# Copy to `.env` beside docker-compose.yml and fill in. NEVER commit the filled-in file.
# Every value here is a placeholder; see docs/photos-immich-setup.md.

# ── The read-only CIFS mount of the collection ──────────────────────────────────────────────────
# MUST be a READ-ONLY NAS account. Immich is then physically incapable of modifying an original,
# whatever any UI mishap might try — the prime directive of the whole vertical (photos-plan.md §6).
NAS_HOST=nas-host-or-ip
NAS_SHARE=share-name
NAS_READONLY_USER=readonly-account
NAS_READONLY_PASSWORD=replace-me

# ── Bind address ────────────────────────────────────────────────────────────────────────────────
# The host's LAN address. Never 0.0.0.0 on a machine with a public interface, and never behind the
# public reverse proxy: this sidecar is LAN-only by design.
IMMICH_BIND_ADDRESS=127.0.0.1

# ── Immich's own database (its data, not ours — disposable) ─────────────────────────────────────
DB_USERNAME=immich
DB_PASSWORD=replace-me
DB_DATABASE_NAME=immich
DB_HOSTNAME=immich-database
REDIS_HOSTNAME=immich-redis

# Where Immich writes its own derivatives. Relative to this directory.
UPLOAD_LOCATION=./data/upload
DB_DATA_LOCATION=./data/postgres
