<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- The photo ingest pipeline is exercised end to end against a GENERATED fixture tree and a
         throwaway SQLite file. Both are deliberate: the NAS is never read by a test, and the
         configured SQL Server connection string IS the live shared production database. -->
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MovieTheater.Services\MovieTheater.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The family-album gate is ASP.NET authorization, so the suite needs the framework's
         Authorization/Http/Mvc assemblies to exercise the real middleware over the real policy. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test the gateway's RomCache + SaveStore from source (they only need BCL + ILogger), so the suite
         stays buildable without a ProjectReference to the Web-SDK gateway app. -->
    <Compile Include="..\MovieTheater.ArcadeGateway\RomCache.cs" Link="Arcade\RomCache.cs" />
    <Compile Include="..\MovieTheater.ArcadeGateway\SaveStore.cs" Link="Arcade\SaveStore.cs" />
    <Compile Include="..\MovieTheater.ArcadeGateway\HeavyLane.cs" Link="Arcade\HeavyLane.cs" />
    <Compile Include="..\MovieTheater.ArcadeGateway\HeavyStager.cs" Link="Arcade\HeavyStager.cs" />
    <Compile Include="..\MovieTheater.ArcadeGateway\HeavyVault.cs" Link="Arcade\HeavyVault.cs" />
    <Compile Include="..\MovieTheater.ArcadeGateway\ApolloAdmin.cs" Link="Arcade\ApolloAdmin.cs" />
    <Compile Include="..\MovieTheater\Arcade\RepoDataPath.cs" Link="Arcade\RepoDataPath.cs" />
    <Compile Include="..\MovieTheater\Arcade\ArcadeRomTags.cs" Link="Arcade\ArcadeRomTags.cs" />
    <Compile Include="..\MovieTheater\Arcade\ArcadeVersions.cs" Link="Arcade\ArcadeVersions.cs" />
    <!-- ThumbRepo is a load-bearing lookup table (which systems get libretro art, on which branch) and it
         has been wrong in both directions; the tests pin it. -->
    <Compile Include="..\MovieTheater\Arcade\ArcadeBoxArt.cs" Link="Arcade\ArcadeBoxArt.cs" />
    <Compile Include="..\MovieTheater\Arcade\ArcadeBoxArtIndex.cs" Link="Arcade\ArcadeBoxArtIndex.cs" />
    <Compile Include="..\MovieTheater\Arcade\ArcadeBoxArtAliases.cs" Link="Arcade\ArcadeBoxArtAliases.cs" />
    <Compile Include="..\MovieTheater\Arcade\ArcadeRoomService.cs" Link="Arcade\ArcadeRoomService.cs" />
    <Compile Include="..\MovieTheater\Arcade\ArcadeChtFile.cs" Link="Arcade\ArcadeChtFile.cs" />
    <Compile Include="..\MovieTheater\Arcade\ArcadeChtIndex.cs" Link="Arcade\ArcadeChtIndex.cs" />
    <Compile Include="..\MovieTheater\Arcade\ArcadeCheatCatalog.cs" Link="Arcade\ArcadeCheatCatalog.cs" />
    <Compile Include="..\MovieTheater\Arcade\DolphinGameIni.cs" Link="Arcade\DolphinGameIni.cs" />
    <Compile Include="..\MovieTheater\Arcade\DolphinDiscId.cs" Link="Arcade\DolphinDiscId.cs" />
    <Compile Include="..\MovieTheater\Arcade\ArcadeCoreOptionCatalog.cs" Link="Arcade\ArcadeCoreOptionCatalog.cs" />
    <Compile Include="..\MovieTheater\Arcade\ArcadeRendererProfiles.cs" Link="Arcade\ArcadeRendererProfiles.cs" />
    <Compile Include="..\MovieTheater\Arcade\ArcadeCoreOptionApplicability.cs" Link="Arcade\ArcadeCoreOptionApplicability.cs" />
    <Compile Include="..\MovieTheater\Arcade\ArcadeRoomOptionDelivery.cs" Link="Arcade\ArcadeRoomOptionDelivery.cs" />
    <Compile Include="..\MovieTheater\Arcade\ArcadeQualityPresets.cs" Link="Arcade\ArcadeQualityPresets.cs" />
    <Compile Include="..\MovieTheater\Arcade\ArcadeRewindSupport.cs" Link="Arcade\ArcadeRewindSupport.cs" />
    <Compile Include="..\MovieTheater\Music\MusicNaming.cs" Link="Music\MusicNaming.cs" />
    <!-- The library's A-Z article convention and its inverse. Compiled from source because the
         inverse is what every external title lookup goes through: folders spell it "Sheep
         Detectives, The" and no catalogue has ever heard of that, so a regression here does not
         throw — it quietly resolves nothing. -->
    <Compile Include="..\MovieTheater\Ingest\TitleNorm.cs" Link="Ingest\TitleNorm.cs" />
    <!-- The tracklist order. Compiled from source because the claim is about the SHIPPED query — a
         re-declared copy would sort a list, and the bug it fixes is a DATABASE behaviour (ORDER BY
         puts NULLs first) that only a real query can exhibit. -->
    <Compile Include="..\MovieTheater\Music\MusicTrackOrdering.cs" Link="Music\MusicTrackOrdering.cs" />
    <!-- The cue-fit test that keeps a wrong-version LRC out of the database. Compiled from source
         so the tests judge the SHIPPED tolerance and the SHIPPED timestamp grammar — the whole bug
         was an LRC that passed one check (LRCLIB's duration) and failed the one nobody ran. -->
    <Compile Include="..\MovieTheater\Music\MusicLyricsFit.cs" Link="Music\MusicLyricsFit.cs" />
    <Compile Include="..\MovieTheater\Music\MusicArtStore.cs" Link="Music\MusicArtStore.cs" />
    <!-- The genre normaliser + roll-ups (R9 S10). Compiled from source because the claim is about
         the SHIPPED fold: eight spellings of "Rock" must become ONE pill in the rail, and a
         re-declared copy would pass while the shipped facet shattered into near-duplicates. Pure
         (no I/O, no database) — the file reading lives in the CLI, which is excluded as always. -->
    <Compile Include="..\MovieTheater\Music\MusicGenres.cs" Link="Music\MusicGenres.cs" />
    <!-- The popularity scale and the library BLEND behind the "Top rated" order (R9 S10). Pure
         arithmetic, and the arithmetic is the claim: a linear popularity map would collapse the
         whole library into two points of the scale, and a plain average would let one enthusiastic
         100 outrank a record five people agreed was excellent. -->
    <Compile Include="..\MovieTheater\Music\MusicPopularity.cs" Link="Music\MusicPopularity.cs" />
    <!-- The external album RATING's scale (2026-08-31). Compiled from source because the shrink IS
         the claim: MusicBrainz ratings run to a median of 4 votes, and without it a lone 5.0 would
         outrank a record forty-five people settled at 3.2. -->
    <Compile Include="..\MovieTheater\Music\MusicRating.cs" Link="Music\MusicRating.cs" />
    <!-- Reading a Last.fm album.getinfo body. Compiled from source because the claim is about the
         SHIPPED parse: Last.fm serves `tags` as an array, as a bare object, or as the empty STRING,
         and the third shape threw InvalidOperationException past a catch(JsonException) and cost
         ~12% of the library the popularity score it had already been given. -->
    <Compile Include="..\MovieTheater\Music\MusicLastFm.cs" Link="Music\MusicLastFm.cs" />
    <!-- Where the raw-response cache lands. Compiled from source because the claim is about the
         SHIPPED default: anchored on the repo marker, so a stray data/ beside a binary can no longer
         shadow the real cache and send an offline re-parse back to the network. -->
    <Compile Include="..\MovieTheater\Music\MusicResponseCache.cs" Link="Music\MusicResponseCache.cs" />
    <!-- The remote-art match gate. Pure apart from the HTTP calls the tests never reach, and worth
         testing directly: it is what stops a search result that merely shares a name from being
         accepted as the album's cover. -->
    <Compile Include="..\MovieTheater\Music\MusicRemoteArt.cs" Link="Music\MusicRemoteArt.cs" />
    <!-- The family-album gate and the controller it guards (docs/photos-plan.md §2.1). Both are
         compiled in so the policy tests run the REAL requirement/handler and read the REAL
         [Authorize] attribute off PhotosController — a re-declared copy would pass while the
         shipped controller sat open. Neither file needs a database at test time: the gate's
         UserSettings lookup is behind IFamilyAlbumMembership, which the tests substitute (the
         configured connection string is the live shared DB and no test may reach it). -->
    <!-- The streaming control plane, for the video players' self-report sink
         (POST /API/Stream/Incident). Compiled from source for the same reason PhotosController is:
         the claims are about the SHIPPED action — that it reads a raw beacon body, keeps a report it
         cannot parse, caps the payload, and prunes its own table on insert — and a re-declared copy
         would pass while the shipped endpoint did something else. It drags in the two app-local
         helpers it holds references to (the rating gate's rating resolution and the in-app session
         ledger), both of which are BCL/EF only; everything else it needs arrives through the
         Services ProjectReference. No test may contact Jellyfin, so the client handed to it points
         at a socket that is never opened. -->
    <Compile Include="..\MovieTheater\Controllers\StreamController.cs" Link="Streaming\StreamController.cs" />
    <!-- The music control plane, for the play beacon's sink (POST /API/Music/Play) and its gate.
         Compiled from source for the same reason StreamController and PhotosController are: the
         claims are about the SHIPPED action — that it reads a raw text/plain beacon, floors the
         start stamp to the minute, and treats a report carrying a minute it already counted as a
         no-op — and about the REAL [Authorize] attribute on the class, which is the only thing
         standing between play telemetry and an anonymous writer. A re-declared copy would pass
         while the shipped endpoint double-counted or sat open. No test may reach the configured
         connection string (it IS the live shared database), so every test here runs against a
         throwaway SQLite MovieDb. MusicArtFill comes along because the controller references it. -->
    <Compile Include="..\MovieTheater\Music\MusicArtFill.cs" Link="Music\MusicArtFill.cs" />
    <Compile Include="..\MovieTheater\Controllers\MusicController.cs" Link="Music\MusicController.cs" />
    <Compile Include="..\MovieTheater\Streaming\TranscodeSessionRegistry.cs" Link="Streaming\TranscodeSessionRegistry.cs" />
    <Compile Include="..\MovieTheater\Web\RatingGate.cs" Link="Streaming\RatingGate.cs" />
    <!-- The grouped browse core + the A–Z walk it derives letter rails from (BrowseGroupsTests). -->
    <Compile Include="..\MovieTheater\Web\BrowseGroups.cs" Link="Browse\BrowseGroups.cs" />
    <!-- The facet rail's combinable filter + facet counts (R9 S2, BrowseFilterTests): the includes/excludes,
         the newest-insight tag rule and the counts are claims about the SHIPPED query builder. -->
    <Compile Include="..\MovieTheater\Web\BrowseFilter.cs" Link="Browse\BrowseFilter.cs" />
    <Compile Include="..\MovieTheater\Web\PhotoBrowseFilter.cs" Link="Browse\PhotoBrowseFilter.cs" />
    <!-- R9 S7: the change-driven catalog warmer's judgeable halves — the catalog FINGERPRINT it gates
         on and the pure gating decision — plus the two cache keys a warm has to agree with a request
         about, and the base queries both of them build over. The hosted service itself is deliberately
         NOT compiled in: a real warm reads the whole library, and no test may do that. -->
    <Compile Include="..\MovieTheater\Web\CatalogQueries.cs" Link="Browse\CatalogQueries.cs" />
    <Compile Include="..\MovieTheater\Web\BrowseCacheKeys.cs" Link="Browse\BrowseCacheKeys.cs" />
    <Compile Include="..\MovieTheater\Web\ImageBytes.cs" Link="Web\ImageBytes.cs" />
    <Compile Include="..\MovieTheater\Web\ThumbRecoder.cs" Link="Web\ThumbRecoder.cs" />
    <Compile Include="..\MovieTheater\Web\ThumbsRecodeService.cs" Link="Web\ThumbsRecodeService.cs" />
    <Compile Include="..\MovieTheater\Web\CatalogWarmup.cs" Link="Browse\CatalogWarmup.cs" />
    <Compile Include="..\MovieTheater\Web\LetterBuckets.cs" Link="Browse\LetterBuckets.cs" />
    <!-- The endpoint boundary for a request the caller abandoned. Compiled from source because the
         claim is about the SHIPPED filter Startup registers globally: a cancellation raised by THIS
         request's RequestAborted closes quietly as 499, and a cancellation from any other token is
         still a failure. A re-declared copy would pass while the shipped filter swallowed real faults. -->
    <Compile Include="..\MovieTheater\Web\ClientAbortedFilter.cs" Link="Browse\ClientAbortedFilter.cs" />
    <Compile Include="..\MovieTheater\Web\BoardgameLinkFacets.cs" Link="Browse\BoardgameLinkFacets.cs" />
    <Compile Include="..\MovieTheater\Arcade\ArcadeGameGroups.cs" Link="Arcade\ArcadeGameGroups.cs" />
    <Compile Include="..\MovieTheater\Photos\FamilyAlbumGate.cs" Link="Photos\FamilyAlbumGate.cs" />
    <!-- The Books gate and the OPDS Basic scheme (merge program R5), for the same reason as the family-album
         gate: the tests run the REAL policy declaration and the real handler; only the UserSettings read and
         the password hash check are substituted. The Yarp transform/config stay out (they need the proxy). -->
    <Compile Include="..\MovieTheater\Books\BooksAccessGate.cs" Link="Books\BooksAccessGate.cs" />
    <Compile Include="..\MovieTheater\Books\OpdsBasicAuthenticationHandler.cs" Link="Books\OpdsBasicAuthenticationHandler.cs" />
    <Compile Include="..\MovieTheater\Controllers\PhotosController.cs" Link="Photos\PhotosController.cs" />
    <Compile Include="..\MovieTheater\Controllers\PhotosController.Browse.cs" Link="Photos\PhotosController.Browse.cs" />
    <!-- The Phase 1 ingest pipeline, compiled from source for the same reason: the tests must drive
         the SHIPPED walk/metadata/hash/thumb code, not a description of it. Everything here depends
         only on BCL + EF + ImageSharp + MetadataExtractor — the CliFx command that wraps it is
         deliberately NOT included, so the engine stays free of the CLI. -->
    <Compile Include="..\MovieTheater\Photos\PhotoFileKinds.cs" Link="Photos\PhotoFileKinds.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoWalkCursor.cs" Link="Photos\PhotoWalkCursor.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoDates.cs" Link="Photos\PhotoDates.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoMetadataReader.cs" Link="Photos\PhotoMetadataReader.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoHashes.cs" Link="Photos\PhotoHashes.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoThumbCache.cs" Link="Photos\PhotoThumbCache.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoIngestPipeline.cs" Link="Photos\PhotoIngestPipeline.cs" />
    <!-- Phase 2 curation (docs/photos-plan.md §2.9/§2.11), same reasoning: the suggested-hide
         heuristics, the review-artifact store, album slugs and the export/import engine are all
         driven from source. The CliFx commands that wrap them are again excluded, so the engines
         stay free of the CLI. -->
    <Compile Include="..\MovieTheater\Photos\PhotoCurationStore.cs" Link="Photos\PhotoCurationStore.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoHideSuggestions.cs" Link="Photos\PhotoHideSuggestions.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoSuggestHidePass.cs" Link="Photos\PhotoSuggestHidePass.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoAlbumSlug.cs" Link="Photos\PhotoAlbumSlug.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoCurationExportModel.cs" Link="Photos\PhotoCurationExportModel.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoCurationExporter.cs" Link="Photos\PhotoCurationExporter.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoCurationImporter.cs" Link="Photos\PhotoCurationImporter.cs" />
    <!-- Phase 3 grouping (docs/photos-plan.md §2.6). The determinism and idempotency the whole lane is
         judged on can only be measured by running the SHIPPED engine twice, so the master heuristic,
         the BK-tree index, the variant rules and the three passes are all compiled from source; the
         CliFx command that wraps them is again excluded. -->
    <Compile Include="..\MovieTheater\Photos\PhotoDupeMasters.cs" Link="Photos\PhotoDupeMasters.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoHashIndex.cs" Link="Photos\PhotoHashIndex.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoVariantPairs.cs" Link="Photos\PhotoVariantPairs.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoDupePass.cs" Link="Photos\PhotoDupePass.cs" />
    <!-- Phase 4 people, tagging and the Immich sidecar (docs/photos-plan.md §2.4/§2.8). Same reason
         again: the master-redirect on tags, the no-clobber suggestion rules and the sync's mapping are
         claims about the SHIPPED code, so they are compiled from source. The Immich client itself lives
         in MovieTheater.Services and arrives through the ProjectReference; the tests drive it against a
         stand-in HTTP server and never a live instance. The CliFx command is excluded as always. -->
    <Compile Include="..\MovieTheater\Photos\PhotoPersonTags.cs" Link="Photos\PhotoPersonTags.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoFaceCrops.cs" Link="Photos\PhotoFaceCrops.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoImmichSync.cs" Link="Photos\PhotoImmichSync.cs" />
    <!-- Phase 5 videos (docs/photos-plan.md §2.3). The path translation, the sync's stamping and
         clearing, the reserved-folder audit, the ffprobe parsing and the video ingest pass are all
         claims about the SHIPPED code and are compiled from source. Both external dependencies are
         behind seams — IPhotoJellyfinSource and IPhotoVideoTools — because no test, build or smoke may
         contact the live media server or read the NAS. The CliFx command is excluded as always. -->
    <Compile Include="..\MovieTheater\Photos\PhotoJellyfinPaths.cs" Link="Photos\PhotoJellyfinPaths.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoJellyfinReservedFolders.cs" Link="Photos\PhotoJellyfinReservedFolders.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoJellyfinSync.cs" Link="Photos\PhotoJellyfinSync.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoVideoTools.cs" Link="Photos\PhotoVideoTools.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoVideoPlayback.cs" Link="Photos\PhotoVideoPlayback.cs" />
    <!-- Phase 6 the Google Takeout mesh (docs/photos-plan.md §2.10). Same reason once more: the
         sidecar pairing rules, the three-rung matching cascade, the source-hierarchy backfill and the
         download lane's three refusals are claims about the SHIPPED code. The archive and the download
         destination are both generated temp directories — no test reads a real Takeout export and no
         test writes anywhere near the collection. The CliFx command is excluded as always. -->
    <Compile Include="..\MovieTheater\Photos\PhotoGoogleSidecar.cs" Link="Photos\PhotoGoogleSidecar.cs" />
    <Compile Include="..\MovieTheater\Photos\PhotoGoogleMesh.cs" Link="Photos\PhotoGoogleMesh.cs" />
    <!-- Phase 7 the Gallery shelf (docs/photos-plan.md §2.12). Compiled from source for the reason
         every pass above it is: the prefix/exclusion arithmetic, the group-coherent expansion and —
         above all — IDEMPOTENCY are claims about the SHIPPED engine, and idempotency in particular
         can only be measured by running the real thing twice against the same rows. The pass reads no
         files at all, so the fixture it runs on is a database and nothing else. The CliFx command is
         excluded as always. -->
    <Compile Include="..\MovieTheater\Photos\PhotoShelfPass.cs" Link="Photos\PhotoShelfPass.cs" />
    <!-- The extracted per-core option catalog, embedded here too so the quality-preset tests can
         validate preset tokens against the FULL catalog (the hand-defined entries alone don't cover
         the extracted keys the presets pin). LoadExtracted finds it by resource-name suffix. -->
    <EmbeddedResource Include="..\MovieTheater\Arcade\core-options-catalog.json" Link="Arcade\core-options-catalog.json" />
  </ItemGroup>

</Project>