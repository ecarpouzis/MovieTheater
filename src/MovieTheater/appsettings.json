{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ArcadeZoningEnabled": true,
  "ReverseProxy": {
    "Routes": {
      "ui-catch-all": {
        "ClusterId": "localhost",
        "Order": 1,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "localhost": {
        "Destinations": {
          "localhost/catch-all": {
            "Address": "http://localhost:3000/"
          }
        }
      }
    }
  }
}
