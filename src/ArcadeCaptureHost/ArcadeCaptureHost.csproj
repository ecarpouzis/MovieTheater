<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ArcadeCaptureHost — a standalone Windows Graphics Capture (WGC) *window* capture helper for the
    MovieTheater arcade capture lane. It captures a single game window (by HWND) — which works even
    when the window is off-screen or occluded, in ANY session (console or RDP) — and publishes packed
    BGRA frames into a shared-memory ring the mingw Go worker reads (see docs/arcade-capture-worker-plan.md).

    WHY A SEPARATE PROCESS: our GStreamer/Go worker is built with mingw/ucrt64, where WGC won't compile
    (WinRT/WRL headers don't emit the __FITypedEventHandler typedefs mingw needs — hard wall confirmed
    2026-07-23). .NET 10 has first-class WinRT projections for WGC, so we isolate the capture to this
    tiny .NET process. A WGC/D3D crash here stays out of the worker (which historically abort()ed the
    whole worker on the stock plugin's cursor bug → "the arcade is full").

    NOT part of MovieTheater.sln and NOT built by CI — it is Windows-only, Ziggy-only, deployed by file
    copy to D:\ArcadeStorage\worker-capture\bin\ (publish: see build.ps1).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- No AOT/trimming: COM/WinRT interop is reflection- and marshaling-heavy and trims badly. -->
    <PublishTrimmed>false</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ArcadeCaptureHost</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- D3D11 device + staging-texture map/copy. Pulls Vortice.DXGI transitively. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>

</Project>
