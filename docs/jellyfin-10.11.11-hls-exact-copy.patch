diff -ruN -x bin -x obj a/Jellyfin.Api/Controllers/KeyframeExtractionController.cs b/Jellyfin.Api/Controllers/KeyframeExtractionController.cs
--- a/Jellyfin.Api/Controllers/KeyframeExtractionController.cs	1969-12-31 19:00:00.000000000 -0500
+++ b/Jellyfin.Api/Controllers/KeyframeExtractionController.cs	2026-09-01 20:19:56.167906400 -0400
@@ -0,0 +1,151 @@
+using System;
+using System.Collections.Generic;
+using System.ComponentModel.DataAnnotations;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using Jellyfin.MediaEncoding.Hls.Extractors;
+using MediaBrowser.Common.Api;
+using MediaBrowser.Controller.IO;
+using MediaBrowser.Controller.Library;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Mvc;
+
+namespace Jellyfin.Api.Controllers;
+
+/// <summary>
+/// Per-item keyframe extraction. Populates the keyframe repository with a COMPLETE keyframe list
+/// (ffprobe packet walk) for one video, which authorizes the exact per-keyframe HLS segmentation
+/// for stream-copied sessions (see DynamicHlsPlaylistGenerator). Exists so a driver can backfill
+/// the library in bounded, resumable batches instead of the all-or-nothing scheduled task — whose
+/// extractor ordering also prefers container cues, which are not complete enough for this purpose.
+/// </summary>
+[Route("Videos")]
+[Authorize(Policy = Policies.RequiresElevation)]
+public class KeyframeExtractionController : BaseJellyfinApiController
+{
+    private readonly ILibraryManager _libraryManager;
+    private readonly IKeyframeManager _keyframeManager;
+    private readonly IKeyframeExtractor[] _keyframeExtractors;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="KeyframeExtractionController"/> class.
+    /// </summary>
+    /// <param name="libraryManager">An instance of the <see cref="ILibraryManager"/> interface.</param>
+    /// <param name="keyframeManager">An instance of the <see cref="IKeyframeManager"/> interface.</param>
+    /// <param name="keyframeExtractors">The registered keyframe extractors.</param>
+    public KeyframeExtractionController(
+        ILibraryManager libraryManager,
+        IKeyframeManager keyframeManager,
+        IEnumerable<IKeyframeExtractor> keyframeExtractors)
+    {
+        _libraryManager = libraryManager;
+        _keyframeManager = keyframeManager;
+        _keyframeExtractors = keyframeExtractors.ToArray();
+    }
+
+    /// <summary>
+    /// Extracts and stores the complete keyframe list for a video via ffprobe.
+    /// </summary>
+    /// <param name="itemId">The item id.</param>
+    /// <param name="cancellationToken">The cancellation token.</param>
+    /// <response code="204">Keyframes extracted and stored.</response>
+    /// <response code="404">Item not found or has no local path.</response>
+    /// <response code="500">Extraction failed.</response>
+    /// <returns>A <see cref="NoContentResult"/> on success.</returns>
+    [HttpPost("{itemId}/ExtractKeyframes")]
+    [ProducesResponseType(StatusCodes.Status204NoContent)]
+    [ProducesResponseType(StatusCodes.Status404NotFound)]
+    public async Task<ActionResult> ExtractKeyframes([FromRoute, Required] Guid itemId, CancellationToken cancellationToken)
+    {
+        var item = _libraryManager.GetItemById(itemId);
+        var path = item?.Path;
+        if (item is null || string.IsNullOrEmpty(path) || !System.IO.File.Exists(path))
+        {
+            return NotFound();
+        }
+
+        // The non-metadata extractor is the ffprobe packet walk — the only complete source. It is
+        // registered behind the cache decorator, which returns any stored row instead of re-reading
+        // the file, so clear the repository first: this endpoint's contract is a FRESH complete
+        // extraction (it also purges any legacy cue-derived row for the item).
+        var ffprobeExtractor = _keyframeExtractors.FirstOrDefault(e => !e.IsMetadataBased);
+        if (ffprobeExtractor is null)
+        {
+            return StatusCode(StatusCodes.Status500InternalServerError, "No ffprobe keyframe extractor registered");
+        }
+
+        await _keyframeManager.DeleteKeyframeDataAsync(itemId, cancellationToken).ConfigureAwait(false);
+        if (!ffprobeExtractor.TryExtractKeyframes(itemId, path, out _))
+        {
+            return StatusCode(StatusCodes.Status500InternalServerError, "Keyframe extraction failed");
+        }
+
+        return NoContent();
+    }
+
+    /// <summary>
+    /// Stores a previously-extracted keyframe list for a video without touching the file.
+    /// </summary>
+    /// <remarks>
+    /// The restore half of keyframe custody: KeyframeData rows cascade-delete with their items, so a
+    /// renamed folder destroys the stored lists for everything under it even though the bytes are
+    /// unchanged. The caller (the site's sync) holds the master copy keyed by content fingerprint and
+    /// re-imports it onto the item's NEW id — a per-keyframe list for the same bytes is identical
+    /// whatever the file is called, so this is a pure repository write. Delete-then-save mirrors the
+    /// extraction endpoint above: the table's meaning ("ffprobe-complete") is preserved because the
+    /// caller only ever imports lists that were captured from that same extraction path.
+    /// </remarks>
+    /// <param name="itemId">The item id.</param>
+    /// <param name="request">The keyframe list to store.</param>
+    /// <param name="cancellationToken">The cancellation token.</param>
+    /// <response code="204">Keyframes stored.</response>
+    /// <response code="400">Empty or malformed keyframe list.</response>
+    /// <response code="404">Item not found.</response>
+    /// <returns>A <see cref="NoContentResult"/> on success.</returns>
+    [HttpPost("{itemId}/ImportKeyframes")]
+    [ProducesResponseType(StatusCodes.Status204NoContent)]
+    [ProducesResponseType(StatusCodes.Status400BadRequest)]
+    [ProducesResponseType(StatusCodes.Status404NotFound)]
+    public async Task<ActionResult> ImportKeyframes(
+        [FromRoute, Required] Guid itemId,
+        [FromBody, Required] ImportKeyframesRequest request,
+        CancellationToken cancellationToken)
+    {
+        var item = _libraryManager.GetItemById(itemId);
+        if (item is null)
+        {
+            return NotFound();
+        }
+
+        if (request.KeyframeTicks is null || request.KeyframeTicks.Count == 0 || request.TotalDurationTicks <= 0)
+        {
+            return BadRequest("A keyframe import needs a positive duration and a non-empty tick list.");
+        }
+
+        await _keyframeManager.DeleteKeyframeDataAsync(itemId, cancellationToken).ConfigureAwait(false);
+        await _keyframeManager.SaveKeyframeDataAsync(
+            itemId,
+            new Jellyfin.MediaEncoding.Keyframes.KeyframeData(request.TotalDurationTicks, request.KeyframeTicks),
+            cancellationToken).ConfigureAwait(false);
+
+        return NoContent();
+    }
+}
+
+/// <summary>
+/// The body of a keyframe import: the stored list, exactly as an extraction produced it.
+/// </summary>
+public class ImportKeyframesRequest
+{
+    /// <summary>
+    /// Gets or sets the total duration of the stream in ticks.
+    /// </summary>
+    public long TotalDurationTicks { get; set; }
+
+    /// <summary>
+    /// Gets or sets the keyframes in ticks.
+    /// </summary>
+    public IReadOnlyList<long>? KeyframeTicks { get; set; }
+}
