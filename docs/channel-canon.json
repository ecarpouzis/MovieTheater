// Per-channel canon for the channel-canon command: titles that MUST be in the eligible pool and
// titles that MUST NOT be. Case-insensitive substrings — keep them distinctive ("Toy Story",
// never "It"). This is the regression harness born from the 2026-07-28/29 session: every entry
// below was a real failure or a real leak at some point that night. Extend it whenever a channel's
// identity gets litigated — the argument becomes a permanent test.
//
// NOTE: entries for judged channels describe the POST-SWEEP contract. Until the channel-tag sweep
// has loaded membership for a channel, DB-mode failures here are the documented gap, not a bug.
[
  {
    "channel": "family-night",
    "mustInclude": [
      "Star Wars: Episode IV", "E.T.", "Jurassic Park", "Back to the Future",
      "Raiders of the Lost Ark", "Ghostbusters", "Princess Bride", "Toy Story",
      "Goonies", "Moana", "Karate Kid"
    ],
    "mustExclude": [
      "Anchorman", "Dirty Dozen", "Lawrence of Arabia", "Casino Royale",
      "Dumb & Dumber", "Wayne's World", "Berserk", "Evangelion", "Poltergeist"
    ]
  },
  {
    "channel": "kid-films",
    "mustInclude": ["Toy Story", "Land Before Time", "Winnie the Pooh"],
    "mustExclude": ["Jurassic Park", "Gremlins", "Watership Down", "Jaws"]
  },
  {
    "channel": "family-tv",
    "mustInclude": ["Bluey", "Sesame Street", "Avatar: The Last Airbender", "DuckTales"],
    "mustExclude": ["Rick and Morty", "Berserk", "South Park"]
  },
  {
    "channel": "holiday-cheer",
    "mustInclude": ["It's a Wonderful Life", "Grinch Stole Christmas", "Muppet Christmas"],
    // Eric's strict rule: Occasion-style membership only for movies that ARE the holiday
    // (Rudolf/Frosty tier). Gremlins is a monster movie that happens to be set at Christmas.
    "mustExclude": ["Gremlins"]
  },
  {
    "channel": "spooky-season",
    // Deliberately broad — a seasonal MOOD channel may air year-round monster movies in October.
    "mustInclude": ["Hocus Pocus", "Great Pumpkin", "Nightmare Before Christmas", "Gremlins"],
    "mustExclude": []
  },
  {
    "channel": "big-kid-horror",
    "mustInclude": ["Gremlins", "Monster Squad", "Hocus Pocus", "Coraline", "Beetlejuice"],
    // Poltergeist judged out (follows a kid to bed); R-tier excluded mechanically anyway.
    "mustExclude": ["Poltergeist", "Exorcist", "Saw", "Ju-on"]
  },
  {
    "channel": "superstation",
    "mustInclude": ["Fugitive", "Point Break", "Matrix", "Groundhog Day", "Beverly Hills Cop", "Jurassic Park", "Die Hard"],
    "mustExclude": ["Lawrence of Arabia", "Aguirre"]
  },
  {
    "channel": "after-dark",
    "mustInclude": ["Animal House", "Breakfast Club", "Lethal Weapon", "Big Lebowski", "Usual Suspects"],
    "mustExclude": ["Toy Story", "Bluey", "Zatoichi"]
  },
  {
    "channel": "public-access",
    "mustInclude": ["Birdemic", "Room, The", "Troll 2", "Plan 9"],
    // Eric's vetoes: produced mainstream chaos and web narratives are NOT the UHF dial.
    "mustExclude": ["Jackass", "Red Versus Blue"]
  },
  {
    "channel": "whodunit",
    "mustInclude": ["Clue", "Charade", "Thin Man", "Dial M for Murder"],
    "mustExclude": ["Se7en", "Texas Chainsaw"]
  },
  {
    "channel": "lazy-sunday",
    "mustInclude": ["Great Escape", "Bridge on the River Kwai", "Hunt for Red October", "Ben-Hur", "Das Boot"],
    "mustExclude": ["Bluey", "Anchorman"]
  },
  {
    "channel": "date-night",
    "mustInclude": ["When Harry Met Sally", "Princess Bride", "Amélie", "Before Sunrise", "Moonstruck"],
    "mustExclude": ["Antichrist", "Blue Valentine"]
  },
  {
    "channel": "naughty-list",
    "mustInclude": ["Violent Night", "Bad Santa", "Die Hard"],
    "mustExclude": ["Grinch", "Charlie Brown Christmas"]
  },
  {
    "channel": "witching-hour",
    "mustInclude": ["Halloween", "Trick 'r Treat", "Suspiria", "Nightmare on Elm Street"],
    // The rubric is seasonal atmosphere, not horror quality: a great film can be a wrong answer.
    "mustExclude": ["Silence of the Lambs", "Toy Story"]
  },
  {
    "channel": "adult-swim",
    "mustInclude": ["Aqua Teen", "Venture Bros", "Superjail", "Frisky Dingo"],
    "mustExclude": ["Harley Quinn", "Bluey"]
  },
  {
    "channel": "adult-animation",
    "mustInclude": ["Akira", "Heavy Metal", "Fritz the Cat", "Maxx"],
    // Block TV SHOWS stay on [adult swim]; block-derived FILMS (Aqua Teen Forever) belong here,
    // since adult-swim is series-only. Sealab has no film, so it's the clean exclusion probe.
    "mustExclude": ["Toy Story", "Bluey", "Sealab"]
  },
  {
    "channel": "kid-shorts",
    "mustInclude": ["Luxo", "Bao", "Trip to the Moon", "Wrong Trousers"],
    "mustExclude": ["Ben-Hur"]
  },
  {
    "channel": "read-learn",
    // The gap that triggered the concept-channel conversion: educational shows the old path
    // list didn't know. Bill Nye must never go missing from the kids' educational channel again.
    "mustInclude": ["Bill Nye the Science Guy", "Emily's Wonder Lab", "Reading Rainbow", "Magic School Bus"],
    "mustExclude": ["Hilda", "Rick and Morty"]
  },
  {
    "channel": "preschool",
    "mustInclude": ["Bluey", "Blue's Clues", "Peppa Pig", "Sesame Street"],
    "mustExclude": ["Rick and Morty", "Berserk"]
  },
  {
    "channel": "animated-heroes",
    // HARD RULE: baby/toddler shows stay off general channels — preschool Marvel is not this station.
    "mustInclude": ["Batman", "Avatar: The Last Airbender", "X-Men"],
    "mustExclude": ["Spidey and His Amazing Friends", "Bluey"]
  },
  {
    "channel": "nickelodeon",
    // The network's big-kid identity; toddler-tier Nick (Blue's Clues) lives on Preschool Corner.
    "mustInclude": ["SpongeBob", "Invader ZIM", "Pete & Pete"],
    "mustExclude": ["Blue's Clues", "Bluey"]
  },
  {
    "channel": "science-tv",
    "mustInclude": ["MythBusters", "How It's Made", "Bill Nye"],
    "mustExclude": ["Peppa Pig", "Sesame Street"]
  }
]
