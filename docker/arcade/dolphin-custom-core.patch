diff --git a/CMakeLists.txt b/CMakeLists.txt
index c98ef09..f13538b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -114,7 +114,19 @@ option(FASTLOG "Enable all logs" OFF)
 
 if (MSVC)
    set(CMAKE_CXX_FLAGS_DEBUG   "/MTd")
-   set(CMAKE_CXX_FLAGS_RELEASE "/MT")
+   # MT PATCH: upstream sets this to bare "/MT", which does not ADD to CMake's default Release flags
+   # ("/MD /O2 /Ob2 /DNDEBUG") -- it REPLACES them. So an MSVC "Release" build compiles every C++ file
+   # with no /O2 (MSVC falls back to /Od) and no NDEBUG (assertions live). It clobbers only the CXX
+   # flags, so the C code still gets /O2 and the build looks entirely healthy.
+   #
+   # Dolphin is C++. That means the PowerPC JIT, VideoCommon and Common -- the whole emulator -- were
+   # built unoptimized. Measured: F-Zero GX raced at 30-50 ticks/s with one core pegged and the GPU
+   # idle, against 58-60 on the stock nightly (the libretro buildbot passes its own flags and never
+   # hits this). Every symptom pointed at the GPU/shader stack; none of it pointed here.
+   #
+   # This cannot be fixed with -DCMAKE_CXX_FLAGS_RELEASE on the command line: a plain set() creates a
+   # normal variable that SHADOWS the cache entry, so the -D is silently ignored. It has to be here.
+   set(CMAKE_CXX_FLAGS_RELEASE "/MT /O2 /Ob2 /DNDEBUG")
 endif()
 
