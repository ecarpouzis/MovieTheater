+static HDC s_external_main_dc = nullptr;
+static HGLRC s_external_main_rc = nullptr;
+
+bool GLContextWGL::CaptureExternalMainContext()
+{
+  s_external_main_dc = wglGetCurrentDC();
+  s_external_main_rc = wglGetCurrentContext();
+  if (!s_external_main_dc || !s_external_main_rc)
+  {
+    WARN_LOG_FMT(VIDEO, "CaptureExternalMainContext: no current WGL context on this thread");
+    return false;
+  }
+  LoadWGLExtensions();  // needs a current context, which we verifiably have right now
+  if (!wglCreateContextAttribsARB || !wglCreatePbufferARB || !wglGetPbufferDCARB)
+  {
+    WARN_LOG_FMT(VIDEO, "CaptureExternalMainContext: WGL extensions unavailable");
+    return false;
+  }
+  INFO_LOG_FMT(VIDEO, "CaptureExternalMainContext: captured frontend dc/rc, extensions loaded");
+  return true;
+}
+
+std::unique_ptr<GLContext> GLContextWGL::CreateExternalSharedContext()
+{
+  if (!s_external_main_dc || !s_external_main_rc)
+    return nullptr;
+
+  HANDLE pbuffer;
+  HDC dc;
+  if (!CreatePBuffer(s_external_main_dc, 1, 1, &pbuffer, &dc))
+    return nullptr;
+
+  HGLRC rc = CreateCoreContext(dc, s_external_main_rc);
+  if (!rc)
+  {
+    // Core-profile share against the frontend's legacy/compat context can be refused by some
+    // drivers; fall back to a plain compat context + wglShareLists â€” legal here because the new
+    // context is brand-new and empty.
+    rc = wglCreateContext(dc);
+    if (rc && !wglShareLists(s_external_main_rc, rc))
+    {
+      WARN_LOG_FMT(VIDEO, "CreateExternalSharedContext: wglShareLists failed ({})", GetLastError());
+      wglDeleteContext(rc);
+      rc = nullptr;
+    }
+  }
+  if (!rc)
+  {
+    wglReleasePbufferDCARB(static_cast<HPBUFFERARB>(pbuffer), dc);
+    wglDestroyPbufferARB(static_cast<HPBUFFERARB>(pbuffer));
+    return nullptr;
+  }
+
+  std::unique_ptr<GLContextWGL> context = std::make_unique<GLContextWGL>();
+  context->m_pbuffer_handle = pbuffer;
+  context->m_dc = dc;
+  context->m_rc = rc;
+  context->m_opengl_mode = Mode::OpenGL;
+  context->m_is_shared = true;
+  return context;
+}
