+// MT INSTRUMENTATION — "is it actually USING the shaders it compiles?"
+//
+// Async ubershaders only pay off if a specialized pipeline, once compiled, takes over from the
+// ubershader. That handoff depends on RetrieveAsyncShaders() running, and it is hooked to
+// after_frame_event — whose ONLY per-frame trigger is the EFB->XFB copy in BPStructs.cpp ("as closest
+// as we have to an end of the frame... works 99% of the time"). If that does not fire under the
+// libretro port, finished pipelines are never collected, `pending` never clears, and the game renders
+// with ubershaders FOREVER while the compiler threads keep churning. That reads exactly like a game
+// that is slow at the same track spots on every restart.
+//
+// So: count it. mt_retrieve_calls == 0 during a race IS the answer.
+static u64 mt_async_hit = 0;       // specialized pipeline ready and used
+static u64 mt_async_pending = 0;   // ubershader used because the specialized one is still compiling
+static u64 mt_async_queued = 0;    // brand-new uid, compile queued
+static u64 mt_retrieve_calls = 0;  // times after_frame_event actually collected finished work
+static u64 mt_installed = 0;       // pipelines handed back by the async compiler and installed
+static u64 mt_requeued = 0;        // work items that were NOT ready and re-queued for another frame
+
+void ShaderCache::MTCountInstalled()
+{
+  mt_installed++;
+}
+void ShaderCache::MTCountRequeued()
+{
+  mt_requeued++;
+}
+
+void ShaderCache::MTReportAsyncStats()
+{
+  INFO_LOG_FMT(VIDEO,
+               "[MT] async: specialized_hit={} ubershader_pending={} queued={} retrieve_calls={} "
+               "installed={} requeued={}",
+               mt_async_hit, mt_async_pending, mt_async_queued, mt_retrieve_calls, mt_installed,
+               mt_requeued);
+}
+
 void ShaderCache::RetrieveAsyncShaders()
 {
+  mt_retrieve_calls++;
   m_async_shader_compiler->RetrieveWorkItems();
 }
 
