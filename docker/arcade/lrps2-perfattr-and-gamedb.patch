diff --git a/pcsx2/PerfAttr.h b/pcsx2/PerfAttr.h
new file mode 100644
index 0000000..5c1c2b6
--- /dev/null
+++ b/pcsx2/PerfAttr.h
@@ -0,0 +1,73 @@
+// Phase A instrumentation (MovieTheater arcade, docs/arcade-stuntman-plan.md, 2026-07-15).
+//
+// Attributes slow retro_run ticks to their cause. In this port's topology (see MTGS.cpp
+// PostVsyncStart) retro_run IS the GS MainLoop, so GS-side work (shader compiles, program-binary
+// loads) extends the tick directly, while the EE thread's WaitGS time measures how long the
+// emulated CPU sat blocked on the GS. Four seams are sampled:
+//   compile_*  - true GLSL driver compiles (GLShaderCache miss path)      [GS thread]
+//   binload_*  - program-binary loads from gl_programs.bin (cache hits)   [GS thread]
+//   vswait_ns  - per-frame WaitGS in MTGS::PostVsyncStart (frame pacing)  [EE thread]
+//   fifowait_* - WaitGS in MTGS::InitAndReadFIFO (readback sync; the
+//                cpuSpriteRenderBW / hw_download path)                    [EE thread]
+// Dumped + reset every 300 frames (~5 s NTSC) by retro_run (libretro/main.cpp) as a
+// "[perf-attr] ..." log line, designed to sit beside the worker's pace-diag lines.
+//
+// C++17 inline atomics: header-only on purpose - no build-system changes to carry.
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace PerfAttr
+{
+	inline std::atomic<std::uint64_t> compile_ns{0}, compile_n{0};
+	inline std::atomic<std::uint64_t> binload_ns{0}, binload_n{0};
+	inline std::atomic<std::uint64_t> vswait_ns{0};
+	inline std::atomic<std::uint64_t> fifowait_ns{0}, fifowait_n{0};
+	// Round 2 (post-restart collapse attribution): split the GS drain itself.
+	//   mainloop_ns - MTGS::MainLoop inside retro_run = the whole GS drain           [libretro thread]
+	//   vidpush_ns  - the video_cb call in GSDeviceOGL::EndPresent = the WORKER's
+	//                 zero-copy push (zc_push + GL copy), i.e. OUR pipeline's share  [libretro thread]
+	// mainloop - vidpush - compile - binload ~= PCSX2's raw GS render work (draws,
+	// texture uploads). Whichever side owns the post-restart 30-40ms/frame is the villain.
+	inline std::atomic<std::uint64_t> mainloop_ns{0};
+	inline std::atomic<std::uint64_t> vidpush_ns{0};
+	// Round 4 (level-start texture-burst profile, GL HW renderer): split the GS thread's texture
+	// work so the async-upload fix targets the measured hot spot, not a guess.
+	//   texmap_*    - GSTextureOGL::Map    (stream-buffer acquisition, incl. fence waits on wrap)
+	//   texunmap_ns - GSTextureOGL::Unmap  (glTexSubImage from the upload ring)
+	//   texupd_*    - GSTextureOGL::Update (direct-path upload: caller-converted pixels -> GL)
+	// gs_cpu minus these ~= draw/state/conversion work elsewhere on the GS thread.
+	inline std::atomic<std::uint64_t> texmap_ns{0}, texmap_n{0};
+	inline std::atomic<std::uint64_t> texunmap_ns{0};
+	inline std::atomic<std::uint64_t> texupd_ns{0}, texupd_n{0};
+	// Round 5: the texture-UPLOAD theory measured dead (texmap/texunmap/texupd ~0 in the burst while
+	// gs_cpu ran 80% of wall). Split what actually remains on the GS thread:
+	//   xfer_*    - GSState::Transfer (GIF texture DMA -> emulated-VRAM swizzle writes; CPU memwork
+	//               present on BOTH renderers)
+	//   hash_*    - GSTextureCache source lookup (HW-renderer-ONLY per-draw hash/cache work; absent
+	//               on SW, which is the leading explanation for why SW cured the burst)
+	//   gsidle_ns - MTGS WaitForWork (the busy-spin that contaminates gs_cpu; subtract it)
+	inline std::atomic<std::uint64_t> xfer_ns{0}, xfer_n{0};
+	inline std::atomic<std::uint64_t> hash_ns{0}, hash_n{0};
+	inline std::atomic<std::uint64_t> gsidle_ns{0};
+
+	struct Timer
+	{
+		std::atomic<std::uint64_t>& ns;
+		std::atomic<std::uint64_t>* n;
+		std::chrono::steady_clock::time_point t0;
+
+		explicit Timer(std::atomic<std::uint64_t>& ns_, std::atomic<std::uint64_t>* n_ = nullptr)
+			: ns(ns_), n(n_), t0(std::chrono::steady_clock::now()) {}
+		~Timer()
+		{
+			ns.fetch_add(static_cast<std::uint64_t>(
+				std::chrono::duration_cast<std::chrono::nanoseconds>(
+					std::chrono::steady_clock::now() - t0).count()),
+				std::memory_order_relaxed);
+			if (n)
+				n->fetch_add(1, std::memory_order_relaxed);
+		}
+	};
+} // namespace PerfAttr
