+// PR's applyAccurateBinaryMACOp / ...Broadcast collapsed into one helper: this tree has no
+// MACOpDst/_getDst<> template machinery (it predates the upstream refactor), so the
+// destination and the four "other operand" lanes are passed in explicitly. Feeding the same
+// value into all four lanes reproduces the broadcast form exactly.
+template <PS2Float (*Fn)(u32, u32)>
+static __fi void vuSoftBinaryMAC(VURegs* VU, VECTOR* dst, u32 bx, u32 by, u32 bz, u32 bw)
+{
+	if (_X) { dst->i.x = VU_MACx_UPDATE(VU, Fn(VU->VF[_Fs_].i.x, bx)); } else VU_MACx_CLEAR(VU);
+	if (_Y) { dst->i.y = VU_MACy_UPDATE(VU, Fn(VU->VF[_Fs_].i.y, by)); } else VU_MACy_CLEAR(VU);
+	if (_Z) { dst->i.z = VU_MACz_UPDATE(VU, Fn(VU->VF[_Fs_].i.z, bz)); } else VU_MACz_CLEAR(VU);
+	if (_W) { dst->i.w = VU_MACw_UPDATE(VU, Fn(VU->VF[_Fs_].i.w, bw)); } else VU_MACw_CLEAR(VU);
+	VU_STAT_UPDATE(VU);
+}
