@@ -179,6 +179,26 @@ void eeRecompileCodeRC2(R5900FNPTR constcode, R5900FNPTR_INFO noconstcode, int x
 			eeFPURecompileCode(rec##fn##_xmm, R5900::Interpreter::OpcodeImpl::COP1::fn, xmminfo); \
 	}
 
+// Soft-float (PS2Float) routing -- backport of PCSX2 PR #12001 + Goatman13's
+// "int_fallback_fpu_cop2" approach (PCSX2 issue #2990). `softcheck` is evaluated at block
+// *compile* time, so when the option is off this emits byte-for-byte the same code as
+// FPURECOMPILE_CONSTCODE above and costs nothing at emulation time. When it is on, the
+// block calls the COP1 interpreter op, whose body is the soft-float implementation.
+#define FPURECOMPILE_CONSTCODE_SOFT(fn, xmminfo, softcheck) \
+	void rec##fn(void) \
+	{ \
+		if (softcheck) \
+		{ \
+			iFlushCall(FLUSH_INTERPRETER); \
+			xFastCall((void*)(uptr)R5900::Interpreter::OpcodeImpl::COP1::fn); \
+			return; \
+		} \
+		if (CHECK_FPU_FULL) \
+			eeFPURecompileCode(DOUBLE::rec##fn##_xmm, R5900::Interpreter::OpcodeImpl::COP1::fn, xmminfo); \
+		else \
+			eeFPURecompileCode(rec##fn##_xmm, R5900::Interpreter::OpcodeImpl::COP1::fn, xmminfo); \
+	}
+
 // rd = rs op rt (all regs need to be in xmm)
