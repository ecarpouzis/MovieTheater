+	if (_W) { dst->i.w = VU_MACw_UPDATE(VU, Fn(VU->ACC.i.w, VU->VF[_Fs_].i.w, bw)); } else VU_MACw_CLEAR(VU);
+	VU_STAT_UPDATE(VU);
