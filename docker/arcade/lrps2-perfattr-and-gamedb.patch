+	//   ee_cpu ~ wall  -> the EE thread is genuinely compute-bound
+	//   gs_cpu ~ wall  -> the GS/libretro thread is genuinely compute-bound
+	//   both  << wall while ticks sag -> neither is working: a scheduling/wait pathology
+	{
+		static unsigned s_perfattr_frames = 0;
+		if (++s_perfattr_frames >= 300)
+		{
+			s_perfattr_frames = 0;
+			constexpr double ms = 1.0 / 1000000.0;
+			double wall_ms = 0.0, ee_cpu_ms = 0.0, gs_cpu_ms = 0.0;
+			{
+				static std::chrono::steady_clock::time_point s_prev_wall = std::chrono::steady_clock::now();
+				const auto now = std::chrono::steady_clock::now();
+				wall_ms = std::chrono::duration_cast<std::chrono::microseconds>(now - s_prev_wall).count() / 1000.0;
+				s_prev_wall = now;
+#ifdef _WIN32
+				static unsigned long long s_prev_ee = 0, s_prev_gs = 0;
+				auto cpu100 = [](HANDLE h) -> unsigned long long {
+					FILETIME c, e, k, u;
+					if (!GetThreadTimes(h, &c, &e, &k, &u))
+						return 0;
+					return ((static_cast<unsigned long long>(k.dwHighDateTime) << 32) | k.dwLowDateTime) +
+					       ((static_cast<unsigned long long>(u.dwHighDateTime) << 32) | u.dwLowDateTime);
+				};
+				const unsigned long long ee = cpu_thread.joinable() ? cpu100(static_cast<HANDLE>(cpu_thread.native_handle())) : 0;
+				const unsigned long long gs = cpu100(GetCurrentThread());
+				ee_cpu_ms = (ee - s_prev_ee) / 10000.0;
+				gs_cpu_ms = (gs - s_prev_gs) / 10000.0;
+				s_prev_ee = ee;
+				s_prev_gs = gs;
+#endif
+			}
+			log_cb(RETRO_LOG_INFO,
+				"[perf-attr] wall=%.0fms ee_cpu=%.0fms gs_cpu=%.0fms gsidle=%.0fms xfer=%.1fms(n=%llu) hash=%.1fms(n=%llu) mainloop=%.1fms vidpush=%.1fms vswait=%.1fms fifo=%.1fms(n=%llu) compile=%.1fms(n=%llu) binload=%.1fms(n=%llu) texmap=%.1fms(n=%llu) texunmap=%.1fms texupd=%.1fms(n=%llu)\n",
+				wall_ms, ee_cpu_ms, gs_cpu_ms,
+				PerfAttr::gsidle_ns.exchange(0) * ms,
+				PerfAttr::xfer_ns.exchange(0) * ms,
+				static_cast<unsigned long long>(PerfAttr::xfer_n.exchange(0)),
+				PerfAttr::hash_ns.exchange(0) * ms,
+				static_cast<unsigned long long>(PerfAttr::hash_n.exchange(0)),
+				PerfAttr::mainloop_ns.exchange(0) * ms,
+				PerfAttr::vidpush_ns.exchange(0) * ms,
+				PerfAttr::vswait_ns.exchange(0) * ms,
+				PerfAttr::fifowait_ns.exchange(0) * ms,
+				static_cast<unsigned long long>(PerfAttr::fifowait_n.exchange(0)),
+				PerfAttr::compile_ns.exchange(0) * ms,
+				static_cast<unsigned long long>(PerfAttr::compile_n.exchange(0)),
+				PerfAttr::binload_ns.exchange(0) * ms,
+				static_cast<unsigned long long>(PerfAttr::binload_n.exchange(0)),
+				PerfAttr::texmap_ns.exchange(0) * ms,
+				static_cast<unsigned long long>(PerfAttr::texmap_n.exchange(0)),
+				PerfAttr::texunmap_ns.exchange(0) * ms,
+				PerfAttr::texupd_ns.exchange(0) * ms,
+				static_cast<unsigned long long>(PerfAttr::texupd_n.exchange(0)));
+		}
+	}
 }
 
