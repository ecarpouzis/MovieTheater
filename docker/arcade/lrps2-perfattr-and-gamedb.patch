+// Soft-float (PS2Float) routing for the COP2 (VU0 macro-mode) FMAC/FDIV ops -- backport of
+// PCSX2 PR #12001 plus Goatman13's "int_fallback_fpu_cop2" approach (PCSX2 issue #2990).
+//
+// The check runs at block *compile* time, so with the option off this macro emits byte-for-
+// byte what REC_COP2_mVU0 emitted before. With it on, the op is handed to the COP2
+// interpreter entry point (VUops.cpp V##f -> _vu##f), whose body is the soft-float path.
+//
+// IMPORTANT: this variant is used for *exactly* the ops whose mode has bit 0x10 (writes
+// status/mac). setupMacroOp/endMacroOp implement a "denormalized status flag lives in
+// memory between two macro ops" protocol driven by EEINST_COP2_{,DE}NORMALIZE_STATUS_FLAG.
+// Diverting every 0x10 op at once keeps that protocol coherent: no macro op writes a
+// denormalized flag and no macro op reads one back, and the interpreter's SYNCMSFLAGS()
+// always leaves VI[REG_STATUS_FLAG] normalized. Diverting only *some* of them would break it.
+#define REC_COP2_mVU0_SOFT(f, opName, mode) \
+	void recV##f(void) \
+	{ \
+		if (CHECK_VU_SOFT(0)) \
+		{ \
+			iFlushCall(FLUSH_FOR_POSSIBLE_MICRO_EXEC); \
+			xADD(ptr64[&cpuRegs.cycle], scaleblockcycles_clear()); \
+			recCall(V##f); \
+			return; \
+		} \
+		int _mode = (mode); \
+		setupMacroOp(_mode, opName); \
+		if (_mode & 4) \
+		{ \
+			mVU_##f(microVU0, 0); \
+			if (!microVU0.prog.IRinfo.info[0].lOp.isNOP) \
+			{ \
+				mVU_##f(microVU0, 1); \
+			} \
+		} \
+		else \
+		{ \
+			mVU_##f(microVU0, 1); \
+		} \
+		endMacroOp(_mode); \
+	}
+
