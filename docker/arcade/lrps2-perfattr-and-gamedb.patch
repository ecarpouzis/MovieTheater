+	if (_W) { VU->ACC.i.w = VU_MACw_UPDATE(VU, Fn(VU->ACC.i.w, VU->VF[_Fs_].i.w, bw, IsOverflowSet(VU, 0))); } else VU_MACw_CLEAR(VU);
