-    pi->regs[PI_CART_ADDR_REG] = (pi->regs[PI_CART_ADDR_REG] + length + 1) & ~1;
+    /* MT PATCH: the stock writeback ROUNDS THE END ADDRESS UP TO EVEN ("+ 1) & ~1"), which silently
+     * re-aligns the register after every transfer. Honouring the odd address at DMA time but then
