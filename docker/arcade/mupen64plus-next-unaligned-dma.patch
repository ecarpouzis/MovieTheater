diff --git a/mupen64plus-core/src/device/cart/cart_rom.h b/mupen64plus-core/src/device/cart/cart_rom.h
index 2bba5a3..77d615d 100644
--- a/mupen64plus-core/src/device/cart/cart_rom.h
+++ b/mupen64plus-core/src/device/cart/cart_rom.h
@@ -41,9 +41,21 @@ struct cart_rom
     struct pi_controller* pi;
 };
 
+/* MT PATCH: 0x03fffffc -> 0x07fffffc, the THIRD mask of the 128 MiB cart-ROM raise.
+ *
+ * There are three, and missing this one is silent. cart_rom.c's CART_ROM_ADDR_MASK covers PI *DMA*
+ * (how a game normally streams itself in) and memory.h's CART_ROM_MAX_SIZE covers the load-time size
+ * gate — but this is the mask for a *direct CPU load* out of cart space, and it lived in the header
+ * rather than next to the other two. Raise the first two alone and a >64 MiB ROM loads, runs at full
+ * speed, and quietly reads the START of itself whenever it touches its own data above the 64 MiB
+ * line: OoT 4 Player Edition (64 MiB + 16,896 B) boots, holds 60 ticks/s with audio, and never draws
+ * a frame, because the bytes the hack appended wrap to the ROM header.
+ *
+ * The low two bits stay masked off (word alignment) — that is 0x...fc, not 0x...ff. Keep all three
+ * masks in step; see the notes in cart_rom.c and memory.h. */
 static osal_inline uint32_t rom_address(uint32_t address)
 {
-    return (address & 0x03fffffc);
+    return (address & 0x07fffffc);
 }
 
 void init_cart_rom(struct cart_rom* cart_rom,
diff --git a/mupen64plus-core/src/device/memory/memory.h b/mupen64plus-core/src/device/memory/memory.h
