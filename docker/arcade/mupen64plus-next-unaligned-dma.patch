 enum { RDRAM_MAX_SIZE = 0x800000 };
-enum { CART_ROM_MAX_SIZE = 0x4000000 };
+/* MT PATCH: 64 MiB -> 128 MiB. Identical change, identical reasoning, to the one in parallel_n64
+ * (see the long note on CART_ROM_MAX_SIZE in that core's device/memory/m64p_memory.h). Both cores
+ * are mupen64plus-core forks and BOTH shipped the same 0x4000000 cap and the same
+ * `ParamInt > CART_ROM_MAX_SIZE` assert in api/frontend.c, so switching cores was never a
+ * workaround for an over-64 MiB romhack — it failed the same way on each. Patched here too so the
+ * default N64 core is not the odd one out: a title that only boots on one core is a support trap,
+ * and OoT "4 Player Edition" (64 MiB + 16,896 B) and b3313 (96 MiB) are mainstream enough to be
+ * tried on whatever core a room happens to pick.
+ * MUST be kept in step with CART_ROM_ADDR_MASK in device/cart/cart_rom.c. */
+enum { CART_ROM_MAX_SIZE = 0x8000000 };
