@@ -18389,7 +18389,31 @@ char inifile[] =
 "\n"
 "[A76B619EC832A7E2ABCFBDFEB5375E39]\n"
 "GoodName=Mario Artist Paint Studio (J) (1999-02-11 Proto)\n"
-"CountPerOp=1\n";
+"CountPerOp=1\n"
+/* MT PATCH: OoT romhacks built on the Master Quest DEBUG ROM.
+ *
+ * This database is NOT a file you can edit — retro_init() does copy_file(inifile, "mupen64plus.ini")
+ * with fopen(...,"w"), so it rewrites the system-dir copy from this string at EVERY core init. An
+ * edit on disk survives until the next room start and no further. Entries must be added HERE.
+ *
+ * Why these hacks need an entry at all: an unrecognised ROM falls through to open_rom()'s else
+ * branch, whose comment reads "There's no way to guess the save type, but 4K EEPROM is better than
+ * nothing" — and OoT uses SRAM. Given a save chip that isn't there, the game boots, holds a steady
+ * 60 ticks/s with audio, and never draws a frame. The base ROM works only because it is recognised.
+ *
+ * They cannot fall back to the base entry either: a hack keeps the base's header CRC, and
+ * ini_search_by_crc() deliberately returns NULL when a CRC is ambiguous — 917D18F6 69BC5453 is
+ * already shared by the "(Debug Version)" and "(Debug Version) [f2]" entries. So MD5 is the only
+ * key that can work, and every hack needs its own line. */
+"\n"
+"[30E9434D818732C60020E62BE4091BA1]\n"
+"GoodName=Legend of Zelda, The - Ocarina of Time (USA) - 4 Player Edition [Hack]\n"
+"CRC=917D18F6 69BC5453\n"
+"Status=4\n"
+"Players=4\n"
+"SaveType=SRAM\n"
+"Rumble=Yes\n"
+"Mempak=Yes\n";
 
 #endif
 
