+ * Mirrors Project64's per-game "Unaligned DMA" setting, which masks the same single bit
+ * (Source/Project64-core/N64System/MemoryHandler/PeripheralInterfaceHandler.cpp). */
+extern uint32_t AllowUnalignedDMA;
+#define PI_CART_ADDR_ALIGN_MASK (AllowUnalignedDMA ? ~UINT32_C(0) : ~UINT32_C(1))
