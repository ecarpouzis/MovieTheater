diff --git a/libretro/libretro.c b/libretro/libretro.c
index 7665666..5ef8309 100644
--- a/libretro/libretro.c
+++ b/libretro/libretro.c
@@ -18,6 +18,12 @@
  *   51 Franklin Street, Fifth Floor, Boston, MA 02110-1301, USA.          *
  * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
 
+/* MT BUILD FIX (not part of the unaligned-DMA feature): the netplay path below calls rand_s()
+ * under #ifdef __MINGW32__, but MinGW-w64 only DECLARES rand_s when _CRT_RAND_S is defined before
+ * <stdlib.h>. Upstream builds on an older GCC where the resulting implicit declaration was just a
+ * warning; GCC 14+ makes it a hard error. Must precede the stdlib.h include below. */
+#define _CRT_RAND_S
+
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -219,6 +225,9 @@ uint32_t CountPerOpDenomPot = 0;
 uint32_t CountPerScanlineOverride = 0;
 uint32_t ForceDisableExtraMem = 0;
 uint32_t IgnoreTLBExceptions = 0;
+/* MT PATCH: honour odd (unaligned) PI cart addresses instead of force-aligning them.
+ * Read by mupen64plus-core/src/device/rcp/pi/pi_controller.c. Default 0 = stock behaviour. */
+uint32_t AllowUnalignedDMA = 0;
 
 extern struct device g_dev;
 extern unsigned int r4300_emumode;
@@ -1472,6 +1481,17 @@ static void update_variables(bool startup)
           CountPerOpDenomPot = atoi(var.value);
        }
 
+       /* MT PATCH: unaligned PI DMA. Some romhacks (SM64: Last Impact) program an ODD
+        * PI_CART_ADDR_REG; stock mupen clears bit 0, so the transfer lands one byte off and the
+        * CPU executes garbage seconds later (`reserved opcode` -> `error in ERET`). Project64
+        * gates the same bit behind its per-game "Unaligned DMA" setting; this is that switch. */
+       var.key = CORE_NAME "-AllowUnalignedDMA";
+       var.value = NULL;
+       if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
+       {
+          AllowUnalignedDMA = !strcmp(var.value, "True") ? 1 : 0;
+       }
+
        if(EnableFullspeed)
        {
           CountPerOp = 1; // Force CountPerOp == 1
