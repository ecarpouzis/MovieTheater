 #include "Common/StringUtils.h"
 #include "Common/File/Path.h"
 
-#if defined(_WIN32) && !defined(USING_QT_UI)
+// MT PATCH: guard mismatch with our own header — draw_text_uwp.h declares TextDrawerUWP under
+//   #if defined(_WIN32) && !defined(USING_QT_UI) && !defined(__LIBRETRO__)
+// while this body was compiled under the same condition MINUS the __LIBRETRO__ exclusion. So a
+// Windows libretro build compiles the implementation of a class its header never declared, and every
+// member reference is an undeclared identifier. Match the header. (Upstream break; nothing to do with
+// the MachineContext change.)
+#if defined(_WIN32) && !defined(USING_QT_UI) && !defined(__LIBRETRO__)
 
 #include <string>
 
