@@ -119,7 +135,12 @@ static void dma_pi_write(struct pi_controller* pi)
     pi->regs[PI_STATUS_REG] |= PI_STATUS_DMA_BUSY;
     /* Update PI_DRAM_ADDR_REG and PI_CART_ADDR_REG */
