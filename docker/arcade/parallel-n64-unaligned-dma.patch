@@ -225,6 +225,10 @@ float    screen_aspect_ratio        = 4.0 / 3.0;
 uint32_t screen_pitch               = 0;
 uint32_t screen_aspectmodehint;
 uint32_t send_allist_to_hle_rsp     = 0;
+/* MT PATCH: the mirror of send_allist_to_hle_rsp — route AUDIO (type 2) tasks to the ACCURATE (LLE) RSP
+ * while GRAPHICS stay on HLE. The only way to pair an HLE graphics plugin (glide64, which romhacks need)
+ * with accurate audio microcode; consumed by plugin.c plugin_start_rsp. Off = upstream behaviour. */
+uint32_t send_alist_to_lle_rsp      = 0;
 /* Set from the ROM header for titles whose audio microcode use cannot be
  * HLE'd faithfully; consulted by plugin_rsp_init (plugin.c). */
 unsigned int FAKE_SDL_TICKS         = 0;
@@ -1526,6 +1530,18 @@ void update_variables(bool startup)
    else
       send_allist_to_hle_rsp = false;
 
+   /* MT PATCH: mirror option — audio on the ACCURATE RSP while graphics stay HLE. See plugin.c for the
+    * evidence trail; short version: the HLE audio microcode crackles on SM64: Last Impact's custom music,
+    * an HLE graphics plugin is required for its rendering, and Project64 (which sounds right) ships
+    * exactly this split. Read every update_variables, so it can be flipped per-room. */
+   var.key   = "parallel-n64-send_alist_to_lle_rsp";
+   var.value = NULL;
+
+   if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
+      send_alist_to_lle_rsp = !strcmp(var.value, "enabled") ? 1 : 0;
+   else
+      send_alist_to_lle_rsp = 0;
+
    var.key   = "parallel-n64-screensize";
    var.value = NULL;
 
@@ -2057,6 +2073,19 @@ void update_variables(bool startup)
       AllowUnalignedDMA = !strcmp(var.value, "False") ? 0 : 1;
    }
 
+   /* MT PATCH: Count Per Op (COP0 counter factor). The global below has always existed and the core
+    * has always consumed it (main.c: count_per_op = CountPerOp, falling back to the per-ROM database
+    * when <= 0) — nothing ever assigned it, so this core silently had no counter-factor control.
+    * 0 preserves the old behaviour exactly (defer to the ROM database). Project64 pins Counter
+    * Factor=1 for the SM64 romhacks that need it; without this option, honouring that on OUR stack
+    * meant switching to mupen64plus_next and giving up Glide64, which only this core has. */
+   var.key = CORE_NAME "-countperop";
+   var.value = NULL;
+   if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
+   {
+      CountPerOp = (uint32_t)atoi(var.value);
+   }
+
    var.key = CORE_NAME "-allow-large-roms";
    var.value = NULL;
    if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
