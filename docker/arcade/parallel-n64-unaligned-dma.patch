+/* MT PATCH: set from the libretro "Audio Processing (LLE RSP)" core option — the mirror of the above.
+ * Routes audio (type 2) tasks to the ACCURATE RSP while graphics stay on HLE, which is the only way to
+ * pair an HLE graphics plugin (glide64, needed for romhack rendering) with accurate audio microcode. */
+extern uint32_t send_alist_to_lle_rsp;
 
 
 
