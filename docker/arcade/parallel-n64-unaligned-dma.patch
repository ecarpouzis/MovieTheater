 extern uint32_t send_allist_to_hle_rsp;
+/* MT PATCH: set from the libretro "Audio Processing (LLE RSP)" core option — the mirror of the above.
+ * Routes audio (type 2) tasks to the ACCURATE RSP while graphics stay on HLE, which is the only way to
+ * pair an HLE graphics plugin (glide64, needed for romhack rendering) with accurate audio microcode. */
+extern uint32_t send_alist_to_lle_rsp;
 
 
 
@@ -307,6 +311,37 @@ static m64p_error plugin_start_rsp(void)
         rsp_hle.initiateRSP(rsp_info, NULL);
         rsp_audio = rsp_hle;
     }
+    /* MT PATCH: the MIRROR of the branch above — graphics HLE, audio LLE.
+     *
+     * WHY: an HLE GRAPHICS plugin (glide64/GLideN64/rice) needs the RSP to hand it display lists, which
+     * forces the active RSP to HLE — and that drags AUDIO onto the HLE audio microcode too. For most
+     * games that is fine; for SM64: Last Impact the HLE audio microcode renders its custom music with a
+     * constant crackle. Proven three ways: BAZR (another SM64 hack) is clean on the LLE RSP; switching
+     * this game to rspplugin=parallel removed the crackle entirely (and broke graphics, because the LLE
+     * RSP consumes the graphics tasks); and Project64 — which sounds correct — ships exactly this split,
+     * m_AudioHle(false) + m_GraphicsHle(true) in its own RSP core.
+     *
+     * A raw pre-encode PCM capture ruled out the whole delivery chain first (0 clicks, 0 clipping, 0
+     * held-sample runs), as did client jitter buffer 80/400 ms, Opus frame-size 10/20, loss resilience
+     * and bitrate, codec, and a pacer measured flat — so the microcode was the only remaining producer.
+     *
+     * Everything needed was already here: rsp_core.c dispatches task type 2 to rsp_audio unconditionally,
+     * whichever RSP is active. So we only re-point rsp_audio. paraLLEl-RSP is preferred (a recompiler, it
+     * runs the real audio microcode fast); cxd4 is the fallback when parallel is not compiled in.
+     * NOTE the comment above about LLE plugins "not emulating audio" is upstream's and is WRONG for
+     * paraLLEl-RSP — it executes whatever microcode the game uploads, audio included. Measured, not assumed. */
+    else if (send_alist_to_lle_rsp && current_rsp_type == RSP_PLUGIN_HLE)
+    {
+        /* cxd4, NOT paraLLEl-RSP, and the choice is load-bearing. paraLLEl-RSP is a recompiler with its
+         * own threading and lifecycle; initialised as a SECONDARY alongside an active HLE RSP it hung the
+         * game a few frames into boot (measured 2026-07-30 — the room started, logged no error, and never
+         * produced a pace-diag window). cxd4 is a plain self-contained software interpreter, which is the
+         * same shape as the lightweight secondary upstream uses in the mirror branch above (rsp_hle).
+         * It costs more CPU than paraLLEl-RSP would, but it is only running audio lists. */
+        rsp_cxd4.initiateRSP(rsp_info, NULL);
+        rsp_audio = rsp_cxd4;
+        DebugMessage(M64MSG_INFO, "audio RSP: cxd4 (LLE) while graphics stay on HLE [send_alist_to_lle_rsp]");
+    }
     else
     {
         rsp_audio = rsp;
