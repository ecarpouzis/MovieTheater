 void ServiceFrameworkBase::RegisterHandlersBase(const FunctionInfoBase* functions, std::size_t n) {
-    handlers.reserve(handlers.size() + n);
+    const std::size_t before = handlers.size();
+    handlers.reserve(before + n);
     for (std::size_t i = 0; i < n; ++i) {
         // Usually this array is sorted by id already, so hint to insert at the end
         handlers.emplace_hint(handlers.cend(), functions[i].command_id, functions[i]);
     }
+    // MovieTheater guard: this table is the entire HLE dispatch surface, and MSVC has silently
+    // dropped entries here before (constexpr FunctionInfo + a null handler miscompiled; see
+    // service.h). A handler count that does not match the table means services are half-registered
+    // and the guest WILL fatal-error on boot with a black screen — say so loudly once, at startup,
+    // instead of leaving it to be rediscovered from a 3DS error code.
+    if (handlers.size() != before + n) {
+        LOG_CRITICAL(Service,
+                     "{}: registered {} of {} handlers (duplicate/garbage command ids) — the "
+                     "handler table was miscompiled; HLE dispatch is broken for this service.",
+                     service_name, handlers.size() - before, n);
+    }
 }
 
