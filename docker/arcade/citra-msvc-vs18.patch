+    // MovieTheater: base AND max track citra_resolution_factor. At factor N the DEFAULT top-bottom
+    // layout renders/presents 400N x 480N (UpdateLayout in libretro_window.cpp: baseX =
+    // kScreenTopWidth * scaling, baseY = (kScreenTopHeight + kScreenBottomHeight) * scaling), and
+    // video_cb reports that size every frame.
+    //   * WHY base = max, not base < max: the frontend's GL hw-render FBO is allocated ONCE from
+    //     max_width/max_height and never grows (SetBuffer only resizes the CPU readback buffer), so a
+    //     max smaller than the render clips it to black — which is exactly what a hardcoded 400x480
+    //     did to a 2x render. It must be >= the largest frame citra will draw.
+    //   * WHY NOT the old max = base*10: on the VULKAN path the synthetic surface is sized from max
+    //     while the capture reads back at base, so max >> base captured only the top-left corner (the
+    //     black-stream bug). max == the real render size keeps BOTH paths correct.
+    // So max = base = the current factor's exact output. UpdateSettings() runs during
+    // retro_load_game, before the frontend calls this, so resolution_factor is already applied.
+    const unsigned factor = std::max(1u, static_cast<unsigned>(Settings::values.resolution_factor.GetValue()));
+    info->geometry.base_width = 400 * factor;
+    info->geometry.base_height = 480 * factor;
+    info->geometry.max_width = 400 * factor;
+    info->geometry.max_height = 480 * factor;
+    // Aspect is factor-invariant (400/480 = 0.833). Stock reported 0, and our client falls back to
+    // 4:3 on a 0, which stretched the stacked screens ~1.6x horizontally (1.332 vs 0.833).
+    info->geometry.aspect_ratio = 400.0f / 480.0f;
 }
