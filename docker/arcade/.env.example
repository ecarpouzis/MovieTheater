# Copy to .env and fill in. Consumed by docker-compose.yml.

# The CloudRetro image we own, built from a pinned commit (see README.md → "Building the image").
ARCADE_IMAGE=movietheater/cloud-game:pinned

# Ziggy's public IP (or DDNS-resolved address). WebRTC ICE advertises THIS so candidates point at the
# right host instead of the Docker-internal IP. Must match the router's UDP forward target.
ZIGGY_PUBLIC_IP=203.0.113.10

# The site origin that opens the signaling WebSocket (defense-in-depth Origin check).
SITE_ORIGIN=https://theater.carpouzis.com

# All arcade data lives under one root on Ziggy's FAST local disk (the 990 PRO NVMe, D:) — NOT the
# repo drive (F: is a spinning HDD) and NOT the L: NAS. Live PSX disc images are read random-access
# by the emulator during play, so the ROM mount wants the SSD. Layout: roms/ saves/ bios/ savestore/.
#   D:\ArcadeStorage\roms       -> /roms  (ro)  per-system subfolders; JIT extracts land here
#   D:\ArcadeStorage\saves      -> /saves (rw)  CloudRetro's working save dir
#   D:\ArcadeStorage\bios       -> the libretro system dir (ro)  PS1 scph*.bin
#   D:\ArcadeStorage\savestore  -> durable per-user saves (gateway-owned; see docs/arcade-saves-plan.md)

# ROM library root. Holds per-system subfolders: nes, snes, genesis, gb, gbc, gba, n64, psx, arcade.
# Mounted read-only into the workers.
ROMS_DIR=D:\ArcadeStorage\roms

# CloudRetro's working save-state dir (read-write). The durable per-user store (savestore/) is
# separate and gateway-managed; this dir is just the emulator's live scratch. Back both up.
SAVES_DIR=D:\ArcadeStorage\saves

# PS1 BIOS dir (scph1001.bin / scph5501.bin). Mounted read-only at the core's libretro system dir.
BIOS_DIR=D:\ArcadeStorage\bios
