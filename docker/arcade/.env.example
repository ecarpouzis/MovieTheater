# Copy to .env and fill in. Consumed by docker-compose.yml.

# The CloudRetro image we own, built from a pinned commit (see README.md → "Building the image").
ARCADE_IMAGE=movietheater/cloud-game:pinned

# Ziggy's public IP (or DDNS-resolved address). WebRTC ICE advertises THIS so candidates point at the
# right host instead of the Docker-internal IP. Must match the router's UDP forward target.
ZIGGY_PUBLIC_IP=203.0.113.10

# The site origin that opens the signaling WebSocket (defense-in-depth Origin check).
SITE_ORIGIN=https://theater.carpouzis.com

# ROM library root on Ziggy local disk (NOT the L: NAS). Holds per-system subfolders: nes, snes,
# genesis, gb, gbc, gba, n64, psx, arcade. Mounted read-only into the workers.
ROMS_DIR=D:\Arcade\roms

# Save-state dir (read-write; add to Ziggy's backup routine).
SAVES_DIR=D:\Arcade\saves
