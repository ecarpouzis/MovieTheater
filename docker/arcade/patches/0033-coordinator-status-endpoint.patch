+// handleStatus (patch 0033) reports each connected worker's occupancy as JSON for the
+// GL-worker watchdog (scripts/watch-arcade-glworkers.ps1). Detection contract: a worker
+// whose room is non-empty MUST be emitting emulator ticks (pace-diag lines every 5 s in
+// its log); "busy here + silent log" = the room-close wedge -> the watchdog recycles it.
+// NOTE Port is the worker's HTTP port from the handshake (9000/9001...), NOT the UDP
+// single-port -- the watchdog maps a busy Room to its worker via the room id in the
+// worker logs, never via this field.
+func (h *Hub) handleStatus() http.HandlerFunc {
+	return func(w http.ResponseWriter, _ *http.Request) {
+		type workerStatus struct {
+			Addr string `json:"addr"`
+			Port string `json:"port"`
+			Zone string `json:"zone"`
+			Room string `json:"room"`
+			Free bool   `json:"free"`
+		}
+		out := []workerStatus{}
+		for wk := range h.workers.Values() {
+			out = append(out, workerStatus{
+				Addr: wk.Addr, Port: wk.Port, Zone: wk.Zone,
+				Room: wk.RoomId, Free: wk.HasSlot(),
+			})
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(out)
+	}
+}
