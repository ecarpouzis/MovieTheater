+
+// SetVideoBitrate live-sets the video encoder's target bitrate. This is the whole reason ABR is cheap
+// here: nvh264enc/x264enc expose `bitrate` (kbit/s) as "changeable in the PLAYING state", so NVENC
+// reconfigures its rate controller in place — no pipeline rebuild, no renegotiation, no reconnect, and
+// (unlike a RESOLUTION change, which re-inits the pipeline via Reinit) nothing the viewer can see.
+// vpx names the property differently and takes bit/s.
+//
+// Safe to call before the pipeline exists: the value is remembered and applied by initVideo.
+func (g *GstMediaPipe) SetVideoBitrate(kbps int) error {
+	if kbps <= 0 {
+		return nil
+	}
+	g.vBitrate.Store(int64(kbps))
+	v := g.v
+	if v == nil || v.enc == nil {
+		return nil
+	}
+	switch strings.ToLower(g.conf.Video.Codec) {
+	case "vp8", "vp9":
+		return v.enc.SetProperty("target-bitrate", kbps*1000)
+	default: // h264 (nvh264enc / x264enc)
+		return v.enc.SetProperty("bitrate", uint(kbps))
+	}
+}
+
+// VideoBitrate is the ABR target currently applied (kbps), or 0 if ABR never set one.
+func (g *GstMediaPipe) VideoBitrate() int { return int(g.vBitrate.Load()) }
