diff --git a/pkg/worker/abr.go b/pkg/worker/abr.go
new file mode 100644
index 0000000..b71d32d
--- /dev/null
+++ b/pkg/worker/abr.go
@@ -0,0 +1,113 @@
+package worker
+
+import (
+	"time"
+
+	"github.com/giongto35/cloud-game/v3/pkg/logger"
+	"github.com/giongto35/cloud-game/v3/pkg/worker/media"
+	"github.com/giongto35/cloud-game/v3/pkg/worker/room"
+)
+
+// Adaptive bitrate for a room's single video encoder (arcade ABR, patch 0021).
+//
+// Why this is cheap: nvh264enc's `bitrate` is "changeable in the PLAYING state", so a rung costs one
+// property set — no pipeline rebuild, no renegotiation, no reconnect, nothing the player sees. Only
+// bitrate is adapted; changing RESOLUTION would re-init the pipeline (a visible glitch), so we don't.
+//
+// Why the MINIMUM across peers: one encoder serves the whole room. The stream can only be as good as
+// the worst receiver can carry, so a single friend on hotel wifi throttles everyone. That is inherent
+// to shared-room emulation, not a bug.
+//
+// Why we probe upward instead of trusting the estimate: GCC is a congestion DETECTOR. Its estimate can
+// never exceed what we actually send (you cannot measure capacity you never use), so simply following
+// the estimate would pin the room forever at its starting bitrate. Instead we treat "estimate is
+// keeping up with what we send" as permission to send more, and back off hard the moment it isn't.
+const (
+	abrTick = time.Second
+
+	abrFloorKbps = 1500 // below this the picture is worse than a stall; give up adapting
+	abrStartKbps = 6000 // conservative opener; a healthy LAN reaches a 14 Mbps ceiling in ~7 ticks
+
+	abrRampPct    = 15 // healthy: raise the target by this much per tick
+	abrHealthyPct = 95 // estimate >= 95% of what we send  => the link is keeping up
+	abrBackoffPct = 85 // estimate <  85% of what we send  => congestion, drop to the estimate
+
+	abrMinStepKbps = 250 // don't bother with changes smaller than this
+)
+
+// bwePeer is the slice of *webrtc.Peer that ABR needs. Declared as an interface so this package does
+// not depend on the concrete session type (and so a peer without an estimator is simply skipped).
+type bwePeer interface{ TargetBitrateKbps() int }
+
+// startRoomAbr drives the room's encoder bitrate from the worst peer's send-side estimate.
+// ceilKbps is the room's chosen quality (the creator's t=104 bitrate, else the config default): ABR
+// never exceeds it, so "Auto" on the site still decides how good the room is allowed to look.
+func startRoomAbr(log *logger.Logger, r *room.Room[*room.GameSession], m *media.GstMediaPipe, ceilKbps int) {
+	if ceilKbps <= 0 || r == nil || m == nil {
+		return
+	}
+	floor := min(abrFloorKbps, ceilKbps)
+	cur := min(max(abrStartKbps, floor), ceilKbps)
+
+	if err := m.SetVideoBitrate(cur); err != nil {
+		log.Warn().Err(err).Msg("abr: encoder rejected the initial bitrate; ABR disabled for this room")
+		return
+	}
+	log.Info().Msgf("abr: start %d kbps (floor %d, ceiling %d)", cur, floor, ceilKbps)
+
+	go func() {
+		t := time.NewTicker(abrTick)
+		defer t.Stop()
+		for range t.C {
+			if r.Closed() {
+				log.Debug().Msg("abr: room closed")
+				return
+			}
+
+			worst, peers := 0, 0
+			for u := range r.Users().Values() {
+				p, ok := u.Session.(bwePeer)
+				if !ok {
+					continue
+				}
+				// 0 = not connected yet, or no TWCC feedback has arrived. Not an opinion.
+				if k := p.TargetBitrateKbps(); k > 0 {
+					peers++
+					if worst == 0 || k < worst {
+						worst = k
+					}
+				}
+			}
+			if peers == 0 {
+				continue // hold: nobody has told us anything yet
+			}
+
+			next := cur
+			switch {
+			case worst*100 < cur*abrBackoffPct:
+				next = worst // congestion: fall back to what the worst receiver says it can take
+			case worst*100 >= cur*abrHealthyPct && cur < ceilKbps:
+				next = cur + max(abrMinStepKbps, cur*abrRampPct/100) // healthy: probe upward
+			}
+			next = min(max(next, floor), ceilKbps)
+
+			if next == cur || abs(next-cur) < abrMinStepKbps {
+				continue
+			}
+			if err := m.SetVideoBitrate(next); err != nil {
+				log.Warn().Err(err).Msgf("abr: failed to set %d kbps", next)
+				continue
+			}
+			log.Info().Msgf("abr: %d -> %d kbps (worst peer estimate %d, ceiling %d, peers %d)",
+				cur, next, worst, ceilKbps, peers)
+			cur = next
+		}
+	}()
+}
+
+func abs(n int) int {
+	if n < 0 {
+		return -n
+	}
+	return n
+}
