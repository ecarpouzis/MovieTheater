@@ -176,3 +184,174 @@ func ReplaceTree(src, dst string) error {
 	}
 	return CopyTree(src, dst)
 }
+
+// ── File sets inside a shared directory (patch 0041: cards that are NOT a directory) ─────────────
+//
+// Some cores keep their card as loose files in a directory they share with data we must not touch:
+// flycast writes vmu_save_A1..D1.bin straight into the Dreamcast SYSTEM dir, next to dc_boot.bin
+// and dc_flash.bin. The whole-directory helpers above would vault the BIOS into every player's
+// card and overwrite it on seed, so these operate on a NAME PATTERN and never see anything else.
+
+// GlobFiles returns the files directly in dir whose base name matches pattern. Sub-directories are
+// ignored (never matched, never descended), and a missing dir is empty rather than an error.
+func GlobFiles(dir, pattern string) ([]string, error) {
+	if strings.ContainsAny(pattern, `/\`) {
+		return nil, errors.New("card pattern must be a bare file name, got " + pattern)
+	}
+	entries, err := os.ReadDir(dir)
+	if errors.Is(err, fs.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var out []string
+	for _, e := range entries {
+		if e.IsDir() {
+			continue
+		}
+		ok, err := filepath.Match(pattern, e.Name())
+		if err != nil {
+			return nil, err // a malformed pattern is a config bug: report it, don't silently match nothing
+		}
+		if ok {
+			out = append(out, filepath.Join(dir, e.Name()))
+		}
+	}
+	return out, nil
+}
+
+// CopyGlob copies the matching files from srcDir into dstDir, creating dstDir. Like CopyTree it
+// merges and never deletes — dstDir is a player's vault.
+func CopyGlob(srcDir, pattern, dstDir string) error {
+	files, err := GlobFiles(srcDir, pattern)
+	if err != nil {
+		return err
+	}
+	if len(files) == 0 {
+		return nil
+	}
+	if err := MakeDirAll(dstDir); err != nil {
+		return err
+	}
+	for _, f := range files {
+		if err := CopyFile(f, filepath.Join(dstDir, filepath.Base(f))); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// ClearGlob removes ONLY the matching files in dir. Whatever else lives there (the BIOS) survives.
+func ClearGlob(dir, pattern string) error {
+	files, err := GlobFiles(dir, pattern)
+	if err != nil {
+		return err
+	}
+	for _, f := range files {
+		if err := os.Remove(f); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// ReplaceGlob makes dstDir's matching files exactly srcDir's matching files, touching nothing else
+// in dstDir. Clearing first is what stops one player's card from surviving into another's session.
+func ReplaceGlob(srcDir, pattern, dstDir string) error {
+	if err := ClearGlob(dstDir, pattern); err != nil {
+		return err
+	}
+	return CopyGlob(srcDir, pattern, dstDir)
+}
+
+// ── Copying INTO the vault (patch 0041) ──────────────────────────────────────────────────────────
+//
+// Seeding overwrites blindly — the worker's card dir is scratch. Vaulting must not: it is the only
+// copy of a player's progress. Two rules:
+//
+//	newer-wins   A card left behind by a crashed worker gets recovered by whichever room runs next on
+//	             that worker, which can be LONG after the player moved to the other worker and saved
+//	             again. Recovering it must not overwrite the fresher card with the stale one.
+//	torn-writes  A harvest can run while the core is live and land in the middle of the core writing
+//	             its card. Rather than GUESS that a file which has been quiet for N seconds must be
+//	             finished — a bet on a number, and wrong the moment a core writes more slowly than
+//	             expected — copy it and then ASK whether it changed underneath us. If it did, the
+//	             copy is torn: throw it away and leave the vault's previous copy alone. The next
+//	             harvest (or the close harvest, when the core is provably stopped) takes it.
+// Unchanged reports whether a file looked the same before and after we read it. This is the whole
+// torn-write test: if the core rewrote the card while the harvest was copying it, the copy is a mix
+// of two states and must be thrown away. Asking the file is a fact; waiting N seconds and assuming
+// the core must be finished is a guess.
+func Unchanged(before, after os.FileInfo) bool {
+	return before.Size() == after.Size() && before.ModTime().Equal(after.ModTime())
+}
+
+func copyFileToVault(from, to string) (bool, error) {
+	src, err := os.Stat(from)
+	if err != nil {
+		return false, err
+	}
+	if dst, err := os.Stat(to); err == nil && !src.ModTime().After(dst.ModTime()) {
+		return false, nil // the vault already holds this card, or a newer one
+	}
+	if err := MakeDirAll(filepath.Dir(to)); err != nil {
+		return false, err
+	}
+
+	// Copy to a scratch name first so a torn read can never become the vault's copy.
+	tmp := to + ".part"
+	if err := CopyFile(from, tmp); err != nil {
+		_ = os.Remove(tmp)
+		return false, err
+	}
+	after, err := os.Stat(from)
+	if err != nil {
+		_ = os.Remove(tmp)
+		return false, err
+	}
+	if !Unchanged(src, after) {
+		// The core wrote to it while we were reading. Whatever we copied is a mix of two states.
+		_ = os.Remove(tmp)
+		return false, nil
+	}
+	if err := os.Rename(tmp, to); err != nil { // atomic within a volume: the vault never sees a half file
+		_ = os.Remove(tmp)
+		return false, err
+	}
+	_ = os.Chtimes(to, after.ModTime(), after.ModTime())
+	return true, nil
+}
+
+// CopyTreeNewer vaults a directory card: like CopyTree, but never replaces a vault file with an
+// older one, and discards any copy the core tore by writing to it mid-read.
+func CopyTreeNewer(src, dst string) error {
+	return filepath.WalkDir(src, func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if d.IsDir() {
+			return nil // directories are created on demand by the file copy below
+		}
+		rel, err := filepath.Rel(src, path)
+		if err != nil {
+			return err
+		}
+		_, err = copyFileToVault(path, filepath.Join(dst, rel))
+		return err
+	})
+}
+
+// CopyGlobNewer vaults a file-set card under the same two rules.
+func CopyGlobNewer(srcDir, pattern, dstDir string) error {
+	files, err := GlobFiles(srcDir, pattern)
+	if err != nil || len(files) == 0 {
+		return err
+	}
+	for _, f := range files {
+		if _, err := copyFileToVault(f, filepath.Join(dstDir, filepath.Base(f))); err != nil {
+			return err
+		}
+	}
+	return nil
+}
