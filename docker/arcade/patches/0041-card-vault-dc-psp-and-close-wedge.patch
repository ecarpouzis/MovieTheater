+// ── Glob cards (patch 0041) ─────────────────────────────────────────────────────────────────────
+//
+// The Dreamcast's VMUs live IN the BIOS directory. Every card operation therefore has to be able to
+// see the four vmu_save_*.bin files and nothing else — if any of these tests fail, the failure mode
+// in production is either "we copied the BIOS into a player's vault" or, far worse, "we overwrote
+// the BIOS with a player's vault".
+
+// dcDir builds a Dreamcast system dir: the real BIOS plus a VMU set.
+func dcDir(t *testing.T, vmuBody string) string {
+	t.Helper()
+	dir := t.TempDir()
+	write(t, filepath.Join(dir, "dc_boot.bin"), "BIOS")
+	write(t, filepath.Join(dir, "dc_flash.bin"), "FLASH")
+	write(t, filepath.Join(dir, "data", "syscalls.bin"), "DATA")
+	for _, v := range []string{"A1", "B1"} {
+		write(t, filepath.Join(dir, "vmu_save_"+v+".bin"), vmuBody+v)
+	}
+	return dir
+}
+
+func TestGlobFilesMatchesOnlyTheCard(t *testing.T) {
+	dir := dcDir(t, "card")
+	got, err := GlobFiles(dir, "vmu_save_*.bin")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 {
+		t.Fatalf("want the 2 VMUs, got %v", got)
+	}
+	for _, f := range got {
+		if filepath.Base(f) == "dc_boot.bin" || filepath.Base(f) == "data" {
+			t.Fatalf("the glob reached the BIOS: %v", f)
+		}
+	}
+	// A sub-directory must never be matched or descended, even by a pattern that would match it.
+	if got, err := GlobFiles(dir, "d*"); err != nil || len(got) != 2 {
+		t.Fatalf("want the 2 dc_*.bin files and NOT the data/ dir, got %v (%v)", got, err)
+	}
+}
+
+func TestCopyGlobVaultsTheCardAndNotTheBios(t *testing.T) {
+	dir := dcDir(t, "card")
+	vault := filepath.Join(t.TempDir(), "1", "dc")
+	if err := CopyGlob(dir, "vmu_save_*.bin", vault); err != nil {
+		t.Fatal(err)
+	}
+	if read(t, filepath.Join(vault, "vmu_save_A1.bin")) != "cardA1" {
+		t.Fatal("the VMU did not reach the vault")
+	}
+	if Exists(filepath.Join(vault, "dc_boot.bin")) || Exists(filepath.Join(vault, "data")) {
+		t.Fatal("the BIOS was copied into the player's vault")
+	}
+}
+
+func TestClearGlobLeavesTheBiosIntact(t *testing.T) {
+	dir := dcDir(t, "card")
+	if err := ClearGlob(dir, "vmu_save_*.bin"); err != nil {
+		t.Fatal(err)
+	}
+	if Exists(filepath.Join(dir, "vmu_save_A1.bin")) {
+		t.Fatal("the VMU survived the clear — the next player would inherit it")
+	}
+	if read(t, filepath.Join(dir, "dc_boot.bin")) != "BIOS" ||
+		read(t, filepath.Join(dir, "data", "syscalls.bin")) != "DATA" {
+		t.Fatal("clearing the card destroyed the BIOS")
+	}
+}
+
+// Seeding player B over player A's session must leave B holding B's card only — and must not
+// resurrect a VMU that B's vault doesn't have (A's C1 slot must not linger).
+func TestReplaceGlobSwapsPlayersWithoutBleed(t *testing.T) {
+	dir := dcDir(t, "playerA")
+	write(t, filepath.Join(dir, "vmu_save_C1.bin"), "playerA-C1")
+
