+// ── Per-user virtual memory cards (MovieTheater patch 0039) ──────────────────────────────────────
+//
+// A memory card is the one save class libretro never exposes: PCSX2 and Dolphin write theirs into
+// their own directories, so a card is ONE file shared by every player — outside the per-user vault,
+// with no backup. For some games that card IS the progress: Gauntlet Dark Legacy keeps its named
+// characters on the GameCube card, not in the save-state, so a player's characters were visible to
+// (and deletable by) everyone, and would vanish with the directory.
+//
+// The worker has to be the one to move them. The gateway can't: the COORDINATOR picks which worker
+// serves a room, so the gateway never knows whose card directory is in play. The worker knows its
+// own dirs and runs exactly one room at a time — which is also why each worker now needs its OWN
+// ConfDir (two workers sharing one would seed and harvest each other's cards).
+//
+// Only the CARD subtree moves. The save dir also holds Dolphin's shader caches (~850 MB), which are
+// shared, disposable, and regenerate — vaulting those per session would be absurd.
+
+// cardOwner parses the room id the site mints (sv-<user>-<game>-<slot>-<system>___<key>, ArcadeSaveId).
+// Returns ok=false for a stock random room id, which correctly means "no owner, leave cards alone".
+func cardOwner(roomId string) (user string, system string, ok bool) {
+	if !strings.HasPrefix(roomId, "sv-") {
+		return "", "", false
+	}
+	sep := strings.Index(roomId, "___")
+	if sep < 0 {
+		return "", "", false
+	}
+	parts := strings.SplitN(roomId[len("sv-"):sep], "-", 4)
+	if len(parts) != 4 || parts[0] == "" || parts[3] == "" {
+		return "", "", false
+	}
+	return parts[0], parts[3], true
+}
+
+// cardDir resolves the configured card directory for a system, e.g. "save:User/GC" ->
+// <saveDir>/User/GC. Empty when this system has no card (most cores) or the feature is off.
+func (f *Frontend) cardDir(system string) string {
+	if f.conf.CardVault == "" {
+		return ""
+	}
+	spec, ok := f.conf.Cards[system]
+	if !ok {
+		return ""
+	}
+	root, rel, found := strings.Cut(spec, ":")
+	if !found {
+		f.log.Error().Msgf("cards: bad spec for %v: %q (want \"save:<path>\" or \"system:<path>\")", system, spec)
+		return ""
+	}
+	switch root {
+	case "save":
+		return filepath.Join(f.nano.SaveDir(), filepath.FromSlash(rel))
+	case "system":
+		return filepath.Join(f.nano.SystemDir(), filepath.FromSlash(rel))
+	default:
+		f.log.Error().Msgf("cards: unknown root %q for %v", root, system)
+		return ""
+	}
+}
+
+func (f *Frontend) vaultDir(user, system string) string {
+	return filepath.Join(f.conf.CardVault, user, system)
+}
+
+// ownerFile records who the card currently in the worker's directory belongs to, so that a worker
+// that DIED without harvesting (the exit-139 teardown, a kill) can still have that player's card
+// recovered on the next room rather than cleared out from under them.
+const cardOwnerFile = ".owner"
+
+// seedCards puts THIS room owner's card in place before the core loads the game.
+func (f *Frontend) seedCards() {
+	user, system, ok := cardOwner(f.storage.MainPath())
+	if !ok {
+		return
+	}
+	dir := f.cardDir(system)
+	if dir == "" {
+		return
+	}
+
+	// Whoever used this directory last may never have been harvested (a killed worker skips the
+	// close path entirely). Recover their card before touching it — never clear another player's
+	// progress to make room for this one.
+	if prev, err := os.ReadFile(filepath.Join(dir, cardOwnerFile)); err == nil {
+		if p := strings.TrimSpace(string(prev)); p != "" && p != user {
+			if err := os.CopyTree(dir, f.vaultDir(p, system)); err != nil {
+				f.log.Error().Err(err).Msgf("cards: could not recover user %v's %v card", p, system)
+			} else {
+				f.log.Info().Msgf("cards: recovered an unharvested %v card for user %v", system, p)
+			}
+		}
+	}
+
+	vault := f.vaultDir(user, system)
+	if !os.Exists(vault) {
+		// First time this user plays this system. Their card starts EMPTY rather than inheriting
+		// whatever the previous player left behind — a fresh card, like a new console.
+		// (Existing shared cards are migrated into each user's vault out of band; see the skill.)
+		if err := os.ClearDir(dir); err != nil {
+			f.log.Error().Err(err).Msgf("cards: could not clear the %v card dir", system)
+			return
+		}
+		f.log.Info().Msgf("cards: fresh %v card for user %v", system, user)
+	} else if err := os.ReplaceTree(vault, dir); err != nil {
+		f.log.Error().Err(err).Msgf("cards: could not seed user %v's %v card", user, system)
+		return
+	} else {
+		f.log.Info().Msgf("cards: seeded user %v's %v card", user, system)
+	}
+
+	_ = os.MakeDirAll(dir)
+	if err := os.WriteFile(filepath.Join(dir, cardOwnerFile), []byte(user), 0644); err != nil {
+		f.log.Error().Err(err).Msg("cards: could not stamp the card owner")
+	}
+}
+
+// harvestCards copies the room owner's card back to their vault. Call it AFTER Shutdown — the core
+// flushes the card as it closes, so harvesting earlier can vault a stale one.
+func (f *Frontend) harvestCards() {
+	user, system, ok := cardOwner(f.storage.MainPath())
+	if !ok {
+		return
+	}
+	dir := f.cardDir(system)
+	if dir == "" || !os.Exists(dir) {
+		return
+	}
+	if err := os.CopyTree(dir, f.vaultDir(user, system)); err != nil {
+		f.log.Error().Err(err).Msgf("cards: could not harvest user %v's %v card", user, system)
+		return
+	}
+	f.log.Info().Msgf("cards: harvested user %v's %v card", user, system)
+}
+
