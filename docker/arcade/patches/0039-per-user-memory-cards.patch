+// ── Directory trees (MovieTheater patch 0039: per-user memory cards) ─────────────────────────────
+
+// CopyTree copies every FILE under src into dst, creating dst. It merges into whatever is already
+// there and never deletes — the destination here is a player's save vault, so a bug must not be
+// able to erase it.
+func CopyTree(src, dst string) error {
+	return filepath.WalkDir(src, func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(src, path)
+		if err != nil {
+			return err
+		}
+		target := filepath.Join(dst, rel)
+		if d.IsDir() {
+			return MakeDirAll(target)
+		}
+		if err := MakeDirAll(filepath.Dir(target)); err != nil {
+			return err
+		}
+		return CopyFile(path, target)
+	})
+}
+
+// ClearDir empties dir (leaving dir itself), creating it if absent.
+func ClearDir(dir string) error {
+	if !Exists(dir) {
+		return MakeDirAll(dir)
+	}
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return err
+	}
+	for _, e := range entries {
+		if err := os.RemoveAll(filepath.Join(dir, e.Name())); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// ReplaceTree makes dst hold exactly what src holds. Unlike CopyTree it CLEARS dst first, so a card
+// seeded for one user can't leave another user's files behind — the caller must have vaulted
+// anything in dst that still matters.
+func ReplaceTree(src, dst string) error {
+	if err := ClearDir(dst); err != nil {
+		return err
+	}
+	return CopyTree(src, dst)
+}
