+// audioClockFrames accumulates audio frames (per channel) produced since the last read. The frontend
+// pacing loop drains it each tick to pace retro_run against the emulated audio clock (real-time 44.1kHz)
+// — so a game whose content rate varies (e.g. flycast running Sonic's 30fps gameplay at 2x, emitting 2x
+// audio) is throttled to true speed instead of the fixed video fps. See frontend.go Start.
+var audioClockFrames atomic.Int64
+
+// TakeAudioFrames returns and resets the audio frames produced since the last call.
+func (n *Nanoarch) TakeAudioFrames() int64 { return audioClockFrames.Swap(0) }
+
 //export coreAudioSampleBatch
 func coreAudioSampleBatch(data unsafe.Pointer, frames C.size_t) C.size_t {
 	if Nan0.Stopped.Load() {
 		return frames
 	}
+	audioClockFrames.Add(int64(frames))
 	Nan0.Handlers.OnAudio(data, int(frames)<<1)
 
