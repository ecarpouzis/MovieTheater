diff --git a/pkg/worker/caged/libretro/nanoarch/nanoarch.c b/pkg/worker/caged/libretro/nanoarch/nanoarch.c
index 669862d..9582179 100644
--- a/pkg/worker/caged/libretro/nanoarch/nanoarch.c
+++ b/pkg/worker/caged/libretro/nanoarch/nanoarch.c
@@ -407,3 +407,36 @@ void *same_thread_with_args2(void *f, int type, void *arg1, void *arg2) {
 void same_thread(void *f) {
     same_thread_with_args(f, CALL_VOID);
 }
+
+// --- Disk control (MovieTheater patch 0005) ---------------------------------------------------------
+// Captures the core's retro_disk_control_callback (registered via RETRO_ENVIRONMENT_SET_DISK_CONTROL_
+// INTERFACE) so the frontend can swap discs of a multi-disc .m3u game. Applied on the emulator thread
+// from Run(); see docs/arcade-dedupe-multidisc-plan.md.
+static struct retro_disk_control_callback nano_disk;
+static bool nano_disk_set = false;
+
+void nano_disk_set_interface(const void *cb) {
+    if (cb) {
+        nano_disk = *(const struct retro_disk_control_callback *)cb;
+        nano_disk_set = true;
+    } else {
+        nano_disk_set = false;
+    }
+}
+
+static bool nano_disk_ok(void) {
+    return nano_disk_set && nano_disk.set_eject_state && nano_disk.set_image_index && nano_disk.get_num_images;
+}
+
+// nano_disk_set_index ejects, selects image `index`, and re-inserts. Returns false if there is no disk
+// control, the index is out of range, or the core rejects the swap.
+bool nano_disk_set_index(unsigned index) {
+    if (!nano_disk_ok()) return false;
+    unsigned n = nano_disk.get_num_images();
+    if (n == 0 || index >= n) return false;
+    if (nano_disk.get_image_index && nano_disk.get_image_index() == index) return true;
+    if (!nano_disk.set_eject_state(true)) return false;
+    bool ok = nano_disk.set_image_index(index);
+    nano_disk.set_eject_state(false);
+    return ok;
+}
