 func (gl GameLauncher) FindAppByName(name string) (AppMeta, error) {
 	game := gl.lib.FindGameByName(name)
+	if game.Path == "" {
+		// JIT ROM materialization (MovieTheater patch): a game can be extracted into the ROM dir on
+		// demand, AFTER the worker's boot-time scan. fsnotify WatchMode does not reliably fire across a
+		// Windows-host → WSL2 bind mount, so on a miss force one (throttled) rescan and retry before
