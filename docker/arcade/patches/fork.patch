+func (p *Peer) DeviceId() string {
+	if p == nil {
+		return ""
+	}
+	return p.deviceId
+}
+
+// Username is the site login this peer authenticated as, "" when unknown. Observability only.
+func (p *Peer) Username() string {
+	if p == nil {
