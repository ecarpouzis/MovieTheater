+package worker
+
+// RetroAchievements wiring between the embedded rcheevos runtime (pkg/worker/cheevos) and the outside
+// world: the live in-room toast (a t=160 packet to the browser) and the durable MIRROR to the site
+// (two secret-gated internal callbacks, the same worker->site trust path documented in the arcade plan).
+// rcheevos itself submits the real unlock/run to retroachievements.org under the player's own account;
+// everything here is a copy for the site's friends board + profile + toast.
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	neturl "net/url"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/giongto35/cloud-game/v3/pkg/api"
+	"github.com/giongto35/cloud-game/v3/pkg/logger"
+	"github.com/giongto35/cloud-game/v3/pkg/worker/cheevos"
+)
+
+var raMirrorClient = &http.Client{Timeout: 15 * time.Second}
+
+// parseRoomOwner pulls the site user id + arcade game id out of the room id the site mints
+// (sv-<user>-<game>-<slot>-<system>___<key>, ArcadeSaveId). Returns ok=false for a stock random room.
+func parseRoomOwner(roomId string) (userId, gameId int, ok bool) {
+	if !strings.HasPrefix(roomId, "sv-") {
+		return 0, 0, false
+	}
+	sep := strings.Index(roomId, "___")
+	if sep < 0 {
+		return 0, 0, false
+	}
+	parts := strings.SplitN(roomId[len("sv-"):sep], "-", 4)
+	if len(parts) != 4 {
+		return 0, 0, false
+	}
+	u, err1 := strconv.Atoi(parts[0])
+	g, err2 := strconv.Atoi(parts[1])
+	if err1 != nil || err2 != nil {
+		return 0, 0, false
+	}
+	return u, g, true
+}
+
+// buildCheevosHandlers wires the achievement/leaderboard events to the room and the site. `send` is the
+// room's packet sink (room.Send); roomId is the site-minted id we parse for attribution; system + raUser
+// ride the mirror payloads. Safe to call with an empty mirror config — the toast still fires.
+func buildCheevosHandlers(cfg raMirrorConfig, log *logger.Logger, send func([]byte), roomId, system, raUser string) cheevos.Handlers {
+	userId, gameId, haveOwner := parseRoomOwner(roomId)
+
+	// Fetched ONCE per room, off the emu loop. Nil when unavailable, which means "toast everything" —
+	// see fetchPriorUnlocks. Only read from the achievement callback, which the runtime serialises.
+	var prior *priorUnlocks
+	if haveOwner {
+		prior = cfg.fetchPriorUnlocks(log, userId, raUser)
+	}
+
+	return cheevos.Handlers{
+		OnAchievement: func(a cheevos.Achievement) {
+			// 1) live toast to everyone in the room (cosmetic; RA + the mirror hold the real record).
+			// SKIPPED for an achievement this player already holds. Spectator mode gives the runtime no
+			// per-user history, so it re-raises every achievement whenever its trigger fires again and
+			// the same unlocks popped session after session. The MIRROR below still runs: the DB keys on
+			// (UserId, RaAchievementId, Clean), so a re-earn at the same legitimacy updates in place,
+			// and a clean re-earn after a dirty one is a genuine new row.
+			if prior.suppressToast(a.ID, !a.Cheat && !a.Savescum && !a.Timeplay) {
+				log.Info().Msgf("RetroAchievements: %q already unlocked by this player — toast suppressed", a.Title)
+			} else if data, err := api.Wrap(api.Out{
+				T: uint8(api.AchievementUnlock),
+				Payload: achievementToast{
+					ID: a.ID, Title: a.Title, Description: a.Description, Points: a.Points, Hardcore: a.Hardcore,
+					Cheat: a.Cheat, Savescum: a.Savescum, Timeplay: a.Timeplay,
+				},
+			}); err == nil {
+				send(data)
+			}
+			log.Info().Msgf("RetroAchievements unlocked: %q (%d pts, hardcore=%v)", a.Title, a.Points, a.Hardcore)
+
+			// 2) durable mirror to the site (async — never block the emu loop on HTTP).
+			if haveOwner {
+				go cfg.postAchievement(log, userId, gameId, raUser, a)
+			}
+		},
+		OnLeaderboard: func(l cheevos.Leaderboard) {
+			log.Info().Msgf("RetroAchievements leaderboard submit: %q = %d (%s)", l.Title, l.RawValue, l.Format)
+			if haveOwner {
+				go cfg.postLeaderboard(log, userId, gameId, raUser, l)
+			}
+		},
+		OnLog: func(msg string) { log.Info().Msg(msg) },
+	}
+}
+
+type achievementToast struct {
+	ID          uint32 `json:"id"`
+	Title       string `json:"title"`
+	Description string `json:"description,omitempty"`
+	Points      uint32 `json:"points"`
+	Hardcore    bool   `json:"hardcore"`
+	// Run-legitimacy taints for the toast's why-icon (a save-scummed unlock shows differently).
+	Cheat    bool `json:"cheat,omitempty"`
+	Savescum bool `json:"savescum,omitempty"`
+	Timeplay bool `json:"timeplay,omitempty"`
+}
+
+// raMirrorConfig captures the site mirror endpoint + secret (from worker config).
+type raMirrorConfig struct {
+	baseURL string
+	secret  string
+}
+
+func (c raMirrorConfig) enabled() bool { return c.baseURL != "" && c.secret != "" }
+
+func (c raMirrorConfig) post(log *logger.Logger, path string, body any) {
+	if !c.enabled() {
+		return
+	}
+	buf, err := json.Marshal(body)
+	if err != nil {
+		return
+	}
+	req, err := http.NewRequest(http.MethodPost, strings.TrimRight(c.baseURL, "/")+path, bytes.NewReader(buf))
+	if err != nil {
+		return
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-Arcade-Internal-Secret", c.secret)
+	resp, err := raMirrorClient.Do(req)
+	if err != nil {
+		log.Warn().Err(err).Msgf("RetroAchievements mirror POST %s failed", path)
+		return
+	}
+	_ = resp.Body.Close()
+}
+
+// priorUnlocks is what this player has already earned, so the room stops toasting the same achievement
+// every session. The rcheevos runtime cannot answer this: it runs as ONE site service account in
+// spectator mode, so it has no per-user history and re-raises every achievement whenever its trigger
+// fires again. Only the site DB knows.
+type priorUnlocks struct {
+	all   map[uint32]bool // ever unlocked, at any legitimacy
+	clean map[uint32]bool // unlocked on a clean run
+}
+
+// suppressToast reports whether this unlock is a repeat the player should NOT be popped about again.
+// A clean re-earn after a dirty one is deliberately still toasted: it is a genuine first, and the
+// unlock table records it as its own row for exactly the same reason.
+func (p *priorUnlocks) suppressToast(id uint32, clean bool) bool {
+	if p == nil {
+		return false // never fetched (mirror disabled, or the lookup failed) — better a repeat than a silence
+	}
+	if p.clean[id] {
+		return true // already earned legitimately; nothing left to announce
+	}
+	return p.all[id] && !clean // already earned dirty, and this one is dirty too
+}
+
+// fetchPriorUnlocks asks the site what this player already has. Returns nil on ANY failure, which the
+// caller treats as "toast everything" — a lookup problem must not silently swallow real unlocks.
+func (c raMirrorConfig) fetchPriorUnlocks(log *logger.Logger, userId int, raUser string) *priorUnlocks {
+	if !c.enabled() {
+		return nil
+	}
+	url := strings.TrimRight(c.baseURL, "/") + "/API/Arcade/Internal/UnlockedAchievements?userId=" +
+		strconv.Itoa(userId) + "&raUser=" + neturl.QueryEscape(raUser)
+	req, err := http.NewRequest(http.MethodGet, url, nil)
+	if err != nil {
+		return nil
+	}
+	req.Header.Set("X-Arcade-Internal-Secret", c.secret)
+	resp, err := raMirrorClient.Do(req)
+	if err != nil {
+		log.Warn().Err(err).Msg("RetroAchievements: prior-unlock lookup failed — every achievement will toast this session")
+		return nil
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode != http.StatusOK {
+		log.Warn().Msgf("RetroAchievements: prior-unlock lookup returned HTTP %d — every achievement will toast this session", resp.StatusCode)
+		return nil
+	}
+	var body struct {
+		All   []uint32 `json:"all"`
+		Clean []uint32 `json:"clean"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&body); err != nil {
+		log.Warn().Err(err).Msg("RetroAchievements: prior-unlock lookup gave unreadable JSON — every achievement will toast this session")
+		return nil
+	}
+	p := &priorUnlocks{all: map[uint32]bool{}, clean: map[uint32]bool{}}
+	for _, id := range body.All {
+		p.all[id] = true
+	}
+	for _, id := range body.Clean {
+		p.clean[id] = true
+	}
+	log.Info().Msgf("RetroAchievements: %d achievement(s) already unlocked by this player (%d clean) — those will not re-toast",
+		len(p.all), len(p.clean))
+	return p
+}
+
+func (c raMirrorConfig) postAchievement(log *logger.Logger, userId, gameId int, raUser string, a cheevos.Achievement) {
+	c.post(log, "/API/Arcade/Internal/AchievementUnlocked", map[string]any{
+		"userId":          userId,
+		"raUser":          raUser,
+		"arcadeGameId":    gameId,
+		"raAchievementId": a.ID,
+		"title":           a.Title,
+		"points":          a.Points,
+		"hardcore":        a.Hardcore,
+		"cheat":           a.Cheat,
+		"savescum":        a.Savescum,
+		"timeplay":        a.Timeplay,
+	})
+}
+
+func (c raMirrorConfig) postLeaderboard(log *logger.Logger, userId, gameId int, raUser string, l cheevos.Leaderboard) {
+	c.post(log, "/API/Arcade/Internal/LeaderboardSubmitted", map[string]any{
+		"userId":          userId,
+		"raUser":          raUser,
+		"arcadeGameId":    gameId,
+		"raLeaderboardId": l.ID,
+		"title":           l.Title,
+		"value":           l.RawValue,
+		"format":          l.Format,
+		"hardcore":        l.Hardcore,
+		"cheat":           l.Cheat,
+		"savescum":        l.Savescum,
+		"timeplay":        l.Timeplay,
+	})
+}
