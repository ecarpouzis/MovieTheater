+#ifndef VULKAN_H_
+#define VULKAN_H_ 1
+/* Minimal vendored <vulkan/vulkan.h> for the CloudRetro worker's Vulkan-capture
+ * frontend (M1). We never present, so no platform/surface headers (win32, xlib,
+ * ...) are pulled in — only the core API. vulkan-1.dll is loaded at runtime and
+ * every entry point is resolved via vkGetInstanceProcAddr, so VK_NO_PROTOTYPES
+ * is set by the includer (nanoarch_vulkan.c) to suppress the loader-linked
+ * global prototypes. */
+#include "vk_platform.h"
+#include "vulkan_core.h"
+#endif
