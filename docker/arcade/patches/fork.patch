+    if (nano_disk.get_image_index && nano_disk.get_image_index() == index) return true;
+    if (!nano_disk.set_eject_state(true)) return false;
+    bool ok = nano_disk.set_image_index(index);
+    nano_disk.set_eject_state(false);
+    return ok;
+}
