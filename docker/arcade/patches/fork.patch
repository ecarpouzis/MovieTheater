diff --git a/pkg/worker/caged/libretro/graphics/readback_stats.go b/pkg/worker/caged/libretro/graphics/readback_stats.go
new file mode 100644
index 0000000..96877c5
--- /dev/null
+++ b/pkg/worker/caged/libretro/graphics/readback_stats.go
@@ -0,0 +1,81 @@
+package graphics
+
+import (
+	"fmt"
+	"os"
+	"sort"
+	"sync"
+	"time"
+)
+
+// Instrumentation for the GL readback (env-gated: CLOUD_GAME_GL_READBACK_STATS=1).
+//
+// Hardware-rendered cores (n64, gc, ps2, psp, dc — everything 3D) render into an FBO on the GPU and we
+// pull the pixels back with glReadPixels, on the EMULATOR THREAD, inside video_refresh. That call is
+// synchronous: it flushes the GL pipeline and blocks until the frame has crossed PCIe into system
+// memory. Then patch 0004 copies it again, and NVENC uploads it straight back to the GPU.
+//
+// So the question this answers is NOT "how much bandwidth does the round trip cost" — it is "how long
+// does the core sit still doing nothing". At 60fps the whole frame budget is 16.7 ms. If the readback
+// is ~0.5 ms it is noise and GL/CUDA interop (which has to share a WGL context across libco cothreads
+// — a crash risk, not a glitch risk) is not worth it. If it is 5-8 ms it is the biggest single win
+// available on the 3D cores, and it also explains frame-pacing sag on the heavy ones.
+//
+// Measure before building: the same discipline settled P4 (9.2 ms vs 3.0 ms measured), and it is what
+// showed the +137 ms figure in arxiv 2507.00623 does not describe this stack.
+var readbackStats = struct {
+	on      bool
+	mu      sync.Mutex
+	samples []time.Duration
+	w, h    uint
+	bytes   uint
+	logged  int
+}{on: os.Getenv("CLOUD_GAME_GL_READBACK_STATS") == "1"}
+
+const readbackReportEvery = 300 // ~5s at 60fps
+
+// recordReadback times one glReadPixels and periodically reports the distribution. Called only when
+// the env gate is on; the zero-cost path is a single bool check in ReadFramebuffer.
+func recordReadback(d time.Duration, size, w, h uint) {
+	s := &readbackStats
+	s.mu.Lock()
+	s.samples = append(s.samples, d)
+	s.w, s.h, s.bytes = w, h, size
+	if len(s.samples) < readbackReportEvery {
+		s.mu.Unlock()
+		return
+	}
+	batch := s.samples
+	s.samples = nil
+	s.logged++
+	n := s.logged
+	s.mu.Unlock()
+
+	sorted := make([]time.Duration, len(batch))
+	copy(sorted, batch)
+	sort.Slice(sorted, func(i, j int) bool { return sorted[i] < sorted[j] })
+
+	pct := func(p int) float64 {
+		i := len(sorted) * p / 100
+		if i >= len(sorted) {
+			i = len(sorted) - 1
+		}
+		return float64(sorted[i].Microseconds()) / 1000
+	}
+	var total time.Duration
+	for _, d := range batch {
+		total += d
+	}
+	mean := float64(total.Microseconds()) / float64(len(batch)) / 1000
+
+	// A frame is 16.7 ms at 60fps — express the cost as the share of the budget the core spends
+	// blocked, because that is the number that decides whether this is worth fixing.
+	budgetPct := pct(50) / 16.67 * 100
+
+	fmt.Fprintf(os.Stderr,
+		"[gl-readback #%d] %dx%d %.1f MB/frame | p50 %.2f ms  p95 %.2f ms  max %.2f ms  mean %.2f ms "+
+			"| p50 = %.0f%% of a 60fps frame budget (n=%d)\n",
+		n, w, h, float64(size)/1024/1024,
+		pct(50), pct(95), float64(sorted[len(sorted)-1].Microseconds())/1000, mean,
+		budgetPct, len(batch))
+}
