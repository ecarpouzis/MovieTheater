+RC_BEGIN_C_DECLS
+
+/* RAIntegration follows the same calling convention as rcheevos */
+
+typedef void (RC_CCONV* rc_client_raintegration_action_func_t)(void);
+typedef const char* (RC_CCONV* rc_client_raintegration_get_string_func_t)(void);
