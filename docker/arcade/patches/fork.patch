+
+func write(t *testing.T, path, body string) {
+	t.Helper()
+	if err := MakeDirAll(filepath.Dir(path)); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(body), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func read(t *testing.T, path string) string {
+	t.Helper()
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return ""
+	}
+	return string(b)
+}
+
+// A player's card vault must never be emptied by a copy — CopyTree merges, so a bug upstream can
+// destroy a session's worth of progress at worst, not a whole card.
+func TestCopyTreeMergesAndNeverDeletes(t *testing.T) {
+	src, dst := t.TempDir(), t.TempDir()
+	write(t, filepath.Join(src, "Card A", "gauntlet.gci"), "characters")
+	write(t, filepath.Join(dst, "Card A", "older.gci"), "keep me")
+
+	if err := CopyTree(src, dst); err != nil {
+		t.Fatal(err)
+	}
+	if got := read(t, filepath.Join(dst, "Card A", "gauntlet.gci")); got != "characters" {
+		t.Fatalf("new file not copied: %q", got)
+	}
+	if got := read(t, filepath.Join(dst, "Card A", "older.gci")); got != "keep me" {
+		t.Fatalf("CopyTree deleted an existing vault file: %q", got)
+	}
+}
+
+// Seeding one user's card must leave NOTHING of the previous user's behind, or player B would see
+// (and overwrite) player A's characters.
+func TestReplaceTreeLeavesNothingBehind(t *testing.T) {
+	src, dst := t.TempDir(), t.TempDir()
+	write(t, filepath.Join(src, "Card A", "player-b.gci"), "player-b-save")
+	write(t, filepath.Join(dst, "Card A", "eric.gci"), "eric")
+	write(t, filepath.Join(dst, "stray.bin"), "stray")
+
+	if err := ReplaceTree(src, dst); err != nil {
+		t.Fatal(err)
+	}
+	if got := read(t, filepath.Join(dst, "Card A", "player-b.gci")); got != "player-b-save" {
+		t.Fatalf("card not seeded: %q", got)
+	}
+	if Exists(filepath.Join(dst, "Card A", "eric.gci")) {
+		t.Fatal("previous user's card survived the seed")
+	}
+	if Exists(filepath.Join(dst, "stray.bin")) {
+		t.Fatal("stray file survived the seed")
+	}
