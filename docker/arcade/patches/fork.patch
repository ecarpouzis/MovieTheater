+// GstMediaPipe a video and audio pipline based on GStreamer.
+// Very unsafe.
+//
+// Video encoding is done in a single goroutine to avoid races.
+// Audio is pulled from the appsink on GStreamer's own audio thread.
+//
+// Goroutines (3):
+//   - video worker x1 (push+pull loop for video encoding)
+//   - bus messages x2 (one per pipeline, bus message logging)
+type GstMediaPipe struct {
+	a, v *pipe
+
+	onAudio func([]byte, time.Duration)
+	onVideo func([]byte, time.Duration)
+
+	vDrops atomic.Int64 // frames dropped because the video channel was full (patch 0004)
+
+	// Current ABR target (kbps, 0 = never set). Re-applied after every Reinit, because a video
+	// geometry change destroys and rebuilds the pipeline — and with it the encoder element.
+	vBitrate atomic.Int64
+
+	conf config.Encoder
+
+	pixFmt uint32
+
+	VideoW, VideoH int
+	VideoScale     float64
+	ScaleMethod    string
+	MaxThreads     int
+	AudioSrcHz     int
+	VideoVFR       bool
+	VideoFPS       float64
+
+	// VideoSrcChain (P4 zero-copy, capture lane only): a GStreamer fragment that REPLACES the
+	// appsrc head — capture source → convert → NV12 in GPU memory, linked straight into the encoder.
+	// Empty (the default, and every libretro room) keeps the appsrc path exactly as it was.
+	//
+	// The point is to keep the ENCODER in this package. Design-A read every frame back to system
+	// memory (d3d12download) only to hand it to Go, which pushed it into an appsrc that uploaded it
+	// to the GPU again for NVENC — a GPU→CPU→GPU round trip that measured 9.2 ms vs 3.0 ms for the
+	// same encoder fed directly from GPU memory. Moving the encoder into the capture app instead
+	// would have orphaned ABR, per-room codec and forced keyframes; swapping only the SOURCE HEAD
+	// keeps all three working against the same `video_enc` element.
+	VideoSrcChain string
+
+	// GLZeroCopy (libretro GL cores): the appsrc carries GL textures, not system-memory frames, and the
+	// encoder reads them straight out of VRAM. See glzerocopy.go. Off => the readback path, unchanged.
+	GLZeroCopy bool
+
+	// destroyed guards destroySync: with GL zero-copy the pipeline is torn down from the core's own
+	// teardown AND again from Room.Close(). Guarded by mu.
+	destroyed bool
+
+	oldPf  uint32
+	oldRot uint
+	bpp    int
+	vidFmt uint32 // cached GstVideoFormat enum
+
+	encFrames  atomic.Uint64 // encoded frames out of the appsink (zero-copy: the only observable rate)
+	lastEncLog time.Time     // touched only from the appsink's streaming thread
+
+	frameI   int          // for forced keyframes
+	keyI     int          // periodic keyframe counter
+	kfi      int          // 0=GStreamer auto, >0=force keyframe every N frames
+	forceKf  atomic.Int32 // countdown of frames in the post-join force-keyframe window — RequestKeyframe
+	aSegSent bool         // for Opusenc bug
+
+	// used for reinit
+	videoCh   chan videoJob
+	videoDone chan struct{}
+	reinit    atomic.Bool
+	mu        sync.Mutex
+
+	log *logger.Logger
+}
+
+type videoJob struct {
+	data         []byte
+	w, h, stride int
+	dur          time.Duration
+}
+
+type Video struct {
+	Frame    RawFrame
+	Duration time.Duration
+}
+
+type RawFrame struct {
+	// Tex: GL zero-copy (HW cores). Non-zero => the frame is a GL texture, Data is nil.
+	Tex    uint32
+	Data   []byte
+	Stride int
+	W, H   int
+}
+
+type pipe struct {
+	pipeline *gst.Pipeline
+	source   *app.Source
+	sink     *app.Sink
+	srcPad   *gst.Pad
+	enc      *gst.Element // video encoder, kept for live bitrate changes (arcade ABR, patch 0021)
+	frameDur time.Duration
+	stale    atomic.Bool
+
+	// P4 zero-copy (capture lane): the head is a live capture element, not an appsrc, so `source`
+	// and `srcPad` are nil and no frame ever crosses into Go. `valve` gates desktop frames at the
+	// pipeline instead of at the Go callback (privacy — see SetVideoValveDrop).
+	zeroCopy bool
+	valve    *gst.Element
+}
+
+func (p *pipe) src() *C.GstAppSrc      { return (*C.GstAppSrc)(unsafe.Pointer(p.source.Instance())) }
+func (p *pipe) sinkPtr() *C.GstAppSink { return (*C.GstAppSink)(unsafe.Pointer(p.sink.Instance())) }
+func (p *pipe) stop() {
+	if p != nil && p.pipeline != nil {
+		p.pipeline.SetState(gst.StateNull)
+	}
+}
+
+func (p *pipe) destroy() {
+	if p == nil {
+		return
+	}
+	if p.pipeline != nil {
+		p.pipeline.GetPipelineBus().Post(gst.NewEOSMessage(p.pipeline))
+		if p.zeroCopy {
+			// The d3d12/d3d11 screen-capture element lives in THIS pipeline now, and an async
+			// SetState(NULL) returns before its WGC capture session is actually freed — the next
+			// room's capture then gets no frames (that is the "room 2 is black at ~1 fps" bug the
+			// capture app already had to solve). Drive it to NULL and WAIT, then drop the ref and
+			// force the GC so go-gst's finalizer actually unrefs the element. Bounded, because a
+			// wedged nvcodec/WGC teardown must not eat the 10 s media-teardown watchdog.
+			done := make(chan struct{})
+			go func() { defer close(done); _ = p.pipeline.BlockSetState(gst.StateNull) }()
+			select {
+			case <-done:
+			case <-time.After(3 * time.Second):
+			}
+			p.pipeline = nil
+			p.enc = nil
+			p.valve = nil
+			runtime.GC()
+			time.Sleep(60 * time.Millisecond) // let the finalizer run gst_object_unref → free
+			runtime.GC()
+		} else {
+			p.pipeline.SetState(gst.StateNull)
+			p.pipeline = nil
+		}
+	}
+	p.sink = nil
+	p.source = nil
+}
+
+type builder struct{ strings.Builder }
+
+func (b *builder) write(s string)               { b.Builder.WriteString(s) }
+func (b *builder) writef(s string, args ...any) { fmt.Fprintf(&b.Builder, s, args...) }
+func (b *builder) writeIfSet(s string) {
+	if s != "" {
+		b.write(s)
+	}
+}
+
+// TemporalLayers reports how many temporal SVC layers the configured encoder will emit, read from the
+// encoder's own params string (`temporal-layers=N` on nvav1enc — our patched nvcodec plugin).
+//
+// Deliberately parsed from the SAME string that configures the element rather than carried as a
+// separate config key: the send path drops frames by temporal id, so a Go-side count that disagreed
+// with the encoder's would silently drop layers that were never produced (or feed layers we believe
+// don't exist). One source of truth, no way to desync. Anything unparseable = 1 = SVC off.
+func (g *GstMediaPipe) TemporalLayers() int {
+	opts, _ := g.conf.VideoSettings()
+	if opts == nil {
+		return 1
+	}
+	for _, f := range strings.Fields(opts.Params) {
+		v, ok := strings.CutPrefix(f, "temporal-layers=")
+		if !ok {
+			continue
+		}
+		n, err := strconv.Atoi(v)
+		if err != nil || n < 1 {
+			return 1
+		}
+		return n
+	}
+	return 1
+}
+
+func NewGstreamer(conf config.Encoder, log *logger.Logger) *GstMediaPipe {
+	return &GstMediaPipe{conf: conf, bpp: 4, vidFmt: gstVideoFormat("BGRx"), log: log}
+}
+
+func (g *GstMediaPipe) Init() error {
+	if err := g.initVideo(); err != nil {
+		return fmt.Errorf("gst video init: %w", err)
+	}
+	if err := g.initAudio(); err != nil {
+		return fmt.Errorf("gst audio init: %w", err)
+	}
+	return nil
+}
+
+func (g *GstMediaPipe) initAudio() (err error) {
+	srcHz := g.AudioSrcHz
+	g.a, err = buildAudioPipeline(srcHz, g.conf, g.log)
+	if err != nil {
+		return
+	}
+	g.a.sink.SetCallbacks(&app.SinkCallbacks{NewSampleFunc: g.pullAudio})
+	return g.a.pipeline.SetState(gst.StatePlaying)
+}
+
+func (g *GstMediaPipe) initVideo() (err error) {
+	w, h, scale := g.VideoW, g.VideoH, g.VideoScale
+	sw, sh := round(w, scale), round(h, scale)
+	if g.oldRot%180 != 0 {
+		w, h = h, w
+	}
+	g.v, err = buildVideoPipeline(w, h, sw, sh, g.pixFmt, g.ScaleMethod, g.MaxThreads, g.conf,
+		g.log, g.VideoFPS, g.VideoVFR, g.VideoSrcChain, g.GLZeroCopy)
+	if err != nil {
+		return
+	}
+	// A geometry change rebuilds the pipeline (and the encoder element), so an ABR target set on the
+	// old encoder would silently revert to the config bitrate. Re-apply it to the new one.
+	if kbps := g.vBitrate.Load(); kbps > 0 {
+		if e := g.SetVideoBitrate(int(kbps)); e != nil {
+			g.log.Warn().Err(e).Msgf("abr: could not re-apply %d kbps after reinit", kbps)
+		}
+	}
+
+	// if params contain keyframe-mode=disabled, we force periodic keyframes
+	// ourselves instead of relying on GStreamer's auto mode
+	if opts, _ := g.conf.VideoSettings(); opts != nil && strings.Contains(opts.Params, "keyframe-mode=disabled") {
+		g.kfi = cmp.Or(g.conf.Video.KeyframeInterval, 120)
+	} else {
+		g.kfi = 0
+	}
+
+	p := g.v
+	fmt := g.vidFmt
+	// Patch 0004: the sink delivers encoded frames via GStreamer's own streaming thread (like the
+	// audio path always did) instead of a synchronous pull after each push — encode latency no
+	// longer gates input throughput. Channel deepened 3→8: frames are now COPIED at push, so a
+	// queued job can't be overwritten by the emulator reusing its frame buffer.
+	p.sink.SetCallbacks(&app.SinkCallbacks{NewSampleFunc: func(*app.Sink) gst.FlowReturn { return g.pullVideo(p) }})
+	// Zero-copy has no appsrc, so there is nothing to push and no push goroutine. Starting one would
+	// give videoWorker a pipe whose src() is nil.
+	if !p.zeroCopy {
+		g.videoCh = make(chan videoJob, 8)
+		g.videoDone = make(chan struct{})
+		go g.videoWorker(p, fmt, g.videoCh, g.videoDone)
+	}
+
+	return p.pipeline.SetState(gst.StatePlaying)
+}
+
+func (g *GstMediaPipe) SetPixFmt(f uint32) {
+	g.oldPf, g.pixFmt = f, f
+	g.vidFmt = gstVideoFormat(cmp.Or(pixFmtToGst[f], "RGBA"))
+	if f == pixFmtRGB16 {
+		g.bpp = 2
+	} else {
+		g.bpp = 4
+	}
+}
+func (g *GstMediaPipe) SetRot(r uint) { g.oldRot = r }
+
+// Destroy tears the pipelines down, guarded by a hard timeout (MovieTheater patch 0017).
+// gst_element_set_state(NULL) can HANG FOREVER inside libgstnvcodec (observed live: a goroutine
+// parked in the plugin's cond wait, captured in a full dump) — and Destroy runs SYNCHRONOUSLY on
+// the coordinator's message-pump goroutine (TerminateSession → Room.Close → here), so one stuck
+// encoder silently killed the whole worker: pings stopped, the coordinator dropped it
+// ("no free workers" → every create t=112 "arcade is full"), yet the process never exited, so the
+// runner's restart loop never fired. On timeout we log and EXIT: one room per worker means nothing
+// else lives here, and the runner respawns a clean worker in ~4 s (vs a 60-90 s watchdog window).
+func (g *GstMediaPipe) Destroy() {
+	done := make(chan struct{})
+	go func() { defer close(done); g.destroySync() }()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		g.log.Error().Msg("media pipeline teardown wedged (nvcodec set_state hang) — hard-exiting for a clean respawn")
+		// os.Exit (and log.Fatal) run ExitProcess, whose DLL_PROCESS_DETACH notifications can block
+		// behind the very thread that's wedged inside nvcodec (verified live: the Fatal logged but the
+		// process lived on until the watchdog shot it 41 s later). TerminateProcess skips DLL detach
+		// entirely — it cannot block. The runner loop respawns a clean worker in ~4 s.
+		h, _ := syscall.GetCurrentProcess()
+		_ = syscall.TerminateProcess(h, 1)
+	}
+}
+
+func (g *GstMediaPipe) destroySync() {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+
+	// Idempotent: GL zero-copy tears the pipeline down from inside the CORE's teardown (the encoder's
+	// GL context is shared with the core's and must not outlive it), and Room.Close() then calls
+	// Destroy() again on its way out. The second call used to panic on the already-closed video channel
+	// — which read as a worker crash at every room close, exit -1.
+	if g.destroyed {
+		return
+	}
+	g.destroyed = true
+
+	g.reinit.Store(true)
+
+	if g.videoCh != nil {
+		g.v.stop()
+		close(g.videoCh)
+		<-g.videoDone
+		g.videoCh = nil
+	}
+
+	g.v.destroy()
+	g.a.destroy()
+	g.aSegSent = false
+	g.keyI = 0
+}
+
+func (g *GstMediaPipe) ProcessAudio(audio []byte, cb func([]byte, time.Duration)) {
+	g.onAudio = cb
+	// PPSSPP emits a zero-length audio batch at gameplay start; &audio[0] below panics on an empty
+	// slice (index out of range [0] with length 0) → the worker crashed the instant PSP gameplay began.
+	if len(audio) == 0 {
+		return
+	}
+	if !g.aSegSent {
+		g.aSegSent = true
+		g.a.srcPad.PushEvent(gst.NewSegmentEvent(cachedSegment))
+	}
+	C.pushAudioBuf(g.a.src(), unsafe.Pointer(&audio[0]), C.gsize(len(audio)))
+}
+
+// pullAudio pulls audio buffers from the appsink when they are available.
+func (g *GstMediaPipe) pullAudio(_ *app.Sink) gst.FlowReturn {
+	var mapInfo C.GstMapInfo
+	buf := C.pullMappedBuffer(g.a.sinkPtr(), &mapInfo)
+	if buf == nil {
+		return gst.FlowEOS
+	}
+	defer C.unmapAndUnref(buf, &mapInfo)
+	if g.onAudio != nil {
+		g.onAudio(unsafe.Slice((*byte)(unsafe.Pointer(mapInfo.data)), int(mapInfo.size)), g.a.frameDur)
+	}
+	return gst.FlowOK
+}
+
+// videoWorker is the single goroutine pushing frames into the pipeline (patch 0004: pull moved to
+// the appsink callback — see pullVideo — so a slow encode round trip can't cap input throughput).
+func (g *GstMediaPipe) videoWorker(v *pipe, vidFmt uint32, ch <-chan videoJob, done chan<- struct{}) {
+	defer close(done)
+	for job := range ch {
+		if v.stale.Load() {
+			continue
+		}
+		C.pushVideoBuf(v.src(),
+			unsafe.Pointer(&job.data[0]), C.gsize(len(job.data)),
+			C.GstVideoFormat(vidFmt), C.guint(job.w), C.guint(job.h), C.gint(job.stride),
+			C.guint64(job.dur))
+	}
+}
+
+// pullVideo delivers encoded frames from the appsink's own streaming thread (patch 0004).
+// The frame duration was stamped on the buffer at push time — restore it for RTP timestamps.
+// The pipe is captured at registration so a late callback can't touch a successor pipeline.
+func (g *GstMediaPipe) pullVideo(p *pipe) gst.FlowReturn {
+	var mi C.GstMapInfo
+	buf := C.pullMappedBuffer(p.sinkPtr(), &mi)
+	if buf == nil {
+		return gst.FlowEOS
+	}
+	defer C.unmapAndUnref(buf, &mi)
+	if p.zeroCopy {
+		// The encoded frame IS the frame clock here — nothing arrives on the input side to count.
+		g.maybeForceKeyframe(p)
+		// And it is the ONLY place the capture lane's health can be observed. The capture app's own
+		// frame counters are design-A (they count what crossed into Go, which is now nothing), and a
+		// browser can't be trusted to tell us either: the captured game runs FULLSCREEN over the top
+		// of it, and an occluded Chrome throttles itself to a few fps — a healthy 60 fps stream reads
+		// as "fps: 2" in getStats. So the worker log is the source of truth for this lane.
+		if n := g.encFrames.Add(1); n%300 == 0 {
+			now := time.Now()
+			if prev := g.lastEncLog; !prev.IsZero() {
+				g.log.Info().Msgf("capture: encoded %d frames (%.1f fps out of NVENC, zero-copy)",
+					n, 300/now.Sub(prev).Seconds())
+			}
+			g.lastEncLog = now
+		}
+	}
+	if g.onVideo != nil && !p.stale.Load() {
+		data := unsafe.Slice((*byte)(unsafe.Pointer(mi.data)), int(mi.size))
+		g.onVideo(data, time.Duration(C.bufDuration(buf)))
+	}
+	return gst.FlowOK
+}
+
+// SetVideoSink wires the callback that ships encoded frames to the peers. ProcessVideo assigns it per
+// frame on the appsrc path; zero-copy has no ProcessVideo, so it must be handed over up front or the
+// encoder encodes into a nil callback.
+func (g *GstMediaPipe) SetVideoSink(cb func([]byte, time.Duration)) { g.onVideo = cb }
+
+// RequestKeyframe opens a spaced keyframe window (kfJoinWindow frames) so a NEW viewer syncs even
+// though we run an effectively infinite GOP — periodic IDRs were the ~2s audio hitch (the browser
+// stalled decoding each big IDR). Called from room.Router.AddUser.
+func (g *GstMediaPipe) RequestKeyframe() { g.forceKf.Store(kfJoinWindow) }
+
+// maybeForceKeyframe runs the keyframe POLICY — unchanged: a few at startup, a spaced burst after a
+// join (RequestKeyframe), and the periodic kfi path for encoders configured keyframe-mode=disabled.
+//
+// What P4 changes is only its CLOCK. The policy counts FRAMES, and it used to be driven from
+// ProcessVideo — i.e. by raw frames arriving from Go. In zero-copy no raw frame ever reaches Go, so
+// it is driven from pullVideo (encoded frames) instead. Both tick once per frame at the stream's
+// frame rate, so kfJoinWindow/kfJoinSpacing keep meaning exactly what they meant. Each clock has a
+// single streaming thread, so the non-atomic counters stay safe.
+func (g *GstMediaPipe) maybeForceKeyframe(p *pipe) {
+	kf := g.forceKf.Load()
+	if g.frameI < maxForcedKeyframes || (kf > 0 && kf%kfJoinSpacing == 0) || (g.kfi > 0 && g.keyI%g.kfi == 0) {
+		if p.zeroCopy {
+			// UPSTREAM, and sent straight to the encoder. The request now originates on the APPSINK's
+			// streaming thread, and we no longer own a src pad to push from: a serialized DOWNSTREAM
+			// event pushed from a foreign thread would contend for the capture element's stream lock.
+			// An upstream force-key-unit is handled directly by GstVideoEncoder — which nvh264enc and
+			// nvav1enc both derive from — with no locking games.
+			if p.enc != nil {
+				s := gst.NewStructure("GstForceKeyUnit")
+				s.SetValue("all-headers", true)
+				p.enc.SendEvent(gst.NewCustomEvent(gst.EventTypeCustomUpstream, s))
+			}
+		} else {
+			p.srcPad.PushEvent(forceKeyframeEvent)
+		}
+		if g.frameI < maxForcedKeyframes {
+			g.frameI++
+		}
+	}
+	if kf > 0 {
+		g.forceKf.Add(-1)
+	}
+	g.keyI++
+}
+
+// SetVideoValveDrop gates live desktop frames at the PIPELINE (P4 zero-copy). Design-A gated them in
+// Go — the capture app simply stopped calling ProcessVideo — but with no frame crossing into Go there
+// is nothing there to gate, and the desktop must never reach the stream between rooms or after the
+// game exits. Dropping at the valve leaves the client on the last decoded (game) frame, which is what
+// the Go-side gate did too. No-op on the appsrc path.
+func (g *GstMediaPipe) SetVideoValveDrop(drop bool) {
+	v := g.v
+	if v == nil || v.valve == nil {
+		return
+	}
+	if err := v.valve.SetProperty("drop", drop); err != nil {
+		g.log.Warn().Err(err).Msgf("capture: could not set video valve drop=%v", drop)
+	}
+}
+
+func (g *GstMediaPipe) ProcessVideo(v Video, cb func([]byte, time.Duration)) {
+	if g.reinit.Load() {
+		return
+	}
+	// Zero-copy owns its own source; no raw frame should ever arrive here. room.NewRoom wires
+	// SetVideoCb unconditionally, so guard rather than trust that nothing calls us.
+	if p := g.v; p == nil || p.zeroCopy {
+		return
+	}
+
+	// Force a keyframe: at startup (frameI), during a post-join window every kfJoinSpacing frames (so
+	// a still-connecting joiner gets one once ready), or on the kfi periodic path.
+	g.maybeForceKeyframe(g.v)
+
+	// GL zero-copy: the frame is a texture, not bytes. Push it as GLMemory and we are done — no
+	// videoconvert, no upload, and no copy of a frame that is already exactly where the encoder wants
+	// it. A mid-run geometry change is handled INSIDE zc_push (it renegotiates the appsrc caps), not
+	// by the CPU path below — this branch returns, so nothing below it ever runs for a GL core. An
+	// earlier version of this comment claimed the code below covered it; it does not, and that
+	// sentence is exactly why PS2 shipped with a video stream that died on the first height change.
+	if v.Frame.Tex != 0 {
+		g.onVideo = cb
+		g.pushGLTexture(v.Frame.Tex, v.Frame.W, v.Frame.H, uint64(v.Duration.Nanoseconds()))
+		return
+	}
+
+	w, h := v.Frame.W, v.Frame.H
+	stride := v.Frame.Stride
+
+	data := v.Frame.Data[:stride*h]
+	if stride == w*g.bpp {
+		stride = 0
+	}
+
+	g.onVideo = cb
+
+	select {
+	case g.videoCh <- videoJob{data: data, w: w, h: h, stride: stride, dur: v.Duration}:
+	default:
+		// Patch 0004: never drop silently — this is a real signal (the pipeline fell a full
+		// channel behind), and the invisible version of it cost a night of diagnosis.
+		if n := g.vDrops.Add(1); n%60 == 1 {
+			g.log.Warn().Msgf("video pipeline overloaded: %d frames dropped so far", n)
+		}
+	}
+}
+
+func (g *GstMediaPipe) Reinit() error {
+	// prevent concurrent reinits
+	g.mu.Lock()
+	defer g.mu.Unlock()
+
+	if g.v == nil {
+		return nil
+	}
+
+	g.reinit.Store(true)
+	defer g.reinit.Store(false)
+
+	// drop stale frames (for the new pipe)
+	g.v.stale.Store(true)
+
+	// stop the video worker
+	if g.videoCh != nil {
+		g.v.stop()
+		close(g.videoCh)
+		<-g.videoDone
+	}
+
+	// we rebuild new pipeline every time because
+	// changing the piplne parts proves to be unreliable
+	g.v.destroy()
+	if err := g.initVideo(); err != nil {
+		return fmt.Errorf("gst video reinit: %w", err)
+	}
+
+	g.keyI = 0
+	return nil
+}
+
+func buildVideoPipeline(w, h, scaledW, scaledH int, pixFmt uint32, scaleMethod string,
+	maxThreads int, conf config.Encoder, log *logger.Logger, fps float64, vfr bool,
+	srcChain string, glZeroCopy bool) (*pipe, error) {
+	format := cmp.Or(pixFmtToGst[pixFmt], "RGBA")
+	kfi := cmp.Or(conf.Video.KeyframeInterval, 120)
+	opts, codec := conf.VideoSettings()
+	if opts == nil {
+		return nil, fmt.Errorf("unsupported codec: %s", conf.Video.Codec)
+	}
+	zeroCopy := srcChain != ""
+	// The I420-CPU head needs a videoconvert to reach NVENC's NV12-only sink; the GPU head already
+	// hands the encoder NV12 in D3D12Memory (which nvh264enc/nvav1enc accept directly), and putting a
+	// videoconvert there would drag the frame back to system memory — exactly what P4 removes.
+	conv := "videoconvert n-threads=2 ! "
+	if zeroCopy || glZeroCopy {
+		// A videoconvert here would drag the frame back to system memory — exactly what both zero-copy
+		// paths exist to avoid. NVENC takes GLMemory/D3D12Memory RGBA/NV12 on its sink directly.
+		conv = ""
+	}
+
+	build := builder{}
+	build.Grow(512)
+	if zeroCopy {
+		// P4: the caller's chain already ends in NV12 GPU memory at the encode geometry (it does the
+		// convert/scale/colorimetry on the GPU, because doing any of it here would mean a download).
+		// It links STRAIGHT into the encoder below — no videoconvert, or the whole point is lost.
+		build.write(srcChain)
+		build.write(" ! ")
+	} else if glZeroCopy {
+		// GL ZERO-COPY head. The frame arrives as a GL texture the core just rendered (a GPU-side copy
+		// of it — graphics/zerocopy.go), so there is no download and no upload: glcolorscale does the
+		// resize ON THE GPU and the encoder reads the result straight out of VRAM.
+		//
+		// Verified end-to-end before any of this was written: gltestsrc(1920x1584) ! glcolorscale !
+		// GLMemory(1280x1056) ! nvav1enc encodes cleanly with temporal SVC intact.
+		build.write("appsrc name=video_src is-live=true ")
+		var fn, fd C.gint
+		C.doubleToFraction(C.gdouble(fps), &fn, &fd)
+		if vfr {
+			build.writef(`caps="video/x-raw(memory:GLMemory),format=RGBA,width=%d,height=%d,framerate=0/1,max-framerate=%d/%d" `, w, h, int(fn), int(fd))
+		} else {
+			build.writef(`caps="video/x-raw(memory:GLMemory),format=RGBA,width=%d,height=%d,framerate=%d/%d" `, w, h, int(fn), int(fd))
+		}
+		build.write("! glcolorscale name=video_scale ")
+		build.write("! queue name=video_q max-size-buffers=1 ")
+		build.writef("! capsfilter name=video_caps caps=\"video/x-raw(memory:GLMemory),format=RGBA,width=%d,height=%d\" ", scaledW, scaledH)
+		build.write("! ")
+	} else {
+		build.write("appsrc name=video_src is-live=true ")
+		var fn, fd C.gint
+		C.doubleToFraction(C.gdouble(fps), &fn, &fd)
+		if vfr {
+			build.writef(`caps="video/x-raw,format=%s,width=%d,height=%d,framerate=0/1,max-framerate=%d/%d" `, format, w, h, int(fn), int(fd))
+		} else {
+			build.writef(`caps="video/x-raw,format=%s,width=%d,height=%d,framerate=%d/%d" `, format, w, h, int(fn), int(fd))
+		}
+		build.writef("! videoconvertscale name=video_scale chroma-resampler=cubic method=%s n-threads=2 ", cmp.Or(scaleMethod, "nearest-neighbour"))
+		build.write("! queue name=video_q max-size-buffers=1 ")
+		build.writef("! capsfilter name=video_caps caps=\"video/x-raw,format=I420,color-range=0_255,width=%d,height=%d ", scaledW, scaledH)
+		if conf.Video.Colorimetry != "" {
+			build.writef(",colorimetry=%s", conf.Video.Colorimetry)
+		}
+		build.write("\" ")
+		build.write("! ")
+	}
+	switch codec {
+	// h264 (MovieTheater patch): the encoder element + all tuning come from encoder.list
+	// (e.g. nvh264enc for NVENC — keyframe cadence via gop-size in params, since the vpx
+	// keyframe-mode=disabled force-keyframe path below doesn't apply to h264). The videoconvert
+	// bridges the shared I420 capsfilter to whatever the encoder actually takes (NVENC on WSL
+	// probes NV12-only — the I420 caps won't link directly); it's passthrough when formats match.
+	case "h264":
+		build.writef("%s%s name=video_enc ", conv, cmp.Or(opts.Encoder, "x264enc"))
+	// av1 (patch 0024): nvav1enc emits an obu-stream. Pion's AV1 payloader wants TEMPORAL-UNIT aligned
+	// OBUs, so av1parse is not optional — without alignment=tu the receiver sees fragments of a TU and
+	// renders nothing. Same shape as the h264 case: element + tuning come from encoder.list.
+	case "av1":
+		build.writef("%s%s name=video_enc ", conv, cmp.Or(opts.Encoder, "nvav1enc"))
+	case "vp8", "vp9":
+		encoder := cmp.Or(opts.Encoder, fmt.Sprintf("vp%cenc", codec[len(codec)-1]))
+		threads := cmp.Or(conf.Video.Threads, cpuCores)
+		if maxThreads > 0 && threads > maxThreads {
+			threads = maxThreads
+		}
+		build.writef("%s name=video_enc threads=%d keyframe-max-dist=%d ", encoder, threads, kfi)
+	}
+	build.writeIfSet(opts.Params)
+	if opts.Caps != "" {
+		build.write(" ! " + opts.Caps)
+	}
+	// max-buffers raised 1→4 (patch 0004): with 1, any WriteSample stall >1 frame period silently
+	// killed a frame at the sink (~5fps of steady loss measured). 4 absorbs the stalls; drop=true
+	// still bounds worst-case latency to 4 frames under sustained overload.
+	build.write(" ! queue name=video_q2 max-size-buffers=1 ")
+	build.write("! appsink name=video_sink sync=false max-buffers=4 drop=true")
+
+	pipeDef := build.String()
+
+	log.Debug().Msgf("Gstreamer [video]: %s", pipeDef)
+
+	pipeline, err := gst.NewPipelineFromString(pipeDef)
+	if err != nil {
+		return nil, err
+	}
+	if glZeroCopy {
+		// Hand the pipeline the core's GL display + context BEFORE it goes to PLAYING. Without this its
+		// GL elements would create their own, isolated context — and the texture ids we push would be
+		// meaningless in it (garbage frames, not an error).
+		attachGLContext(pipeline)
+	}
+	sinkEl, err := pipeline.GetElementByName("video_sink")
+	if err != nil {
+		return nil, err
+	}
+	// Not fatal when absent: ABR simply stays off for that pipeline.
+	encEl, _ := pipeline.GetElementByName("video_enc")
+
+	p := &pipe{
+		pipeline: pipeline,
+		sink:     app.SinkFromElement(sinkEl),
+		enc:      encEl,
+		zeroCopy: zeroCopy,
+	}
+	if zeroCopy {
+		// No appsrc to own: the head is a live capture element and frames never enter Go. The valve
+		// is how desktop frames get gated instead (privacy); absent is not fatal, it just means the
+		// caller's chain didn't ask for one.
+		p.valve, _ = pipeline.GetElementByName("video_valve")
+	} else {
+		srcEl, err := pipeline.GetElementByName("video_src")
+		if err != nil {
+			return nil, err
+		}
+		p.source = app.SrcFromElement(srcEl)
+		p.srcPad = srcEl.GetStaticPad("src")
+	}
+
+	go watchBus(pipeline, log)
+	return p, nil
+}
+
+func buildAudioPipeline(srcHz int, conf config.Encoder, log *logger.Logger) (*pipe, error) {
+	opts := conf.AudioSettings()
+	if opts == nil {
+		return nil, fmt.Errorf("unsupported audio codec: %s", conf.Audio.Codec)
+	}
+
+	build := builder{}
+	build.Grow(384)
+	build.write("appsrc name=audio_src is-live=true ")
+	build.writef("caps=audio/x-raw,format=S16LE,rate=%d,channels=2,layout=interleaved ", srcHz)
+	if srcHz != 48_000 {
+		m, q := "kaiser", 10
+		switch conf.Audio.Resampler {
+		case 0:
+			m, q = "nearest", 0
+		case 1:
+			m, q = "linear", 4
+		}
+		build.write("! audioresample sinc-filter-mode=full ")
+		build.writef("resample-method=%s quality=%d ! audio/x-raw,rate=48000 ", m, q)
+	}
+	build.writef("! %s name=audio_enc %s ", cmp.Or(opts.Encoder, "opusenc"), opts.Params)
+	build.write("! queue name=audio_q max-size-buffers=1 ")
+	build.write("! appsink name=audio_sink sync=false max-buffers=1 drop=true")
+
+	pipeDef := build.String()
+	log.Debug().Msgf("Gstreamer [audio]: %s", pipeDef)
+
+	pipeline, err := gst.NewPipelineFromString(pipeDef)
+	if err != nil {
+		return nil, err
+	}
+	srcEl, _ := pipeline.GetElementByName("audio_src")
+	sinkEl, _ := pipeline.GetElementByName("audio_sink")
+	encEl, _ := pipeline.GetElementByName("audio_enc")
+
+	frameMs := defaultAudioFrameMs
+	if encEl != nil {
+		if v, e := encEl.GetProperty("frame-size"); e == nil {
+			if ms := v.(int); ms > 0 {
+				frameMs = time.Duration(ms) * time.Millisecond
+			}
+		}
+	}
+
+	go watchBus(pipeline, log)
+	return &pipe{
+		pipeline: pipeline,
+		source:   app.SrcFromElement(srcEl),
+		sink:     app.SinkFromElement(sinkEl),
+		srcPad:   srcEl.GetStaticPad("src"),
+		frameDur: frameMs,
+	}, nil
+}
+
+func gstVideoFormat(format string) uint32 {
+	if v, ok := pixFmtCache[format]; ok {
+		return v
+	}
+	pix := unsafe.Pointer(unsafe.StringData(format + "\x00"))
+	var p runtime.Pinner
+	p.Pin(pix)
+	defer p.Unpin()
+	v := uint32(C.gstVideoFormatFromString((*C.gchar)(pix)))
+	pixFmtCache[format] = v
+	return v
+}
+
+func round(x int, scale float64) int { return (int(float64(x)*scale) + 1) &^ 1 }
+
+func watchBus(pipeline *gst.Pipeline, log *logger.Logger) {
+	bus := pipeline.GetPipelineBus()
+
+	for {
+		msg := bus.TimedPop(gst.ClockTimeNone)
+		if msg == nil {
+			return
+		}
+		switch msg.Type() {
+		case gst.MessageError:
+			gerr := msg.ParseError()
+			log.Error().Str("debug", gerr.DebugString()).Err(gerr).Msg("gst pipeline error")
+		case gst.MessageWarning:
+			gerr := msg.ParseWarning()
+			if strings.Contains(gerr.Error(), "invalid video buffer") {
+				log.Debug().Str("debug", gerr.DebugString()).Err(gerr).Msg("gst pipeline warning")
+			} else {
+				log.Warn().Str("debug", gerr.DebugString()).Err(gerr).Msg("gst pipeline warning")
+			}
+		case gst.MessageEOS:
+			return
+		default:
+			// log.Debug().Msg("gst pipeline message: " + msg.String())
+		}
+	}
+}
+
+// SetVideoBitrate live-sets the video encoder's target bitrate. This is the whole reason ABR is cheap
+// here: the NVENC encoders — nvav1enc (the DEFAULT codec) and nvh264enc, plus x264enc — expose
+// `bitrate` (kbit/s) as "changeable in the PLAYING state", so the encoder reconfigures its rate
+// controller in place: no pipeline rebuild, no renegotiation, no reconnect, and (unlike a RESOLUTION
+// change, which re-inits the pipeline via Reinit) nothing the viewer can see.
+//
+// The switch below is therefore by PROPERTY NAME, not by codec family: vpx is the odd one out
+// (`target-bitrate`, in bit/s), and everything else — av1 included — takes `bitrate` in kbit/s.
+//
+// Safe to call before the pipeline exists: the value is remembered and applied by initVideo.
+func (g *GstMediaPipe) SetVideoBitrate(kbps int) error {
+	if kbps <= 0 {
+		return nil
+	}
+	g.vBitrate.Store(int64(kbps))
+	v := g.v
+	if v == nil || v.enc == nil {
+		return nil
+	}
+	switch strings.ToLower(g.conf.Video.Codec) {
+	case "vp8", "vp9":
+		return v.enc.SetProperty("target-bitrate", kbps*1000)
+	default: // h264 (nvh264enc / x264enc)
+		if err := v.enc.SetProperty("bitrate", uint(kbps)); err != nil {
+			return err
+		}
+		// Scale the VBV/HRD buffer with the target: kbps/20 kbits ≈ 3 frame-budgets at 60fps
+		// (arcade patch 0025). An unbounded VBV lets a CBR IDR burst to 4-6x the per-frame budget
+		// (measured: 94KB IDR in a 14 Mbps stream whose frames average 22KB) — on a thin remote
+		// link that bulge delays everything behind it, audio included: the residual keyframe
+		// hitch. Capping at 3 budgets halved the worst burst for -0.65..-1.5 dB, paid only in
+		// transparent-quality territory (undershooting CBR). Offline matrix + tradeoff table:
+		// docs/arcade-quality-plan.md §17. nvh264enc property, live-changeable; x264enc names its
+		// equivalent differently, so this is best-effort by design (a failed set must never kill
+		// the bitrate rung that just succeeded).
+		if err := v.enc.SetProperty("vbv-buffer-size", uint(max(kbps/20, 100))); err != nil {
+			g.log.Debug().Err(err).Msg("vbv-buffer-size not settable on this encoder")
+		}
+		return nil
+	}
+}
+
+// VideoBitrate is the ABR target currently applied (kbps), or 0 if ABR never set one.
