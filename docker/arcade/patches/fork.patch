new file mode 100644
index 0000000..5646d4c
--- /dev/null
+++ b/pkg/coordinator/health.go
@@ -0,0 +1,123 @@
+package coordinator
+
+import (
+	"net/http"
+	"time"
+
+	"github.com/giongto35/cloud-game/v3/pkg/com"
+)
+
+// Worker idle/liveness health-check (MovieTheater).
+//
+// THE ZOMBIE-WORKER FIX. A worker is normally removed from the hub only when its coordinator WS
+// connection closes (handleWorkerConnection's deferred RemoveDisconnect). But a worker that crashes
+// into a wedged, unkillable 1-thread process — the observed failure after an idle/teardown core crash
+// or the citra GL-load crash — keeps its half-open TCP socket, so that disconnect NEVER fires. The dead
+// worker then lingers in the registry, keeps being handed rooms by findWorkerFor / find1stFreeWorker,
+// and every room routed to it hangs at "Negotiating" while the whole main zone reads as "the arcade is
+// full". Recovery previously required a coordinator restart or a full box reboot.
+//
+// This monitor makes that a self-healing capacity blip instead of an outage: it periodically GETs each
+// worker's own HTTP /echo endpoint (Worker.PingServer, already advertised in the handshake). A live
+// worker answers /echo from its HTTP goroutine regardless of what the emulator thread is doing — so a
+// genuinely SLOW room (a cold PS2 boot, a shader cache) still passes and is NEVER dropped. A process
+// that is actually dead cannot answer at all; after maxFails consecutive failures it is deregistered
+// (Disconnect + Remove), including one that still claims a RoomId, because that room is already lost
+// with the process. We do NOT try to kill the wedged process (proven futile — it needs a reboot); we
+// just stop routing rooms to it, which is what turns the outage into a blip.
+const (
+	healthCheckInterval = 15 * time.Second
+	healthCheckTimeout  = 4 * time.Second
+	healthCheckMaxFails = 4 // ~60s unresponsive before deregister — rides out transient blips
+)
+
+type workerHealthMonitor struct {
+	hub      *Hub
+	interval time.Duration
+	timeout  time.Duration
+	maxFails int
+	client   *http.Client
+	fails    map[com.Uid]int
+}
+
+// startHealthMonitor launches the background worker-liveness loop. Call once, from the real
+// coordinator's Start() (never from NewHub, which unit tests use with unreachable fake workers).
+func (h *Hub) startHealthMonitor() {
+	m := &workerHealthMonitor{
+		hub:      h,
+		interval: healthCheckInterval,
+		timeout:  healthCheckTimeout,
+		maxFails: healthCheckMaxFails,
+		client:   &http.Client{Timeout: healthCheckTimeout},
+		fails:    map[com.Uid]int{},
+	}
+	go m.run()
+	h.log.Info().Msgf("worker health monitor started (every %v, drop after %d misses)", m.interval, m.maxFails)
+}
+
+func (m *workerHealthMonitor) run() {
+	t := time.NewTicker(m.interval)
+	defer t.Stop()
+	for range t.C {
+		m.tick()
+	}
+}
+
+func (m *workerHealthMonitor) tick() {
+	// Snapshot under the map's RLock FIRST: NetMap.Values holds an RLock for the whole range, so
+	// calling RemoveDisconnect (a write) inside the range would deadlock. Ping + remove happen after.
+	var snapshot []*Worker
+	for w := range m.hub.workers.Values() {
+		snapshot = append(snapshot, w)
+	}
+
+	seen := make(map[com.Uid]struct{}, len(snapshot))
+	for _, w := range snapshot {
+		id := w.Id()
+		seen[id] = struct{}{}
+		if m.alive(w) {
+			if m.fails[id] > 0 {
+				m.hub.log.Info().Msgf("worker %v health recovered after %d misses", id, m.fails[id])
+				delete(m.fails, id)
+			}
+			continue
+		}
+		m.fails[id]++
+		n := m.fails[id]
+		m.hub.log.Warn().Msgf("worker %v missed health check %d/%d (room=%q free=%v ping=%v)",
+			id, n, m.maxFails, w.RoomId, w.HasSlot(), w.PingServer)
+		if n >= m.maxFails {
+			m.hub.log.Error().Msgf("worker %v unresponsive x%d — deregistering dead worker (room=%q); "+
+				"the process is wedged and needs an external restart/reboot, but it will no longer receive rooms",
+				id, n, w.RoomId)
+			m.hub.workers.RemoveDisconnect(w)
+			delete(m.fails, id)
+		}
+	}
+
+	// Forget counters for workers that left the registry on their own (clean disconnect).
+	for id := range m.fails {
+		if _, ok := seen[id]; !ok {
+			delete(m.fails, id)
+		}
+	}
+}
+
+// alive reports whether the worker answers its own HTTP /echo. A transport error (connect refused/reset,
+// timeout) means the process is not serving — i.e. dead/wedged. An empty PingServer can't be checked, so
+// it is treated as alive (never punish a worker we simply can't probe).
+func (m *workerHealthMonitor) alive(w *Worker) bool {
+	if w.PingServer == "" {
+		return true
+	}
+	req, err := http.NewRequest(http.MethodGet, w.PingServer, nil)
+	if err != nil {
+		return true // malformed URL is our problem, not the worker's — don't deregister over it
+	}
+	resp, err := m.client.Do(req)
+	if err != nil {
+		return false
+	}
+	_ = resp.Body.Close()
+	return resp.StatusCode == http.StatusOK
+}
