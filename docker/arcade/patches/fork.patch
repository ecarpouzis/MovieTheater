+	SetAudioCb(func(Audio))
+	SetVideoCb(func(Video))
+	SetDataCb(func([]byte))
+	Input(port int, device byte, data []byte)
+	KbMouseSupport() bool
+}
+
+type Audio struct {
+	Data     []byte
+	Duration time.Duration
+}
+
+type Video struct {
+	Frame    RawFrame
+	Duration time.Duration
+}
+
+type RawFrame struct {
+	// Tex: GL zero-copy (HW cores). Non-zero => the frame is a GL texture, Data is nil.
+	Tex    uint32
+	// Serial: the zc-slot generation stamped on this texture (dup-pin). Lets handleDup verify the slot
+	// still holds THIS frame before re-pushing a borrowed texture. Zero for the readback path.
+	Serial uint64
+	Data   []byte
+	Stride int
+	W, H   int
+}
