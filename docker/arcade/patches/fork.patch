+// roomVideoCodec sanitizes a client-requested per-room video codec (patch 0036): lowercase, must
+// have an encoder.list entry, else the config default. Never trust the wire value — an unknown
+// codec would fail the pipeline build after the peer was already created.
+func (w *Worker) roomVideoCodec(requested string) string {
+	c := strings.ToLower(strings.TrimSpace(requested))
+	if c == "" {
+		return w.conf.Encoder.Video.Codec
+	}
+	if _, ok := w.conf.Encoder.List[c]; !ok {
+		w.log.Warn().Msgf("unknown per-room video codec %q, using config default %s", requested, w.conf.Encoder.Video.Codec)
+		return w.conf.Encoder.Video.Codec
+	}
+	return c
+}
