diff --git a/pkg/worker/caged/libretro/graphics/zerocopy.go b/pkg/worker/caged/libretro/graphics/zerocopy.go
new file mode 100644
index 0000000..55e039f
--- /dev/null
+++ b/pkg/worker/caged/libretro/graphics/zerocopy.go
@@ -0,0 +1,136 @@
+package graphics
+
+// GL zero-copy for hardware-rendered cores (n64/gc/ps2/psp/dc).
+//
+// The old path pulled every frame back with glReadPixels — SYNCHRONOUS, on the emulator thread, inside
+// video_refresh. It flushes the GL pipeline and blocks until the frame has crossed PCIe. Measured
+// (CLOUD_GAME_GL_READBACK_STATS=1): GameCube 1920x1584 = 11.6 MB/frame, p50 3.7-4.2 ms, p95 6-8 ms —
+// the core sits blocked for a QUARTER of a 60fps frame budget, and up to half at p95.
+//
+// Instead we hand the encoder the texture: nvav1enc takes video/x-raw(memory:GLMemory) in RGBA
+// directly, so the frame never leaves VRAM.
+//
+// ── OWNERSHIP IS THE WHOLE PROBLEM, AND IT IS NOT OBVIOUS ──────────────────────────────────────────
+// The core re-renders into the SAME texture every frame, so we copy each frame GPU->GPU into a pool
+// texture and hand the encoder THAT. But a GstBuffer holds a *reference* to the texture, not a
+// snapshot — and the encoder consumes buffers asynchronously, several frames deep (the queue plus the
+// appsink hold ~5-6). A pool that simply cycles will therefore overwrite a texture the encoder has not
+// read yet, and that frame encodes pixels from the FUTURE. Then the next buffer shows the correct,
+// older content.
+//
+// That is not tearing and it is not a dropped frame — it is TIME going backwards, and it showed up
+// live as a scrolling marquee ("Select a Cup.") jumping back and forth while everything else looked
+// fine: 60fps, no freezes, no NACKs, clean audio.
+//
+// So a texture is only reusable once GStreamer has RELEASED the buffer holding it. Each wrapped
+// texture carries a destroy-notify that returns it to the free list (see media/glzerocopy.go); the
+// core takes the next FREE one, and if none is free it says so and the caller falls back to the
+// readback for that frame — a slow frame is always better than a wrong one.
+
+import (
+	"fmt"
+	"sync"
+)
+
+// zcPoolSize must comfortably exceed the number of buffers that can be in flight (queue + appsink +
+// the encoder's own). 8 is generous; each texture is only w*h*4 of VRAM and running out just means one
+// frame takes the readback path.
+const zcPoolSize = 8
+
+var (
+	zcMu     sync.Mutex
+	zcPool   []uint32 // every texture we own
+	zcFree   []uint32 // the ones GStreamer is not holding
+	zcW, zcH int32
+)
+
+// InitZeroCopyPool (re)allocates the texture pool for a frame size. Runs on the GL thread with the
+// core's context current.
+func InitZeroCopyPool(w, h int32) error {
+	if gpCopyImageSubData == nil {
+		return fmt.Errorf("glCopyImageSubData unavailable (needs GL 4.3+); GL zero-copy cannot run")
+	}
+	zcMu.Lock()
+	sized := zcW == w && zcH == h && len(zcPool) == zcPoolSize
+	zcMu.Unlock()
+	if sized {
+		return nil
+	}
+	FreeZeroCopyPool()
+
+	pool := make([]uint32, zcPoolSize)
+	genTextures(zcPoolSize, &pool[0])
+	for _, id := range pool {
+		bindTexture(gl_TEXTURE_2D, id)
+		texParameteri(gl_TEXTURE_2D, gl_TEXTURE_MIN_FILTER, gl_NEAREST)
+		texParameteri(gl_TEXTURE_2D, gl_TEXTURE_MAG_FILTER, gl_NEAREST)
+		texImage2D(gl_TEXTURE_2D, 0, gl_RGBA8, w, h, 0, pixType, pixFormat, nil)
+	}
+	bindTexture(gl_TEXTURE_2D, 0)
+
+	zcMu.Lock()
+	zcPool = pool
+	zcFree = append([]uint32(nil), pool...)
+	zcW, zcH = w, h
+	zcMu.Unlock()
+	return nil
+}
+
+// FreeZeroCopyPool deletes the textures. GL thread only.
+func FreeZeroCopyPool() {
+	zcMu.Lock()
+	pool := zcPool
+	zcPool, zcFree, zcW, zcH = nil, nil, 0, 0
+	zcMu.Unlock()
+
+	if len(pool) > 0 {
+		deleteTextures(int32(len(pool)), &pool[0])
+	}
+}
+
+// ReleaseZeroCopyTexture returns a texture to the free list. Called from GStreamer's thread when it
+// frees the buffer that wrapped it — that, and ONLY that, is what makes the texture safe to reuse.
+func ReleaseZeroCopyTexture(id uint32) {
+	zcMu.Lock()
+	defer zcMu.Unlock()
+	// Ignore textures from a pool we have already thrown away (a geometry change mid-flight).
+	for _, p := range zcPool {
+		if p == id {
+			zcFree = append(zcFree, id)
+			return
+		}
+	}
+}
+
+// CopyFrameToPool copies the core's just-rendered frame into a FREE pool texture and returns its id.
+// GPU->GPU: no readback, no CPU copy, and the emulator thread never blocks on PCIe.
+//
+// Returns 0 when the pool is unusable or every texture is still held by the encoder — the caller must
+// treat that as "use the readback for this frame", never as an empty frame.
+func CopyFrameToPool(w, h int32) uint32 {
+	zcMu.Lock()
+	needInit := len(zcPool) == 0 || w != zcW || h != zcH
+	zcMu.Unlock()
+	if needInit {
+		if err := InitZeroCopyPool(w, h); err != nil {
+			return 0
+		}
+	}
+
+	zcMu.Lock()
+	if len(zcFree) == 0 {
+		zcMu.Unlock()
+		return 0 // encoder is holding every texture; this frame goes the slow way
+	}
+	dst := zcFree[len(zcFree)-1]
+	zcFree = zcFree[:len(zcFree)-1]
+	zcMu.Unlock()
+
+	// tex is the FBO's colour attachment — what the core just rendered into.
+	copyImageSubData(tex, dst, w, h)
+	// The encoder reads this texture from ANOTHER context, on another thread, as soon as we return. A
+	// glFlush would only mean "submitted", not "done" — so wait for the copy to actually land. No PCIe
+	// transfer happens here (that is the 11 MB/frame we are removing); this is a GPU-side sync only.
+	finish()
+	return dst
+}
