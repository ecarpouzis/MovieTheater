+static int rc_libretro_string_equal_nocase_wildcard(const char* test, const char* match) {
+  char c1, c2;
+  while ((c1 = *test++)) {
+    if (tolower(c1) != tolower(c2 = *match++) && c2 != '?')
+      return (c2 == '*');
+  }
+
+  return (*match == '\0');
+}
