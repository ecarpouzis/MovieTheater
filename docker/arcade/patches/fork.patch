+
+func TestClearDirCreatesWhenAbsent(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "not-there")
+	if err := ClearDir(dir); err != nil {
+		t.Fatal(err)
+	}
+	if !Exists(dir) {
