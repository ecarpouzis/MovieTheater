diff --git a/pkg/worker/caged/libretro/nanoarch/nanoarch_vulkan.c b/pkg/worker/caged/libretro/nanoarch/nanoarch_vulkan.c
new file mode 100644
index 0000000..4fc504d
--- /dev/null
+++ b/pkg/worker/caged/libretro/nanoarch/nanoarch_vulkan.c
@@ -0,0 +1,1728 @@
+// MovieTheater arcade — Vulkan-capture frontend (M1: readback path).
+//
+// Lets the CloudRetro worker host libretro cores that render with RETRO_HW_CONTEXT_VULKAN
+// (LRPS2 pcsx2_renderer "paraLLEl-GS" is the M1 target) and deliver their frames through the
+// EXISTING CPU video path: per frame we copy the core's VkImage into a host-visible staging
+// buffer and hand the pixels to nanoarch's software-frame flow (XRGB8888).
+//
+// This module is the frontend "half" of the libretro Vulkan interface, modelled on RetroArch's
+// gfx/common/vulkan_common.c minus the swapchain (we never present):
+//   * honor SET_HW_RENDER_CONTEXT_NEGOTIATION_INTERFACE (v1 and v2),
+//   * bring up VkInstance + VkDevice via the core's create_instance / create_device2 wrappers,
+//   * build the retro_hw_render_interface_vulkan (interface_version 5) the core fetches at
+//     context_reset,
+//   * implement set_image / get_sync_index{,_mask} / wait_sync_index / lock_queue / unlock_queue /
+//     set_command_buffers / set_signal_semaphore,
+//   * per-frame blit+copy readback into a mapped host buffer (BGRA == libretro XRGB8888 layout).
+//
+// We never link a Vulkan SDK: vulkan-1.dll is loaded at runtime and every entry point is resolved
+// through vkGetInstanceProcAddr / vkGetDeviceProcAddr, so VK_NO_PROTOTYPES is set before the headers.
+//
+// Threading: nano_vk_init, nano_vk_readback and the teardown all run on the core's LibCo cothread
+// (same_thread). set_image is called by the core immediately before video_cb on that same thread.
+// lock_queue / unlock_queue guard the shared VkQueue against the core's OWN submit threads (paraLLEl-GS
+// submits from the GS thread under the same lock — GSRendererPGS.cpp:221-228), so every submit we make
+// is wrapped in the same mutex.
+
+#include <windows.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <string.h>
+
+#define VK_NO_PROTOTYPES
+#include "libretro_vulkan.h"
+// M2 zero-copy: the Win32 external-memory / external-semaphore entry points and structs
+// (VK_KHR_external_memory_win32, VK_KHR_external_semaphore_win32). Vendored verbatim from the LRPS2
+// tree; needs windows.h (HANDLE/DWORD/LPCWSTR — included above) and the core types (vulkan_core.h,
+// pulled in through libretro_vulkan.h). VK_NO_PROTOTYPES keeps it declaration-only (we resolve
+// through vkGetDeviceProcAddr like everything else).
+#include "vulkan/vulkan_win32.h"
+
+// core_log_cgo routes into the Go logger (defined in nanoarch.c, variadic). We do NOT include
+// nanoarch.h here: its forward-declaration of core_log_cgo is a simplified non-variadic stub that
+// would conflict, and the nano_vk_* prototypes it declares are for the Go/cgo side, not this file.
+void core_log_cgo(enum retro_log_level level, const char *fmt, ...);
+#define VKLOG(lvl, ...) core_log_cgo(lvl, "[vk] " __VA_ARGS__)
+
+// Number of in-flight readback slots (command buffer + fence). paraLLEl-GS never calls
+// get_sync_index / wait_sync_index, but the interface promises a ring, so we keep one.
+#define NANO_VK_SYNC 2
+
+// XRGB8888 as libretro/nanoarch's CPU path expects it: a 32-bit pixel 0x00RRGGBB, i.e. bytes
+// [B,G,R,X] in memory. Blitting the core's R8G8B8A8_UNORM image into a B8G8R8A8_UNORM image makes
+// Vulkan do the R<->B channel move for us, so the copied buffer is already in that byte order.
+// If colors ever come out swapped, flip this one define to VK_FORMAT_R8G8B8A8_UNORM.
+#define NANO_VK_STAGE_FORMAT VK_FORMAT_B8G8R8A8_UNORM
+
+// ---- resolved Vulkan entry points ------------------------------------------------------------------
+struct vkfns {
+    PFN_vkGetInstanceProcAddr                 GetInstanceProcAddr;
+    PFN_vkGetDeviceProcAddr                   GetDeviceProcAddr;
+    PFN_vkCreateInstance                      CreateInstance;
+    PFN_vkDestroyInstance                     DestroyInstance;
+    PFN_vkEnumeratePhysicalDevices            EnumeratePhysicalDevices;
+    PFN_vkGetPhysicalDeviceProperties         GetPhysicalDeviceProperties;
+    PFN_vkGetPhysicalDeviceMemoryProperties   GetPhysicalDeviceMemoryProperties;
+    PFN_vkGetPhysicalDeviceQueueFamilyProperties GetPhysicalDeviceQueueFamilyProperties;
+    PFN_vkCreateDevice                        CreateDevice;
+    PFN_vkDestroyDevice                       DestroyDevice;
+    PFN_vkGetDeviceQueue                      GetDeviceQueue;
+    PFN_vkCreateCommandPool                   CreateCommandPool;
+    PFN_vkDestroyCommandPool                  DestroyCommandPool;
+    PFN_vkAllocateCommandBuffers              AllocateCommandBuffers;
+    PFN_vkFreeCommandBuffers                  FreeCommandBuffers;
+    PFN_vkBeginCommandBuffer                  BeginCommandBuffer;
+    PFN_vkEndCommandBuffer                    EndCommandBuffer;
+    PFN_vkResetCommandBuffer                  ResetCommandBuffer;
+    PFN_vkCmdPipelineBarrier                  CmdPipelineBarrier;
+    PFN_vkCmdBlitImage                        CmdBlitImage;
+    PFN_vkCmdCopyImageToBuffer                CmdCopyImageToBuffer;
+    PFN_vkCreateImage                         CreateImage;
+    PFN_vkDestroyImage                        DestroyImage;
+    PFN_vkGetImageMemoryRequirements          GetImageMemoryRequirements;
+    PFN_vkCreateBuffer                        CreateBuffer;
+    PFN_vkDestroyBuffer                       DestroyBuffer;
+    PFN_vkGetBufferMemoryRequirements         GetBufferMemoryRequirements;
+    PFN_vkAllocateMemory                      AllocateMemory;
+    PFN_vkFreeMemory                          FreeMemory;
+    PFN_vkBindImageMemory                     BindImageMemory;
+    PFN_vkBindBufferMemory                    BindBufferMemory;
+    PFN_vkMapMemory                           MapMemory;
+    PFN_vkUnmapMemory                         UnmapMemory;
+    PFN_vkCreateFence                         CreateFence;
+    PFN_vkDestroyFence                        DestroyFence;
+    PFN_vkResetFences                         ResetFences;
+    PFN_vkWaitForFences                       WaitForFences;
+    PFN_vkQueueSubmit                         QueueSubmit;
+    PFN_vkDeviceWaitIdle                      DeviceWaitIdle;
+    // M2 zero-copy: device-extension enumeration (instance-level), external-memory/semaphore export.
+    PFN_vkEnumerateDeviceExtensionProperties  EnumerateDeviceExtensionProperties;
+    PFN_vkGetMemoryWin32HandleKHR             GetMemoryWin32HandleKHR;
+    PFN_vkGetSemaphoreWin32HandleKHR          GetSemaphoreWin32HandleKHR;
+    PFN_vkCreateSemaphore                     CreateSemaphore;
+    PFN_vkDestroySemaphore                    DestroySemaphore;
+};
+
+// ---- M2 zero-copy: GL external-object entry points (EXT_memory_object[_win32], EXT_semaphore[_win32])
+// ------------------------------------------------------------------------------------------------
+// Resolved through the RGFW/WGL getProcAddress handed in from Go — the SAME context the imported
+// textures live in must be current when these run. We hand-load only the handful we need (plus the
+// core GL calls glGenTextures/glBindTexture/glTexParameteri/glFlush that opengl32 exports) to avoid a
+// GL header dependency in this translation unit.
+#ifndef APIENTRY
+#define APIENTRY
+#endif
+typedef unsigned int   GLenum;
+typedef unsigned int   GLuint;
+typedef int            GLint;
+typedef int            GLsizei;
+typedef unsigned long long GLuint64;
+typedef float          GLfloat;
+
+// GL enums we need (EXT_memory_object[_win32] / EXT_semaphore + core).
+#define GL_HANDLE_TYPE_OPAQUE_WIN32_EXT 0x9587
+#define GL_RGBA8                        0x8058
+#define GL_TEXTURE_2D                   0x0DE1
+#define GL_TEXTURE_MIN_FILTER           0x2801
+#define GL_TEXTURE_MAG_FILTER           0x2800
+#define GL_LINEAR                       0x2601
+#define GL_NEAREST                      0x2600
+#define GL_LAYOUT_SHADER_READ_ONLY_EXT  0x9590
+
+typedef void (APIENTRY *PFNGLCREATEMEMORYOBJECTSEXT)(GLsizei, GLuint*);
+typedef void (APIENTRY *PFNGLDELETEMEMORYOBJECTSEXT)(GLsizei, const GLuint*);
+typedef void (APIENTRY *PFNGLIMPORTMEMORYWIN32HANDLEEXT)(GLuint, GLuint64, GLenum, void*);
+typedef void (APIENTRY *PFNGLTEXSTORAGEMEM2DEXT)(GLenum, GLsizei, GLenum, GLsizei, GLsizei, GLuint, GLuint64);
+typedef void (APIENTRY *PFNGLGENSEMAPHORESEXT)(GLsizei, GLuint*);
+typedef void (APIENTRY *PFNGLDELETESEMAPHORESEXT)(GLsizei, const GLuint*);
+typedef void (APIENTRY *PFNGLIMPORTSEMAPHOREWIN32HANDLEEXT)(GLuint, GLenum, void*);
+typedef void (APIENTRY *PFNGLWAITSEMAPHOREEXT)(GLuint, GLuint, const GLuint*, GLuint, const GLuint*, const GLenum*);
+typedef void (APIENTRY *PFNGLGENTEXTURES)(GLsizei, GLuint*);
+typedef void (APIENTRY *PFNGLDELETETEXTURES)(GLsizei, const GLuint*);
+typedef void (APIENTRY *PFNGLBINDTEXTURE)(GLenum, GLuint);
+typedef void (APIENTRY *PFNGLTEXPARAMETERI)(GLenum, GLenum, GLint);
+typedef void (APIENTRY *PFNGLFLUSH)(void);
+typedef GLenum (APIENTRY *PFNGLGETERROR)(void);
+
+struct glfns {
+    PFNGLCREATEMEMORYOBJECTSEXT        CreateMemoryObjectsEXT;
+    PFNGLDELETEMEMORYOBJECTSEXT        DeleteMemoryObjectsEXT;
+    PFNGLIMPORTMEMORYWIN32HANDLEEXT    ImportMemoryWin32HandleEXT;
+    PFNGLTEXSTORAGEMEM2DEXT            TexStorageMem2DEXT;
+    PFNGLGENSEMAPHORESEXT              GenSemaphoresEXT;
+    PFNGLDELETESEMAPHORESEXT           DeleteSemaphoresEXT;
+    PFNGLIMPORTSEMAPHOREWIN32HANDLEEXT ImportSemaphoreWin32HandleEXT;
+    PFNGLWAITSEMAPHOREEXT              WaitSemaphoreEXT;
+    PFNGLGENTEXTURES                   GenTextures;
+    PFNGLDELETETEXTURES                DeleteTextures;
+    PFNGLBINDTEXTURE                   BindTexture;
+    PFNGLTEXPARAMETERI                 TexParameteri;
+    PFNGLFLUSH                         Flush;
+    PFNGLGETERROR                      GetError;
+};
+
+// Number of zero-copy pool slots. The spec suggests N=3, but the GL zero-copy path
+// (graphics/zerocopy.go) documents — with a live marquee-jitter regression as the evidence — that the
+// encoder holds 5-6 buffers in flight (queue + appsink + nvenc), so a 3-slot pool would starve and
+// dup most frames. We mirror the proven GL pool size (8); each slot is only w*h*4 of VRAM. See the
+// RESULTS deviations note.
+#define NANO_VK_ZC_SLOTS 8
+#define NANO_VK_ZC_FORMAT VK_FORMAT_R8G8B8A8_UNORM  // RGBA (NOT M1's BGRA): the GL zc path ships RGBA
+
+// ---- module state ----------------------------------------------------------------------------------
+struct nano_vk {
+    HMODULE                 dll;
+    struct vkfns            fn;
+
+    struct retro_hw_render_context_negotiation_interface_vulkan negotiation;
+    int                     have_negotiation;
+
+    VkInstance              instance;
+    VkPhysicalDevice        gpu;
+    VkDevice                device;
+    VkQueue                 queue;
+    uint32_t                queue_family;
+    VkPhysicalDeviceMemoryProperties mem_props;
+
+    // ---- synthetic headless surface (hack vk_synthetic_surface) --------------------------------
+    // Some libretro Vulkan cores (PPSSPP) DEMAND a non-null VkSurfaceKHR. PPSSPP's LibretroVulkanContext
+    // create_device unconditionally calls VulkanContext::InitSurface(WIN32, null, null) then, at
+    // ContextReset, ReinitSurface -> vkCreateWin32SurfaceKHR. That call is warped (LoadInstanceFunctions
+    // runs AFTER vk_libretro_init installs the warp) to vkCreateLibretroSurfaceKHR, which ECHOES the
+    // frontend's surface handle (vk_init_info.surface) back — ignoring the null window data. PPSSPP then
+    // queries surface caps on that handle through the REAL driver; a VK_NULL_HANDLE there access-violates
+    // (live 2026-07-16, psp Daxter: "Creating Vulkan surface for window (data1=0 data2=0)" -> 0xC0000005).
+    // So we hand the core a REAL surface backed by a hidden window. paraLLEl-GS/paraLLEl-RDP never touch a
+    // surface, so this is strictly opt-in per core (the hack) and leaves those paths at VK_NULL_HANDLE.
+    int          synth_surface_wanted; // armed before nano_vk_init (hack vk_synthetic_surface)
+    HWND         synth_hwnd;           // hidden WS_POPUP window backing the surface (never shown)
+    VkSurfaceKHR synth_surface;        // handed to create_device instead of VK_NULL_HANDLE
+
+    // The interface handed to the core (kept alive for the core's whole life).
+    struct retro_hw_render_interface_vulkan iface;
+    int                     iface_ready;
+
+    // Frontend->frontend queue lock (the core takes it around its own submits).
+    pthread_mutex_t         queue_mutex;
+
+    // Sync ring.
+    VkCommandPool           cmd_pool;
+    VkCommandBuffer         cmd[NANO_VK_SYNC];
+    VkFence                 fence[NANO_VK_SYNC];
+    uint32_t                sync_index;
+
+    // Latest image handed over by set_image (copied — the pointer's lifetime ends at the next call).
+    int                     have_image;
+    VkImage                 src_image;
+    VkImageLayout           src_layout;
+    // FULL extent (and format) of the core's image. NOT the same as the video_cb geometry when the
+    // core renders internally upscaled (paraLLEl-GS pgs_high_res_scanout / pgs_ssaa): video_cb still
+    // reports the BASE size while the VkImage is larger, and the blit must read the WHOLE image and
+    // let vkCmdBlitImage scale it down — reading only {video_cb w,h} would crop the top-left corner.
+    uint32_t                src_w, src_h;
+    VkFormat                src_format;
+    // set_image semaphores to wait on once (defensive; paraLLEl-GS passes none).
+    VkSemaphore             wait_sems[8];
+    uint32_t                num_wait_sems;
+    VkSemaphore             signal_sem;
+
+    // Staging: blit target image (NANO_VK_STAGE_FORMAT) + host-visible readback buffer (mapped).
+    uint32_t                stage_w, stage_h;
+    VkImage                 stage_image;
+    VkDeviceMemory          stage_image_mem;
+    VkBuffer                stage_buf;
+    VkDeviceMemory          stage_buf_mem;
+    void                   *stage_mapped;
+    int                     command_buffers_warned;
+
+    // ---- M2 zero-copy state -------------------------------------------------------------------
+    int                     zc_enabled;   // room requested zero-copy (set before nano_vk_init)
+    int                     zc_fallback;  // a required extension was missing -> M1 readback instead
+    int                     zc_active;    // pool built and usable
+    int                     zc_sync_fence;// 1 = conservative layer-2 (host fence-wait the blit)
+    struct glfns            gl;
+    void                   *(*gl_getproc)(const char *); // RGFW getProcAddress (from Go)
+    pthread_mutex_t         zc_mutex;     // guards the free list (GStreamer releases from its thread)
+    int                     zc_mutex_init;
+    uint32_t                zc_w, zc_h;   // current pool geometry
+    // Per-slot: exportable VkImage + dedicated memory + GL import + Vk->GL "ready" semaphore + fence.
+    VkImage                 zc_image[NANO_VK_ZC_SLOTS];
+    VkDeviceMemory          zc_mem[NANO_VK_ZC_SLOTS];
+    GLuint                  zc_glmem[NANO_VK_ZC_SLOTS];
+    GLuint                  zc_tex[NANO_VK_ZC_SLOTS];
+    VkSemaphore             zc_ready[NANO_VK_ZC_SLOTS];   // Vulkan signals, GL waits
+    GLuint                  zc_gl_ready[NANO_VK_ZC_SLOTS];
+    VkFence                 zc_fence[NANO_VK_ZC_SLOTS];
+    VkCommandBuffer         zc_cmd[NANO_VK_ZC_SLOTS];
+    int                     zc_free[NANO_VK_ZC_SLOTS];    // 1 = free (GStreamer not holding it)
+    int                     zc_submitted[NANO_VK_ZC_SLOTS]; // 1 = fence pending (needs a wait before reuse)
+    VkCommandPool           zc_cmd_pool;
+    // One retired generation kept alive across a geometry flip so a texture GStreamer still holds is
+    // never freed under it (external memory: freeing the VkImage under a live GL sampler is a shared-
+    // memory use-after-free, worse than the GL path's plain-texture case). Destroyed on the NEXT flip
+    // or at teardown.
+    // Fences + command buffers are geometry-INDEPENDENT: created once in nano_vk_zc_setup and reused
+    // across reallocs (a flip vkDeviceWaitIdle's first, so the old submits are done and the buffers are
+    // free to re-record). They are NOT part of a generation and must NOT be retired/destroyed on a flip.
+    int                     zc_retired_valid;
+    VkImage                 zc_r_image[NANO_VK_ZC_SLOTS];
+    VkDeviceMemory          zc_r_mem[NANO_VK_ZC_SLOTS];
+    GLuint                  zc_r_glmem[NANO_VK_ZC_SLOTS];
+    GLuint                  zc_r_tex[NANO_VK_ZC_SLOTS];
+    VkSemaphore             zc_r_ready[NANO_VK_ZC_SLOTS];
+    GLuint                  zc_r_gl_ready[NANO_VK_ZC_SLOTS];
+};
+
+static struct nano_vk vk;
+
+// --- Vulkan capture debug instrumentation (gated by CLOUD_GAME_VK_DEBUG on the Go side; counters are
+// always incremented — cheap, single-cothread — and dumped on demand by nano_vk_dbg_log). Built to
+// answer, per the gc root-cause rules: does set_image fire? does the zc frame path return a texture or
+// drop, and WHY? See RESULTS-vulkan-w3.md §gc. Kept as a permanent debug flag (Stuntman-profiler precedent).
+static struct {
+    unsigned long long set_image;   // core called cb_set_image (handed us a VkImage)
+    unsigned long long zc_call;     // nano_vk_zc_frame entered
+    unsigned long long zc_tex;      // returned a real texture id (frame delivered)
+    unsigned long long r_noactive;  // dropped: pool not active
+    unsigned long long r_noimage;   // dropped: no set_image yet (vk.have_image==0)
+    unsigned long long r_sub16;     // dropped: <16px on an axis
+    unsigned long long r_noslot;    // dropped: encoder holds every pool slot
+    unsigned long long r_reallocf;  // dropped: pool realloc failed
+    unsigned long long sem_begin;   // GL semaphore wait started
+    unsigned long long sem_done;    // GL semaphore wait returned
+    unsigned last_w, last_h;        // last geometry seen by nano_vk_zc_frame
+    unsigned sub16_w, sub16_h;      // last sub-16px geometry dropped
+} vk_dbg;
+
+void nano_vk_dbg_reset(void) { memset(&vk_dbg, 0, sizeof(vk_dbg)); }
+void nano_vk_dbg_log(void) {
+    VKLOG(RETRO_LOG_INFO, "[vkdbg-c] set_image=%llu zc_call=%llu zc_tex=%llu | drops: noActive=%llu noImage=%llu "
+          "sub16=%llu(%ux%u) noSlot=%llu reallocFail=%llu | sem(begin=%llu done=%llu) last=%ux%u\n",
+          vk_dbg.set_image, vk_dbg.zc_call, vk_dbg.zc_tex, vk_dbg.r_noactive, vk_dbg.r_noimage,
+          vk_dbg.r_sub16, vk_dbg.sub16_w, vk_dbg.sub16_h, vk_dbg.r_noslot, vk_dbg.r_reallocf,
+          vk_dbg.sem_begin, vk_dbg.sem_done, vk_dbg.last_w, vk_dbg.last_h);
+}
+
+// ===================================================================================================
+// Loader + negotiation
+// ===================================================================================================
+
+static int load_instance_fns(void) {
+    PFN_vkGetInstanceProcAddr gipa = vk.fn.GetInstanceProcAddr;
+#define IFN(name) \
+    vk.fn.name = (PFN_vk##name)gipa(vk.instance, "vk" #name); \
+    if (!vk.fn.name) { VKLOG(RETRO_LOG_ERROR, "missing instance fn vk" #name "\n"); return -1; }
+    IFN(DestroyInstance)
+    IFN(EnumeratePhysicalDevices)
+    IFN(GetPhysicalDeviceProperties)
+    IFN(GetPhysicalDeviceMemoryProperties)
+    IFN(GetPhysicalDeviceQueueFamilyProperties)
+    IFN(CreateDevice)
+    IFN(GetDeviceProcAddr)
+    IFN(EnumerateDeviceExtensionProperties)
+#undef IFN
+    return 0;
+}
+
+static int load_device_fns(void) {
+    PFN_vkGetDeviceProcAddr gdpa = vk.fn.GetDeviceProcAddr;
+#define DFN(name) \
+    vk.fn.name = (PFN_vk##name)gdpa(vk.device, "vk" #name); \
+    if (!vk.fn.name) { VKLOG(RETRO_LOG_ERROR, "missing device fn vk" #name "\n"); return -1; }
+    DFN(DestroyDevice)
+    DFN(GetDeviceQueue)
+    DFN(CreateCommandPool)
+    DFN(DestroyCommandPool)
+    DFN(AllocateCommandBuffers)
+    DFN(FreeCommandBuffers)
+    DFN(BeginCommandBuffer)
+    DFN(EndCommandBuffer)
+    DFN(ResetCommandBuffer)
+    DFN(CmdPipelineBarrier)
+    DFN(CmdBlitImage)
+    DFN(CmdCopyImageToBuffer)
+    DFN(CreateImage)
+    DFN(DestroyImage)
+    DFN(GetImageMemoryRequirements)
+    DFN(CreateBuffer)
+    DFN(DestroyBuffer)
+    DFN(GetBufferMemoryRequirements)
+    DFN(AllocateMemory)
+    DFN(FreeMemory)
+    DFN(BindImageMemory)
+    DFN(BindBufferMemory)
+    DFN(MapMemory)
+    DFN(UnmapMemory)
+    DFN(CreateFence)
+    DFN(DestroyFence)
+    DFN(ResetFences)
+    DFN(WaitForFences)
+    DFN(QueueSubmit)
+    DFN(DeviceWaitIdle)
+    DFN(CreateSemaphore)
+    DFN(DestroySemaphore)
+#undef DFN
+    return 0;
+}
+
+// Load the Win32-handle export entry points. These exist only when the device was created with
+// VK_KHR_external_memory_win32 / VK_KHR_external_semaphore_win32 (injected by create_device_wrapper),
+// so they are resolved separately from the mandatory device fns. Returns 0 on success.
+static int load_zc_win32_fns(void) {
+    PFN_vkGetDeviceProcAddr gdpa = vk.fn.GetDeviceProcAddr;
+    vk.fn.GetMemoryWin32HandleKHR    = (PFN_vkGetMemoryWin32HandleKHR)gdpa(vk.device, "vkGetMemoryWin32HandleKHR");
+    vk.fn.GetSemaphoreWin32HandleKHR = (PFN_vkGetSemaphoreWin32HandleKHR)gdpa(vk.device, "vkGetSemaphoreWin32HandleKHR");
+    if (!vk.fn.GetMemoryWin32HandleKHR || !vk.fn.GetSemaphoreWin32HandleKHR) {
+        VKLOG(RETRO_LOG_ERROR, "zero-copy: Win32 export entry points missing (external memory/semaphore not enabled)\n");
+        return -1;
+    }
+    return 0;
+}
+
+// Store the core's negotiation interface (from SET_HW_RENDER_CONTEXT_NEGOTIATION_INTERFACE). Returns 1
+// if it is a Vulkan negotiation interface, 0 otherwise.
+int nano_vk_set_negotiation_interface(const void *data) {
+    const struct retro_hw_render_context_negotiation_interface_vulkan *n = data;
+    if (!n || n->interface_type != RETRO_HW_RENDER_CONTEXT_NEGOTIATION_INTERFACE_VULKAN) {
+        VKLOG(RETRO_LOG_WARN, "negotiation interface is not Vulkan (type=%d)\n", n ? (int)n->interface_type : -1);
+        return 0;
+    }
+    vk.negotiation = *n;
+    vk.have_negotiation = 1;
+    VKLOG(RETRO_LOG_INFO, "negotiation interface stored (version %u, create_instance=%s create_device2=%s)\n",
+          n->interface_version,
+          n->create_instance ? "yes" : "no",
+          n->create_device2 ? "yes" : "no");
+    return 1;
+}
+
+// ===================================================================================================
+// Instance / device creation
+// ===================================================================================================
+
+// The core builds a VkInstanceCreateInfo and asks us to create the instance. We add nothing and just
+// create it: in v2 the CORE authors the extension list, so anything it needs (incl. surface, if its
+// context code assumes one) it puts there itself — paraLLEl-GS does exactly that and is proven live.
+// (The W3 surface-extension fix below is therefore v1-only; this wrapper stays verbatim.)
+static VkInstance VKAPI_PTR create_instance_wrapper(void *opaque, const VkInstanceCreateInfo *ci) {
+    (void)opaque;
+    VkInstance inst = VK_NULL_HANDLE;
+    VkResult r = vk.fn.CreateInstance(ci, NULL, &inst);
+    if (r != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "vkCreateInstance (core wrapper) failed: %d\n", r);
+        return VK_NULL_HANDLE;
+    }
+    return inst;
+}
+
+// Is device extension `name` advertised for vk.gpu? (vkEnumerateDeviceExtensionProperties is loaded in
+// load_instance_fns, and vk.gpu is set by pick_physical_device — both run before create_device.)
+static int zc_device_ext_supported(const char *name) {
+    if (!vk.fn.EnumerateDeviceExtensionProperties || vk.gpu == VK_NULL_HANDLE) return 0;
+    uint32_t n = 0;
+    if (vk.fn.EnumerateDeviceExtensionProperties(vk.gpu, NULL, &n, NULL) != VK_SUCCESS || n == 0) return 0;
+    if (n > 1024) n = 1024;
+    VkExtensionProperties *props = (VkExtensionProperties *)malloc(sizeof(VkExtensionProperties) * n);
+    if (!props) return 0;
+    int found = 0;
+    if (vk.fn.EnumerateDeviceExtensionProperties(vk.gpu, NULL, &n, props) == VK_SUCCESS) {
+        for (uint32_t i = 0; i < n; i++) {
+            if (strcmp(props[i].extensionName, name) == 0) { found = 1; break; }
+        }
+    }
+    free(props);
+    return found;
+}
+
+// The core builds the VkDeviceCreateInfo (it states the features/extensions paraLLEl-GS needs). For
+// zero-copy we must ALSO get VK_KHR_external_memory_win32 + VK_KHR_external_semaphore_win32 onto the
+// device — and the ONLY place to do it is here, because the core owns device creation (M2 spec §3
+// footgun). We append our names to a copied extension list (dedup) after verifying support; if either
+// is unsupported we flip zc_fallback and create the device UNMODIFIED (the room then runs M1 readback).
+// We never create a second device.
+static VkDevice VKAPI_PTR create_device_wrapper(VkPhysicalDevice gpu, void *opaque, const VkDeviceCreateInfo *ci) {
+    (void)opaque;
+    VkDevice dev = VK_NULL_HANDLE;
+
+    if (vk.zc_enabled && !vk.zc_fallback) {
+        static const char *want[] = {
+            VK_KHR_EXTERNAL_MEMORY_WIN32_EXTENSION_NAME,
+            VK_KHR_EXTERNAL_SEMAPHORE_WIN32_EXTENSION_NAME,
+        };
+        const uint32_t nwant = (uint32_t)(sizeof(want) / sizeof(want[0]));
+        int ok = 1;
+        for (uint32_t i = 0; i < nwant; i++) {
+            if (!zc_device_ext_supported(want[i])) {
+                VKLOG(RETRO_LOG_WARN, "zero-copy: device extension %s unsupported -> falling back to M1 readback\n", want[i]);
+                ok = 0;
+            }
+        }
+        if (!ok) {
+            vk.zc_fallback = 1;
+        } else {
+            uint32_t base = ci->enabledExtensionCount;
+            uint32_t cap  = base + nwant;
+            const char **merged = (const char **)malloc(sizeof(char *) * cap);
+            if (merged) {
+                for (uint32_t i = 0; i < base; i++) merged[i] = ci->ppEnabledExtensionNames[i];
+                uint32_t count = base;
+                for (uint32_t i = 0; i < nwant; i++) {
+                    int dup = 0;
+                    for (uint32_t j = 0; j < base; j++)
+                        if (strcmp(merged[j], want[i]) == 0) { dup = 1; break; }
+                    if (!dup) merged[count++] = want[i];
+                }
+                VkDeviceCreateInfo ci2 = *ci;
+                ci2.enabledExtensionCount   = count;
+                ci2.ppEnabledExtensionNames = merged;
+                VkResult r2 = vk.fn.CreateDevice(gpu, &ci2, NULL, &dev);
+                free(merged);
+                if (r2 == VK_SUCCESS) {
+                    VKLOG(RETRO_LOG_INFO, "zero-copy: injected external-memory/semaphore extensions into the core's device (%u->%u)\n", base, count);
+                    return dev;
+                }
+                VKLOG(RETRO_LOG_WARN, "zero-copy: device create WITH injected extensions failed (%d) -> retry unmodified + fallback\n", r2);
+                vk.zc_fallback = 1;
+                dev = VK_NULL_HANDLE;
+            } else {
+                vk.zc_fallback = 1;
+            }
+        }
+    }
+
+    VkResult r = vk.fn.CreateDevice(gpu, ci, NULL, &dev);
+    if (r != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "vkCreateDevice (core wrapper) failed: %d\n", r);
+        return VK_NULL_HANDLE;
+    }
+    return dev;
+}
+
+// Is instance extension `name` advertised by the loader? Global-level query (pLayerName=NULL), safe
+// before any instance exists — vkEnumerateInstanceExtensionProperties is one of the three functions
+// resolvable with a NULL instance.
+static int instance_ext_supported(const char *name) {
+    PFN_vkEnumerateInstanceExtensionProperties enum_fn =
+        (PFN_vkEnumerateInstanceExtensionProperties)vk.fn.GetInstanceProcAddr(NULL, "vkEnumerateInstanceExtensionProperties");
+    if (!enum_fn) return 0;
+    uint32_t n = 0;
+    if (enum_fn(NULL, &n, NULL) != VK_SUCCESS || n == 0) return 0;
+    if (n > 1024) n = 1024;
+    VkExtensionProperties *props = (VkExtensionProperties *)malloc(sizeof(VkExtensionProperties) * n);
+    if (!props) return 0;
+    int found = 0;
+    if (enum_fn(NULL, &n, props) == VK_SUCCESS) {
+        for (uint32_t i = 0; i < n; i++) {
+            if (strcmp(props[i].extensionName, name) == 0) { found = 1; break; }
+        }
+    }
+    free(props);
+    return found;
+}
+
+static const VkApplicationInfo *default_app_info(void) {
+    static const VkApplicationInfo app = {
+        VK_STRUCTURE_TYPE_APPLICATION_INFO, NULL,
+        "CloudRetro", VK_MAKE_VERSION(1, 0, 0),
+        "nanoarch",   VK_MAKE_VERSION(1, 0, 0),
+        VK_API_VERSION_1_2
+    };
+    return &app;
+}
+
+static int create_instance(void) {
+    const VkApplicationInfo *app = NULL;
+    if (vk.have_negotiation && vk.negotiation.get_application_info)
+        app = vk.negotiation.get_application_info();
+    if (!app)
+        app = default_app_info();
+
+    // v2: let the core create the instance so it can inject its required instance extensions.
+    // GATE BY interface_version, NOT callback presence. flycast reports interface_version=1 yet its
+    // create_instance/create_device2 struct fields READ non-null ("version 1, create_instance=yes
+    // create_device2=yes", live 2026-07-16 dc/Crazy Taxi) — but those are a GARBAGE MISREAD: flycast is a
+    // genuine v1 core, so it authored only the v1 struct, and we read create_instance/create_device2 from
+    // beyond it (uninitialized/adjacent memory). Calling them jumps to a garbage address (crash PC=
+    // 0x100000004, before device creation). So TRUST the version: a v1 core takes the v1 path below.
+    // (flycast's v1 create_device ignores our required_device_extensions, so it can't do zero-copy — the
+    // fail-soft in finishVideoVulkan keeps that from crashing; flycast/dc stays on GL, see RESULTS §W4-LIVE.)
+    if (vk.have_negotiation && vk.negotiation.interface_version >= 2 && vk.negotiation.create_instance) {
+        vk.instance = vk.negotiation.create_instance(vk.fn.GetInstanceProcAddr, app,
+                                                     create_instance_wrapper, &vk);
+        if (vk.instance == VK_NULL_HANDLE) {
+            VKLOG(RETRO_LOG_ERROR, "core create_instance returned VK_NULL_HANDLE\n");
+            return -1;
+        }
+        VKLOG(RETRO_LOG_INFO, "instance created by core (v2 create_instance)\n");
+        return 0;
+    }
+
+    // v1 / fallback: create the instance ourselves. Contract note (libretro_vulkan.h, create_device
+    // doc): the frontend only owes "supported for VK_KHR_surface" when it passes a real surface — we
+    // pass VK_NULL_HANDLE and never present, so NO extension is required of us. But real cores are
+    // developed against RetroArch, whose instance always carries the surface extensions, and PPSSPP's
+    // VulkanContext unconditionally loads the vkGetPhysicalDeviceSurface*KHR entry points at
+    // instance-bind time — on a bare headless instance those resolve to NULL and the core fastfails
+    // (0xC0000409; W3 live probe, "[G3D] Failed to load VK instance function:
+    // vkGetPhysicalDeviceSurfaceSupportKHR/...CapabilitiesKHR/...FormatsKHR/...PresentModesKHR").
+    // So enable VK_KHR_surface + VK_KHR_win32_surface when the loader advertises them (universal on
+    // desktop; skipped silently if absent — the strict-contract core still works without them).
+    // win32_surface depends on surface, so it is only added alongside it. We still create no surface.
+    const char *surf_ext[2];
+    uint32_t nsurf = 0;
+    if (instance_ext_supported(VK_KHR_SURFACE_EXTENSION_NAME)) {
+        surf_ext[nsurf++] = VK_KHR_SURFACE_EXTENSION_NAME;
+        if (instance_ext_supported(VK_KHR_WIN32_SURFACE_EXTENSION_NAME))
+            surf_ext[nsurf++] = VK_KHR_WIN32_SURFACE_EXTENSION_NAME;
+    }
+    VkInstanceCreateInfo ci = { VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO };
+    ci.pApplicationInfo = app;
+    ci.enabledExtensionCount = nsurf;
+    ci.ppEnabledExtensionNames = nsurf ? surf_ext : NULL;
+    VkResult r = vk.fn.CreateInstance(&ci, NULL, &vk.instance);
+    if (r != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "self vkCreateInstance failed: %d\n", r);
+        return -1;
+    }
+    VKLOG(RETRO_LOG_INFO, "instance created by frontend (v1 path, %u surface extension(s) enabled)\n", nsurf);
+    return 0;
+}
+
+static int pick_physical_device(void) {
+    uint32_t count = 0;
+    if (vk.fn.EnumeratePhysicalDevices(vk.instance, &count, NULL) != VK_SUCCESS || count == 0) {
+        VKLOG(RETRO_LOG_ERROR, "no Vulkan physical devices\n");
+        return -1;
+    }
+    if (count > 16) count = 16;
+    VkPhysicalDevice devs[16];
+    if (vk.fn.EnumeratePhysicalDevices(vk.instance, &count, devs) != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "vkEnumeratePhysicalDevices (fill) failed\n");
+        return -1;
+    }
+    vk.gpu = devs[0];
+    for (uint32_t i = 0; i < count; i++) {
+        VkPhysicalDeviceProperties p;
+        vk.fn.GetPhysicalDeviceProperties(devs[i], &p);
+        if (p.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU) {
+            vk.gpu = devs[i];
+            break;
+        }
+    }
+    VkPhysicalDeviceProperties p;
+    vk.fn.GetPhysicalDeviceProperties(vk.gpu, &p);
+    VKLOG(RETRO_LOG_INFO, "physical device: %s (api %u.%u.%u)\n", p.deviceName,
+          VK_VERSION_MAJOR(p.apiVersion), VK_VERSION_MINOR(p.apiVersion), VK_VERSION_PATCH(p.apiVersion));
+    return 0;
+}
+
+// Arm the synthetic-surface path (hack vk_synthetic_surface). Called from Go BEFORE nano_vk_init, like
+// nano_vk_zc_set_enabled — a plain flag write, so thread-independent. Always called with an explicit
+// 0/1 so a previous room's value can never persist.
+void nano_vk_set_synthetic_surface(int on) { vk.synth_surface_wanted = on ? 1 : 0; }
+
+// Hidden window class for the synthetic surface. Registered once (idempotent); WS_POPUP, never shown.
+#define NANO_VK_SURF_CLASS L"nanoVkHiddenSurface"
+
+// create_synthetic_surface builds a hidden Win32 window + VkSurfaceKHR on our instance, for cores that
+// need a non-null surface (see the struct comment). No-op unless the hack armed it. Runs AFTER
+// create_instance (needs vk.instance with VK_KHR_surface + VK_KHR_win32_surface, which the v1 headless
+// instance already enables — commit 4451d47) and BEFORE create_device (which passes the surface in).
+// A WS_POPUP window is used, NOT message-only: vkCreateWin32SurfaceKHR needs a presentable HWND.
+static int create_synthetic_surface(void) {
+    if (!vk.synth_surface_wanted) return 0;
+
+    HINSTANCE hinst = GetModuleHandleW(NULL);
+    WNDCLASSEXW wc;
+    memset(&wc, 0, sizeof(wc));
+    wc.cbSize        = sizeof(wc);
+    wc.lpfnWndProc   = DefWindowProcW;
+    wc.hInstance     = hinst;
+    wc.lpszClassName = NANO_VK_SURF_CLASS;
+    RegisterClassExW(&wc); // ignore ERROR_CLASS_ALREADY_EXISTS (a prior room on this process registered it)
+
+    HWND hwnd = CreateWindowExW(0, NANO_VK_SURF_CLASS, L"nanoarch-vk", WS_POPUP,
+                                0, 0, 16, 16, NULL, NULL, hinst, NULL);
+    if (!hwnd) {
+        VKLOG(RETRO_LOG_ERROR, "synthetic surface: CreateWindowEx failed (%lu)\n", (unsigned long)GetLastError());
+        return -1;
+    }
+    // Never ShowWindow — it stays hidden. It exists solely to back a presentable VkSurfaceKHR.
+
+    PFN_vkCreateWin32SurfaceKHR createWin32 =
+        (PFN_vkCreateWin32SurfaceKHR)vk.fn.GetInstanceProcAddr(vk.instance, "vkCreateWin32SurfaceKHR");
+    if (!createWin32) {
+        VKLOG(RETRO_LOG_ERROR, "synthetic surface: vkCreateWin32SurfaceKHR unavailable "
+              "(instance lacks VK_KHR_win32_surface? synthetic surface needs the v1 headless instance)\n");
+        DestroyWindow(hwnd);
+        return -1;
+    }
+    VkWin32SurfaceCreateInfoKHR sci;
+    memset(&sci, 0, sizeof(sci));
+    sci.sType     = VK_STRUCTURE_TYPE_WIN32_SURFACE_CREATE_INFO_KHR;
+    sci.hinstance = hinst;
+    sci.hwnd      = hwnd;
+    VkSurfaceKHR surf = VK_NULL_HANDLE;
+    VkResult r = createWin32(vk.instance, &sci, NULL, &surf);
+    if (r != VK_SUCCESS || surf == VK_NULL_HANDLE) {
+        VKLOG(RETRO_LOG_ERROR, "synthetic surface: vkCreateWin32SurfaceKHR failed (%d)\n", (int)r);
+        DestroyWindow(hwnd);
+        return -1;
+    }
+    vk.synth_hwnd    = hwnd;
+    vk.synth_surface = surf;
+    VKLOG(RETRO_LOG_INFO, "synthetic headless surface created (hidden WS_POPUP window) — core will get a "
+          "real VkSurfaceKHR instead of VK_NULL_HANDLE\n");
+    return 0;
+}
+
+// Fallback: find a graphics+compute queue family (only used if the core has no create_device*).
+static int find_graphics_compute_family(uint32_t *out) {
+    uint32_t n = 0;
+    vk.fn.GetPhysicalDeviceQueueFamilyProperties(vk.gpu, &n, NULL);
+    if (n == 0) return -1;
+    if (n > 32) n = 32;
+    VkQueueFamilyProperties fams[32];
+    vk.fn.GetPhysicalDeviceQueueFamilyProperties(vk.gpu, &n, fams);
+    for (uint32_t i = 0; i < n; i++) {
+        if ((fams[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) && (fams[i].queueFlags & VK_QUEUE_COMPUTE_BIT)) {
+            *out = i;
+            return 0;
+        }
+    }
+    return -1;
+}
+
+static int create_device(void) {
+    struct retro_vulkan_context ctx;
+    memset(&ctx, 0, sizeof(ctx));
+
+    // v2: create_device2 (paraLLEl-GS). We hand it the explicit discrete GPU and the same
+    // get_instance_proc_addr we used for create_instance (the core sanity-checks it). GATE BY
+    // interface_version — a v1 core's create_device2 field is a garbage misread (see the create_instance
+    // note above; calling it crashes). paraLLEl-GS is genuine v2 and takes this path.
+    if (vk.have_negotiation && vk.negotiation.interface_version >= 2 && vk.negotiation.create_device2) {
+        if (!vk.negotiation.create_device2(&ctx, vk.instance, vk.gpu, vk.synth_surface,
+                                           vk.fn.GetInstanceProcAddr, create_device_wrapper, &vk)) {
+            VKLOG(RETRO_LOG_ERROR, "core create_device2 failed\n");
+            return -1;
+        }
+        vk.gpu          = ctx.gpu ? ctx.gpu : vk.gpu;
+        vk.device       = ctx.device;
+        vk.queue        = ctx.queue;
+        vk.queue_family = ctx.queue_family_index;
+        VKLOG(RETRO_LOG_INFO, "device created by core (v2 create_device2), queue family %u\n", vk.queue_family);
+        return 0;
+    }
+
+    // v1: create_device (mupen64plus-next / paraLLEl-RDP). Unlike v2 there is NO create_device_wrapper —
+    // the CORE calls vkCreateDevice itself. The v1 mechanism for the frontend to get extensions ONTO
+    // that device is the required_device_extensions argument: the core must enable everything we ask for
+    // (libretro_vulkan.h create_device contract). So for zero-copy we pass our external-memory/semaphore
+    // names HERE — the v1 equivalent of the create_device_wrapper injection. If a name is unsupported we
+    // do not ask (readback fallback); if create_device fails WITH our names we retry WITHOUT them.
+    if (vk.have_negotiation && vk.negotiation.create_device) {
+        // mupen64plus-next / paraLLEl-RDP (v1). CRITICAL: the core's create_device memcpy's the
+        // required_features argument WITHOUT a null check, so passing NULL access-violates INSIDE the core
+        // (gdb 2026-07-16: `movdqu (%rax),%xmm6` with rax=0 -> a 16-byte struct copy from NULL, 3 frames
+        // into mupen64plus_next_libretro.dll). Always pass a ZEROED VkPhysicalDeviceFeatures. The earlier
+        // "extensions crash" was in fact this NULL required_features — so WITH features fixed we can inject
+        // the external-memory/semaphore extensions via required_device_extensions (v1 contract) to get M2
+        // zero-copy. Try WITH extensions; if the core returns false, retry WITHOUT (M1 readback).
+        VkPhysicalDeviceFeatures no_features;
+        memset(&no_features, 0, sizeof(no_features));
+        const char *zc_ext[2] = {
+            VK_KHR_EXTERNAL_MEMORY_WIN32_EXTENSION_NAME,
+            VK_KHR_EXTERNAL_SEMAPHORE_WIN32_EXTENSION_NAME,
+        };
+        const char **req = NULL;
+        unsigned nreq = 0;
+        if (vk.zc_enabled && !vk.zc_fallback) {
+            if (zc_device_ext_supported(zc_ext[0]) && zc_device_ext_supported(zc_ext[1])) {
+                req = zc_ext; nreq = 2;
+            } else {
+                VKLOG(RETRO_LOG_WARN, "zero-copy: external-memory/semaphore unsupported -> M1 readback\n");
+                vk.zc_fallback = 1;
+            }
+        }
+        if (vk.negotiation.create_device(&ctx, vk.instance, vk.gpu, vk.synth_surface,
+                                         vk.fn.GetInstanceProcAddr, req, nreq, NULL, 0, &no_features)) {
+            vk.gpu          = ctx.gpu ? ctx.gpu : vk.gpu;
+            vk.device       = ctx.device;
+            vk.queue        = ctx.queue;
+            vk.queue_family = ctx.queue_family_index;
+            VKLOG(RETRO_LOG_INFO, "device created by core (v1 create_device), queue family %u%s\n",
+                  vk.queue_family, nreq ? " (zero-copy extensions injected)" : "");
+            return 0;
+        }
+        if (nreq) {
+            // Core returned false WITH our extensions — retry unmodified and run M1 readback.
+            VKLOG(RETRO_LOG_WARN, "zero-copy: v1 create_device false WITH extensions -> retry unmodified (readback)\n");
+            vk.zc_fallback = 1;
+            memset(&ctx, 0, sizeof(ctx));
+            if (vk.negotiation.create_device(&ctx, vk.instance, vk.gpu, vk.synth_surface,
+                                             vk.fn.GetInstanceProcAddr, NULL, 0, NULL, 0, &no_features)) {
+                vk.gpu          = ctx.gpu ? ctx.gpu : vk.gpu;
+                vk.device       = ctx.device;
+                vk.queue        = ctx.queue;
+                vk.queue_family = ctx.queue_family_index;
+                VKLOG(RETRO_LOG_INFO, "device created by core (v1 create_device, unmodified), queue family %u\n", vk.queue_family);
+                return 0;
+            }
+        }
+        VKLOG(RETRO_LOG_WARN, "core create_device returned false; falling back to frontend device\n");
+    }
+
+    // Fallback: create a device ourselves with one graphics+compute queue. This bare device carries
+    // neither the zero-copy extensions nor the features a Vulkan renderer typically needs, so if we got
+    // here with zero-copy armed, force the readback path (never export from a device that lacks the
+    // external-memory extension).
+    if (vk.zc_enabled && !vk.zc_fallback) {
+        VKLOG(RETRO_LOG_WARN, "zero-copy: core provided no create_device; self-created device -> M1 readback\n");
+        vk.zc_fallback = 1;
+    }
+    uint32_t fam = 0;
+    if (find_graphics_compute_family(&fam) != 0) {
+        VKLOG(RETRO_LOG_ERROR, "no graphics+compute queue family\n");
+        return -1;
+    }
+    float prio = 1.0f;
+    VkDeviceQueueCreateInfo q = { VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO };
+    q.queueFamilyIndex = fam;
+    q.queueCount = 1;
+    q.pQueuePriorities = &prio;
+    VkDeviceCreateInfo ci = { VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO };
+    ci.queueCreateInfoCount = 1;
+    ci.pQueueCreateInfos = &q;
+    VkResult r = vk.fn.CreateDevice(vk.gpu, &ci, NULL, &vk.device);
+    if (r != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "self vkCreateDevice failed: %d\n", r);
+        return -1;
+    }
+    vk.queue_family = fam;
+    if (load_device_fns() != 0) return -1;
+    vk.fn.GetDeviceQueue(vk.device, fam, 0, &vk.queue);
+    VKLOG(RETRO_LOG_INFO, "device created by frontend, queue family %u\n", fam);
+    return 0;
+}
+
+// ===================================================================================================
+// Interface callbacks (called by the core)
+// ===================================================================================================
+
+static void VKAPI_PTR cb_set_image(void *handle, const struct retro_vulkan_image *image,
+                                   uint32_t num_semaphores, const VkSemaphore *semaphores,
+                                   uint32_t src_queue_family) {
+    (void)handle;
+    vk_dbg.set_image++;
+    if (!image) { vk.have_image = 0; return; }
+    vk.src_image  = image->create_info.image;
+    vk.src_layout = image->image_layout;
+    vk.src_format = image->create_info.format;
+    // Source extent (review F1). The interface CANNOT hand us the VkImage's extent:
+    // retro_vulkan_image.create_info is a VkImageViewCreateInfo (sType/image/viewType/format/
+    // components/subresourceRange — NO extent; the spec's "contains ... extent" was mistaken), and
+    // Vulkan has no vkGetImageExtent. The libretro contract — and RetroArch's normative behavior
+    // (gfx/drivers/vulkan.c hw path sizes the frame from video_cb's width/height, never the image)
+    // — is that the video_cb dimensions ARE the frame size. paraLLEl-GS upholds it under internal
+    // upscaling too: with pgs_high_res_scanout its av_info doubles the base geometry
+    // (libretro/main.cpp:1533) and every video_cb receives vsync.image->get_width()/get_height()
+    // (GSRendererPGS.cpp:532/592) — the image is never larger than what video_cb reports (verified
+    // live: high-res scanout reallocates staging at 1280x896 and the full frame renders, no crop).
+    // So src_w/src_h are set from video_cb in nano_vk_readback; they exist as separate fields so an
+    // M3 core with a real extent side-channel (none exists in interface v5) could feed them, and the
+    // blit below already downscales (LINEAR) whenever they differ from the output size.
+    vk.src_w = 0;
+    vk.src_h = 0;
+    vk.have_image = 1;
+
+    // M1: same queue family in practice (paraLLEl-GS passes queue_index / IGNORED). Log if not, so a
+    // future async-compute core that needs an ownership acquire is visible instead of silently wrong.
+    if (src_queue_family != vk.queue_family &&
+        src_queue_family != VK_QUEUE_FAMILY_IGNORED) {
+        VKLOG(RETRO_LOG_WARN, "set_image src_queue_family %u != frontend %u (ownership transfer not handled in M1)\n",
+              src_queue_family, vk.queue_family);
+    }
+
+    vk.num_wait_sems = 0;
+    if (num_semaphores > 0 && semaphores) {
+        uint32_t n = num_semaphores > 8 ? 8 : num_semaphores;
+        for (uint32_t i = 0; i < n; i++) vk.wait_sems[i] = semaphores[i];
+        vk.num_wait_sems = n;
+    }
+}
+
+static uint32_t VKAPI_PTR cb_get_sync_index(void *handle)      { (void)handle; return vk.sync_index; }
+static uint32_t VKAPI_PTR cb_get_sync_index_mask(void *handle) { (void)handle; return (1u << NANO_VK_SYNC) - 1u; }
+
+static void VKAPI_PTR cb_wait_sync_index(void *handle) {
+    (void)handle;
+    // Block until the prior GPU work for the current sync index is done (fence wait).
+    //
+    // KNOWN LIMITATION (review N1, revisit for M3 cores): if a core called this concurrently from
+    // another thread while nano_vk_readback is between its ResetFences and QueueSubmit, this would
+    // wait on an unsubmitted fence (vkWaitForFences on a reset, never-pending fence times out /
+    // returns immediately depending on driver — either way not the intended semantics). M1-safe:
+    // paraLLEl-GS never calls wait_sync_index at all, and the readback runs single-threaded on the
+    // core's cothread. A multi-threaded M3 core needs a small state machine (submitted flag per
+    // index guarded by a mutex) here.
+    if (vk.fence[vk.sync_index])
+        vk.fn.WaitForFences(vk.device, 1, &vk.fence[vk.sync_index], VK_TRUE, UINT64_MAX);
+}
+
+static void VKAPI_PTR cb_lock_queue(void *handle)   { (void)handle; pthread_mutex_lock(&vk.queue_mutex); }
+static void VKAPI_PTR cb_unlock_queue(void *handle) { (void)handle; pthread_mutex_unlock(&vk.queue_mutex); }
+
+static void VKAPI_PTR cb_set_command_buffers(void *handle, uint32_t num, const VkCommandBuffer *cmd) {
+    (void)handle; (void)num; (void)cmd;
+    // paraLLEl-GS does not use this alternative frame-handover mode. Log once so a future core that
+    // needs it is not silently dropped.
+    if (!vk.command_buffers_warned) {
+        VKLOG(RETRO_LOG_WARN, "set_command_buffers used by core but not implemented in M1 (frame handover is set_image only)\n");
+        vk.command_buffers_warned = 1;
+    }
+}
+
+static void VKAPI_PTR cb_set_signal_semaphore(void *handle, VkSemaphore sem) {
+    (void)handle;
+    vk.signal_sem = sem; // signalled on our next copy submit if set (paraLLEl-GS leaves it null).
+}
+
+static void build_interface(void) {
+    memset(&vk.iface, 0, sizeof(vk.iface));
+    vk.iface.interface_type    = RETRO_HW_RENDER_INTERFACE_VULKAN;
+    vk.iface.interface_version = RETRO_HW_RENDER_INTERFACE_VULKAN_VERSION; // 5 — the core refuses anything else
+    vk.iface.handle            = &vk;
+    vk.iface.instance          = vk.instance;
+    vk.iface.gpu               = vk.gpu;
+    vk.iface.device            = vk.device;
+    vk.iface.get_device_proc_addr   = vk.fn.GetDeviceProcAddr;
+    vk.iface.get_instance_proc_addr = vk.fn.GetInstanceProcAddr;
+    vk.iface.queue             = vk.queue;
+    vk.iface.queue_index       = vk.queue_family;
+    vk.iface.set_image             = cb_set_image;
+    vk.iface.get_sync_index        = cb_get_sync_index;
+    vk.iface.get_sync_index_mask   = cb_get_sync_index_mask;
+    vk.iface.set_command_buffers   = cb_set_command_buffers;
+    vk.iface.wait_sync_index       = cb_wait_sync_index;
+    vk.iface.lock_queue            = cb_lock_queue;
+    vk.iface.unlock_queue          = cb_unlock_queue;
+    vk.iface.set_signal_semaphore  = cb_set_signal_semaphore;
+    vk.iface_ready = 1;
+}
+
+// ===================================================================================================
+// Public init
+// ===================================================================================================
+
+int nano_vk_init(void) {
+    if (vk.iface_ready) return 0; // idempotent
+
+    vk.dll = LoadLibraryA("vulkan-1.dll");
+    if (!vk.dll) { VKLOG(RETRO_LOG_ERROR, "LoadLibrary vulkan-1.dll failed\n"); return -1; }
+    vk.fn.GetInstanceProcAddr = (PFN_vkGetInstanceProcAddr)(void*)GetProcAddress(vk.dll, "vkGetInstanceProcAddr");
+    if (!vk.fn.GetInstanceProcAddr) { VKLOG(RETRO_LOG_ERROR, "no vkGetInstanceProcAddr\n"); return -1; }
+
+    // Global entry point (instance == NULL): vkCreateInstance.
+    vk.fn.CreateInstance = (PFN_vkCreateInstance)vk.fn.GetInstanceProcAddr(NULL, "vkCreateInstance");
+    if (!vk.fn.CreateInstance) { VKLOG(RETRO_LOG_ERROR, "no vkCreateInstance\n"); return -1; }
+
+    if (create_instance() != 0) return -1;
+    if (load_instance_fns() != 0) return -1;
+    if (pick_physical_device() != 0) return -1;
+    // Synthetic headless surface (opt-in, hack vk_synthetic_surface): MUST come between instance/gpu and
+    // create_device — the surface is handed to the core inside create_device. No-op for ps2/n64.
+    if (create_synthetic_surface() != 0) return -1;
+    if (create_device() != 0) return -1;
+    // The v2/v1 core paths return the device but not our device-level fns; load them (the self path
+    // already loaded them, but re-loading is harmless/idempotent).
+    if (load_device_fns() != 0) return -1;
+
+    vk.fn.GetPhysicalDeviceMemoryProperties(vk.gpu, &vk.mem_props);
+
+    if (pthread_mutex_init(&vk.queue_mutex, NULL) != 0) {
+        VKLOG(RETRO_LOG_ERROR, "queue mutex init failed\n");
+        return -1;
+    }
+
+    // Command pool + per-sync-index command buffers and fences (fences created SIGNALED so the first
+    // reuse-wait returns immediately).
+    VkCommandPoolCreateInfo pci = { VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO };
+    pci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    pci.queueFamilyIndex = vk.queue_family;
+    if (vk.fn.CreateCommandPool(vk.device, &pci, NULL, &vk.cmd_pool) != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "vkCreateCommandPool failed\n");
+        return -1;
+    }
+    VkCommandBufferAllocateInfo ai = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO };
+    ai.commandPool = vk.cmd_pool;
+    ai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    ai.commandBufferCount = NANO_VK_SYNC;
+    if (vk.fn.AllocateCommandBuffers(vk.device, &ai, vk.cmd) != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "vkAllocateCommandBuffers failed\n");
+        return -1;
+    }
+    for (int i = 0; i < NANO_VK_SYNC; i++) {
+        VkFenceCreateInfo fi = { VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+        fi.flags = VK_FENCE_CREATE_SIGNALED_BIT;
+        if (vk.fn.CreateFence(vk.device, &fi, NULL, &vk.fence[i]) != VK_SUCCESS) {
+            VKLOG(RETRO_LOG_ERROR, "vkCreateFence failed\n");
+            return -1;
+        }
+    }
+
+    build_interface();
+    VKLOG(RETRO_LOG_INFO, "hw render interface ready (version %u)\n", (unsigned)vk.iface.interface_version);
+    return 0;
+}
+
+// Returns the built retro_hw_render_interface_vulkan* (for GET_HW_RENDER_INTERFACE), or NULL.
+const void *nano_vk_hw_render_interface(void) {
+    return vk.iface_ready ? (const void *)&vk.iface : NULL;
+}
+
+int nano_vk_have_image(void) { return vk.have_image; }
+
+// ===================================================================================================
+// Staging (re)allocation
+// ===================================================================================================
+
+static uint32_t find_memory_type(uint32_t type_bits, VkMemoryPropertyFlags want) {
+    for (uint32_t i = 0; i < vk.mem_props.memoryTypeCount; i++) {
+        if ((type_bits & (1u << i)) &&
+            (vk.mem_props.memoryTypes[i].propertyFlags & want) == want)
+            return i;
+    }
+    return UINT32_MAX;
+}
+
+static void destroy_staging(void) {
+    if (vk.stage_mapped)     { vk.fn.UnmapMemory(vk.device, vk.stage_buf_mem); vk.stage_mapped = NULL; }
+    if (vk.stage_buf)        { vk.fn.DestroyBuffer(vk.device, vk.stage_buf, NULL); vk.stage_buf = VK_NULL_HANDLE; }
+    if (vk.stage_buf_mem)    { vk.fn.FreeMemory(vk.device, vk.stage_buf_mem, NULL); vk.stage_buf_mem = VK_NULL_HANDLE; }
+    if (vk.stage_image)      { vk.fn.DestroyImage(vk.device, vk.stage_image, NULL); vk.stage_image = VK_NULL_HANDLE; }
+    if (vk.stage_image_mem)  { vk.fn.FreeMemory(vk.device, vk.stage_image_mem, NULL); vk.stage_image_mem = VK_NULL_HANDLE; }
+    vk.stage_w = vk.stage_h = 0;
+}
+
+// Allocate (or reallocate on extent change) the blit-target image and mapped host readback buffer.
+static int ensure_staging(uint32_t w, uint32_t h) {
+    if (vk.stage_image && vk.stage_w == w && vk.stage_h == h)
+        return 0;
+
+    // In-flight copies reference the old staging; idle before tearing it down.
+    vk.fn.DeviceWaitIdle(vk.device);
+    destroy_staging();
+
+    // Blit-target image: NANO_VK_STAGE_FORMAT, TILING_OPTIMAL, TRANSFER_DST (blit) + TRANSFER_SRC (copy).
+    VkImageCreateInfo ici = { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+    ici.imageType = VK_IMAGE_TYPE_2D;
+    ici.format = NANO_VK_STAGE_FORMAT;
+    ici.extent.width = w; ici.extent.height = h; ici.extent.depth = 1;
+    ici.mipLevels = 1; ici.arrayLayers = 1;
+    ici.samples = VK_SAMPLE_COUNT_1_BIT;
+    ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ici.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    ici.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    ici.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (vk.fn.CreateImage(vk.device, &ici, NULL, &vk.stage_image) != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "stage image create failed (%ux%u)\n", w, h);
+        return -1;
+    }
+    VkMemoryRequirements ir;
+    vk.fn.GetImageMemoryRequirements(vk.device, vk.stage_image, &ir);
+    uint32_t itype = find_memory_type(ir.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    if (itype == UINT32_MAX) itype = find_memory_type(ir.memoryTypeBits, 0);
+    VkMemoryAllocateInfo imai = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    imai.allocationSize = ir.size; imai.memoryTypeIndex = itype;
+    if (vk.fn.AllocateMemory(vk.device, &imai, NULL, &vk.stage_image_mem) != VK_SUCCESS ||
+        vk.fn.BindImageMemory(vk.device, vk.stage_image, vk.stage_image_mem, 0) != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "stage image memory failed\n");
+        return -1;
+    }
+
+    // Host-visible readback buffer, persistently mapped.
+    VkDeviceSize bytes = (VkDeviceSize)w * h * 4;
+    VkBufferCreateInfo bci = { VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+    bci.size = bytes;
+    bci.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+    bci.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    if (vk.fn.CreateBuffer(vk.device, &bci, NULL, &vk.stage_buf) != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "stage buffer create failed\n");
+        return -1;
+    }
+    VkMemoryRequirements br;
+    vk.fn.GetBufferMemoryRequirements(vk.device, vk.stage_buf, &br);
+    uint32_t btype = find_memory_type(br.memoryTypeBits,
+        VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+    if (btype == UINT32_MAX) {
+        VKLOG(RETRO_LOG_ERROR, "no host-visible+coherent memory type\n");
+        return -1;
+    }
+    VkMemoryAllocateInfo bmai = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    bmai.allocationSize = br.size; bmai.memoryTypeIndex = btype;
+    if (vk.fn.AllocateMemory(vk.device, &bmai, NULL, &vk.stage_buf_mem) != VK_SUCCESS ||
+        vk.fn.BindBufferMemory(vk.device, vk.stage_buf, vk.stage_buf_mem, 0) != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "stage buffer memory failed\n");
+        return -1;
+    }
+    if (vk.fn.MapMemory(vk.device, vk.stage_buf_mem, 0, bytes, 0, &vk.stage_mapped) != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "stage buffer map failed\n");
+        return -1;
+    }
+    vk.stage_w = w; vk.stage_h = h;
+    VKLOG(RETRO_LOG_INFO, "staging (re)allocated for %ux%u\n", w, h);
+    return 0;
+}
+
+// ===================================================================================================
+// Per-frame readback
+// ===================================================================================================
+
+static void img_barrier(VkCommandBuffer cb, VkImage image,
+                        VkImageLayout old_layout, VkImageLayout new_layout,
+                        VkAccessFlags src_access, VkAccessFlags dst_access,
+                        VkPipelineStageFlags src_stage, VkPipelineStageFlags dst_stage) {
+    VkImageMemoryBarrier b = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+    b.srcAccessMask = src_access;
+    b.dstAccessMask = dst_access;
+    b.oldLayout = old_layout;
+    b.newLayout = new_layout;
+    b.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.image = image;
+    b.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    b.subresourceRange.levelCount = 1;
+    b.subresourceRange.layerCount = 1;
+    vk.fn.CmdPipelineBarrier(cb, src_stage, dst_stage, 0, 0, NULL, 0, NULL, 1, &b);
+}
+
+// Copy the latest set_image frame (w x h) into the mapped host buffer and return the pointer. *pitch
+// is the row stride in bytes (== w*4). Returns NULL if there is no frame or a step fails.
+const void *nano_vk_readback(unsigned width, unsigned height, unsigned *pitch) {
+    if (!vk.iface_ready || !vk.have_image || width == 0 || height == 0) return NULL;
+    uint32_t w = width, h = height;
+    // Source region = the full core image. Interface v5 has no extent side-channel (see cb_set_image),
+    // so unless something upstream filled src_w/src_h, the video_cb dimensions are the image size —
+    // the libretro contract, upheld by paraLLEl-GS even with pgs_high_res_scanout (which reports the
+    // UPSCALED size through video_cb/geometry, so the staging + encode ride at the high-res size).
+    uint32_t src_w = vk.src_w ? vk.src_w : w;
+    uint32_t src_h = vk.src_h ? vk.src_h : h;
+    if (ensure_staging(w, h) != 0) return NULL;
+
+    uint32_t idx = vk.sync_index;
+    VkCommandBuffer cb = vk.cmd[idx];
+    VkFence fence = vk.fence[idx];
+
+    // The fence for this slot is signaled from its previous use (or created signaled); wait so the
+    // command buffer is free to re-record, then reset both.
+    vk.fn.WaitForFences(vk.device, 1, &fence, VK_TRUE, UINT64_MAX);
+    vk.fn.ResetFences(vk.device, 1, &fence);
+    vk.fn.ResetCommandBuffer(cb, 0);
+
+    VkCommandBufferBeginInfo bi = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+    bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vk.fn.BeginCommandBuffer(cb, &bi);
+
+    // Core image: its current layout -> TRANSFER_SRC (read for blit). No semaphores from paraLLEl-GS,
+    // so a pipeline barrier provides the src synchronization (per the interface header).
+    img_barrier(cb, vk.src_image, vk.src_layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+                VK_ACCESS_TRANSFER_READ_BIT,
+                VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+
+    // Stage image: UNDEFINED -> TRANSFER_DST (we overwrite it entirely).
+    img_barrier(cb, vk.stage_image, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                0, VK_ACCESS_TRANSFER_WRITE_BIT,
+                VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+
+    // Blit core(RGBA) -> stage(BGRA): the blit does the R<->B channel move (format conversion),
+    // giving us XRGB8888 byte order without a CPU swap. Source is the FULL image extent (review F1);
+    // when it differs from the output size vkCmdBlitImage downscales it — LINEAR then, so a scaled
+    // frame is averaged, not point-sampled; NEAREST for the 1:1 case (bit-preserving, the verified
+    // baseline output).
+    VkImageBlit region;
+    memset(&region, 0, sizeof(region));
+    region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    region.srcSubresource.layerCount = 1;
+    region.dstSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    region.dstSubresource.layerCount = 1;
+    region.srcOffsets[1].x = (int32_t)src_w; region.srcOffsets[1].y = (int32_t)src_h; region.srcOffsets[1].z = 1;
+    region.dstOffsets[1].x = (int32_t)w;     region.dstOffsets[1].y = (int32_t)h;     region.dstOffsets[1].z = 1;
+    VkFilter filter = (src_w != w || src_h != h) ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+    vk.fn.CmdBlitImage(cb,
+        vk.src_image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+        vk.stage_image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+        1, &region, filter);
+
+    // Stage image: TRANSFER_DST -> TRANSFER_SRC, then copy into the host buffer.
+    img_barrier(cb, vk.stage_image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+                VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+
+    VkBufferImageCopy copy;
+    memset(&copy, 0, sizeof(copy));
+    copy.bufferRowLength = 0;   // tightly packed == w*4
+    copy.bufferImageHeight = 0;
+    copy.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    copy.imageSubresource.layerCount = 1;
+    copy.imageExtent.width = w; copy.imageExtent.height = h; copy.imageExtent.depth = 1;
+    vk.fn.CmdCopyImageToBuffer(cb, vk.stage_image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, vk.stage_buf, 1, &copy);
+
+    // Restore the core image to the layout the core handed it in, so the core can reuse it.
+    img_barrier(cb, vk.src_image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, vk.src_layout,
+                VK_ACCESS_TRANSFER_READ_BIT,
+                VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT);
+
+    vk.fn.EndCommandBuffer(cb);
+
+    // Submit under the shared queue lock (the core submits on other threads under the same lock).
+    VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_TRANSFER_BIT;
+    VkSubmitInfo si = { VK_STRUCTURE_TYPE_SUBMIT_INFO };
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &cb;
+    if (vk.num_wait_sems > 0) {
+        // static is safe here ONLY because the readback is single-threaded: it runs exclusively on
+        // the core's cothread (one call at a time), so this array is never written concurrently
+        // (review N2). If readback ever moves off the cothread, make it stack-local.
+        static VkPipelineStageFlags stages[8];
+        for (uint32_t i = 0; i < vk.num_wait_sems; i++) stages[i] = wait_stage;
+        si.waitSemaphoreCount = vk.num_wait_sems;
+        si.pWaitSemaphores = vk.wait_sems;
+        si.pWaitDstStageMask = stages;
+    }
+    if (vk.signal_sem) {
+        si.signalSemaphoreCount = 1;
+        si.pSignalSemaphores = &vk.signal_sem;
+    }
+
+    cb_lock_queue(&vk);
+    VkResult r = vk.fn.QueueSubmit(vk.queue, 1, &si, fence);
+    cb_unlock_queue(&vk);
+
+    // Consume the one-shot set_image state.
+    vk.num_wait_sems = 0;
+    vk.signal_sem = VK_NULL_HANDLE;
+
+    if (r != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "vkQueueSubmit (readback) failed: %d\n", r);
+        return NULL;
+    }
+
+    // M1 is allowed the synchronous fence wait (~1-2 ms at PS2 sizes). Wait OUTSIDE the queue lock.
+    vk.fn.WaitForFences(vk.device, 1, &fence, VK_TRUE, UINT64_MAX);
+
+    vk.sync_index = (idx + 1) % NANO_VK_SYNC;
+    if (pitch) *pitch = w * 4;
+    return vk.stage_mapped;
+}
+
+// ===================================================================================================
+// M2: Vulkan -> GL external-memory zero-copy
+// ===================================================================================================
+//
+// Replaces the readback for zero-copy rooms: the core's frame is blitted into a pool of EXPORTABLE
+// VkImages (dedicated allocations, OPAQUE_WIN32) that are imported ONCE into GL textures; those texture
+// ids feed the existing zc_push GLMemory path. The frame never visits system memory. Cross-API
+// ordering is a per-slot external "ready" semaphore: Vulkan signals it after the blit, GL waits it on
+// our import context before the encoder samples (M2 spec §1.4 layer 1). A conservative host fence-wait
+// (layer 2) is available via CLOUD_GAME_VK_ZEROCOPY=fence for A/B and as the correctness reference.
+//
+// Threading: setup / frame / teardown run on the core's LibCo cothread, which is where the RGFW/WGL
+// import context is current (thread.Main is inline on Windows). Release runs on GStreamer's thread.
+
+// Resolve a GL entry point via opengl32 then wglGetProcAddress (the RGFW pattern, incl. the sentinel
+// guard). Requires the WGL context current on the calling thread.
+static void *gl_resolve(const char *name) {
+    static HMODULE glmod;
+    if (!glmod) glmod = LoadLibraryA("opengl32.dll");
+    if (glmod) { void *p = (void *)(void(*)(void))GetProcAddress(glmod, name); if (p) return p; }
+    void *p = (void *)wglGetProcAddress(name);
+    if (p == (void *)1 || p == (void *)2 || p == (void *)3 || p == (void *)-1) p = NULL;
+    return p;
+}
+
+static int zc_load_gl(void) {
+    int missing = 0;
+#define GLFN(field, type, name) \
+    vk.gl.field = (type)gl_resolve(name); \
+    if (!vk.gl.field) { VKLOG(RETRO_LOG_ERROR, "zero-copy: missing GL fn " name "\n"); missing = 1; }
+    GLFN(CreateMemoryObjectsEXT,        PFNGLCREATEMEMORYOBJECTSEXT,        "glCreateMemoryObjectsEXT")
+    GLFN(DeleteMemoryObjectsEXT,        PFNGLDELETEMEMORYOBJECTSEXT,        "glDeleteMemoryObjectsEXT")
+    GLFN(ImportMemoryWin32HandleEXT,    PFNGLIMPORTMEMORYWIN32HANDLEEXT,    "glImportMemoryWin32HandleEXT")
+    GLFN(TexStorageMem2DEXT,            PFNGLTEXSTORAGEMEM2DEXT,            "glTexStorageMem2DEXT")
+    GLFN(GenSemaphoresEXT,              PFNGLGENSEMAPHORESEXT,              "glGenSemaphoresEXT")
+    GLFN(DeleteSemaphoresEXT,           PFNGLDELETESEMAPHORESEXT,           "glDeleteSemaphoresEXT")
+    GLFN(ImportSemaphoreWin32HandleEXT, PFNGLIMPORTSEMAPHOREWIN32HANDLEEXT, "glImportSemaphoreWin32HandleEXT")
+    GLFN(WaitSemaphoreEXT,              PFNGLWAITSEMAPHOREEXT,              "glWaitSemaphoreEXT")
+    GLFN(GenTextures,                   PFNGLGENTEXTURES,                   "glGenTextures")
+    GLFN(DeleteTextures,                PFNGLDELETETEXTURES,                "glDeleteTextures")
+    GLFN(BindTexture,                   PFNGLBINDTEXTURE,                   "glBindTexture")
+    GLFN(TexParameteri,                 PFNGLTEXPARAMETERI,                 "glTexParameteri")
+    GLFN(Flush,                         PFNGLFLUSH,                         "glFlush")
+    GLFN(GetError,                      PFNGLGETERROR,                      "glGetError")
+#undef GLFN
+    return missing ? -1 : 0;
+}
+
+// Destroy the GL + Vulkan objects of ONE pool generation (images, memory, GL imports, ready
+// semaphores). Fences and command buffers are NOT part of a generation (see the struct note). GL
+// deletes need the WGL context current (cothread); the Vulkan device must be idle before the
+// images/memory are freed.
+static void zc_destroy_gen(VkImage *img, VkDeviceMemory *mem, GLuint *glmem, GLuint *tex,
+                           VkSemaphore *ready, GLuint *gl_ready) {
+    for (int i = 0; i < NANO_VK_ZC_SLOTS; i++) {
+        if (tex && tex[i] && vk.gl.DeleteTextures)             { vk.gl.DeleteTextures(1, &tex[i]); tex[i] = 0; }
+        if (glmem && glmem[i] && vk.gl.DeleteMemoryObjectsEXT) { vk.gl.DeleteMemoryObjectsEXT(1, &glmem[i]); glmem[i] = 0; }
+        if (gl_ready && gl_ready[i] && vk.gl.DeleteSemaphoresEXT) { vk.gl.DeleteSemaphoresEXT(1, &gl_ready[i]); gl_ready[i] = 0; }
+        if (ready && ready[i])  { vk.fn.DestroySemaphore(vk.device, ready[i], NULL); ready[i] = VK_NULL_HANDLE; }
+        if (img && img[i])      { vk.fn.DestroyImage(vk.device, img[i], NULL); img[i] = VK_NULL_HANDLE; }
+        if (mem && mem[i])      { vk.fn.FreeMemory(vk.device, mem[i], NULL); mem[i] = VK_NULL_HANDLE; }
+    }
+}
+
+// Retire the current generation (kept alive one flip so a texture GStreamer still holds is not freed
+// under it) and destroy any older retired generation.
+static void zc_retire_current(void) {
+    if (vk.zc_retired_valid) {
+        // The previously-retired gen has had a full generation to be released by GStreamer; free it now.
+        zc_destroy_gen(vk.zc_r_image, vk.zc_r_mem, vk.zc_r_glmem, vk.zc_r_tex,
+                       vk.zc_r_ready, vk.zc_r_gl_ready);
+        vk.zc_retired_valid = 0;
+    }
+    if (!vk.zc_w) return; // nothing to retire
+    for (int i = 0; i < NANO_VK_ZC_SLOTS; i++) {
+        vk.zc_r_image[i]    = vk.zc_image[i];    vk.zc_image[i]  = VK_NULL_HANDLE;
+        vk.zc_r_mem[i]      = vk.zc_mem[i];      vk.zc_mem[i]    = VK_NULL_HANDLE;
+        vk.zc_r_glmem[i]    = vk.zc_glmem[i];    vk.zc_glmem[i]  = 0;
+        vk.zc_r_tex[i]      = vk.zc_tex[i];      vk.zc_tex[i]    = 0;
+        vk.zc_r_ready[i]    = vk.zc_ready[i];    vk.zc_ready[i]  = VK_NULL_HANDLE;
+        vk.zc_r_gl_ready[i] = vk.zc_gl_ready[i]; vk.zc_gl_ready[i] = 0;
+    }
+    vk.zc_retired_valid = 1;
+}
+
+// Build the pool at (w,h): N exportable VkImages -> exported handle -> GL import -> GL texture, plus a
+// per-slot exportable ready semaphore imported into GL. Assumes the WGL context is current. The Vulkan
+// command pool + per-slot command buffers + fences are created once (in nano_vk_zc_setup) and reused.
+static int zc_build_pool(uint32_t w, uint32_t h) {
+    for (int i = 0; i < NANO_VK_ZC_SLOTS; i++) {
+        // --- exportable VkImage (RGBA8, OPTIMAL, TRANSFER_DST|SAMPLED, OPAQUE_WIN32) ---------------
+        VkExternalMemoryImageCreateInfo ext = { VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO };
+        ext.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+        VkImageCreateInfo ici = { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+        ici.pNext = &ext;
+        ici.imageType = VK_IMAGE_TYPE_2D;
+        ici.format = NANO_VK_ZC_FORMAT;
+        ici.extent.width = w; ici.extent.height = h; ici.extent.depth = 1;
+        ici.mipLevels = 1; ici.arrayLayers = 1;
+        ici.samples = VK_SAMPLE_COUNT_1_BIT;
+        ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+        ici.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+        ici.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        ici.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        if (vk.fn.CreateImage(vk.device, &ici, NULL, &vk.zc_image[i]) != VK_SUCCESS) {
+            VKLOG(RETRO_LOG_ERROR, "zero-copy: exportable image create failed (%ux%u slot %d)\n", w, h, i);
+            return -1;
+        }
+        VkMemoryRequirements mr;
+        vk.fn.GetImageMemoryRequirements(vk.device, vk.zc_image[i], &mr);
+        uint32_t mt = find_memory_type(mr.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        if (mt == UINT32_MAX) mt = find_memory_type(mr.memoryTypeBits, 0);
+        // Dedicated allocation (NVIDIA requires it for reliable Win32 export) + export handle type.
+        VkMemoryDedicatedAllocateInfo ded = { VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO };
+        ded.image = vk.zc_image[i];
+        VkExportMemoryAllocateInfo emai = { VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO };
+        emai.pNext = &ded;
+        emai.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+        VkMemoryAllocateInfo mai = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+        mai.pNext = &emai;
+        mai.allocationSize = mr.size;
+        mai.memoryTypeIndex = mt;
+        if (vk.fn.AllocateMemory(vk.device, &mai, NULL, &vk.zc_mem[i]) != VK_SUCCESS ||
+            vk.fn.BindImageMemory(vk.device, vk.zc_image[i], vk.zc_mem[i], 0) != VK_SUCCESS) {
+            VKLOG(RETRO_LOG_ERROR, "zero-copy: dedicated export memory failed (slot %d)\n", i);
+            return -1;
+        }
+        // Export the Win32 handle for the memory and import it into a GL memory object + texture.
+        VkMemoryGetWin32HandleInfoKHR gwi = { VK_STRUCTURE_TYPE_MEMORY_GET_WIN32_HANDLE_INFO_KHR };
+        gwi.memory = vk.zc_mem[i];
+        gwi.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+        HANDLE mem_handle = NULL;
+        if (vk.fn.GetMemoryWin32HandleKHR(vk.device, &gwi, &mem_handle) != VK_SUCCESS || !mem_handle) {
+            VKLOG(RETRO_LOG_ERROR, "zero-copy: vkGetMemoryWin32HandleKHR failed (slot %d)\n", i);
+            return -1;
+        }
+        vk.gl.CreateMemoryObjectsEXT(1, &vk.zc_glmem[i]);
+        // GL takes its own reference on import, so the Win32 handle is closed right after (else we leak
+        // one handle per slot per realloc — a real leak under the 448<->896 flip rate, spec §3 footgun).
+        vk.gl.ImportMemoryWin32HandleEXT(vk.zc_glmem[i], (GLuint64)mr.size, GL_HANDLE_TYPE_OPAQUE_WIN32_EXT, mem_handle);
+        CloseHandle(mem_handle);
+        vk.gl.GenTextures(1, &vk.zc_tex[i]);
+        vk.gl.BindTexture(GL_TEXTURE_2D, vk.zc_tex[i]);
+        // The GL texture storage MUST match the VkImage exactly (w/h/format/mips=1) or it is silent
+        // corruption, not an error (spec §3 footgun). offset 0: dedicated allocation, image at base.
+        vk.gl.TexStorageMem2DEXT(GL_TEXTURE_2D, 1, GL_RGBA8, (GLsizei)w, (GLsizei)h, vk.zc_glmem[i], 0);
+        vk.gl.TexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        vk.gl.TexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        vk.gl.BindTexture(GL_TEXTURE_2D, 0);
+        GLenum gerr = vk.gl.GetError();
+        if (gerr != 0) {
+            VKLOG(RETRO_LOG_ERROR, "zero-copy: GL import error 0x%x (slot %d)\n", (unsigned)gerr, i);
+            return -1;
+        }
+
+        // --- exportable Vk->GL "ready" semaphore ---------------------------------------------------
+        VkExportSemaphoreCreateInfo esci = { VK_STRUCTURE_TYPE_EXPORT_SEMAPHORE_CREATE_INFO };
+        esci.handleTypes = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+        VkSemaphoreCreateInfo sci = { VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+        sci.pNext = &esci;
+        if (vk.fn.CreateSemaphore(vk.device, &sci, NULL, &vk.zc_ready[i]) != VK_SUCCESS) {
+            VKLOG(RETRO_LOG_ERROR, "zero-copy: create export semaphore failed (slot %d)\n", i);
+            return -1;
+        }
+        VkSemaphoreGetWin32HandleInfoKHR sgi = { VK_STRUCTURE_TYPE_SEMAPHORE_GET_WIN32_HANDLE_INFO_KHR };
+        sgi.semaphore = vk.zc_ready[i];
+        sgi.handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+        HANDLE sem_handle = NULL;
+        if (vk.fn.GetSemaphoreWin32HandleKHR(vk.device, &sgi, &sem_handle) != VK_SUCCESS || !sem_handle) {
+            VKLOG(RETRO_LOG_ERROR, "zero-copy: vkGetSemaphoreWin32HandleKHR failed (slot %d)\n", i);
+            return -1;
+        }
+        vk.gl.GenSemaphoresEXT(1, &vk.zc_gl_ready[i]);
+        vk.gl.ImportSemaphoreWin32HandleEXT(vk.zc_gl_ready[i], GL_HANDLE_TYPE_OPAQUE_WIN32_EXT, sem_handle);
+        CloseHandle(sem_handle);
+
+        vk.zc_free[i] = 1;
+        vk.zc_submitted[i] = 0;
+    }
+    vk.zc_w = w; vk.zc_h = h;
+    VKLOG(RETRO_LOG_INFO, "zero-copy: pool built (%d slots @ %ux%u)\n", NANO_VK_ZC_SLOTS, w, h);
+    return 0;
+}
+
+// Enable/disable zero-copy for the room (before nano_vk_init). sync_fence selects layer-2.
+void nano_vk_zc_set_enabled(int on, int sync_fence) { vk.zc_enabled = on ? 1 : 0; vk.zc_sync_fence = sync_fence ? 1 : 0; }
+
+// After device creation: did zero-copy survive (enabled and no extension fallback)? Go uses this to
+// decide whether to build the GL import context + pool, or run the M1 readback.
+int nano_vk_zc_wanted(void) { return (vk.zc_enabled && !vk.zc_fallback) ? 1 : 0; }
+int nano_vk_zc_active(void) { return vk.zc_active; }
+
+// Build the import context's GL function table, the Vulkan command pool + fences, and the initial pool.
+// WGL context must be current on the calling (cothread) thread. Returns 0 on success.
+int nano_vk_zc_setup(unsigned w, unsigned h) {
+    if (!vk.iface_ready || vk.zc_fallback || !vk.zc_enabled) return -1;
+    if (w == 0 || h == 0) { w = 640; h = 448; }
+    if (load_zc_win32_fns() != 0) { vk.zc_fallback = 1; return -1; }
+    if (zc_load_gl() != 0)        { vk.zc_fallback = 1; return -1; }
+
+    if (pthread_mutex_init(&vk.zc_mutex, NULL) != 0) { VKLOG(RETRO_LOG_ERROR, "zero-copy: mutex init failed\n"); return -1; }
+    vk.zc_mutex_init = 1;
+
+    VkCommandPoolCreateInfo pci = { VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO };
+    pci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    pci.queueFamilyIndex = vk.queue_family;
+    if (vk.fn.CreateCommandPool(vk.device, &pci, NULL, &vk.zc_cmd_pool) != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "zero-copy: command pool create failed\n");
+        return -1;
+    }
+    VkCommandBufferAllocateInfo ai = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO };
+    ai.commandPool = vk.zc_cmd_pool;
+    ai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    ai.commandBufferCount = NANO_VK_ZC_SLOTS;
+    if (vk.fn.AllocateCommandBuffers(vk.device, &ai, vk.zc_cmd) != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "zero-copy: command buffer alloc failed\n");
+        return -1;
+    }
+    for (int i = 0; i < NANO_VK_ZC_SLOTS; i++) {
+        VkFenceCreateInfo fi = { VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+        if (vk.fn.CreateFence(vk.device, &fi, NULL, &vk.zc_fence[i]) != VK_SUCCESS) {
+            VKLOG(RETRO_LOG_ERROR, "zero-copy: fence create failed\n");
+            return -1;
+        }
+    }
+    if (zc_build_pool(w, h) != 0) return -1;
+    vk.zc_active = 1;
+    VKLOG(RETRO_LOG_INFO, "zero-copy: ACTIVE (sync=%s)\n", vk.zc_sync_fence ? "fence(layer2)" : "semaphore(layer1)");
+    return 0;
+}
+
+// Acquire a free slot, blit the core frame into it, submit (signal the slot's ready semaphore), then
+// order it into the GL share group (GL semaphore wait + flush). Returns the slot's GL texture id, or 0
+// on dup/failure (caller OnDup()s — a dropped frame beats a stall or a wrong frame). Reallocates the
+// pool on a geometry change.
+unsigned nano_vk_zc_frame(unsigned width, unsigned height) {
+    // Drop degenerate frames (< 16px on either axis). paraLLEl-RDP emits a 1x1 frame during its async
+    // shader warmup; building a 1x1 pool and letting zc_push renegotiate the appsrc caps to 1x1 is the
+    // exact operation that error-kills the GL encode pipeline (see the matching guard in gstreamer.go
+    // pushVideoBuf for the M1/readback path). Returning 0 makes the caller OnDup() — a dropped warmup
+    // frame beats a black-for-the-session room. Parity with the readback path (audit 2026-07-16).
+    vk_dbg.zc_call++;
+    vk_dbg.last_w = width; vk_dbg.last_h = height;
+    if (!vk.zc_active)                 { vk_dbg.r_noactive++; return 0; }
+    if (!vk.have_image)                { vk_dbg.r_noimage++;  return 0; }
+    if (width < 16 || height < 16)     { vk_dbg.r_sub16++; vk_dbg.sub16_w = width; vk_dbg.sub16_h = height; return 0; }
+    uint32_t w = width, h = height;
+
+    if (w != vk.zc_w || h != vk.zc_h) {
+        // Geometry flip (routine for PS2). Idle the device, retire the current gen (kept one flip so a
+        // texture GStreamer still holds is not freed under it), rebuild at the new size. zc_push
+        // renegotiates the appsrc caps on its own from the new w/h — we do not touch the pipeline.
+        vk.fn.DeviceWaitIdle(vk.device);
+        pthread_mutex_lock(&vk.zc_mutex);
+        zc_retire_current();
+        int rc = zc_build_pool(w, h);
+        pthread_mutex_unlock(&vk.zc_mutex);
+        if (rc != 0) { vk_dbg.r_reallocf++; VKLOG(RETRO_LOG_ERROR, "zero-copy: realloc to %ux%u failed\n", w, h); return 0; }
+        VKLOG(RETRO_LOG_INFO, "zero-copy: pool reallocated for %ux%u\n", w, h);
+    }
+
+    // Acquire a free slot (reuse-oldest not needed — the free list IS the released set).
+    int idx = -1;
+    pthread_mutex_lock(&vk.zc_mutex);
+    for (int i = 0; i < NANO_VK_ZC_SLOTS; i++) {
+        if (vk.zc_free[i]) { idx = i; vk.zc_free[i] = 0; break; }
+    }
+    pthread_mutex_unlock(&vk.zc_mutex);
+    if (idx < 0) { vk_dbg.r_noslot++; return 0; } // encoder holds every slot; dup this frame
+
+    VkCommandBuffer cb = vk.zc_cmd[idx];
+    VkFence fence = vk.zc_fence[idx];
+    if (vk.zc_submitted[idx]) {
+        // The slot's previous blit fence — wait it so the command buffer is free to re-record and its
+        // ready semaphore is back to unsignaled (GStreamer only freed the slot after GL consumed it).
+        vk.fn.WaitForFences(vk.device, 1, &fence, VK_TRUE, UINT64_MAX);
+        vk.zc_submitted[idx] = 0;
+    }
+    vk.fn.ResetFences(vk.device, 1, &fence);
+    vk.fn.ResetCommandBuffer(cb, 0);
+
+    uint32_t src_w = vk.src_w ? vk.src_w : w;
+    uint32_t src_h = vk.src_h ? vk.src_h : h;
+
+    VkCommandBufferBeginInfo bi = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+    bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vk.fn.BeginCommandBuffer(cb, &bi);
+
+    // Core image: current layout -> TRANSFER_SRC.
+    img_barrier(cb, vk.src_image, vk.src_layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+                VK_ACCESS_TRANSFER_READ_BIT,
+                VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+    // Slot image: UNDEFINED (discard previous) -> TRANSFER_DST.
+    img_barrier(cb, vk.zc_image[idx], VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                0, VK_ACCESS_TRANSFER_WRITE_BIT,
+                VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+    // Blit core(RGBA) -> slot(RGBA). No channel swap (M1's BGRA swap is gone — the GL zc path ships
+    // RGBA). LINEAR only when scaling, NEAREST 1:1 (bit-preserving), matching M1's F1 semantics.
+    VkImageBlit region;
+    memset(&region, 0, sizeof(region));
+    region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    region.srcSubresource.layerCount = 1;
+    region.dstSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    region.dstSubresource.layerCount = 1;
+    region.srcOffsets[1].x = (int32_t)src_w; region.srcOffsets[1].y = (int32_t)src_h; region.srcOffsets[1].z = 1;
+    region.dstOffsets[1].x = (int32_t)w;     region.dstOffsets[1].y = (int32_t)h;     region.dstOffsets[1].z = 1;
+    VkFilter filter = (src_w != w || src_h != h) ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+    vk.fn.CmdBlitImage(cb, vk.src_image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                       vk.zc_image[idx], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region, filter);
+    // Slot image: TRANSFER_DST -> SHADER_READ_ONLY (the layout the GL wait names; GL samples it).
+    img_barrier(cb, vk.zc_image[idx], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+                VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT,
+                VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT);
+    // Core image back to the layout the core handed it in, so the core can reuse it.
+    img_barrier(cb, vk.src_image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, vk.src_layout,
+                VK_ACCESS_TRANSFER_READ_BIT,
+                VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT);
+    vk.fn.EndCommandBuffer(cb);
+
+    VkSubmitInfo si = { VK_STRUCTURE_TYPE_SUBMIT_INFO };
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &cb;
+    si.signalSemaphoreCount = 1;
+    si.pSignalSemaphores = &vk.zc_ready[idx];   // Vulkan -> GL ready
+
+    cb_lock_queue(&vk);
+    VkResult r = vk.fn.QueueSubmit(vk.queue, 1, &si, fence);
+    cb_unlock_queue(&vk);
+    if (r != VK_SUCCESS) {
+        VKLOG(RETRO_LOG_ERROR, "zero-copy: blit submit failed: %d\n", r);
+        pthread_mutex_lock(&vk.zc_mutex); vk.zc_free[idx] = 1; pthread_mutex_unlock(&vk.zc_mutex);
+        return 0;
+    }
+    vk.zc_submitted[idx] = 1;
+
+    if (vk.zc_sync_fence) {
+        // Layer 2 (conservative / correctness reference): host-wait the blit fence before GL consumes.
+        // Still strictly cheaper than M1's blit+copy+host-visibility chain (no copy, no map).
+        vk.fn.WaitForFences(vk.device, 1, &fence, VK_TRUE, UINT64_MAX);
+    }
+
+    // Layer 1: order the slot into the GL share group. glWaitSemaphoreEXT inserts a GPU wait on the
+    // imported ready semaphore (naming the texture's current layout), so GStreamer's shared context
+    // samples only after the Vulkan blit's GPU signal. glFlush pushes the wait so it is visible before
+    // the encoder's context binds the texture.
+    GLenum src_layout = GL_LAYOUT_SHADER_READ_ONLY_EXT;
+    vk_dbg.sem_begin++;
+    vk.gl.WaitSemaphoreEXT(vk.zc_gl_ready[idx], 0, NULL, 1, &vk.zc_tex[idx], &src_layout);
+    vk.gl.Flush();
+    vk_dbg.sem_done++;
+
+    vk_dbg.zc_tex++;
+    return (unsigned)vk.zc_tex[idx];
+}
+
+// Return a slot to the free list (called from GStreamer's thread when it frees the wrapping buffer —
+// the ONLY moment the slot is safe to reuse). Returns 1 if the texid belonged to this pool (current or
+// retired gen), 0 otherwise (a long-gone gen — ignore, like graphics.ReleaseZeroCopyTexture).
+int nano_vk_zc_release(unsigned texid) {
+    if (!vk.zc_mutex_init || texid == 0) return 0;
+    int owned = 0;
+    pthread_mutex_lock(&vk.zc_mutex);
+    for (int i = 0; i < NANO_VK_ZC_SLOTS; i++) {
+        if (vk.zc_tex[i] == (GLuint)texid) { vk.zc_free[i] = 1; owned = 1; break; }
+    }
+    if (!owned && vk.zc_retired_valid) {
+        for (int i = 0; i < NANO_VK_ZC_SLOTS; i++)
+            if (vk.zc_r_tex[i] == (GLuint)texid) { owned = 1; break; } // retired gen freed wholesale later
+    }
+    pthread_mutex_unlock(&vk.zc_mutex);
+    return owned;
+}
+
+// Tear down the zero-copy pool (GL imports + Vulkan pool objects). Runs on the cothread with the WGL
+// context current, BEFORE nano_vk_predestroy / device destroy.
+void nano_vk_zc_teardown(void) {
+    if (!vk.device) return;
+    vk.fn.DeviceWaitIdle(vk.device);
+    zc_destroy_gen(vk.zc_image, vk.zc_mem, vk.zc_glmem, vk.zc_tex, vk.zc_ready, vk.zc_gl_ready);
+    if (vk.zc_retired_valid) {
+        zc_destroy_gen(vk.zc_r_image, vk.zc_r_mem, vk.zc_r_glmem, vk.zc_r_tex, vk.zc_r_ready, vk.zc_r_gl_ready);
+        vk.zc_retired_valid = 0;
+    }
+    for (int i = 0; i < NANO_VK_ZC_SLOTS; i++) {
+        if (vk.zc_fence[i]) { vk.fn.DestroyFence(vk.device, vk.zc_fence[i], NULL); vk.zc_fence[i] = VK_NULL_HANDLE; }
+    }
+    if (vk.zc_cmd_pool) { vk.fn.DestroyCommandPool(vk.device, vk.zc_cmd_pool, NULL); vk.zc_cmd_pool = VK_NULL_HANDLE; }
+    if (vk.zc_mutex_init) { pthread_mutex_destroy(&vk.zc_mutex); vk.zc_mutex_init = 0; }
+    vk.zc_active = 0;
+    vk.zc_w = vk.zc_h = 0;
+    VKLOG(RETRO_LOG_INFO, "zero-copy: pool torn down (pre context_destroy)\n");
+}
+
+// One-shot capability probe: does the discrete GPU advertise the external-memory/semaphore Win32
+// extensions? Brings up a throwaway instance (never a device — enumeration needs only a physical
+// device), so the decision is known at pipeline-BUILD time (the readback-vs-GL pipeline is chosen
+// before the core's device exists). CLOUD_GAME_VK_ZC_SIMULATE_NOEXT=1 forces a negative for testing the
+// automatic fallback. Returns 1 if supported.
+int nano_vk_probe_zerocopy(void) {
+    const char *sim = getenv("CLOUD_GAME_VK_ZC_SIMULATE_NOEXT");
+    if (sim && sim[0] == '1') return 0;
+
+    HMODULE dll = LoadLibraryA("vulkan-1.dll");
+    if (!dll) return 0;
+    PFN_vkGetInstanceProcAddr gipa = (PFN_vkGetInstanceProcAddr)(void(*)(void))GetProcAddress(dll, "vkGetInstanceProcAddr");
+    if (!gipa) { FreeLibrary(dll); return 0; }
+    PFN_vkCreateInstance ci_fn = (PFN_vkCreateInstance)gipa(NULL, "vkCreateInstance");
+    if (!ci_fn) { FreeLibrary(dll); return 0; }
+
+    VkApplicationInfo app = { VK_STRUCTURE_TYPE_APPLICATION_INFO };
+    app.apiVersion = VK_API_VERSION_1_1;
+    VkInstanceCreateInfo ci = { VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO };
+    ci.pApplicationInfo = &app;
+    VkInstance inst = VK_NULL_HANDLE;
+    if (ci_fn(&ci, NULL, &inst) != VK_SUCCESS) { FreeLibrary(dll); return 0; }
+
+    PFN_vkEnumeratePhysicalDevices epd = (PFN_vkEnumeratePhysicalDevices)gipa(inst, "vkEnumeratePhysicalDevices");
+    PFN_vkGetPhysicalDeviceProperties gpp = (PFN_vkGetPhysicalDeviceProperties)gipa(inst, "vkGetPhysicalDeviceProperties");
+    PFN_vkEnumerateDeviceExtensionProperties edep = (PFN_vkEnumerateDeviceExtensionProperties)gipa(inst, "vkEnumerateDeviceExtensionProperties");
+    PFN_vkDestroyInstance di = (PFN_vkDestroyInstance)gipa(inst, "vkDestroyInstance");
+    int supported = 0;
+    if (epd && edep) {
+        uint32_t n = 0;
+        if (epd(inst, &n, NULL) == VK_SUCCESS && n > 0) {
+            if (n > 16) n = 16;
+            VkPhysicalDevice devs[16];
+            if (epd(inst, &n, devs) == VK_SUCCESS) {
+                VkPhysicalDevice gpu = devs[0];
+                for (uint32_t i = 0; i < n && gpp; i++) {
+                    VkPhysicalDeviceProperties p;
+                    gpp(devs[i], &p);
+                    if (p.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU) { gpu = devs[i]; break; }
+                }
+                uint32_t en = 0;
+                if (edep(gpu, NULL, &en, NULL) == VK_SUCCESS && en > 0) {
+                    if (en > 1024) en = 1024;
+                    VkExtensionProperties *props = (VkExtensionProperties *)malloc(sizeof(VkExtensionProperties) * en);
+                    if (props && edep(gpu, NULL, &en, props) == VK_SUCCESS) {
+                        int mem = 0, sem = 0;
+                        for (uint32_t i = 0; i < en; i++) {
+                            if (strcmp(props[i].extensionName, VK_KHR_EXTERNAL_MEMORY_WIN32_EXTENSION_NAME) == 0) mem = 1;
+                            if (strcmp(props[i].extensionName, VK_KHR_EXTERNAL_SEMAPHORE_WIN32_EXTENSION_NAME) == 0) sem = 1;
+                        }
+                        supported = (mem && sem);
+                    }
+                    free(props);
+                }
+            }
+        }
+    }
+    if (di) di(inst, NULL);
+    FreeLibrary(dll);
+    return supported;
+}
+
+// ===================================================================================================
+// Teardown
+// ===================================================================================================
+
+// Destroy OUR resources (before the core's context_destroy runs).
+void nano_vk_predestroy(void) {
+    if (!vk.device) return;
+    vk.fn.DeviceWaitIdle(vk.device);
+    destroy_staging();
+    for (int i = 0; i < NANO_VK_SYNC; i++) {
+        if (vk.fence[i]) { vk.fn.DestroyFence(vk.device, vk.fence[i], NULL); vk.fence[i] = VK_NULL_HANDLE; }
+    }
+    if (vk.cmd_pool) { vk.fn.DestroyCommandPool(vk.device, vk.cmd_pool, NULL); vk.cmd_pool = VK_NULL_HANDLE; }
+    vk.iface_ready = 0;
+    vk.have_image = 0;
+    VKLOG(RETRO_LOG_INFO, "frontend resources destroyed (pre context_destroy)\n");
+}
+
+// Destroy the device + instance and unload the loader (after the core's context_destroy has run and
+// released ownership of both).
+void nano_vk_shutdown(void) {
+    if (vk.device) {
+        vk.fn.DeviceWaitIdle(vk.device);
+        // If a negotiation destroy_device exists, let the core free its auxiliary resources first.
+        if (vk.have_negotiation && vk.negotiation.destroy_device)
+            vk.negotiation.destroy_device();
+        vk.fn.DestroyDevice(vk.device, NULL);
+        vk.device = VK_NULL_HANDLE;
+    }
+    // Synthetic surface (if any): destroy it BEFORE the instance it belongs to; the window can go after.
+    if (vk.synth_surface && vk.instance) {
+        PFN_vkDestroySurfaceKHR destroySurf =
+            (PFN_vkDestroySurfaceKHR)vk.fn.GetInstanceProcAddr(vk.instance, "vkDestroySurfaceKHR");
+        if (destroySurf) destroySurf(vk.instance, vk.synth_surface, NULL);
+        vk.synth_surface = VK_NULL_HANDLE;
+    }
+    if (vk.instance && vk.fn.DestroyInstance) {
+        vk.fn.DestroyInstance(vk.instance, NULL);
+        vk.instance = VK_NULL_HANDLE;
+    }
+    if (vk.synth_hwnd) {
+        DestroyWindow(vk.synth_hwnd);
+        vk.synth_hwnd = NULL;
+    }
+    pthread_mutex_destroy(&vk.queue_mutex);
+    if (vk.dll) { FreeLibrary(vk.dll); vk.dll = NULL; }
+
+    // Reset ALL state so a subsequent room on this worker (Vulkan or not) starts clean.
+    memset(&vk, 0, sizeof(vk));
+    VKLOG(RETRO_LOG_INFO, "device + instance destroyed; loader unloaded\n");
+}
diff --git a/pkg/worker/caged/libretro/nanoarch/overrides.go b/pkg/worker/caged/libretro/nanoarch/overrides.go
new file mode 100644
index 0000000..f3bbec2
--- /dev/null
+++ b/pkg/worker/caged/libretro/nanoarch/overrides.go
@@ -0,0 +1,187 @@
+package nanoarch
+
+import (
+	"encoding/json"
+	"os"
+	"sync"
+	"time"
+)
+
+// GameOverride is one ROM's entry in the arcade per-game config manifest (game-overrides.json,
+// generated by the site's `arcade-gameconfig-export` from the ArcadeGameProfile table). It is keyed
+// by ROM filename sans extension (== ArcadeGame.CloudRetroGameKey, the same key options4rom uses).
+// See docs/arcade-per-game-config.md.
+//
+//	{
+//	  "Sonic Adventure v1.005 (1999)(Sega)(US)(M5)[!][%51000-A]": { "fps": 30 },
+//	  "Some Game (USA)": { "options": { "flycast_widescreen_hacks": "enabled" } }
+//	}
+type GameOverride struct {
+	Fps     float64           `json:"fps"`     // forced framerate (0 = leave the core's advertised rate)
+	Options map[string]string `json:"options"` // libretro core-option overrides applied before load
+	// HwContext is an EXPLICIT per-game hardware-render-context override: "gl" or "vulkan" (absent = ""
+	// = defer to inference/core default). It is the ABSOLUTE top of the room layer's hw-context
+	// precedence chain — above the renderer-option inference (WantsVulkanRenderer / ForcesGlRenderer)
+	// and above the core config's HwContext default. It exists for the cores that have NO renderer
+	// core-option to infer from — PPSSPP (psp), flycast (dc), Dolphin (gc) all just follow the
+	// frontend's hw context, so a per-game escape/opt-in for those systems cannot be expressed as a
+	// renderer-option value; this field is how a profile pins one of those games onto (or off of) the
+	// Vulkan-capture path. See GameHwContext and coordinatorhandlers.go.
+	HwContext string `json:"hwContext"`
+}
+
+var (
+	goMu     sync.Mutex
+	goCache  map[string]GameOverride
+	goMod    time.Time
+	goLoaded bool
+	goPath   string
+)
+
+// vulkanRendererOptions is the data-driven table of "a core-option key whose value flips a game onto
+// the Vulkan-capture path". Keyed by the libretro option NAME; the inner set holds the VALUES that
+// mean Vulkan for that core. A game's override is a Vulkan room iff ANY listed option is set to a
+// listed value.
+//
+//   - pcsx2_renderer (LRPS2 / PS2, M1+M2): the Vulkan renderers are "paraLLEl-GS" and "Vulkan".
+//   - mupen64plus-rdp-plugin (mupen64plus-next / N64, W2): "parallel" selects paraLLEl-RDP, a Vulkan
+//     COMPUTE renderer. (The "gliden64" default is GL and "angrylion" is software — neither is Vulkan.)
+//     paraLLEl-RDP also wants the LLE RSP (mupen64plus-rsp-plugin=parallel); that is an accuracy pairing
+//     the profile sets, but the RENDERER selector above is what decides the capture path.
+//
+// The exporter now HAS an explicit hwContext field on GameOverride (GameHwContext, W3 F1), which is
+// the general per-game lever. This inference table stays because the ps2/n64 profiles already export
+// their renderer as a core option (pcsx2_renderer / mupen64plus-rdp-plugin) and it keeps working with
+// zero re-export, and it doubles as the GL escape hatch (glRendererOptions). W3/W4 cores that have NO
+// renderer core-option to infer from (flycast/dolphin/ppsspp) are NOT wired here — they use the
+// explicit hwContext field instead. Do not add those systems to this table.
+var vulkanRendererOptions = map[string]map[string]struct{}{
+	"pcsx2_renderer":         {"paraLLEl-GS": {}, "Vulkan": {}},
+	"mupen64plus-rdp-plugin": {"parallel": {}},
+}
+
+// WantsVulkanRenderer reports whether a game's per-game override requests a Vulkan-rendered core —
+// the signal the room layer uses to put THAT room on the Vulkan-capture path (HwContextOverride)
+// while the core's config default stays GL for every other game on the system.
+func WantsVulkanRenderer(gameKey string) bool {
+	o, ok := gameOverrides()[gameKey]
+	if !ok {
+		return false
+	}
+	for optName, vulkanValues := range vulkanRendererOptions {
+		if v, set := o.Options[optName]; set {
+			if _, isVulkan := vulkanValues[v]; isVulkan {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// GameHwContext returns a game's EXPLICIT per-game hardware-context override — "gl" or "vulkan" — or
+// "" when the game has no (or an unrecognized) hwContext field. This is the top level of the room
+// layer's 3-level hw-context precedence (see coordinatorhandlers.go): it wins over both the
+// renderer-option inference and the core config default. Only "gl"/"vulkan" are honored; any other
+// value is treated as absent so a typo can't silently pin a game onto a nonexistent context.
+func GameHwContext(gameKey string) string {
+	o, ok := gameOverrides()[gameKey]
+	if !ok {
+		return ""
+	}
+	switch o.HwContext {
+	case "gl", "vulkan":
+		return o.HwContext
+	default:
+		return ""
+	}
+}
+
+// ResolveHwContext computes a room's hardware-render context ("gl" or "vulkan", never "") by the F1
+// 3-level precedence (highest wins):
+//
+//  1. the game's EXPLICIT hwContext override field (GameHwContext) — absolute;
+//  2. the renderer-option inference — WantsVulkanRenderer (→ "vulkan") then ForcesGlRenderer (→ "gl");
+//  3. coreDefault — the core config's HwContext ("" is normalized to "gl").
+//
+// The room layer (coordinatorhandlers) calls this, then stages HwContextOverride only when the result
+// diverges from the core default. Pure over the current manifest, so it is unit-testable; see
+// overrides_test.go for the full combination table.
+func ResolveHwContext(gameKey, coreDefault string) string {
+	if coreDefault == "" {
+		coreDefault = "gl"
+	}
+	switch {
+	case GameHwContext(gameKey) != "":
+		return GameHwContext(gameKey)
+	case WantsVulkanRenderer(gameKey):
+		return "vulkan"
+	case ForcesGlRenderer(gameKey):
+		return "gl"
+	default:
+		return coreDefault
+	}
+}
+
+// glRendererOptions is the inverse of vulkanRendererOptions: an override value that EXPLICITLY selects
+// a non-Vulkan (GL / software) renderer. When a core config DEFAULTS to hwContext:"vulkan" (all PS2 /
+// N64 games ride the Vulkan-capture path), this is the per-game ESCAPE HATCH — a title that paraLLEl-GS
+// / paraLLEl-RDP can't serve is pinned back onto the GL capture path from its manifest alone, no code
+// change. Setting e.g. pcsx2_renderer:"OpenGL" both trips this (→ HwContextOverride "gl") AND overrides
+// the core option, so the core renders GL and the GL pipeline captures it — consistent.
+var glRendererOptions = map[string]map[string]struct{}{
+	"pcsx2_renderer":         {"OpenGL": {}, "Software": {}},
+	"mupen64plus-rdp-plugin": {"gliden64": {}, "angrylion": {}},
+}
+
+// ForcesGlRenderer reports whether a game's override EXPLICITLY selects a GL/software renderer — the
+// signal the room layer uses to pin THAT room to the GL capture path even when the core config defaults
+// to Vulkan. Checked BEFORE the vulkan default so an incompatible title always has a fallback.
+func ForcesGlRenderer(gameKey string) bool {
+	o, ok := gameOverrides()[gameKey]
+	if !ok {
+		return false
+	}
+	for optName, glValues := range glRendererOptions {
+		if v, set := o.Options[optName]; set {
+			if _, isGl := glValues[v]; isGl {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// gameOverrides returns the current per-game manifest (romName → override), transparently reloading
+// when the file's mtime changes so admin edits take effect on the NEXT room without a worker restart.
+// Path: CLOUD_GAME_GAME_OVERRIDES, else "game-overrides.json" resolved from the worker CWD (the same
+// ConfDir config.yaml loads from). A missing file means "no overrides" (nil); a parse error keeps the
+// last good map so a bad regen can't wipe live behavior mid-session.
+func gameOverrides() map[string]GameOverride {
+	path := os.Getenv("CLOUD_GAME_GAME_OVERRIDES")
+	if path == "" {
+		path = "game-overrides.json"
+	}
+
+	goMu.Lock()
+	defer goMu.Unlock()
+
+	fi, err := os.Stat(path)
+	if err != nil {
+		goCache, goLoaded, goPath = nil, true, path
+		return nil
+	}
+	if goLoaded && path == goPath && fi.ModTime().Equal(goMod) {
+		return goCache
+	}
+
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return goCache
+	}
+	var m map[string]GameOverride
+	if err := json.Unmarshal(data, &m); err != nil {
+		return goCache // keep last-good on malformed JSON
+	}
+	goCache, goMod, goLoaded, goPath = m, fi.ModTime(), true, path
+	return m
+}
diff --git a/pkg/worker/caged/libretro/nanoarch/overrides_test.go b/pkg/worker/caged/libretro/nanoarch/overrides_test.go
new file mode 100644
index 0000000..156812d
--- /dev/null
+++ b/pkg/worker/caged/libretro/nanoarch/overrides_test.go
@@ -0,0 +1,111 @@
+package nanoarch
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// writeOverrides drops a game-overrides manifest into a temp dir, points the loader at it via
+// CLOUD_GAME_GAME_OVERRIDES, and forces a reload (a fresh path defeats the mtime cache). It returns a
+// cleanup that restores the previous env + cache state so tests don't leak into each other.
+func writeOverrides(t *testing.T, json string) {
+	t.Helper()
+	dir := t.TempDir()
+	path := filepath.Join(dir, "game-overrides.json")
+	if err := os.WriteFile(path, []byte(json), 0o644); err != nil {
+		t.Fatalf("write manifest: %v", err)
+	}
+	prev, had := os.LookupEnv("CLOUD_GAME_GAME_OVERRIDES")
+	if err := os.Setenv("CLOUD_GAME_GAME_OVERRIDES", path); err != nil {
+		t.Fatalf("setenv: %v", err)
+	}
+	// Reset the package cache so the new path/mtime is picked up deterministically.
+	goMu.Lock()
+	goLoaded, goPath, goCache = false, "", nil
+	goMu.Unlock()
+	t.Cleanup(func() {
+		if had {
+			_ = os.Setenv("CLOUD_GAME_GAME_OVERRIDES", prev)
+		} else {
+			_ = os.Unsetenv("CLOUD_GAME_GAME_OVERRIDES")
+		}
+		goMu.Lock()
+		goLoaded, goPath, goCache = false, "", nil
+		goMu.Unlock()
+	})
+}
+
+// TestResolveHwContext exercises the F1 3-level precedence:
+//  1. explicit hwContext field (absolute)  2. renderer-option inference  3. core default.
+func TestResolveHwContext(t *testing.T) {
+	// One manifest covering every lever the resolver reads.
+	writeOverrides(t, `{
+	  "explicit-vk":        { "hwContext": "vulkan" },
+	  "explicit-gl":        { "hwContext": "gl" },
+	  "explicit-bogus":     { "hwContext": "metal" },
+	  "explicit-wins-over-infer": { "hwContext": "gl", "options": { "pcsx2_renderer": "paraLLEl-GS" } },
+	  "infer-vk":           { "options": { "mupen64plus-rdp-plugin": "parallel" } },
+	  "infer-gl":           { "options": { "pcsx2_renderer": "OpenGL" } },
+	  "no-hw-signal":       { "options": { "some_unrelated_opt": "x" } }
+	}`)
+
+	cases := []struct {
+		name        string
+		gameKey     string
+		coreDefault string
+		want        string
+	}{
+		// Level 1 — explicit field is absolute, regardless of core default.
+		{"explicit vulkan over gl-default core", "explicit-vk", "gl", "vulkan"},
+		{"explicit gl over vulkan-default core", "explicit-gl", "vulkan", "gl"},
+		{"explicit field beats renderer inference", "explicit-wins-over-infer", "gl", "gl"},
+		{"bogus explicit value is ignored, falls to default", "explicit-bogus", "vulkan", "vulkan"},
+
+		// Level 2 — renderer-option inference when no explicit field.
+		{"infer vulkan (rdp=parallel) on gl-default core", "infer-vk", "gl", "vulkan"},
+		{"infer gl (pcsx2_renderer=OpenGL) escapes vulkan-default core", "infer-gl", "vulkan", "gl"},
+
+		// Level 3 — core default when no per-game signal at all.
+		{"no signal, vulkan-default core", "no-hw-signal", "vulkan", "vulkan"},
+		{"no signal, gl-default core", "no-hw-signal", "gl", "gl"},
+		{"absent game key, vulkan-default core", "not-in-manifest", "vulkan", "vulkan"},
+		{"absent game key, gl-default core", "not-in-manifest", "gl", "gl"},
+
+		// Core default normalization: "" == "gl".
+		{"empty core default normalizes to gl", "no-hw-signal", "", "gl"},
+		{"explicit vulkan over empty core default", "explicit-vk", "", "vulkan"},
+	}
+
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if got := ResolveHwContext(c.gameKey, c.coreDefault); got != c.want {
+				t.Errorf("ResolveHwContext(%q, %q) = %q, want %q", c.gameKey, c.coreDefault, got, c.want)
+			}
+		})
+	}
+}
+
+// TestGameHwContext checks the explicit-field accessor rejects unrecognized values.
+func TestGameHwContext(t *testing.T) {
+	writeOverrides(t, `{
+	  "vk":    { "hwContext": "vulkan" },
+	  "gl":    { "hwContext": "gl" },
+	  "bogus": { "hwContext": "d3d12" },
+	  "empty": { "hwContext": "" },
+	  "none":  { "fps": 30 }
+	}`)
+
+	for _, c := range []struct{ key, want string }{
+		{"vk", "vulkan"},
+		{"gl", "gl"},
+		{"bogus", ""},
+		{"empty", ""},
+		{"none", ""},
+		{"absent", ""},
+	} {
+		if got := GameHwContext(c.key); got != c.want {
+			t.Errorf("GameHwContext(%q) = %q, want %q", c.key, got, c.want)
+		}
+	}
+}
