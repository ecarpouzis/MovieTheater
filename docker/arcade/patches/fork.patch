diff --git a/cmd/rahash/main.go b/cmd/rahash/main.go
new file mode 100644
index 0000000..66c6d7b
--- /dev/null
+++ b/cmd/rahash/main.go
@@ -0,0 +1,320 @@
+// Command rahash computes RetroAchievements ROM hashes — the same identification rc_client performs
+// when it loads a game — so the site can map its library to RA games by CONTENT instead of by title.
+//
+// Why it exists: RA identifies a ROM by hash. Matching our cards to RA by normalised title is
+// structurally unable to be right every time — RA tags non-retail entries in the title (~Hack~,
+// ~Demo~, ~Prototype~, [Subset - …]), a translation patch resolves to a different REGION's entry, and
+// plenty of titles simply diverge (ours "Learn 2 Kaizo" vs RA "~Hack~ Super Mario World: Learn 2
+// Kaizo"). The hash has none of those failure modes: it is what RA itself keys on.
+//
+// PROTOCOL — one JSON request per line on stdin, one JSON result per line on stdout, in order:
+//
+//	{"path":"R:\\Roms\\Games\\n64\\Diddy Kong Racing (USA).z64","consoleId":2,"id":3}
+//	{"id":3,"hash":"3ec4c...","ok":true}
+//	{"id":4,"ok":false,"error":"could not hash"}
+//
+// `id` is opaque and echoed back, so the caller can correlate without depending on ordering. A line
+// that fails to parse, a file that cannot be read, and a console whose rules do not apply are all
+// reported as ok:false — one bad ROM never kills a batch.
+//
+// The CALLER drives the work and owns the chunking: it streams as many or as few lines as it wants,
+// and can stop after any line and resume from there (see the site's arcade-ra-hash command). This
+// process holds no state between lines beyond rcheevos' one-time reader install.
+package main
+
+import (
+	"archive/zip"
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+
+	"github.com/giongto35/cloud-game/v3/pkg/worker/cheevos"
+)
+
+type request struct {
+	ID        any    `json:"id"`
+	Path      string `json:"path"`
+	ConsoleID uint32 `json:"consoleId"`
+	// System is an alternative to ConsoleID: pass the arcade system code ("n64", "snes") and let the
+	// same map the worker uses resolve it, so the two can never drift apart.
+	System string `json:"system"`
+}
+
+type response struct {
+	ID    any    `json:"id,omitempty"`
+	Hash  string `json:"hash,omitempty"`
+	OK    bool   `json:"ok"`
+	Error string `json:"error,omitempty"`
+}
+
+func main() {
+	in := bufio.NewScanner(os.Stdin)
+	// ROM paths are short, but a caller batching many is not this reader's business; give it room.
+	in.Buffer(make([]byte, 0, 64*1024), 1024*1024)
+	out := bufio.NewWriter(os.Stdout)
+	defer out.Flush()
+	enc := json.NewEncoder(out)
+
+	for in.Scan() {
+		line := in.Bytes()
+		if len(line) == 0 {
+			continue
+		}
+		var req request
+		if err := json.Unmarshal(line, &req); err != nil {
+			_ = enc.Encode(response{OK: false, Error: "bad request: " + err.Error()})
+			out.Flush()
+			continue
+		}
+		console := req.ConsoleID
+		if console == 0 && req.System != "" {
+			console = cheevos.ConsoleID(req.System)
+		}
+		hash, ok := hashSafely(console, req.Path)
+		res := response{ID: req.ID, OK: ok, Hash: hash}
+		if !ok {
+			// rcheevos keeps its reason in its own error buffer, which we do not surface; the caller
+			// needs to know only that this dump could not be identified, and for which path.
+			res.Error = "could not hash for console " + fmt.Sprint(console)
+		}
+		_ = enc.Encode(res)
+		// Flush per line: the caller reads results as they arrive and may stop at any point, so a
+		// buffered tail would look like lost work.
+		out.Flush()
+	}
+	if err := in.Err(); err != nil {
+		fmt.Fprintln(os.Stderr, "rahash: read stdin:", err)
+		os.Exit(1)
+	}
+}
+
+// hashSafely keeps one malformed dump from taking down a whole batch. rcheevos walks structures inside
+// the file (disc tables of contents, zip directories) and a truncated or corrupt image is exactly the
+// kind of input that reaches unhappy paths there — of which we have plenty, since half the point of
+// this tool is finding the dumps that are not what their name claims.
+func hashSafely(console uint32, path string) (hash string, ok bool) {
+	defer func() {
+		if r := recover(); r != nil {
+			hash, ok = "", false
+			fmt.Fprintf(os.Stderr, "rahash: panic hashing %q: %v\n", path, r)
+		}
+	}()
+	if path == "" {
+		return "", false
+	}
+	if st, err := os.Stat(path); err != nil || st.IsDir() {
+		return "", false
+	}
+	// A console ROM inside a .zip must be EXTRACTED before hashing. rc_hash handed the .zip path
+	// hashes the container instead — it succeeds and returns a well-formed hash that matches nothing,
+	// which is the worst possible failure here because every counter says the sweep worked. (Verified
+	// the hard way: ~10,000 zipped dumps hashed "successfully" and matched zero RA games, while the
+	// raw-.z64 N64 set matched perfectly.)
+	//
+	// RC_CONSOLE_ARCADE (27) is the deliberate exception: for MAME/FBNeo the zip IS the ROM, and
+	// rc_hash has its own rules for reading it, so the path form is the correct one there.
+	if console != 27 && strings.EqualFold(filepath.Ext(path), ".zip") {
+		data, err := romFromZip(path)
+		if err != nil || len(data) == 0 {
+			return "", false
+		}
+		return cheevos.HashBuffer(console, data)
+	}
+	// .7z gets the same treatment, but it has to go through an external extractor: there is no 7-Zip
+	// reader in the standard library, and a disc image inside one is not something rc_hash can reach.
+	// Disc archives are also too large to hold in memory comfortably, so this extracts to a temp DIR and
+	// hashes the resulting file by PATH — which additionally lets rc_hash's cdreader follow a .cue to
+	// its .bin tracks, something a lone buffer could never support.
+	if strings.EqualFold(filepath.Ext(path), ".7z") {
+		return hashFrom7z(console, path)
+	}
+	// .chd is the one container we cannot serve on demand: unlike CSO/GCZ (a block index and deflate,
+	// which the virtual filereader reads directly), CHD is a hunk-mapped format with several codecs
+	// (zlib/lzma/flac/zstd) and CD sector framing, so reading it needs libchdr. Until that is linked in,
+	// extract with MAME's chdman and hash the resulting .cue. Slower than the others by far, but correct.
+	if strings.EqualFold(filepath.Ext(path), ".chd") && chdmanExe != "" {
+		return hashFromChd(console, path)
+	}
+	return cheevos.HashFile(console, path)
+}
+
+// chdmanExe is resolved from CHDMAN_EXE or PATH. Absent = .chd dumps report unhashable rather than
+// pretending — the counter is what makes a missing tool visible instead of silently halving coverage.
+var chdmanExe = func() string {
+	if p := os.Getenv("CHDMAN_EXE"); p != "" {
+		if _, err := os.Stat(p); err == nil {
+			return p
+		}
+	}
+	if p, err := exec.LookPath("chdman"); err == nil {
+		return p
+	}
+	return ""
+}()
+
+func hashFromChd(console uint32, path string) (string, bool) {
+	// THE DESCRIPTOR FORMAT MATTERS, and it differs by console. chdman picks its output format from the
+	// extension, and rc_hash will not accept the wrong one:
+	//
+	//   Dreamcast (40) is a GD-ROM — rc_hash reads IP.BIN through a .gdi and rejects a .cue outright
+	//                                (verified: the same disc fails as .cue, hashes as .gdi).
+	//   Saturn / PC Engine CD / everything else — ordinary CD, described by a .cue.
+	//
+	// Try the console's natural form first, then the other: a mislabelled system is far likelier than
+	// a genuinely unhashable disc, and the second attempt costs only a re-extract of one file.
+	order := []string{"out.cue", "out.gdi"}
+	if console == 40 {
+		order = []string{"out.gdi", "out.cue"}
+	}
+	for _, name := range order {
+		if h, ok := chdExtractAndHash(console, path, name); ok {
+			return h, true
+		}
+	}
+	return "", false
+}
+
+func chdExtractAndHash(console uint32, path, outName string) (string, bool) {
+	dir, err := os.MkdirTemp("", "rahashchd")
+	if err != nil {
+		return "", false
+	}
+	defer os.RemoveAll(dir)
+
+	out := filepath.Join(dir, outName)
+	// extractcd covers the CD-based consoles we store as CHD. A .gdi writes its own per-track files; a
+	// .cue needs the companion binary named explicitly.
+	args := []string{"extractcd", "-i", path, "-o", out, "-f"}
+	if strings.EqualFold(filepath.Ext(outName), ".cue") {
+		args = append(args, "-ob", filepath.Join(dir, "out.bin"))
+	}
+	if err := exec.Command(chdmanExe, args...).Run(); err != nil {
+		return "", false
+	}
+	if st, err := os.Stat(out); err != nil || st.Size() == 0 {
+		return "", false
+	}
+	return cheevos.HashFile(console, out)
+}
+
+// sevenZipExe is resolved once from PATH. Absent = .7z dumps report unhashable rather than pretending;
+// the caller counts those separately, which is how the PS1 set (2,956 .7z archives) surfaced at all.
+var sevenZipExe = func() string {
+	for _, n := range []string{"7z", "7za", "7zr"} {
+		if p, err := exec.LookPath(n); err == nil {
+			return p
+		}
+	}
+	return ""
+}()
+
+// discExts are the members worth hashing inside a disc archive, best first. A .cue is preferred over the
+// .bin it references: rc_hash reads the track layout to find the executable it actually fingerprints.
+var discExts = []string{".m3u", ".cue", ".chd", ".iso", ".ccd", ".gdi", ".bin"}
+
+func hashFrom7z(console uint32, path string) (string, bool) {
+	if sevenZipExe == "" {
+		return "", false
+	}
+	dir, err := os.MkdirTemp("", "rahash7z")
+	if err != nil {
+		return "", false
+	}
+	defer os.RemoveAll(dir)
+
+	// `e` (not `x`) flattens the archive: disc sets reference their tracks by bare filename, so a nested
+	// layout would leave a .cue pointing at tracks it cannot find.
+	cmd := exec.Command(sevenZipExe, "e", "-y", "-bso0", "-bse0", "-o"+dir, path)
+	if err := cmd.Run(); err != nil {
+		return "", false
+	}
+	entries, err := os.ReadDir(dir)
+	if err != nil || len(entries) == 0 {
+		return "", false
+	}
+
+	// Pick by extension preference; fall back to the largest file so an unusual layout still hashes.
+	best, bestRank, bestSize := "", len(discExts)+len(romExts)+1, int64(-1)
+	for _, e := range entries {
+		if e.IsDir() {
+			continue
+		}
+		name := filepath.Join(dir, e.Name())
+		ext := strings.ToLower(filepath.Ext(e.Name()))
+		rank := len(discExts) + 1
+		for i, d := range discExts {
+			if ext == d {
+				rank = i
+				break
+			}
+		}
+		if rank > len(discExts) && romExts[ext] {
+			rank = len(discExts)
+		}
+		info, err := e.Info()
+		size := int64(0)
+		if err == nil {
+			size = info.Size()
+		}
+		if rank < bestRank || (rank == bestRank && size > bestSize) {
+			best, bestRank, bestSize = name, rank, size
+		}
+	}
+	if best == "" {
+		return "", false
+	}
+	return cheevos.HashFile(console, best)
+}
+
+// romExts are the members worth preferring inside a console ROM archive. Anything else in there is
+// usually a scan, a text file, or a save.
+var romExts = map[string]bool{
+	".nes": true, ".fds": true, ".unf": true, ".unif": true,
+	".sfc": true, ".smc": true, ".swc": true, ".fig": true,
+	".gb": true, ".gbc": true, ".gba": true, ".sgb": true,
+	".md": true, ".gen": true, ".smd": true, ".bin": true, ".sms": true, ".gg": true, ".sg": true,
+	".pce": true, ".sgx": true, ".n64": true, ".z64": true, ".v64": true,
+	".a26": true, ".a78": true, ".lnx": true, ".ngp": true, ".ngc": true, ".ws": true, ".wsc": true,
+	".col": true, ".vb": true, ".vboy": true,
+}
+
+// romFromZip reads the ROM out of a single-ROM console archive. Chooses the one obvious ROM member;
+// with several candidates it takes the LARGEST, which for these archives is the ROM rather than a
+// README or a patch sitting alongside it.
+func romFromZip(path string) ([]byte, error) {
+	zr, err := zip.OpenReader(path)
+	if err != nil {
+		return nil, err
+	}
+	defer zr.Close()
+
+	var best *zip.File
+	bestScore := -1
+	for _, f := range zr.File {
+		if f.FileInfo().IsDir() {
+			continue
+		}
+		// Prefer a known ROM extension; fall back to sheer size so an unusual extension still works.
+		score := 0
+		if romExts[strings.ToLower(filepath.Ext(f.Name))] {
+			score = 1
+		}
+		if score > bestScore || (score == bestScore && best != nil && f.UncompressedSize64 > best.UncompressedSize64) {
+			best, bestScore = f, score
+		}
+	}
+	if best == nil {
+		return nil, fmt.Errorf("no file in archive")
+	}
+	rc, err := best.Open()
+	if err != nil {
+		return nil, err
+	}
+	defer rc.Close()
+	return io.ReadAll(rc)
+}
