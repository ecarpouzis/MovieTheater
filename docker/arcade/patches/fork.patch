+func (n *Nanoarch) LoadGame(path string) error {
+	game := C.struct_retro_game_info{}
+
+	big := bool(n.sys.i.need_fullpath) // big ROMs are loaded by cores later
+	if big {
+		size, err := os.StatSize(path)
+		if err != nil {
+			return err
+		}
+		game.size = C.size_t(size)
+	} else {
+		bytes, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		// !to pin in 1.21
+		ptr := unsafe.Pointer(C.CBytes(bytes))
+		game.data = ptr
+		game.size = C.size_t(len(bytes))
+		defer C.free(ptr)
+	}
+	fp := C.CString(path)
+	defer C.free(unsafe.Pointer(fp))
+	game.path = fp
+
+	n.log.Debug().Msgf("ROM - big: %v, size: %v", big, byteCountBinary(int64(game.size)))
+
+	romName := strings.TrimSuffix(filepath.Base(path), filepath.Ext(path))
+
+	// maybe some custom options (static per-ROM overrides from config.yaml)
+	if n.options4rom != nil {
+		if _, ok := n.options4rom[romName]; ok {
+			for k, v := range n.options4rom[romName] {
+				n.options[k] = v
+				n.log.Debug().Msgf("Replace: %v=%v", k, v)
+			}
+		}
+	}
+
+	// Arcade per-game config manifest (game-overrides.json, DB-driven via arcade-gameconfig-export).
+	// Core-option overrides here win over config; the forced-fps field is applied after av-info below.
+	override, hasOverride := gameOverrides()[romName]
+	if hasOverride {
+		for k, v := range override.Options {
+			n.options[k] = v
+			n.log.Info().Msgf("[game-override] option %v=%v for %q", k, v, romName)
+		}
+	}
+
+	// Per-room cheats, part 1: core-option cheats (arcade cheats feature). LAST writer wins on purpose —
+	// this is one player's explicit choice for one room, so it outranks the static config and the per-game
+	// manifest. The core reads these while loading, so they must land before retro_load_game.
+	for k, v := range n.roomOptions {
+		n.options[k] = v
+		n.log.Info().Msgf("[room-cheat] option %v=%v", k, v)
+	}
+
+	if ok := C.bridge_retro_load_game(retroLoadGame, &game); !ok {
+		return fmt.Errorf("core failed to load ROM: %v", path)
+	}
+
+	// Per-room cheats, part 2: cheat codes, which are only meaningful once the game is loaded (they poke
+	// its memory).
+	//
+	// retro_cheat_reset runs UNCONDITIONALLY. Nanoarch is a process-wide singleton (Nan0) and a worker
+	// serves one room after another, so "only reset when this room has cheats" would let the previous
+	// room's codes survive into a room that asked for none. RetroArch resets on every content load too.
+	//
+	// Every core EXPORTS retro_cheat_set — a good number implement it as an empty stub, and then a code is
+	// accepted and does nothing. There is no way to detect that from here, which is why the site only
+	// offers codes on the systems ArcadeCheatCatalog.SupportsCheatCodes allowlists.
+	C.bridge_retro_cheat_reset(retroCheatReset)
+	applied := 0
+	for _, code := range n.cheats {
+		if code == "" {
+			continue
+		}
+		cs := C.CString(code)
+		C.bridge_retro_cheat_set(retroCheatSet, C.unsigned(applied), C.bool(true), cs)
+		C.free(unsafe.Pointer(cs))
+		applied++
+	}
+	if applied > 0 {
+		n.log.Info().Msgf("[room-cheat] applied %d cheat code(s)", applied)
+	}
+	// Staged per-room state is consumed here. Clearing it means a later load on this singleton — a disc
+	// swap, a core reload — can't silently re-apply a previous room's cheats.
+	n.roomOptions, n.cheats = nil, nil
+
+	var av C.struct_retro_system_av_info
+	C.bridge_retro_get_system_av_info(retroGetSystemAVInfo, &av)
+	n.log.Info().Msgf("System A/V >>> %vx%v (%vx%v), [%vfps], AR [%v], audio [%vHz]",
+		av.geometry.base_width, av.geometry.base_height,
+		av.geometry.max_width, av.geometry.max_height,
+		av.timing.fps, av.geometry.aspect_ratio, av.timing.sample_rate,
+	)
+	if isGeometryDifferent(av.geometry) {
+		geometryChange(av.geometry)
+	}
+	n.sys.av = av
+
+	// Per-ROM forced framerate (arcade per-game config). Some cores advertise the DISPLAY refresh
+	// (e.g. flycast reports 59.94 for Dreamcast) while the GAME's engine is hardcoded to a lower rate
+	// with physics tied to it — Sonic Adventure is locked to 30fps, so pacing retro_run at 59.94Hz runs
+	// it at DOUBLE SPEED. Overriding the stored timing here makes tickTime, VideoFramerate() and the
+	// frontend pacing loop all target the game's true rate. Only listed games are affected; genuine
+	// 60fps titles are untouched (no global slowdown). Source: manifest wins, config fps4rom is fallback.
+	forcedFps := 0.0
+	if hasOverride && override.Fps > 0 {
+		forcedFps = override.Fps
+	} else if n.fps4rom != nil {
+		forcedFps = n.fps4rom[romName]
+	}
+	if forcedFps > 0 {
+		n.log.Info().Msgf("[game-override] forcing %.3f fps for %q (core advertised %.3f)", forcedFps, romName, float64(n.sys.av.timing.fps))
+		n.sys.av.timing.fps = C.double(forcedFps)
+	}
+
+	if !n.hackSkipSerializeSizeProbe {
+		n.serializeSize = C.bridge_retro_serialize_size(retroSerializeSize)
+		n.log.Info().Msgf("Save file size: %v", byteCountBinary(int64(n.serializeSize)))
+	} else {
+		n.serializeSize = 0 // informational only; SaveGameState re-queries fresh (see hack note above)
+		n.log.Info().Msgf("Save file size: probe skipped (skip_serialize_size_probe)")
+	}
+
+	Nan0.tickTime = time.Duration(float64(time.Second) / float64(n.sys.av.timing.fps))
+	if n.vfr {
+		n.log.Info().Msgf("variable framerate (VFR) is enabled")
+	}
+
+	n.Stopped.Store(false)
+
+	if n.Video.gl.enabled {
+		if n.LibCo {
+			C.same_thread(C.init_video_cgo)
+			C.same_thread(unsafe.Pointer(Nan0.Video.hw.context_reset))
+		} else {
+			runtime.LockOSThread()
+			initVideo()
+			C.bridge_context_reset(Nan0.Video.hw.context_reset)
+			runtime.UnlockOSThread()
+		}
+	}
+
+	// set default controller types on all ports
+	// needed for nestopia
+	for i := range maxPort {
+		C.bridge_retro_set_controller_port_device(retroSetControllerPortDevice, C.uint(i), C.RETRO_DEVICE_JOYPAD)
+	}
+
+	// map custom devices to ports
+	for k, v := range n.meta.Hid {
+		for _, device := range v {
+			C.bridge_retro_set_controller_port_device(retroSetControllerPortDevice, C.uint(k), C.unsigned(device))
+			n.log.Debug().Msgf("set custom port-device: %v:%v", k, device)
+		}
+	}
+
+	n.LastFrameTime = time.Now()
+
+	return nil
+}
+
+func (n *Nanoarch) Shutdown() {
+	Nan0.audioBuffCb = nil
+	if n.LibCo {
+		thread.Main(func() {
+			C.same_thread(retroUnloadGame)
+			C.same_thread(retroDeinit)
+			if n.Video.gl.enabled {
+				C.same_thread(C.deinit_video_cgo)
+			}
+			C.same_thread(C.same_thread_stop)
+		})
+	} else {
+		if n.Video.gl.enabled {
+			thread.Main(func() {
+				// running inside a go routine, lock the thread to make sure the OpenGL context stays current
+				runtime.LockOSThread()
+				if err := n.glCtx.BindContext(); err != nil {
+					n.log.Error().Err(err).Msg("ctx switch fail")
+				}
+			})
+		}
+		C.bridge_call(retroUnloadGame)
+		C.bridge_call(retroDeinit)
+		if n.Video.gl.enabled {
+			thread.Main(func() {
+				deinitVideo()
+				runtime.UnlockOSThread()
+			})
+		}
+	}
+
+	setRotation(0)
+	Nan0.sys.av = C.struct_retro_system_av_info{}
+	if err := coreLib.close(); err != nil {
+		n.log.Error().Err(err).Msg("lib close failed")
+	}
+	n.options = nil
+	n.options4rom = nil
+	Nan0.audioBuffCb = nil
+	C.free(unsafe.Pointer(n.cUserName))
+	C.free(unsafe.Pointer(n.cSaveDirectory))
+	C.free(unsafe.Pointer(n.cSystemDirectory))
+}
+
+func (n *Nanoarch) Reset() {
+	C.bridge_call(retroReset)
+}
+
+func (n *Nanoarch) syncInputToCache() {
+	n.retropad.SyncToCache()
+	if n.keyboardCb != nil {
+		n.keyboard.SyncToCache()
+	}
+	n.mouse.SyncToCache()
+}
+
+func (n *Nanoarch) Run() {
+	// patch 0005: apply a queued multi-disc swap on the emulator thread, before the core steps. (Disc-based
+	// cores — pcsx/Sega CD/Saturn — are non-LibCo, so this runs on the same thread as the retro_run below.)
+	if d := n.pendingDisk.Swap(0); d > 0 {
+		if !bool(C.nano_disk_set_index(C.uint(d - 1))) {
+			n.log.Warn().Msgf("disk swap to index %d failed (no disk control or bad index)", d-1)
+		}
+	}
+	n.syncInputToCache()
+
+	if n.LibCo {
+		C.same_thread(retroRun)
+	} else {
+		if n.Video.gl.enabled {
+			runtime.LockOSThread()
+			if err := n.glCtx.BindContext(); err != nil {
+				n.log.Error().Err(err).Msg("ctx bind fail")
+			}
+		}
+		C.bridge_call(retroRun)
+		if n.Video.gl.enabled {
+			runtime.UnlockOSThread()
+		}
+	}
+}
+
+func (n *Nanoarch) IsSupported() error                  { return graphics.RGFWTryInit() }
