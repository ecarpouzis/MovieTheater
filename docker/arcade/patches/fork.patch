+	for i, f := range fields {
+		if strings.HasPrefix(f, key+"=") {
+			fields[i] = key + "=" + val
+			found = true
+			break
+		}
+	}
+	if !found {
+		if !addIfMissing {
+			return params
+		}
+		fields = append(fields, key+"="+val)
+	}
+	return strings.Join(fields, " ")
+}
+
+// VideoBitrateKbps reads the ACTIVE video codec's configured `bitrate=` (kbit/s), or 0 when it has
+// none. Used as the ABR ceiling for rooms whose creator didn't pick a quality. vpx names its property
+// `target-bitrate` and measures bit/s, so it deliberately reports 0 here rather than a wrong number.
+func (e Encoder) VideoBitrateKbps() int {
+	cs, ok := e.List[strings.ToLower(e.Video.Codec)]
+	if !ok {
+		return 0
+	}
+	for _, f := range strings.Fields(cs.Params) {
+		if v, found := strings.CutPrefix(f, "bitrate="); found {
+			if n, err := strconv.Atoi(v); err == nil && n > 0 {
+				return n
+			}
+		}
+	}
+	return 0
+}
