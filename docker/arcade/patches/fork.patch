+// Start begins the video+audio pipelines, the re-push ticker, and the heartbeat. Idempotent.
+func (a *App) Start() {
+	a.mu.Lock()
+	if a.started {
+		a.mu.Unlock()
+		return
+	}
+	a.started = true
+	a.mu.Unlock()
+
+	a.stopRepush = make(chan struct{})
+	a.setCapturing(true) // let this room's frames through
+	if a.windowMode() {
+		// Window mode: the ArcadeCaptureHost helper is already capturing the off-screen game window
+		// (armed in LoadApp). v2 (winZC): the helper shares GPU textures, the worker GPU-copies them
+		// into nvautogpu*enc — no readback, no re-upload. v1: BGRA pixels arrive over the shm ring and
+		// feed the SAME design-A appsrc ingest. Either way the re-push ticker covers a static screen.
+		if a.conf.ZeroCopy {
+			a.log.Info().Msg("capture: monitor zeroCopy is ignored in window mode (see windowZeroCopy)")
+		}
+		if a.winZC {
+			go a.d3d11ReadLoop()
+			go a.repushLoopD3D11()
+			a.log.Info().Msg("capture: video WINDOW mode v2 (D3D11 shared textures → nvautogpu, no readback)")
+		} else {
+			go a.shmReadLoop()
+			go a.repushLoop()
+			a.log.Info().Msg("capture: video WINDOW mode v1 (WGC helper → shm → appsrc, no readback of the desktop)")
+		}
+	} else if a.conf.ZeroCopy {
+		// P4: the capture element lives in the MEDIA pipeline (already PLAYING), so there is no
+		// pipeline to build here — and no re-push ticker either: with the framerate on the source
+		// caps the capture element paces itself over a static screen, which is the only thing the
+		// ticker existed to cover.
+		a.log.Info().Msgf("capture: video ZERO-COPY (%s → NVENC, no readback)", a.videoSource())
+	} else if err := a.startVideoPipeline(); err != nil {
+		a.log.Error().Err(err).Msg("capture: video pipeline failed to start")
+	} else {
+		go a.repushLoop()
+	}
+	if err := a.startAudioPipeline(a.gamePid); err != nil {
+		a.log.Warn().Err(err).Msg("capture: audio pipeline failed to start")
+	}
+	go a.heartbeat()
+}
+
+// Close tears everything down. Idempotent, must finish well under 10 s (media-teardown watchdog).
+// Runs on the coordinator's clean-failure path too (LoadApp error → r.Close()) — BEFORE Start() on
+// a failed start — so every step tolerates "never started".
+func (a *App) Close() {
+	a.mu.Lock()
+	if a.closed {
+		a.mu.Unlock()
+		return
+	}
+	a.closed = true
+	prepared := a.prepared
+	a.mu.Unlock()
+
+	a.stopPipelines() // nil-guards stopRepush when Start() never ran (W1); kills the helper (window mode)
+	// v2: release the media pipe's D3D11 device + pool + the helper's shared textures AFTER the helper
+	// is dead and the read loops are signaled to stop. Held under d11Mu so it can't overlap an in-flight
+	// push; once deinited the C push funcs no-op (they nil-guard the device/pool), so a late read-loop
+	// push is harmless. Must run whenever we opened the sink, even on a failed start (guarded inside).
+	if a.d11Sink != nil {
+		a.d11Mu.Lock()
+		a.d11Sink.DeinitD3D11ZeroCopy()
+		a.d11Mu.Unlock()
+	}
+	if a.proc != nil {
+		a.proc.kill()
+	}
+	// Remove the room's hidden virtual display AFTER capture is torn down and the game is dead
+	// (capturing a just-removed monitor would error). No-op unless one was created.
+	a.closeRoomDisplay()
+	if a.swappedExe != "" {
+		a.restoreInputProfile(a.swappedExe)
+	}
+	if a.pads != nil {
+		a.pads.removeTargets()
+	}
+	a.frameMu.Lock()
+	a.lastFrame = nil // free the ~8 MB frame buffer (W7)
+	a.frameMu.Unlock()
+	// Only release the heavy lock if WE acquired it. On a prepare 409 the lock is held by ANOTHER
+	// session (possibly an Artemis session of the SAME title — HeavyLock.Release keys on appId only),
+	// so an unconditional gwFinish here would release + harvest that session mid-play (W1).
+	if prepared {
+		a.gwFinish(a.heavyAppId)
+	}
+}
+
+// ── Lifecycle (called from the coordinator branch) ─────────────────────────────────────────────
+
+// resetForRoom clears all per-room state so a SECOND room on this long-lived worker process starts
+// clean (W2 — the mod is a process-lifetime singleton; workers serve sequential rooms without
+// restarting). The libretro app gets the equivalent via ReloadFrontend(); the capture mod does it here.
+func (a *App) resetForRoom() {
+	a.mu.Lock()
+	a.started = false
+	a.closed = false
+	a.prepared = false
+	a.gamePid = 0
+	a.mu.Unlock()
+	a.proc = nil
+	a.swappedExe = ""
+	a.heavyAppId = ""
+	a.roomId = ""
+	a.ownerUserId = 0
+	a.stopRepush = nil
+	// window-mode per-room state (handles are already released by stopWindowCapture in Close)
+	atomic.StoreUintptr(&a.winHwnd, 0)
+	a.winStop = nil
+	a.helper = nil
+	a.helperStdin = nil
+	a.shm = 0
+	a.shmAddr = 0
+	a.shmEvent = 0
+	// window zero-copy (v2) per-room state — the shared textures/device are released in Close via the
+	// sink; d11Sink itself is wired per-room BEFORE LoadApp (don't clear it here).
+	a.winZC = false
+	a.texLuid = 0
+	a.helperPid = 0
+	a.texHandles = nil
+	atomic.StoreInt32(&a.lastSlot, 0)
+	a.d11Black.Store(false)
+	a.frameMu.Lock()
+	a.lastFrame = nil
+	a.lastStride = 0
+	a.frames = 0
+	a.frameMu.Unlock()
+}
+
+// LoadApp runs prepare -> profile swap -> pad0 -> launch -> attach, and arms the exit watcher.
+// Returns an error (fails the room start) on a gateway 409 or a launch failure.
+func (a *App) LoadApp(heavyAppId, roomId string) error {
+	a.resetForRoom() // this mod is a process-lifetime singleton serving sequential rooms (W2)
+	// Isolation gate: when a hidden virtual display is configured but the worker is NOT on the console
+	// session (i.e. someone is RDP'd into the box), SudoVDA can't attach a hidden display and we refuse to
+	// fall back to capturing the owner's live desktop. Fail the room cleanly instead of splattering the game
+	// across the owner's screen. (Isolated capture while the owner is on RDP needs WGC window capture.)
+	if !a.windowMode() && a.conf.VirtualDisplay && !isOnConsole() {
+		return fmt.Errorf("capture lane needs the console session for isolation, but the worker is in a remote/RDP session where a hidden display can't attach — start capture rooms when not RDP'd into the box (isolated capture over RDP is planned via window capture)")
+	}
+	// Window mode: if the owner's RDP session is DISCONNECTED, reattach it to the physical console
+	// BEFORE launching the game — so the game window is created on the real high-refresh displays and
+	// capture runs at 60fps instead of the stalled/32Hz disconnected-DWM rate. No-op unless window
+	// mode + disconnected + enabled; never disrupts an Active (attached) session.
+	a.maybeReattachConsole()
+	a.roomId = roomId
+	a.heavyAppId = heavyAppId
+	if uid, _, _, system, gameKey, ok := parseRoomId(roomId); ok {
+		if system == System && (gameKey == heavyAppId || heavyAppId == "") {
+			a.ownerUserId = uid
+			a.heavyAppId = gameKey
+		} else {
+			a.log.Warn().Msgf("capture: room id gameKey/system mismatch (system=%s key=%s app=%s) — proceeding without owner", system, gameKey, heavyAppId)
+		}
+	} else {
+		a.log.Warn().Msgf("capture: room id %q not a minted sv- id — proceeding with ownerUserId=0", roomId)
+	}
+
+	prep, err := a.gwPrepare(a.heavyAppId)
+	if err != nil {
+		return err // 409/decode error → prepared stays false → Close won't touch the lock (W1)
+	}
+	a.mu.Lock()
+	a.prepared = true // we now hold the heavy lock; Close() must gwFinish to release it
+	a.mu.Unlock()
+	a.log.Info().Msgf("capture: prepare ok exe=%s args=%s", prep.Exe, prep.Args)
+
+	a.swappedExe = a.applyStreamedInputProfile(prep.Exe)
+	a.pads.ensurePad(0) // yuzu binds Player 1 at boot
+
+	if v, derr := setDpiCompatLayer(prep.Exe); derr != nil {
+		a.log.Warn().Err(derr).Msg("capture: DPI compat layer not set (window may be DPI-virtualized on scaled displays)")
+	} else {
+		a.log.Info().Msgf("capture: DPI compat layer %q for %s", v, filepath.Base(prep.Exe))
+	}
+
+	proc, err := launchGame(prep.Exe, prep.Args, prep.WorkingDir)
+	if err != nil {
+		a.restoreInputProfile(prep.Exe)
+		return err
+	}
+	a.proc = proc
+	a.mu.Lock()
+	a.gamePid = proc.pid
+	a.mu.Unlock()
+	a.log.Info().Msgf("capture: launched pid %d", proc.pid)
+
+	a.gwAttach(a.heavyAppId, proc.pid)
+	if a.windowMode() {
+		// Park the window OFF-SCREEN (never focused — the owner keeps working) and start the WGC helper
+		// against its HWND. placeOffScreen discovers the window and stores a.winHwnd; we wait for it, then
+		// arm the helper + shm reader. The minimize guard runs for the room's life.
+		a.winStop = make(chan struct{})
+		go a.placeOffScreen(proc.pid)
+		go a.windowGuardLoop()
+		if hwnd := a.awaitWinHwnd(15 * time.Second); hwnd != 0 {
+			if err := a.startWindowCapture(hwnd); err != nil {
+				a.log.Error().Err(err).Msg("capture(window): helper/shm setup failed — video will be black this room")
+			}
+		} else {
+			// Not fatal any more: placeOffScreen keeps hunting for the room's life, so a title that
+			// simply boots slowly (shader warm-up, a long first load) recovers instead of being black
+			// forever. Attach off the main path the moment the window shows up.
+			a.log.Warn().Msg("capture(window): no game window yet after 15s — still hunting; video is black until it appears")
+			go func() {
+				if hwnd := a.awaitWinHwndUntil(a.winStop, 3*time.Minute); hwnd != 0 {
+					a.log.Info().Msgf("capture(window): game window %#x appeared late — attaching now", hwnd)
+					if err := a.startWindowCapture(hwnd); err != nil {
+						a.log.Error().Err(err).Msg("capture(window): late helper/shm setup failed — video stays black this room")
+					}
+				} else {
+					a.log.Warn().Msg("capture(window): game window never appeared — video was black this room")
+				}
+			}()
+		}
+	} else {
+		go a.focusPid(proc.pid) // monitor mode: foreground (or place on the vdisplay) the game
+	}
+	a.routeAudioToSink(proc.pid)
+	go a.exitWatcher(proc, a.heavyAppId, a.swappedExe)
+	return nil
+}
+
+// awaitWinHwndUntil is awaitWinHwnd for the SLOW path: it keeps waiting for a window that hasn't
+// shown up yet, giving up only when the room ends (stop) or `limit` elapses — so a late-booting title
+// still gets captured instead of being black for the whole room.
+func (a *App) awaitWinHwndUntil(stop <-chan struct{}, limit time.Duration) uintptr {
+	deadline := time.Now().Add(limit)
+	for time.Now().Before(deadline) {
+		if h := atomic.LoadUintptr(&a.winHwnd); h != 0 {
+			return h
+		}
+		select {
+		case <-stop:
+			return atomic.LoadUintptr(&a.winHwnd)
+		case <-time.After(200 * time.Millisecond):
+		}
+	}
+	return atomic.LoadUintptr(&a.winHwnd)
+}
+
+// awaitWinHwnd blocks until placeOffScreen has discovered the game window (or the timeout elapses).
+func (a *App) awaitWinHwnd(d time.Duration) uintptr {
+	deadline := time.Now().Add(d)
+	for time.Now().Before(deadline) {
+		if h := atomic.LoadUintptr(&a.winHwnd); h != 0 {
+			return h
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+	return atomic.LoadUintptr(&a.winHwnd)
+}
+
+// routeAudioToSink moves ONLY this game's audio (by PID) to the configured virtual sink (VB-CABLE)
+// so it doesn't play on the host speakers; we then capture from that sink. By-PID routing is
+// session-scoped — it reverts the instant the game exits, and never touches the host's own audio.
+// Re-asserted a few times because the emulator opens its audio session a couple seconds into boot.
+func (a *App) routeAudioToSink(pid int) {
+	if a.conf.AudioSink == "" || a.conf.SoundVolumeView == "" {
+		return
+	}
+	if _, err := os.Stat(a.conf.SoundVolumeView); err != nil {
+		a.log.Warn().Msgf("capture: SoundVolumeView not at %s — game audio stays on the host speakers", a.conf.SoundVolumeView)
+		return
+	}
+	// W5: poll TIGHTLY (every 250 ms for ~12 s) instead of a few sparse retries. /SetAppDefault only
+	// moves a session that already EXISTS, and the emulator opens its audio session some seconds into
+	// boot (after shader compile), so the sparse version left ~5 s of the game blasting the HOST
+	// speakers. Tight polling catches the session within ~250 ms of it opening (per-PID = still
+	// session-scoped; a stale/closed room bails). Re-routing an already-routed session is a harmless
+	// no-op, so we keep asserting through the boot window without needing to detect "done".
+	go func() {
+		routed := false
+		deadline := time.Now().Add(12 * time.Second)
+		for time.Now().Before(deadline) {
+			a.mu.Lock()
+			stale := a.closed || a.gamePid != pid // don't route a PREVIOUS room's pid into the next room
+			a.mu.Unlock()
+			if stale {
+				return
+			}
+			if err := exec.Command(a.conf.SoundVolumeView, "/SetAppDefault", a.conf.AudioSink, "all", strconv.Itoa(pid)).Run(); err != nil {
+				a.log.Warn().Err(err).Msg("capture: audio route to virtual sink failed")
+			} else if !routed {
+				routed = true
+				a.log.Info().Msgf("capture: routing pid %d audio -> %s (off the host speakers)", pid, a.conf.AudioSink)
+			}
+			time.Sleep(250 * time.Millisecond)
+		}
+	}()
+}
+
+// exitWatcher blanks the stream and finishes the session if the game dies while the room is open
+// (privacy: never stream the bare desktop). It captures ITS room's proc/appId/exe as params — never
+// the shared fields, which the NEXT room overwrites — and bails if a newer room already owns the
+// worker (a.gamePid moved on / closed). Without this guard, room 1's watcher fired after room 2's
+// resetForRoom cleared `closed` and blanked room 2 (froze its video). finish is re-entrant.
+func (a *App) exitWatcher(proc *gameProc, appId, swappedExe string) {
+	proc.waitExit()
+	a.mu.Lock()
+	stale := a.closed || a.gamePid != proc.pid
+	a.mu.Unlock()
+	if stale {
+		return
+	}
+	a.log.Warn().Msg("capture: game exited while room open — blanking + finishing")
+	// Stop pushing live-desktop frames FIRST (privacy — trap #12), THEN pin a black frame the re-push
+	// ticker holds. Order matters: if we blanked first, an in-flight appsink frame would overwrite it.
+	a.stopVideoOnly()
+	a.pushBlackFrames()
+	a.restoreInputProfile(swappedExe)
+	a.gwFinish(appId)
+}
+
+// pushBlackFrames pins a black frame so viewers see black, not the desktop (game-exit privacy).
+func (a *App) pushBlackFrames() {
+	if a.winZC && a.d11Sink != nil {
+		a.d11PushBlack() // v2: a cleared pool buffer; the re-push ticker keeps it pinned
+		return
+	}
+	a.frameMu.Lock()
+	n := a.width() * a.height() * 4
+	if cap(a.lastFrame) < n {
+		a.lastFrame = make([]byte, n)
+	}
+	a.lastFrame = a.lastFrame[:n]
+	for i := range a.lastFrame {
+		a.lastFrame[i] = 0
+	}
+	a.lastStride = a.width() * 4
+	a.lastDur = time.Second / time.Duration(a.fps())
+	a.pushLocked()
+	a.frameMu.Unlock()
+}
+
+// heartbeat emits a 5 s "capture tick" so the GL-worker watchdog's check C doesn't read a busy
+// room with a silent log as a wedge (plan §4.6).
+func (a *App) heartbeat() {
+	t := time.NewTicker(5 * time.Second)
+	defer t.Stop()
+	for {
+		select {
+		case <-a.stopRepush:
+			return
+		case <-t.C:
+			a.mu.Lock()
+			closed := a.closed
+			a.mu.Unlock()
+			if closed {
+				return
+			}
+			a.frameMu.Lock()
+			f := a.frames
+			a.frameMu.Unlock()
+			a.log.Info().Msgf("capture tick: frames=%d raw=%d capturing=%v pads=%d inpkts=%d", f, atomic.LoadUint64(&a.rawFrames), a.capturing.Load(), a.pads.count(), a.pads.packetCount())
+		}
+	}
+}
+
+// parseRoomId ports ArcadeSaveId.TryParse: sv-<userId>-<gameId>-<slotId>-<system>___<gameKey>.
+func parseRoomId(id string) (userId, gameId, slotId int, system, gameKey string, ok bool) {
+	const prefix, sep = "sv-", "___"
+	if !strings.HasPrefix(id, prefix) {
+		return
+	}
+	si := strings.Index(id, sep)
+	if si < 0 {
+		return
+	}
+	gameKey = id[si+len(sep):]
+	parts := strings.SplitN(id[len(prefix):si], "-", 4)
+	if len(parts) != 4 {
+		return
+	}
+	u, e1 := strconv.Atoi(parts[0])
+	g, e2 := strconv.Atoi(parts[1])
+	s, e3 := strconv.Atoi(parts[2])
+	if e1 != nil || e2 != nil || e3 != nil || gameKey == "" || parts[3] == "" {
+		return
+	}
+	return u, g, s, parts[3], gameKey, true
+}
diff --git a/pkg/worker/caged/capture/d3d11window.go b/pkg/worker/caged/capture/d3d11window.go
new file mode 100644
index 0000000..8af80b1
--- /dev/null
+++ b/pkg/worker/caged/capture/d3d11window.go
@@ -0,0 +1,182 @@
+package capture
+
+// Window ZERO-COPY (capture lane v2). In v1 the ArcadeCaptureHost helper reads each WGC frame back to
+// system memory and memcpys it through a shared-memory PIXEL ring; the worker re-uploads it for NVENC.
+// v2 removes that round trip: the helper shares the frame as keyed-mutex D3D11 TEXTURES (published as
+// NT-handle values + its pid + adapter LUID in the ready JSON), the shm ring becomes a slot/seq CONTROL
+// channel, and the media pipe GPU-copies the shared texture into a pooled D3D11 buffer that goes
+// straight into nvautogpu*enc (media/d3d11zerocopy.go). No readback, no re-upload (~9.2 ms → ~3 ms).
+//
+// Transport is NT-handle DUPLICATION, not open-by-name (by-name is process-local on this box — proven
+// 2026-07-23). Any failure at any stage falls back to v1 automatically (see startWindowCapture).
+
+import (
+	"encoding/json"
+	"sync/atomic"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+// d11Sink is the media pipe's D3D11 zero-copy surface (implemented by *media.GstMediaPipe). The
+// coordinator wires it onto the capture app BEFORE LoadApp; the app drives it during startWindowCapture
+// (so the gst device + pool exist before m.Init builds the appsrc-D3D11 pipeline).
+type d11Sink interface {
+	InitD3D11ZeroCopy(luid int64, w, h int) error
+	OpenD3D11Shared(helperPid int, handles []uint64) error
+	PushD3D11Slot(slot, w, h int, durNs uint64)
+	PushD3D11Black(w, h int, durNs uint64)
+	DeinitD3D11ZeroCopy()
+	SetD3D11ZeroCopy(on bool)
+}
+
+// SetD3D11Sink wires the media pipe's D3D11 hooks. Called by the coordinator's capture branch before
+// LoadApp; nil (retro/monitor rooms, or an un-wired build) keeps window capture on v1.
+func (a *App) SetD3D11Sink(s d11Sink) { a.d11Sink = s }
+
+// windowZeroCopyEnabled reports the config knob (default TRUE — *bool nil means the key was absent;
+// project policy: quality levers default ON with opt-out).
+func (a *App) windowZeroCopyEnabled() bool {
+	return a.conf.WindowZeroCopy == nil || *a.conf.WindowZeroCopy
+}
+
+// readyInfo is the helper's `ready` status line. The texShare fields are present only when the helper
+// was asked for --texshare AND created the shared textures; absence ⇒ the worker runs v1.
+type readyInfo struct {
+	Event      string   `json:"event"`
+	Width      int      `json:"width"`
+	Height     int      `json:"height"`
+	Fps        int      `json:"fps"`
+	TexShare   bool     `json:"texShare"`
+	TexCount   int      `json:"texCount"`
+	Luid       int64    `json:"luid"`
+	Pid        int      `json:"pid"`
+	TexHandles []uint64 `json:"texHandles"`
+}
+
+// parseReady parses a helper `ready` JSON line; nil on malformed input (caller falls back to v1).
+func parseReady(line string) *readyInfo {
+	var ri readyInfo
+	if err := json.Unmarshal([]byte(line), &ri); err != nil {
+		return nil
+	}
+	return &ri
+}
+
+// armWindowZeroCopy opens the helper's shared textures on the media pipe's gst d3d11 device and flips
+// the pipe into D3D11 appsrc mode. Returns false on any failure (caller respawns the helper in v1).
+func (a *App) armWindowZeroCopy(ri *readyInfo) bool {
+	if ri == nil || len(ri.TexHandles) == 0 || ri.Pid == 0 {
+		a.log.Warn().Msg("capture(window): texShare advertised but pid/handles missing — v1 fallback")
+		return false
+	}
+	if err := a.d11Sink.InitD3D11ZeroCopy(ri.Luid, a.width(), a.height()); err != nil {
+		a.log.Error().Err(err).Msg("capture(window): d3d11 device/pool init failed")
+		return false
+	}
+	if err := a.d11Sink.OpenD3D11Shared(ri.Pid, ri.TexHandles); err != nil {
+		a.log.Error().Err(err).Msg("capture(window): opening helper shared textures failed")
+		return false
+	}
+	a.texLuid = ri.Luid
+	a.helperPid = ri.Pid
+	a.texHandles = ri.TexHandles
+	a.winZC = true
+	a.d11Sink.SetD3D11ZeroCopy(true) // media builds the appsrc-D3D11 → nvautogpu pipeline at m.Init
+	return true
+}
+
+func (a *App) d11DurNs() uint64 { return uint64(time.Second / time.Duration(a.fps())) }
+
+// d11PushSlot copies shared texture[slot] into a pool buffer and pushes it (serialized under d11Mu so
+// the media pipe's forced-keyframe counters stay single-threaded across the read loop and re-push).
+func (a *App) d11PushSlot(slot int) {
+	a.d11Mu.Lock()
+	a.d11Black.Store(false)
+	atomic.StoreInt32(&a.lastSlot, int32(slot))
+	a.d11LastPush = time.Now()
+	a.d11Sink.PushD3D11Slot(slot, a.width(), a.height(), a.d11DurNs())
+	a.d11Mu.Unlock()
+	a.frameMu.Lock()
+	a.frames++ // heartbeat counter (same lock v1 uses, so the tick read stays consistent)
+	a.frameMu.Unlock()
+}
+
+// d11PushBlack pins a cleared pool buffer (game-exit privacy). The re-push ticker keeps it up.
+func (a *App) d11PushBlack() {
+	a.d11Mu.Lock()
+	a.d11Black.Store(true)
+	a.d11LastPush = time.Now()
+	a.d11Sink.PushD3D11Black(a.width(), a.height(), a.d11DurNs())
+	a.d11Mu.Unlock()
+}
+
+// d3d11ReadLoop is the v2 frame source: it waits on the helper's frame event, reads the published slot
+// index from the shm CONTROL header (no pixels), and pushes that shared-texture slot into the encoder.
+// Dropped intermediate frames are fine (live stream); a static screen is covered by repushLoopD3D11.
+func (a *App) d3d11ReadLoop() {
+	base := a.shmAddr
+	if base == 0 {
+		a.log.Error().Msg("capture(window): d3d11ReadLoop with no control mapping — no video")
+		return
+	}
+	var lastSeq uint64
+	for {
+		select {
+		case <-a.winStop:
+			return
+		default:
+		}
+		if a.shmEvent != 0 {
+			windows.WaitForSingleObject(a.shmEvent, 500)
+		} else {
+			time.Sleep(8 * time.Millisecond)
+		}
+		select {
+		case <-a.winStop:
+			return
+		default:
+		}
+		fseq := ld64(base + offFrameSeq)
+		if fseq == lastSeq {
+			continue // no new frame — repushLoopD3D11 keeps the last one alive
+		}
+		lastSeq = fseq
+		if !a.capturing.Load() {
+			continue // between rooms / after game exit — never push live desktop/game frames
+		}
+		slot := int32(ld32(base + offLatestSlot))
+		if slot < 0 {
+			continue
+		}
+		a.d11PushSlot(int(slot))
+	}
+}
+
+// repushLoopD3D11 re-pushes the last slot (or black) when the helper goes quiet (WGC delivers only on
+// screen change; a static screen would starve the encoder and leave joiners nothing to decode). 2 Hz;
+// re-push only when >500 ms since the last push (matches the v1 ticker).
+func (a *App) repushLoopD3D11() {
+	t := time.NewTicker(250 * time.Millisecond)
+	defer t.Stop()
+	for {
+		select {
+		case <-a.stopRepush:
+			return
+		case <-t.C:
+			a.d11Mu.Lock()
+			idle := time.Since(a.d11LastPush) > 500*time.Millisecond
+			black := a.d11Black.Load()
+			slot := int(atomic.LoadInt32(&a.lastSlot))
+			a.d11Mu.Unlock()
+			if !idle {
+				continue
+			}
+			if black {
+				a.d11PushBlack()
+			} else if a.capturing.Load() {
+				a.d11PushSlot(slot)
+			}
+		}
+	}
+}
diff --git a/pkg/worker/caged/capture/input.go b/pkg/worker/caged/capture/input.go
new file mode 100644
index 0000000..77ef11c
--- /dev/null
+++ b/pkg/worker/caged/capture/input.go
@@ -0,0 +1,203 @@
+package capture
+
+import (
+	"encoding/binary"
+	"fmt"
+	"sync"
+	"sync/atomic"
+
+	vigem "github.com/openstadia/go-vigem"
+	x360 "github.com/openstadia/go-vigem/x360"
+)
+
+// padManager owns the ViGEm client and one virtual Xbox 360 pad per occupied seat. Port 0 is
+// created eagerly in LoadApp (yuzu binds Player 1 at boot); ports 1..maxPads-1 are created lazily
+// on the first packet from that seat. All targets are removed in Close().
+//
+// Tolerant by design: if ViGEm is unavailable (missing vigemclient.dll or bus driver), connect()
+// records the failure and every pad op becomes a no-op so video/audio still stream.
+type padManager struct {
+	mu      sync.Mutex
+	client  *vigem.ClientImpl
+	pads    map[int]*x360.Gamepad
+	maxPads int
+	ok      bool
+	packets uint64 // diag: RetroPad packets applied to a pad (heartbeat shows input is ARRIVING)
+}
+
+func newPadManager(maxPads int) *padManager {
+	if maxPads <= 0 {
+		maxPads = 1
+	}
+	return &padManager{pads: make(map[int]*x360.Gamepad), maxPads: maxPads}
+}
+
+// connect allocates + connects the ViGEm client. Returns an error (never panics out) — the caller
+// logs and continues; pads are simply disabled when this fails.
+func (p *padManager) connect() (err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			err = fmt.Errorf("vigem connect failed: %v", r)
+		}
+	}()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.client = vigem.NewClient() // panics on alloc/connect failure -> recovered above
+	p.ok = true
+	return nil
+}
+
+// Arcade pads carry a distinctive VID/PID (0x1209 = pid.codes open-use vendor space; 0x4D54 = "MT")
+// instead of the stock Xbox 360 identity, so Steam's controller_blacklist can exclude EXACTLY these
+// virtual pads. Why (2026-07-23): Steam running on the box grabs any X360-identified pad with its
+// Steam Input desktop configuration — the game gets NOTHING while Steam's on-screen keyboard types
+// with the player's stick drift. XInput/SDL identify xusb devices by class, not VID/PID, so games
+// still see a normal Xbox 360 controller.
+const (
+	arcadePadVid = 0x1209
+	arcadePadPid = 0x4D54
+)
+
+// ensurePadLocked returns (creating if needed) the pad for a seat, or nil when ViGEm is down or the
+// seat is beyond maxPads. Caller MUST hold p.mu.
+func (p *padManager) ensurePadLocked(port int) *x360.Gamepad {
+	if !p.ok || port < 0 || port >= p.maxPads {
+		return nil
+	}
+	if pad, ok := p.pads[port]; ok {
+		return pad
+	}
+	pad := x360.NewGamepad(p.client)
+	pad.VendorId = arcadePadVid
+	pad.ProductId = arcadePadPid
+	pad.Connect()
+	p.pads[port] = pad
+	return pad
+}
+
+// ensurePad is the locked entry point (used from LoadApp for the eager port-0 pad).
+func (p *padManager) ensurePad(port int) *x360.Gamepad {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.ensurePadLocked(port)
+}
+
+// removeTargets disconnects+releases every pad but KEEPS the ViGEm client connected so the next
+// room on this worker can reuse it. Called from App.Close().
+func (p *padManager) removeTargets() {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	for _, pad := range p.pads {
+		func() {
+			defer func() { _ = recover() }()
+			pad.Disconnect()
+			pad.Release()
+		}()
+	}
+	p.pads = make(map[int]*x360.Gamepad)
+}
+
+// count returns the number of live pads (for the heartbeat log).
+func (p *padManager) count() int {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return len(p.pads)
+}
+
+// packetCount returns how many input packets have been applied (for the heartbeat log).
+func (p *padManager) packetCount() uint64 {
+	return atomic.LoadUint64(&p.packets)
+}
+
+
+// RetroPad button bit -> XUSB button. Index is the RetroPad bit (see the plan's §4.5 table and
+// pkg/worker/caged/libretro/nanoarch/input.go). Bits 12/13 (L2/R2) and analog triggers handled
+// separately below; 0xFFFF sentinel = no direct button.
+var retroPadToXusb = [16]uint16{
+	0:  x360.XUSB_GAMEPAD_A,              // RetroPad B
+	1:  x360.XUSB_GAMEPAD_X,              // RetroPad Y
+	2:  x360.XUSB_GAMEPAD_BACK,           // RetroPad SELECT
+	3:  x360.XUSB_GAMEPAD_START,          // RetroPad START
+	4:  x360.XUSB_GAMEPAD_DPAD_UP,        // RetroPad UP
+	5:  x360.XUSB_GAMEPAD_DPAD_DOWN,      // RetroPad DOWN
+	6:  x360.XUSB_GAMEPAD_DPAD_LEFT,      // RetroPad LEFT
+	7:  x360.XUSB_GAMEPAD_DPAD_RIGHT,     // RetroPad RIGHT
+	8:  x360.XUSB_GAMEPAD_B,              // RetroPad A
+	9:  x360.XUSB_GAMEPAD_Y,              // RetroPad X
+	10: x360.XUSB_GAMEPAD_LEFT_SHOULDER,  // RetroPad L
+	11: x360.XUSB_GAMEPAD_RIGHT_SHOULDER, // RetroPad R
+	12: 0xFFFF,                           // RetroPad L2 -> left trigger
+	13: 0xFFFF,                           // RetroPad R2 -> right trigger
+	14: x360.XUSB_GAMEPAD_LEFT_THUMB,     // RetroPad L3
+	15: x360.XUSB_GAMEPAD_RIGHT_THUMB,    // RetroPad R3
+}
+
+// invertAxis negates a Gamepad-API axis (down-positive) into XInput's up-positive convention,
+// clamping the asymmetric -32768 to avoid int16 overflow when negated.
+func invertAxis(v int16) int16 {
+	if v == -32768 {
+		v = -32767
+	}
+	return -v
+}
+
+// apply parses one RetroPad packet (little-endian: [BTN u16] optionally [LX i16][LY i16][RX i16]
+// [RY i16] optionally [L2 i16][R2 i16]) and writes the full XUSB state onto the seat's pad. The
+// whole body runs under p.mu (W4): the pad ops call into vigemclient.dll on a target that
+// Close→removeTargets can free concurrently, so fetch + use must be atomic. Input is ~60 Hz.
+func (p *padManager) apply(port int, data []byte) {
+	if len(data) < 2 { // buttons-only (2-byte) packets are valid, like libretro (W9)
+		return
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	pad := p.ensurePadLocked(port)
+	if pad == nil {
+		return
+	}
+	atomic.AddUint64(&p.packets, 1)
+	btn := binary.LittleEndian.Uint16(data[0:2])
+	var lx, ly, rx, ry int16
+	if len(data) >= 10 {
+		lx = int16(binary.LittleEndian.Uint16(data[2:4]))
+		ly = int16(binary.LittleEndian.Uint16(data[4:6]))
+		rx = int16(binary.LittleEndian.Uint16(data[6:8]))
+		ry = int16(binary.LittleEndian.Uint16(data[8:10]))
+	}
+
+	pad.Reset()
+	for bit := 0; bit < 16; bit++ {
+		if btn&(1<<uint(bit)) == 0 {
+			continue
+		}
+		if x := retroPadToXusb[bit]; x != 0xFFFF && x != 0 {
+			pad.PressButton(x)
+		}
+	}
+
+	// Triggers: prefer the analog L2/R2 int16 (0..32767 -> 0..255) when present; else digital
+	// from bits 12/13.
+	var lt, rt uint8
+	if len(data) >= 14 {
+		l2 := int16(binary.LittleEndian.Uint16(data[10:12]))
+		r2 := int16(binary.LittleEndian.Uint16(data[12:14]))
+		if l2 > 0 {
+			lt = uint8(l2 >> 7)
+		}
+		if r2 > 0 {
+			rt = uint8(r2 >> 7)
+		}
+	}
+	if btn&(1<<12) != 0 && lt == 0 {
+		lt = 255
+	}
+	if btn&(1<<13) != 0 && rt == 0 {
+		rt = 255
+	}
+	pad.LeftTrigger(lt)
+	pad.RightTrigger(rt)
+
+	pad.LeftJoystick(lx, invertAxis(ly))
+	pad.RightJoystick(rx, invertAxis(ry))
+	pad.Update()
+}
diff --git a/pkg/worker/caged/capture/launch.go b/pkg/worker/caged/capture/launch.go
new file mode 100644
index 0000000..e04ceec
--- /dev/null
+++ b/pkg/worker/caged/capture/launch.go
@@ -0,0 +1,540 @@
+package capture
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+	"golang.org/x/sys/windows/registry"
+)
+
+// ── Gateway heavy contract (reused verbatim from heavy-launch.ps1) ──────────────────────────────
+
+type prepareResp struct {
+	Ok         bool   `json:"ok"`
+	AppId      string `json:"appId"`
+	Exe        string `json:"exe"`
+	Args       string `json:"args"`
+	WorkingDir string `json:"workingDir"`
+	Rom        string `json:"rom"`
+	Error      string `json:"error"`
+}
+
+func (a *App) gwDo(method, path string, body any) (*http.Response, error) {
+	var rdr io.Reader
+	if body != nil {
+		b, _ := json.Marshal(body)
+		rdr = bytes.NewReader(b)
+	}
+	url := strings.TrimRight(a.conf.GatewayUrl, "/") + path
+	req, err := http.NewRequest(method, url, rdr)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("X-Arcade-Internal-Secret", a.secret)
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	return a.http.Do(req)
+}
+
+// gwPrepare takes the heavy lane lock and returns the resolved launch command. A 409 (lane busy or
+// not staged) is surfaced as an error so the room start fails cleanly.
+func (a *App) gwPrepare(appId string) (*prepareResp, error) {
+	path := "/heavy/prepare/" + url.PathEscape(appId) + "?client=capture-room"
+	if a.ownerUserId > 0 {
+		path += fmt.Sprintf("&userId=%d", a.ownerUserId) // gateway skips HeavyClient lookup (P2)
+	}
+	resp, err := a.gwDo("POST", path, nil)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	raw, _ := io.ReadAll(resp.Body)
+	if resp.StatusCode == http.StatusConflict {
+		return nil, fmt.Errorf("heavy lane unavailable (409): %s", strings.TrimSpace(string(raw)))
+	}
+	var pr prepareResp
+	if err := json.Unmarshal(raw, &pr); err != nil {
+		return nil, fmt.Errorf("prepare decode (%d): %s", resp.StatusCode, strings.TrimSpace(string(raw)))
+	}
+	if !pr.Ok {
+		return nil, fmt.Errorf("prepare not ok: %s", pr.Error)
+	}
+	return &pr, nil
+}
+
+func (a *App) gwAttach(appId string, pid int) {
+	resp, err := a.gwDo("POST", "/heavy/attach/"+url.PathEscape(appId), map[string]int{"pid": pid})
+	if err != nil {
+		a.log.Warn().Err(err).Msg("capture: heavy attach failed (lock stays time-based)")
+		return
+	}
+	resp.Body.Close()
+}
+
+func (a *App) gwFinish(appId string) {
+	resp, err := a.gwDo("POST", "/heavy/finish/"+url.PathEscape(appId), nil)
+	if err != nil {
+		a.log.Warn().Err(err).Msg("capture: heavy finish failed")
+		return
+	}
+	resp.Body.Close()
+}
+
+// ── Input profile swap (Go port of heavy-launch.ps1 Apply/Restore-StreamedInputProfile) ─────────
+
+type inputProfile struct {
+	ExeMatch        string `json:"exeMatch"`
+	ConfigFile      string `json:"configFile"`
+	KeyPrefix       string `json:"keyPrefix"`
+	StreamedProfile string `json:"streamedProfile"`
+}
+
+func (a *App) getInputProfile(exePath string) *inputProfile {
+	raw, err := os.ReadFile(a.conf.ProfilesFile)
+	if err != nil {
+		return nil
+	}
+	var all []inputProfile
+	if json.Unmarshal(raw, &all) != nil {
+		return nil
+	}
+	leaf := filepath.Base(exePath)
+	for i := range all {
+		if strings.EqualFold(all[i].ExeMatch, leaf) {
+			return &all[i]
+		}
+	}
+	return nil
+}
+
+func readLines(path string) ([]string, error) {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	s := strings.ReplaceAll(string(raw), "\r\n", "\n")
+	return strings.Split(strings.TrimSuffix(s, "\n"), "\n"), nil
+}
+
+// writeLines writes CRLF-joined, UTF-8 no-BOM (matches the PS UTF8Encoding($false) contract).
+func writeLines(path string, lines []string) error {
+	return os.WriteFile(path, []byte(strings.Join(lines, "\r\n")+"\r\n"), 0644)
+}
+
+// swapConfigLines replaces every <keyPrefix>* line with newLines at the first old line's position.
+func swapConfigLines(configFile, keyPrefix string, newLines []string) error {
+	lines, err := readLines(configFile)
+	if err != nil {
+		return err
+	}
+	kept := make([]string, 0, len(lines))
+	insertAt := -1
+	for _, l := range lines {
+		if strings.HasPrefix(l, keyPrefix) {
+			if insertAt < 0 {
+				insertAt = len(kept)
+			}
+			continue
+		}
+		kept = append(kept, l)
+	}
+	if insertAt < 0 {
+		insertAt = len(kept)
+	}
+	out := make([]string, 0, len(kept)+len(newLines))
+	out = append(out, kept[:insertAt]...)
+	out = append(out, newLines...)
+	out = append(out, kept[insertAt:]...)
+	return writeLines(configFile, out)
+}
+
+func (a *App) restoreInputProfile(exePath string) {
+	p := a.getInputProfile(exePath)
+	if p == nil {
+		return
+	}
+	restore := p.StreamedProfile + ".restore"
+	if _, err := os.Stat(restore); err != nil {
+		return
+	}
+	lines, err := readLines(restore)
+	if err != nil {
+		return
+	}
+	if err := swapConfigLines(p.ConfigFile, p.KeyPrefix, lines); err != nil {
+		a.log.Warn().Err(err).Msg("capture: input profile restore failed")
+		return
+	}
+	_ = os.Remove(restore)
+	a.log.Info().Msgf("capture: input profile restored (%s)", filepath.Base(p.ConfigFile))
+}
+
+// applyStreamedInputProfile heals a crashed session's leftover swap, backs up the live player_0
+// block to <streamedProfile>.restore, then swaps in the streamed bindings. Returns the exe on
+// success so Close knows to restore.
+func (a *App) applyStreamedInputProfile(exePath string) string {
+	p := a.getInputProfile(exePath)
+	if p == nil {
+		return ""
+	}
+	if _, err := os.Stat(p.StreamedProfile); err != nil {
+		a.log.Warn().Msgf("capture: no streamed profile %s — pads may be dead in this emulator", p.StreamedProfile)
+		return ""
+	}
+	a.restoreInputProfile(exePath) // heal a leftover swap first
+	cur, err := readLines(p.ConfigFile)
+	if err != nil {
+		a.log.Warn().Err(err).Msg("capture: read config for profile swap failed")
+		return ""
+	}
+	var block []string
+	for _, l := range cur {
+		if strings.HasPrefix(l, p.KeyPrefix) {
+			block = append(block, l)
+		}
+	}
+	if err := writeLines(p.StreamedProfile+".restore", block); err != nil {
+		a.log.Warn().Err(err).Msg("capture: write .restore failed")
+		return ""
+	}
+	streamed, err := readLines(p.StreamedProfile)
+	if err != nil {
+		return ""
+	}
+	if err := swapConfigLines(p.ConfigFile, p.KeyPrefix, streamed); err != nil {
+		a.log.Warn().Err(err).Msg("capture: input profile swap failed (launching with current bindings)")
+		return ""
+	}
+	a.log.Info().Msgf("capture: input profile swapped to streamed bindings for %s", filepath.Base(exePath))
+	return exePath
+}
+
+// setDpiCompatLayer marks exe system-DPI-aware via the per-user AppCompatFlags layer (same
+// mechanism as Explorer's Compatibility → "Override high DPI scaling behavior: System"). Why
+// (2026-07-23, SM64 Plus on the 300%-scaled console TV): a DPI-unaware game gets DWM-virtualized —
+// its "1920x1080" window is physically scale× larger, the GL driver sizes the framebuffer to the
+// PHYSICAL client area while the game's glViewport uses the logical size it believes, and GL's
+// bottom-left origin leaves the image in the bottom-left corner of a mostly-black surface (WGC
+// captures physical pixels; the stream showed the corner). The layer pins the window to physical
+// 1920x1080 on ANY monitor scale. Merges into existing layer tokens; caller logs the outcome —
+// a failure only means DPI-scaled capture, never a failed room.
+func setDpiCompatLayer(exe string) (string, error) {
+	k, _, err := registry.CreateKey(registry.CURRENT_USER,
+		`Software\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\Layers`,
+		registry.QUERY_VALUE|registry.SET_VALUE)
+	if err != nil {
+		return "", err
+	}
+	defer k.Close()
+	cur, _, gerr := k.GetStringValue(exe)
+	if gerr != nil {
+		cur = ""
+	}
+	if strings.Contains(cur, "HIGHDPIAWARE") {
+		return cur, nil
+	}
+	val := "~ HIGHDPIAWARE"
+	if strings.TrimSpace(cur) != "" {
+		val = cur + " HIGHDPIAWARE"
+	}
+	if err := k.SetStringValue(exe, val); err != nil {
+		return "", err
+	}
+	return val, nil
+}
+
+// ── Process launch under a kill-on-close Job Object ─────────────────────────────────────────────
+
+type gameProc struct {
+	cmd *exec.Cmd
+	job windows.Handle
+	pid int
+}
+
+// launchGame starts the emulator with the exact command line the gateway resolved (Start-Process
+// semantics: raw args string appended to the quoted exe), assigns it to a Job Object with
+// KILL_ON_JOB_CLOSE so the tree dies with the worker no matter what.
+func launchGame(exe, args, workingDir string) (*gameProc, error) {
+	cmd := exec.Command(exe)
+	cmd.Dir = workingDir
+	// Deliver gamepad input even while the game window is NOT foreground — the capture lane runs the
+	// game hidden/unfocused on the virtual display so it can't steal the owner's input, but an SDL game
+	// (SM64 Plus, yuzu) drops joystick events when it lacks focus unless this hint is set. Harmless to
+	// non-SDL titles.
+	//
+	// IGNORE_DEVICES_EXCEPT pins SDL games to the arcade's ViGEm pads (arcadePadVid/arcadePadPid).
+	// Without it a game that opens "the first controller" latches one of the REAL pads plugged into
+	// the box (Pro Controller / DualSense / Hori were all attached 2026-07-23) and the room's virtual
+	// pad — enumerated after them — is never consulted: browser input reaches the worker and the pad,
+	// and the game ignores it. (yuzu dodged this only because its streamed input profile pins pads
+	// explicitly.) Real pads keep working everywhere else; this env only shapes THIS game process.
+	cmd.Env = append(os.Environ(),
+		"SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1",
+		fmt.Sprintf("SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT=0x%04x/0x%04x", arcadePadVid, arcadePadPid))
+	cmdLine := `"` + exe + `"`
+	if strings.TrimSpace(args) != "" {
+		cmdLine += " " + args
+	}
+	cmd.SysProcAttr = &syscall.SysProcAttr{CmdLine: cmdLine}
+	if err := cmd.Start(); err != nil {
+		return nil, fmt.Errorf("launch %s: %w", exe, err)
+	}
+	gp := &gameProc{cmd: cmd, pid: cmd.Process.Pid}
+
+	job, err := windows.CreateJobObject(nil, nil)
+	if err == nil {
+		var info windows.JOBOBJECT_EXTENDED_LIMIT_INFORMATION
+		info.BasicLimitInformation.LimitFlags = windows.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
+		_, _ = windows.SetInformationJobObject(job,
+			windows.JobObjectExtendedLimitInformation,
+			uintptr(unsafe.Pointer(&info)), uint32(unsafe.Sizeof(info)))
+		if ph, oerr := windows.OpenProcess(windows.PROCESS_SET_QUOTA|windows.PROCESS_TERMINATE, false, uint32(gp.pid)); oerr == nil {
+			if aerr := windows.AssignProcessToJobObject(job, ph); aerr == nil {
+				gp.job = job
+			}
+			windows.CloseHandle(ph)
+		}
+	}
+	return gp, nil
+}
+
+// kill stops the game tree. GRACEFUL FIRST: post WM_CLOSE so the emulator stops cleanly and flushes
+// its shader/pipeline cache — a hard kill mid-shader-compile truncates yuzu's vulkan_pipelines.bin,
+// and the NEXT launch then crashes loading it (observed live; yuzu's confirmStop is off so no dialog
+// blocks the close). Wait up to 3 s for a clean exit, THEN the hard path: closing the job handle
+// triggers KILL_ON_JOB_CLOSE, plus a direct Process.Kill fallback.
+func (gp *gameProc) kill() {
+	if gp == nil {
+		return
+	}
+	if gp.pid > 0 {
+		postCloseToPid(gp.pid)
+		if h, err := windows.OpenProcess(windows.SYNCHRONIZE, false, uint32(gp.pid)); err == nil {
+			windows.WaitForSingleObject(h, 3000) // clean exit flushes the cache; timeout ⇒ hard-kill below
+			windows.CloseHandle(h)
+		}
+	}
+	if gp.job != 0 {
+		windows.CloseHandle(gp.job)
+		gp.job = 0
+	}
+	if gp.cmd != nil && gp.cmd.Process != nil {
+		_ = gp.cmd.Process.Kill()
+	}
+}
+
+// waitExit blocks until the game process exits and returns.
+func (gp *gameProc) waitExit() {
+	if gp != nil && gp.cmd != nil {
+		_ = gp.cmd.Wait()
+	}
+}
+
+// ── Foreground focus (best-effort; yuzu -f usually self-foregrounds) ────────────────────────────
+
+var (
+	procEnumWindows        = user32.NewProc("EnumWindows")
+	procGetWindowThreadPid = user32.NewProc("GetWindowThreadProcessId")
+	procIsWindowVisible    = user32.NewProc("IsWindowVisible")
+	procSetForegroundWin   = user32.NewProc("SetForegroundWindow")
+	procShowWindow         = user32.NewProc("ShowWindow")
+	procSetWindowLongPtr   = user32.NewProc("SetWindowLongPtrW")
+	procSetWindowPos       = user32.NewProc("SetWindowPos")
+	procGetWindowRect      = user32.NewProc("GetWindowRect")
+	procBringWindowToTop   = user32.NewProc("BringWindowToTop")
+	procKeybdEvent         = user32.NewProc("keybd_event")
+	procPostMessageW       = user32.NewProc("PostMessageW")
+	procSetDpiAwareness    = user32.NewProc("SetProcessDpiAwarenessContext")
+)
+
+const wmClose = 0x0010
+
+// setProcessDpiAwarenessV2 opts this process into per-monitor-v2 DPI awareness so USER32 window
+// coordinates are PHYSICAL pixels (see the Init call site for why the capture worker needs this).
+// DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2 is the pseudo-handle -4.
+func setProcessDpiAwarenessV2() bool {
+	r, _, _ := procSetDpiAwareness.Call(^uintptr(3)) // two's-complement -4
+	return r != 0
+}
+
+// postClose enum state — the callback is created ONCE at package init (same NewCallback-slot-leak
+// reason as focusEnumWindow, W3). One room closes at a time ⇒ no lock needed.
+var (
+	postCloseTargetPid int
+	postCloseEnum      = syscall.NewCallback(func(hwnd, lparam uintptr) uintptr {
+		var wpid uint32
+		procGetWindowThreadPid.Call(hwnd, uintptr(unsafe.Pointer(&wpid)))
+		if int(wpid) == postCloseTargetPid {
+			if vis, _, _ := procIsWindowVisible.Call(hwnd); vis != 0 {
+				procPostMessageW.Call(hwnd, wmClose, 0, 0)
+			}
+		}
+		return 1 // keep going — close every top-level window the pid owns
+	})
+)
+
+// postCloseToPid posts WM_CLOSE to every visible top-level window owned by pid (graceful stop).
+func postCloseToPid(pid int) {
+	postCloseTargetPid = pid
+	procEnumWindows.Call(postCloseEnum, 0)
+}
+
+const (
+	swShow         = 5
+	vkMenu         = 0x12 // ALT
+	keyeventfKeyUp = 0x02
+)
+
+// focus enum state — the callback is created ONCE at package init (W3): syscall.NewCallback slots
+// are process-global and NEVER freed (Go caps ~2000), so one per launch would eventually panic on a
+// long-lived worker serving many rooms. One room at a time ⇒ these globals need no lock.
+var (
+	focusTargetPid  int
+	focusFoundHwnd  uintptr
+	focusEnumWindow = syscall.NewCallback(func(hwnd, lparam uintptr) uintptr {
+		var wpid uint32
+		procGetWindowThreadPid.Call(hwnd, uintptr(unsafe.Pointer(&wpid)))
+		if int(wpid) == focusTargetPid {
+			if vis, _, _ := procIsWindowVisible.Call(hwnd); vis != 0 {
+				focusFoundHwnd = hwnd
+				return 0 // stop
+			}
+		}
+		return 1
+	})
+)
+
+// focusPid polls (up to ~20 s) for a visible top-level window owned by pid and foregrounds it.
+// SetForegroundWindow is silently ignored for a BACKGROUND process (Windows foreground lock), which
+// is exactly our case — the worker isn't the foreground app. Synthesizing an ALT tap first makes
+// Windows treat this as user-initiated and honor the change (the documented unlock). We also raise
+// + re-assert a few times because yuzu creates a splash then its real window.
+//
+// When a per-room virtual display is active, focusPid delegates to placeOnVDisplay (below) which
+// relocates the game window onto that display so it renders — and is captured — THERE, not on the
+// owner's physical desktop.
+func (a *App) focusPid(pid int) {
+	if a.vdActive {
+		a.placeOnVDisplay(pid)
+		return
+	}
+	// Physical-monitor path (legacy): the game is on the owner's screen, so foreground it so it frames
+	// + receives input. ALT tap unlocks the background-process foreground lock.
+	deadline := time.Now().Add(20 * time.Second)
+	asserts := 0
+	focusTargetPid = pid
+	for time.Now().Before(deadline) {
+		focusFoundHwnd = 0
+		procEnumWindows.Call(focusEnumWindow, 0)
+		found := focusFoundHwnd
+		if found != 0 {
+			procKeybdEvent.Call(vkMenu, 0, 0, 0)
+			procKeybdEvent.Call(vkMenu, 0, keyeventfKeyUp, 0)
+			procShowWindow.Call(found, swShow)
+			procSetForegroundWin.Call(found)
+			procBringWindowToTop.Call(found)
+			// Re-assert 3x over ~1.5s: a window can lose focus/position to its own late-created child.
+			asserts++
+			if asserts >= 3 {
+				return
+			}
+			time.Sleep(500 * time.Millisecond)
+			continue
+		}
+		time.Sleep(300 * time.Millisecond)
+	}
+}
+
+// windowRect returns a window's screen rectangle (left, top, right, bottom).
+func windowRect(hwnd uintptr) (l, t, r, b int32) {
+	var rc win32rect
+	procGetWindowRect.Call(hwnd, uintptr(unsafe.Pointer(&rc)))
+	return rc.left, rc.top, rc.right, rc.bottom
+}
+
+// placeOnVDisplay parks the game window on the hidden per-room virtual display and KEEPS re-asserting
+// the position for a few seconds. This is the load-bearing part: an SDL title (SM64 Plus) re-centers
+// its own window onto its configured `default_monitor` a beat AFTER it first creates the window, which
+// would yank the game back onto the owner's PHYSICAL desktop — leaving the captured vdisplay blank and
+// the stream showing an empty display while audio still plays (the exact "I hear it but don't see it"
+// symptom). A one-shot move loses that race; re-placing until the window STAYS on the vdisplay rect
+// wins it. We never foreground the window — foregrounding a game the owner can't see would steal their
+// keyboard/mouse (the SM64 Plus mouse-trap); the pad still reaches it via
+// SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS (set at launch).
+//
+// It logs where the window is first seen and where it ends up, so a blank capture can be told apart:
+// window confirmed ON the vdisplay rect + still blank ⇒ a WGC-can't-capture-this-display problem, not
+// a placement one.
+func (a *App) placeOnVDisplay(pid int) {
+	target := fmt.Sprintf("@(%d,%d) %dx%d", a.vdX, a.vdY, a.vdW, a.vdH)
+	deadline := time.Now().Add(10 * time.Second)
+	firstSeen := false
+	settledStreak := 0
+	focusTargetPid = pid
+	for time.Now().Before(deadline) {
+		focusFoundHwnd = 0
+		procEnumWindows.Call(focusEnumWindow, 0)
+		found := focusFoundHwnd
+		if found == 0 {
+			time.Sleep(300 * time.Millisecond)
+			continue
+		}
+		l, t, r, b := windowRect(found)
+		if !firstSeen {
+			a.log.Info().Msgf("capture: game window %#x first seen @(%d,%d) %dx%d — relocating onto virtual display %s",
+				found, l, t, r-l, b-t, target)
+			firstSeen = true
+		}
+		onTarget := int(l) == a.vdX && int(t) == a.vdY
+		a.placeBorderlessAt(found, a.vdX, a.vdY, a.vdW, a.vdH)
+		if onTarget {
+			// Two consecutive checks with the window already on the vdisplay ⇒ it has stopped fighting
+			// us. Confirm and stop re-asserting.
+			settledStreak++
+			if settledStreak >= 2 {
+				a.log.Info().Msgf("capture: game window %#x settled on virtual display %s", found, target)
+				return
+			}
+		} else {
+			settledStreak = 0
+		}
+		time.Sleep(400 * time.Millisecond)
+	}
+	a.log.Warn().Msgf("capture: game window never settled on virtual display %s within 10s — "+
+		"the stream may show a blank display (title likely re-homes itself; check its monitor/fullscreen setting)", target)
+}
+
+// placeBorderlessAt strips the game window's chrome and moves+sizes it to the given rect, shown but
+// NOT activated — so the game renders (and is captured) there without ever taking the owner's
+// foreground/mouse/keyboard. Used both for the SudoVDA vdisplay rect (monitor mode) and the
+// off-screen park rect (window mode).
+func (a *App) placeBorderlessAt(hwnd uintptr, x, y, w, h int) {
+	const (
+		gwlStyle        = ^uintptr(15) // GWL_STYLE (-16)
+		wsPopup         = 0x80000000
+		wsVisible       = 0x10000000
+		swShowNoActive  = 4    // SW_SHOWNOACTIVATE
+		swpNoActivate   = 0x10 // SWP_NOACTIVATE
+		swpFrameChanged = 0x20 // SWP_FRAMECHANGED
+		swpShowWindow   = 0x40 // SWP_SHOWWINDOW
+	)
+	procSetWindowLongPtr.Call(hwnd, gwlStyle, uintptr(wsPopup|wsVisible))
+	procShowWindow.Call(hwnd, swShowNoActive)
+	procSetWindowPos.Call(hwnd, 0,
+		uintptr(int32(x)), uintptr(int32(y)),
+		uintptr(int32(w)), uintptr(int32(h)),
+		swpNoActivate|swpFrameChanged|swpShowWindow)
+}
