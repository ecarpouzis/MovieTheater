+//export coreEnvironment
+func coreEnvironment(cmd C.unsigned, data unsafe.Pointer) C.bool {
+
+	// see core_environment_cgo
+
+	switch cmd {
+	case C.RETRO_ENVIRONMENT_SET_SYSTEM_AV_INFO:
+		Nan0.log.Debug().Msgf("retro_set_system_av_info")
+		av := *(*C.struct_retro_system_av_info)(data)
+		// Apply TIMING changes, not just geometry: cores (e.g. flycast on a DC cutscene) call this to
+		// switch fps mid-run. Ignoring it left the frontend pacing retro_run at the old rate → the
+		// cutscene ran double-speed (audio clipped). The frontend loop re-reads VideoFramerate() and
+		// recomputes its frame budget, so updating the stored timing here fixes the pacing.
+		if av.timing.fps != Nan0.sys.av.timing.fps || av.timing.sample_rate != Nan0.sys.av.timing.sample_rate {
+			Nan0.log.Info().Msgf("[AV-CHANGE] fps %v->%v sample_rate %v->%v",
+				Nan0.sys.av.timing.fps, av.timing.fps, Nan0.sys.av.timing.sample_rate, av.timing.sample_rate)
+			Nan0.sys.av.timing = av.timing
+			// tickTime feeds the per-frame RTP duration (vfr:false path) — recompute it too, else the
+			// frame timestamps stay at the old rate after an fps change even though pacing follows.
+			if av.timing.fps > 0 {
+				Nan0.tickTime = time.Duration(float64(time.Second) / float64(av.timing.fps))
+			}
+		}
+		if isGeometryDifferent(av.geometry) {
+			geometryChange(av.geometry)
+		}
+		return true
+	case C.RETRO_ENVIRONMENT_SET_GEOMETRY:
+		Nan0.log.Debug().Msgf("retro_set_geometry")
+		geom := *(*C.struct_retro_game_geometry)(data)
+		if isGeometryDifferent(geom) {
+			geometryChange(geom)
+		}
+		return true
+	case C.RETRO_ENVIRONMENT_SET_ROTATION:
+		setRotation((*(*uint)(data) % 4) * 90)
+		return true
+	case C.RETRO_ENVIRONMENT_GET_CAN_DUPE:
+		dup := C.bool(Nan0.meta.FrameDup)
+		*(*C.bool)(data) = dup
+		return dup
+	case C.RETRO_ENVIRONMENT_GET_USERNAME:
+		*(**C.char)(data) = Nan0.cUserName
+		return true
+	case C.RETRO_ENVIRONMENT_GET_LOG_INTERFACE:
+		cb := (*C.struct_retro_log_callback)(data)
+		cb.log = (C.retro_log_printf_t)(C.core_log_cgo)
+		return true
+	case C.RETRO_ENVIRONMENT_SET_PIXEL_FORMAT:
+		res, err := videoSetPixelFormat(*(*C.enum_retro_pixel_format)(data))
+		if err != nil {
+			Nan0.log.Fatal().Err(err).Msg("pix format failed")
+		}
+		return res
+	case C.RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY:
+		*(**C.char)(data) = Nan0.cSystemDirectory
+		return true
+	case C.RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY:
+		*(**C.char)(data) = Nan0.cSaveDirectory
+		return true
+	case C.RETRO_ENVIRONMENT_SET_DISK_CONTROL_INTERFACE:
+		// MovieTheater patch 0005: capture the core's disk-control callbacks so a multi-disc .m3u game
+		// can swap discs live (docs/arcade-dedupe-multidisc-plan.md). Applied on the emulator thread in Run.
+		C.nano_disk_set_interface(data)
+		Nan0.log.Debug().Msgf("disk control interface registered")
+		return true
+	case C.RETRO_ENVIRONMENT_SET_MESSAGE:
+		// only with the Libretro debug mode
+		if Nan0.log.GetLevel() < logger.InfoLevel {
+			message := (*C.struct_retro_message)(data)
+			msg := C.GoString(message.msg)
+			Nan0.log.Debug().Msgf("message: %v", msg)
+			return true
+		}
+		return false
+	case C.RETRO_ENVIRONMENT_GET_VARIABLE:
+		if Nan0.options == nil {
+			return false
+		}
+		rv := (*C.struct_retro_variable)(data)
+		key := C.GoString(rv.key)
+		if v, ok := Nan0.options[key]; ok {
+			// make Go strings null-terminated copies ;_;
+			Nan0.options[key] = v + "\x00"
+			ptr := unsafe.Pointer(unsafe.StringData(Nan0.options[key]))
+			var p runtime.Pinner
+			p.Pin(ptr)
+			defer p.Unpin()
+			// cast to C string and set the value
+			rv.value = (*C.char)(ptr)
+			Nan0.log.Debug().Msgf("Set %v=%v", key, v)
+			return true
+		}
+		return false
+	case C.RETRO_ENVIRONMENT_GET_PREFERRED_HW_RENDER:
+		// MovieTheater patch 0006: we can only host OpenGL contexts (RGFW/WGL). Without this answer
+		// flycast falls back to probing drivers and commits to D3D11 on Windows builds, which then
+		// null-calls through unresolved glsm GL pointers on the first retro_run (PC=0 GPF).
+		if Nan0.Video.gl.enabled {
+			*(*C.unsigned)(data) = C.RETRO_HW_CONTEXT_OPENGL
+			return true
+		}
+		return false
+	case C.RETRO_ENVIRONMENT_SET_HW_RENDER:
+		if Nan0.Video.gl.enabled {
+			hw := (*C.struct_retro_hw_render_callback)(data)
+			// patch 0006: accept only context types the RGFW graphics layer can actually create;
+			// accepting D3D/Vulkan here strands the core with a renderer it can never initialize.
+			if hw.context_type != C.RETRO_HW_CONTEXT_OPENGL && hw.context_type != C.RETRO_HW_CONTEXT_OPENGL_CORE {
+				Nan0.log.Warn().Msgf("rejected non-GL hw render context type: %v", uint(hw.context_type))
+				return false
+			}
+			Nan0.Video.hw = hw
+			Nan0.Video.hw.get_current_framebuffer = (C.retro_hw_get_current_framebuffer_t)(C.core_get_current_framebuffer_cgo)
+			Nan0.Video.hw.get_proc_address = (C.retro_hw_get_proc_address_t)(C.core_get_proc_address_cgo)
+			return true
+		}
+		return false
+	case C.RETRO_ENVIRONMENT_SET_HW_SHARED_CONTEXT:
+		// MovieTheater patch 0016: acknowledge SHARED hardware context (env 44). Dolphin's OGL backend
+		// renders / compiles shaders on threads OTHER than the retro_run graphics thread and asks the
+		// frontend to permit additional GL contexts that share the main one's object namespace. When we
+		// refused (default false), Dolphin logged "unable to set shared context for OpenGL 3.0", fell back
+		// to a single-context path, and then dereferenced a null context on its video thread → 0xc0000005
+		// at GameCube-mode boot. Our WGL/GLX context creation already shares self-consistently: Dolphin
+		// caches the main HGLRC/HDC (wglGetCurrentContext/DC) during context_reset on the graphics thread,
+		// then wglCreateContext + wglShareLists on its worker thread. So granting the capability is what it
+		// needs. Only claim it on the GL path (a non-GL core must never get a spurious yes).
+		if Nan0.Video.gl.enabled {
+			Nan0.log.Info().Msg("shared hardware context granted (env 44)")
+			return true
+		}
+		return false
+	case C.RETRO_ENVIRONMENT_SET_CONTROLLER_INFO:
+		if Nan0.log.GetLevel() > logger.DebugLevel {
+			return false
+		}
+
+		info := (*[64]C.struct_retro_controller_info)(data)
+		for c, controller := range info {
+			tp := unsafe.Pointer(controller.types)
+			if tp == nil {
+				break
+			}
+			cInfo := strings.Builder{}
+			fmt.Fprintf(&cInfo, "Controller [%v] ", c)
+			cd := (*[32]C.struct_retro_controller_description)(tp)
+			delim := ", "
+			n := int(controller.num_types)
+			for i := range n {
+				if i == n-1 {
+					delim = ""
+				}
+				fmt.Fprintf(&cInfo, "%v: %v%s", cd[i].id, C.GoString(cd[i].desc), delim)
+			}
+			//Nan0.log.Debug().Msgf("%v", cInfo.String())
+		}
+		return true
+	case C.RETRO_ENVIRONMENT_SET_KEYBOARD_CALLBACK:
+		Nan0.log.Debug().Msgf("Keyboard event callback was set")
+		Nan0.keyboardCb = (*C.struct_retro_keyboard_callback)(data)
+		return true
+	case C.RETRO_ENVIRONMENT_SET_AUDIO_BUFFER_STATUS_CALLBACK:
+		if data == nil {
+			Nan0.audioBuffCb = nil
+			return true
+		}
+
+		src := (*C.struct_retro_audio_buffer_status_callback)(data)
+		Nan0.audioBuffCb = new(C.struct_retro_audio_buffer_status_callback)
+		*Nan0.audioBuffCb = *src
+		Nan0.log.Info().Msg("Audio buffer status callback registered")
+		return true
+	case C.RETRO_ENVIRONMENT_SET_MINIMUM_AUDIO_LATENCY:
+		latency := *(*C.unsigned)(data)
+		Nan0.log.Info().Uint("latency_ms", uint(latency)).Msg("audio latency requested")
+		return true
+	}
+	return false
+}
+
+//export initVideo
+func initVideo() {
+	var context graphics.Context
+	switch Nan0.Video.hw.context_type {
+	case C.RETRO_HW_CONTEXT_NONE:
+		context = graphics.CtxNone
+	case C.RETRO_HW_CONTEXT_OPENGL:
+		context = graphics.CtxOpenGl
+	case C.RETRO_HW_CONTEXT_OPENGLES2:
+		context = graphics.CtxOpenGlEs2
+	case C.RETRO_HW_CONTEXT_OPENGL_CORE:
+		context = graphics.CtxOpenGlCore
+	case C.RETRO_HW_CONTEXT_OPENGLES3:
+		context = graphics.CtxOpenGlEs3
+	case C.RETRO_HW_CONTEXT_OPENGLES_VERSION:
+		context = graphics.CtxOpenGlEsVersion
+	case C.RETRO_HW_CONTEXT_VULKAN:
+		context = graphics.CtxVulkan
+	case C.RETRO_HW_CONTEXT_DUMMY:
+		context = graphics.CtxDummy
+	default:
+		context = graphics.CtxUnknown
+	}
+
+	thread.Main(func() {
+		var err error
+		Nan0.glCtx, err = graphics.NewRGFWContext(graphics.Config{
+			Ctx:            context,
+			W:              int(Nan0.sys.av.geometry.max_width),
+			H:              int(Nan0.sys.av.geometry.max_height),
+			GLAutoContext:  Nan0.Video.gl.autoCtx,
+			GLVersionMajor: uint(Nan0.Video.hw.version_major),
+			GLVersionMinor: uint(Nan0.Video.hw.version_minor),
+			GLHasDepth:     bool(Nan0.Video.hw.depth),
+			GLHasStencil:   bool(Nan0.Video.hw.stencil),
+		})
+		if err != nil {
+			panic(err)
+		}
+
+		// GL ZERO-COPY: wrap this context for GStreamer, HERE and nowhere else. It has to happen on the
+		// thread where the core's GL context is CURRENT (GStreamer reads the GL function pointers out
+		// of it), and this closure is that thread. Doing it from the coordinator handler — where the
+		// media pipe is otherwise assembled — silently produces a context with no vtable.
+		//
+		// A failure is NOT fatal: we log it and leave GLZeroCopy false, which keeps the readback path.
+		// The 3D lane must never go dark because an optimisation did not initialise.
+		if Nan0.GLZeroCopy && GLContextReady != nil {
+			glrc, _ := Nan0.glCtx.GLHandles()
+			// The share step needs NO context current (wglShareLists -> ERROR_BUSY otherwise), so hand
+			// the media package the unbind/rebind pair rather than letting it guess about our threads.
+			if err := GLContextReady(glrc, Nan0.glCtx.UnbindContext, Nan0.glCtx.BindContext); err != nil {
+				Nan0.log.Error().Err(err).Msg("gl zero-copy unavailable; falling back to the readback path")
+				Nan0.GLZeroCopy = false
+			} else {
+				Nan0.log.Info().Msg("gl zero-copy: the encoder reads the core's texture (no glReadPixels)")
+			}
+		}
+	})
+
+	if Nan0.log.GetLevel() < logger.InfoLevel {
+		printOpenGLDriverInfo()
+	}
+}
+
+// GLContextReady is called on the GRAPHICS thread once the core's GL context exists, with its native
+// handle, so the media package can wrap it for GStreamer. A package-level hook rather than an import so
+// nanoarch keeps knowing nothing about the encoder.
+var GLContextReady func(glrc uintptr, unbind func(), rebind func() error) error
+
+// GLContextGone is called just before the core's GL context is destroyed, so the media package can drop
+// the encoder's shared contexts first. Order matters — see deinitVideo.
+var GLContextGone func()
+
+//export deinitVideo
+func deinitVideo() {
+	if !Nan0.hackSkipHwContextDestroy {
+		C.bridge_context_reset(Nan0.Video.hw.context_destroy)
+	}
+	// GL zero-copy: drop the ENCODER's GL contexts before the core's goes away. They share an object
+	// space, so destroying the core's first leaves nvcodec doing GL work against a dead share group —
+	// which hangs its state change ("media pipeline teardown wedged") and hard-exits the worker.
+	if Nan0.GLZeroCopy && GLContextGone != nil {
+		GLContextGone()
+	}
+	thread.Main(func() {
+		graphics.FreeZeroCopyPool()
+		if err := Nan0.glCtx.Deinit(); err != nil {
+			Nan0.log.Error().Err(err).Msg("deinit fail")
+		}
+	})
+	Nan0.Video.gl.enabled = false
+	Nan0.Video.gl.autoCtx = false
+	Nan0.hackSkipHwContextDestroy = false
+	Nan0.hackSkipSameThreadSave = false
+	Nan0.hackSkipBootRestore = false
+	Nan0.hackSkipSerializeSizeProbe = false
+	thread.SwitchGraphics(false)
+}
+
+type limit struct {
+	d  time.Duration
+	t  *time.Timer
+	mu sync.Mutex
+}
+
+func NewLimit(d time.Duration) func(f func()) {
+	l := &limit{d: d}
+	return func(f func()) { l.push(f) }
+}
+
+func (d *limit) push(f func()) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.t != nil {
+		d.t.Stop()
+	}
+	d.t = time.AfterFunc(d.d, f)
+}
+
+func geometryChange(geom C.struct_retro_game_geometry) {
+	Nan0.limiter(func() {
+		old := Nan0.sys.av.geometry
+		Nan0.sys.av.geometry = geom
+
+		if Nan0.Video.gl.enabled && (old.max_width != geom.max_width || old.max_height != geom.max_height) {
+			// (for LRPS2) makes the max height bigger increasing SDL2 and OpenGL buffers slightly
+			Nan0.sys.av.geometry.max_height = C.unsigned(float32(Nan0.sys.av.geometry.max_height) * 1.5)
+			bufS := uint(geom.max_width*Nan0.sys.av.geometry.max_height) * Nan0.Video.PixFmt.BPP
+			graphics.SetBuffer(int(bufS))
+			Nan0.log.Debug().Msgf("OpenGL frame buffer: %v", bufS)
+		}
+
+		if Nan0.OnSystemAvInfo != nil {
+			Nan0.log.Debug().Msgf(">>> geometry change %v -> %v", old, geom)
+			go Nan0.OnSystemAvInfo()
+		}
+	})
+}
+
+func isGeometryDifferent(geom C.struct_retro_game_geometry) bool {
+	return Nan0.sys.av.geometry.base_width != geom.base_width ||
+		Nan0.sys.av.geometry.base_height != geom.base_height
+}
