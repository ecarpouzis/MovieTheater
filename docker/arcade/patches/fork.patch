+func (c *coordinator) HandleInitWebrtcStream(rq api.InitWebrtcStreamRequest, w *Worker, factory *webrtc.ApiFactory) api.Out {
+	var err error
+	defer func() {
+		if err != nil {
+			c.log.Error().Err(err).Str("peer", rq.Id).Msg("")
+		}
+	}()
+
+	peer := webrtc.New(c.log, factory)
+	// Per-room codec (patch 0036): the site's join descriptor hands every client of a room the
+	// creator's codec choice, and each client echoes it here — so this peer's track mime matches
+	// the encoder the creator's t=104 will build (or already built, for joiners).
+	codec := w.roomVideoCodec(rq.VideoCodec)
+
+	// Patch 0020: a non-initiator browser can set the (otherwise unused) init sdp field to
+	// "audio-pc" to ask for opus on a dedicated aux PeerConnection (see webrtc.go Peer.ac).
+	// Old clients never send it → identical to stock.
+	splitAudio := !rq.Initiator && rq.Sdp == "audio-pc"
+
+	if err = peer.NewConnection(codec, splitAudio, func(ice *string) { c.IceCandidate(*ice, rq.Id) }); err != nil {
+		return api.EmptyPacket
+	}
+
+	if rq.Initiator {
+		if err = peer.HandleSignal(nil, &rq.Sdp); err != nil {
+			return api.EmptyPacket
+		}
+	}
+
+	var sdp string
+	sdp, err = peer.OfferAnswer(!rq.Initiator)
+	if err != nil {
+		return api.EmptyPacket
+	}
+
+	// The aux audio offer travels in the ice signal field ("aux-sdp:" envelope) — the coordinator
+	// relays that string verbatim, and the browser buffers aux ICE until this lands. A failure here
+	// costs only split audio (the room still runs video+input), so it doesn't abort the init.
+	if splitAudio {
+		if auxSdp, auxErr := peer.OfferAux(); auxErr != nil {
+			c.log.Error().Err(auxErr).Str("peer", rq.Id).Msg("aux audio offer failed")
+		} else if auxSdp != "" {
+			c.IceCandidate("aux-sdp:"+auxSdp, rq.Id)
+		}
+	}
+
+	user := room.NewGameSession(rq.Id, peer) // use user uid from the coordinator
+	c.log.Info().Msgf("Peer connection: %s", user.Id())
+	w.router.AddUser(user)
+
+	return api.Out{Payload: sdp}
+}
