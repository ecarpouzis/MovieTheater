+package capture
+
+import (
+	"syscall"
+	"unsafe"
+)
+
+// monitorInfo is one physical/virtual display as seen by Win32 EnumDisplayMonitors.
+type monitorInfo struct {
+	handle  uint64 // HMONITOR — passed verbatim to d3d11screencapturesrc monitor-handle
+	device  string // \\.\DISPLAYn
+	x, y    int    // virtual-desktop top-left (rcMonitor.left/top) — where to place the game window
+	width   int
+	height  int
+	primary bool
+}
+
+var (
+	user32              = syscall.NewLazyDLL("user32.dll")
+	procEnumDisplayMons = user32.NewProc("EnumDisplayMonitors")
+	procGetMonitorInfoW = user32.NewProc("GetMonitorInfoW")
+)
+
+type win32rect struct{ left, top, right, bottom int32 }
+
+type monitorInfoEx struct {
+	cbSize    uint32
+	rcMonitor win32rect
+	rcWork    win32rect
+	dwFlags   uint32
+	szDevice  [32]uint16
+}
+
+const monitorinfofPrimary = 0x1
+
+// enumMonitors lists every monitor the desktop currently exposes, in EnumDisplayMonitors order.
+// The order is generally stable within a session; we log all of them and select by config index
+// so the operator can dodge a SudoVDA virtual display (plan §1 — the index into GDI display
+// numbers is NOT stable, but the HMONITOR we resolve to IS absolute for the element).
+func enumMonitors() []monitorInfo {
+	var out []monitorInfo
+	cb := syscall.NewCallback(func(hMonitor, hdc, lprc, lparam uintptr) uintptr {
+		var mi monitorInfoEx
+		mi.cbSize = uint32(unsafe.Sizeof(mi))
+		if r, _, _ := procGetMonitorInfoW.Call(hMonitor, uintptr(unsafe.Pointer(&mi))); r != 0 {
+			out = append(out, monitorInfo{
+				handle:  uint64(hMonitor),
+				device:  syscall.UTF16ToString(mi.szDevice[:]),
+				x:       int(mi.rcMonitor.left),
+				y:       int(mi.rcMonitor.top),
+				width:   int(mi.rcMonitor.right - mi.rcMonitor.left),
+				height:  int(mi.rcMonitor.bottom - mi.rcMonitor.top),
+				primary: mi.dwFlags&monitorinfofPrimary != 0,
+			})
+		}
+		return 1 // TRUE = keep enumerating
+	})
+	procEnumDisplayMons.Call(0, 0, cb, 0)
+	return out
+}
+
+// pickMonitor selects the configured index; on an out-of-range index it falls back to the
+// primary monitor (and then the first). Returns the HMONITOR and the chosen record.
+func pickMonitor(mons []monitorInfo, index int) (uint64, monitorInfo, bool) {
+	if len(mons) == 0 {
+		return 0, monitorInfo{}, false
+	}
+	if index >= 0 && index < len(mons) {
+		return mons[index].handle, mons[index], true
+	}
+	for _, m := range mons {
+		if m.primary {
+			return m.handle, m, true
+		}
+	}
+	return mons[0].handle, mons[0], true
+}
diff --git a/pkg/worker/caged/capture/pipeline.go b/pkg/worker/caged/capture/pipeline.go
new file mode 100644
index 0000000..eedaea2
--- /dev/null
+++ b/pkg/worker/caged/capture/pipeline.go
@@ -0,0 +1,337 @@
+package capture
+
+/*
+#cgo pkg-config: gstreamer-1.0 gstreamer-video-1.0
+#include <gst/gst.h>
+#include <gst/video/gstvideometa.h>
+
+// bufferVideoStride0 returns the REAL row stride of plane 0 from the buffer's GstVideoMeta, or -1
+// when there is no meta (fall back to a size/height heuristic). d3d12download can row-pad, so the
+// authoritative stride lives in the meta, not width*4 (W6 / trap #3).
+static int bufferVideoStride0(void *buf) {
+	GstVideoMeta *m = gst_buffer_get_video_meta((GstBuffer*)buf);
+	if (m == NULL) return -1;
+	return (int)m->stride[0];
+}
+*/
+import "C"
+
+import (
+	"fmt"
+	"runtime"
+	"sync/atomic"
+	"time"
+	"unsafe"
+
+	"github.com/giongto35/cloud-game/v3/pkg/worker/caged/app"
+	"github.com/go-gst/go-gst/gst"
+	gstapp "github.com/go-gst/go-gst/gst/app"
+)
+
+// startVideoPipeline builds and starts the capture->downscale->download->appsink pipeline. Frames
+// are pushed through App.videoCb into the UNCHANGED media/appsrc path (PixFormat BGRA), so every
+// encoder behavior (per-room codec, ABR, forced keyframes, PLI) is reused (plan §3.6, design A).
+func (a *App) startVideoPipeline() error {
+	// Rebuild a FRESH capture pipeline per room. Reuse across rooms proved too fragile: keeping one
+	// d3d12 WGC pipeline PLAYING for the process life worked in isolation but stopped delivering in the
+	// real path once the previous room's MEDIA pipe was destroyed (room 2 = frames=0/black). A fresh
+	// pipeline built AFTER the room's media is set up is immune to that. The catch NULL+rebuild used to
+	// hit — the old WGC session lingering because go-gst only unrefs on GC — is handled by releaseVideo
+	// (SetState NULL + drop ref + force GC) in stopPipelines, so the old session is gone before we build.
+	a.pipeMu.Lock()
+	stalePipe := a.videoPipe != nil
+	a.pipeMu.Unlock()
+	if stalePipe {
+		a.releaseVideo() // defensive: a prior room should have released it at Close
+	}
+
+	// WE RUN d3d12 (config: videoSource), and d3d11 is the fallback. Both branches are live code.
+	//
+	// History, because the obvious "fix" is to go back to d3d11: stock d3d12screencapturesrc aborts the
+	// worker (0xC0000409, ~10-30s in) on every FULLSCREEN title — which is every heavy title — via an
+	// out-of-bounds read in libgstd3d12's monochrome-cursor path, fatal only because MSYS2 builds
+	// libstdc++ with _GLIBCXX_ASSERTIONS. Confirmed by gdb (abort <- libstdc++ <- libgstd3d12). It is
+	// STILL unfixed upstream (1.28.5; the known MR 7293 is a different bug), so rather than lose the
+	// HDR tonemapping (tonemap=reinhard) that ONLY d3d12 has, we patch and build the plugin ourselves:
+	// docker/arcade/patches/gst/ + scripts/build-gst-d3d12-patched.ps1.
+	//
+	// ⚠ That patched DLL is a build artifact on the box, not in this repo: any pacman -Syu touching
+	// GStreamer silently restores the stock plugin and the crash returns. Re-run the script after an
+	// upgrade. If the patched DLL is ever unavailable, set videoSource: "d3d11" — correct on an SDR
+	// desktop, washed out on an HDR one.
+	//
+	// ⚠ Constrain format+framerate AFTER the convert — putting them on the src caps fails negotiation
+	// (not-negotiated). Rest of the path (limited-range encode downstream) is unchanged.
+	var launch string
+	if a.videoSource() == "d3d12" {
+		launch = fmt.Sprintf(
+			"d3d12screencapturesrc name=cap_src monitor-handle=%d show-cursor=false tonemap=reinhard "+
+				"! d3d12convert "+
+				"! video/x-raw(memory:D3D12Memory),format=BGRA,width=%d,height=%d,framerate=%d/1 "+
+				"! d3d12download "+
+				"! queue max-size-buffers=2 leaky=downstream "+
+				"! appsink name=cap_sink sync=false max-buffers=2 drop=true",
+			a.hmonitor, a.width(), a.height(), a.fps())
+	} else {
+		launch = fmt.Sprintf(
+			"d3d11screencapturesrc name=cap_src monitor-handle=%d show-cursor=false "+
+				"! d3d11convert "+
+				"! video/x-raw(memory:D3D11Memory),format=BGRA,width=%d,height=%d,framerate=%d/1 "+
+				"! d3d11download "+
+				"! queue max-size-buffers=2 leaky=downstream "+
+				"! appsink name=cap_sink sync=false max-buffers=2 drop=true",
+			a.hmonitor, a.width(), a.height(), a.fps())
+	}
+	a.log.Info().Msgf("capture: video source %v", map[bool]string{true: "d3d12", false: "d3d11"}[a.videoSource() == "d3d12"])
+
+	pipe, err := gst.NewPipelineFromString(launch)
+	if err != nil {
+		return fmt.Errorf("build video pipeline: %w", err)
+	}
+	sinkEl, err := pipe.GetElementByName("cap_sink")
+	if err != nil {
+		return fmt.Errorf("no cap_sink: %w", err)
+	}
+	sink := gstapp.SinkFromElement(sinkEl)
+	if sink == nil {
+		return fmt.Errorf("cap_sink is not an appsink")
+	}
+
+	dur := time.Second / time.Duration(a.fps())
+	sink.SetCallbacks(&gstapp.SinkCallbacks{
+		NewSampleFunc: func(s *gstapp.Sink) gst.FlowReturn {
+			sample := s.PullSample()
+			if sample == nil {
+				return gst.FlowEOS
+			}
+			buf := sample.GetBuffer()
+			if buf == nil {
+				return gst.FlowOK
+			}
+			mi := buf.Map(gst.MapRead)
+			if mi == nil {
+				return gst.FlowOK
+			}
+			atomic.AddUint64(&a.rawFrames, 1) // diag: counts BEFORE the capturing gate (pipeline liveness)
+			size := int(buf.GetSize())
+			src := unsafe.Slice((*byte)(mi.Data()), size)
+			h := a.height()
+			stride := a.width() * 4
+			if s := int(C.bufferVideoStride0(unsafe.Pointer(buf.Instance()))); s > 0 {
+				stride = s // authoritative row stride from GstVideoMeta (W6)
+			} else if h > 0 && size%h == 0 {
+				stride = size / h // fallback: single-plane packed buffer (size == stride*height)
+			}
+			a.cacheAndPush(src, stride, dur)
+			buf.Unmap()
+			return gst.FlowOK
+		},
+	})
+
+	if err := pipe.SetState(gst.StatePlaying); err != nil {
+		return fmt.Errorf("video pipeline play: %w", err)
+	}
+	a.videoPipe = pipe
+	return nil
+}
+
+// startAudioPipeline builds the PID-scoped (or system) WASAPI loopback -> S16LE 48k stereo ->
+// appsink pipeline. Must be called AFTER attach (needs the game PID) for process scope.
+func (a *App) startAudioPipeline(pid int) error {
+	var srcProps string
+	switch {
+	case a.conf.AudioCaptureDevice != "":
+		// Per-app isolation (VB-CABLE): the game was routed to the virtual sink. We capture from that
+		// sink; it carries ONLY the game (host speakers stay clean), no PID filter needed.
+		// LOOPBACK the CABLE *Input* render endpoint (AudioCaptureLoopback) rather than the CABLE
+		// *Output* capture device — the render-mix tap is BEFORE the cable's internal 96kHz double-SRC
+		// and ~7168-sample transfer buffer, cutting ~75-150ms of audio latency (plan §12A).
+		lb := ""
+		if a.conf.AudioCaptureLoopback {
+			lb = "loopback=true "
+		}
+		srcProps = fmt.Sprintf("%slow-latency=true device=\"%s\"", lb, a.conf.AudioCaptureDevice)
+	case a.conf.AudioScope != "system" && pid > 0:
+		srcProps = fmt.Sprintf("loopback=true low-latency=true loopback-mode=include-process-tree loopback-target-pid=%d", pid)
+	default:
+		srcProps = "loopback=true low-latency=true" // whole-endpoint (heavy lock => nothing else intended)
+	}
+	launch := fmt.Sprintf(
+		"wasapi2src name=aud_src %s "+
+			"! audioconvert ! audioresample "+
+			"! audio/x-raw,format=S16LE,rate=48000,channels=2,layout=interleaved "+
+			"! appsink name=aud_sink sync=false max-buffers=4 drop=true",
+		srcProps)
+
+	pipe, err := gst.NewPipelineFromString(launch)
+	if err != nil {
+		return fmt.Errorf("build audio pipeline: %w", err)
+	}
+	sinkEl, err := pipe.GetElementByName("aud_sink")
+	if err != nil {
+		return fmt.Errorf("no aud_sink: %w", err)
+	}
+	sink := gstapp.SinkFromElement(sinkEl)
+	if sink == nil {
+		return fmt.Errorf("aud_sink is not an appsink")
+	}
+	sink.SetCallbacks(&gstapp.SinkCallbacks{
+		NewSampleFunc: func(s *gstapp.Sink) gst.FlowReturn {
+			sample := s.PullSample()
+			if sample == nil {
+				return gst.FlowEOS
+			}
+			buf := sample.GetBuffer()
+			if buf == nil {
+				return gst.FlowOK
+			}
+			mi := buf.Map(gst.MapRead)
+			if mi == nil {
+				return gst.FlowOK
+			}
+			size := int(buf.GetSize())
+			out := make([]byte, size)
+			copy(out, unsafe.Slice((*byte)(mi.Data()), size))
+			buf.Unmap()
+			if cb := a.audioCb; cb != nil {
+				cb(app.Audio{Data: out, Duration: 0}) // opus frame-size drives audio timing
+			}
+			return gst.FlowOK
+		},
+	})
+	if err := pipe.SetState(gst.StatePlaying); err != nil {
+		return fmt.Errorf("audio pipeline play: %w", err)
+	}
+	a.audioPipe = pipe
+	return nil
+}
+
+// cacheAndPush copies the frame into the reusable last-frame buffer and pushes it to the media
+// path, serialized so the re-push ticker and the capture callback never overlap ProcessVideo.
+// Dropped when not capturing (between rooms / after the game dies) — the pipeline keeps running but
+// its live desktop frames must not reach the stream (privacy + no stale-desktop between rooms).
+func (a *App) cacheAndPush(src []byte, stride int, dur time.Duration) {
+	if !a.capturing.Load() {
+		return
+	}
+	a.frameMu.Lock()
+	if cap(a.lastFrame) < len(src) {
+		a.lastFrame = make([]byte, len(src))
+	}
+	a.lastFrame = a.lastFrame[:len(src)]
+	copy(a.lastFrame, src)
+	a.lastStride = stride
+	a.lastDur = dur
+	a.lastPush = time.Now()
+	a.pushLocked()
+	a.frameMu.Unlock()
+}
+
+// pushLocked emits the cached frame to videoCb. Caller holds frameMu.
+func (a *App) pushLocked() {
+	cb := a.videoCb
+	if cb == nil || len(a.lastFrame) == 0 {
+		return
+	}
+	a.frames++
+	cb(app.Video{
+		Frame:    app.RawFrame{Data: a.lastFrame, Stride: a.lastStride, W: a.width(), H: a.height()},
+		Duration: a.lastDur,
+	})
+}
+
+// repushLoop re-pushes the last frame when Windows Graphics Capture goes quiet (WGC only delivers
+// on screen change; a static screen would starve the encoder and leave joiners with nothing to
+// decode). 2 Hz; re-push only when >500 ms since the last real/re-pushed frame (plan trap #2).
+func (a *App) repushLoop() {
+	t := time.NewTicker(250 * time.Millisecond)
+	defer t.Stop()
+	for {
+		select {
+		case <-a.stopRepush:
+			return
+		case <-t.C:
+			a.frameMu.Lock()
+			if len(a.lastFrame) > 0 && time.Since(a.lastPush) > 500*time.Millisecond {
+				a.lastPush = time.Now()
+				a.pushLocked()
+			}
+			a.frameMu.Unlock()
+		}
+	}
+}
+
+// blockNull drives a pipeline to NULL and WAITS for the state change to complete (with a timeout
+// backstop), so the element's OS resources are released before we drop it. Plain async SetState(NULL)
+// returns before the d3d12 WGC screen-capture session is actually freed — the NEXT room's capture
+// then gets no frames (verified: room 2 video froze at ~1 fps). BlockSetState fixes that; the timeout
+// keeps a wedged nvcodec/WGC teardown from hanging Close past the 10 s media-teardown watchdog.
+func blockNull(p *gst.Pipeline) {
+	if p == nil {
+		return
+	}
+	done := make(chan struct{})
+	go func() { defer close(done); _ = p.BlockSetState(gst.StateNull) }()
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+	}
+}
+
+// setCapturing opens/closes the desktop-frame gate. Design A gates in Go (the `capturing` flag, read
+// by cacheAndPush); zero-copy has no Go frame path to gate, so it closes the media pipeline's valve
+// instead. Both leave the client on the last decoded GAME frame — never the desktop.
+func (a *App) setCapturing(on bool) {
+	a.capturing.Store(on)
+	if g := a.videoGate; g != nil {
+		g(!on) // valve drop == not capturing
+	}
+}
+
+// stopVideoOnly stops live desktop frames reaching the stream (privacy: called from the exit-watcher
+// the moment the game dies). The pipeline stays PLAYING either way — a d3d12 WGC session can't be
+// PAUSE/NULL-resumed in-process. Audio stays alive. Idempotent.
+func (a *App) stopVideoOnly() {
+	a.setCapturing(false)
+}
+
+// releaseVideo drives the capture pipeline to NULL and FREES it, so the d3d12 WGC session is gone
+// before the next room builds a fresh one. go-gst unrefs GstObjects via a runtime finalizer, so after
+// dropping our reference we force a GC (with a yield between) to run it — else the old WGC session
+// lingers and the next pipeline gets no frames (the room-2 freeze). Idempotent.
+func (a *App) releaseVideo() {
+	a.pipeMu.Lock()
+	p := a.videoPipe
+	a.videoPipe = nil
+	a.pipeMu.Unlock()
+	if p == nil {
+		return
+	}
+	blockNull(p) // stop capture at the element level (releases the WGC frame pool)
+	p = nil      // drop the last Go reference so the object is collectible
+	runtime.GC()
+	time.Sleep(60 * time.Millisecond) // let the finalizer goroutine run gst_object_unref → free
+	runtime.GC()
+}
+
+// stopPipelines tears down both pipelines and the re-push loop. Idempotent, and safe to call when
+// Start() never ran (stopRepush is nil on a failed room start — closing it would panic, which used to
+// take down the whole worker on any prepare 409 / launch failure, W1).
+func (a *App) stopPipelines() {
+	a.stopWindowCapture() // window mode: stop the shm reader + kill the helper (no-op in monitor mode)
+	if a.stopRepush != nil {
+		select {
+		case <-a.stopRepush:
+		default:
+			close(a.stopRepush)
+		}
+	}
+	a.setCapturing(false)
+	a.releaseVideo() // free the video pipe + WGC session so the NEXT room rebuilds cleanly
+	a.pipeMu.Lock()
+	defer a.pipeMu.Unlock()
+	if a.audioPipe != nil {
+		blockNull(a.audioPipe) // audio IS per-room (PID/CABLE) — fully release it
+		a.audioPipe = nil
+	}
+}
diff --git a/pkg/worker/caged/capture/sudovda.go b/pkg/worker/caged/capture/sudovda.go
new file mode 100644
index 0000000..2cfe5e4
--- /dev/null
+++ b/pkg/worker/caged/capture/sudovda.go
@@ -0,0 +1,352 @@
+package capture
+
+// SudoVDA control — the P4 virtual-display isolation path. Instead of capturing a PHYSICAL monitor
+// (which puts the game on the owner's desktop), the worker creates a HIDDEN SudoVDA virtual display
+// per room, points the capture pipeline at it, and destroys it on close. SudoVDA is the same indirect
+// display driver Apollo bundles (C:\Program Files\Apollo\drivers\sudovda); it has no CLI, so we speak
+// its IOCTL protocol directly (proven standalone before wiring — see the memory/plan). Protocol from
+// Apollo third-party/sudovda/sudovda-ioctl.h.
+
+import (
+	"encoding/binary"
+	"fmt"
+	"syscall"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// stableMonitorGUID is a FIXED identity for this worker's virtual display. Using one constant GUID for
+// every room makes Windows REUSE a single monitor devnode (toggling it present/non-present) instead of
+// spawning — and orphaning — a fresh non-present devnode per room, which is what piled up the
+// "Generic Monitor (MTArcadeVD)" ghosts in Device Manager. One capture worker serves one room at a time,
+// so a single shared identity never collides. Pairs with the boot-time reap in App.Init (remove any
+// orphan left by a crashed prior instance) and the always-on remove in closeRoomDisplay.
+var stableMonitorGUID = [16]byte{0x4d, 0x54, 0x41, 0x72, 0x63, 0x61, 0x64, 0x65, 0x56, 0x44, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05}
+
+var (
+	setupapi                             = syscall.NewLazyDLL("setupapi.dll")
+	procSetupDiGetClassDevsW             = setupapi.NewProc("SetupDiGetClassDevsW")
+	procSetupDiEnumDeviceInterfaces      = setupapi.NewProc("SetupDiEnumDeviceInterfaces")
+	procSetupDiGetDeviceInterfaceDetailW = setupapi.NewProc("SetupDiGetDeviceInterfaceDetailW")
+	procSetupDiDestroyDeviceInfoList     = setupapi.NewProc("SetupDiDestroyDeviceInfoList")
+)
+
+// SudoVDA control-device interface GUID {e5bcc234-1e0c-418a-a0d4-ef8b7501414d}.
+var sudovdaInterfaceGUID = windows.GUID{
+	Data1: 0xe5bcc234, Data2: 0x1e0c, Data3: 0x418a,
+	Data4: [8]byte{0xa0, 0xd4, 0xef, 0x8b, 0x75, 0x01, 0x41, 0x4d},
+}
+
+const (
+	digcfPresent         = 0x02
+	digcfDeviceInterface = 0x10
+
+	// CTL_CODE(FILE_DEVICE_UNKNOWN=0x22, fn, METHOD_BUFFERED=0, FILE_ANY_ACCESS=0).
+	ioctlAddVirtualDisplay    = 0x00222000 // fn 0x800
+	ioctlRemoveVirtualDisplay = 0x00222004 // fn 0x801
+	ioctlDriverPing           = 0x00222220 // fn 0x888
+)
+
+type spDeviceInterfaceData struct {
+	cbSize             uint32
+	interfaceClassGUID windows.GUID
+	flags              uint32
+	reserved           uintptr
+}
+
+// vddAddParams mirrors VIRTUAL_DISPLAY_ADD_PARAMS (56 bytes: 3×u32 + GUID(16) + 2×CHAR[14]). The Go
+// layout matches the C struct exactly (byte arrays are 1-aligned, so no padding creeps in).
+type vddAddParams struct {
+	width        uint32
+	height       uint32
+	refresh      uint32
+	monitorGUID  [16]byte
+	deviceName   [14]byte
+	serialNumber [14]byte
+}
+
+// vda is an open handle to the SudoVDA control device. One is opened at Init and reused for the
+// worker's life; displays are ADD/REMOVE'd per room against it.
+type vda struct{ h windows.Handle }
+
+// openVDA enumerates the SudoVDA control interface and opens it. NON-elevated works: the driver's INF
+// grants Everyone GRGW. Returns an error the caller degrades on (fall back to the physical monitor).
+func openVDA() (*vda, error) {
+	set, _, err := procSetupDiGetClassDevsW.Call(
+		uintptr(unsafe.Pointer(&sudovdaInterfaceGUID)), 0, 0,
+		uintptr(digcfPresent|digcfDeviceInterface))
+	if set == 0 || set == ^uintptr(0) { // INVALID_HANDLE_VALUE
+		return nil, fmt.Errorf("SetupDiGetClassDevs: %v", err)
+	}
+	defer procSetupDiDestroyDeviceInfoList.Call(set)
+
+	var did spDeviceInterfaceData
+	did.cbSize = uint32(unsafe.Sizeof(did))
+	if r, _, e := procSetupDiEnumDeviceInterfaces.Call(set, 0,
+		uintptr(unsafe.Pointer(&sudovdaInterfaceGUID)), 0, uintptr(unsafe.Pointer(&did))); r == 0 {
+		return nil, fmt.Errorf("SudoVDA interface absent (driver not installed?): %v", e)
+	}
+
+	var reqSize uint32
+	procSetupDiGetDeviceInterfaceDetailW.Call(set, uintptr(unsafe.Pointer(&did)), 0, 0,
+		uintptr(unsafe.Pointer(&reqSize)), 0)
+	if reqSize == 0 {
+		return nil, fmt.Errorf("SetupDiGetDeviceInterfaceDetail size query returned 0")
+	}
+	buf := make([]byte, reqSize)
+	// SP_DEVICE_INTERFACE_DETAIL_DATA_W: cbSize field = 8 on 64-bit; DevicePath (WCHAR) begins at
+	// byte offset 4 (right after the DWORD cbSize).
+	binary.LittleEndian.PutUint32(buf[0:], 8)
+	if r, _, e := procSetupDiGetDeviceInterfaceDetailW.Call(set, uintptr(unsafe.Pointer(&did)),
+		uintptr(unsafe.Pointer(&buf[0])), uintptr(reqSize), 0, 0); r == 0 {
+		return nil, fmt.Errorf("SetupDiGetDeviceInterfaceDetail: %v", e)
+	}
+	path := windows.UTF16PtrToString((*uint16)(unsafe.Pointer(&buf[4])))
+	pathPtr, err := windows.UTF16PtrFromString(path)
+	if err != nil {
+		return nil, fmt.Errorf("device path %q: %w", path, err)
+	}
+	h, err := windows.CreateFile(pathPtr,
+		windows.GENERIC_READ|windows.GENERIC_WRITE,
+		windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil,
+		windows.OPEN_EXISTING, 0, 0)
+	if err != nil {
+		return nil, fmt.Errorf("open SudoVDA device: %w", err)
+	}
+	return &vda{h: h}, nil
+}
+
+func (v *vda) closeDev() {
+	if v != nil && v.h != 0 {
+		windows.CloseHandle(v.h)
+		v.h = 0
+	}
+}
+
+// add creates a virtual display at w×h@fps, identified by mon (used later to remove it).
+func (v *vda) add(w, h, fps uint32, mon [16]byte) error {
+	p := vddAddParams{width: w, height: h, refresh: fps, monitorGUID: mon}
+	copy(p.deviceName[:], "MTArcadeVD")
+	copy(p.serialNumber[:], "MTA0001")
+	var out [12]byte // VIRTUAL_DISPLAY_ADD_OUT { LUID AdapterLuid; UINT TargetId } — unused here
+	var ret uint32
+	if err := windows.DeviceIoControl(v.h, ioctlAddVirtualDisplay,
+		(*byte)(unsafe.Pointer(&p)), uint32(unsafe.Sizeof(p)),
+		&out[0], uint32(len(out)), &ret, nil); err != nil {
+		return fmt.Errorf("IOCTL_ADD_VIRTUAL_DISPLAY: %w", err)
+	}
+	return nil
+}
+
+// ping resets the driver watchdog so the display isn't auto-reaped. Errors are ignored (the display
+// staying alive is what matters; a lost ping just risks one reap the next tick re-covers).
+func (v *vda) ping() {
+	var out [8]byte
+	var ret uint32
+	_ = windows.DeviceIoControl(v.h, ioctlDriverPing, nil, 0, &out[0], uint32(len(out)), &ret, nil)
+}
+
+func (v *vda) remove(mon [16]byte) error {
+	var ret uint32
+	return windows.DeviceIoControl(v.h, ioctlRemoveVirtualDisplay,
+		&mon[0], uint32(len(mon)), nil, 0, &ret, nil)
+}
+
+// ── Per-room lifecycle ──────────────────────────────────────────────────────────────────────────
+
+// isOnConsole reports whether the worker's session is the physical console session. SudoVDA is an
+// indirect display driver (IDD): its virtual displays only ATTACH in the console session, alongside the
+// real GPU displays (monitors may be POWERED OFF — headless is fine; it's an RDP session that isn't).
+// In an RDP/remote session the ADD 'succeeds' but no monitor ever surfaces, so there we skip the vdisplay
+// and just capture the session's own display instead. Recomputed live per room since RDP can connect or
+// disconnect while the worker runs.
+func isOnConsole() bool {
+	var mySess uint32
+	_ = windows.ProcessIdToSessionId(windows.GetCurrentProcessId(), &mySess)
+	return mySess == windows.WTSGetActiveConsoleSessionId()
+}
+
+// mySessionId returns the worker's own Windows session id.
+func mySessionId() uint32 {
+	var s uint32
+	_ = windows.ProcessIdToSessionId(windows.GetCurrentProcessId(), &s)
+	return s
+}
+
+var (
+	wtsapi32                        = windows.NewLazySystemDLL("wtsapi32.dll")
+	procWTSQuerySessionInformationW = wtsapi32.NewProc("WTSQuerySessionInformationW")
+	procWTSFreeMemory               = wtsapi32.NewProc("WTSFreeMemory")
+)
+
+// WTS_CONNECTSTATE_CLASS values we care about.
+const (
+	wtsConnectStateClass = 8 // WTSConnectState info class
+	wtsActive            = 0 // WTSActive — someone is attached (console or live RDP)
+	wtsConnected         = 1
+	wtsDisconnected      = 4 // WTSDisconnected — session exists but nothing is attached (RDP detached)
+	wtsIdle              = 5
+)
+
+// sessionConnectState returns the worker session's WTS connect state and whether the query succeeded.
+// This distinguishes an ACTIVE session (owner attached — never disrupt) from a DISCONNECTED one (RDP
+// detached → safe to reattach to the console). Complements isOnConsole (which only tells console vs not).
+func sessionConnectState() (uint32, bool) {
+	var pbuf uintptr
+	var bytesRet uint32
+	r, _, _ := procWTSQuerySessionInformationW.Call(
+		0, // WTS_CURRENT_SERVER_HANDLE
+		uintptr(mySessionId()),
+		uintptr(wtsConnectStateClass),
+		uintptr(unsafe.Pointer(&pbuf)),
+		uintptr(unsafe.Pointer(&bytesRet)))
+	if r == 0 || pbuf == 0 {
+		return 0, false
+	}
+	state := *(*uint32)(unsafe.Pointer(pbuf))
+	procWTSFreeMemory.Call(pbuf)
+	return state, true
+}
+
+// wtsStateName renders a WTS connect state for logs.
+func wtsStateName(s uint32) string {
+	switch s {
+	case wtsActive:
+		return "Active"
+	case wtsConnected:
+		return "Connected"
+	case wtsDisconnected:
+		return "Disconnected"
+	case wtsIdle:
+		return "Idle"
+	default:
+		return fmt.Sprintf("state-%d", s)
+	}
+}
+
+// logSessionContext records which session the worker booted into and what that means for the vdisplay.
+func (a *App) logSessionContext() {
+	var mySess uint32
+	_ = windows.ProcessIdToSessionId(windows.GetCurrentProcessId(), &mySess)
+	consoleSess := windows.WTSGetActiveConsoleSessionId()
+	if mySess == consoleSess {
+		a.log.Info().Msgf("capture: on the console session %d — the hidden virtual display is available (monitors may be OFF; that's fine)", mySess)
+		return
+	}
+	a.log.Warn().Msgf("capture: on a remote/RDP session (worker session=%d, console session=%d) — the hidden "+
+		"virtual display can't attach here, so capture rooms will be REFUSED (no desktop capture). Start capture "+
+		"rooms when not RDP'd into the box; isolated capture over RDP is planned via WGC window capture.", mySess, consoleSess)
+}
+
+// reapOrphanDisplay best-effort removes a leftover virtual display from a crashed prior worker instance
+// (same stable GUID). Harmless no-op when none exists; keeps at most one MTArcadeVD devnode around.
+func (v *vda) reapOrphanDisplay() { _ = v.remove(stableMonitorGUID) }
+
+// OpenRoomDisplay creates the room's hidden virtual display and repoints a.hmonitor at it, so both
+// pipeline paths (zero-copy VideoSrcChain and design-A startVideoPipeline) capture it. Called by the
+// coordinator's capture branch BEFORE VideoSrcChain — that is the load-bearing ordering: VideoSrcChain
+// bakes monitor-handle into the media pipe before LoadApp runs, so this must run first. Any failure
+// degrades gracefully to the physical monitor (a.hmonitor unchanged) rather than failing the room.
+func (a *App) OpenRoomDisplay() {
+	if !a.conf.VirtualDisplay || a.vda == nil {
+		return
+	}
+	// The physical/live handle was cached at BOOT; the display topology may have changed since (an RDP
+	// connect/disconnect, a monitor sleeping, a resolution change all invalidate the old HMONITOR and make
+	// d3d12 capture fail with "Failed to prepare capture object"). Re-pick it now so we always capture a
+	// currently-valid display, whether that ends up being the vdisplay or this session's own display.
+	a.refreshPhysMonitor()
+	// Over RDP the virtual display can't attach, and we must NOT fall back to capturing the session's own
+	// desktop — that would splatter the game across the owner's working screen. Skip the vdisplay here (so
+	// there's zero SudoVDA add/remove churn and zero ghost devnodes on RDP); LoadApp refuses the room
+	// outright when not on the console. Isolated capture over RDP needs WGC window capture (planned).
+	if !isOnConsole() {
+		a.log.Warn().Msg("capture: remote/RDP session — isolated capture unavailable here; the room will be refused (no desktop capture)")
+		return
+	}
+	mon := stableMonitorGUID
+	before := map[string]bool{}
+	for _, m := range enumMonitors() {
+		before[m.device] = true
+	}
+	if err := a.vda.add(uint32(a.width()), uint32(a.height()), uint32(a.fps()), mon); err != nil {
+		a.log.Error().Err(err).Msg("capture: virtual-display ADD failed — capturing the physical monitor instead")
+		return
+	}
+	// Windows surfaces the new monitor a beat after ADD; find it by diffing the device set.
+	var found *monitorInfo
+	deadline := time.Now().Add(5 * time.Second)
+	for found == nil && time.Now().Before(deadline) {
+		time.Sleep(150 * time.Millisecond)
+		for _, m := range enumMonitors() {
+			if !before[m.device] {
+				mm := m
+				found = &mm
+				break
+			}
+		}
+	}
+	if found == nil {
+		a.log.Error().Msg("capture: virtual display ADD'd but no new monitor appeared — reverting to physical")
+		_ = a.vda.remove(mon)
+		return
+	}
+	a.vdMon = mon
+	a.vdActive = true
+	a.vdX, a.vdY, a.vdW, a.vdH = found.x, found.y, found.width, found.height
+	a.hmonitor = found.handle
+	a.vdStop = make(chan struct{})
+	go a.vdPingLoop(a.vdStop)
+	a.log.Info().Msgf("capture: virtual display %s %dx%d @(%d,%d) hmonitor=%d — game hidden from the physical desktop",
+		found.device, found.width, found.height, found.x, found.y, found.handle)
+}
+
+// closeRoomDisplay stops the watchdog ping and removes the room's virtual display, restoring the
+// physical-monitor handle as the fallback for a room where the vdisplay fails to create. Idempotent.
+func (a *App) closeRoomDisplay() {
+	if !a.vdActive {
+		return
+	}
+	a.vdActive = false
+	if a.vdStop != nil {
+		close(a.vdStop)
+		a.vdStop = nil
+	}
+	if a.vda != nil {
+		if err := a.vda.remove(a.vdMon); err != nil {
+			a.log.Warn().Err(err).Msg("capture: virtual-display REMOVE failed (driver watchdog will reap it)")
+		}
+	}
+	a.hmonitor = a.physHmonitor
+}
+
+// refreshPhysMonitor re-enumerates displays and re-selects the configured physical monitor, updating the
+// fallback handle (and, since vdActive is still false when this runs, the live capture handle too). Called
+// at room start so a topology change since boot can't leave the fallback pointing at a dead HMONITOR.
+func (a *App) refreshPhysMonitor() {
+	mons := enumMonitors()
+	if h, chosen, ok := pickMonitor(mons, a.conf.MonitorIndex); ok {
+		a.physHmonitor = h
+		if !a.vdActive {
+			a.hmonitor = h
+		}
+		a.log.Info().Msgf("capture: physical fallback monitor refreshed → %s (%dx%d hmonitor=%d)", chosen.device, chosen.width, chosen.height, h)
+	}
+}
+
+func (a *App) vdPingLoop(stop chan struct{}) {
+	t := time.NewTicker(time.Second)
+	defer t.Stop()
+	for {
+		select {
+		case <-stop:
+			return
+		case <-t.C:
+			if a.vda != nil {
+				a.vda.ping()
+			}
+		}
+	}
+}
diff --git a/pkg/worker/caged/capture/wincapture.go b/pkg/worker/caged/capture/wincapture.go
new file mode 100644
index 0000000..6dd8a84
--- /dev/null
+++ b/pkg/worker/caged/capture/wincapture.go
@@ -0,0 +1,537 @@
+package capture
+
+// Window-capture mode (captureMode: window). Instead of screen-capturing a monitor (the SudoVDA/
+// d3d12screencapturesrc path), the worker launches the game, parks its window fully OFF-SCREEN
+// (borderless, never focused), and spawns the external ArcadeCaptureHost helper to WGC-capture that
+// window BY HWND. The helper publishes packed BGRA frames into a shared-memory ring this file reads
+// and feeds into the SAME design-A appsrc ingest (cacheAndPush → videoCb), so ABR / per-room codec /
+// keyframes / the re-push ticker / black-on-exit all reuse unchanged.
+//
+// Why a separate helper: WGC won't compile in our mingw/ucrt64 GStreamer toolchain (WinRT/WRL headers
+// don't emit the __FITypedEventHandler typedefs mingw needs — hard wall). .NET 10 has first-class WGC
+// projections, so the capture lives in a tiny .NET process (src/ArcadeCaptureHost). A WGC/D3D crash
+// there stays out of the worker. Window capture works in ANY session (console OR RDP) because it grabs
+// the window's DWM visual, which composits even off-screen (frames only stop while MINIMIZED — hence
+// the minimize guard). The IPC protocol is defined identically here and in SharedFrameRing.cs.
+//
+// The shared-memory ring header (little-endian; x64):
+//   0  u32 magic='MTWC'  4 u32 version  8 u32 width  12 u32 height  16 u32 stride  20 u32 slotCount
+//   24 u32 slotSize  28 u32 generation  32 i32 latestSlot  40 u64 frameSeq  48 u64 qpc
+// then slotCount slots of (8-byte seq + slotSize pixels) at 64 + i*(8+slotSize).
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+const (
+	shmMagic       = 0x4357544D // 'M','T','W','C' as a LE u32
+	shmHeaderSize  = 64
+	offMagic       = 0
+	offWidth       = 8
+	offHeight      = 12
+	offStride      = 16
+	offSlotSize    = 24
+	offGeneration  = 28
+	offLatestSlot  = 32
+	offFrameSeq    = 40
+	fileMapReadCap = 0x0004 // FILE_MAP_READ
+)
+
+var (
+	kernel32           = windows.NewLazySystemDLL("kernel32.dll")
+	procOpenFileMapW   = kernel32.NewProc("OpenFileMappingW")
+	procGetSystemMetr = user32.NewProc("GetSystemMetrics")
+	procIsIconic      = user32.NewProc("IsIconic")
+)
+
+const (
+	smXVirtualScreen  = 76
+	smYVirtualScreen  = 77
+	smCXVirtualScreen = 78
+	swShowNoActivate  = 4 // SW_SHOWNOACTIVATE
+	swRestore         = 9 // SW_RESTORE
+)
+
+// windowMode reports whether this room captures a window (vs a monitor). Default = window; a config
+// that explicitly sets captureMode:"monitor" gets the legacy SudoVDA/monitor path.
+func (a *App) windowMode() bool {
+	switch a.conf.CaptureMode {
+	case "monitor":
+		return false
+	case "window", "":
+		return a.conf.HelperPath != "" || a.conf.CaptureMode == "window"
+	default:
+		return false
+	}
+}
+
+func ld32(addr uintptr) uint32 { return atomic.LoadUint32((*uint32)(unsafe.Pointer(addr))) }
+func ld64(addr uintptr) uint64 { return atomic.LoadUint64((*uint64)(unsafe.Pointer(addr))) }
+
+// reattachTaskName is the on-demand elevated task that runs tscon /dest:console. Registered ONCE by
+// Eric (scripts/register-reattach-console-task.ps1) as SYSTEM/Highest with an ACL that lets the
+// non-elevated worker start it; the worker only triggers it (schtasks /Run).
+const reattachTaskName = "MovieTheater - Reattach Console"
+
+// reattachEnabled reports the config knob (default TRUE — *bool nil means the key was absent).
+func (a *App) reattachEnabled() bool {
+	return a.conf.ReattachConsole == nil || *a.conf.ReattachConsole
+}
+
+// maybeReattachConsole runs at capture-room start (window mode, before the game launches). If the
+// worker's session is RDP-DISCONNECTED, it reattaches the session to the physical console so the game
+// creates its window on the real high-refresh displays and capture runs at full rate (60fps) instead
+// of the stalled/32Hz disconnected-DWM rate. It NEVER fires while the session is Active — tscon then
+// would forcibly kick a live RDP owner to the console mid-work (a hard "no"). Everything degrades
+// gracefully: query fails / task missing / still disconnected after the poll → log loudly and return
+// so the room proceeds anyway (a reduced-rate or stalled room still beats no room).
+func (a *App) maybeReattachConsole() {
+	if !a.windowMode() || !a.reattachEnabled() {
+		return
+	}
+	state, ok := sessionConnectState()
+	if !ok {
+		a.log.Warn().Msg("capture(window): could not query session connect state — skipping console reattach")
+		return
+	}
+	a.log.Info().Msgf("capture(window): session %d connect state = %s (console=%v)", mySessionId(), wtsStateName(state), isOnConsole())
+	if state == wtsActive {
+		return // owner attached (console or live RDP) — NEVER disrupt; Active-RDP rooms stay reduced-rate by design
+	}
+	if state != wtsDisconnected {
+		return // Connected/Idle/etc — don't touch a session we don't understand
+	}
+
+	a.log.Warn().Msgf("capture(window): session %d is DISCONNECTED (RDP detached) — reattaching to the console for full-rate capture", mySessionId())
+	a.writeReattachSentinel() // hand the SYSTEM task the exact session id (robust vs auto-detect)
+	if out, err := exec.Command("schtasks", "/Run", "/TN", reattachTaskName).CombinedOutput(); err != nil {
+		a.log.Error().Err(err).Msgf("capture(window): could not start %q (%s) — register it ONCE elevated via "+
+			"scripts/register-reattach-console-task.ps1. Continuing the room at reduced/stalled rate.",
+			reattachTaskName, strings.TrimSpace(string(out)))
+		return
+	}
+	// The console switch + display topology need a beat to settle; poll for Active-on-console.
+	deadline := time.Now().Add(10 * time.Second)
+	for time.Now().Before(deadline) {
+		time.Sleep(500 * time.Millisecond)
+		if st, ok := sessionConnectState(); ok && st == wtsActive && isOnConsole() {
+			a.log.Info().Msg("capture(window): session reattached to the console (Active) — full-rate capture available")
+			return
+		}
+	}
+	a.log.Warn().Msg("capture(window): session still not on the console after 10s — proceeding with the room anyway (reduced rate or stalled DWM)")
+}
+
+// writeReattachSentinel writes the worker's session id next to the helper/reattach script (bin dir), so
+// the SYSTEM task's reattach-console.ps1 tscons the EXACT right session rather than guessing.
+func (a *App) writeReattachSentinel() {
+	if a.conf.HelperPath == "" {
+		return
+	}
+	path := filepath.Join(filepath.Dir(a.conf.HelperPath), ".reattach-session")
+	_ = os.WriteFile(path, []byte(strconv.FormatUint(uint64(mySessionId()), 10)), 0644)
+}
+
+// startWindowCapture launches the helper for hwnd and arms the frame path — v2 (D3D11 shared-texture
+// zero-copy) when windowZeroCopy is enabled AND the helper advertises texShare AND the worker can open
+// the shared textures; otherwise v1 (the shm pixel ring). Every v2 failure falls back to v1 for this
+// room (respawning the helper without --texshare when it had already entered texshare mode). Returns an
+// error only on a hard failure the caller can't recover (helper won't exec / ring never appears).
+func (a *App) startWindowCapture(hwnd uintptr) error {
+	if a.conf.HelperPath == "" {
+		return fmt.Errorf("captureMode window but no helperPath configured")
+	}
+	if _, err := os.Stat(a.conf.HelperPath); err != nil {
+		return fmt.Errorf("helper not found at %s: %w", a.conf.HelperPath, err)
+	}
+
+	wantTS := a.windowZeroCopyEnabled() && a.d11Sink != nil
+	shm, evt := a.newShmNames()
+	ri, err := a.spawnHelper(hwnd, shm, evt, wantTS)
+	if err != nil {
+		return err
+	}
+
+	if wantTS && ri != nil && ri.TexShare {
+		if a.armWindowZeroCopy(ri) {
+			a.log.Info().Msgf("capture(window): v2 armed — %d shared textures, luid=%d helperPid=%d", len(a.texHandles), a.texLuid, a.helperPid)
+			if err := a.openShm(shm, evt); err != nil { // CONTROL channel (slot/seq), not pixels
+				a.log.Error().Err(err).Msg("capture(window): v2 control shm open failed — falling back to v1")
+			} else {
+				return nil
+			}
+		}
+		// v2 could not be armed but the helper is in texshare mode (publishing no pixels) → respawn v1.
+		a.log.Warn().Msg("capture(window): D3D11 zero-copy setup failed — respawning helper in v1 (shm readback) mode")
+		if a.d11Sink != nil {
+			a.d11Sink.DeinitD3D11ZeroCopy()
+		}
+		a.winZC = false
+		a.killHelperOnly()
+		shm, evt = a.newShmNames()
+		if _, err := a.spawnHelper(hwnd, shm, evt, false); err != nil {
+			return err
+		}
+	}
+
+	if err := a.openShm(shm, evt); err != nil {
+		return fmt.Errorf("open capture shm: %w", err)
+	}
+	return nil
+}
+
+// newShmNames mints a fresh shared-memory + event name pair.
+func (a *App) newShmNames() (shm, evt string) {
+	shm = fmt.Sprintf("mtwc-%d-%d", os.Getpid(), time.Now().UnixNano())
+	return shm, shm + "-evt"
+}
+
+// spawnHelper starts ArcadeCaptureHost for hwnd, waits for its `ready` line, and returns the parsed
+// ready info (nil on timeout — a slow helper is tolerated for v1; v2 needs the info and falls back if
+// it is missing). texshare adds --texshare so the helper shares GPU textures instead of pixels.
+func (a *App) spawnHelper(hwnd uintptr, shm, evt string, texshare bool) (*readyInfo, error) {
+	args := []string{
+		"--hwnd", strconv.FormatUint(uint64(hwnd), 10),
+		"--shm", shm, "--event", evt,
+		"--width", strconv.Itoa(a.width()),
+		"--height", strconv.Itoa(a.height()),
+		"--fps", strconv.Itoa(a.fps()),
+	}
+	if texshare {
+		args = append(args, "--texshare")
+	}
+	cmd := exec.Command(a.conf.HelperPath, args...)
+	stdin, err := cmd.StdinPipe() // HELD OPEN — closing it makes the helper exit (its stdin watcher)
+	if err != nil {
+		return nil, fmt.Errorf("helper stdin pipe: %w", err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		return nil, fmt.Errorf("helper stdout pipe: %w", err)
+	}
+	if err := cmd.Start(); err != nil {
+		return nil, fmt.Errorf("helper start: %w", err)
+	}
+	a.helper = cmd
+	a.helperStdin = stdin
+	a.log.Info().Msgf("capture(window): helper pid %d hwnd=%#x shm=%s texshare=%v", cmd.Process.Pid, hwnd, shm, texshare)
+
+	ready := make(chan *readyInfo, 1)
+	go a.helperStdoutLoop(stdout, ready)
+	select {
+	case ri := <-ready:
+		return ri, nil
+	case <-time.After(8 * time.Second):
+		a.log.Warn().Msg("capture(window): helper not ready in 8s — continuing (video black until it recovers)")
+		return nil, nil
+	}
+}
+
+// killHelperOnly kills just the helper process (close stdin, then terminate) WITHOUT touching winStop /
+// the shm mapping — used to respawn the helper in a different mode (v2→v1 fallback) mid-setup.
+func (a *App) killHelperOnly() {
+	if a.helperStdin != nil {
+		a.helperStdin.Close()
+		a.helperStdin = nil
+	}
+	if a.helper != nil && a.helper.Process != nil {
+		done := make(chan struct{})
+		go func() { a.helper.Wait(); close(done) }()
+		select {
+		case <-done:
+		case <-time.After(2 * time.Second):
+			_ = a.helper.Process.Kill()
+		}
+		a.helper = nil
+	}
+}
+
+// helperStdoutLoop forwards the helper's JSON status lines into the worker log and delivers the parsed
+// first `ready` line on the channel (once, non-blocking).
+func (a *App) helperStdoutLoop(r io.ReadCloser, ready chan<- *readyInfo) {
+	sc := bufio.NewScanner(r)
+	sc.Buffer(make([]byte, 0, 8192), 1<<20)
+	sent := false
+	for sc.Scan() {
+		line := sc.Text()
+		if line == "" {
+			continue
+		}
+		a.log.Info().Msgf("capture(window) helper: %s", line)
+		if !sent && strings.Contains(line, `"event":"ready"`) {
+			ri := parseReady(line)
+			sent = true
+			select {
+			case ready <- ri:
+			default:
+			}
+		}
+	}
+}
+
+// openShm opens the helper's shared-memory ring + frame event and reads the fixed header.
+func (a *App) openShm(shm, evt string) error {
+	shmP, err := windows.UTF16PtrFromString(shm)
+	if err != nil {
+		return err
+	}
+	evtP, _ := windows.UTF16PtrFromString(evt)
+
+	var mh windows.Handle
+	for i := 0; i < 100; i++ { // the ring is created by the helper a beat after it starts
+		r, _, e := procOpenFileMapW.Call(uintptr(fileMapReadCap), 0, uintptr(unsafe.Pointer(shmP)))
+		if r != 0 {
+			mh = windows.Handle(r)
+			break
+		}
+		if i == 99 {
+			return fmt.Errorf("OpenFileMapping(%s): %v", shm, e)
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	addr, err := windows.MapViewOfFile(mh, fileMapReadCap, 0, 0, 0)
+	if err != nil {
+		windows.CloseHandle(mh)
+		return fmt.Errorf("MapViewOfFile: %w", err)
+	}
+	if m := ld32(addr + offMagic); m != shmMagic {
+		windows.UnmapViewOfFile(addr)
+		windows.CloseHandle(mh)
+		return fmt.Errorf("bad shm magic 0x%08x", m)
+	}
+	eh, eerr := windows.OpenEvent(windows.SYNCHRONIZE, false, evtP)
+	if eerr != nil {
+		a.log.Warn().Err(eerr).Msg("capture(window): frame event unavailable — reader will poll")
+		eh = 0
+	}
+	a.shm = mh
+	a.shmAddr = addr
+	a.shmEvent = eh
+	a.shmW = int(ld32(addr + offWidth))
+	a.shmH = int(ld32(addr + offHeight))
+	a.shmStride = int(ld32(addr + offStride))
+	slotSize := int(ld32(addr + offSlotSize))
+	a.shmPerSlot = 8 + slotSize
+	a.log.Info().Msgf("capture(window): shm open %dx%d stride=%d slotSize=%d", a.shmW, a.shmH, a.shmStride, slotSize)
+	return nil
+}
+
+// shmReadLoop is the design-A frame source for window mode: it waits on the helper's frame event, reads
+// the latest slot under the seqlock, and hands the packed BGRA frame to cacheAndPush (→ videoCb, the
+// exact same ingest the monitor path uses). Dropped intermediate frames are fine (live stream); a
+// static screen is covered by the re-push ticker started alongside it.
+func (a *App) shmReadLoop() {
+	base := a.shmAddr
+	if base == 0 {
+		a.log.Error().Msg("capture(window): shmReadLoop with no mapping — no video")
+		return
+	}
+	stride := a.shmStride
+	h := a.shmH
+	perSlot := a.shmPerSlot
+	pixBytes := stride * h
+	scratch := make([]byte, pixBytes)
+	dur := time.Second / time.Duration(a.fps())
+	var lastSeq uint64
+	gen := ld32(base + offGeneration)
+
+	for {
+		select {
+		case <-a.winStop:
+			return
+		default:
+		}
+		if a.shmEvent != 0 {
+			windows.WaitForSingleObject(a.shmEvent, 500) // auto-reset; wake on a new frame or timeout
+		} else {
+			time.Sleep(8 * time.Millisecond)
+		}
+		select {
+		case <-a.winStop:
+			return
+		default:
+		}
+		fseq := ld64(base + offFrameSeq)
+		if fseq == lastSeq {
+			continue // no new frame — repushLoop keeps the last one alive
+		}
+		lastSeq = fseq
+		if g := ld32(base + offGeneration); g != gen {
+			gen = g
+			// Dims are normalized to the ring's fixed geometry by the helper, so downstream caps never
+			// change; log for observability (a real content-size change under an off-screen window).
+			a.log.Info().Msgf("capture(window): helper generation -> %d", g)
+		}
+		slot := int32(ld32(base + offLatestSlot))
+		if slot < 0 {
+			continue
+		}
+		seqOff := base + uintptr(shmHeaderSize+int(slot)*perSlot)
+		pixOff := seqOff + 8
+		ok := false
+		for attempt := 0; attempt < 5; attempt++ {
+			s1 := ld64(seqOff)
+			if s1&1 != 0 {
+				continue // writer mid-write; retry
+			}
+			src := unsafe.Slice((*byte)(unsafe.Pointer(pixOff)), pixBytes)
+			copy(scratch, src)
+			if ld64(seqOff) == s1 {
+				ok = true
+				break
+			}
+		}
+		if !ok {
+			continue // torn on every attempt — skip this frame
+		}
+		a.cacheAndPush(scratch, stride, dur)
+	}
+}
+
+// ── off-screen placement + minimize guard (window mode) ──────────────────────────────────────────
+
+// offScreenRect computes a rect fully outside the virtual desktop, sized to the capture geometry.
+// Recomputed per room because RDP connect/disconnect changes the desktop geometry.
+func (a *App) offScreenRect() (x, y, w, h int) {
+	vx, _, _ := procGetSystemMetr.Call(smXVirtualScreen)
+	vcx, _, _ := procGetSystemMetr.Call(smCXVirtualScreen)
+	x = int(int32(vx)) + int(int32(vcx)) + 1000 // 1000px past the right edge of everything
+	y = 0
+	return x, y, a.width(), a.height()
+}
+
+// placeOffScreen parks the game window off-screen (borderless, NEVER focused) and re-asserts until it
+// stays put for two consecutive checks — winning the SM64-Plus re-home race the same way placeOnVDisplay
+// does, but WITHOUT stealing the owner's foreground/keyboard/mouse (the whole point of window mode is
+// that the owner keeps working). The pad still reaches the unfocused window via
+// SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS (set at launch). Records the HWND for the minimize guard.
+func (a *App) placeOffScreen(pid int) {
+	x, y, w, h := a.offScreenRect()
+	a.winX, a.winY, a.winW, a.winH = x, y, w, h
+	target := fmt.Sprintf("@(%d,%d) %dx%d", x, y, w, h)
+	// The 10s budget is a SETTLE budget, and it is armed at FIRST SIGHT — not at launch. It used to
+	// cover discovery too, which made a slow-booting title unrecoverable: if no window had appeared by
+	// the deadline this returned with winHwnd still 0, and nothing ever looked again. windowGuardLoop
+	// no-ops on hwnd == 0 and startWindowCapture is never called, so the room stayed black for its
+	// whole life even once the window existed — and the "the guard will keep asserting it" warning was
+	// a lie, because the guard cannot assert a window that was never found. Discovery now runs until
+	// the room ends (winStop); the caller attaches late via awaitWinHwndUntil.
+	var deadline time.Time
+	firstSeen := false
+	settledStreak := 0
+	focusTargetPid = pid
+	for {
+		select {
+		case <-a.winStop:
+			return // room ended before the window ever appeared
+		default:
+		}
+		if firstSeen && time.Now().After(deadline) {
+			break
+		}
+		focusFoundHwnd = 0
+		procEnumWindows.Call(focusEnumWindow, 0)
+		found := focusFoundHwnd
+		if found == 0 {
+			time.Sleep(300 * time.Millisecond)
+			continue
+		}
+		atomic.StoreUintptr(&a.winHwnd, found)
+		l, t, r, b := windowRect(found)
+		if !firstSeen {
+			a.log.Info().Msgf("capture(window): game window %#x first seen @(%d,%d) %dx%d — parking off-screen %s",
+				found, l, t, r-l, b-t, target)
+			firstSeen = true
+			deadline = time.Now().Add(10 * time.Second) // settle budget starts at first sight
+		}
+		onTarget := int(l) == x && int(t) == y
+		a.placeBorderlessAt(found, x, y, w, h)
+		if onTarget {
+			settledStreak++
+			if settledStreak >= 2 {
+				a.log.Info().Msgf("capture(window): game window %#x settled off-screen %s", found, target)
+				return
+			}
+		} else {
+			settledStreak = 0
+		}
+		time.Sleep(400 * time.Millisecond)
+	}
+	a.log.Warn().Msgf("capture(window): game window never settled off-screen %s within 10s "+
+		"(title likely re-homes itself); the minimize/placement guard will keep asserting it", target)
+}
+
+// windowGuardLoop keeps the game window OFF-SCREEN and NOT minimized for the room's life. WGC stops
+// delivering frames while a window is minimized, so if the game (or anything) minimizes it we restore
+// it SHOWNOACTIVATE (no focus steal) and re-park it off-screen. Cheap 1 Hz poll; stops on winStop.
+func (a *App) windowGuardLoop() {
+	t := time.NewTicker(time.Second)
+	defer t.Stop()
+	for {
+		select {
+		case <-a.winStop:
+			return
+		case <-t.C:
+			hwnd := atomic.LoadUintptr(&a.winHwnd)
+			if hwnd == 0 {
+				continue
+			}
+			if r, _, _ := procIsIconic.Call(hwnd); r != 0 {
+				a.log.Info().Msgf("capture(window): window %#x was minimized — restoring off-screen (WGC needs it un-minimized)", hwnd)
+				procShowWindow.Call(hwnd, swShowNoActivate)
+				a.placeBorderlessAt(hwnd, a.winX, a.winY, a.winW, a.winH)
+			}
+		}
+	}
+}
+
+// stopWindowCapture tears down the shm reader, the helper (close stdin then terminate), and unmaps the
+// ring. Idempotent; safe when window mode was never started.
+func (a *App) stopWindowCapture() {
+	if a.winStop != nil {
+		select {
+		case <-a.winStop:
+		default:
+			close(a.winStop)
+		}
+	}
+	if a.helperStdin != nil {
+		a.helperStdin.Close() // signals the helper to exit
+		a.helperStdin = nil
+	}
+	if a.helper != nil && a.helper.Process != nil {
+		done := make(chan struct{})
+		go func() { a.helper.Wait(); close(done) }()
+		select {
+		case <-done:
+		case <-time.After(2 * time.Second):
+			_ = a.helper.Process.Kill()
+		}
+		a.helper = nil
+	}
+	if a.shmAddr != 0 {
+		windows.UnmapViewOfFile(a.shmAddr)
+		a.shmAddr = 0
+	}
+	if a.shm != 0 {
+		windows.CloseHandle(a.shm)
+		a.shm = 0
+	}
+	if a.shmEvent != 0 {
+		windows.CloseHandle(a.shmEvent)
+		a.shmEvent = 0
+	}
+	atomic.StoreUintptr(&a.winHwnd, 0)
+}
