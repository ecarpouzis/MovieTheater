+// NewFrontend implements Emulator interface for a Libretro frontend.
+func NewFrontend(conf config.Emulator, log *logger.Logger) (*Frontend, error) {
+	path, err := filepath.Abs(conf.LocalPath)
+	if err != nil {
+		return nil, fmt.Errorf("failed to use emulator path: %v, %w", conf.LocalPath, err)
+	}
+	if err := os.CheckCreateDir(path); err != nil {
+		return nil, fmt.Errorf("failed to create local path: %v, %w", conf.LocalPath, err)
+	}
+	log.Info().Msgf("Emulator save path is %v", path)
+
+	// we use the global Nanoarch instance from nanoarch
+	nano := nanoarch.NewNano(path)
+
+	log = log.Extend(log.With().Str("m", "Libretro"))
+	level := logger.Level(conf.Libretro.LogLevel)
+	nano.SetLogger(log.Extend(log.Level(level).With()))
+
+	// Check if room is on local storage, if not, pull from GCS to local storage
+	log.Info().Msgf("Local storage path: %v", conf.Storage)
+	if err := os.CheckCreateDir(conf.Storage); err != nil {
+		return nil, fmt.Errorf("failed to create local storage path: %v, %w", conf.Storage, err)
+	}
+
+	var store Storage = &StateStorage{Path: conf.Storage}
+	if conf.Libretro.SaveCompression {
+		store = &ZipStorage{Storage: store}
+	}
+
+	// set global link to the Libretro
+	f := &Frontend{
+		conf:      conf,
+		done:      make(chan struct{}),
+		log:       log,
+		onAudio:   noAudio,
+		onData:    noData,
+		onVideo:   noVideo,
+		storage:   store,
+		th:        conf.Threads,
+		SpinBatch: 2048, // ~ 3GHz 3M / 2048 calls
+	}
+	f.linkNano(nano)
+
+	if conf.Libretro.DebounceMs > 0 {
+		t := time.Duration(conf.Libretro.DebounceMs) * time.Millisecond
+		f.nano.SetVideoDebounce(t)
+		f.log.Debug().Msgf("set debounce time: %v", t)
+	}
+
+	return f, nil
+}
+
+func (f *Frontend) LoadCore(emu string) {
+	conf := f.conf.GetLibretroCoreConfig(emu)
+
+	libExt := ""
+	if ar, err := f.conf.Libretro.Cores.Repo.Guess(); err == nil {
+		libExt = ar.Ext
+	} else {
+		f.log.Warn().Err(err).Msg("system arch guesser failed")
+	}
+
+	meta := nanoarch.Metadata{
+		AutoGlContext:   conf.AutoGlContext,
+		FrameDup:        f.conf.Libretro.Dup,
+		Hacks:           conf.Hacks,
+		HasVFR:          conf.VFR,
+		Hid:             conf.Hid,
+		IsGlAllowed:     conf.IsGlAllowed,
+		LibPath:         conf.Lib,
+		Options:         conf.Options,
+		Options4rom:     conf.Options4rom,
+		Fps4rom:         conf.Fps4rom,
+		UsesLibCo:       conf.UsesLibCo,
+		CoreAspectRatio: conf.CoreAspectRatio,
+		KbMouseSupport:  conf.KbMouseSupport,
+		LibExt:          libExt,
+	}
+	f.mu.Lock()
+	f.SaveStateFs = conf.SaveStateFs
+	f.NoSaveStates = conf.NoSaveStates
+	f.AudioMaster = conf.AudioMaster
+	if conf.AudioMaster {
+		f.log.Info().Msgf("%v: audio-mastered pacing (the audio clock may outrun the fps floor)", emu)
+	}
+	if conf.NoSaveStates {
+		f.log.Info().Msgf("%v: save-states are off for this core; progress lives on the memory card", emu)
+	}
+	if conf.UniqueSaveDir {
+		f.UniqueSaveDir = true
+		f.nano.SetSaveDirSuffix(f.storage.MainPath())
+		f.log.Debug().Msgf("Using unique dir for saves: %v", f.storage.MainPath())
+	}
+	// Drop a cache the current core build did not write. Must run HERE: the save dir is final by now
+	// (the block above may have re-pointed it), and the core reads its cache during the load that
+	// follows — context_reset, still inside this same call. A purge after that point would be a no-op.
+	f.purgeForeignCoreCache(conf, corePath(conf, libExt))
+	// Scale > 1 magnifies (2D cores: integer nearest upscale, which is what preserves pixel art and puts
+	// the 4:2:0 chroma plane back at native resolution). Scale < 1 SHRINKS, which is supersampling:
+	// render the core at N x native and average it down before the encoder sees it. That is the only
+	// anti-aliasing available to cores whose MSAA is inert under libretro's non-multisampled hw_render
+	// FBO (measured: mupen64plus and ppsspp produce BIT-IDENTICAL frames with MSAA on and off; only
+	// Dolphin, which owns its framebuffers, actually multisamples).
+	//
+	// The old gate was `> 1`, which silently ignored any fractional scale. round() in the media pipe
+	// already handles it (it rounds up to an even size), so this is the whole change. Pair a fractional
+	// scale with a SMOOTH scaleMethod (bilinear2): nearest would point-sample and defeat the purpose —
+	// downscaling with nearest doesn't anti-alias, it aliases.
+	scale := 1.0
+	if conf.Scale > 0 && conf.Scale != 1 {
+		scale = conf.Scale
+		f.log.Debug().Msgf("Scale: x%v (%s)", scale, map[bool]string{true: "supersample", false: "magnify"}[scale < 1])
+	}
+	f.storage.SetNonBlocking(conf.NonBlockingSave)
+	f.scale = scale
+	f.scaleM = conf.ScaleMethod
+	f.isGL = conf.IsGlAllowed
+	f.nano.CoreLoad(meta)
+	f.mu.Unlock()
+}
+
+func (f *Frontend) handleAudio(audio unsafe.Pointer, samples int) {
+	fr, _ := audioPool.Get().(*app.Audio)
+	if fr == nil {
+		fr = new(app.Audio)
+	}
+	// !to look if we need a copy
+	fr.Data = unsafe.Slice((*byte)(audio), samples<<1)
+	// due to audio buffering for opus fixed frames and const duration up in the hierarchy,
+	// we skip Duration here
+	f.onAudio(*fr)
+	audioPool.Put(fr)
+}
+
+func (f *Frontend) handleVideo(data []byte, delta time.Duration, fi nanoarch.FrameInfo) {
+	if f.conf.SkipLateFrames && f.skipVideo {
+		return
+	}
+
+	fr, _ := videoPool.Get().(*app.Video)
+	if fr == nil {
+		fr = new(app.Video)
+	}
+	fr.Frame.Data = data
+	fr.Frame.Tex = fi.Tex
+	fr.Frame.W = int(fi.W)
+	fr.Frame.H = int(fi.H)
+	fr.Frame.Stride = int(fi.Stride)
+	fr.Duration = delta
+
+	lastFrame = fr
+	f.onVideo(*fr)
+
+	videoPool.Put(fr)
+}
+
+func (f *Frontend) handleDup() {
+	if lastFrame != nil {
+		f.onVideo(*lastFrame)
+	}
+}
+
+func (f *Frontend) Shutdown() {
+	f.mu.Lock()
+	f.nano.Shutdown()
+	f.SetAudioCb(noAudio)
+	f.SetVideoCb(noVideo)
+	lastFrame = nil
+	f.mu.Unlock()
+	f.log.Debug().Msgf("frontend shutdown done")
+}
+
+func (f *Frontend) linkNano(nano *nanoarch.Nanoarch) {
+	f.nano = nano
+	if nano == nil {
+		return
+	}
+	f.nano.WaitReady() // start only when nano is available
+
+	f.nano.OnVideo = f.handleVideo
+	f.nano.OnAudio = f.handleAudio
+	f.nano.OnDup = f.handleDup
+}
+
+func (f *Frontend) SetVideoChangeCb(fn func()) {
+	if f.nano != nil {
+		f.nano.OnSystemAvInfo = fn
+	}
+}
+
+func (f *Frontend) Start() {
+	f.log.Debug().Msgf("frontend start")
+	if f.nano.Stopped.Load() {
+		f.log.Warn().Msgf("frontend stopped during the start")
+		f.mui.Lock()
+		defer f.mui.Unlock()
+		f.Shutdown()
+		return
+	}
+
+	if f.isGL {
+		// don't jump between threads
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+	}
+
+	f.mui.Lock()
+	f.done = make(chan struct{})
+	f.doneEvt = make(chan struct{})
+	f.nano.LastFrameTime = time.Now()
+
+	defer func() {
+		// FIRST, before anything that can take the process down with it (patch 0041). Both steps
+		// below can: a serialize can access-violate inside a core, and flycast corrupts the heap on
+		// teardown — and a dead worker harvests nothing, so the room used to end with the player's
+		// card still sitting in the worker's dirs, unvaulted. The card is cheap to copy and it IS
+		// the progress on the systems that have one. It goes first.
+		f.harvestCards()
+
+		// Save game on quit — UNCONDITIONALLY (patch 0031). Stock gated this on HasSave()
+		// ("only re-save if saved before"), which meant a session where nobody clicked Save
+		// harvested nothing and the vault's Continue slot stayed empty — and PS2 players
+		// couldn't click Save at all until patch 0030. One serialize at teardown costs
+		// nothing anyone can see; it runs before Shutdown so the core is still live.
+		if f.SaveOnClose && !f.NoSaveStates {
+			f.log.Debug().Msg("save on quit")
+			if err := f.Save(); err != nil {
+				f.log.Error().Err(err).Msg("save on quit failed")
+			}
+		}
+		f.mui.Unlock()
+		f.Shutdown()
+		// AND again after: the cores that DO survive teardown (Dolphin, PCSX2) flush their card on the
+		// way out, so this pass picks that up. It cannot undo the one above — vaulting never replaces
+		// a card with an older one (os.CopyTreeNewer).
+		f.harvestCards()
+		close(f.doneEvt)
+	}()
+
+	// skip_boot_restore => DEFERRED restore (patch 0032b): PCSX2 "successfully" unserializes one
+	// tick after init into a WEDGED black GS (then close-save re-serializes the wedge — a poison
+	// loop on the deterministic save id). But an in-session Load a few seconds in round-trips
+	// cleanly (verified live 2026-07-09). So heavy GL cores restore INTO A WARM VM: the same code
+	// path as a user pressing Load ~5s after boot, which is exactly what this schedules.
+	if f.HasSave() && f.nano.SkipBootRestore() {
+		go func() {
+			select {
+			case <-f.done:
+				return
+			case <-time.After(5 * time.Second):
+			}
+			if err := f.RestoreGameState(); err != nil {
+				f.log.Error().Err(err).Msg("deferred boot-restore failed; continuing unsaved")
+			} else {
+				f.log.Info().Msg("deferred boot-restore done (warm-VM resume)")
+			}
+		}()
+	}
+	if f.HasSave() && !f.nano.SkipBootRestore() && !f.NoSaveStates {
+		// advance 1 frame for Mupen, DOSBox save states
+		// loading will work if autostart is selected for DOSBox apps
+		f.Tick()
+		if err := f.RestoreGameState(); err != nil {
+			f.log.Error().Err(err).Msg("couldn't load a save file")
+		}
+	}
+
+	if f.conf.AutosaveSec > 0 {
+		// !to sync both for loops, can crash if the emulator starts later
+		go f.autosave(f.conf.AutosaveSec)
+	}
+
+	// The main loop of Libretro
+
+	targetFrameTimeNs := int64(float64(time.Second) / f.nano.VideoFramerate())
+
+	// stop sleeping and start spinning in the remaining 1ms
+	const spinThresholdNs = int64(1 * time.Millisecond)
+
+	// how many frames will be considered not normal
+	const lateFramesThreshold = 3
+
+	// How far an audio-mastered core may be pulled ABOVE its advertised fps to keep its audio clock
+	// fed, as a fraction of one frame. 2% covers PPSSPP's ~0.35-0.6% shortfall many times over while
+	// staying far below anything a player could perceive as fast (60.0 -> 61.2 fps worst case), and it
+	// is a hard ceiling: a core that stopped producing audio entirely could not drift beyond it.
+	const audioPullMax = 0.02
+
+	// How far behind the audio clock an audio-mastered core may fall and still REPAY it rather than have
+	// it forgiven. Sized off what repayment costs: at audioPullMax (2%) a 500 ms deficit takes ~25 s of
+	// imperceptibly-fast emulation to work off, which is fine; a multi-second desync would take minutes,
+	// which is not — that one gets forgiven, as before. Comfortably above any load stall we have measured
+	// (the worst PSP transition is ~60 ms; a cold gc boot ~110 ms).
+	const audioForgiveAfter = 500 * time.Millisecond
+
+	batch := max(f.SpinBatch, 1)
+
+	// AUDIO-DRIVEN PACING. We pace retro_run against the emulated AUDIO clock (the game should produce
+	// exactly sampleRate audio frames per real second) rather than a fixed video fps, with the video
+	// frame time kept as a MAX-RATE FLOOR (never faster than the core's fps; also the whole pace when a
+	// game is silent or a core emits no audio).
+	//
+	// Why: some cores emit a variable amount of emulated time per retro_run. flycast runs a Dreamcast
+	// game's 30fps sections at 2 vblanks per retro_run (2x the audio) but its 60fps menus at 1 vblank —
+	// so a fixed 59.94 pace runs gameplay at DOUBLE SPEED (Sonic Adventure, Jet Set Radio) while menus
+	// are correct. Pacing to audio makes each section play at its true rate automatically, with no
+	// per-game data (this is what stock emulators do — "sync to audio"). Constant-rate cores (PSP, 60fps
+	// DC, all 2D) produce audio at a steady sampleRate/fps per frame, so the floor dominates and behavior
+	// is unchanged.
+	sr := float64(f.nano.AudioSampleRate())
+	if sr <= 0 {
+		sr = 44100
+	}
+	audioEpoch := os.Nanotime() // real-time anchor of the audio clock
+	var audioFrames int64       // cumulative audio frames produced (the audio clock)
+	floorNext := os.Nanotime()  // earliest allowed time for the next tick (max-rate floor)
+
+	// pace-diag: every 5s, log what the emulator actually produced — ticks/s, audio frames/s (should
+	// track the core's sample rate), the worst single retro_run of the window, and how many ticks blew
+	// a 20ms budget. Steady audio/s while the player hears gaps = the problem is DOWNSTREAM of the
+	// emulator (encode/network/client).
+	//
+	// ⚠ DO NOT DELETE OR DEMOTE THIS TO Debug, despite it having started life as a temporary probe.
+	// It is now the GL worker's HEARTBEAT: nothing else logs periodically during a healthy room (ABR
+	// only logs on change), and the watchdog's wedge test is "the coordinator says this worker is BUSY
+	// but its log has been silent for >150s -> kill it" (scripts/watch-arcade-glworkers.ps1). Silence
+	// this line and a healthy long session looks exactly like a wedged one. The capture mod keeps its
+	// own 5s "capture tick" for the same reason.
+	diagWindow := os.Nanotime()
+	var diagTicks, diagSlow int64
+	var diagAudioBase int64
+	var diagMaxTickNs int64
+
+	// pace-diag II — the audio-underrun probe (2026-07-14). The four fields above CANNOT see the PSP
+	// crackle, and that blindness cost us a wrong verdict (we A/B'd two cores on maxTick, saw a wash,
+	// and rolled back the one that actually fixed the sound). They are blind structurally:
+	//
+	//   * audio/s reads ~100% of the sample rate on ANY arm, because the pacer TARGETS the audio clock.
+	//     It says what the loop asked for, not whether the core could deliver it.
+	//   * maxTick is the WORST retro_run of a 5 s window — an outlier. Repaying an audio deficit needs
+	//     the core to run <=2% FAST for seconds on end, which is a question about the MEAN frame cost.
+	//
+	// So measure the thing that decides whether a stall gets repaid or becomes a permanent hole in the
+	// stream: HEADROOM. sumTick/ticks is what a frame really costs; noSleep counts the ticks that had no
+	// spare time at all (the loop was already late leaving retro_run — at that point the core CANNOT run
+	// fast, so the deficit stands and the client's jitter buffer eats it, forever). deficit is the audio
+	// clock's live debt at window end, and forgiven counts the stalls the pacer gave up on repaying.
+	// A core that crackles should show: noSleep high, deficit climbing, forgiven > 0.
+	var diagSumTickNs int64
+	var diagNoSleep int64
+	var diagForgiven int64
+	var diagMaxDeficitNs int64
+
+	for {
+		select {
+		case <-f.done:
+			return
+		default:
+			tick0 := os.Nanotime()
+			f.Tick()
+			tickDur := os.Nanotime() - tick0
+			audioDelta := f.nano.TakeAudioFrames()
+			audioFrames += audioDelta
+			diagTicks++
+			diagSumTickNs += tickDur
+			if tickDur > diagMaxTickNs {
+				diagMaxTickNs = tickDur
+			}
+			if tickDur > 20*1e6 {
+				diagSlow++
+			}
+			if now := os.Nanotime(); now-diagWindow >= 5*1e9 {
+				winSec := float64(now-diagWindow) / 1e9
+				// Live audio debt: how far real time has run past where the audio the core produced says
+				// it should be. Positive = the client is owed samples that do not exist yet.
+				deficitNs := os.Nanotime() - (audioEpoch + int64(float64(audioFrames)/sr*1e9))
+				f.log.Info().Msgf(
+					"pace-diag: ticks/s=%.1f audio/s=%.0f maxTick=%.1fms slowTicks(>20ms)=%d "+
+						"meanTick=%.2fms noSleep=%.1f%% deficit=%.1fms maxDeficit=%.1fms forgiven=%d",
+					float64(diagTicks)/winSec, float64(audioFrames-diagAudioBase)/winSec,
+					float64(diagMaxTickNs)/1e6, diagSlow,
+					float64(diagSumTickNs)/float64(max(diagTicks, 1))/1e6,
+					100*float64(diagNoSleep)/float64(max(diagTicks, 1)),
+					float64(deficitNs)/1e6, float64(diagMaxDeficitNs)/1e6, diagForgiven)
+				diagWindow, diagTicks, diagSlow, diagMaxTickNs = now, 0, 0, 0
+				diagSumTickNs, diagNoSleep, diagForgiven, diagMaxDeficitNs = 0, 0, 0, 0
+				diagAudioBase = audioFrames
+			}
+
+			// Track mid-run fps changes (SET_SYSTEM_AV_INFO) so the floor follows the core's fps.
+			if fps := f.nano.VideoFramerate(); fps > 0 {
+				if nt := int64(float64(time.Second) / fps); nt != targetFrameTimeNs {
+					targetFrameTimeNs = nt
+				}
+			}
+
+			// Audio deadline: when real-time SHOULD be, given the audio produced so far.
+			audioDeadline := audioEpoch + int64(float64(audioFrames)/sr*1e9)
+			// Floor: never run faster than the core fps (covers silence + no-audio cores).
+			floor := floorNext
+			// ...unless this core is audio-mastered, and it is actually producing audio right now.
+			//
+			// A core whose audio clock runs SLOWER than its video clock can never be rescued by the
+			// max() below: its audioDeadline is always earlier than the floor, so the floor always wins,
+			// the loop never speeds up, and the core keeps under-feeding the encoder for the whole
+			// session. PPSSPP does exactly this (733 samples/frame where its own 44100 Hz @ 59.94 fps
+			// implies 735.7) and the missing ~250 samples/sec drain the client's audio buffer until it
+			// underruns — the faint PSP crackle. Letting the audio clock pull the loop a little faster
+			// than nominal makes the core produce exactly what the encoder consumes.
+			//
+			// Two guards, and they are the whole reason this is safe: the pull is bounded to audioPullMax
+			// (a core cannot run away), and it only applies while audio is FLOWING (a silent or audio-less
+			// core keeps the honest fps floor, which is what the floor was there for in the first place).
+			if f.AudioMaster && audioDelta > 0 {
+				floor -= int64(float64(targetFrameTimeNs) * audioPullMax)
+			}
+			deadline := floor
+			if audioDeadline > deadline {
+				deadline = audioDeadline
+			}
+
+			now := os.Nanotime()
+			// Resync if we've fallen far behind the audio clock (emulation stall / big catch-up batch):
+			// rebase the audio epoch so we don't sprint to catch up.
+			//
+			// But rebasing FORGIVES the audio the core failed to produce, and forgiven audio is a hole in
+			// the stream that nothing ever fills. A 60 ms load stall (PSP reading its savedata when the
+			// player walks into a sign) is ~55 ms of samples the client's jitter buffer silently eats —
+			// and it never gets them back, so buffer depth ratchets down with every transition until it
+			// underruns and the player hears a crackle. That is the PSP crackle, and it is OUR pacer's
+			// doing, not the core's.
+			//
+			// An audio-mastered core is allowed to REPAY a stall instead: leaving the epoch alone keeps the
+			// audio clock authoritative, so the loop runs (bounded by audioPullMax, i.e. ≤2% fast) until the
+			// missing samples are made up and the buffer refills — a few seconds later, inaudibly. The
+			// rebase still exists for a stall so large that repaying it would mean sprinting for minutes;
+			// that is a genuine desync, not a hiccup, and forgiving it is right.
+			resyncAfter := targetFrameTimeNs * lateFramesThreshold
+			if f.AudioMaster {
+				resyncAfter = int64(audioForgiveAfter)
+			}
+			if lateBy := now - deadline; lateBy > diagMaxDeficitNs {
+				diagMaxDeficitNs = lateBy
+			}
+			if now-deadline > resyncAfter {
+				// The pacer is about to FORGIVE this much audio — samples the core never produced and
+				// now never will. Each one is a permanent hole the client's jitter buffer absorbs.
+				diagForgiven++
+				audioEpoch += now - deadline
+				deadline = now
+			}
+			// Clamp a large forward jump (audio burst after a silent stretch) so one tick can't stall the
+			// loop for many frames; pull the epoch back so the clock stays consistent afterward.
+			if maxAhead := targetFrameTimeNs * lateFramesThreshold; deadline-now > maxAhead {
+				audioEpoch -= (deadline - now) - maxAhead
+				deadline = now + maxAhead
+			}
+
+			if sleepNs := deadline - now; sleepNs > 0 {
+				if sleepNs > spinThresholdNs {
+					time.Sleep(time.Duration(sleepNs - spinThresholdNs))
+				}
+				for os.Nanotime() < deadline {
+					for range batch - 1 {
+					}
+				}
+				f.skipVideo = false
+			} else {
+				// No sleep left: retro_run itself ate the whole frame budget. This is the tick that
+				// decides the crackle — a core with no spare time cannot run the <=2% fast that repaying
+				// an audio deficit requires, so the debt stands and the buffer ratchets down.
+				diagNoSleep++
+				if f.conf.LogDroppedFrames {
+					f.log.Debug().Msgf("[] Frame drop: %v", time.Duration(-sleepNs))
+				}
+				f.skipVideo = true
+			}
+
+			// Anchor the next floor to this frame's intended deadline (drift-free 60fps cap).
+			floorNext = deadline + targetFrameTimeNs
+		}
+	}
+}
+
+// ── Core-build cache isolation (MovieTheater patch 0042) ────────────────────────────────────────
+//
+// A shader/pipeline cache is only meaningful to the exact core BUILD that wrote it. Dolphin compares
+// its pipeline UIDs with memcmp, and two builds of the same emulator lay that struct out differently,
+// so a core handed a foreign cache matches nothing, recompiles every pipeline INLINE on the emulator
+// thread, and appends its own UIDs next to the ones it could not read. The file grows without ever
+// becoming useful, and it happens on every boot, not just the first — the "GX slowdown" was this.
+//
+// So the cache is stamped with the identity of the build that owns it, and a core that finds someone
+// else's stamp throws the cache away rather than trying to read it. Regenerating a shader cache is
+// cheap and automatic; reading a poisoned one never stops being expensive.
+
+// coreBuildId identifies a core BUILD, not a core name. The name is not enough: we rebuild the custom
+// Dolphin against upstream, and the stock core is overwritten by the nightly repo sync — same filename,
+// different pipeline UIDs, same poison. Hashing the library is the only identity that tracks that.
+func coreBuildId(libPath string) (string, error) {
+	lib, err := os.ReadFile(libPath)
+	if err != nil {
+		return "", err
+	}
+	return fmt.Sprintf("%x", sha256.Sum256(lib))[:16], nil
+}
+
+// corePath rebuilds the library path nanoarch will actually dlopen (see nanoarch.coreLoad).
+func corePath(conf config.LibretroCoreConfig, libExt string) string { return conf.Lib + libExt }
+
+func (f *Frontend) purgeForeignCoreCache(conf config.LibretroCoreConfig, libPath string) {
+	if conf.CoreCache.Dir == "" || len(conf.CoreCache.Purge) == 0 {
+		return
+	}
+
+	saveDir := f.nano.SaveDir()
+	cacheDir := filepath.Join(saveDir, filepath.FromSlash(conf.CoreCache.Dir))
+	// Containment guard. Everything below deletes, and the dir comes from config — a "../.." in it
+	// would aim this at the save tree. Refuse rather than trust.
+	if rel, err := filepath.Rel(saveDir, cacheDir); err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		f.log.Error().Msgf("coreCache.dir %q escapes the save dir — refusing to purge", conf.CoreCache.Dir)
+		return
+	}
+	if !os.Exists(cacheDir) {
+		return // nothing cached yet; the core will create it and we stamp it on the next boot
+	}
+
+	id, err := coreBuildId(libPath)
+	if err != nil {
+		// Unreadable core: the load about to happen will fail anyway. Don't delete on a guess.
+		f.log.Warn().Err(err).Msgf("couldn't identify the core build; leaving the cache alone")
+		return
+	}
+
+	stampPath := filepath.Join(cacheDir, ".core-build")
+	stamp, err := os.ReadFile(stampPath)
+	owner := strings.TrimSpace(string(stamp))
+	switch {
+	case err == nil && owner == id:
+		// Say so on every boot. A silently-unbound config would leave Dir empty and skip this whole
+		// function — which looks EXACTLY like a healthy run in the logs, right up until the cache is
+		// poisoned again. The presence of this line is the proof that isolation is actually armed.
+		f.log.Info().Msgf("core cache %v owned by this build (%v)", conf.CoreCache.Dir, id)
+		return // ours
+	case err == nil:
+		f.log.Info().Msgf("core cache belongs to build %v, this is %v — dropping it", owner, id)
+	default:
+		// No stamp. Written by a build from before this existed, so it CANNOT be vouched for — and the
+		// unstamped caches that exist today are exactly the poisoned ones. Unknown means foreign.
+		f.log.Info().Msgf("core cache is unstamped (unknown build) — dropping it")
+	}
+
+	var removed int
+	var freed int64
+	for _, pattern := range conf.CoreCache.Purge {
+		// Matched against the TOP LEVEL of the cache dir only, and only against what the core config
+		// named. Dolphin keeps its memory cards under this same User tree; nothing sweeps broadly here.
+		hits, err := filepath.Glob(filepath.Join(cacheDir, pattern))
+		if err != nil {
+			f.log.Error().Err(err).Msgf("bad coreCache.purge pattern %q — skipped", pattern)
+			continue
+		}
+		for _, hit := range hits {
+			freed += treeSize(hit)
+			if err := os.RemoveAll(hit); err != nil {
+				f.log.Error().Err(err).Msgf("couldn't drop cached %v", hit)
+				continue
+			}
+			removed++
+		}
+	}
+	f.log.Info().Msgf("core cache purged: %d entr(ies), ~%v freed, now owned by build %v",
+		removed, byteCount(freed), id)
+
+	if err := os.WriteFile(stampPath, []byte(id), 0644); err != nil {
+		// Non-fatal, but say so loudly: an unwritable stamp means the next boot purges again.
+		f.log.Error().Err(err).Msgf("couldn't stamp the core cache — it will be re-purged next boot")
+	}
+}
+
+// treeSize is the size of the whole subtree. The shader cache is a DIRECTORY, and a plain Stat on a
+// directory reports the dir entry (a handful of bytes), not the megabytes that are the only reason
+// this number is worth logging.
+func treeSize(root string) int64 {
+	var total int64
+	_ = filepath.WalkDir(root, func(_ string, d fs.DirEntry, err error) error {
+		if err != nil || d.IsDir() {
+			return nil
+		}
+		if fi, err := d.Info(); err == nil {
+			total += fi.Size()
+		}
+		return nil
+	})
+	return total
+}
+
+func byteCount(b int64) string {
+	const unit = 1024
+	if b < unit {
+		return fmt.Sprintf("%d B", b)
+	}
+	div, exp := int64(unit), 0
+	for n := b / unit; n >= unit; n /= unit {
+		div *= unit
+		exp++
+	}
+	return fmt.Sprintf("%.1f %cB", float64(b)/float64(div), "KMGTPE"[exp])
+}
