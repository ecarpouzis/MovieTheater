diff --git a/pkg/config/corecache_bind_test.go b/pkg/config/corecache_bind_test.go
new file mode 100644
index 0000000..2aa55cc
--- /dev/null
+++ b/pkg/config/corecache_bind_test.go
@@ -0,0 +1,41 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// Proves coreCache actually binds from YAML. A silent bind failure leaves Dir empty, which skips the
+// purge entirely and looks identical to a healthy run — the exact way the poisoned cache went
+// unnoticed for weeks. So it gets a test.
+func TestCoreCacheBinds(t *testing.T) {
+	dir := t.TempDir()
+	yml := `
+emulator:
+  libretro:
+    cores:
+      list:
+        gc:
+          lib: dolphin_custom_libretro
+          coreCache:
+            dir: "User/Cache"
+            purge: ["Shaders", "*.uidcache"]
+`
+	if err := os.WriteFile(filepath.Join(dir, "config.yaml"), []byte(yml), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	var conf struct{ Emulator Emulator }
+	if _, err := LoadConfig(&conf, dir); err != nil {
+		t.Fatal(err)
+	}
+
+	gc := conf.Emulator.Libretro.Cores.List["gc"]
+	if gc.CoreCache.Dir != "User/Cache" {
+		t.Fatalf("coreCache.dir did not bind: %q", gc.CoreCache.Dir)
+	}
+	if len(gc.CoreCache.Purge) != 2 || gc.CoreCache.Purge[0] != "Shaders" || gc.CoreCache.Purge[1] != "*.uidcache" {
+		t.Fatalf("coreCache.purge did not bind: %#v", gc.CoreCache.Purge)
+	}
+}
