+func (c *coordinator) HandleChangePlayer(rq api.ChangePlayerRequest, w *Worker) api.Out {
+	user := w.router.FindUser(rq.Id)
+	if user == nil || w.router.FindRoom(rq.Rid) == nil {
+		return api.Out{Payload: -1} // semi-predicates
+	}
+	user.Index = rq.Index
+	w.log.Info().Msgf("Updated player index to: %d", rq.Index)
+	return api.Out{Payload: rq.Index}
+}
+
+func (c *coordinator) HandleRecordGame(rq api.RecordGameRequest, w *Worker) api.Out {
+	if !w.conf.Recording.Enabled {
+		return api.ErrPacket
+	}
+	r := w.router.FindRoom(rq.Rid)
+	if r == nil {
+		return api.ErrPacket
+	}
+	room.WithRecorder(r.App()).ToggleRecording(rq.Active, rq.User)
+	return api.OkPacket
+}
+
+func toJson(data any) (string, error) {
+	if data == nil {
+		return "", nil
+	}
+	b, err := json.Marshal(data)
+	if err != nil {
+		return "", err
+	}
+	return string(b), nil
+}
diff --git a/pkg/worker/media/glzerocopy.go b/pkg/worker/media/glzerocopy.go
new file mode 100644
index 0000000..1de3477
--- /dev/null
+++ b/pkg/worker/media/glzerocopy.go
@@ -0,0 +1,288 @@
+package media
+
+// GL zero-copy for hardware-rendered libretro cores (n64/gc/ps2/psp/dc).
+//
+// The libretro path used to pull every rendered frame back to system memory with glReadPixels —
+// SYNCHRONOUSLY, on the emulator thread — only to hand it to an appsrc that uploaded it to the GPU
+// again for NVENC. Measured (CLOUD_GAME_GL_READBACK_STATS=1): GameCube renders 1920x1584 (11.6 MB per
+// frame, far larger than the 1280x1056 we actually encode) and the readback blocked the core for a p50
+// of 3.7-4.2 ms — a QUARTER of a 60fps frame budget, up to half at p95.
+//
+// This keeps the frame in VRAM: the core's texture is copied GPU->GPU into a pool (graphics.zerocopy)
+// and pushed as GLMemory. nvav1enc accepts video/x-raw(memory:GLMemory) in RGBA directly, so there is
+// no download, no upload, and no conversion element in between.
+//
+// The context is the delicate part. The core's GL context lives on the emulator thread (a libco
+// cothread). GStreamer runs its GL work on its own thread, so it needs a context that SHARES object
+// space with the core's — otherwise the texture ids we hand it are meaningless. gst_gl_context_new_
+// wrapped() wraps the core's HGLRC without taking it over, and handing that to the pipeline as
+// "gst.gl.app_context" makes GStreamer create its own context shared with it.
+//
+// Cross-thread ordering is a GstGLSyncMeta on every buffer: our thread records a fence after the copy,
+// GStreamer's thread waits on it before the encoder reads. Without it the encoder can read a texture
+// whose copy has not landed — which shows up as intermittent tearing, not a clean failure.
+
+/*
+#cgo pkg-config: gstreamer-1.0 gstreamer-video-1.0 gstreamer-app-1.0 gstreamer-gl-1.0
+#include <gst/gst.h>
+#include <gst/gl/gl.h>
+#include <gst/app/gstappsrc.h>
+#include <gst/video/video.h>
+
+static GstGLDisplay *zc_display = NULL;
+static GstGLContext *zc_wrapped = NULL;   // the CORE's context, wrapped (not ours to drive)
+static GstGLContext *zc_shared  = NULL;   // GStreamer's OWN context, sharing object space with it
+static char zc_err[512] = {0};
+
+// zc_init wraps the core's native GL context. hglrc is the WGL HGLRC (graphics.RGFW.GLHandles).
+static int zc_prepare(void *hglrc) {
+	if (zc_wrapped) return 1;
+	if (!hglrc) return 0;
+
+	zc_display = gst_gl_display_new();
+	if (!zc_display) return 0;
+
+	// GST_GL_API_OPENGL3: the cores request a core-profile 3.x/4.x context (config.GLVersionMajor).
+	zc_wrapped = gst_gl_context_new_wrapped(zc_display, (guintptr) hglrc,
+	                                        GST_GL_PLATFORM_WGL, GST_GL_API_OPENGL3);
+	if (!zc_wrapped) {
+		gst_object_unref(zc_display);
+		zc_display = NULL;
+		return 0;
+	}
+	// Fill in the wrapped context's GL vtable from the current thread (the emulator thread, where the
+	// core's context IS current). Without this GStreamer has no function pointers for it.
+	gst_gl_context_activate(zc_wrapped, TRUE);
+	GError *err = NULL;
+	if (!gst_gl_context_fill_info(zc_wrapped, &err)) {
+		g_snprintf(zc_err, sizeof(zc_err), "fill_info: %s",
+		           err && err->message ? err->message : "failed");
+		if (err) g_error_free(err);
+		gst_gl_context_activate(zc_wrapped, FALSE);
+		gst_object_unref(zc_wrapped);
+		gst_object_unref(zc_display);
+		zc_wrapped = NULL;
+		zc_display = NULL;
+		return 0;
+	}
+	gst_gl_context_activate(zc_wrapped, FALSE);
+	return 1;
+}
+
+// zc_share creates GStreamer's own context, sharing object space with the core's.
+//
+// MUST run with NO GL context current on this thread. GStreamer shares via wglShareLists, and Windows
+// fails that with ERROR_BUSY (0xaa) while either context is CURRENT on a thread — which it is, because
+// we are on the graphics thread the core renders from. Caller brackets this with Unbind/Bind.
+static int zc_share(void) {
+	if (!zc_wrapped) return 0;
+
+	// DO NOT add the wrapped context to the display. That is what makes the elements try to USE it:
+	// nvav1enc calls gst_gl_context_thread_add() on whatever context the display hands out, and a
+	// WRAPPED context has no thread of its own — the call trips
+	//   'context->priv->active_thread == g_thread_self()' failed
+	// and the encoder ends up with "Couldn't get GL context", so not one frame is ever encoded.
+	//
+	// Instead let GStreamer create its OWN context that SHARES object space with the core's. Same
+	// share group => the texture ids from the core's context are valid in it, and it has a real thread,
+	// so the GL elements can drive it normally.
+	GError *cerr = NULL;
+	zc_shared = gst_gl_context_new(zc_display);
+	if (!zc_shared || !gst_gl_context_create(zc_shared, zc_wrapped, &cerr)) {
+		// Report WHY. This failing silently is what made the first attempt look like it worked (the
+		// readback fallback kept video flowing) while the feature was in fact off.
+		g_snprintf(zc_err, sizeof(zc_err), "%s",
+		           cerr && cerr->message ? cerr->message : "gst_gl_context_create failed");
+		if (cerr) g_error_free(cerr);
+		if (zc_shared) { gst_object_unref(zc_shared); zc_shared = NULL; }
+		gst_object_unref(zc_wrapped);
+		gst_object_unref(zc_display);
+		zc_wrapped = NULL;
+		zc_display = NULL;
+		return 0;
+	}
+	gst_gl_display_add_context(zc_display, zc_shared);
+	return 1;
+}
+
+static const char *zc_last_error(void) { return zc_err; }
+
+// zc_tex_released is the GDestroyNotify on every wrapped texture: GStreamer calls it when it frees the
+// buffer, which is the ONLY moment the texture is safe for the core to render over again. Without this
+// the pool just cycles and the encoder ends up reading a texture the core has already overwritten —
+// frames then show FUTURE pixels and snap back (a scrolling marquee jitters back and forth).
+extern void goReleaseZeroCopyTexture(unsigned int texid);
+static void zc_tex_released(gpointer user_data) {
+	goReleaseZeroCopyTexture((unsigned int) (guintptr) user_data);
+}
+
+// zc_set_context gives the pipeline our display + app context, so its GL elements build a context that
+// SHARES with the core's rather than creating an isolated one (whose texture ids would mean nothing).
+static void zc_set_context(GstElement *pipeline) {
+	if (!zc_wrapped || !pipeline) return;
+
+	GstContext *dctx = gst_context_new(GST_GL_DISPLAY_CONTEXT_TYPE, TRUE);
+	gst_context_set_gl_display(dctx, zc_display);
+	gst_element_set_context(pipeline, dctx);
+	gst_context_unref(dctx);
+
+	GstContext *actx = gst_context_new("gst.gl.app_context", TRUE);
+	GstStructure *s = gst_context_writable_structure(actx);
+	gst_structure_set(s, "context", GST_TYPE_GL_CONTEXT, zc_wrapped, NULL);
+	gst_element_set_context(pipeline, actx);
+	gst_context_unref(actx);
+}
+
+// zc_deinit drops our references to the GL contexts. MUST run BEFORE the core's GL context is
+// destroyed: the encoder holds a GL context of its own (shared with the core's), and tearing the core's
+// down first leaves nvcodec doing GL work against a dead share group — which is exactly the
+// "media pipeline teardown wedged (nvcodec set_state hang)" the worker hard-exits on.
+static void zc_deinit(void) {
+	if (zc_shared) { gst_object_unref(zc_shared); zc_shared = NULL; }
+	if (zc_wrapped) { gst_object_unref(zc_wrapped); zc_wrapped = NULL; }
+	if (zc_display) { gst_object_unref(zc_display); zc_display = NULL; }
+}
+
+// zc_push wraps an existing GL texture as a GstBuffer and pushes it. The texture belongs to the pool in
+// graphics.zerocopy — already a GPU-side copy of the core's frame, so the core is free to render the
+// next one immediately.
+static void zc_push(GstAppSrc *src, unsigned int texid, int w, int h, unsigned long long durNs) {
+	if (!zc_shared || !src || !texid) return;
+
+	// Renegotiate the source caps when the core's frame size changes at runtime — the SAME fix
+	// pushVideoBuf (gstreamer.go) already carries for the CPU path, which the GL path needs just as
+	// badly and shipped without. The appsrc caps are fixed at pipeline-build time, so once the core's
+	// geometry diverges we push a buffer whose video meta says 894 into caps that still claim 896;
+	// downstream gst_video_frame_map_id() then asserts 'info->height <= meta->height', the appsrc
+	// errors with "Internal data stream error", and the VIDEO STREAM STOPS FOR THE REST OF THE SESSION
+	// while the emulator runs on at a happy 60fps — a black room, with the core looking perfectly healthy
+	// in every log. (Found 2026-07-14 on PS2 Stuntman, which flips 1280x896 <-> 1280x894 the moment a
+	// save resumes. The CPU path's own comment names the rest of the victims: God of War, Kingdom Hearts,
+	// FFX, Shadow of the Colossus, Monster Hunter — PS2 games switch field/frame height mid-run as a
+	// matter of course, and GL zero-copy is armed for exactly these 3D cores.)
+	//
+	// Only width/height move; format and framerate are preserved. glcolorscale sits between this appsrc
+	// and the video_caps capsfilter that pins the ENCODE geometry, so it simply rescales the new size to
+	// the same output — the encoder never re-inits, and WebRTC never renegotiates. Nothing downstream
+	// can even tell.
+	GstCaps *cur = gst_app_src_get_caps(src);
+	if (cur) {
+		GstStructure *st = gst_caps_get_structure(cur, 0);
+		gint cw = 0, ch = 0;
+		gst_structure_get_int(st, "width", &cw);
+		gst_structure_get_int(st, "height", &ch);
+		if (cw != (gint) w || ch != (gint) h) {
+			g_printerr("[video] gl source caps %dx%d -> %dx%d (core frame size changed)\n", cw, ch, w, h);
+			GstCaps *nc = gst_caps_copy(cur);
+			gst_caps_set_simple(nc, "width", G_TYPE_INT, (gint) w, "height", G_TYPE_INT, (gint) h, NULL);
+			gst_app_src_set_caps(src, nc);
+			gst_caps_unref(nc);
+		}
+		gst_caps_unref(cur);
+	}
+
+	GstVideoInfo vinfo;
+	gst_video_info_set_format(&vinfo, GST_VIDEO_FORMAT_RGBA, w, h);
+
+	// Allocate against the context the PIPELINE drives (zc_shared), not the core's wrapped one. The two
+	// share object space, so this texture id — created in the core's context — is valid here, and every
+	// GL element downstream can operate on it from its own thread.
+	GstGLMemoryAllocator *alloc = gst_gl_memory_allocator_get_default(zc_shared);
+	GstGLVideoAllocationParams *params = gst_gl_video_allocation_params_new_wrapped_texture(
+		zc_shared, NULL, &vinfo, 0, NULL, GST_GL_TEXTURE_TARGET_2D, GST_GL_RGBA,
+		(guint) texid, (gpointer) (guintptr) texid, zc_tex_released);
+	if (!params) { gst_object_unref(alloc); return; }
+
+	// Allocate the ONE plane directly rather than gst_gl_memory_setup_buffer(): that helper wants a
+	// per-plane `wrapped_data` array and asserts 'wrapped_data != NULL' without it (every frame died on
+	// that assertion, silently, and the stream stayed black). RGBA is single-plane, so the base
+	// allocator is both simpler and correct here.
+	GstMemory *mem = (GstMemory *) gst_gl_base_memory_alloc(
+		(GstGLBaseMemoryAllocator *) alloc, (GstGLAllocationParams *) params);
+	gst_gl_allocation_params_free((GstGLAllocationParams *) params);
+	gst_object_unref(alloc);
+	if (!mem) return;
+
+	GstBuffer *buf = gst_buffer_new();
+	gst_buffer_append_memory(buf, mem);
+	gst_buffer_add_video_meta(buf, GST_VIDEO_FRAME_FLAG_NONE, GST_VIDEO_FORMAT_RGBA, w, h);
+
+	GST_BUFFER_DURATION(buf) = durNs;
+
+	// NO GstGLSyncMeta. It looks like the right tool and it is a trap here: set_sync_point() drives
+	// gst_gl_context_thread_add() on the context you give it, and the CORE's context is WRAPPED — it has
+	// no thread of its own, so that trips
+	//   'context->priv->active_thread == g_thread_self()' failed
+	// on every single frame (it spammed a worker to death). Handing it the SHARED context instead would
+	// bounce the fence onto GStreamer's thread, which is not where the copy happened.
+	//
+	// The producer waits instead: graphics.CopyFrameToPool does a glFinish after the GPU->GPU copy, so
+	// the texture is complete before the encoder is ever told about it. That costs a GPU sync on the
+	// emulator thread — but no PCIe transfer, which is the 11 MB/frame this whole path exists to remove.
+	gst_app_src_push_buffer(src, buf);
+}
+*/
+import "C"
+
+import (
+	"fmt"
+	"unsafe"
+
+	"github.com/giongto35/cloud-game/v3/pkg/worker/caged/libretro/graphics"
+	"github.com/go-gst/go-gst/gst"
+)
+
+//export goReleaseZeroCopyTexture
+func goReleaseZeroCopyTexture(texid C.uint) {
+	graphics.ReleaseZeroCopyTexture(uint32(texid))
+}
+
+// glZeroCopyReady reports whether the GL context has been wrapped successfully.
+func glZeroCopyReady() bool { return C.zc_shared != nil }
+
+// InitGLZeroCopy wraps the core's GL context for GStreamer. MUST be called from the thread where that
+// context is current (the emulator thread) — it reads the GL function pointers out of it.
+func InitGLZeroCopy(hglrc uintptr, unbind func(), rebind func() error) error {
+	if hglrc == 0 {
+		return fmt.Errorf("no native GL context (not a hardware-rendered core?)")
+	}
+	// Phase 1 needs the core's context CURRENT (GStreamer reads its GL function pointers).
+	if C.zc_prepare(unsafe.Pointer(hglrc)) == 0 {
+		return fmt.Errorf("could not wrap the core's GL context: %s", C.GoString(C.zc_last_error()))
+	}
+	// Phase 2 needs it NOT current: sharing goes through wglShareLists, which Windows fails with
+	// ERROR_BUSY (0xaa) if either context is current on any thread. Unbind, share, rebind — and rebind
+	// even on failure, or the core would carry on rendering with no context at all.
+	unbind()
+	ok := C.zc_share() != 0
+	if err := rebind(); err != nil {
+		return fmt.Errorf("could not restore the core's GL context after sharing: %w", err)
+	}
+	if !ok {
+		return fmt.Errorf("could not share a GL context with GStreamer: %s", C.GoString(C.zc_last_error()))
+	}
+	return nil
+}
+
+// DeinitGLZeroCopy releases the GL contexts. Call BEFORE the core's GL context is destroyed — see the
+// note on zc_deinit: the reverse order wedges nvcodec's state change and the worker hard-exits.
+func DeinitGLZeroCopy() { C.zc_deinit() }
+
+// attachGLContext gives a pipeline the core's GL display + context, so its GL elements SHARE object
+// space with the core instead of building an isolated context (in which our texture ids would be
+// meaningless — garbage frames, not an error). cgo preambles are per-file, so this wrapper is what lets
+// gstreamer.go reach it.
+func attachGLContext(p *gst.Pipeline) {
+	if p == nil {
+		return
+	}
+	C.zc_set_context((*C.GstElement)(unsafe.Pointer(p.Instance())))
+}
+
+// pushGLTexture hands one pool texture to the encoder. No download, no upload, no conversion.
+func (g *GstMediaPipe) pushGLTexture(texID uint32, w, h int, durNs uint64) {
+	if g.v == nil || g.v.source == nil {
+		return
+	}
+	C.zc_push(g.v.src(), C.uint(texID), C.int(w), C.int(h), C.ulonglong(durNs))
+}
