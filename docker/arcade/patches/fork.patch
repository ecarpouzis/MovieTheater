+	if bitrateKbps <= 0 && fec == 0 && codec == "" {
+		return e
+	}
+	nl := make(map[string]CodecSettings, len(e.List))
+	for k, v := range e.List {
+		nl[k] = v
+	}
+	e.List = nl
+
+	// Per-room codec swap (patch 0036) — BEFORE the bitrate rewrite below, so the bitrate lands on
+	// the codec this room will actually encode with. Callers sanitize against e.List (the worker's
+	// roomVideoCodec), so an unknown value can't reach the pipeline builder from here.
+	if codec != "" {
+		if _, ok := e.List[codec]; ok {
+			e.Video.Codec = codec
+		}
+	}
+
+	if bitrateKbps > 0 {
+		if bitrateKbps < 500 {
+			bitrateKbps = 500
+		} else if bitrateKbps > 20000 {
+			bitrateKbps = 20000
+		}
+		vc := strings.ToLower(e.Video.Codec)
+		if cs, ok := e.List[vc]; ok {
+			cs.Params = setEncoderParam(cs.Params, "bitrate", strconv.Itoa(bitrateKbps), false)
+			e.List[vc] = cs
+		}
+	}
+	if fec != 0 {
+		on := fec == 1
+		fecVal, plp := "false", "0"
+		if on {
+			fecVal, plp = "true", "15"
+		}
+		ac := strings.ToLower(e.Audio.Codec)
+		if cs, ok := e.List[ac]; ok {
+			cs.Params = setEncoderParam(cs.Params, "inband-fec", fecVal, true)
+			cs.Params = setEncoderParam(cs.Params, "packet-loss-percentage", plp, true)
+			e.List[ac] = cs
+		}
+	}
+	return e
+}
