+package libretro
+
+import (
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"io/fs"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+	"unsafe"
+
+	"github.com/giongto35/cloud-game/v3/pkg/config"
+	"github.com/giongto35/cloud-game/v3/pkg/logger"
+	"github.com/giongto35/cloud-game/v3/pkg/os"
+	"github.com/giongto35/cloud-game/v3/pkg/worker/caged/app"
+	"github.com/giongto35/cloud-game/v3/pkg/worker/caged/libretro/graphics"
+	"github.com/giongto35/cloud-game/v3/pkg/worker/caged/libretro/nanoarch"
+	"github.com/giongto35/cloud-game/v3/pkg/worker/cheevos"
+)
+
+type Emulator interface {
+	SetAudioCb(func(app.Audio))
+	SetVideoCb(func(app.Video))
+	SetDataCb(func([]byte))
+	LoadCore(name string)
+	LoadGame(path string) error
+	FPS() float64
+	Flipped() bool
+	Rotation() uint
+	PixFormat() uint32
+	AudioSampleRate() int
+	IsPortrait() bool
+	// Start is called after LoadGame
+	Start()
+	// ViewportRecalculate calculates output resolution with aspect and scale
+	ViewportRecalculate()
+	RestoreGameState() error
+	// SetSessionId sets distinct name for the game session (in order to save/load it later)
+	SetSessionId(name string)
+	SaveGameState() error
+	SaveStateName() string
+	// HashPath returns the path emulator will save state to
+	HashPath() string
+	// HasSave returns true if the current ROM was saved before
+	HasSave() bool
+	// Close will be called when the game is done
+	Close()
+	// Input passes input to the emulator
+	Input(player int, device byte, data []byte)
+	// Scale returns set video scale factor and method
+	Scale() (float64, string)
+	Reset()
+}
+
+type Frontend struct {
+	conf    config.Emulator
+	done    chan struct{}
+	doneEvt chan struct{} // closed when Start() fully exits
+	closed  atomic.Bool
+	log     *logger.Logger
+	nano    *nanoarch.Nanoarch
+	onAudio func(app.Audio)
+	onData  func([]byte)
+	onVideo func(app.Video)
+	storage Storage
+	scale   float64
+	scaleM  string
+	isGL    bool
+	th      int // draw threads
+	vw, vh  int // out frame size
+
+	// directives
+
+	// SpinBatch batches nanotime checks in the spin loop.
+	// Higher values = check every N iterations, reducing syscall overhead.
+	SpinBatch int
+
+	// skipVideo used when new frame was too late
+	skipVideo bool
+
+	// silenceBuf is pushSilence's reusable zero buffer (emulator goroutine only).
+	silenceBuf []byte
+
+	mu  sync.Mutex
+	mui sync.Mutex
+
+	// RetroAchievements (per room, when the creator linked RA). Staged by SetRetroAchievements before
+	// Load, the live client is created in Start() once memory is available and ticked each frame; nil =
+	// RA off for this room. The Frontend is recreated per room (ReloadFrontend), so this never leaks
+	// across rooms.
+	ra        *cheevos.Client
+	raUser    string
+	raToken   string
+	raSystem  string
+	raHard    bool
+	raCheats  bool // room staged cheat codes → seeds the run's Cheat legitimacy taint
+	// raSeededState: this room BOOTED from a restored save-state (the gateway's Continue/?seedslot seed,
+	// or a leftover mount .dat), so the run is save-scummed from frame 0. Set in Start() from the same
+	// HasSave() condition the restore branches use, and applied in startCheevos() once the client exists.
+	//
+	// Without this, only the explicit in-room Load press tainted a run — and every boot-time restore
+	// (which is how you resume ANY game) laundered a save-scum into a "clean" run. That mattered little
+	// while legitimacy also required a competitive room; it is the whole ballgame now that a run is legit
+	// until something dirties it. A hard reset still clears it, exactly like a mid-run Load: RA restores
+	// hardcore eligibility on reset, so a clean run started after one is legit again.
+	raSeededState bool
+	// raSeedExplicit: the boot state was a DELIBERATE pick (named snapshot / Quickload, ?seedslot=N)
+	// rather than the ordinary auto-save continue. Only the former is save-scumming.
+	raSeedExplicit bool
+	raHandler cheevos.Handlers
+	// raKnownHash: hash supplied by the site so the load skips identification (see cheevos.SetKnownHash).
+	raKnownHash string
+	gamePath  string // the ROM/disc path last loaded — RetroAchievements hashes it to identify the game
+	// Deferred RA bring-up state (see beginCheevosBoot). raBootPending gates a once-per-frame poll of
+	// the core's memory in the emulator loop; raBootStart is when we began waiting. Emu goroutine only.
+	raBootPending bool
+	raBootStart   int64
+
+	DisableCanvasPool bool
+	SaveOnClose       bool
+	UniqueSaveDir     bool
+	SaveStateFs       string
+	NoSaveStates      bool // this core cannot be serialized; its memory card is the progress (0041)
+	NoAutoSaveStates  bool // only the PERIODIC autosave skips serializing; manual/close/boot states work
+	AudioMaster       bool // the audio clock paces this core, even above its fps floor (0043)
+
+	// AudioSilenceFill: this core emits NO audio callbacks at all while the game is SILENT, rather than
+	// the stream of zero samples every other core produces. Its audio clock therefore stops dead for the
+	// length of every quiet passage, and the Opus/RTP timeline stops with it — measured on ScummVM
+	// (2026-07-27): whole 5 s pace-diag windows at audio/s=0 while video/s held 60, and the pacer's
+	// `deficit` climbed to 26.7 s over one 3.5 min session and never came back down.
+	//
+	// Two things that costs, both real:
+	//   * The client's NetEq buffer drains to empty during every silence and has to re-ramp when sound
+	//     resumes — in a point-and-click game, where speech starts and stops constantly, that lands on
+	//     the FRONT of dialogue lines.
+	//   * The audio track's RTP clock drifts from wall clock without bound, so nothing downstream can
+	//     use it as a timebase, and the deficit diagnostic reads as a catastrophic fault when the core
+	//     is in fact perfectly healthy. (That misreading cost a whole investigation once.)
+	//
+	// Armed per core, never globally: the top-up below is SILENCE, so on a core that merely trickles
+	// slightly behind its declared rate (PPSSPP: 733 samples/frame against 735.7) it would splice
+	// periodic silence into live sound — audible clicks. Those cores want AudioMaster instead, which
+	// REPAYS the shortfall with real samples. The two are mutually exclusive and Start() enforces it.
+	AudioSilenceFill bool
+
+	// ScaleMaxWidth caps the server-side upscale in OUTPUT pixels instead of leaving `scale` as a blind
+	// multiplier. Cores whose games have a FIXED native size are fine with a bare multiplier; ScummVM's
+	// do not — its catalog runs 320x200 (most SCUMM/Sierra classics) through 640x480 (Curse of Monkey
+	// Island, Broken Sword), so any single `scale` is either too soft for the small ones or a needlessly
+	// huge encode for the large ones. With this set, `scale` becomes "up to", and Scale() picks the
+	// largest INTEGER factor that still fits — integer being the point, since a fractional
+	// nearest-neighbour ratio duplicates some rows more than others and shimmers.
+	ScaleMaxWidth int
+
+	// ── Fast-forward / rewind (t=114/115) ────────────────────────────────────────────────────
+	// ffOn/rwOn are written from the coordinator's command goroutine (SetFastForward/SetRewind)
+	// and read by the emulator loop and the AV callbacks; rewindArmed flips off permanently if
+	// serialize keeps failing mid-session. Everything below those is owned by the emulator
+	// goroutine exclusively — the ring is never touched from anywhere else.
+	ffOn        atomic.Bool
+	rwOn        atomic.Bool
+	rewindArmed atomic.Bool
+
+	rewindStepFrames int      // snapshot cadence in frames (config RewindStepFrames, default 6)
+	rewindMaxBytes   int      // ring memory cap (config RewindMB, default 512 MB)
+	rewindSnaps      [][]byte // the ring, oldest first
+	rewindBytes      int      // current ring payload size
+	rewindHold       []byte   // last popped state — held (re-restored) when the ring runs dry
+	rewindPopNow     bool     // engage edge: pop immediately, don't wait for a step boundary
+	rewindTicks      uint64   // loop tick counter driving both capture and pop cadence
+	rewindFails      int      // consecutive serialize failures (3 = disable for the session)
+	rewindFree       [][]byte // evicted buffers, recycled into the next capture (see rewindCapture)
+	rewindCapN       int      // captures since the last cost report
+	rewindCapSumMs   float64  // their total wall cost
+	rewindCapMaxMs   float64  // the worst one
+	ffLastVideoNs    int64    // last frame pushed downstream while fast-forwarding (throttle)
+}
+
+// rewindFreeMax bounds the recycle list. The ring only ever evicts from the front, so a couple of
+// spare buffers is all a steady state needs; anything beyond that is just held memory.
+const rewindFreeMax = 4
+
+// ffRatio is the fast-forward speed multiplier: the pacing floor shrinks to 1/ffRatio of a
+// frame while engaged. 2D cores hit it exactly; heavy cores run as fast as retro_run allows
+// and land wherever they land — the ratio is a ceiling on pacing, not a promise.
+const ffRatio = 4
+
+// ErrNoSaveStates is returned instead of serializing a core that cannot survive it.
+var ErrNoSaveStates = errors.New("this system has no save states; its progress is kept on the memory card")
+
+type Device byte
+
+const (
+	RetroPad = Device(nanoarch.RetroPad)
+	Keyboard = Device(nanoarch.Keyboard)
+	Mouse    = Device(nanoarch.Mouse)
+)
+
+var (
+	audioPool sync.Pool
+	noAudio   = func(app.Audio) {}
+	noData    = func([]byte) {}
+	noVideo   = func(app.Video) {}
+	videoPool sync.Pool
+	lastFrame *app.Video
+)
+
+// NewFrontend implements Emulator interface for a Libretro frontend.
+func NewFrontend(conf config.Emulator, log *logger.Logger) (*Frontend, error) {
+	path, err := filepath.Abs(conf.LocalPath)
+	if err != nil {
+		return nil, fmt.Errorf("failed to use emulator path: %v, %w", conf.LocalPath, err)
+	}
+	if err := os.CheckCreateDir(path); err != nil {
+		return nil, fmt.Errorf("failed to create local path: %v, %w", conf.LocalPath, err)
+	}
+	log.Info().Msgf("Emulator save path is %v", path)
+
+	// we use the global Nanoarch instance from nanoarch
+	nano := nanoarch.NewNano(path)
+
+	log = log.Extend(log.With().Str("m", "Libretro"))
+	level := logger.Level(conf.Libretro.LogLevel)
+	nano.SetLogger(log.Extend(log.Level(level).With()))
+
+	// Check if room is on local storage, if not, pull from GCS to local storage
+	log.Info().Msgf("Local storage path: %v", conf.Storage)
+	if err := os.CheckCreateDir(conf.Storage); err != nil {
+		return nil, fmt.Errorf("failed to create local storage path: %v, %w", conf.Storage, err)
+	}
+
+	var store Storage = &StateStorage{Path: conf.Storage}
+	if conf.Libretro.SaveCompression {
+		store = &ZipStorage{Storage: store}
+	}
+
+	// set global link to the Libretro
+	f := &Frontend{
+		conf:      conf,
+		done:      make(chan struct{}),
+		log:       log,
+		onAudio:   noAudio,
+		onData:    noData,
+		onVideo:   noVideo,
+		storage:   store,
+		th:        conf.Threads,
+		SpinBatch: 2048, // ~ 3GHz 3M / 2048 calls
+	}
+	f.linkNano(nano)
+
+	if conf.Libretro.DebounceMs > 0 {
+		t := time.Duration(conf.Libretro.DebounceMs) * time.Millisecond
+		f.nano.SetVideoDebounce(t)
+		f.log.Debug().Msgf("set debounce time: %v", t)
+	}
+
+	return f, nil
+}
+
+func (f *Frontend) LoadCore(emu string) {
+	conf := f.conf.GetLibretroCoreConfig(emu)
+
+	libExt := ""
+	if ar, err := f.conf.Libretro.Cores.Repo.Guess(); err == nil {
+		libExt = ar.Ext
+	} else {
+		f.log.Warn().Err(err).Msg("system arch guesser failed")
+	}
+
+	meta := nanoarch.Metadata{
+		AutoGlContext:   conf.AutoGlContext,
+		FrameDup:        f.conf.Libretro.Dup,
+		Hacks:           conf.Hacks,
+		HasVFR:          conf.VFR,
+		Hid:             conf.Hid,
+		Hid4rom:         conf.Hid4rom,
+		HidGc:           conf.HidGc,
+		IsGlAllowed:     conf.IsGlAllowed,
+		HwContext:       conf.HwContext,
+		LibPath:         conf.Lib,
+		Options:         conf.Options,
+		Options4rom:     conf.Options4rom,
+		Fps4rom:         conf.Fps4rom,
+		UsesLibCo:       conf.UsesLibCo,
+		CoreAspectRatio: conf.CoreAspectRatio,
+		KbMouseSupport:  conf.KbMouseSupport,
+		LibExt:          libExt,
+	}
+	f.mu.Lock()
+	f.SaveStateFs = conf.SaveStateFs
+	f.NoSaveStates = conf.NoSaveStates
+	f.AudioMaster = conf.AudioMaster
+	if conf.AudioMaster {
+		f.log.Info().Msgf("%v: audio-mastered pacing (the audio clock may outrun the fps floor)", emu)
+	}
+	f.NoAutoSaveStates = conf.NoAutoSaveStates
+	if conf.NoSaveStates {
+		f.log.Info().Msgf("%v: save-states are off for this core; progress lives on the memory card", emu)
+	} else if conf.NoAutoSaveStates {
+		f.log.Info().Msgf("%v: periodic autosave harvests the card only; manual Save/Load and save-on-quit still serialize", emu)
+	}
+	// AudioSilenceFill and AudioMaster are opposite answers to "the audio clock is behind real time", and
+	// running both would have the pacer chasing a deficit that the filler keeps erasing. Refuse the combo
+	// loudly rather than let it half-work: silence-fill wins because it is the one that can be WRONG in an
+	// audible way if it fires on the other kind of core.
+	if conf.AudioSilenceFill && conf.AudioMaster {
+		f.log.Warn().Msgf("%v: audioSilenceFill and audioMaster are mutually exclusive — dropping audioMaster", emu)
+		f.AudioMaster = false
+	}
+	f.AudioSilenceFill = conf.AudioSilenceFill
+	if f.AudioSilenceFill {
+		f.log.Info().Msgf("%v: audio silence-fill armed (this core emits nothing while the game is quiet)", emu)
+	}
+	f.ScaleMaxWidth = conf.ScaleMaxWidth
+	// Rewind is opt-in per core and hard-gated on the one thing that is categorically disqualifying:
+	// a core that cannot be serialized at all. NoSaveStates is that flag (PSP, PS2 — their progress
+	// lives on the memory card precisely because serializing them wedges or crashes them).
+	//
+	// LibCo used to be disqualifying too, on the belief that routing serialize through the cothread
+	// trampoline was inherently unsafe and that "mupen is flaky". Both halves of that are stale:
+	// patch 0030 moved serialize AND its size probe onto the core's own thread, and the same patch
+	// fixed same_thread_with_args reading the Go POINTER-to-size as the size — which is exactly what
+	// made mupen's load-states flaky. N64 has autosaved and quicksaved through that path in
+	// production since. So the gate is capability, not thread model; everything else stays opt-in
+	// per core, and a core whose serialize fails three times running still drops rewind for the
+	// session on its own.
+	if conf.Rewind && conf.NoSaveStates {
+		f.log.Warn().Msgf("%v: rewind is configured but this core cannot be serialized (noSaveStates) — off", emu)
+	}
+	if armed := conf.Rewind && !conf.NoSaveStates; armed {
+		f.rewindStepFrames = conf.RewindStepFrames
+		if f.rewindStepFrames <= 0 {
+			f.rewindStepFrames = 6 // ~100 ms granularity at 60 fps
+		}
+		mb := conf.RewindMB
+		if mb <= 0 {
+			mb = 512
+		}
+		f.rewindMaxBytes = mb << 20
+		f.rewindArmed.Store(true)
+		f.log.Info().Msgf("%v: rewind armed (step %v frames, cap %v MB)", emu, f.rewindStepFrames, mb)
+	}
+	if conf.UniqueSaveDir {
+		f.UniqueSaveDir = true
+		f.nano.SetSaveDirSuffix(f.storage.MainPath())
+		f.log.Debug().Msgf("Using unique dir for saves: %v", f.storage.MainPath())
+	}
+	// Drop a cache the current core build did not write. Must run HERE: the save dir is final by now
+	// (the block above may have re-pointed it), and the core reads its cache during the load that
+	// follows — context_reset, still inside this same call. A purge after that point would be a no-op.
+	f.purgeForeignCoreCache(conf, corePath(conf, libExt))
+	// Scale > 1 magnifies (2D cores: integer nearest upscale, which is what preserves pixel art and puts
+	// the 4:2:0 chroma plane back at native resolution). Scale < 1 SHRINKS, which is supersampling:
+	// render the core at N x native and average it down before the encoder sees it. That is the only
+	// anti-aliasing available to cores whose MSAA is inert under libretro's non-multisampled hw_render
+	// FBO (measured: mupen64plus and ppsspp produce BIT-IDENTICAL frames with MSAA on and off; only
+	// Dolphin, which owns its framebuffers, actually multisamples).
+	//
+	// The old gate was `> 1`, which silently ignored any fractional scale. round() in the media pipe
+	// already handles it (it rounds up to an even size), so this is the whole change. Pair a fractional
+	// scale with a SMOOTH scaleMethod (bilinear2): nearest would point-sample and defeat the purpose —
+	// downscaling with nearest doesn't anti-alias, it aliases.
+	scale := 1.0
+	if conf.Scale > 0 && conf.Scale != 1 {
+		scale = conf.Scale
+		f.log.Debug().Msgf("Scale: x%v (%s)", scale, map[bool]string{true: "supersample", false: "magnify"}[scale < 1])
+	}
+	f.storage.SetNonBlocking(conf.NonBlockingSave)
+	f.scale = scale
+	f.scaleM = conf.ScaleMethod
+	f.isGL = conf.IsGlAllowed
+	f.nano.CoreLoad(meta)
+	f.mu.Unlock()
+}
+
+func (f *Frontend) handleAudio(audio unsafe.Pointer, samples int) {
+	// Time warp (fast-forward/rewind) drops audio entirely: a 4x-fast core produces 4x the samples,
+	// which would pile into the Opus pipeline's buffer and come out as chipmunk sound followed by a
+	// permanent multi-second audio lag after release. Silence while engaged is the correct sound —
+	// the pacer pins the audio epoch meanwhile, so release resumes debt-free (see the warp branch).
+	if f.ffOn.Load() || f.rwOn.Load() {
+		return
+	}
+	fr, _ := audioPool.Get().(*app.Audio)
+	if fr == nil {
+		fr = new(app.Audio)
+	}
+	// !to look if we need a copy
+	fr.Data = unsafe.Slice((*byte)(audio), samples<<1)
+	// due to audio buffering for opus fixed frames and const duration up in the hierarchy,
+	// we skip Duration here
+	f.onAudio(*fr)
+	audioPool.Put(fr)
+}
+
+// pushSilence hands the audio pipeline n frames (per channel) of silence, as if the core had produced
+// them. S16LE stereo, so 4 bytes a frame — and the buffer is grown-and-reused rather than allocated,
+// because this runs on the emulator goroutine inside the frame budget.
+//
+// Called ONLY from the pacing loop, which is that same goroutine — the same one every real audio frame
+// arrives on (coreAudioSampleBatch fires inside retro_run), so this needs no extra synchronisation and
+// can never interleave with a real callback.
+func (f *Frontend) pushSilence(n int) {
+	need := n << 2
+	if cap(f.silenceBuf) < need {
+		f.silenceBuf = make([]byte, need)
+	}
+	f.onAudio(app.Audio{Data: f.silenceBuf[:need]})
+}
+
+// skipFrame is nanoarch's per-frame delivery gate (Handlers.SkipFrame). It runs on the emulator
+// thread inside video_cb, BEFORE the frame is captured, and true means the frame is never captured
+// at all — no Vulkan/GL zero-copy slot checked out, no blit, no readback.
+//
+// It lives at that point, and not at the top of handleVideo where it used to, because dropping a
+// frame AFTER capture leaks the pool slot the capture checked out: nothing but GStreamer freeing the
+// wrapping buffer ever returns one. Holding fast-forward for half a second was enough to leak all
+// eight and freeze the picture for the rest of the session. See coreVideoRefresh.
+func (f *Frontend) skipFrame() bool {
+	if f.conf.SkipLateFrames && f.skipVideo {
+		return true
+	}
+	// Fast-forward: the core renders up to ffRatio× the frames, but the encoder must keep seeing
+	// ~native fps — every skipped frame is pure savings (the capture itself, NVENC load, bitrate,
+	// client decode) and the player can't perceive frames that would exceed their display anyway.
+	// Same-goroutine state: video_cb fires inside retro_run, on the emulator loop's thread.
+	if f.ffOn.Load() {
+		minGap := int64(0)
+		if fps := f.nano.VideoFramerate(); fps > 0 {
+			minGap = int64(float64(time.Second) / fps * 0.9)
+		}
+		if now := os.Nanotime(); now-f.ffLastVideoNs < minGap {
+			return true
+		} else {
+			f.ffLastVideoNs = now
+		}
+	}
+	return false
+}
+
+func (f *Frontend) handleVideo(data []byte, delta time.Duration, fi nanoarch.FrameInfo) {
+	fr, _ := videoPool.Get().(*app.Video)
+	if fr == nil {
+		fr = new(app.Video)
+	}
+	// STALE-FRAME FIX #1 (2026-07-17): on a per-frame geometry reneg (PS2 field/frame flip, loading<->level
+	// at 1280x447<->1280x896), the previous lastFrame is PRE-transition content. Drop the reference so a
+	// dropped-frame dup (handleDup re-pushes lastFrame) can never replay the old geometry across the
+	// transition — the new frame below re-seeds it. Pairs with fix #2 (leaky appsrc drops the stale backlog).
+	if lastFrame != nil && (int(fi.W) != lastFrame.Frame.W || int(fi.H) != lastFrame.Frame.H) {
+		lastFrame = nil
+	}
+
+	fr.Frame.Data = data
+	fr.Frame.Tex = fi.Tex
+	fr.Frame.Serial = fi.Serial
+	fr.Frame.W = int(fi.W)
+	fr.Frame.H = int(fi.H)
+	fr.Frame.Stride = int(fi.Stride)
+	fr.Duration = delta
+
+	lastFrame = fr
+	f.onVideo(*fr)
+
+	videoPool.Put(fr)
+}
+
+func (f *Frontend) handleDup() {
+	if lastFrame == nil {
+		return
+	}
+	// DUP-PIN (gc "wrong frame at idle"): lastFrame.Frame.Tex is a BORROWED zero-copy slot texture, not an
+	// owned copy. GStreamer frees the slot after encode and a later frame can re-blit new content into the
+	// same texture id — so re-pushing a stale borrowed slot encodes the wrong frame. If this is a zc frame
+	// (Serial != 0) and its slot no longer holds this exact serial, SKIP the dup: a skipped dup is harmless
+	// (the encoder just repeats its last frame). Readback frames (Serial 0) own their pixels — always safe.
+	if lastFrame.Frame.Serial != 0 && !f.nano.ZcTexCurrent(lastFrame.Frame.Tex, lastFrame.Frame.Serial) {
+		return
+	}
+	f.onVideo(*lastFrame)
+}
+
+func (f *Frontend) Shutdown() {
+	f.mu.Lock()
+	f.nano.Shutdown()
+	f.SetAudioCb(noAudio)
+	f.SetVideoCb(noVideo)
+	lastFrame = nil
+	f.mu.Unlock()
+	f.log.Debug().Msgf("frontend shutdown done")
+}
+
+func (f *Frontend) linkNano(nano *nanoarch.Nanoarch) {
+	f.nano = nano
+	if nano == nil {
+		return
+	}
+	f.nano.WaitReady() // start only when nano is available
+
+	f.nano.OnVideo = f.handleVideo
+	f.nano.OnAudio = f.handleAudio
+	f.nano.OnDup = f.handleDup
+	f.nano.SkipFrame = f.skipFrame
+}
+
+func (f *Frontend) SetVideoChangeCb(fn func()) {
+	if f.nano != nil {
+		f.nano.OnSystemAvInfo = fn
+	}
+}
+
+func (f *Frontend) Start() {
+	f.log.Debug().Msgf("frontend start")
+	if f.nano.Stopped.Load() {
+		f.log.Warn().Msgf("frontend stopped during the start")
+		f.mui.Lock()
+		defer f.mui.Unlock()
+		f.Shutdown()
+		return
+	}
+
+	if f.isGL {
+		// don't jump between threads
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+	}
+
+	f.mui.Lock()
+	f.done = make(chan struct{})
+	f.doneEvt = make(chan struct{})
+	f.nano.LastFrameTime = time.Now()
+
+	defer func() {
+		// FIRST, before anything that can take the process down with it (patch 0041). Both steps
+		// below can: a serialize can access-violate inside a core, and flycast corrupts the heap on
+		// teardown — and a dead worker harvests nothing, so the room used to end with the player's
+		// card still sitting in the worker's dirs, unvaulted. The card is cheap to copy and it IS
+		// the progress on the systems that have one. It goes first.
+		f.harvestCards()
+
+		// Save game on quit — UNCONDITIONALLY (patch 0031). Stock gated this on HasSave()
+		// ("only re-save if saved before"), which meant a session where nobody clicked Save
+		// harvested nothing and the vault's Continue slot stayed empty — and PS2 players
+		// couldn't click Save at all until patch 0030. One serialize at teardown costs
+		// nothing anyone can see; it runs before Shutdown so the core is still live.
+		// The NoSaveStates skip is on the STATE only — Save() writes the battery first and returns
+		// ErrNoSaveStates after, so a psp/ps2/scummvm room still flushes its card here.
+		if f.SaveOnClose {
+			f.log.Debug().Msg("save on quit")
+			if err := f.Save(); err != nil && !errors.Is(err, ErrNoSaveStates) {
+				f.log.Error().Err(err).Msg("save on quit failed")
+			}
+		}
+		f.mui.Unlock()
+		f.Shutdown()
+		// AND again after: the cores that DO survive teardown (Dolphin, PCSX2) flush their card on the
+		// way out, so this pass picks that up. It cannot undo the one above — vaulting never replaces
+		// a card with an older one (os.CopyTreeNewer).
+		f.harvestCards()
+		close(f.doneEvt)
+	}()
+
+	// skip_boot_restore => DEFERRED restore (patch 0032b): PCSX2 "successfully" unserializes one
+	// tick after init into a WEDGED black GS (then close-save re-serializes the wedge — a poison
+	// loop on the deterministic save id). But an in-session Load a few seconds in round-trips
+	// cleanly (verified live 2026-07-09). So heavy GL cores restore INTO A WARM VM: the same code
+	// path as a user pressing Load ~5s after boot, which is exactly what this schedules.
+	// Run legitimacy: a boot-time restore taints the run ONLY when the player deliberately picked that
+	// state (a named snapshot / Quickload). Recorded BEFORE startCheevos() below reads it, and mirroring
+	// the union of the two restore branches that follow — keep it in step with them. (The deferred
+	// branch restores 5s in, but the run is compromised the moment we commit to restoring, so tainting
+	// at boot is both correct and simpler.)
+	//
+	// ⚠ raSeedExplicit is the whole point of this condition. It used to be absent, so ANY room that
+	// resumed from the auto-save was tagged save-scummed before the player pressed a button — which
+	// meant nobody who plays across sessions could ever earn a clean achievement. Resuming where you
+	// left off is not save-scumming; reloading to undo an outcome is. The worker cannot tell those
+	// apart on its own (all it sees is "a save existed and we restored it"), so the site sends intent.
+	f.raSeedExplicit = f.raSeedExplicit && f.HasSave() && (f.nano.SkipBootRestore() || !f.NoSaveStates)
+	f.raSeededState = f.raSeedExplicit
+
+	// INSERT THE CARD FIRST, and for every core — no HasSave(), no NoSaveStates gate. This is the one
+	// line that makes a battery/memory card its own persistence layer instead of a rider on the
+	// save-state (see the SAVE_RAM note above Save/Load for the five ways that lost people's saves).
+	// The state restores after it, so on a Continue boot the outcome is unchanged: the state applies,
+	// then Load()'s own .srm pass re-asserts the same card bytes.
+	// [boot] markers: the span from here to the first frame is where our worst crashes land, and until
+	// now it logged NOTHING between the core's own load chatter and the emulator loop. A 0xC0000005 in
+	// it left the log's last line owned by the core, which reads like "the core died on load" no matter
+	// which of our post-load steps actually faulted. One Info line per step makes the last line before
+	// a crash name the phase; they are once-per-room, so they cost nothing measurable.
+	f.log.Info().Msg("[boot] restoring SAVE_RAM card")
+	if err := f.RestoreSRAM(); err != nil {
+		f.log.Error().Err(err).Msg("couldn't insert the save card (SAVE_RAM)")
+	}
+	f.log.Info().Msg("[boot] SAVE_RAM done")
+
+	if f.HasSave() && f.nano.SkipBootRestore() {
+		go func() {
+			select {
+			case <-f.done:
+				return
+			case <-time.After(5 * time.Second):
+			}
+			if err := f.RestoreGameState(); err != nil {
+				f.log.Error().Err(err).Msg("deferred boot-restore failed; continuing unsaved")
+			} else {
+				f.log.Info().Msg("deferred boot-restore done (warm-VM resume)")
+			}
+		}()
+	}
+	if f.HasSave() && !f.nano.SkipBootRestore() && !f.NoSaveStates {
+		// advance 1 frame for Mupen, DOSBox save states
+		// loading will work if autostart is selected for DOSBox apps
+		f.Tick()
+		if err := f.RestoreGameState(); err != nil {
+			f.log.Error().Err(err).Msg("couldn't load a save file")
+		}
+	}
+
+	if f.conf.AutosaveSec > 0 {
+		// !to sync both for loops, can crash if the emulator starts later
+		go f.autosave(f.conf.AutosaveSec)
+	}
+
+	// RetroAchievements: bring the session up as soon as the core's memory is live — which for some
+	// cores is not until a frame or two from now (see cheevosBootDecide) — and tear it down when this
+	// loop exits (both on this, the emulator goroutine — rc_client is single-threaded). No-op off.
+	f.beginCheevosBoot()
+	defer f.stopCheevos()
+
+	// The main loop of Libretro
+
+	targetFrameTimeNs := int64(float64(time.Second) / f.nano.VideoFramerate())
+
+	// stop sleeping and start spinning in the remaining 1ms
+	const spinThresholdNs = int64(1 * time.Millisecond)
+
+	// how many frames will be considered not normal
+	const lateFramesThreshold = 3
+
+	// How far an audio-mastered core may be pulled ABOVE its advertised fps to keep its audio clock
+	// fed, as a fraction of one frame. 2% covers PPSSPP's ~0.35-0.6% shortfall many times over while
+	// staying far below anything a player could perceive as fast (60.0 -> 61.2 fps worst case), and it
+	// is a hard ceiling: a core that stopped producing audio entirely could not drift beyond it.
+	const audioPullMax = 0.02
+
+	// How far behind the audio clock an audio-mastered core may fall and still REPAY it rather than have
+	// it forgiven. Sized off what repayment costs: at audioPullMax (2%) a 500 ms deficit takes ~25 s of
+	// imperceptibly-fast emulation to work off, which is fine; a multi-second desync would take minutes,
+	// which is not — that one gets forgiven, as before. Comfortably above any load stall we have measured
+	// (the worst PSP transition is ~60 ms; a cold gc boot ~110 ms).
+	const audioForgiveAfter = 500 * time.Millisecond
+
+	// Silence-fill thresholds (see the AudioSilenceFill field). audioFillAfter must sit well clear of a
+	// healthy core's normal one-tick swing about real time (16.7 ms at 60 fps) so the filler can never
+	// splice silence between live samples; audioFillMaxPerTick bounds the catch-up so an inherited debt
+	// is paid over a few ticks rather than dumped into the Opus queue in one push.
+	const audioFillAfter = 100 * time.Millisecond
+	const audioFillMaxPerTick = 40 * time.Millisecond
+
+	batch := max(f.SpinBatch, 1)
+
+	// AUDIO-DRIVEN PACING. We pace retro_run against the emulated AUDIO clock (the game should produce
+	// exactly sampleRate audio frames per real second) rather than a fixed video fps, with the video
+	// frame time kept as a MAX-RATE FLOOR (never faster than the core's fps; also the whole pace when a
+	// game is silent or a core emits no audio).
+	//
+	// Why: some cores emit a variable amount of emulated time per retro_run. flycast runs a Dreamcast
+	// game's 30fps sections at 2 vblanks per retro_run (2x the audio) but its 60fps menus at 1 vblank —
+	// so a fixed 59.94 pace runs gameplay at DOUBLE SPEED (Sonic Adventure, Jet Set Radio) while menus
+	// are correct. Pacing to audio makes each section play at its true rate automatically, with no
+	// per-game data (this is what stock emulators do — "sync to audio"). Constant-rate cores (PSP, 60fps
+	// DC, all 2D) produce audio at a steady sampleRate/fps per frame, so the floor dominates and behavior
+	// is unchanged.
+	// Nan0 is a singleton reused across rooms — clear any rate derived for a PREVIOUS game before we
+	// read the declaration, or this room starts timed against the last game's measurement.
+	f.nano.SetDerivedAudioSampleRate(0)
+	sr := float64(f.nano.AudioSampleRate())
+	if sr <= 0 {
+		sr = 44100
+	}
+	audioEpoch := os.Nanotime() // real-time anchor of the audio clock
+	var audioFrames int64       // cumulative audio frames produced (the audio clock)
+	floorNext := os.Nanotime()  // earliest allowed time for the next tick (max-rate floor)
+
+	// ── TRUE-RATE DERIVATION ─────────────────────────────────────────────────────────────────────
+	// sr is the denominator of every audio-clock computation (the deadline, the epoch re-pin, the
+	// deficit, the silence-fill threshold). It used to be read ONCE, here, while the video frame time
+	// IS re-read every tick to follow the core — so we honoured half of SET_SYSTEM_AV_INFO and a
+	// mid-session rate change left the pacer timing against a stale denominator forever.
+	//
+	// Worse, a core can be wrong from the START: parallel_n64 declares 32040 Hz on SM64: Last Impact
+	// and delivers ~31230 (2.6% short). audioPullMax caps the rescue at 2%, so the pacer pins at the
+	// clamp and the delivered rate OSCILLATES — audible as crackle, and immune to every downstream
+	// remedy (client jitter buffer 80 -> 400 ms and Opus frame-size 10 -> 20 ms both measured no
+	// change, because a rate error is not jitter).
+	//
+	// So: measure what the core actually produces and adopt it. Then no pull is needed (the game runs
+	// at its true speed rather than 2.6% fast) and room.go's per-batch AudioSampleRate() comparison
+	// re-caps the appsrc + resampler for free through ReconfigureAudio.
+	const rateWindow = 3 * time.Second // long enough to average out bursty audio DMA
+	const rateAdoptMin = 0.005         // < 0.5% error: leave it, the pull absorbs that inaudibly
+	const rateAgree = 0.003            // consecutive windows must agree within 0.3% to count as steady
+	const rateSane = 0.15              // never adopt further than 15% from the declaration
+	const rateAdoptMax = 3             // bound thrash; a core that needs more than this is broken elsewhere
+	rateWinStart := os.Nanotime()
+	var rateWinFrames int64
+	var ratePrevObserved float64
+	rateAdoptions := 0
+	rateWinDirty := false // a warp/fill/stall happened in this window -> its average is meaningless
+
+	// pace-diag: every 5s, log what the emulator actually produced — ticks/s, audio frames/s (should
+	// track the core's sample rate), the worst single retro_run of the window, and how many ticks blew
+	// a 20ms budget. Steady audio/s while the player hears gaps = the problem is DOWNSTREAM of the
+	// emulator (encode/network/client).
+	//
+	// ⚠ DO NOT DELETE OR DEMOTE THIS TO Debug, despite it having started life as a temporary probe.
+	// It is now the GL worker's HEARTBEAT: nothing else logs periodically during a healthy room (ABR
+	// only logs on change), and the watchdog's wedge test is "the coordinator says this worker is BUSY
+	// but its log has been silent for >150s -> kill it" (scripts/watch-arcade-glworkers.ps1). Silence
+	// this line and a healthy long session looks exactly like a wedged one. The capture mod keeps its
+	// own 5s "capture tick" for the same reason.
+	diagWindow := os.Nanotime()
+	var diagTicks, diagSlow int64
+	var diagAudioBase int64
+	var diagMaxTickNs int64
+
+	// pace-diag II — the audio-underrun probe (2026-07-14). The four fields above CANNOT see the PSP
+	// crackle, and that blindness cost us a wrong verdict (we A/B'd two cores on maxTick, saw a wash,
+	// and rolled back the one that actually fixed the sound). They are blind structurally:
+	//
+	//   * audio/s reads ~100% of the sample rate on ANY arm, because the pacer TARGETS the audio clock.
+	//     It says what the loop asked for, not whether the core could deliver it.
+	//   * maxTick is the WORST retro_run of a 5 s window — an outlier. Repaying an audio deficit needs
+	//     the core to run <=2% FAST for seconds on end, which is a question about the MEAN frame cost.
+	//
+	// So measure the thing that decides whether a stall gets repaid or becomes a permanent hole in the
+	// stream: HEADROOM. sumTick/ticks is what a frame really costs; noSleep counts the ticks that had no
+	// spare time at all (the loop was already late leaving retro_run — at that point the core CANNOT run
+	// fast, so the deficit stands and the client's jitter buffer eats it, forever). deficit is the audio
+	// clock's live debt at window end, and forgiven counts the stalls the pacer gave up on repaying.
+	// A core that crackles should show: noSleep high, deficit climbing, forgiven > 0.
+	var diagSumTickNs int64
+	var diagNoSleep int64
+	var diagForgiven int64
+	var diagMaxDeficitNs int64
+	// silence/s counts the frames the silence-filler injected, kept SEPARATE from audio/s on purpose:
+	// audio/s must keep reporting what the CORE produced, or the one number that shows a core has gone
+	// quiet would be masked by our own fill and the metric would lie exactly where it matters.
+	var diagSilence int64
+
+	// prevRw edge-detects rewind engage so the first pop happens NOW, not up to a step later —
+	// a held rewind that visibly does nothing for 100 ms feels broken.
+	prevRw := false
+
+	for {
+		select {
+		case <-f.done:
+			return
+		default:
+			// ── Time warp state (fast-forward / rewind, t=114/115) ────────────────────────
+			ff := f.ffOn.Load()
+			rw := f.rwOn.Load() && f.rewindArmed.Load() && !ff // FF wins when both are held
+			if rw && !prevRw {
+				f.rewindPopNow = true
+			}
+			prevRw = rw
+			f.rewindTicks++
+
+			// Deferred RetroAchievements bring-up: retry until the core's memory shows up. One
+			// already-hot bool per frame once it has settled, which it does within a frame or two.
+			if f.raBootPending {
+				f.stepCheevosBoot()
+			}
+			if rw {
+				f.rewindStep()
+			}
+
+			tick0 := os.Nanotime()
+			f.Tick()
+			tickDur := os.Nanotime() - tick0
+
+			// Record the ring OUTSIDE any warp: never while rewinding (we'd re-record what we
+			// just walked back over), and not during FF (a serialize per step is exactly the
+			// cost the 4x tick rate has no room for). An FF'd span is thus absent from the
+			// ring — rewinding across it jumps straight over, which is acceptable.
+			if f.rewindArmed.Load() && !rw && !ff && f.rewindTicks%uint64(f.rewindStepFrames) == 0 {
+				f.rewindCapture()
+			}
+
+			audioDelta := f.nano.TakeAudioFrames()
+			audioFrames += audioDelta
+
+			// ── Follow the core's rate, and derive it when the declaration is wrong ───────────
+			// (1) Honour a CHANGED rate (SET_SYSTEM_AV_INFO, or our own derivation below). Re-pinning
+			// the epoch is mandatory: sr is the denominator of the audio clock, so swapping it without
+			// restarting the anchor would make the clock jump by the ratio of old to new.
+			if cur := float64(f.nano.AudioSampleRate()); cur > 0 && cur != sr {
+				f.log.Info().Msgf("[audio] pacer sample rate %.0f -> %.0f Hz (re-pinning audio clock)", sr, cur)
+				sr = cur
+				audioEpoch = os.Nanotime()
+				audioFrames = 0
+				rateWinStart = audioEpoch
+				rateWinFrames = 0
+				ratePrevObserved = 0
+			}
+
+			// (2) Measure what the core REALLY delivers. Windows containing a warp or a silence-fill are
+			// discarded rather than averaged — fast-forward multiplies audio, rewind drops it, and a fill
+			// injects samples the core never made, so any of them would poison the measurement.
+			rateWinFrames += audioDelta
+			if ff || rw {
+				rateWinDirty = true
+			}
+			if el := os.Nanotime() - rateWinStart; el >= int64(rateWindow) {
+				observed := float64(rateWinFrames) / (float64(el) / 1e9)
+				declared := float64(f.nano.DeclaredAudioSampleRate())
+				sane := declared > 0 && observed > declared*(1-rateSane) && observed < declared*(1+rateSane)
+				steady := ratePrevObserved > 0 && absf(observed-ratePrevObserved)/observed < rateAgree
+				wrong := absf(observed-sr)/sr > rateAdoptMin
+
+				if !rateWinDirty && sane && steady && wrong && rateAdoptions < rateAdoptMax {
+					rateAdoptions++
+					hz := int(observed + 0.5)
+					f.log.Warn().Msgf(
+						"[audio] DERIVED true sample rate %d Hz (core declares %.0f, pacer had %.0f, %.2f%% off) "+
+							"— adopting: pacer re-times and the appsrc/resampler re-cap. A declared-vs-delivered "+
+							"error beyond audioPullMax (%.0f%%) cannot be paced away and is heard as crackle.",
+						hz, declared, sr, (observed-sr)/sr*100, audioPullMax*100)
+					// Installing the override changes what AudioSampleRate() returns, so branch (1) picks
+					// it up on the next tick (re-pinning the clock) and room.go's per-batch comparison
+					// re-caps the pipeline via ReconfigureAudio. One write, both consumers.
+					f.nano.SetDerivedAudioSampleRate(hz)
+				}
+				ratePrevObserved = observed
+				rateWinStart = os.Nanotime()
+				rateWinFrames = 0
+				rateWinDirty = false
+			}
+
+			// ── Audio silence-fill (2026-07-27) ───────────────────────────────────────────
+			// Top the audio clock back up to real time with actual silence when an armed core
+			// has simply stopped emitting (see Frontend.AudioSilenceFill for why ScummVM does).
+			// The samples are real: they go down the same path the core's would, so the Opus
+			// stream keeps ticking, the client's jitter buffer stays primed through a quiet
+			// passage, and the audio track remains a wall-clock timebase.
+			//
+			// Never during a warp — handleAudio drops audio outright there and the warp branch
+			// pins the epoch, so "behind" is meaningless and a fill would be dropped anyway.
+			if f.AudioSilenceFill && !ff && !rw {
+				behind := os.Nanotime() - (audioEpoch + int64(float64(audioFrames)/sr*1e9))
+				// audioFillAfter is the arming threshold, NOT a target: a healthy core's clock
+				// swings by a tick (16.7 ms at 60 fps) either side of real time all the time, and
+				// filling that would splice silence into live sound. 100 ms is far outside that
+				// swing and still only ~1/10 s of quiet before the stream is carrying samples again.
+				if behind > int64(audioFillAfter) {
+					// Bound the per-tick fill so a debt inherited from a long silence (or from
+					// boot) is paid down over several ticks instead of arriving as one burst the
+					// Opus queue has to swallow whole.
+					fill := min(behind, int64(audioFillMaxPerTick))
+					if n := int(float64(fill) / 1e9 * sr); n > 0 {
+						f.pushSilence(n)
+						audioFrames += int64(n)
+						diagSilence += int64(n)
+					}
+				}
+			}
+
+			diagTicks++
+			diagSumTickNs += tickDur
+			if tickDur > diagMaxTickNs {
+				diagMaxTickNs = tickDur
+			}
+			if tickDur > 20*1e6 {
+				diagSlow++
+			}
+			if now := os.Nanotime(); now-diagWindow >= 5*1e9 {
+				winSec := float64(now-diagWindow) / 1e9
+				// Live audio debt: how far real time has run past where the audio the core produced says
+				// it should be. Positive = the client is owed samples that do not exist yet.
+				deficitNs := os.Nanotime() - (audioEpoch + int64(float64(audioFrames)/sr*1e9))
+				vcb, vnull := f.nano.TakeVideoFrames()
+				f.log.Info().Msgf(
+					"pace-diag: ticks/s=%.1f audio/s=%.0f silence/s=%.0f video/s=%.1f vnull/s=%.1f maxTick=%.1fms slowTicks(>20ms)=%d "+
+						"meanTick=%.2fms noSleep=%.1f%% deficit=%.1fms maxDeficit=%.1fms forgiven=%d",
+					float64(diagTicks)/winSec,
+					// audio/s is the CORE's own production — the injected silence is netted back out so
+					// this number keeps meaning what every past reading of it meant.
+					float64(audioFrames-diagAudioBase-diagSilence)/winSec,
+					float64(diagSilence)/winSec,
+					float64(vcb)/winSec, float64(vnull)/winSec,
+					float64(diagMaxTickNs)/1e6, diagSlow,
+					float64(diagSumTickNs)/float64(max(diagTicks, 1))/1e6,
+					100*float64(diagNoSleep)/float64(max(diagTicks, 1)),
+					float64(deficitNs)/1e6, float64(diagMaxDeficitNs)/1e6, diagForgiven)
+				diagWindow, diagTicks, diagSlow, diagMaxTickNs = now, 0, 0, 0
+				diagSumTickNs, diagNoSleep, diagForgiven, diagMaxDeficitNs = 0, 0, 0, 0
+				diagSilence = 0
+				diagAudioBase = audioFrames
+			}
+
+			// Track mid-run fps changes (SET_SYSTEM_AV_INFO) so the floor follows the core's fps.
+			if fps := f.nano.VideoFramerate(); fps > 0 {
+				if nt := int64(float64(time.Second) / fps); nt != targetFrameTimeNs {
+					targetFrameTimeNs = nt
+				}
+			}
+
+			// ── Time-warp pacing ──────────────────────────────────────────────────────────
+			// While fast-forwarding or rewinding the audio clock is moot (handleAudio drops
+			// every sample), so pacing falls back to a pure frame-time floor: 1/ffRatio of a
+			// frame per tick when fast-forwarding, one real frame per tick when rewinding.
+			// The audio epoch is re-pinned to "no debt" every warped tick, so the instant the
+			// player lets go the normal pacer resumes with a clean clock — no sprint, no
+			// forgiveness hole, no repayment.
+			if ff || rw {
+				now := os.Nanotime()
+				audioEpoch = now - int64(float64(audioFrames)/sr*1e9)
+				step := targetFrameTimeNs
+				if ff {
+					step /= ffRatio
+				}
+				deadline := floorNext
+				// A stall (or the moment of engage, when floorNext is a full audio deadline
+				// away) must not trigger a catch-up sprint — warp pacing is relative to now.
+				if deadline < now-step*lateFramesThreshold || deadline > now+step*lateFramesThreshold {
+					deadline = now
+				}
+				if sleepNs := deadline - now; sleepNs > 0 {
+					if sleepNs > spinThresholdNs {
+						time.Sleep(time.Duration(sleepNs - spinThresholdNs))
+					}
+					for os.Nanotime() < deadline {
+						for range batch - 1 {
+						}
+					}
+					f.skipVideo = false
+				} else {
+					diagNoSleep++
+					f.skipVideo = true
+				}
+				floorNext = deadline + step
+				continue
+			}
+
+			// Audio deadline: when real-time SHOULD be, given the audio produced so far.
+			audioDeadline := audioEpoch + int64(float64(audioFrames)/sr*1e9)
+			// Floor: never run faster than the core fps (covers silence + no-audio cores).
+			floor := floorNext
+			// ...unless this core is audio-mastered, and it is actually producing audio right now.
+			//
+			// A core whose audio clock runs SLOWER than its video clock can never be rescued by the
+			// max() below: its audioDeadline is always earlier than the floor, so the floor always wins,
+			// the loop never speeds up, and the core keeps under-feeding the encoder for the whole
+			// session. PPSSPP does exactly this (733 samples/frame where its own 44100 Hz @ 59.94 fps
+			// implies 735.7) and the missing ~250 samples/sec drain the client's audio buffer until it
+			// underruns — the faint PSP crackle. Letting the audio clock pull the loop a little faster
+			// than nominal makes the core produce exactly what the encoder consumes.
+			//
+			// Two guards, and they are the whole reason this is safe: the pull is bounded to audioPullMax
+			// (a core cannot run away), and it only applies while audio is FLOWING (a silent or audio-less
+			// core keeps the honest fps floor, which is what the floor was there for in the first place).
+			if f.AudioMaster && audioDelta > 0 {
+				floor -= int64(float64(targetFrameTimeNs) * audioPullMax)
+			}
+			deadline := floor
+			if audioDeadline > deadline {
+				deadline = audioDeadline
+			}
+
+			now := os.Nanotime()
+			// Resync if we've fallen far behind the audio clock (emulation stall / big catch-up batch):
+			// rebase the audio epoch so we don't sprint to catch up.
+			//
+			// But rebasing FORGIVES the audio the core failed to produce, and forgiven audio is a hole in
+			// the stream that nothing ever fills. A 60 ms load stall (PSP reading its savedata when the
+			// player walks into a sign) is ~55 ms of samples the client's jitter buffer silently eats —
+			// and it never gets them back, so buffer depth ratchets down with every transition until it
+			// underruns and the player hears a crackle. That is the PSP crackle, and it is OUR pacer's
+			// doing, not the core's.
+			//
+			// An audio-mastered core is allowed to REPAY a stall instead: leaving the epoch alone keeps the
+			// audio clock authoritative, so the loop runs (bounded by audioPullMax, i.e. ≤2% fast) until the
+			// missing samples are made up and the buffer refills — a few seconds later, inaudibly. The
+			// rebase still exists for a stall so large that repaying it would mean sprinting for minutes;
+			// that is a genuine desync, not a hiccup, and forgiving it is right.
+			resyncAfter := targetFrameTimeNs * lateFramesThreshold
+			if f.AudioMaster {
+				resyncAfter = int64(audioForgiveAfter)
+			}
+			if lateBy := now - deadline; lateBy > diagMaxDeficitNs {
+				diagMaxDeficitNs = lateBy
+			}
+			if now-deadline > resyncAfter {
+				// The pacer is about to FORGIVE this much audio — samples the core never produced and
+				// now never will. Each one is a permanent hole the client's jitter buffer absorbs.
+				diagForgiven++
+				audioEpoch += now - deadline
+				deadline = now
+			}
+			// Clamp a large forward jump (audio burst after a silent stretch) so one tick can't stall the
+			// loop for many frames; pull the epoch back so the clock stays consistent afterward.
+			if maxAhead := targetFrameTimeNs * lateFramesThreshold; deadline-now > maxAhead {
+				audioEpoch -= (deadline - now) - maxAhead
+				deadline = now + maxAhead
+			}
+
+			if sleepNs := deadline - now; sleepNs > 0 {
+				if sleepNs > spinThresholdNs {
+					time.Sleep(time.Duration(sleepNs - spinThresholdNs))
+				}
+				for os.Nanotime() < deadline {
+					for range batch - 1 {
+					}
+				}
+				f.skipVideo = false
+			} else {
+				// No sleep left: retro_run itself ate the whole frame budget. This is the tick that
+				// decides the crackle — a core with no spare time cannot run the <=2% fast that repaying
+				// an audio deficit requires, so the debt stands and the buffer ratchets down.
+				diagNoSleep++
+				if f.conf.LogDroppedFrames {
+					f.log.Debug().Msgf("[] Frame drop: %v", time.Duration(-sleepNs))
+				}
+				f.skipVideo = true
+			}
+
+			// Anchor the next floor to this frame's intended deadline (drift-free 60fps cap).
+			floorNext = deadline + targetFrameTimeNs
+		}
+	}
+}
+
+// ── Core-build cache isolation (MovieTheater patch 0042) ────────────────────────────────────────
+//
+// A shader/pipeline cache is only meaningful to the exact core BUILD that wrote it. Dolphin compares
+// its pipeline UIDs with memcmp, and two builds of the same emulator lay that struct out differently,
+// so a core handed a foreign cache matches nothing, recompiles every pipeline INLINE on the emulator
+// thread, and appends its own UIDs next to the ones it could not read. The file grows without ever
+// becoming useful, and it happens on every boot, not just the first — the "GX slowdown" was this.
+//
+// So the cache is stamped with the identity of the build that owns it, and a core that finds someone
+// else's stamp throws the cache away rather than trying to read it. Regenerating a shader cache is
+// cheap and automatic; reading a poisoned one never stops being expensive.
+
+// coreBuildId identifies a core BUILD, not a core name. The name is not enough: we rebuild the custom
+// Dolphin against upstream, and the stock core is overwritten by the nightly repo sync — same filename,
+// different pipeline UIDs, same poison. Hashing the library is the only identity that tracks that.
+func coreBuildId(libPath string) (string, error) {
+	lib, err := os.ReadFile(libPath)
+	if err != nil {
+		return "", err
+	}
+	return fmt.Sprintf("%x", sha256.Sum256(lib))[:16], nil
+}
+
+// corePath rebuilds the library path nanoarch will actually dlopen (see nanoarch.coreLoad).
+func corePath(conf config.LibretroCoreConfig, libExt string) string { return conf.Lib + libExt }
+
+func (f *Frontend) purgeForeignCoreCache(conf config.LibretroCoreConfig, libPath string) {
+	if conf.CoreCache.Dir == "" || len(conf.CoreCache.Purge) == 0 {
+		return
+	}
+
+	baseDir, baseName := f.nano.SaveDir(), "save"
+	if conf.CoreCache.SystemDir {
+		baseDir, baseName = f.nano.SystemDir(), "system"
+	}
+	cacheDir := filepath.Join(baseDir, filepath.FromSlash(conf.CoreCache.Dir))
+	// Containment guard. Everything below deletes, and the dir comes from config — a "../.." in it
+	// would aim this at the save/system tree. Refuse rather than trust.
+	if rel, err := filepath.Rel(baseDir, cacheDir); err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		f.log.Error().Msgf("coreCache.dir %q escapes the %s dir — refusing to purge", conf.CoreCache.Dir, baseName)
+		return
+	}
+	if !os.Exists(cacheDir) {
+		return // nothing cached yet; the core will create it and we stamp it on the next boot
+	}
+
+	id, err := coreBuildId(libPath)
+	if err != nil {
+		// Unreadable core: the load about to happen will fail anyway. Don't delete on a guess.
+		f.log.Warn().Err(err).Msgf("couldn't identify the core build; leaving the cache alone")
+		return
+	}
+
+	stampPath := filepath.Join(cacheDir, ".core-build")
+	stamp, err := os.ReadFile(stampPath)
+	owner := strings.TrimSpace(string(stamp))
+	switch {
+	case err == nil && owner == id:
+		// Say so on every boot. A silently-unbound config would leave Dir empty and skip this whole
+		// function — which looks EXACTLY like a healthy run in the logs, right up until the cache is
+		// poisoned again. The presence of this line is the proof that isolation is actually armed.
+		f.log.Info().Msgf("core cache %v owned by this build (%v)", conf.CoreCache.Dir, id)
+		return // ours
+	case err == nil:
+		f.log.Info().Msgf("core cache belongs to build %v, this is %v — dropping it", owner, id)
+	default:
+		// No stamp. Written by a build from before this existed, so it CANNOT be vouched for — and the
+		// unstamped caches that exist today are exactly the poisoned ones. Unknown means foreign.
+		f.log.Info().Msgf("core cache is unstamped (unknown build) — dropping it")
+	}
+
+	var removed int
+	var freed int64
+	for _, pattern := range conf.CoreCache.Purge {
+		// Matched against the TOP LEVEL of the cache dir only, and only against what the core config
+		// named. Dolphin keeps its memory cards under this same User tree; nothing sweeps broadly here.
+		hits, err := filepath.Glob(filepath.Join(cacheDir, pattern))
+		if err != nil {
+			f.log.Error().Err(err).Msgf("bad coreCache.purge pattern %q — skipped", pattern)
+			continue
+		}
+		for _, hit := range hits {
+			freed += treeSize(hit)
+			if err := os.RemoveAll(hit); err != nil {
+				f.log.Error().Err(err).Msgf("couldn't drop cached %v", hit)
+				continue
+			}
+			removed++
+		}
+	}
+	f.log.Info().Msgf("core cache purged: %d entr(ies), ~%v freed, now owned by build %v",
+		removed, byteCount(freed), id)
+
+	if err := os.WriteFile(stampPath, []byte(id), 0644); err != nil {
+		// Non-fatal, but say so loudly: an unwritable stamp means the next boot purges again.
+		f.log.Error().Err(err).Msgf("couldn't stamp the core cache — it will be re-purged next boot")
+	}
+}
+
+// treeSize is the size of the whole subtree. The shader cache is a DIRECTORY, and a plain Stat on a
+// directory reports the dir entry (a handful of bytes), not the megabytes that are the only reason
+// this number is worth logging.
+func treeSize(root string) int64 {
+	var total int64
+	_ = filepath.WalkDir(root, func(_ string, d fs.DirEntry, err error) error {
+		if err != nil || d.IsDir() {
+			return nil
+		}
+		if fi, err := d.Info(); err == nil {
+			total += fi.Size()
+		}
+		return nil
+	})
+	return total
+}
+
+func byteCount(b int64) string {
+	const unit = 1024
+	if b < unit {
+		return fmt.Sprintf("%d B", b)
+	}
+	div, exp := int64(unit), 0
+	for n := b / unit; n >= unit; n /= unit {
+		div *= unit
+		exp++
+	}
+	return fmt.Sprintf("%.1f %cB", float64(b)/float64(div), "KMGTPE"[exp])
+}
+
+// SetRoomCheats stages per-room core-option overrides + cheat codes for the next LoadGame.
+func (f *Frontend) SetRoomCheats(opts map[string]string, codes []string) {
+	f.mu.Lock()
+	f.nano.SetRoomCheats(opts, codes)
+	f.mu.Unlock()
+}
+
+// SetRetroAchievements stages this room's RetroAchievements session — the creator's linked account and
+// whether it runs hardcore (a competitive room). Call BEFORE Load, like SetRoomCheats; the live client
+// is created in Start() once the core's memory exists. Empty user/token = RA off (the common case).
+func (f *Frontend) SetRetroAchievements(user, token, system, knownHash string, hardcore, cheats, seedExplicit bool, h cheevos.Handlers) {
+	f.raUser, f.raToken, f.raSystem, f.raHard, f.raCheats, f.raHandler = user, token, system, hardcore, cheats, h
+	f.raKnownHash = knownHash
+	f.raSeedExplicit = seedExplicit
+}
+
+// NotifySaveStateLoaded / NotifyFastForward / NotifyReset forward run-legitimacy events to the RA
+// client so leaderboard/achievement submissions this run carry the right taint. Called from the
+// coordinator's command goroutine (HandleLoadGame/HandleResetGame); no-op when RA is off. They only
+// flip atomics on the client — never an rc_client call — so they're safe off the emulator goroutine.
+func (f *Frontend) NotifySaveStateLoaded() { f.ra.NotifySaveStateLoaded() }
+func (f *Frontend) NotifyFastForward(on bool) { f.ra.NotifyFastForward(on) }
+func (f *Frontend) NotifyReset()           { f.ra.NotifyReset() }
+
+// How long the deferred bring-up keeps waiting for the core to publish ANY usable memory before it
+// gives up on the room, and how long it waits for the second source once it already has one.
+//
+// The grace is what stops a 2 ms race from costing a room its achievements, and it is sized for
+// "generous, and nobody can feel it": the observed mupen64plus gap is 2 ms, so 2 s is a thousandfold
+// margin, spent at a boot screen before the player has pressed anything. The deadline only ever
+// elapses on a core that publishes no memory at all, where the room was never going to track.
+const (
+	cheevosBootDeadline = 10 * time.Second
+	cheevosBootGrace    = 2 * time.Second
+)
+
+type cheevosBootAction int
+
+const (
+	cheevosBootWait cheevosBootAction = iota
+	cheevosBootStart
+	cheevosBootGiveUp
+)
+
+// cheevosBootDecide is the entire policy of the deferred bring-up, kept pure so it can be tested
+// without a core (frontend_cheevosboot_test.go).
+//
+// EITHER source of memory is enough to run RA, and we want both when we can get them:
+//   - the core's memory MAP is the better one — it maps RA addresses precisely, and it is what
+//     RetroArch uses, so every RA set was authored against it. rc_libretro_memory_init needs nothing
+//     else when it has one.
+//   - SYSTEM_RAM alone still works for the consoles whose RA addresses are a flat offset into it.
+//
+// So the only real failure is having NEITHER by the deadline. Everything else is worth waiting for.
+//
+// ⚠ WAITING IS THE WHOLE FIX — do not "simplify" this back to a single up-front query. A core
+// publishes its RAM pointer and its memory map when IT is ready, not when we happen to ask.
+// mupen64plus returns SYSTEM_RAM ptr=NULL with the SIZE already correct (0x800000) and sets its
+// memory map ~2 ms later, inside its first retro_run. Asking once, before frame 1, therefore
+// disabled RetroAchievements — achievements AND leaderboards — in every single plain-n64 room for
+// over a month (33 rooms; the paraLLEl-N64 rooms next to them worked, which is what made it look
+// core-specific rather than a race). Nothing in the log said "leaderboard" — the room just quietly
+// scored nothing.
+func cheevosBootDecide(hasRAM, hasMap bool, waited time.Duration) cheevosBootAction {
+	switch {
+	case hasRAM && hasMap:
+		return cheevosBootStart
+	case hasRAM || hasMap:
+		// One source is up. Give the core its grace to publish the other before we settle for what we
+		// have: starting without a map that was 2 ms away is exactly how a room ends up with every
+		// achievement disabled as "Invalid address".
+		if waited >= cheevosBootGrace {
+			return cheevosBootStart
+		}
+		return cheevosBootWait
+	case waited >= cheevosBootDeadline:
+		return cheevosBootGiveUp
+	default:
+		return cheevosBootWait
+	}
+}
+
+// beginCheevosBoot arms the deferred RetroAchievements bring-up, on the emulator goroutine, just
+// before the frame loop. It attempts the bring-up immediately — the common case is a core that is
+// already fully up, which then starts before frame 1 exactly as it always did — and otherwise leaves
+// stepCheevosBoot to retry once per frame. No-op when RA is off for the room.
+func (f *Frontend) beginCheevosBoot() {
+	if f.raUser == "" || f.raToken == "" {
+		return
+	}
+	f.log.Info().Msgf("[boot] cheevos: waiting for core memory (system=%v, consoleID=%v)", f.raSystem, cheevos.ConsoleID(f.raSystem))
+	f.raBootPending = true
+	f.raBootStart = os.Nanotime()
+	f.stepCheevosBoot()
+}
+
+// stepCheevosBoot is the per-frame poll of the deferred bring-up. Called from the emulator loop while
+// raBootPending; both reads are a plain call into the core (retro_get_memory_data/size) and a struct
+// field, so a pending poll costs nothing measurable and a settled one costs one bool.
+func (f *Frontend) stepCheevosBoot() {
+	sysRAM, sysSize := f.nano.MemoryRegion(uint(nanoarch.RetroMemorySystemRAM))
+	mmap := f.nano.MemoryMap()
+	waited := time.Duration(os.Nanotime() - f.raBootStart)
+
+	switch cheevosBootDecide(sysRAM != nil && sysSize > 0, mmap != nil, waited) {
+	case cheevosBootWait:
+		return
+	case cheevosBootGiveUp:
+		f.raBootPending = false
+		f.log.Warn().Msgf("RetroAchievements: %v published neither SYSTEM_RAM nor a memory map within %v; achievements disabled for this room", f.raSystem, cheevosBootDeadline)
+		return
+	}
+	f.raBootPending = false
+	f.startCheevos(sysRAM, uint(sysSize), mmap, waited)
+}
+
+// startCheevos brings up the RetroAchievements client once the core's memory is live, on the emulator
+// goroutine. Called only by stepCheevosBoot, which owns the readiness decision above.
+func (f *Frontend) startCheevos(sysRAM unsafe.Pointer, sysSize uint, mmap unsafe.Pointer, waited time.Duration) {
+	// Each of the next few steps calls INTO the core (retro_get_memory_data/size) or walks a struct the
+	// core owns, on a core that has just finished loading — the exact shape of bug that has bitten this
+	// path before (the GBC memory-map dangling pointer). Log each one separately: "which of these five
+	// calls was in flight" is otherwise unanswerable after the fact, and the whole block is silent on
+	// the systems where it bails early.
+	f.log.Info().Msgf("[boot] cheevos: core memory live after %v (SYSTEM_RAM ptr=%p size=0x%X, memoryMap=%p)",
+		waited.Round(time.Millisecond), sysRAM, sysSize, mmap)
+	saveRAM, saveSize := f.nano.MemoryRegion(uint(nanoarch.RetroMemorySaveRAM))
+	f.log.Info().Msgf("[boot] cheevos: SAVE_RAM ptr=%p size=0x%X", saveRAM, saveSize)
+
+	f.ra = cheevos.New(f.raUser, f.raToken, f.raHard, f.raCheats, cheevos.ConsoleID(f.raSystem), f.gamePath, f.raHandler)
+	if f.ra == nil {
+		return
+	}
+	// A room that booted from a restored save-state starts save-scummed. Reuses the mid-run Load taint:
+	// same meaning, same stickiness, same clear-on-hard-reset. Battery/SRAM and memory-card seeding are
+	// deliberately NOT tainted — those are the game's own save system and legitimate on real hardware.
+	f.ra.SetKnownHash(f.raKnownHash)
+	if f.raSeededState {
+		f.ra.NotifySaveStateLoaded()
+	}
+	f.log.Info().Msgf("[boot] cheevos: memoryMap=%p; registering regions", mmap)
+	f.ra.SetMemory(sysRAM, uintptr(sysSize), saveRAM, uintptr(saveSize), mmap)
+	f.log.Info().Msg("[boot] cheevos: regions registered; building address map")
+	// Build the memory region map NOW, before the game load. rc_client probes every achievement address
+	// through our read callback during load — if the regions aren't registered yet it disables the whole
+	// set as "Invalid address". (This, not the memory-map, was why Genesis/N64 never fired.)
+	memOK := f.ra.InitMemory()
+	f.log.Info().Msgf("RetroAchievements: session started (hardcore=%v, seededState=%v, memmap=%v, systemRAM=0x%X, saveRAM=0x%X, regions=%v, waited=%v)",
+		f.raHard, f.raSeededState, mmap != nil, sysSize, saveSize, memOK, waited.Round(time.Millisecond))
+	// regions=false means rc_libretro mapped nothing, so every address reads 0 and the whole set will
+	// be disabled during load. That is a dead room for RA and it must not hide inside an Info line.
+	if !memOK {
+		f.log.Warn().Msgf("RetroAchievements: %v mapped no memory regions (memmap=%v); nothing will track this room", f.raSystem, mmap != nil)
+	}
+}
+
+// stopCheevos tears the client down on the emulator goroutine (after the frame loop stops).
+func (f *Frontend) stopCheevos() {
+	if f.ra != nil {
+		f.ra.Close()
+		f.ra = nil
+	}
+}
+
+func (f *Frontend) LoadGame(path string) error {
+	if f.UniqueSaveDir {
+		f.copyFsMaybe(path)
+	}
+	f.seedCards()
+	f.seedWiiSdLoader(path)
+	f.gamePath = path // RetroAchievements hashes this to identify the game
+	return f.nano.LoadGame(path)
+}
+
+// ── Per-user virtual memory cards (MovieTheater patch 0039) ──────────────────────────────────────
+//
+// A memory card is the one save class libretro never exposes: PCSX2 and Dolphin write theirs into
+// their own directories, so a card is ONE file shared by every player — outside the per-user vault,
+// with no backup. For some games that card IS the progress: Gauntlet Dark Legacy keeps its named
+// characters on the GameCube card, not in the save-state, so a player's characters were visible to
+// (and deletable by) everyone, and would vanish with the directory.
+//
+// The worker has to be the one to move them. The gateway can't: the COORDINATOR picks which worker
+// serves a room, so the gateway never knows whose card directory is in play. The worker knows its
+// own dirs and runs exactly one room at a time — which is also why each worker now needs its OWN
+// ConfDir (two workers sharing one would seed and harvest each other's cards).
+//
+// Only the CARD subtree moves. The save dir also holds Dolphin's shader caches (~850 MB), which are
+// shared, disposable, and regenerate — vaulting those per session would be absurd.
+
+// cardOwner parses the room id the site mints (sv-<user>-<game>-<slot>-<system>___<key>, ArcadeSaveId).
+// Returns ok=false for a stock random room id, which correctly means "no owner, leave cards alone".
+func cardOwner(roomId string) (user string, system string, ok bool) {
+	if !strings.HasPrefix(roomId, "sv-") {
+		return "", "", false
+	}
+	sep := strings.Index(roomId, "___")
+	if sep < 0 {
+		return "", "", false
+	}
+	parts := strings.SplitN(roomId[len("sv-"):sep], "-", 4)
+	if len(parts) != 4 || parts[0] == "" || parts[3] == "" {
+		return "", "", false
+	}
+	return parts[0], parts[3], true
+}
+
+// card is where a system keeps its memory card in the worker's dirs. Two shapes, because the cores
+// disagree:
+//
+//	dir  — the card IS a directory and everything under it is card (gc: <save>/User/GC, ps2:
+//	       <system>/pcsx2/memcards). Seed/harvest move the whole subtree.
+//	glob — the card is loose FILES in a directory that also holds things we must never touch (dc:
+//	       vmu_save_*.bin sit in the Dreamcast system dir next to dc_boot.bin/dc_flash.bin). Only
+//	       the matching files move; the BIOS beside them is invisible to every card operation.
+type card struct {
+	dir     string // directory the core reads/writes
+	pattern string // "" = the whole dir is the card; otherwise only files matching this name
+}
+
+func (c card) empty() bool { return c.dir == "" }
+
+// cardFor resolves the configured card for a system: "<root>:<path>", root = save|system. A trailing
+// path element containing a wildcard makes it a file set rather than a directory, e.g.
+// "system:dc/vmu_save_*.bin". Empty when the system has no card (most cores) or the feature is off.
+func (f *Frontend) cardFor(system string) card {
+	if f.conf.CardVault == "" {
+		return card{}
+	}
+	spec, ok := f.conf.Cards[system]
+	if !ok {
+		return card{}
+	}
+	root, rel, found := strings.Cut(spec, ":")
+	if !found {
+		f.log.Error().Msgf("cards: bad spec for %v: %q (want \"save:<path>\" or \"system:<path>\")", system, spec)
+		return card{}
+	}
+
+	// uniqueSaveDir and a save-rooted card are mutually exclusive, and silently so — which is why this
+	// refuses rather than warns. uniqueSaveDir re-points nano.SaveDir() at a PER-SESSION subdirectory,
+	// so "save:User/GC" would resolve somewhere the core never writes its card: we would faithfully
+	// vault an empty directory over the player's real one every session. It is off for every carded
+	// core today; this exists so that turning it back on fails loudly instead of eating saves.
+	if f.UniqueSaveDir && root == "save" {
+		f.log.Error().Msgf(
+			"cards: %v has uniqueSaveDir AND a save-rooted card (%q) — these cannot both be on: the card "+
+				"would resolve inside the per-session save dir. Cards DISABLED for this room; fix the config.",
+			system, spec)
+		return card{}
+	}
+
+	var base string
+	switch root {
+	case "save":
+		base = f.nano.SaveDir()
+	case "system":
+		base = f.nano.SystemDir()
+	default:
+		f.log.Error().Msgf("cards: unknown root %q for %v", root, system)
+		return card{}
+	}
+
+	rel = filepath.FromSlash(rel)
+	if last := filepath.Base(rel); strings.ContainsAny(last, "*?[") {
+		if dir := filepath.Dir(rel); dir != "." {
+			return card{dir: filepath.Join(base, dir), pattern: last}
+		}
+		return card{dir: base, pattern: last}
+	}
+	return card{dir: filepath.Join(base, rel)}
+}
+
+func (f *Frontend) vaultDir(user, system string) string {
+	return filepath.Join(f.conf.CardVault, user, system)
+}
+
+// ownerFile records who the card currently in the worker's directory belongs to, so that a worker
+// that DIED without harvesting (the exit-139 teardown, a kill) can still have that player's card
+// recovered on the next room rather than cleared out from under them. A glob card's dir is SHARED
+// (dc's VMUs sit in the BIOS dir), so its stamp is system-scoped and can't collide with a neighbour.
+const cardOwnerFile = ".owner"
+
+func (f *Frontend) cardOwnerPath(system string, c card) string {
+	if c.pattern == "" {
+		return filepath.Join(c.dir, cardOwnerFile)
+	}
+	return filepath.Join(c.dir, cardOwnerFile+"-"+system)
+}
+
+// vaultCard copies the card OUT of the worker's dir into a player's vault. It never deletes, never
+// replaces a vault file with an older one, and discards any copy the core tore by writing to the
+// card mid-read (see os.CopyTreeNewer) — so it is safe to call while the core is still running.
+func (f *Frontend) vaultCard(c card, vault string) error {
+	if c.pattern == "" {
+		return os.CopyTreeNewer(c.dir, vault)
+	}
+	return os.CopyGlobNewer(c.dir, c.pattern, vault)
+}
+
+// vaultHasCard reports whether this player has a card of this shape already stored.
+func (f *Frontend) vaultHasCard(c card, vault string) bool {
+	if c.pattern == "" {
+		return os.Exists(vault)
+	}
+	files, err := os.GlobFiles(vault, c.pattern)
+	return err == nil && len(files) > 0
+}
+
+// seedCards puts THIS room owner's card in place before the core loads the game.
+func (f *Frontend) seedCards() {
+	user, system, ok := cardOwner(f.storage.MainPath())
+	if !ok {
+		return
+	}
+	c := f.cardFor(system)
+	if c.empty() {
+		return
+	}
+
+	// Whoever used this directory last may never have been harvested: a worker that dies skips the
+	// close path entirely, and that is NOT rare — flycast corrupts the heap on teardown often enough
+	// (0xC0000374) that a Dreamcast room ending in a dead worker is routine. Vault what's here before
+	// touching it.
+	//
+	// This runs even when the previous owner IS this user, and that is the whole point. Skipping it
+	// then looks harmless but is the worst case there is: a first-time player crashes before their
+	// first harvest, rejoins, and — with an empty vault and their only copy sitting right here — the
+	// "fresh card" branch below would wipe the session the crash already failed to save.
+	if prev, err := os.ReadFile(f.cardOwnerPath(system, c)); err == nil {
+		if p := strings.TrimSpace(string(prev)); p != "" {
+			// vaultCard's error now means "some individual files were skipped" (locked/in-use), not
+			// "nothing was recovered" — os.CopyTreeNewer/CopyGlobNewer keep going past a busy file
+			// instead of aborting the whole copy. The previous room has already closed by the time we
+			// get here, so nothing should still hold these files open; treat a residual error as
+			// noteworthy but non-fatal rather than refusing to seed over a card we mostly DID recover.
+			if err := f.vaultCard(c, f.vaultDir(p, system)); err != nil {
+				f.log.Warn().Err(err).Msgf(
+					"cards: recovered user %v's unharvested %v card with some files skipped", p, system)
+			}
+			if p != user {
+				f.log.Info().Msgf("cards: recovered an unharvested %v card for user %v", system, p)
+			} else {
+				f.log.Info().Msgf("cards: recovered your own unharvested %v card (user %v)", system, p)
+			}
+		}
+	}
+
+	vault := f.vaultDir(user, system)
+	switch {
+	case !f.vaultHasCard(c, vault):
+		// First time this user plays this system. Their card starts EMPTY rather than inheriting
+		// whatever the previous player left behind — a fresh card, like a new console. The core
+		// re-creates (and formats) what it needs on boot.
+		// (Existing shared cards are migrated into each user's vault out of band; see the skill.)
+		var err error
+		if c.pattern == "" {
+			err = os.ClearDir(c.dir)
+		} else {
+			err = os.ClearGlob(c.dir, c.pattern)
+		}
+		if err != nil {
+			f.log.Error().Err(err).Msgf("cards: could not clear the %v card", system)
+			return
+		}
+		f.seedCardSkeleton(system, c)
+		f.log.Info().Msgf("cards: fresh %v card for user %v", system, user)
+	default:
+		var err error
+		if c.pattern == "" {
+			err = os.ReplaceTree(vault, c.dir)
+		} else {
+			err = os.ReplaceGlob(vault, c.pattern, c.dir)
+		}
+		if err != nil {
+			f.log.Error().Err(err).Msgf("cards: could not seed user %v's %v card", user, system)
+			return
+		}
+		f.log.Info().Msgf("cards: seeded user %v's %v card", user, system)
+	}
+
+	_ = os.MakeDirAll(c.dir)
+	if err := os.WriteFile(f.cardOwnerPath(system, c), []byte(user), 0644); err != nil {
+		f.log.Error().Err(err).Msg("cards: could not stamp the card owner")
+	}
+}
+
+// seedCardSkeleton lays a system's minimum-viable card contents over a card that seedCards just
+// cleared, from the optional <CardVault>/_skeleton/<system> directory. Absent directory = no-op, so
+// this stays inert for every system that doesn't need one.
+//
+// "Fresh card = new console" is the right default, but a bare Wii NAND is NOT a working console for
+// the BrawlEx SD-loader mods: Brawl requires IOS36 in the NAND, and without it GeckoOS stops on
+// "This Game Requires IOS 36" — and taking that install path then boots VANILLA Brawl for the rest
+// of the session. So a first-time player of Smash Universe / Infinite would not see an error, they
+// would see the unmodded game and report the mod as broken (proven by direct test 2026-07-30, and a
+// third member of this project's "looks fixed but isn't" family — see the brawlex-wii-mods skill).
+//
+// Deliberately a directory convention rather than a config key: it needs no config.worker-gl.yaml
+// change (so no coordinator rebuild) and no code edit to cover a future system — drop a folder in.
+// The vault root is never enumerated (vaultDir is always built from a specific user id), and the
+// "_" prefix cannot collide with the numeric user ids the site mints.
+func (f *Frontend) seedCardSkeleton(system string, c card) {
+	if f.conf.CardVault == "" {
+		return
+	}
+	skel := filepath.Join(f.conf.CardVault, "_skeleton", system)
+	if !os.Exists(skel) {
+		return
+	}
+	if err := os.MakeDirAll(c.dir); err != nil {
+		f.log.Warn().Err(err).Msgf("cards: could not prepare the %v card dir for its skeleton", system)
+		return
+	}
+	// Copy, never move: the skeleton is reused by every new player of this system. Anything the
+	// player saves later simply overwrites it when their card is harvested.
+	if err := os.CopyTreeNewer(skel, c.dir); err != nil {
+		f.log.Warn().Err(err).Msgf("cards: could not lay the %v card skeleton", system)
+		return
+	}
+	f.log.Info().Msgf("cards: laid the %v card skeleton", system)
+}
+
+// harvestCards copies the room owner's card back to their vault. Called twice on close — once with
+// the core still alive (it may not survive its own teardown) and once after, for the cores that do
+// and that flush their card on the way out. Running twice is safe: newer-wins, and the second pass
+// logs nothing new if it copies nothing.
+func (f *Frontend) harvestCards() { f.harvest(false) }
+
+// harvestCardsLive vaults the card WITHOUT waiting for the room to end. The close harvest is not a
+// guarantee: flycast corrupts the heap on teardown often enough that a Dreamcast worker regularly
+// dies before it can run, and a killed worker never runs it at all. Called on the autosave tick, so
+// a crash costs a player at most one autosave period of card progress instead of the whole session.
+func (f *Frontend) harvestCardsLive() { f.harvest(true) }
+
+func (f *Frontend) harvest(quiet bool) {
+	user, system, ok := cardOwner(f.storage.MainPath())
+	if !ok {
+		return
+	}
+	c := f.cardFor(system)
+	if c.empty() || !os.Exists(c.dir) {
+		return
+	}
+	// A non-nil error here now means "one or more individual files were skipped" (os.CopyTreeNewer /
+	// CopyGlobNewer no longer abort the whole card on the first busy file — see their doc comments),
+	// not "nothing was vaulted". Dolphin holds the Wii Menu's play_rec.dat open for the WHOLE session,
+	// so a live Wii harvest hits this on literally every tick; treating that as total failure used to
+	// mean the live-harvest safety net (see harvestCardsLive) never actually protected a Wii session.
+	// Log what was skipped at WARN and still report the harvest, because the files that matter did
+	// make it across.
+	if err := f.vaultCard(c, f.vaultDir(user, system)); err != nil {
+		f.log.Warn().Err(err).Msgf("cards: user %v's %v card harvested with some files skipped (likely still open)", user, system)
+	}
+	if quiet {
+		f.log.Debug().Msgf("cards: live-harvested user %v's %v card", user, system)
+		return
+	}
+	f.log.Info().Msgf("cards: harvested user %v's %v card", user, system)
+}
+
+// ── Wii SD-card + ELF/DOL loader boot (MovieTheater, 2026-07-18) ────────────────────────────────
+//
+// A small number of Wii ROM hacks (BrawlEx-based Brawl mods: Project REX, Smash Bros Infinite) crash
+// when baked onto a standalone disc — their own file/config loader only reliably reads from a real
+// SD card, not a disc image. These ship as a loader ELF/DOL (the ArcadeGame row's own content path)
+// instead of a disc. Before it boots, Dolphin needs [Core] WiiSDCard/WiiSDCardPath pointed at the
+// mod's own SD card image and [Core] DefaultISO pointed at a paired base disc — Dolphin's stock
+// Boot.cpp (SetDefaultDisc) auto-inserts DefaultISO on any ELF/DOL ("Executable") boot, unmodified
+// upstream behavior, the same thing standalone `Dolphin.exe -e loader.elf` relies on.
+//
+// Dolphin.ini is shared by every Wii/GC room THIS worker ever serves (one file, not per-room), and
+// DolphinLibretro's retro_load_game/retro_unload_game fully tear down and rebuild Dolphin's Config
+// from that file on every single room (UICommon::Init/Shutdown, verified against Main.cpp) — so
+// seeding it here, synchronously before nano.LoadGame, reliably takes effect for the room about to
+// start. A wii room WITHOUT a matching asset folder must explicitly turn the SD card back OFF, or it
+// would silently inherit whatever mod a previous room on this worker left mounted.
+//
+// The card image is CACHED per worker per game (<SaveDir>/User/wiisd-cache/<GameKey>/sd.raw),
+// copied from the shared master only once — not fresh every boot. A first live test copied REX's
+// 8GB card synchronously on every room start: ~23s, which blocked this worker's report back to the
+// coordinator long enough that the browser gave up waiting and disconnected before a single frame
+// rendered (2026-07-18). Existing memory cards never hit this because those are KB/MB save files;
+// an SD card image is not. The cache is refreshed only when missing or the master's size changed,
+// so the ~23s cost is paid at most once per worker per game (and can be pre-warmed by an admin
+// simply touching the master file's mtime, or eliminated entirely with a one-time manual copy).
+func (f *Frontend) seedWiiSdLoader(path string) {
+	assetsDir := f.conf.WiiSdLoader.AssetsDir
+	if assetsDir == "" {
+		return
+	}
+	// Same room-id-derived system code the card vault uses (cardOwner) — not GC (that core never
+	// touches the Wii SDIO subsystem, and this would otherwise write keys it never looks at).
+	_, system, ok := cardOwner(f.storage.MainPath())
+	if !ok || system != "wii" {
+		return
+	}
+
+	userDir := filepath.Join(f.nano.SaveDir(), "User")
+	iniPath := filepath.Join(userDir, "Config", "Dolphin.ini")
+
+	gameKey := strings.TrimSuffix(filepath.Base(path), filepath.Ext(path))
+	srcDir := filepath.Join(assetsDir, gameKey)
+	if !os.Exists(srcDir) {
+		if err := setDolphinIni(iniPath, map[dolphinIniKey]string{{"Core", "WiiSDCard"}: "False"}); err != nil {
+			f.log.Error().Err(err).Msg("wiiSdLoader: could not disable a stale SD card")
+		}
+		return
+	}
+
+	srcSd := filepath.Join(srcDir, "sd.raw")
+	if !os.Exists(srcSd) {
+		f.log.Error().Msgf("wiiSdLoader: %v has an asset folder but no sd.raw, leaving SD card disabled", gameKey)
+		return
+	}
+	bases, err := os.GlobFiles(srcDir, "base.*")
+	if err != nil || len(bases) != 1 {
+		f.log.Error().Msgf("wiiSdLoader: %v needs exactly one base.<ext> disc image in its asset folder, found %d", gameKey, len(bases))
+		return
+	}
+
+	// Cached, not re-copied every boot — see the doc comment above. Never opened directly from
+	// assetsDir: Dolphin writes to this file live, and two concurrent rooms of the SAME mod on the
+	// two different workers must not share one file handle (each worker gets its own cached copy).
+	cacheSd := filepath.Join(userDir, "wiisd-cache", gameKey, "sd.raw")
+	if wiiSdCacheStale(srcSd, cacheSd) {
+		if err := os.MakeDirAll(filepath.Dir(cacheSd)); err != nil {
+			f.log.Error().Err(err).Msgf("wiiSdLoader: could not prepare cache dir for %v", gameKey)
+			return
+		}
+		f.log.Info().Msgf("wiiSdLoader: caching sd card for %v (first use on this worker, or the master changed)…", gameKey)
+		if err := os.CopyFile(srcSd, cacheSd); err != nil {
+			f.log.Error().Err(err).Msgf("wiiSdLoader: could not cache sd card for %v", gameKey)
+			return
+		}
+	}
+	if err := setDolphinIni(iniPath, map[dolphinIniKey]string{
+		{"Core", "WiiSDCard"}:        "True",
+		{"General", "WiiSDCardPath"}: cacheSd,
+		{"Core", "DefaultISO"}:       bases[0], // read-only disc emulation — referenced directly, no copy
+	}); err != nil {
+		f.log.Error().Err(err).Msgf("wiiSdLoader: could not patch Dolphin.ini for %v", gameKey)
+		return
+	}
+	f.log.Info().Msgf("wiiSdLoader: seeded %v (sd card + DefaultISO=%v)", gameKey, filepath.Base(bases[0]))
+}
+
+// wiiSdCacheStale reports whether the cached SD card copy is missing or out of sync with the
+// master (by size — the master is a hand-staged, rarely-changed file, so a size compare is enough
+// to catch a real replacement without needing the pkg/os wrapper to expose full os.Stat/mtime).
+func wiiSdCacheStale(src, cache string) bool {
+	if !os.Exists(cache) {
+		return true
+	}
+	srcSize, err := os.StatSize(src)
+	if err != nil {
+		return true
+	}
+	cacheSize, err := os.StatSize(cache)
+	if err != nil {
+		return true
+	}
+	return srcSize != cacheSize
+}
+
+type dolphinIniKey struct{ Section, Key string }
+
+// setDolphinIni sets each Section/Key pair in the Dolphin.ini at path, creating the file (and any
+// missing section) if needed, and leaving everything else in the file untouched. Direct Go port of
+// Setup-BrawlSDMod.ps1's Set-IniValue (the LOCAL equivalent of this same seed step) — same shape,
+// because it solves the identical problem: point Dolphin.ini at a specific SD card + default disc
+// before the core reads it, without disturbing anything else already there.
+func setDolphinIni(path string, kv map[dolphinIniKey]string) error {
+	var lines []string
+	if os.Exists(path) {
+		raw, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		lines = strings.Split(strings.ReplaceAll(string(raw), "\r\n", "\n"), "\n")
+	}
+	for k, v := range kv {
+		lines = setIniValue(lines, k.Section, k.Key, v)
+	}
+	if err := os.MakeDirAll(filepath.Dir(path)); err != nil {
+		return err
+	}
+	return os.WriteFile(path, []byte(strings.Join(lines, "\n")), 0644)
+}
+
+func setIniValue(lines []string, section, key, value string) []string {
+	header, entry := "["+section+"]", key+" = "+value
+	secIdx := -1
+	for i, l := range lines {
+		if strings.TrimSpace(l) == header {
+			secIdx = i
+			break
+		}
+	}
+	if secIdx == -1 {
+		return append(append(lines, header), entry)
+	}
+	secEnd := len(lines)
+	for i := secIdx + 1; i < len(lines); i++ {
+		if strings.HasPrefix(strings.TrimSpace(lines[i]), "[") {
+			secEnd = i
+			break
+		}
+	}
+	for i := secIdx + 1; i < secEnd; i++ {
+		t := strings.TrimSpace(lines[i])
+		if strings.HasPrefix(t, key+"=") || strings.HasPrefix(t, key+" =") {
+			lines[i] = entry
+			return lines
+		}
+	}
+	out := make([]string, 0, len(lines)+1)
+	out = append(out, lines[:secIdx+1]...)
+	out = append(out, entry)
+	out = append(out, lines[secIdx+1:]...)
+	return out
+}
+
