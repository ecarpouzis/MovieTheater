@@ -0,0 +1,983 @@
+package worker
+
+import (
+	"fmt"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/giongto35/cloud-game/v3/pkg/logger"
+	"github.com/giongto35/cloud-game/v3/pkg/network/webrtc"
+	"github.com/giongto35/cloud-game/v3/pkg/worker/media"
+	"github.com/giongto35/cloud-game/v3/pkg/worker/room"
+)
+
+// Adaptive bitrate for a room's single video encoder (arcade ABR, patch 0021; temporal SVC 0042).
+//
+// Why this is cheap: nvav1enc's `bitrate` is "changeable in the PLAYING state", so a rung costs one
+// property set — no pipeline rebuild, no renegotiation, no reconnect, nothing the player sees. Only
+// bitrate is adapted; changing RESOLUTION would re-init the pipeline (a visible glitch), so we don't.
+//
+// Why we probe upward instead of trusting the estimate: GCC is a congestion DETECTOR. Its estimate can
+// never exceed what we actually send (you cannot measure capacity you never use), so simply following
+// the estimate would pin the room forever at its starting bitrate. Instead we treat "estimate is
+// keeping up with what we send" as permission to send more, and back off hard the moment it isn't.
+//
+// ── What temporal SVC changed ──────────────────────────────────────────────────────────────────────
+// This loop used to drive the encoder from the WORST peer's estimate, because one encoder serves the
+// whole room: a single friend on hotel wifi throttled everyone. That is no longer inherent.
+//
+// With a layered encoder (svc.go) each peer can be fed a DIFFERENT SUBSET of the same stream, so a
+// weak peer takes fewer frames instead of forcing a worse picture on everybody. Two consequences:
+//
+//  1. The room bitrate follows the peers we can actually SERVE at their assigned layer. A peer that
+//     has been dropped to base layer no longer vetoes the room's quality, because the bits it
+//     receives are already only ~28% of what we send (AV1, 3 layers).
+//  2. A peer drags the room down only when even the BASE layer will not fit down its link. Then we do
+//     lower the room — but only to what base layer needs (estimate / baseShare), which is ~3.5x
+//     higher than the old "drop the room to the worst estimate" behaviour.
+//
+// How much of that a room actually gets depends on the CODEC — see layerShare below. AV1 has the
+// deep ladder; H.264's 2-layer hierarchical P shaves only ~20%, so there the win is mostly (1): the
+// first answer to a weak peer is 30 fps for it, not fewer bits for everyone.
+const (
+	abrTick = time.Second
+
+	abrFloorKbps = 1500 // below this the picture is worse than a stall; give up adapting
+	abrStartKbps = 6000 // conservative opener; a healthy LAN reaches a 14 Mbps ceiling in ~7 ticks
+	// ...but 6000 is only an OPENER for the high-ceiling 3D systems it was tuned against (gc 14000,
+	// ps2 12000, n64 11000). Clamped by min() to a 2D room's 5000 ceiling it became a COLD START AT
+	// FULL RATE: 5 Mbps plus the first keyframe hit a wireless client before any estimate exists, the
+	// queue overruns, GCC craters (measured: 7335 -> 560 kbps five seconds into a genesis room), and
+	// the 15%/tick ramp spends ~10s climbing back. Proven by the control case the same evening — the
+	// one room with a 16000 ceiling opened at 6000 (37%) and had ZERO collapses and zero layer changes
+	// while every room that opened AT its ceiling collapsed inside 10s. Never open above this fraction
+	// of the ceiling: a 5000 room now opens at 3000 and reaches full rate in ~4 ticks, burst-free, and
+	// nothing changes for the 3D systems (0.6*14000 = 8400, still above the 6000 opener).
+	abrStartCeilPct = 60
+
+	abrRampPct    = 15 // healthy: raise the target by this much per tick
+	abrHealthyPct = 95 // estimate >= 95% of what that peer RECEIVES => its link is keeping up
+	abrBackoffPct = 85 // estimate <  85% of what that peer RECEIVES => congestion
+
+	abrMinStepKbps = 250 // don't bother with changes smaller than this
+
+	// Temporal-layer hysteresis. The gap between these two is a DEAD BAND in which a peer simply keeps
+	// the layer it has, and it has to be wide: a layer change halves (or doubles) the frame rate, which
+	// is enormously more visible than a bitrate rung. Narrow thresholds made a healthy peer oscillate
+	// 60->30->60 fps every few seconds — a stuttering game, and worse than anything it was avoiding.
+	abrLayerDownPct = 85  // drop a layer only when the estimate is <85% of what this peer RECEIVES
+	abrLayerUpPct   = 125 // climb only with 25% headroom over what the higher layer would cost
+	// ...and a drop must persist. One bad tick is noise (we send unpaced, so GCC misreads microbursts);
+	// two in a row is a link.
+	abrLayerDownTicks = 2
+
+	// STARVE PATH hysteresis + cut clamp. A starved peer caps the room IMMEDIATELY — it got none of
+	// the two-tick confirmation the backoff (lowTicks) and layer (abrLayerDownTicks) paths get, even
+	// though it is fed by the same noisy signal and the comment above says why that signal lies.
+	// With a temporal ladder the cap is est/baseShare, which absorbs the noise. WITHOUT one baseShare
+	// is 100% and the cap IS the peer's raw estimate — and H.264 had no ladder at all until 2026-07-26
+	// (the tagger was AV1-only), so the codec we tell tablet users to pick was exactly the codec that
+	// turned one misread microburst into a cliff. Measured on an older tablet (h264, ceiling 16000):
+	// 11370 -> 1964 kbps in ONE tick, and 46 starve events in one session, each followed by a 15%/tick
+	// climb straight back into the next one. H.264 now gets 2 layers (baseShare 80% => a 1.25x cap),
+	// which is a far shallower cushion than AV1's 3.5x — so these two guards stay load-bearing there.
+	abrStarveTicks = 2  // confirm a starve like everything else before letting it cap the room
+	abrMaxCutPct   = 70 // and never cut below this % of current in one tick — staircase, not cliff
+
+	// CONGESTION MEMORY — the ceiling is a PERMISSION, not a target. Without memory the healthy
+	// branch probes +15%/tick toward the ceiling forever, relearning nothing: measured (older tablet,
+	// h264, ceiling 16000) the room starved at 3260/3398/3574/3788 — the SAME wall, four visits in
+	// eight seconds — because each cut was followed by a full-speed climb straight back into it. So a
+	// high ceiling made the experience WORSE than a low one, which inverts what the quality picker
+	// promises. Remember the rate that provoked a confirmed cut; approach it in abrMinStepKbps creeps
+	// instead of 15% leaps (a 250 kbps overshoot starves gently and reconfirms; a 500+ leap starves
+	// hard); and only forget the wall after abrCongClearTicks consecutive healthy ticks AT or ABOVE
+	// it — proof the link opened up, at which point full-speed probing resumes (the same session's
+	// wall really did vanish at 16:52:20, and the room then deserved its clean ramp to 16000).
+	abrCongProbePct   = 90 // within this % of the remembered wall, probe additively, not multiplicatively
+	abrCongClearTicks = 3  // healthy ticks at/above the wall before it is forgotten
+
+	// PROBE HOLD. Memory alone made collisions with the wall GENTLE but not RARE: the live trace
+	// (tablet, ceiling 16000, wall ~10 Mbps) settled into starve -> small cut -> creep back -> starve
+	// every 5-6 seconds, indefinitely. Each starve is two confirmed congested ticks — a small hitch on
+	// a schedule. So after a cut lands while a wall is remembered (the wall was just re-confirmed),
+	// stop PROBING INTO it for this many ticks: sit at the settled rate, which is stable by
+	// construction (it is where the last cut left us, below the wall). Recovery from a deep cut is
+	// unaffected — the hold gates only the additive creep inside the probe zone; below the zone the
+	// normal ramp still runs. Net effect: collision cadence drops from every ~5s to every ~15s+, and
+	// between tests the bitrate is flat, which is precisely when the stream feels smooth.
+	abrCongHoldTicks = 12
+)
+
+// layerShare[codec][n][l] = the percentage of the encoder's bitrate a peer receives when it is fed
+// temporal layers 0..l of an n-layer stream. These shift with content, so they are used only to
+// CHOOSE a layer and are re-checked every tick against the peer's real estimate — an over-optimistic
+// share costs one extra tick of backoff, not a broken stream.
+//
+// PER CODEC, because the two encoders build very different ladders out of the same idea. Measured
+// the same way for both (300 frames, one access unit per file, sum the bytes of the frames a
+// base-only peer would still receive):
+//
+//	nvav1enc, 640x480 ball @5000: 3 layers -> 28 / 54 / 100    2 layers -> 53 / 100
+//	nvh264enc, hierarchical P:    2 layers -> 66..83 / 100     (no 3-layer entry — see below)
+//
+// H.264's spread is the interesting part. Base share by configuration:
+//
+//	640x480  ball  @5000 ... 66.3%   (CBR target not binding — content too cheap to spend it)
+//	1280x1056 ball @8000 ... 66.2%
+//	1280x1056 smpte@4000 ... 81.6%
+//	1280x1056 ball @1500 ... 82.2%   <- a struggling room
+//	640x480  snow  @5000 ... 82.8%
+//
+// The ~82% cluster is every case where CBR actually binds, which is precisely the regime a ladder
+// operates in: nobody drops a layer in a room with bits to spare. So 80 — just under that cluster,
+// far under the cheap-content 66 — is the honest number, and being slightly PESSIMISTIC about the
+// saving is the safe direction (it cuts the room a little deeper and drops a layer a little sooner
+// than strictly needed, rather than believing a peer is served when it is not).
+//
+// Consequence worth stating plainly: an H.264 base-only peer still costs ~80% of the room, not the
+// ~28% an AV1 one does. The ladder is real but SHALLOW — it buys a ~1.25x starve cap and, far more
+// importantly, makes the FIRST response to congestion "30 fps for that peer" instead of "fewer bits
+// for everyone". It is not a substitute for AV1's ladder.
+//
+// No 3-layer H.264 entry, deliberately: at 3 layers the middle layer is a REFERENCE frame, so the
+// nal_ref_idc tell that h264TemporalID reads no longer separates the layers, and dropping them would
+// punch frame_num holes into a stream we negotiate as Constrained Baseline. The encoder property is
+// range-capped at 2 for the same reason.
+var layerShare = map[string]map[int][]int{
+	"av1": {
+		1: {100},
+		2: {53, 100},
+		3: {28, 54, 100},
+	},
+	"h264": {
+		1: {100},
+		2: {80, 100},
+	},
+}
+
+// shares returns the per-layer bitrate shares for a codec's n-layer stream, or nil if we have no
+// measurements for that combination — in which case ABR runs the room exactly as it did before SVC
+// existed. Never guess a share: the whole loop below trusts these numbers.
+func shares(codec string, layers int) []int { return layerShare[codec][layers] }
+
+// svcPeer is the slice of *webrtc.Peer that ABR needs. An interface so this package does not depend
+// on the concrete session type (and a peer without an estimator is simply skipped).
+type svcPeer interface {
+	TargetBitrateKbps() int
+	SetMaxTemporalLayer(int)
+	MaxTemporalLayer() int
+	// SameHostLink reports that this peer is the worker's own machine (loopback or one of our own
+	// interface IPs), so there is no radio, switch or queue between us. See the local fast path.
+	SameHostLink() bool
+	// LinkRttMs is the latest ICE RTT in ms, and whether one exists. Observability only — see rttStat.
+	LinkRttMs() (float64, bool)
+	// LinkDesc is "<remote addr>:<port>/<type>" — what makes an rtt-probe line attributable to a device.
+	LinkDesc() string
+	// LinkPath is "samehost"/"direct"/"relay"/"unknown" — the class a stored link measurement belongs
+	// to, and may never be mixed across. Observability only (Phase 0 summary).
+	LinkPath() string
+	// DeviceId / Username identify WHOSE link this is, for the session-close mirror. Both "" on an
+	// older client. Observability only.
+	DeviceId() string
+	Username() string
+}
+
+// rttStat accumulates one peer's RTT samples so we can report mean and spread. OBSERVABILITY ONLY: no
+// decision reads it. It exists to answer whether RTT can separate a wired LAN desktop from a Wi-Fi
+// tablet on the same subnet — the two cases ABR currently cannot tell apart, where guessing wrong
+// reverts the gentle ramp for the tablet it was built for. Bounded window; ABR ticks once a second.
+type rttStat struct {
+	n              int
+	mean, m2       float64 // Welford
+	min, max, last float64
+}
+
+func (s *rttStat) add(v float64) {
+	if s.n == 0 || v < s.min {
+		s.min = v
+	}
+	if v > s.max {
+		s.max = v
+	}
+	s.last = v
+	s.n++
+	d := v - s.mean
+	s.mean += d / float64(s.n)
+	s.m2 += d * (v - s.mean)
+}
+
+// sd is the sample standard deviation — the VARIANCE half of the question, which matters more than the
+// mean: a radio under load jitters long before its average latency looks bad.
+func (s *rttStat) sd() float64 {
+	if s.n < 2 {
+		return 0
+	}
+	return math.Sqrt(s.m2 / float64(s.n-1))
+}
+
+// rttProbeEvery: emit a summary line this many ABR ticks (= seconds) apart. Often enough that a short
+// session still produces several lines, rare enough not to bury the abr rate lines.
+const rttProbeEvery = 15
+
+const (
+	// abrAtCeilPct: "at the ceiling" for summary purposes. Not 100%, because the loop deliberately
+	// stops stepping once a move would be smaller than abrMinStepKbps — a room that has arrived is
+	// normally parked a little under the ceiling, and calling that "not at the ceiling" would report
+	// every healthy room as having never got there.
+	abrAtCeilPct = 90
+	// abrSustainedMinTicks: how many CONSECUTIVE healthy ticks a rate must survive before it counts as
+	// sustained. Five seconds is long enough that a single probe overshoot cannot mint a sustained
+	// value it will immediately give back, and short enough that a 30-second room still produces one.
+	abrSustainedMinTicks = 5
+)
+
+// abrPeerStat is the per-peer half of the close summary. OBSERVABILITY ONLY: no ABR decision reads
+// any of it. Same lifetime rules as the rtt/layerDown maps — the ABR goroutine owns it, and a peer
+// that leaves the room simply stops being iterated.
+type abrPeerStat struct {
+	// Sampled ONCE, the first tick they are known: LinkDesc/LinkPath both walk to the selected ICE
+	// candidate pair, and by the time the room closes that pair is being torn down and would report
+	// "unknown". Sampling once also keeps this cheaper than the existing rtt-probe, which calls
+	// LinkDesc on every emit.
+	dev, path          string
+	deviceId, username string
+
+	// sustainedKbps is THE warm-start datum: the highest room send rate that survived
+	// abrSustainedMinTicks consecutive HEALTHY ticks while this peer was the binding estimator (the
+	// one whose estimate set worstServable, i.e. the peer actually constraining the room). Precisely:
+	// a run is a maximal sequence of consecutive ticks in which the tick was healthy AND this peer was
+	// binding; the run's rate is the MINIMUM send rate over the run (what it really held, not its
+	// peak); a run of at least abrSustainedMinTicks contributes its rate, and sustainedKbps is the
+	// largest such contribution. Ticks where this peer was not the constraint say nothing about ITS
+	// link — the room was being held down by somebody else — so they break the run rather than
+	// extending it.
+	sustainedKbps int
+	runTicks      int
+	runMinKbps    int
+}
+
+// abrSummaryPeer is a by-VALUE snapshot of one peer's summary, taken before the mirror goroutine is
+// dispatched. The peer objects and the stat maps die with the ABR goroutine the moment it returns, so
+// nothing that outlives it may hold a pointer into either.
+type abrSummaryPeer struct {
+	dev, path          string
+	deviceId, username string
+	sustainedKbps      int
+	sameHost           bool
+	rttMean, rttSd     float64
+}
+
+const (
+	// A peer whose SUSTAINED mean ICE RTT is below this has no queue worth protecting, so the upward
+	// probe does not need to creep. MEASURED on real hardware 2026-07-30 (rtt-probe), same LAN, same
+	// game, minutes apart:
+	//
+	//   wired desktop   mean 0.91ms  sd 0.92  min 0.50  (n=90)
+	//   Wi-Fi tablet    mean 3.86ms  sd 1.50  min 1.59  (n=115)
+	//
+	// 1.5ms sits below the TABLET'S BEST EVER SINGLE SAMPLE (1.59ms) and 2.6x under its mean, while the
+	// wired machine runs 40% under it. The tablet is the client this whole ramp exists for — it starved
+	// 46 times in one session before the guards landed — so the threshold is placed to exclude it with
+	// margin rather than to include as much hardware as possible.
+	//
+	// Deliberately the MEAN, not the max: the wired machine's max was 5.61ms (one outlier above the
+	// tablet's mean), so any max-based rule would misclassify the good link. Deliberately not the sd
+	// either — 0.92 vs 1.50 does not separate, because that outlier inflates the wired figure.
+	//
+	// ⚠ One device pair is thin evidence. A close-range Wi-Fi 6 client could plausibly sit nearer this
+	// line than the tablet does. That is survivable by construction: this only changes the SIZE of an
+	// upward probe, every guard below still applies, and one confirmed cut sets congKbps and disables
+	// the path for the rest of the room. Widen it only with more measurements, never by intuition.
+	abrFastRttMs = 1.5
+	// Require a sustained read, not a lucky first sample: ~5s of evidence before trusting the link. The
+	// cost of waiting is small (the creep still runs meanwhile) and it prevents an unloaded first
+	// second from speaking for a link that is about to get busy.
+	abrFastRttMinSamples = 5
+)
+
+// logRttProbe emits ONE self-describing key=value line per peer. Deliberately verbose and machine
+// readable: `dev=` carries the remote address, so sessions from different devices can be told apart
+// afterwards without anyone having written down which device was used when. Grep with `rtt-probe`.
+func logRttProbe(log *logger.Logger, roomId string, p svcPeer, s *rttStat, final bool) {
+	if s == nil || s.n == 0 {
+		return
+	}
+	kind := "sample"
+	if final {
+		kind = "final"
+	}
+	sameHost := 0
+	if p.SameHostLink() {
+		sameHost = 1
+	}
+	log.Info().Msgf(
+		"rtt-probe %s room=%s dev=%s samehost=%d n=%d mean=%.2fms sd=%.2fms min=%.2fms max=%.2fms last=%.2fms est=%dkbps",
+		kind, roomId, p.LinkDesc(), sameHost, s.n, s.mean, s.sd(), s.min, s.max, s.last, p.TargetBitrateKbps())
+}
+
+// pickLayer returns the highest temporal layer whose share of `sendKbps` fits inside `estKbps`, and
+// whether even the base layer does not fit.
+//
+// Hysteresis: dropping a layer HALVES a peer's frame rate, which is far more visible than a bitrate
+// rung, so we refuse to do it on a marginal reading. Going DOWN needs the peer to be over budget
+// outright; coming back UP needs the higher layer to fit with 20% headroom. Without that gap a peer
+// parked near a boundary oscillates 60->30->60 fps every second, which looks worse than just staying
+// at 30.
+func pickLayer(share []int, current, sendKbps, estKbps int) (layer int, starved bool) {
+	if share == nil || estKbps <= 0 {
+		return current, false
+	}
+	for l := len(share) - 1; l >= 0; l-- {
+		need := sendKbps * share[l] / 100
+		switch {
+		case l > current:
+			// Climbing costs a re-sync of nothing, but flapping costs everything — see below.
+			need = need * abrLayerUpPct / 100
+		case l == current:
+			// STAYING PUT is the default, and the bar for leaving is deliberately low. A peer only
+			// drops a layer when it is MEANINGFULLY over budget, not merely a few percent under what we
+			// send — GCC's estimate wanders around the send rate constantly, that is what it does.
+			//
+			// This was a real bug, live: a peer estimating 13225 against 13875 sent (95% — which the
+			// bitrate loop below calls HEALTHY) had its frame rate halved, then restored, then halved,
+			// every few seconds. Dropping a layer halves the frame rate, so a flapping layer is a
+			// FAR worse artifact than the bitrate dip it was reacting to: it reads as a stuttering game
+			// and it is the single most visible thing this file can do wrong.
+			need = need * abrLayerDownPct / 100
+		}
+		if need <= estKbps {
+			return l, false
+		}
+	}
+	return 0, true // even base layer does not fit
+}
+
+const (
+	// Bits per pixel per frame, the invariant a bitrate ceiling should actually be expressed in. A flat
+	// per-system table cannot be right: it was measured once against one configuration and is blind to
+	// `scale`, ScaleMaxWidth, a core that changes resolution mid-game (ScummVM, and Sonic switching
+	// 320x224 <-> 256x192 within seconds of boot), and render profiles that move the frame wholesale —
+	// the N64 `screensize` option alone spans 320x240 to 1920x1440 while the table says "n64 -> 11000".
+	//
+	// Two targets, because content class changes what a pixel costs, and `scale` already tells us which
+	// we have (frontend.go: "Scale > 1 magnifies (2D cores: integer nearest upscale)"; scale <= 1 is a
+	// native or SUPERSAMPLED 3D frame):
+	//
+	//   MAGNIFIED 2D — nearest-neighbour upscale. Every pixel edge is a step function, which is
+	//   expensive in DCT terms, and a full-screen scroll (Sonic) destroys frame-to-frame redundancy.
+	//   The old "2D cores are cheap, the encoder sees flat NxN blocks" assumption is why every 3D
+	//   system got raised off the flat 5000 default and 2D never did.
+	//
+	//   0.65 is MEASURED, not judged (scripts/calibrate-arcade-bpp.sh): 600 real Genesis frames
+	//   re-encoded through these exact encoder params across a bitrate sweep, scored by SSIM against
+	//   the same nearest-upscaled source. The result that matters is the TAIL, not the average —
+	//   per-frame MEDIAN SSIM is identical (0.99994) from 5 to 25 Mbps, because a frame-wide mean
+	//   averages localized blocking over 645,120 pixels and cannot see it. The WORST frames:
+	//
+	//     5000 (0.129 bpp)  0.995696      16000 (0.413)  0.999585
+	//     8000 (0.207)      0.998791      20000 (0.517)  0.999742
+	//    12000 (0.310)      0.999352      25000 (0.646)  0.999811
+	//
+	//   Error (1-SSIM) on the hard frames falls 4.3e-3 -> 1.9e-4 across that range and is STILL
+	//   improving at the top: there is no knee to calibrate to. For scroll-heavy pixel art the honest
+	//   answer is "as much as the link allows", so the target is set to land a typical 2D frame near
+	//   abrAutoMaxKbps and the CLAMP becomes the real policy. Matches the reported experience exactly
+	//   (5000 blocked badly; 16000 "much better but still some artifacts").
+	//
+	//   SMOOTH/3D — gradients and motion that compensates well. 0.18 reproduces the hand-measured
+	//   GameCube number almost exactly (1280x1056@60 -> 14.6 Mbps vs the table's 14000), which is the
+	//   cross-check that this formula is calibrated and not invented.
+	abrBppMagnified = 0.65
+	// ⚠ NOT calibrated by the sweep above — that captured a 2D core only. 0.18 stands on the
+	// independent agreement with the hand-measured GameCube number (1280x1056@60 -> 14.6 Mbps against
+	// a table value of 14000, 4% apart). Re-run calibrate-arcade-bpp.sh against a 3D core before
+	// trusting it the way the 2D figure is now trusted.
+	abrBppSmooth = 0.18
+	// Never below the old flat default (so "Auto" cannot be worse than what shipped before), and never
+	// above a rate that stops being about quality. ABR still treats the result as a CEILING, not a
+	// target — a weak peer is walked down from it within a second.
+	abrAutoMinKbps = 5000
+	abrAutoMaxKbps = 25000
+	// Used only when geometry is not yet known, which should not happen at the call site.
+	abrAutoFallbackKbps = 8000
+)
+
+// autoCeilingKbps derives the room's bitrate ceiling from the frame we ACTUALLY encode, rather than
+// from a per-system constant. Encoded size is the core's viewport AFTER `scale` (media.initVideo does
+// exactly this: `sw, sh := round(w, scale), round(h, scale)`), so this tracks every lever that moves
+// the frame, including ones added later, without anybody remembering to update a table.
+// Returns the ceiling and a human description of how it got there. It does NOT log: it is called every
+// ABR tick so the ceiling can follow a mid-room geometry change, and logging there would emit a line a
+// second. Callers log the description once at room start and again whenever the value moves.
+func autoCeilingKbps(m *media.GstMediaPipe) (int, string) {
+	scale := m.VideoScale
+	if scale <= 0 {
+		scale = 1
+	}
+	ew := int(math.Round(float64(m.VideoW) * scale))
+	eh := int(math.Round(float64(m.VideoH) * scale))
+	fps := m.VideoFPS
+	if fps <= 0 {
+		fps = 60
+	}
+	if ew <= 0 || eh <= 0 {
+		return abrAutoFallbackKbps, fmt.Sprintf("no geometry yet (%dx%d x%.4g) — fallback", m.VideoW, m.VideoH, scale)
+	}
+	// Classify by the SCALE METHOD, not by scale alone. `scale > 1` was the first cut and it is wrong
+	// for most of the arcade: n64, parallel_n64, dc, naomi, atomiswave, saturn and pcsx all magnify by 2
+	// with `scaleMethod: bilinear2`, i.e. a SMOOTH upscale of 3D content — no hard edges, nothing like
+	// pixel art. Giving those the 0.50 target computed ~36 Mbps for an N64 room (clamped to 25000
+	// against a hand-measured 11000), and same-host rooms no longer adapt, so that rate would really be
+	// sent. Only a NEAREST magnify produces the step-function edges the high target exists for.
+	// The default when the config omits scaleMethod is nearest-neighbour (media/gstreamer.go
+	// `cmp.Or(scaleMethod, "nearest-neighbour")`), which is what the 2D cores rely on.
+	method := m.ScaleMethod
+	if method == "" {
+		method = "nearest-neighbour"
+	}
+	bpp, class := abrBppSmooth, "smooth/3d"
+	if scale > 1 && strings.Contains(strings.ToLower(method), "nearest") {
+		bpp, class = abrBppMagnified, "magnified-2d"
+	}
+	// A per-core `bppTarget:` wins over the class default. The class is a PROXY — it reads the edge
+	// characteristic (a nearest magnify makes step-function edges that cost bits) but is blind to
+	// content complexity, and cannot tell point-sampled 3D from a sprite sheet. Set the override when a
+	// MEASUREMENT disagrees with the class, never to express a preference.
+	if m.BppTarget > 0 {
+		bpp, class = m.BppTarget, "core-override"
+	}
+	raw := int(bpp * float64(ew) * float64(eh) * fps / 1000)
+	kbps := min(max(raw, abrAutoMinKbps), abrAutoMaxKbps)
+	note := ""
+	if kbps != raw {
+		note = fmt.Sprintf(" [clamped from %d]", raw)
+	}
+	return kbps, fmt.Sprintf("encode %dx%d @%.2ffps (core %dx%d x%.4g %s), %s, %.3f bpp%s",
+		ew, eh, fps, m.VideoW, m.VideoH, scale, method, class, bpp, note)
+}
+
+// startRoomAbr drives the room's encoder bitrate, and each peer's temporal layer, from the peers'
+// send-side estimates. ceilKbps is the room's chosen quality (the creator's t=104 bitrate, else the
+// config default): ABR never exceeds it, so "Auto" on the site still decides how good a room may look.
+// ceilFn is read EVERY TICK, not captured once: a core can change resolution after boot, and the
+// ceiling has to follow it. Sonic comes up at 256x192 and settles at 320x224 roughly 250ms later —
+// sampling once at room start sized the room for 768x576 when it went on to encode 960x672, a 46%
+// pixel undercount that under-provisioned the room for its entire session. The pipeline already
+// rebuilt itself on that change (VideoChangeCb -> Reinit); the ceiling was the one thing that did not.
+// mirror + system are carried purely for the Phase-0 session-close link-stat row; both may be zero
+// (mirror unconfigured) and the loop then behaves exactly as it did before instrumentation.
+func startRoomAbr(log *logger.Logger, r *room.Room[*room.GameSession], m *media.GstMediaPipe, ceilFn func() int,
+	mirror linkStatConfig, system string) {
+	if ceilFn == nil || r == nil || m == nil {
+		return
+	}
+	ceilKbps := ceilFn()
+	if ceilKbps <= 0 {
+		return
+	}
+	floor := min(abrFloorKbps, ceilKbps)
+	// Open at the SMALLER of the fixed opener and a fraction of this room's ceiling, so a low-ceiling
+	// (2D) room ramps into its rate instead of starting at it. Never below the floor.
+	cur := min(abrStartKbps, ceilKbps*abrStartCeilPct/100)
+	cur = min(max(cur, floor), ceilKbps)
+
+	if err := m.SetVideoBitrate(cur); err != nil {
+		log.Warn().Err(err).Msg("abr: encoder rejected the initial bitrate; ABR disabled for this room")
+		return
+	}
+	codec := m.Codec()
+	layers := webrtc.TemporalLayers()
+	share := shares(codec, layers)
+	if layers < 1 || share == nil {
+		// Not layered, or a codec/layer-count combination we have no measurements for: behave exactly
+		// as before SVC existed. Never invent a share — the loop below divides by it.
+		layers, share = 1, []int{100}
+	}
+	log.Info().Msgf("abr: start %d kbps (floor %d, ceiling %d, %s temporal layers %d, base share %d%%)",
+		cur, floor, ceilKbps, codec, layers, share[0])
+
+	// The opening rate, kept separately because `cur` is about to start moving. Phase 0's whole point
+	// is that a room's story is open -> ramp -> steady, and the opener is the number Phase 1 replaces.
+	openKbps := cur
+
+	go func() {
+		t := time.NewTicker(abrTick)
+		defer t.Stop()
+		// Consecutive below-threshold ticks (patch 0026). We send UNPACED on purpose (NoOpPacer —
+		// pacing is queued latency), so every encoded frame leaves as a microburst and GCC's
+		// delay-based detector occasionally reads one as congestion even on idle wired gigabit
+		// (measured: a single-tick 11000->7828 dip on an ethernet LAN with a direct host pair).
+		// Requiring TWO consecutive low ticks makes those one-tick artifacts invisible; genuine
+		// congestion still backs off, one second later.
+		lowTicks := 0
+		// Consecutive over-budget ticks per peer, for temporal-layer DROPS only (see below). Lives in
+		// this goroutine, so no locking; peers that leave the room simply stop being iterated.
+		layerDown := map[svcPeer]int{}
+		// Consecutive STARVED ticks per peer — same idea as layerDown, for the room-cap path.
+		starveHold := map[svcPeer]int{}
+		// Congestion memory (see the const block): the last rate that provoked a confirmed cut
+		// (0 = none seen), how many consecutive healthy ticks we have spent at/above it, and how many
+		// ticks remain of the post-cut probe hold.
+		congKbps, congClear, congHold := 0, 0, 0
+		// RTT accumulators per peer (observability only). Same lifetime rules as layerDown above: this
+		// goroutine owns them, and a peer that leaves simply stops being iterated.
+		rtt := map[svcPeer]*rttStat{}
+		ticks := 0
+
+		// ── Phase-0 close-summary counters (observability only) ────────────────────────────────────
+		// NOTHING below this comment is read by any ABR decision. They exist so that "it looked bad"
+		// becomes an attributable row instead of a memory, and so the two populations the plan cares
+		// about — ramp tax vs genuine wireless limit — separate automatically.
+		//
+		// The RAMP/STEADY split is the discipline that matters: a cold room's climb produces cuts and
+		// starves that look pathological in a tail but are just the probe finding the ceiling. Encoding
+		// the split into the log itself is what stops the next reader misdiagnosing a healthy ramp.
+		pstat := map[svcPeer]*abrPeerStat{}
+		atCeilTicks := 0    // ticks spent at >= abrAtCeilPct of the ceiling
+		atCeilSeen := false // has the room EVER touched the ceiling? — the ramp/steady boundary
+		rampTicks := -1     // ticks from open to the first ceiling touch; -1 = never got there
+		cutsRamp, cutsSteady := 0, 0
+		starvesRamp, starvesSteady := 0, 0
+		congEpisodes := 0 // distinct congestion-memory episodes (0 -> non-zero transitions)
+		congMaxHold := 0  // longest run of consecutive ticks a remembered wall was held
+		congRun := 0
+		for range t.C {
+			if r.Closed() {
+				// Final RTT summary per peer BEFORE returning — a short session may never reach a
+				// periodic emit, and the close line is the one that always exists.
+				for p, s := range rtt {
+					logRttProbe(log, r.Id(), p, s, true)
+				}
+
+				// ── Phase-0 session summary ────────────────────────────────────────────────────
+				// One greppable line for the room, one per peer, then the mirror. All of it is
+				// derived from counters already accumulated; the only work here is formatting, so
+				// the close path stays as fast as it was.
+				ramp := "never"
+				if rampTicks >= 0 {
+					ramp = strconv.Itoa(rampTicks)
+				}
+				atCeilPct := 0
+				if ticks > 0 {
+					atCeilPct = atCeilTicks * 100 / ticks
+				}
+				log.Info().Msgf(
+					"abr: summary room=%s system=%s open=%d ceil=%d codec=%s layers=%d ticks=%d "+
+						"rampTicks=%s atCeilPct=%d cuts=%d cutsRamp=%d cutsSteady=%d "+
+						"starves=%d starvesRamp=%d starvesSteady=%d congEpisodes=%d congMaxHoldTicks=%d",
+					r.Id(), system, openKbps, ceilKbps, codec, layers, ticks,
+					ramp, atCeilPct, cutsRamp+cutsSteady, cutsRamp, cutsSteady,
+					starvesRamp+starvesSteady, starvesRamp, starvesSteady, congEpisodes, congMaxHold)
+
+				// Snapshot each peer BY VALUE before dispatching anything: the peer objects and these
+				// maps die with this goroutine the instant it returns.
+				var snap []abrSummaryPeer
+				for p, st := range pstat {
+					sp := abrSummaryPeer{
+						dev: st.dev, path: st.path, deviceId: st.deviceId, username: st.username,
+						sustainedKbps: st.sustainedKbps, sameHost: st.path == "samehost",
+					}
+					if s := rtt[p]; s != nil {
+						sp.rttMean, sp.rttSd = s.mean, s.sd()
+					}
+					snap = append(snap, sp)
+				}
+				for _, sp := range snap {
+					log.Info().Msgf(
+						"abr: summary-peer room=%s dev=%s path=%s sustained=%d rttMean=%.2fms rttSd=%.2fms device=%s user=%s",
+						r.Id(), sp.dev, sp.path, sp.sustainedKbps, sp.rttMean, sp.rttSd, sp.deviceId, sp.username)
+				}
+
+				// Mirror to the site — one row per NON-SAMEHOST peer. Same-host rows are deliberately
+				// never stored: they measure our own encoder and CPU rather than a link (those rooms
+				// bypass ABR entirely), so a warm value derived from one would describe nothing. The
+				// plan's rule is that they never feed warm values; not storing them at all is the
+				// simplest way to make that unbreakable downstream. They are still LOGGED above.
+				//
+				// A row with no device or no user cannot be keyed to anything Phase 1 could look up,
+				// so it is dropped here rather than stored unattributable.
+				if mirror.enabled() {
+					for _, sp := range snap {
+						if sp.sameHost || sp.deviceId == "" || sp.username == "" {
+							continue
+						}
+						row := linkStatRow{
+							RoomId: r.Id(), Username: sp.username, DeviceId: sp.deviceId,
+							System: system, Codec: codec,
+							CeilingKbps: ceilKbps, OpenKbps: openKbps, SustainedKbps: sp.sustainedKbps,
+							AtCeilPct: atCeilPct, CutsSteady: cutsSteady, StarvesSteady: starvesSteady,
+							CongEpisodes: congEpisodes,
+							RttMeanMs:    sp.rttMean, RttSdMs: sp.rttSd, Path: sp.path,
+						}
+						if rampTicks >= 0 {
+							rt := rampTicks
+							row.RampTicks = &rt
+						}
+						// `go` per row: the room is already gone and must not wait on the site.
+						go mirror.post(log, row)
+					}
+				}
+
+				log.Debug().Msg("abr: room closed")
+				return
+			}
+			ticks++
+			// Re-read the ceiling: a mid-room geometry change moves it (see ceilFn). Widening it simply
+			// gives the healthy branch somewhere to climb; narrowing it is enforced by the clamp below,
+			// so a core that shrinks its frame cannot leave the room sending more than it should.
+			if c := ceilFn(); c > 0 && c != ceilKbps {
+				_, why := autoCeilingKbps(m)
+				log.Info().Msgf("abr: ceiling %d -> %d kbps — %s", ceilKbps, c, why)
+				ceilKbps = c
+				floor = min(abrFloorKbps, ceilKbps)
+				// Congestion memory was learned against the OLD frame size. A bigger frame at the same
+				// bitrate is a different picture, so the remembered wall no longer describes this room.
+				congKbps, congClear, congHold = 0, 0, 0
+			}
+
+			// Summary accounting for the rate we are HOLDING as this tick begins (cur only moves at
+			// the end of a tick, so this is the rate that was actually on the wire for it).
+			if cur*100 >= ceilKbps*abrAtCeilPct {
+				atCeilTicks++
+				if !atCeilSeen {
+					// First touch of the ceiling: this is the ramp/steady boundary every later
+					// counter is split on, and rampTicks is the ramp-tax number Phase 1 must beat.
+					atCeilSeen = true
+					rampTicks = ticks
+				}
+			}
+			// Longest HOLD = the longest unbroken run of ticks during which a wall was remembered.
+			// Not the same as the post-cut probe hold (abrCongHoldTicks); this measures how long the
+			// room's behaviour was actually shaped by congestion memory.
+			if congKbps > 0 {
+				congRun++
+				if congRun > congMaxHold {
+					congMaxHold = congRun
+				}
+			} else {
+				congRun = 0
+			}
+
+			// worstServable: the tightest estimate among peers we can still serve at their assigned
+			// layer, expressed in ROOM terms (scaled back up by the share they receive). That is what
+			// the room bitrate must respect.
+			// roomCap: a hard ceiling contributed by any STARVED peer (one for whom not even the base
+			// layer fits) — set to what base layer alone would need.
+			worstServable, roomCap, peers := 0, 0, 0
+			// bindingPeer: whichever peer's estimate ended up SETTING worstServable this tick — i.e.
+			// the one actually constraining the room. Summary only; it feeds `sustained`, so that a
+			// peer is credited with a rate only while it was the constraint, never while somebody
+			// else was holding the room down.
+			var bindingPeer svcPeer
+			// How many of the estimating peers are on the worker's own host, and how many have a link
+			// fast enough to skip the creep (same-host, or a sustained low RTT). See the fast path below.
+			sameHostPeers, fastPeers := 0, 0
+			// Pre-count the estimating peers: the layer policy below needs to know whether this peer
+			// is ALONE before deciding anything about it.
+			solo := func() bool {
+				n := 0
+				for u := range r.Users().Values() {
+					if p, ok := u.Session.(svcPeer); ok && p.TargetBitrateKbps() > 0 {
+						if n++; n > 1 {
+							return false
+						}
+					}
+				}
+				return n == 1
+			}()
+			for u := range r.Users().Values() {
+				p, ok := u.Session.(svcPeer)
+				if !ok {
+					continue
+				}
+				// 0 = not connected yet, or no TWCC feedback has arrived. Not an opinion.
+				est := p.TargetBitrateKbps()
+				if est <= 0 {
+					continue
+				}
+				peers++
+				sameHost := p.SameHostLink()
+				if sameHost {
+					sameHostPeers++
+				}
+				// Per-peer summary state. Identity is known from connection setup; the link
+				// description needs a nominated ICE pair, so it is sampled on the first tick it
+				// becomes available and never re-read — by room close the pair is being torn down
+				// and would report "unknown".
+				st := pstat[p]
+				if st == nil {
+					st = &abrPeerStat{deviceId: p.DeviceId(), username: p.Username()}
+					pstat[p] = st
+				}
+				if st.dev == "" {
+					if d := p.LinkDesc(); d != "unknown" {
+						st.dev, st.path = d, p.LinkPath()
+					}
+				}
+				if ms, ok := p.LinkRttMs(); ok {
+					s := rtt[p]
+					if s == nil {
+						s = &rttStat{}
+						rtt[p] = s
+					}
+					s.add(ms)
+					if ticks%rttProbeEvery == 0 {
+						logRttProbe(log, r.Id(), p, s, false)
+					}
+				}
+				// "Fast" = nothing between us worth protecting from a probe. Same-host qualifies by
+				// construction (no radio, no switch, no queue); everyone else has to EARN it with a
+				// sustained sub-abrFastRttMs mean. A peer with no RTT reading yet never qualifies.
+				if s := rtt[p]; sameHost || (s != nil && s.n >= abrFastRttMinSamples && s.mean < abrFastRttMs) {
+					fastPeers++
+				}
+
+				// A LONE player has nobody to protect. The ladder's whole rationale — "weak peers get
+				// fewer frames, NOT a worse room" — has no beneficiary when the weak peer IS the room,
+				// and the failure mode is perverse: layer-down and bitrate-backoff share the same
+				// est<85% threshold, the layer drop is evaluated first, and once this peer sits at base
+				// its health is judged against the smaller share it now receives — so the room reads
+				// HEALTHY and ramps bitrate while its only player is stuck at half frame rate. A solo
+				// player is better served by the bitrate path (memory + probe hold) keeping 60fps at
+				// slightly fewer bits. So: full ladder always, bitrate-only adaptation, and restore the
+				// top layer if this peer was dropped back when the room had company. Multi-peer rooms
+				// are untouched. (This was always mildly wrong for solo AV1 too — H.264-on-tablet is
+				// just where it would finally have been felt.)
+				if solo {
+					if now := p.MaxTemporalLayer(); layers > 1 && now != layers-1 {
+						log.Info().Msgf("abr: peer layer %d -> %d (solo room — full frame rate, bitrate adapts instead)",
+							now, layers-1)
+						p.SetMaxTemporalLayer(layers - 1)
+					}
+					delete(layerDown, p)
+					delete(starveHold, p)
+					// Full stream ⇒ share is 100%: the room bitrate must respect the raw estimate.
+					if worstServable == 0 || est < worstServable {
+						worstServable = est
+						bindingPeer = p
+					}
+					continue
+				}
+
+				now := p.MaxTemporalLayer()
+				layer, starved := pickLayer(share, now, cur, est)
+				if layers > 1 && layer != now {
+					// A DROP must persist for abrLayerDownTicks before we act on it. We send unpaced on
+					// purpose, so every encoded frame leaves as a microburst and GCC occasionally reads
+					// one as congestion even on idle gigabit — and unlike a bitrate rung, acting on that
+					// noise halves the player's frame rate. Climbing back up needs no confirmation: it
+					// already carries a 25% headroom requirement, and being early to restore 60fps is
+					// not a defect.
+					if layer < now {
+						layerDown[p]++
+						if layerDown[p] < abrLayerDownTicks {
+							continue
+						}
+					}
+					delete(layerDown, p)
+					log.Info().Msgf("abr: peer layer %d -> %d (estimate %d kbps, room sends %d)",
+						now, layer, est, cur)
+					p.SetMaxTemporalLayer(layer)
+				} else {
+					delete(layerDown, p) // it recovered on its own; forget the bad tick
+				}
+
+				if starved {
+					// Confirm it first: one starved tick is the same microburst noise the layer/backoff
+					// paths already refuse to act on, and with layers==1 acting on it costs the room 6x.
+					starveHold[p]++
+					if starveHold[p] < abrStarveTicks {
+						continue
+					}
+					// Count the CONFIRMATION, not every starved tick: starveHold keeps climbing while
+					// a starve persists, so testing for equality counts one event per episode, which
+					// is what "starves=" is meant to mean. Split on whether the room had ever reached
+					// its ceiling — starves during the climb are the probe doing its job.
+					if starveHold[p] == abrStarveTicks {
+						if atCeilSeen {
+							starvesSteady++
+						} else {
+							starvesRamp++
+						}
+					}
+					// Even the base layer is too much for this link. Lower the room only to what BASE
+					// needs — not to this peer's raw estimate. Everyone else keeps the layers above.
+					need := est * 100 / share[0]
+					if roomCap == 0 || need < roomCap {
+						roomCap = need
+					}
+					continue
+				}
+				delete(starveHold, p) // served this tick; forget the bad one
+				// This peer is served at `layer`, so it receives only a fraction of what we send.
+				// Judge its health against THAT, not against the full room bitrate: scale its estimate
+				// back up into room terms so one comparison works for every peer.
+				effective := est * 100 / max(share[layer], 1)
+				if worstServable == 0 || effective < worstServable {
+					worstServable = effective
+					bindingPeer = p
+				}
+			}
+			if peers == 0 {
+				continue // hold: nobody has told us anything yet
+			}
+
+			// A tick is HEALTHY for summary purposes when nobody is starved and the binding estimate
+			// is keeping up with what we send. Deliberately computed from the same quantities the
+			// switch below reads, but INDEPENDENTLY of which branch runs: the healthy case requires
+			// `cur < ceilKbps`, so a room parked at its ceiling — the steady state `sustained` exists
+			// to measure — takes the default branch. Keying off the branch would blind it to exactly
+			// the ticks that matter. Reads nothing it mutates; the switch is unaffected.
+			healthyTick := roomCap == 0 && worstServable > 0 && worstServable*100 >= cur*abrHealthyPct
+			for p, st := range pstat {
+				if !healthyTick || p != bindingPeer {
+					st.runTicks = 0 // not the constraint (or not healthy) — the run says nothing
+					continue
+				}
+				if st.runTicks == 0 || cur < st.runMinKbps {
+					st.runMinKbps = cur
+				}
+				st.runTicks++
+				if st.runTicks >= abrSustainedMinTicks && st.runMinKbps > st.sustainedKbps {
+					st.sustainedKbps = st.runMinKbps
+				}
+			}
+
+			next := cur
+			// SAME-HOST ROOMS DO NOT ADAPT. When every estimating peer is this machine, the media never
+			// crosses a network — loopback or our own NIC — so GCC is not measuring a link, it is
+			// measuring our own encoder and CPU. Feeding that back into a bandwidth decision is what
+			// produced both failed ramp attempts above. There is nothing to congest and nothing to
+			// protect, so sit at the ceiling and leave the estimate out of it.
+			//
+			// Strictly same-host, never "fast RTT": a wired LAN desktop is a real link that can really
+			// saturate, and its estimate is meaningful. RTT classification stays observability only (the
+			// `fast` count in the log line) until there is a design that earns more.
+			sameHostRoom := peers > 0 && sameHostPeers == peers
+			switch {
+			case sameHostRoom:
+				lowTicks = 0
+				next = ceilKbps
+			case worstServable > 0 && worstServable*100 < cur*abrBackoffPct:
+				lowTicks++
+				if lowTicks >= 2 { // confirmed congestion
+					next = worstServable
+				}
+			case worstServable > 0 && worstServable*100 >= cur*abrHealthyPct && cur < ceilKbps:
+				lowTicks = 0
+				step := max(abrMinStepKbps, cur*abrRampPct/100) // healthy: probe upward
+				// FAST-LINK PATH. The opener is deliberately conservative (min(6000, ceiling*60%)) and
+				// then creeps +15%/tick, which is right when an opening burst can overrun a radio queue.
+				// It is pure waste when the player IS this machine: measured on Ziggy, every room crept
+				// 6000 -> 6900 -> 7935 -> 9125 -> 10493 -> 12066 -> 13875 -> 15956 over ~35s with `cong 0`
+				// and `starved-cap 0` the entire way — nothing was ever congested, and every new room paid
+				// it again. Eric's report was "it looked like a low quality stream repeatedly", which is
+				// exactly what 35 seconds of ramp looks like on a link that was never the constraint.
+				//
+				// So: when EVERY estimating peer is same-host and we hold no congestion memory, go to the
+				// ceiling in one step. Same-host has no queue to overrun, and the guards all still apply —
+				// this only replaces the size of an upward probe. If the estimate later disagrees, the
+				// two-tick backoff, the 70% cut clamp and congestion memory handle it exactly as before,
+				// and once a wall is remembered (congKbps > 0) this path switches itself off.
+				//
+				// Deliberately NOT applied to the opener: at startRoomAbr no peer has connected yet, so
+				// there is no candidate pair to classify. One tick of ramp is the cost of measuring.
+				// ACTIVATED 2026-07-30 against measured hardware, having shipped inert for one session
+				// while the bitrate work was in flight (two behaviour changes competing for blame is how
+				// you learn nothing from a test). Confirming numbers, same LAN, same game:
+				//   wired PC  mean 0.90ms sd 0.48  -> qualifies, and spent 15s creeping 6000 -> 19328
+				//   tablet    mean 3.86ms sd 1.50  -> excluded, best single sample 1.59ms
+				// NOTE: there is deliberately NO "fast link" step multiplier here. Two attempts failed
+				// for the same measured reason (2026-07-30): the +15%/tick creep is not a conservative
+				// choice, it is approximately GCC'S OWN MAXIMUM TRACKING RATE. The estimate can only rise
+				// as we send more, so ANY larger step is judged against an estimate taken at the old rate
+				// and reads as congestion:
+				//   leap 6000 -> 19328 : servable 6861 -> cut to 13529 two ticks later, then a 250/tick crawl
+				//   double 6000 -> 12000: servable 6805 -> cut to 8400 two ticks later, same crawl
+				// Both left the room WORSE than the creep. A faster ramp cannot come from a bigger step;
+				// it can only come from not consulting the estimator at all, which is defensible in
+				// exactly one case — see the same-host branch above the switch.
+				if congKbps > 0 {
+					// Holding at/above the remembered wall and still healthy: count toward forgetting
+					// it. Enough proof and probing goes back to full speed.
+					if cur >= congKbps {
+						congClear++
+						if congClear >= abrCongClearTicks {
+							congKbps, congClear = 0, 0
+						}
+					} else {
+						congClear = 0
+					}
+					// Approaching (or passing) a wall we still remember: creep, don't leap. An
+					// abrMinStepKbps overshoot starves gently and reconfirms the wall; a 15% leap
+					// re-creates the crash we remember.
+					if congKbps > 0 && cur+step >= congKbps*abrCongProbePct/100 {
+						// Fresh off a cut that confirmed this wall: don't probe into it at all yet.
+						// Hold the settled rate — flat bitrate is exactly what plays smoothly.
+						if congHold > 0 {
+							congHold--
+							step = 0
+						} else {
+							step = abrMinStepKbps
+						}
+					}
+				}
+				next = cur + step
+			default:
+				lowTicks = 0
+			}
+			// A starved peer's base-layer requirement is a hard ceiling on the room.
+			if roomCap > 0 {
+				next = min(next, roomCap)
+			}
+			// Descend by steps, never off a cliff: successive ticks compound (3 ticks reach ~34% of
+			// where we started), so real congestion is still met quickly, while a single bad reading
+			// costs one 30% rung instead of the whole room. The floor still applies underneath.
+			if next < cur {
+				next = max(next, cur*abrMaxCutPct/100)
+			}
+			next = min(max(next, floor), ceilKbps)
+
+			if next == cur || abs(next-cur) < abrMinStepKbps {
+				continue
+			}
+			// Any confirmed cut marks where it hurt: the rate we are leaving was too high for the
+			// link. Both the backoff and starve-cap paths funnel through here. The hold starts now —
+			// the wall was just (re)confirmed, so probing into it again immediately is pointless.
+			if next < cur {
+				// Summary: a CONFIRMED cut, split on whether the room had reached its ceiling yet.
+				// cutsRamp is the probe finding the wall on the way up; cutsSteady is the room losing
+				// ground it had already held, which is the one that indicates a real problem.
+				if atCeilSeen {
+					cutsSteady++
+				} else {
+					cutsRamp++
+				}
+				// A new congestion EPISODE is a transition from "no wall remembered" to a wall. A cut
+				// that re-confirms a wall we already remember extends the episode, it does not start
+				// a new one.
+				if congKbps == 0 {
+					congEpisodes++
+				}
+				congKbps, congClear, congHold = cur, 0, abrCongHoldTicks
+			}
+			if err := m.SetVideoBitrate(next); err != nil {
+				log.Warn().Err(err).Msgf("abr: failed to set %d kbps", next)
+				continue
+			}
+			log.Info().Msgf("abr: %d -> %d kbps (servable %d, starved-cap %d, ceiling %d, peers %d, samehost %d, fast %d, cong %d)",
+				cur, next, worstServable, roomCap, ceilKbps, peers, sameHostPeers, fastPeers, congKbps)
+			cur = next
+		}
+	}()
+}
+
+func abs(n int) int {
+	if n < 0 {
+		return -n
+	}
+	return n
+}
diff --git a/pkg/worker/abr_test.go b/pkg/worker/abr_test.go
new file mode 100644
index 0000000..a78e01a
--- /dev/null
+++ b/pkg/worker/abr_test.go
@@ -0,0 +1,106 @@
+package worker
+
+import "testing"
+
+// 3-layer AV1 shares: base 28% / +mid 54% / full 100% of the room bitrate.
+func TestPickLayer(t *testing.T) {
+	const send = 10000 // room sends 10 Mbps
+	share := shares("av1", 3)
+
+	tests := []struct {
+		name        string
+		current     int
+		est         int
+		wantLayer   int
+		wantStarved bool
+	}{
+		// A healthy peer takes everything.
+		{"fat pipe keeps all layers", 2, 12000, 2, false},
+		{"exactly enough for full", 2, 10000, 2, false},
+
+		// 6 Mbps cannot carry the full 10 Mbps stream, but carries layers 0-1 (5.4 Mbps) fine. THIS is
+		// the case the whole feature exists for: before SVC this peer dragged the room to 6 Mbps.
+		{"mid link drops to layer 1", 2, 6000, 1, false},
+
+		// 3 Mbps: only the base layer (2.8 Mbps) fits.
+		{"weak link drops to base", 2, 3000, 0, false},
+
+		// Below even the base layer -> starved. The room must come down for this one.
+		{"starved", 2, 1000, 0, true},
+
+		// Hysteresis — a DEAD BAND, in both directions.
+		//
+		// A peer sitting at layer 1 needs the full layer (10 Mbps) plus 25% headroom (12.5 Mbps) before
+		// climbing back to 2; at 10.5 it stays put.
+		{"no climb without headroom", 1, 10500, 1, false},
+		{"climbs with headroom", 1, 12500, 2, false},
+
+		// ...and it does NOT drop just because the estimate dipped a little below what we send. This is
+		// the regression that shipped: a peer at 9000 against 10000 sent (90%) had its frame rate halved,
+		// restored, halved again every few seconds — the game visibly stuttered. A layer change halves
+		// the FRAME RATE, so it must cost more than a marginal reading. Only <85% moves it.
+		{"holds its layer on a shallow dip (was: flapped 60->30->60)", 2, 9000, 2, false},
+		{"drops when genuinely over budget", 2, 8000, 1, false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			layer, starved := pickLayer(share, tc.current, send, tc.est)
+			if layer != tc.wantLayer || starved != tc.wantStarved {
+				t.Errorf("pickLayer(cur=%d, est=%d) = (layer %d, starved %v), want (layer %d, starved %v)",
+					tc.current, tc.est, layer, starved, tc.wantLayer, tc.wantStarved)
+			}
+		})
+	}
+}
+
+// With SVC off, no peer may ever be capped below the only layer that exists.
+func TestPickLayerSVCOff(t *testing.T) {
+	layer, starved := pickLayer(shares("av1", 1), 0, 10000, 500) // 1 layer, hopeless estimate
+	if layer != 0 {
+		t.Errorf("layer = %d, want 0 (the only layer)", layer)
+	}
+	if !starved {
+		t.Errorf("a peer that cannot carry the single layer should read as starved (room must drop)")
+	}
+}
+
+// An unknown codec/layer-count combination must not panic or silently cap peers.
+func TestPickLayerUnknownLayerCount(t *testing.T) {
+	layer, starved := pickLayer(shares("av1", 99), 2, 10000, 100)
+	if layer != 2 || starved {
+		t.Errorf("unknown layer count should hold current layer, got (%d, %v)", layer, starved)
+	}
+	if s := shares("vp8", 2); s != nil {
+		t.Errorf("shares for an unmeasured codec = %v, want nil (ABR must fall back to no ladder)", s)
+	}
+}
+
+// H.264's ladder is real but SHALLOW: base is 80% of the room, not 28%. The thresholds must still
+// behave, and a peer must not be declared starved while 80% of the stream still fits.
+func TestPickLayerH264(t *testing.T) {
+	share := shares("h264", 2)
+	if share == nil {
+		t.Fatal("no 2-layer share for h264 — SVC would silently stay off in every h264 room")
+	}
+	const send = 10000
+
+	// 8400 is over budget for the full stream (the dead band starts at 85% of 10000) but carries the
+	// 8000 base fine. Note how narrow that window is with an 80% base share — dropping a layer buys
+	// this peer only 400 kbps of margin, which is the whole story of the H.264 ladder.
+	if layer, starved := pickLayer(share, 1, send, 8400); layer != 0 || starved {
+		t.Errorf("weak peer = (layer %d, starved %v), want (0, false)", layer, starved)
+	}
+	// Under the base layer's 8000 there is nothing left to shed: the ROOM has to come down.
+	if layer, starved := pickLayer(share, 0, send, 5000); layer != 0 || !starved {
+		t.Errorf("very weak peer = (layer %d, starved %v), want (0, true)", layer, starved)
+	}
+	// Climbing back to 60fps needs 25% headroom over the full rate, exactly as it does for AV1 —
+	// a shallow ladder is no excuse for flapping the frame rate.
+	if layer, _ := pickLayer(share, 0, send, 11000); layer != 0 {
+		t.Errorf("climbed to layer %d without headroom, want to hold 0", layer)
+	}
+	if layer, _ := pickLayer(share, 0, send, 12500); layer != 1 {
+		t.Errorf("layer = %d with headroom, want 1", layer)
+	}
+}
