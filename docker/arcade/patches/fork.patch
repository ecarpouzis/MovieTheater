index eb84d6e..be09f97 100644
--- a/pkg/worker/caged/libretro/recording.go
+++ b/pkg/worker/caged/libretro/recording.go
@@ -45,8 +45,21 @@ func (r *RecordingFrontend) SetAudioCb(fn func(app.Audio)) {
 
 func (r *RecordingFrontend) SetVideoCb(fn func(app.Video)) {
 	r.Emulator.SetVideoCb(func(v app.Video) {
-		if r.IsRecording() {
-			r.rec.WriteVideo(recorder.Video{Frame: recorder.Frame(v.Frame), Duration: time.Duration(v.Duration)})
+		// v.Frame.Tex != 0 means GL zero-copy: the frame is a texture and Data is nil, so there is
+		// nothing for the recorder to write. Recording and GL zero-copy are mutually exclusive by
+		// nature (the recorder wants system memory, the whole point here is never to produce it) —
+		// skip rather than write empty frames. Field-by-field, not a struct conversion: a plain
+		// recorder.Frame(v.Frame) breaks the moment either struct gains a field.
+		if r.IsRecording() && v.Frame.Data != nil {
+			r.rec.WriteVideo(recorder.Video{
+				Frame: recorder.Frame{
+					Data:   v.Frame.Data,
+					Stride: v.Frame.Stride,
+					W:      v.Frame.W,
+					H:      v.Frame.H,
+				},
+				Duration: time.Duration(v.Duration),
+			})
 		}
 		fn(v)
 	})
