+#ifndef RC_CLIENT_RAINTEGRATION_H
+#define RC_CLIENT_RAINTEGRATION_H
+
+#ifndef _WIN32
+ #undef RC_CLIENT_SUPPORTS_RAINTEGRATION /* Windows required for RAIntegration */
