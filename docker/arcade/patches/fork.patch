+package coordinator
+
+import (
+	"time"
+
+	"github.com/giongto35/cloud-game/v3/pkg/api"
+)
+
+// GameStartTimeout is how long the coordinator lets a worker take to boot a game before it gives up.
+//
+// It is not the 10s default (com.DefaultCallTimeout) because a game start is the one call that runs an
+// entire emulator boot inline, and a hardware core's boot is dominated by shader work that the default
+// never budgeted for. Dolphin on a COLD pipeline cache is the worst case: it compiles on the way up,
+// and mode-2 (async ubershaders) additionally QUEUES the whole ubershader set at init.
+//
+// Timing a start out does not stop it. The worker finishes booting and registers its room, while the
+// coordinator has already released the slot and told the user "the arcade is full" — the two now
+// disagree about who is running what, which is the wedge this budget exists to prevent. So the ceiling
+// is deliberately far above any healthy boot (seconds) rather than tuned close to it: it is a
+// backstop against a hung worker, not a performance knob. A genuinely hung boot still fails, just later.
+const GameStartTimeout = 60 * time.Second
+
+func (w *Worker) InitWebrtcStream(id string, initiator bool, sdp string, videoCodec string, deviceId, username string) (*api.InitWebrtcStreamResponse, error) {
+	return api.UnwrapChecked[api.InitWebrtcStreamResponse](
+		w.Send(api.InitWebrtcStream, api.InitWebrtcStreamRequest{
+			Id: id, Initiator: initiator, Sdp: sdp, VideoCodec: videoCodec,
+			// DeviceId/Username relayed for the ABR link-stat mirror. THIS LITERAL is the silent-drop
+			// point the api structs warn about: a field present in both structs but missing here is
+			// dropped without an error anywhere.
+			DeviceId: deviceId, Username: username,
+		}))
+}
+
+func (w *Worker) WebrtcSignal(id string, sdp, ice *string) {
+	w.Notify(api.WebrtcSignal, api.WebrtcSignalRequest{
+		Stateful: api.Stateful{Id: id}, Ice: ice, Sdp: sdp,
+	})
+}
+
+func (w *Worker) StartGame(id string, req api.GameStartUserRequest) (*api.StartGameResponse, error) {
+	return api.UnwrapChecked[api.StartGameResponse](
+		w.SendWith(api.StartGame, api.StartGameRequest{
+			StatefulRoom: api.StatefulRoom{Id: id, Rid: req.RoomId},
+			Game:         req.GameName,
+			PlayerIndex:  req.PlayerIndex,
+			Record:       req.Record,
+			RecordUser:   req.RecordUser,
+			// Forward the creator's per-room encoder quality choice to the worker.
+			VideoBitrate: req.VideoBitrate,
+			AudioFec:     req.AudioFec,
+			Pace:         req.Pace,
+			VideoCodec:   req.VideoCodec,
+			// ...and the per-launch GL/Vulkan force from the play-button dropdown.
+			HwContext: req.HwContext,
+			// ...and the Wii controller-scheme choice for the GC-controller-native BrawlEx mods.
+			ControllerScheme: req.ControllerScheme,
+			// ...and the per-room core-key override (PS1 pcsx_rearmed vs Beetle). Silent-drop trap.
+			Core: req.Core,
+			// ...and the cheats they picked. The coordinator only relays: any field it doesn't know
+			// about is dropped here without an error, so this line is what makes the feature exist.
+			CoreOptions: req.CoreOptions,
+			Cheats:      req.Cheats,
+			// ...and whether the boot state was a deliberate snapshot pick (save-scum) rather than the
+			// ordinary auto-save continue. Omitting this line is what silently drops the field.
+			SeedExplicit: req.SeedExplicit,
+			// ...and the RetroAchievements creds + hardcore. Same silent-drop trap — the coordinator
+			// relays only what it names, so these lines are what carry RA to the worker.
+			RaUser:   req.RaUser,
+			RaToken:  req.RaToken,
+			RaHash:   req.RaHash,
+			Hardcore: req.Hardcore,
+		}, GameStartTimeout))
+}
+
+func (w *Worker) QuitGame(id string) {
+	w.Notify(api.QuitGame, api.GameQuitRequest{Id: id, Rid: w.RoomId})
+}
+
+func (w *Worker) SaveGame(id string) (*api.SaveGameResponse, error) {
+	return api.UnwrapChecked[api.SaveGameResponse](
+		w.Send(api.SaveGame, api.SaveGameRequest{Id: id, Rid: w.RoomId}))
+}
+
+func (w *Worker) LoadGame(id string) (*api.LoadGameResponse, error) {
+	return api.UnwrapChecked[api.LoadGameResponse](
+		w.Send(api.LoadGame, api.LoadGameRequest{Id: id, Rid: w.RoomId}))
+}
+
+func (w *Worker) ChangePlayer(id string, index int) (*api.ChangePlayerResponse, error) {
+	return api.UnwrapChecked[api.ChangePlayerResponse](
+		w.Send(api.ChangePlayer, api.ChangePlayerRequest{
+			StatefulRoom: api.StatefulRoom{Id: id, Rid: w.RoomId},
+			Index:        index,
+		}))
+}
+
+func (w *Worker) ResetGame(id string) {
+	w.Notify(api.ResetGame, api.ResetGameRequest{Id: id, Rid: w.RoomId})
+}
+
+func (w *Worker) FastForwardGame(id string, active bool) {
+	w.Notify(api.FastForwardGame, api.FastForwardGameRequest{
+		StatefulRoom: api.StatefulRoom{Id: id, Rid: w.RoomId},
+		Active:       active,
+	})
+}
+
+func (w *Worker) RewindGame(id string, active bool) {
+	w.Notify(api.RewindGame, api.RewindGameRequest{
+		StatefulRoom: api.StatefulRoom{Id: id, Rid: w.RoomId},
+		Active:       active,
+	})
+}
+
+func (w *Worker) RecordGame(id string, rec bool, recUser string) (*api.RecordGameResponse, error) {
+	return api.UnwrapChecked[api.RecordGameResponse](
+		w.Send(api.RecordGame, api.RecordGameRequest{
+			StatefulRoom: api.StatefulRoom{Id: id, Rid: w.RoomId},
+			Active:       rec,
+			User:         recUser,
+		}))
+}
+
+func (w *Worker) TerminateSession(id string) {
+	_, _ = w.Send(api.TerminateSession, api.TerminateSessionRequest{Id: id})
+}
