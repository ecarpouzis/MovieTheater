diff --git a/pkg/worker/caged/libretro/recording.go b/pkg/worker/caged/libretro/recording.go
index eb84d6e..be09f97 100644
--- a/pkg/worker/caged/libretro/recording.go
+++ b/pkg/worker/caged/libretro/recording.go
@@ -45,8 +45,21 @@ func (r *RecordingFrontend) SetAudioCb(fn func(app.Audio)) {
 
 func (r *RecordingFrontend) SetVideoCb(fn func(app.Video)) {
 	r.Emulator.SetVideoCb(func(v app.Video) {
-		if r.IsRecording() {
-			r.rec.WriteVideo(recorder.Video{Frame: recorder.Frame(v.Frame), Duration: time.Duration(v.Duration)})
+		// v.Frame.Tex != 0 means GL zero-copy: the frame is a texture and Data is nil, so there is
+		// nothing for the recorder to write. Recording and GL zero-copy are mutually exclusive by
+		// nature (the recorder wants system memory, the whole point here is never to produce it) —
+		// skip rather than write empty frames. Field-by-field, not a struct conversion: a plain
+		// recorder.Frame(v.Frame) breaks the moment either struct gains a field.
+		if r.IsRecording() && v.Frame.Data != nil {
+			r.rec.WriteVideo(recorder.Video{
+				Frame: recorder.Frame{
+					Data:   v.Frame.Data,
+					Stride: v.Frame.Stride,
+					W:      v.Frame.W,
+					H:      v.Frame.H,
+				},
+				Duration: time.Duration(v.Duration),
+			})
 		}
 		fn(v)
 	})
diff --git a/pkg/worker/cheevos/bridge.c b/pkg/worker/cheevos/bridge.c
new file mode 100644
index 0000000..f12f96c
--- /dev/null
+++ b/pkg/worker/cheevos/bridge.c
@@ -0,0 +1,213 @@
+/* bridge.c — see bridge.h. Adapts rcheevos' rc_client to the worker: memory reads come from the
+ * loaded core's RAM via rc_libretro's console mapping; server calls and events cross into Go. */
+#include "bridge.h"
+#include "_cgo_export.h"
+
+#include <string.h>
+
+#include "rc_libretro.h"
+#include "rc_hash.h"
+#include "rc_error.h"
+
+/* libretro RETRO_MEMORY ids (from libretro.h) — declared here so this TU needn't pull the whole header. */
+#define CHEEVOS_MEMORY_SAVE_RAM   0
+#define CHEEVOS_MEMORY_SYSTEM_RAM 2
+
+/* One room per worker, so a single set of module-level memory regions is correct. Rebuilt on each load. */
+static uint8_t *g_system_ram = NULL;
+static size_t g_system_ram_size = 0;
+static uint8_t *g_save_ram = NULL;
+static size_t g_save_ram_size = 0;
+static rc_libretro_memory_regions_t g_regions;
+
+/* rc_libretro asks us for a core memory region by libretro id; answer from what cheevos_set_memory stored. */
+static void cheevos_core_memory_info(uint32_t id, rc_libretro_core_memory_info_t *info) {
+  switch (id) {
+    case CHEEVOS_MEMORY_SYSTEM_RAM:
+      info->data = g_system_ram;
+      info->size = g_system_ram_size;
+      break;
+    case CHEEVOS_MEMORY_SAVE_RAM:
+      info->data = g_save_ram;
+      info->size = g_save_ram_size;
+      break;
+    default:
+      info->data = NULL;
+      info->size = 0;
+      break;
+  }
+}
+
+/* rc_client's per-address memory read — pure C (no cgo callback) so the hot per-frame trigger checks
+ * never cross into Go. Reads zero until cheevos_init_memory has built g_regions. */
+static uint32_t cheevos_read_memory(uint32_t address, uint8_t *buffer, uint32_t num_bytes, rc_client_t *client) {
+  (void)client;
+  return rc_libretro_memory_read(&g_regions, address, buffer, num_bytes);
+}
+
+/* rc_client needs an HTTP request performed. We hand it to Go (net/http) with the opaque callback
+ * pointers; Go returns the response later, on the emu goroutine, via cheevos_deliver_response. */
+static void cheevos_server_call(const rc_api_request_t *request, rc_client_server_callback_t callback,
+                                void *callback_data, rc_client_t *client) {
+  goServerCall((uintptr_t)client,
+               (char *)request->url,
+               (char *)(request->post_data ? request->post_data : ""),
+               (char *)(request->content_type ? request->content_type : ""),
+               (void *)callback, callback_data);
+}
+
+void cheevos_deliver_response(void *callback, void *callback_data, int status, const char *body, size_t body_len) {
+  rc_api_server_response_t response;
+  memset(&response, 0, sizeof(response));
+  response.body = body;
+  response.body_length = body_len;
+  response.http_status_code = status;
+  ((rc_client_server_callback_t)callback)(&response, callback_data);
+}
+
+/* rc_client raises everything through this one handler; we forward the two kinds the site mirrors. */
+static void cheevos_event_handler(const rc_client_event_t *event, rc_client_t *client) {
+  switch (event->type) {
+    case RC_CLIENT_EVENT_ACHIEVEMENT_TRIGGERED: {
+      const rc_client_achievement_t *a = event->achievement;
+      if (a) {
+        goAchievementUnlocked((uintptr_t)client, a->id,
+                              (char *)(a->title ? a->title : ""),
+                              (char *)(a->description ? a->description : ""),
+                              a->points);
+      }
+      break;
+    }
+    case RC_CLIENT_EVENT_LEADERBOARD_SUBMITTED: {
+      const rc_client_leaderboard_t *l = event->leaderboard;
+      if (l) {
+        goLeaderboardSubmitted((uintptr_t)client, l->id,
+                               (char *)(l->title ? l->title : ""),
+                               (int)l->format, (int)l->lower_is_better,
+                               (char *)(l->tracker_value ? l->tracker_value : ""));
+      }
+      break;
+    }
+    default:
+      /* challenge indicators, trackers, rich presence, reset, disconnect, etc. — not mirrored in v1. */
+      break;
+  }
+}
+
+static void cheevos_log(const char *message, const rc_client_t *client) {
+  goCheevosLog((uintptr_t)client, (char *)(message ? message : ""));
+}
+
+static void cheevos_login_callback(int result, const char *error_message, rc_client_t *client, void *userdata) {
+  (void)userdata;
+  goLoginResult((uintptr_t)client, result, (char *)(error_message ? error_message : ""));
+}
+
+static void cheevos_load_callback(int result, const char *error_message, rc_client_t *client, void *userdata) {
+  (void)userdata;
+  goLoadResult((uintptr_t)client, result, (char *)(error_message ? error_message : ""));
+}
+
+rc_client_t *cheevos_create(void) {
+  rc_client_t *client = rc_client_create(cheevos_read_memory, cheevos_server_call);
+  if (!client)
+    return NULL;
+  rc_client_enable_logging(client, RC_CLIENT_LOG_LEVEL_WARN, cheevos_log);
+  rc_client_set_event_handler(client, cheevos_event_handler);
+  memset(&g_regions, 0, sizeof(g_regions));
+  return client;
+}
+
+void cheevos_destroy(rc_client_t *client) {
+  if (client)
+    rc_client_destroy(client);
+  rc_libretro_memory_destroy(&g_regions);
+  g_system_ram = NULL;
+  g_system_ram_size = 0;
+  g_save_ram = NULL;
+  g_save_ram_size = 0;
+}
+
+void cheevos_set_hardcore(rc_client_t *client, int enabled) {
+  rc_client_set_hardcore_enabled(client, enabled);
+}
+
+void cheevos_set_spectator(rc_client_t *client, int enabled) {
+  rc_client_set_spectator_mode_enabled(client, enabled);
+}
+
+void cheevos_set_memory(void *system_ram, size_t system_ram_size, void *save_ram, size_t save_ram_size) {
+  g_system_ram = (uint8_t *)system_ram;
+  g_system_ram_size = system_ram_size;
+  g_save_ram = (uint8_t *)save_ram;
+  g_save_ram_size = save_ram_size;
+}
+
+int cheevos_init_memory(uint32_t console_id, const struct retro_memory_map *mmap) {
+  rc_libretro_memory_destroy(&g_regions);
+  /* Prefer the core's memory map when present (maps RA addresses precisely); NULL falls back to the
+   * console layout over SYSTEM_RAM/SAVE_RAM. */
+  return rc_libretro_memory_init(&g_regions, mmap, cheevos_core_memory_info, console_id);
+}
+
+void cheevos_hash_init(void) {
+  rc_hash_init_custom_filereader(NULL); /* NULL => install the built-in stdio (wide-path on Windows) reader */
+  rc_hash_init_default_cdreader();
+}
+
+int cheevos_hash_file(char *out33, uint32_t console_id, const char *path) {
+  out33[0] = '\0';
+  /* rc_hash_generate_from_file is marked deprecated in favour of the iterator API, but it is the exact
+   * call rc_client_begin_load_game makes for a known console id, and "identical to what identifies the
+   * game at play time" is the property we need here. */
+  return rc_hash_generate_from_file(out33, console_id, path) ? 1 : 0;
+}
+
+int cheevos_hash_buffer(char *out33, uint32_t console_id, const uint8_t *data, size_t size) {
+  out33[0] = '\0';
+  return rc_hash_generate_from_buffer(out33, console_id, data, size) ? 1 : 0;
+}
+
+/* ── Virtual filereader (see bridge.h). Each callback is a thin hop into Go, which owns the handle
+ * table and the block decoders. rc_hash reads a few MB per disc, so the cgo crossings are not hot. */
+static void *mt_vfs_open(const char *path_utf8) {
+  uintptr_t h = goVfsOpen((char *)path_utf8);
+  return h ? (void *)h : NULL; /* NULL tells rc_hash the file could not be opened */
+}
+static void mt_vfs_seek(void *fh, int64_t offset, int origin) { goVfsSeek((uintptr_t)fh, offset, origin); }
+static int64_t mt_vfs_tell(void *fh) { return goVfsTell((uintptr_t)fh); }
+static size_t mt_vfs_read(void *fh, void *buffer, size_t requested) {
+  return goVfsRead((uintptr_t)fh, buffer, requested);
+}
+static void mt_vfs_close(void *fh) { goVfsClose((uintptr_t)fh); }
+
+void cheevos_install_virtual_filereader(void) {
+  static struct rc_hash_filereader reader;
+  reader.open = mt_vfs_open;
+  reader.seek = mt_vfs_seek;
+  reader.tell = mt_vfs_tell;
+  reader.read = mt_vfs_read;
+  reader.close = mt_vfs_close;
+  rc_hash_init_custom_filereader(&reader);
+}
+
+void cheevos_begin_login(rc_client_t *client, const char *username, const char *token) {
+  rc_client_begin_login_with_token(client, username, token, cheevos_login_callback, NULL);
+}
+
+void cheevos_begin_load(rc_client_t *client, uint32_t console_id, const char *file_path) {
+  rc_client_begin_identify_and_load_game(client, console_id, file_path, NULL, 0, cheevos_load_callback, NULL);
+}
+
+void cheevos_begin_load_hash(rc_client_t *client, const char *hash) {
+  /* The site already knows this dump's hash, so skip identification entirely. This is not merely an
+   * optimisation: rc_hash cannot READ several of the container formats our library stores (.chd, .gcz,
+   * .cso), so identify-and-load fails with "Unknown game" on Dreamcast, Saturn, GameCube, PS2 and PSP no
+   * matter how healthy the rest of the RA session is. A hash computed offline sidesteps the reader
+   * entirely — the console id is not needed either, because a hash already names one exact game. */
+  rc_client_begin_load_game(client, hash, cheevos_load_callback, NULL);
+}
+
+void cheevos_do_frame(rc_client_t *client) {
+  rc_client_do_frame(client);
+}
diff --git a/pkg/worker/cheevos/bridge.h b/pkg/worker/cheevos/bridge.h
new file mode 100644
index 0000000..1b95f4d
--- /dev/null
+++ b/pkg/worker/cheevos/bridge.h
@@ -0,0 +1,93 @@
+/* bridge.h — the C surface the Go cheevos package calls, and the glue that adapts rcheevos'
+ * rc_client to our worker. rc_client is the RetroAchievements runtime: it hashes the loaded ROM,
+ * logs the player in with their own connect token, evaluates achievement/leaderboard triggers each
+ * frame against emulator RAM, and submits unlocks/runs to retroachievements.org itself. We only
+ * MIRROR the resulting events for the site; RA remains the source of truth.
+ *
+ * Threading contract (load-bearing): rc_client is NOT thread-safe. Every rc_client_* call — create,
+ * login, load, do_frame, and the delivery of async server responses — happens on ONE goroutine (the
+ * emulator loop that calls Frontend.Tick). HTTP runs on background goroutines but their responses are
+ * handed back to that one goroutine via cheevos_deliver_response inside DoFrame. See cheevos.go.
+ */
+#ifndef CHEEVOS_BRIDGE_H
+#define CHEEVOS_BRIDGE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "rc_client.h"
+
+/* Create an rc_client wired to our memory-read + server-call glue, with the event handler and logging
+ * installed. Returns NULL on allocation failure. */
+rc_client_t *cheevos_create(void);
+void cheevos_destroy(rc_client_t *client);
+
+/* Hardcore = competitive. Must be set before load; enabling it mid-session resets the runtime. We run
+ * the site engine hardcore-ON always (so leaderboards activate in every room); it is decoupled from our
+ * OWN "competitive" tag, which lives on the mirrored event, not here. */
+void cheevos_set_hardcore(rc_client_t *client, int enabled);
+
+/* Spectator mode: evaluate achievements/leaderboards locally and RAISE the events, but NEVER submit to
+ * retroachievements.org. This is what lets ONE site service account power the whole friend group's
+ * scores/times/achievements without earning anything on RA. Set before load. */
+void cheevos_set_spectator(rc_client_t *client, int enabled);
+
+/* Register the emulator's memory regions for the read handler. Call after the core has loaded its game
+ * (retro_get_memory_data pointers are valid then) and BEFORE cheevos_init_memory. */
+void cheevos_set_memory(void *system_ram, size_t system_ram_size, void *save_ram, size_t save_ram_size);
+
+/* Build the RetroAchievements address->region mapping for a console. Returns non-zero if any valid
+ * region was found. When the core provided a memory map (mmap != NULL, from SET_MEMORY_MAPS) rc_libretro
+ * maps RA addresses through it precisely; otherwise it falls back to the console layout over
+ * SYSTEM_RAM/SAVE_RAM. The map is REQUIRED for systems whose RA addresses aren't a flat SYSTEM_RAM
+ * offset (e.g. Genesis high work-RAM), or their achievements get disabled as "invalid address". */
+struct retro_memory_map; /* forward decl — only ever used by pointer here */
+int cheevos_init_memory(uint32_t console_id, const struct retro_memory_map *mmap);
+
+/* Install rcheevos' default file + CD readers so ROM/disc hashing works from a path. Call once. */
+void cheevos_hash_init(void);
+
+/* Swap in a filereader backed by Go, so rc_hash can read COMPRESSED disc containers (.cso/.zso PS2+PSP,
+ * .gcz GameCube) that its built-in reader cannot open at all. Everything else passes through to the OS
+ * unchanged. Reads are served on demand from the block index rather than by materialising the image,
+ * which is what makes hashing thousands of multi-GB discs practical. Call after cheevos_hash_init. */
+void cheevos_install_virtual_filereader(void);
+
+/* Compute the RetroAchievements hash of a ROM/disc at `path` for `console_id`, writing 32 hex chars +
+ * NUL into out33. Returns 1 on success, 0 if the file could not be hashed for that console.
+ *
+ * This is the SAME algorithm rc_client runs when it identifies a loaded game, which is the whole point:
+ * RA maps a game by CONTENT, never by title, and the per-console rules are not something to reimplement
+ * (N64 byte-order normalisation, SNES/NES header skipping, disc-based consoles hashing an executable
+ * rather than the image, zip member selection). Call cheevos_hash_init() once first so the file/CD
+ * readers are installed. No rc_client involved, so this is safe to call off the emulator goroutine. */
+int cheevos_hash_file(char *out33, uint32_t console_id, const char *path);
+
+/* Same, but over a buffer already in memory — used for a ROM extracted from an archive. A console ROM
+ * inside a .zip MUST be hashed this way: rc_hash applied to the .zip path hashes the CONTAINER, which
+ * succeeds and returns a perfectly well-formed hash that matches nothing on RetroAchievements. (The
+ * exception is arcade/MAME, where the zip IS the ROM and the path form is correct.) */
+int cheevos_hash_buffer(char *out33, uint32_t console_id, const uint8_t *data, size_t size);
+
+/* Kick the async login with the player's RA username + connect token. Result arrives via goLoginResult. */
+void cheevos_begin_login(rc_client_t *client, const char *username, const char *token);
+
+/* Kick the async game identify+load from a ROM/disc PATH. console_id may be 0 (RC_CONSOLE_UNKNOWN) to let
+ * rcheevos identify it. Result arrives via goLoadResult. */
+void cheevos_begin_load(rc_client_t *client, uint32_t console_id, const char *file_path);
+
+/* Load a game by a KNOWN RetroAchievements hash, skipping identification. The site computes hashes
+ * offline (ArcadeGame.RaHash) with readers rc_hash does not have, so this is the only path that works
+ * for .chd/.gcz/.cso dumps -- and it is strictly better for every other dump too: no file is reopened
+ * or re-read at boot. Result arrives via goLoadResult, same as cheevos_begin_load. */
+void cheevos_begin_load_hash(rc_client_t *client, const char *hash);
+
+/* Advance the runtime one frame (reads memory, fires triggers). Called once per emulated frame. */
+void cheevos_do_frame(rc_client_t *client);
+
+/* Deliver a completed HTTP response to the rc_client callback that requested it. Called ONLY on the
+ * emu goroutine, from DoFrame, after the background HTTP goroutine finished. callback/callback_data are
+ * the opaque pointers rc_client handed to our server-call glue. */
+void cheevos_deliver_response(void *callback, void *callback_data, int status, const char *body, size_t body_len);
+
+#endif /* CHEEVOS_BRIDGE_H */
diff --git a/pkg/worker/cheevos/cheevos.go b/pkg/worker/cheevos/cheevos.go
new file mode 100644
index 0000000..a71ce10
--- /dev/null
+++ b/pkg/worker/cheevos/cheevos.go
@@ -0,0 +1,640 @@
+// Package cheevos embeds the RetroAchievements runtime (rcheevos' rc_client) into the libretro worker.
+// rc_client hashes the loaded ROM, logs the player in with their OWN connect token, evaluates
+// achievement + leaderboard triggers each emulated frame against core RAM, and submits unlocks/runs to
+// retroachievements.org itself — RA stays the source of truth. This package only surfaces the resulting
+// events so the site can mirror them (friends boards, profile, in-room toast) under the room creator's
+// account (a room is one emulator, so RA runs as the creator).
+//
+// THREADING: rc_client is not thread-safe. Every rc_client_* call and every async server-response
+// delivery happens on ONE goroutine — the emulator loop that calls DoFrame. HTTP runs on background
+// goroutines, but their results are handed back through respCh and delivered inside DoFrame. Do not call
+// New/DoFrame/Close from different goroutines.
+package cheevos
+
+/*
+#cgo CFLAGS: -I${SRCDIR} -I${SRCDIR}/rcheevos/include -I${SRCDIR}/rcheevos/src -I${SRCDIR}/rcheevos/src/rcheevos -I${SRCDIR}/rcheevos/src/rhash -I${SRCDIR}/rcheevos/src/rapi -I${SRCDIR}/../caged/libretro/nanoarch -DRC_CLIENT_SUPPORTS_HASH
+#include <stdlib.h>
+#include "bridge.h"
+*/
+import "C"
+
+import (
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+	"unsafe"
+)
+
+// raUserAgent identifies us to RetroAchievements. Their dorequest API rejects requests with a missing
+// or generic User-Agent (403), so this must be sent on every RA HTTP call. Format: "Client/Version".
+const raUserAgent = "MovieTheaterArcade/1.0"
+
+// Achievement is one unlocked RetroAchievements achievement (the mirror + toast payload).
+//
+// Hardcore is the room's COMPETITIVE flag (our own legit-run tag), unchanged from before. Cheat /
+// Savescum / Timeplay are the per-event RUN-LEGITIMACY taints sampled at unlock time — they say WHY a
+// run wasn't a clean one (cheat codes active, a save-STATE was loaded mid-run, or fast-forward/rewind
+// was used). The site derives "legit" as Hardcore && !Cheat && !Savescum && !Timeplay and shows a
+// why-icon for each taint. See LegitState.
+type Achievement struct {
+	ID          uint32
+	Title       string
+	Description string
+	Points      uint32
+	Hardcore    bool
+	Cheat       bool
+	Savescum    bool
+	Timeplay    bool
+}
+
+// Leaderboard is one submitted leaderboard run. Format is normalized to a token the site understands
+// (SCORE / VALUE — higher is better; CENTISECS — a time board, lower is better), and RawValue is the
+// numeric compared for ranking. Cheat/Savescum/Timeplay mirror Achievement's run-legitimacy taints.
+type Leaderboard struct {
+	ID            uint32
+	Title         string
+	Format        string
+	RawValue      int64
+	LowerIsBetter bool
+	Hardcore      bool
+	Cheat         bool
+	Savescum      bool
+	Timeplay      bool
+}
+
+// LegitState is the run-legitimacy taint sampled when an event fires. Cheat is room-static (cheat codes
+// were staged at room create); Savescum flips when a save-STATE is loaded mid-run and clears on a hard
+// reset (mirrors RA's own "loading a state drops you out of hardcore until reset" rule); Timeplay flips
+// when fast-forward/rewind is used. All three read on the emulator goroutine at event time but are
+// written from the coordinator's command goroutine (HandleLoadGame / HandleResetGame), so they are
+// atomics — never call into rc_client from those setters, only flip a flag.
+type LegitState struct {
+	cheat    atomic.Bool
+	savescum atomic.Bool
+	timeplay atomic.Bool
+}
+
+// Handlers receive events on the emulator goroutine. Keep them cheap or hand off (the mirror POSTs
+// should be async) — they run inline with emulation.
+type Handlers struct {
+	OnAchievement func(Achievement)
+	OnLeaderboard func(Leaderboard)
+	OnLog         func(string) // rcheevos warnings + our own state transitions
+}
+
+type serverResp struct {
+	callback unsafe.Pointer
+	cbData   unsafe.Pointer
+	status   int
+	body     []byte
+}
+
+// Client is one RetroAchievements session bound to one room's emulator.
+type Client struct {
+	ptr       unsafe.Pointer // rc_client_t*
+	key       uintptr        // == ptr, the registry key the C callbacks pass back
+	hardcore  bool
+	consoleID uint32
+	memoryMap unsafe.Pointer // const struct retro_memory_map* from SET_MEMORY_MAPS; nil = core set none
+	romPath   string
+	// knownHash: the RetroAchievements hash the SITE computed for this dump (ArcadeGame.RaHash).
+	// Non-empty means beginLoad skips identification entirely — see SetKnownHash.
+	knownHash string
+	user      string
+	token     string
+	handlers  Handlers
+	httpc     *http.Client
+	respCh    chan serverResp
+	legit     LegitState // per-run taint (cheat/savescum/timeplay), sampled on each event
+	started   bool
+	closed    bool
+	mu        sync.Mutex
+}
+
+var (
+	reg   = map[uintptr]*Client{}
+	regMu sync.RWMutex
+	// hashInit installs rcheevos' file/CD readers exactly once for the process.
+	hashOnce sync.Once
+)
+
+func lookup(key uintptr) *Client {
+	regMu.RLock()
+	defer regMu.RUnlock()
+	return reg[key]
+}
+
+// New creates a session driven by the SITE service account. Returns nil if no account is configured
+// (RA off) or rc_client can't be created. Call SetMemory once the core has loaded its game, then
+// DoFrame each frame and Close on teardown — all on the emulator goroutine.
+//
+// The engine runs in SPECTATOR mode (evaluate + raise events, never submit to RA) and HARDCORE-on
+// (RA only activates leaderboards in hardcore; since we never submit, this is what makes scores/times
+// record in EVERY room). `competitive` is our OWN legit-run tag (no save-scumming) — it rides the
+// mirrored events, decoupled from rc_client's always-on hardcore.
+//
+// `cheats` is true when the room staged cheat codes (known at room create); it seeds the per-run Cheat
+// taint so every event this session reports it (competitive rooms take no cheats, so this is a
+// casual-room signal). See LegitState for savescum/timeplay, flipped at runtime.
+func New(user, token string, competitive, cheats bool, consoleID uint32, romPath string, h Handlers) *Client {
+	if user == "" || token == "" {
+		return nil
+	}
+	hashOnce.Do(hashInit)
+
+	ptr := C.cheevos_create()
+	if ptr == nil {
+		return nil
+	}
+	c := &Client{
+		ptr:       unsafe.Pointer(ptr),
+		key:       uintptr(unsafe.Pointer(ptr)),
+		hardcore:  competitive, // the value REPORTED on events (our legit tag), not rc_client's mode
+		consoleID: consoleID,
+		romPath:   romPath,
+		user:      user,
+		token:     token,
+		handlers:  h,
+		httpc:     &http.Client{Timeout: 20 * time.Second},
+		respCh:    make(chan serverResp, 64),
+	}
+	c.legit.cheat.Store(cheats)
+	regMu.Lock()
+	reg[c.key] = c
+	regMu.Unlock()
+	// Never submit to RA; always activate leaderboards. Both set before load.
+	C.cheevos_set_spectator(ptr, 1)
+	C.cheevos_set_hardcore(ptr, 1)
+	return c
+}
+
+// NotifySaveStateLoaded marks the run as save-scummed — a save-STATE was restored mid-session (the
+// player pressed Load), so every subsequent unlock/leaderboard this session carries the Savescum taint
+// until a hard reset. Cheap flag flip; safe to call from the coordinator command goroutine.
+func (c *Client) NotifySaveStateLoaded() {
+	if c == nil {
+		return
+	}
+	c.legit.savescum.Store(true)
+	c.state("RetroAchievements: save-state loaded — run tagged save-scummed until reset")
+}
+
+// NotifyFastForward marks the run as time-manipulated when fast-forward (or rewind) is engaged. Sticky
+// until a hard reset, like Savescum. Called from the t=114/115 handlers (HandleFastForwardGame/
+// HandleRewindGame) whenever a player engages either control.
+func (c *Client) NotifyFastForward(on bool) {
+	if c == nil || !on {
+		return
+	}
+	c.legit.timeplay.Store(true)
+}
+
+// NotifyReset clears the mid-run taints (savescum/timeplay) on a hard reset — RA restores hardcore
+// eligibility on a reset, so a clean run started after a reset is legit again. The Cheat taint stays:
+// cheat codes are staged for the whole room and a reset does not remove them.
+func (c *Client) NotifyReset() {
+	if c == nil {
+		return
+	}
+	c.legit.savescum.Store(false)
+	c.legit.timeplay.Store(false)
+}
+
+func (c *Client) legitSnapshot() (cheat, savescum, timeplay bool) {
+	return c.legit.cheat.Load(), c.legit.savescum.Load(), c.legit.timeplay.Load()
+}
+
+// SetMemory registers the core's RAM regions for the trigger reader. Call after the game has loaded
+// (retro_get_memory_data pointers are valid then) and before the first DoFrame. memoryMap is the core's
+// retro_memory_map from SET_MEMORY_MAPS (nil if the core set none) — RA uses it to resolve addresses
+// that aren't a flat SYSTEM_RAM offset (e.g. Genesis high work-RAM); without it those triggers get
+// disabled as "invalid address".
+func (c *Client) SetMemory(systemRAM unsafe.Pointer, systemSize uintptr, saveRAM unsafe.Pointer, saveSize uintptr, memoryMap unsafe.Pointer) {
+	if c == nil {
+		return
+	}
+	c.memoryMap = memoryMap
+	C.cheevos_set_memory(systemRAM, C.size_t(systemSize), saveRAM, C.size_t(saveSize))
+}
+
+// InitMemory builds the rc_libretro address→region map from the console layout + the core RAM/map
+// registered by SetMemory. This MUST run before the game load, not after: rc_client validates every
+// achievement/leaderboard address during load by probing it through our read callback (see
+// rc_client_validate_addresses). If the regions aren't registered yet, every probe reads 0 and rcheevos
+// disables the whole set as "Invalid address" — which is exactly what happened when we only built the
+// regions in the load-done callback. Returns false if no valid region was mapped. Emu goroutine only.
+func (c *Client) InitMemory() bool {
+	if c == nil {
+		return false
+	}
+	return C.cheevos_init_memory(C.uint32_t(c.consoleID), (*C.struct_retro_memory_map)(c.memoryMap)) != 0
+}
+
+// DoFrame advances the runtime one frame. On the first call it kicks the login→load sequence; every
+// call drains any completed HTTP responses (delivered here so rc_client stays single-threaded) and
+// steps the trigger evaluation.
+func (c *Client) DoFrame() {
+	if c == nil {
+		return
+	}
+	if !c.started {
+		c.started = true
+		c.beginLogin()
+	}
+	for {
+		select {
+		case r := <-c.respCh:
+			var body *C.char
+			if len(r.body) > 0 {
+				body = (*C.char)(C.CBytes(r.body))
+			}
+			C.cheevos_deliver_response(r.callback, r.cbData, C.int(r.status), body, C.size_t(len(r.body)))
+			if body != nil {
+				C.free(unsafe.Pointer(body))
+			}
+		default:
+			C.cheevos_do_frame((*C.rc_client_t)(c.ptr))
+			return
+		}
+	}
+}
+
+// Close destroys the session. Call on the emulator goroutine after the frame loop has stopped.
+func (c *Client) Close() {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	if c.closed {
+		c.mu.Unlock()
+		return
+	}
+	c.closed = true
+	c.mu.Unlock()
+
+	regMu.Lock()
+	delete(reg, c.key)
+	regMu.Unlock()
+
+	C.cheevos_destroy((*C.rc_client_t)(c.ptr))
+	c.ptr = nil
+}
+
+func (c *Client) beginLogin() {
+	cu := C.CString(c.user)
+	ct := C.CString(c.token)
+	defer C.free(unsafe.Pointer(cu))
+	defer C.free(unsafe.Pointer(ct))
+	c.state("RetroAchievements: logging in as " + c.user)
+	C.cheevos_begin_login((*C.rc_client_t)(c.ptr), cu, ct)
+}
+
+func (c *Client) beginLoad() {
+	// A hash the site already computed wins over identifying the file ourselves. rc_hash cannot read
+	// .chd/.gcz/.cso, so for Dreamcast/Saturn/GameCube/PS2/PSP this is the difference between a tracked
+	// room and "Unknown game"; everywhere else it just saves reopening the ROM at boot.
+	if c.knownHash != "" {
+		ch := C.CString(c.knownHash)
+		defer C.free(unsafe.Pointer(ch))
+		c.state("RetroAchievements: loading by known hash " + c.knownHash)
+		C.cheevos_begin_load_hash((*C.rc_client_t)(c.ptr), ch)
+		return
+	}
+	cp := C.CString(c.romPath)
+	defer C.free(unsafe.Pointer(cp))
+	C.cheevos_begin_load((*C.rc_client_t)(c.ptr), C.uint32_t(c.consoleID), cp)
+}
+
+// SetKnownHash supplies the RetroAchievements hash the site computed for this dump. Must be called
+// before the first DoFrame (which is what kicks login -> load). Empty = identify from the file.
+func (c *Client) SetKnownHash(h string) {
+	if c != nil {
+		c.knownHash = h
+	}
+}
+
+func (c *Client) state(msg string) {
+	if c.handlers.OnLog != nil {
+		c.handlers.OnLog(msg)
+	}
+}
+
+func (c *Client) httpDo(url, post, ctype string) (int, []byte) {
+	var (
+		req *http.Request
+		err error
+	)
+	if post == "" {
+		req, err = http.NewRequest(http.MethodGet, url, nil)
+	} else {
+		req, err = http.NewRequest(http.MethodPost, url, strings.NewReader(post))
+		if err == nil && ctype != "" {
+			req.Header.Set("Content-Type", ctype)
+		}
+	}
+	if err != nil {
+		return 0, nil
+	}
+	// RetroAchievements' dorequest API 403s any request without an identifying User-Agent (Go's default
+	// "Go-http-client/1.1" is rejected) — so every RA call MUST set one, or login + game-data fetch fail.
+	req.Header.Set("User-Agent", raUserAgent)
+	resp, err := c.httpc.Do(req)
+	if err != nil {
+		return 0, nil
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(resp.Body)
+	return resp.StatusCode, body
+}
+
+func boolToC(b bool) C.int {
+	if b {
+		return 1
+	}
+	return 0
+}
+
+// hashInitOnce guards the one-time install of rcheevos' file + CD readers. HashFile needs them, and a
+// worker that never opens an RA room would otherwise never have called it.
+var hashInitOnce sync.Once
+
+// hashInit installs the default readers and then REPLACES the filereader with ours, so compressed
+// disc containers (.cso/.zso/.gcz) become readable. Order matters: cheevos_hash_init installs the
+// built-in filereader, so the swap has to follow it.
+func hashInit() {
+	C.cheevos_hash_init()
+	C.cheevos_install_virtual_filereader()
+}
+
+// HashFile computes the RetroAchievements hash of a ROM/disc for a console — the SAME identification
+// rc_client performs when it loads a game, which is why it is the only correct way to map one of our
+// dumps to an RA game. Returns ("", false) when the file cannot be hashed for that console (wrong
+// format, unreadable, or a console whose rules do not apply).
+//
+// consoleID may be 0 (RC_CONSOLE_UNKNOWN); rcheevos then picks its rules from the file's extension and
+// contents. Prefer passing the real id when it is known — it is what the room will use.
+//
+// No rc_client is involved, so unlike everything else in this package this is safe to call from any
+// goroutine (and from a plain CLI with no emulator at all — see cmd/rahash).
+func HashFile(consoleID uint32, path string) (string, bool) {
+	hashInitOnce.Do(hashInit)
+	cPath := C.CString(path)
+	defer C.free(unsafe.Pointer(cPath))
+	var out [33]C.char
+	if C.cheevos_hash_file(&out[0], C.uint32_t(consoleID), cPath) == 0 {
+		return "", false
+	}
+	return C.GoString(&out[0]), true
+}
+
+// HashBuffer is HashFile over bytes already in memory — for a ROM read out of an archive.
+//
+// ⚠ A console ROM inside a .zip MUST come through here, not HashFile. rc_hash given the .zip PATH
+// hashes the container: it succeeds, returns a well-formed 32-hex hash, and matches nothing at all on
+// RetroAchievements. That silent-wrong-answer is the whole reason this exists — a sweep of ~10,000
+// zipped dumps reported "hashed, 0 unhashable" and produced 0 matches. (arcade/MAME is the exception:
+// there the zip IS the ROM and HashFile is correct.)
+func HashBuffer(consoleID uint32, data []byte) (string, bool) {
+	hashInitOnce.Do(hashInit)
+	if len(data) == 0 {
+		return "", false
+	}
+	var out [33]C.char
+	// Passing a Go pointer into C is allowed here: the bytes contain no Go pointers and C does not
+	// retain them beyond this synchronous call.
+	if C.cheevos_hash_buffer(&out[0], C.uint32_t(consoleID), (*C.uint8_t)(unsafe.Pointer(&data[0])), C.size_t(len(data))) == 0 {
+		return "", false
+	}
+	return C.GoString(&out[0]), true
+}
+
+// ConsoleID maps an arcade system code to the RetroAchievements console id. 0 (RC_CONSOLE_UNKNOWN) lets
+// rc_client identify the console from the ROM hash — a safe default for anything not mapped here.
+func ConsoleID(system string) uint32 {
+	switch strings.ToLower(system) {
+	case "genesis", "megadrive", "md":
+		return 1 // RC_CONSOLE_MEGA_DRIVE
+	case "n64":
+		return 2 // RC_CONSOLE_NINTENDO_64
+	case "snes":
+		return 3 // RC_CONSOLE_SUPER_NINTENDO
+	case "gb":
+		return 4 // RC_CONSOLE_GAMEBOY
+	case "gba":
+		return 5 // RC_CONSOLE_GAMEBOY_ADVANCE
+	case "gbc":
+		return 6 // RC_CONSOLE_GAMEBOY_COLOR
+	case "nes", "fds":
+		return 7 // RC_CONSOLE_NINTENDO
+	case "pce", "pcengine", "tg16":
+		return 8 // RC_CONSOLE_PC_ENGINE
+	case "sms", "mastersystem":
+		return 11 // RC_CONSOLE_MASTER_SYSTEM
+	case "ps1", "psx", "playstation":
+		return 12 // RC_CONSOLE_PLAYSTATION
+	// The disc/handheld systems below were missing, so their rooms passed RC_CONSOLE_UNKNOWN into both
+	// the hash and rc_libretro's memory mapping. Keep this in step with the site's ArcadeRaHasher.Console.
+	case "lynx":
+		return 13
+	case "ngp", "ngpc":
+		return 14
+	case "gg", "gamegear":
+		return 15
+	case "gc", "gamecube":
+		return 16
+	case "nds", "ds":
+		return 18
+	case "ps2":
+		return 21
+	case "a2600", "atari2600":
+		return 25
+	case "arcade", "fbneo", "mame", "neogeo":
+		return 27
+	case "vb", "virtualboy":
+		return 28
+	case "sg1000":
+		return 33
+	case "saturn":
+		return 39
+	case "dc", "dreamcast":
+		return 40
+	case "psp":
+		return 41
+	case "coleco", "colecovision":
+		return 44
+	case "a7800":
+		return 51
+	case "ws", "wsc", "wonderswan":
+		return 53
+	default:
+		return 0 // RC_CONSOLE_UNKNOWN — identify by hash
+	}
+}
+
+// parseLeaderboardValue turns rc_client's leaderboard format enum + formatted display string into a
+// (token, raw-numeric) pair the site can rank. rc_client formats: 0=TIME, 1=SCORE, 2=VALUE.
+//   - SCORE/VALUE: the display IS the integer (strip separators).
+//   - TIME: parse the display ("M:SS.cc" / "H:MM:SS.cc" / "SS.cc") into CENTISECONDS so the site's
+//     lower-is-better time ranking stays exact without guessing the core's raw unit.
+func parseLeaderboardValue(format int, display string) (token string, raw int64) {
+	display = strings.TrimSpace(display)
+	if format == 0 { // TIME
+		return "CENTISECS", parseTimeToCentis(display)
+	}
+	// SCORE (1) / VALUE (2): pull the leading signed integer out of the formatted string.
+	neg := strings.HasPrefix(display, "-")
+	var digits strings.Builder
+	for _, r := range display {
+		if r >= '0' && r <= '9' {
+			digits.WriteRune(r)
+		}
+	}
+	n, _ := strconv.ParseInt(digits.String(), 10, 64)
+	if neg {
+		n = -n
+	}
+	if format == 2 {
+		return "VALUE", n
+	}
+	return "SCORE", n
+}
+
+// parseTimeToCentis converts a colon/decimal time display to total centiseconds. Robust to the common
+// RA shapes; an unparseable exotic format degrades to 0 on OUR mirror only (RA's own board is authoritative).
+func parseTimeToCentis(s string) int64 {
+	if s == "" {
+		return 0
+	}
+	whole, frac := s, ""
+	if dot := strings.IndexByte(s, '.'); dot >= 0 {
+		whole, frac = s[:dot], s[dot+1:]
+	}
+	var total int64
+	for _, part := range strings.Split(whole, ":") {
+		n, _ := strconv.ParseInt(strings.TrimSpace(part), 10, 64)
+		total = total*60 + n
+	}
+	total *= 100 // seconds -> centiseconds
+	if frac != "" {
+		if len(frac) > 2 {
+			frac = frac[:2]
+		}
+		for len(frac) < 2 {
+			frac += "0"
+		}
+		cs, _ := strconv.ParseInt(frac, 10, 64)
+		total += cs
+	}
+	return total
+}
+
+// ─── Exported callbacks invoked by bridge.c (all on the emulator goroutine) ─────────────────────────
+
+//export goServerCall
+func goServerCall(key C.uintptr_t, curl, cpost, cctype *C.char, callback, cbData unsafe.Pointer) {
+	c := lookup(uintptr(key))
+	if c == nil {
+		return
+	}
+	url := C.GoString(curl)
+	post := C.GoString(cpost)
+	ctype := C.GoString(cctype)
+	go func() {
+		status, body := c.httpDo(url, post, ctype)
+		select {
+		case c.respCh <- serverResp{callback: callback, cbData: cbData, status: status, body: body}:
+		case <-time.After(30 * time.Second):
+		}
+	}()
+}
+
+//export goLoginResult
+func goLoginResult(key C.uintptr_t, result C.int, errmsg *C.char) {
+	c := lookup(uintptr(key))
+	if c == nil {
+		return
+	}
+	if result == 0 { // RC_OK
+		c.state("RetroAchievements: logged in")
+		c.beginLoad()
+		return
+	}
+	c.state("RetroAchievements login failed: " + C.GoString(errmsg))
+}
+
+//export goLoadResult
+func goLoadResult(key C.uintptr_t, result C.int, errmsg *C.char) {
+	c := lookup(uintptr(key))
+	if c == nil {
+		return
+	}
+	if result != 0 {
+		c.state("RetroAchievements: game not tracked (" + C.GoString(errmsg) + ")")
+		return
+	}
+	if C.cheevos_init_memory(C.uint32_t(c.consoleID), (*C.struct_retro_memory_map)(c.memoryMap)) == 0 {
+		c.state("RetroAchievements: no memory regions for this core — achievements will not fire")
+		return
+	}
+	c.state("RetroAchievements: game loaded, tracking active")
+}
+
+//export goAchievementUnlocked
+func goAchievementUnlocked(key C.uintptr_t, id C.uint32_t, title, desc *C.char, points C.uint32_t) {
+	c := lookup(uintptr(key))
+	if c == nil || c.handlers.OnAchievement == nil {
+		return
+	}
+	// Skip RA's 0-point WARNING pseudo-achievements ("Warning: Unknown Emulator" — our client isn't a
+	// registered RA emulator; "Unsupported Game Version" — a romhack/unmatched hash). RA serves these as
+	// achievement-triggered events on an unsupported session; real core achievements always carry points.
+	// Filtering here keeps them out of both the in-room toast and the site DB mirror.
+	if points == 0 {
+		return
+	}
+	cheat, savescum, timeplay := c.legitSnapshot()
+	c.handlers.OnAchievement(Achievement{
+		ID:          uint32(id),
+		Title:       C.GoString(title),
+		Description: C.GoString(desc),
+		Points:      uint32(points),
+		Hardcore:    c.hardcore,
+		Cheat:       cheat,
+		Savescum:    savescum,
+		Timeplay:    timeplay,
+	})
+}
+
+//export goLeaderboardSubmitted
+func goLeaderboardSubmitted(key C.uintptr_t, id C.uint32_t, title *C.char, format, lowerIsBetter C.int, value *C.char) {
+	c := lookup(uintptr(key))
+	if c == nil || c.handlers.OnLeaderboard == nil {
+		return
+	}
+	token, raw := parseLeaderboardValue(int(format), C.GoString(value))
+	cheat, savescum, timeplay := c.legitSnapshot()
+	c.handlers.OnLeaderboard(Leaderboard{
+		ID:            uint32(id),
+		Title:         C.GoString(title),
+		Format:        token,
+		RawValue:      raw,
+		LowerIsBetter: lowerIsBetter != 0,
+		Hardcore:      c.hardcore,
+		Cheat:         cheat,
+		Savescum:      savescum,
+		Timeplay:      timeplay,
+	})
+}
+
+//export goCheevosLog
+func goCheevosLog(key C.uintptr_t, msg *C.char) {
+	c := lookup(uintptr(key))
+	if c == nil || c.handlers.OnLog == nil {
+		return
+	}
+	c.handlers.OnLog("rcheevos: " + C.GoString(msg))
+}
diff --git a/pkg/worker/cheevos/parse_test.go b/pkg/worker/cheevos/parse_test.go
new file mode 100644
index 0000000..0bdc5b0
--- /dev/null
+++ b/pkg/worker/cheevos/parse_test.go
@@ -0,0 +1,45 @@
+package cheevos
+
+import "testing"
+
+func TestParseLeaderboardValue(t *testing.T) {
+	cases := []struct {
+		name      string
+		format    int
+		display   string
+		wantToken string
+		wantRaw   int64
+	}{
+		{"score plain", 1, "12300", "SCORE", 12300},
+		{"score grouped", 1, "1,234,567", "SCORE", 1234567},
+		{"value", 2, "42", "VALUE", 42},
+		{"value negative", 2, "-17", "VALUE", -17},
+		{"time m:ss.cc", 0, "1:23.45", "CENTISECS", 8345},
+		{"time h:mm:ss", 0, "1:02:03.00", "CENTISECS", 372300},
+		{"time ss.cc", 0, "9.99", "CENTISECS", 999},
+		{"time whole seconds", 0, "45", "CENTISECS", 4500},
+		{"time one-digit centis", 0, "1:00.5", "CENTISECS", 6050},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			token, raw := parseLeaderboardValue(c.format, c.display)
+			if token != c.wantToken || raw != c.wantRaw {
+				t.Fatalf("parseLeaderboardValue(%d, %q) = (%q, %d); want (%q, %d)",
+					c.format, c.display, token, raw, c.wantToken, c.wantRaw)
+			}
+		})
+	}
+}
+
+func TestConsoleID(t *testing.T) {
+	cases := map[string]uint32{
+		"nes": 7, "snes": 3, "gb": 4, "gbc": 6, "gba": 5,
+		"genesis": 1, "n64": 2, "ps1": 12, "psx": 12, "sms": 11,
+		"unknownsystem": 0, "3ds": 0,
+	}
+	for sys, want := range cases {
+		if got := ConsoleID(sys); got != want {
+			t.Errorf("ConsoleID(%q) = %d; want %d", sys, got, want)
+		}
+	}
+}
