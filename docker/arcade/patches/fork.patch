+
+static const char* rc_type_string(uint32_t type) {
+  switch (type) {
+    case RC_ACHIEVEMENT_TYPE_MISSABLE: return "missable";
+    case RC_ACHIEVEMENT_TYPE_PROGRESSION: return "progression";
+    case RC_ACHIEVEMENT_TYPE_WIN: return "win_condition";
+    default: return "";
+  }
+}
