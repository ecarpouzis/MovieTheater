diff --git a/pkg/network/webrtc/pacer.go b/pkg/network/webrtc/pacer.go
new file mode 100644
index 0000000..4f15d8f
--- /dev/null
+++ b/pkg/network/webrtc/pacer.go
@@ -0,0 +1,82 @@
+// In-frame packet pacing (patch 0028). The stack deliberately runs GCC with a NoOpPacer — a
+// leaky-bucket pacer queues and re-times RTP, which is exactly the latency this project exists to
+// avoid, and on an idle LAN wire-speed bursts are harmless. But off-LAN they are not: each encoded
+// frame's packets leave back-to-back at wire speed (~14-40 KB in one burst every 16 ms), which
+// overflows shallow cellular/home-router queues and trips GCC's delay detector — measured live on
+// real 5G (2026-07-09): estimate collapses to ~525 kbps and a crawl/crash sawtooth pinned the
+// stream at 1500-2500 kbps of a 5000 ceiling.
+//
+// This is the middle ground: when a room opts in (lobby Network profile Remote/5G → t=104 `pace`),
+// each frame's burst is broken into groups of pacePktGroup packets with a 1 ms pause between
+// groups, capped at `pace` pauses per frame. Windows timer granularity makes sub-millisecond
+// sleeps unreliable, so grouping — not per-packet spacing — is the portable unit. Typical frames
+// (≤8 packets) are untouched; a 35-packet IDR spreads over ~4 ms. Pacing OFF (0, the default and
+// the LAN profile) is byte-identical to the pre-patch behavior.
+package webrtc
+
+import (
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/pion/interceptor"
+	"github.com/pion/rtp"
+)
+
+// paceSleeps is the per-frame cap on 1 ms smoothing pauses (== the pacing window in ms). Process-
+// global because one worker hosts exactly one room; set from EVERY room start (0 clears) so a
+// no-pacing room can never inherit the previous room's window.
+var paceSleeps atomic.Int32
+
+// SetPacing arms (or, with 0, disarms) the in-frame packet smoother for the current room.
+func SetPacing(ms int) {
+	if ms < 0 {
+		ms = 0
+	}
+	if ms > 20 {
+		ms = 20
+	}
+	paceSleeps.Store(int32(ms))
+}
+
+// pacePktGroup is how many packets go out back-to-back before a pause — ~9.6 KB at the usual
+// ~1200-byte payloads, i.e. the largest remaining burst a paced stream presents to a queue.
+const pacePktGroup = 8
+
+type pacerFactory struct{}
+
+func (pacerFactory) NewInterceptor(_ string) (interceptor.Interceptor, error) {
+	return &pacer{}, nil
+}
+
+type pacer struct{ interceptor.NoOp }
+
+func (p *pacer) BindLocalStream(info *interceptor.StreamInfo, writer interceptor.RTPWriter) interceptor.RTPWriter {
+	// Video only: audio is 1 small packet per 10 ms frame and rides its own PeerConnection.
+	if !strings.HasPrefix(info.MimeType, "video/") {
+		return writer
+	}
+	return &pacedWriter{next: writer}
+}
+
+// pacedWriter spaces one bound stream's packets. Per-peer state is correct: each viewer's stream
+// is bound (and therefore paced) independently.
+type pacedWriter struct {
+	next interceptor.RTPWriter
+	pkts int // packets sent in the current frame's burst
+	naps int // pauses taken in the current frame's burst
+}
+
+func (w *pacedWriter) Write(header *rtp.Header, payload []byte, attributes interceptor.Attributes) (int, error) {
+	if cap := int(paceSleeps.Load()); cap > 0 {
+		if w.pkts > 0 && w.pkts%pacePktGroup == 0 && w.naps < cap {
+			time.Sleep(time.Millisecond)
+			w.naps++
+		}
+		w.pkts++
+		if header.Marker { // last packet of this frame — the next Write starts a new burst
+			w.pkts, w.naps = 0, 0
+		}
+	}
+	return w.next.Write(header, payload, attributes)
+}
diff --git a/pkg/network/webrtc/plikeyframe.go b/pkg/network/webrtc/plikeyframe.go
new file mode 100644
index 0000000..4b247b7
--- /dev/null
+++ b/pkg/network/webrtc/plikeyframe.go
@@ -0,0 +1,44 @@
+// PLI/FIR → keyframe (patch 0029), the required companion to intra-refresh. The encoder runs an
+// infinite GOP with rolling intra refresh (no periodic IDR pulses at all), so when a viewer's
+// decoder loses the reference chain — unrepaired packet loss, a browser decode hiccup — the ONLY
+// way it ever gets a decodable picture again is to ask. Browsers ask automatically: they send RTCP
+// PLI (and some send FIR). CloudRetro historically ignored both, which is exactly how AV1 rooms
+// froze until the next join event (2026-07-09).
+package webrtc
+
+import (
+	"sync/atomic"
+	"time"
+)
+
+// keyframeReq is wired by room.NewRoom to the media pipe's RequestKeyframe (patch 0012's forceKf
+// window). Process-global like SetPacing: one worker hosts exactly one room, and each new room
+// re-points it at its own pipe. A stale callback after a room closes is inert (it stores into an
+// atomic on a pipe nothing reads), so there is no unhook path.
+var keyframeReq atomic.Value // func()
+
+// lastKeyframeReq rate-limits PLI-driven keyframes (unix nanos). A lossy link PLI-storms — every
+// viewer, every frame gap — and answering each one would resurrect the periodic-IDR pulse problem
+// through the back door. One keyframe heals every viewer at once; half a second is far below the
+// old 2 s GOP worst case.
+var lastKeyframeReq atomic.Int64
+
+const keyframeReqMinInterval = 500 * time.Millisecond
+
+// OnKeyframeRequest registers the current room's keyframe trigger.
+func OnKeyframeRequest(f func()) { keyframeReq.Store(f) }
+
+func requestKeyframeRateLimited() {
+	f, _ := keyframeReq.Load().(func())
+	if f == nil {
+		return
+	}
+	now := time.Now().UnixNano()
+	last := lastKeyframeReq.Load()
+	if now-last < int64(keyframeReqMinInterval) {
+		return
+	}
+	if lastKeyframeReq.CompareAndSwap(last, now) {
+		f()
+	}
+}
diff --git a/pkg/network/webrtc/svc.go b/pkg/network/webrtc/svc.go
new file mode 100644
index 0000000..de4d34a
--- /dev/null
+++ b/pkg/network/webrtc/svc.go
@@ -0,0 +1,87 @@
+package webrtc
+
+import "sync/atomic"
+
+// Temporal SVC (arcade). The room's ONE encoder emits a hierarchical-P pyramid: layer 0 (the base)
+// references only itself, so frames in the upper layers can be discarded by the SENDER without
+// breaking anyone's reference chain. Each Peer owns its own TrackLocalStaticSample — and therefore
+// its own packetizer and its own RTP sequence numbers — so "drop a layer for this peer" is literally
+// "don't call WriteSample for that frame". No sequence gaps, no NACK storm, no Dependency Descriptor
+// header extension, and the browser never learns the stream was layered: it just sees fewer frames.
+//
+// That is what lets one peer on hotel wifi take 30fps (or 15) while the rest of the room keeps 60,
+// instead of ABR dragging the whole room's encode down to the worst receiver.
+//
+// Measured layer shares (nvav1enc, 640x480 ball pattern — real content varies, the shape does not):
+//
+//	3 layers: tid<=0 = 28% of bitrate @15fps | tid<=1 = 54% @30fps | tid<=2 = 100% @60fps
+//	2 layers: tid<=0 = 53% of bitrate @30fps | tid<=1 = 100% @60fps
+//
+// so a base-layer-only peer costs ~28% of the room's bitrate: the room may run ~3.5x that peer's
+// estimate and still serve it.
+
+// svcLayers is how many temporal layers the encoder is CURRENTLY producing (0/1 = not layered).
+// Process-global for the same reason SetPacing and OnKeyframeRequest are: one worker = one room, and
+// the encoder is built long after the peers' package is wired. 1 = every frame is tid 0, so the drop
+// path below can never fire — which is exactly the behaviour we want when SVC is off.
+var svcLayers atomic.Int32
+
+// SetTemporalLayers records the encoder's layer count. Called when the media pipe is built.
+func SetTemporalLayers(n int) { svcLayers.Store(int32(n)) }
+
+// TemporalLayers reports the encoder's layer count (0/1 = SVC off).
+func TemporalLayers() int { return int(svcLayers.Load()) }
+
+// av1TemporalID reads temporal_id out of an AV1 temporal unit's OBU extension header.
+//
+// The encoder hands us one temporal unit per sample (caps: alignment=tu), which is a TEMPORAL
+// DELIMITER OBU followed by the coded frame. The TD does not necessarily carry an extension header,
+// so we walk OBUs until we find the frame itself.
+//
+// Returns 0 for anything it cannot parse, and for every non-layered stream (with temporal-layers=1
+// NVENC emits NO extension headers at all — verified: 0 of 120 frames). 0 = base layer = never
+// dropped, so a parse failure degrades to "send it", never to "silently drop the room's video".
+func av1TemporalID(frame []byte) int {
+	// Low-overhead bitstream: [obu_header] [obu_extension?] [leb128 size] [payload]
+	for i := 0; i < len(frame); {
+		h := frame[i]
+		i++
+		obuType := (h >> 3) & 0xF
+		extFlag := (h >> 2) & 1
+		hasSize := (h >> 1) & 1
+
+		tid := 0
+		if extFlag == 1 {
+			if i >= len(frame) {
+				return 0
+			}
+			tid = int(frame[i] >> 5)
+			i++
+		}
+		// Without a size field we cannot find the next OBU, so we cannot keep walking. An
+		// OBU_FRAME/OBU_FRAME_HEADER here is still authoritative for this frame.
+		if hasSize == 0 {
+			return tid
+		}
+
+		size := 0
+		for shift := 0; ; shift += 7 {
+			if i >= len(frame) || shift > 56 {
+				return 0
+			}
+			b := frame[i]
+			i++
+			size |= int(b&0x7F) << shift
+			if b&0x80 == 0 {
+				break
+			}
+		}
+
+		// OBU_FRAME_HEADER (3) or OBU_FRAME (6) — the coded picture, and what carries the layer.
+		if obuType == 3 || obuType == 6 {
+			return tid
+		}
+		i += size
+	}
+	return 0
+}
diff --git a/pkg/network/webrtc/svc_test.go b/pkg/network/webrtc/svc_test.go
new file mode 100644
index 0000000..2a3570c
--- /dev/null
+++ b/pkg/network/webrtc/svc_test.go
@@ -0,0 +1,88 @@
+package webrtc
+
+import "testing"
+
+// obu builds one OBU: type, optional extension header (temporal id), leb128 size, payload.
+func obu(obuType byte, tid int, hasExt bool, payload []byte) []byte {
+	h := obuType << 3
+	if hasExt {
+		h |= 1 << 2
+	}
+	h |= 1 << 1 // obu_has_size_field
+	out := []byte{h}
+	if hasExt {
+		out = append(out, byte(tid<<5))
+	}
+	// leb128 of len(payload)
+	n := len(payload)
+	for {
+		b := byte(n & 0x7F)
+		n >>= 7
+		if n > 0 {
+			b |= 0x80
+		}
+		out = append(out, b)
+		if n == 0 {
+			break
+		}
+	}
+	return append(out, payload...)
+}
+
+const (
+	obuTD       = 2
+	obuFrameHdr = 3
+	obuFrame    = 6
+	obuSeqHdr   = 1
+)
+
+func TestAV1TemporalID(t *testing.T) {
+	body := make([]byte, 200) // >127 so the size field needs two leb128 bytes
+
+	tests := []struct {
+		name string
+		in   []byte
+		want int
+	}{
+		// The shape NVENC actually emits: a temporal delimiter with no extension header, then the
+		// frame carrying the layer. Reading only the FIRST OBU would report 0 for every frame and
+		// silently disable the whole feature.
+		{"TD then frame tid=2", append(obu(obuTD, 0, false, nil), obu(obuFrame, 2, true, body)...), 2},
+		{"TD then frame tid=1", append(obu(obuTD, 0, false, nil), obu(obuFrame, 1, true, body)...), 1},
+		{"TD then frame tid=0", append(obu(obuTD, 0, false, nil), obu(obuFrame, 0, true, body)...), 0},
+
+		// temporal-layers=1: NVENC emits NO extension headers at all. Must read as base layer so the
+		// drop path can never fire when SVC is off.
+		{"no extension header", append(obu(obuTD, 0, false, nil), obu(obuFrame, 0, false, body)...), 0},
+
+		// A sequence header ahead of the frame (first frame of a stream) must be skipped over.
+		{"seq hdr then frame tid=2",
+			append(append(obu(obuTD, 0, false, nil), obu(obuSeqHdr, 0, false, body)...),
+				obu(obuFrame, 2, true, body)...), 2},
+
+		{"frame header OBU carries the id", obu(obuFrameHdr, 1, true, body), 1},
+
+		// Garbage must read as base layer: dropping is the dangerous direction. A parse failure that
+		// returned a high id would drop real frames and freeze the picture.
+		{"empty", []byte{}, 0},
+		{"truncated after header", []byte{obuFrame << 3}, 0},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := av1TemporalID(tc.in); got != tc.want {
+				t.Errorf("av1TemporalID() = %d, want %d", got, tc.want)
+			}
+		})
+	}
+}
+
+// The base layer must never be droppable, whatever the cap — that is the invariant that keeps a
+// starved peer showing a picture instead of a freeze.
+func TestBaseLayerNeverDropped(t *testing.T) {
+	body := make([]byte, 64)
+	frame := append(obu(obuTD, 0, false, nil), obu(obuFrame, 0, true, body)...)
+	if tid := av1TemporalID(frame); tid != 0 {
+		t.Fatalf("base-layer frame parsed as tid %d; it would be dropped for a capped peer", tid)
+	}
+}
