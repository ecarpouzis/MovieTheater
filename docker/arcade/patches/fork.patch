+package nanoarch
+
+import (
+	"encoding/json"
+	"os"
+	"sync"
+	"time"
+)
+
+// GameOverride is one ROM's entry in the arcade per-game config manifest (game-overrides.json,
+// generated by the site's `arcade-gameconfig-export` from the ArcadeGameProfile table). It is keyed
+// by ROM filename sans extension (== ArcadeGame.CloudRetroGameKey, the same key options4rom uses).
+// See docs/arcade-per-game-config.md.
+//
+//	{
+//	  "Sonic Adventure v1.005 (1999)(Sega)(US)(M5)[!][%51000-A]": { "fps": 30 },
+//	  "Some Game (USA)": { "options": { "flycast_widescreen_hacks": "enabled" } }
+//	}
+type GameOverride struct {
+	Fps     float64           `json:"fps"`     // forced framerate (0 = leave the core's advertised rate)
+	Options map[string]string `json:"options"` // libretro core-option overrides applied before load
+}
+
+var (
+	goMu     sync.Mutex
+	goCache  map[string]GameOverride
+	goMod    time.Time
+	goLoaded bool
+	goPath   string
+)
+
+// gameOverrides returns the current per-game manifest (romName → override), transparently reloading
+// when the file's mtime changes so admin edits take effect on the NEXT room without a worker restart.
+// Path: CLOUD_GAME_GAME_OVERRIDES, else "game-overrides.json" resolved from the worker CWD (the same
+// ConfDir config.yaml loads from). A missing file means "no overrides" (nil); a parse error keeps the
+// last good map so a bad regen can't wipe live behavior mid-session.
+func gameOverrides() map[string]GameOverride {
+	path := os.Getenv("CLOUD_GAME_GAME_OVERRIDES")
+	if path == "" {
+		path = "game-overrides.json"
+	}
+
+	goMu.Lock()
+	defer goMu.Unlock()
+
+	fi, err := os.Stat(path)
+	if err != nil {
+		goCache, goLoaded, goPath = nil, true, path
+		return nil
+	}
+	if goLoaded && path == goPath && fi.ModTime().Equal(goMod) {
+		return goCache
+	}
+
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return goCache
+	}
+	var m map[string]GameOverride
