+  uint32_t id;
+  const char* title;
+  char badge_name[16];
+  uint32_t num_achievements;
+  uint32_t num_leaderboards;
+  const char* badge_url;
+} v3_rc_client_subset_t;
+
+/* achievement */
+
+typedef struct v1_rc_client_achievement_t {
+  const char* title;
+  const char* description;
+  char badge_name[8];
+  char measured_progress[24];
