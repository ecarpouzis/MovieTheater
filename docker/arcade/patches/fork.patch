+			// game's achievement/leaderboard definitions and evaluates them against RAM locally; the handlers
+			// push the in-room toast and mirror unlocks/scores/times to the site, attributed to the ROOM HOST
+			// (parsed from the deterministic room id `uid`). No player needs their own RA account.
+			// rq.Hardcore carries the room's COMPETITIVE flag — our own legit-run tag on the mirrored events,
+			// NOT rc_client's (always-on) hardcore mode. Stage BEFORE Load, like cheats.
+			raCfg := w.conf.RetroAchievements
+			if raCfg.SiteUser != "" && raCfg.SiteToken != "" {
+				mirror := raMirrorConfig{baseURL: raCfg.MirrorURL, secret: raCfg.Secret}
+				handlers := buildCheevosHandlers(mirror, w.log, r.Send, uid, game.System, raCfg.SiteUser)
+				// Seed the per-run Cheat legitimacy taint from whether this room staged cheat codes (codes-only
+				// now; core options are quality settings, not cheats). Competitive rooms take no cheats, so this
+				// is only ever true for a casual room — every event then reports the Cheat why-icon.
+				app.SetRetroAchievements(raCfg.SiteUser, raCfg.SiteToken, game.System, rq.RaHash, rq.Hardcore, len(rq.Cheats) > 0, rq.SeedExplicit, handlers)
+				w.log.Info().Msgf("RetroAchievements: engine active for room %q (competitive=%v)", uid, rq.Hardcore)
+			}
+
+			// Per-room Wii controller-scheme override (site: creator's room-create choice) for the
+			// GC-controller-native BrawlEx mods. Unlike HwContext this needs no precedence resolution
+			// against a DB pin/renderer inference: an empty/unrecognized value just leaves nanoarch's
+			// own hid4rom/hid config default in place. Allowlist hard even though the site already
+			// does — never trust the client to only ever send an accepted value. Staged like
+			// HwContextOverride (consumed + cleared in CoreLoad, which runs inside app.Load below).
+			switch rq.ControllerScheme {
+			case "gc", "wiimote":
+				nanoarch.Nan0.ControllerSchemeOverride = rq.ControllerScheme
+				w.log.Info().Msgf("Per-room controller scheme: %q for %q", rq.ControllerScheme, gameName)
+			default:
+				nanoarch.Nan0.ControllerSchemeOverride = "" // unconditional clear, like HwContextOverride
+			}
+
+			r.SetApp(app)
+
+			// GL ZERO-COPY — ARMED HERE, BEFORE app.Load, AND THAT IS THE WHOLE POINT.
+			//
+			// The core's GL context is created during LOAD (retro_hw_render -> initVideo), and the hook
+			// below is what wraps it for GStreamer. Setting this up after the load — down with the rest
+			// of the media finalize, which is where it naturally wants to live — means the context is
+			// already gone past: GLContextReady is still nil when initVideo runs, GStreamer never gets a
+			// GL context, and we then push texture ids into a pipeline that cannot resolve them. That
+			// is not a clean failure. It is a black stream and an nvcodec teardown hang (seen, 18:12).
+			//
+			// Scoped to HARDWARE-rendered libretro cores: a software core's frame is already in system
+			// memory (nothing to keep on the GPU), and the capture lane has its own zero-copy.
+			coreCfg := w.conf.Emulator.GetLibretroCoreConfig(game.System)
+			// Per-GAME Vulkan: a game whose override manifest requests a Vulkan renderer (Stuntman ->
+			// paraLLEl-GS) flips THIS room onto the Vulkan-capture path while the core config's
+			// default (GL) keeps serving every other game on the system. Staged for the next CoreLoad
+			// (consumed+cleared there, like room cheats) so it cannot leak across rooms. It must be
+			// decided HERE — not in nanoarch's LoadGame — because m.GLZeroCopy below is a pipeline
+			// BUILD-time property: the appsrc is created for GL textures or system-memory frames, and
+			// a Vulkan room's readback frames are the latter.
+			// Resolve THIS room's hardware-render context by a 4-level precedence (docs/arcade-vulkan-
+			// w3w4w5-spec.md, F1). Highest wins:
+			//   0. the CREATOR's explicit per-launch request (rq.HwContext, the site's play-button
+			//      dropdown) — absolute, wins even over an admin's DB pin below. Gated on
+			//      coreCfg.HwContext != "" as defense in depth: only systems whose config already
+			//      declares a hw-context default may honor a request override at all, so a stray/stale
+			//      value for an out-of-scope (2D) system can never reach a core with no Vulkan path.
+			//   1. the game's EXPLICIT hwContext override field (GameHwContext) — DB-pinned admin
+			//      override. This is the lever for cores with no renderer core-option (psp/dc/gc all
+			//      just follow the frontend's hw context), and it overrides everything below for any game.
+			//   2. the renderer-option inference — WantsVulkanRenderer (→ vulkan) / ForcesGlRenderer (→ gl).
+			//      Serves the ps2/n64 profiles already exported as pcsx2_renderer / mupen64plus-rdp-plugin,
+			//      and is the per-game GL escape hatch when a Vulkan-default core meets a title paraLLEl-GS/
+			//      -RDP can't serve.
+			//   3. the core config's HwContext default (per-system; "" == "gl").
+			// This inline switch is the authoritative precedence — nanoarch.ResolveHwContext (overrides.go)
+			// is a narrower 3-level pure function exercised only by its own unit tests, not by this path;
+			// don't assume it's in sync with level 0 here.
+			// We stage HwContextOverride only when the resolved context DIVERGES from the core default
+			// (else clear it, like SetRoomCheats) — the same "override only on divergence" contract
+			// CoreLoad consumes. When resolved=="gl" but the core defaults to Vulkan, the staged "gl"
+			// also flips gl.enabled on via nanoarch's escape-hatch term (meta.HwContext=="gl") even though
+			// isGlAllowed:false. When resolved=="gl" the profile is expected to ALSO set the core's GL
+			// renderer option (pcsx2_renderer:"OpenGL", ...) so renderer + capture agree; for the
+			// no-renderer-option cores (psp/dc/gc) the frontend hw context IS the whole selection.
+			coreDefault := coreCfg.HwContext
+			if coreDefault == "" {
+				coreDefault = "gl"
+			}
+			resolved := coreDefault
+			explicitHw := nanoarch.GameHwContext(game.Name)
+			switch {
+			case (rq.HwContext == "gl" || rq.HwContext == "vulkan") && coreCfg.HwContext != "":
+				resolved = rq.HwContext // level 0 — explicit per-request override, wins over everything
+			case explicitHw != "":
+				resolved = explicitHw // level 1
+			case nanoarch.WantsVulkanRenderer(game.Name):
+				resolved = "vulkan" // level 2 (vk)
+			case nanoarch.ForcesGlRenderer(game.Name):
+				resolved = "gl" // level 2 (gl)
+			}
+			vkGame := resolved == "vulkan"
+			if resolved != coreDefault {
+				via := "renderer-option inference"
+				switch {
+				case rq.HwContext != "" && coreCfg.HwContext != "" && resolved == rq.HwContext:
+					via = "per-request override"
+				case explicitHw != "":
+					via = "explicit hwContext field"
+				}
+				nanoarch.Nan0.HwContextOverride = resolved
+				w.log.Info().Msgf("Per-game hw context: %q → %q (core default %q, via %s)",
+					game.Name, resolved, coreDefault, via)
+			} else {
+				nanoarch.Nan0.HwContextOverride = "" // unconditional clear, like SetRoomCheats
+			}
+			// M2 Vulkan->GL zero-copy: a Vulkan room joins the GL zero-copy encode path (its frames are
+			// imported as GL textures via external memory) when the box advertises the external-memory/
+			// semaphore extensions and the kill-switch is off. CLOUD_GAME_VK_ZEROCOPY: "0"/"off" => M1
+			// readback; "fence" => the conservative layer-2 sync (host fence-wait the blit); anything
+			// else/unset => layer-1 (external semaphore). This MUST be decided here, before app.Load,
+			// because m.GLZeroCopy is a pipeline BUILD-time property (the appsrc carries GL textures or
+			// system-memory frames), and the extension probe needs no core device (throwaway instance).
+			vkKill := os.Getenv("CLOUD_GAME_VK_ZEROCOPY")
+			vkZC := vkGame && vkKill != "0" && vkKill != "off" &&
+				w.conf.Emulator.GlZeroCopy && nanoarch.VulkanZeroCopySupported()
+			nanoarch.Nan0.VkZeroCopyStaged = vkZC
+			nanoarch.Nan0.VkZeroCopyFence = vkZC && vkKill == "fence"
+			if vkGame {
+				if vkZC {
+					sync := "semaphore"
+					if vkKill == "fence" {
+						sync = "fence"
+					}
+					w.log.Info().Msgf("Vulkan zero-copy armed for %q (sync=%s)", game.Name, sync)
+				} else {
+					w.log.Info().Msgf("Vulkan room %q on the M1 readback path (zero-copy off/unsupported)", game.Name)
+				}
+			}
+			// GL zero-copy is a GL-context feature (it wraps a WGL context for GStreamer). A GL core uses
+			// its own context; a Vulkan zero-copy room uses a dedicated import context created in
+			// setupVulkanZeroCopy. Either way the media pipeline runs in GL-texture mode (m.GLZeroCopy).
+			glZC := w.conf.Emulator.GlZeroCopy && coreCfg.IsGlAllowed && !vkGame
+			nanoarch.Nan0.GLZeroCopy = glZC
+			m.GLZeroCopy = glZC || vkZC
+			// ORDER IS THE WHOLE BUG. Room.Close() runs app.Close() (which destroys the core's GL
+			// context) and only THEN media.Destroy(). With GL zero-copy the encoder holds a GL context
+			// SHARED with the core's, so that order leaves nvcodec doing GL work against a dead share
+			// group — its state change never returns, and the worker hard-exits every single room close
+			// ("media pipeline teardown wedged (nvcodec set_state hang)").
+			//
+			// So tear the PIPELINE down first, from inside the core's own teardown, before its GL
+			// context goes away. media.Destroy() is bounded and safe to call again from Room.Close().
+			nanoarch.GLContextGone = func() {
+				m.Destroy()
+				media.DeinitGLZeroCopy()
+			}
+			nanoarch.GLContextReady = func(glrc uintptr, unbind func(), rebind func() error) error {
+				if err := media.InitGLZeroCopy(glrc, unbind, rebind); err != nil {
+					// nanoarch clears Nan0.GLZeroCopy on error; clear the media side too, or the
+					// pipeline would be built for GL frames that will never come.
+					m.GLZeroCopy = false
+					return err
+				}
+				return nil
+			}
+			if glZC {
+				w.log.Info().Msgf("GL zero-copy armed for %s (no glReadPixels)", game.System)
+			}
+
+			// recreate the video encoder when the core's frame size changes at runtime
+			app.VideoChangeCb(func() {
+				app.ViewportRecalculate()
+				m.VideoW, m.VideoH = app.ViewportSize()
+				m.VideoScale, m.ScaleMethod = app.Scale()
+
+				if err := m.Reinit(); err != nil {
+					c.log.Error().Err(err).Msgf("reinit fail")
+				}
+
+				data, err := api.Wrap(api.Out{
+					T: uint8(api.AppVideoChange),
+					Payload: api.AppVideoInfo{
+						W:    m.VideoW,
+						H:    m.VideoH,
+						A:    app.AspectRatio(),
+						S:    int(m.VideoScale),
+						SM:   m.ScaleMethod,
+						Flip: app.Flipped(),
+						Rot:  app.Rotation(),
+					}})
+				if err != nil {
+					c.log.Error().Err(err).Msgf("wrap")
+				}
+				r.Send(data)
+			})
+
+			w.log.Info().Msgf("Starting the game: %v", gameName)
+			// Name the room in any crash report. A worker only ever runs one room, so this is the
+			// single most useful fact to carry into a post-mortem: which game/system was live.
+			gos.SetCrashContext(fmt.Sprintf("room=%v game=%v", r.Id(), gameName))
+			// Arm the wedge sentinel around the core load ONLY (app.Load is where a core
+			// crashes/hangs — the citra GL-load 0xC0000005). exit() runs on any return; if Load never
+			// returns (wedged), the sentinel trips at coreLoadDeadline, frees the port, and hard-exits.
+			w.sentinel.enter(phaseCoreLoad, coreLoadDeadline)
+			loadErr := app.Load(game, w.conf.Library.BasePath)
+			w.sentinel.exit()
+			// The boundary that has been invisible: everything the core prints during retro_load_game
+			// looks identical whether load then RETURNED or died at its tail. This line is the proof it
+			// got through, so a crash before it is the core's load and a crash after it is ours.
+			w.log.Info().Msgf("[boot] core load returned (err=%v)", loadErr)
+			if loadErr != nil {
+				c.log.Error().Err(loadErr).Msgf("couldn't load the game %v", game)
+				r.Close()
+				w.router.SetRoom(nil)
+				return api.EmptyPacket
+			}
+		}
+
+		// Media finalize — SHARED by both lanes, read through the app.App interface. FPS() is not on
+		// the interface (concrete on both apps), so it's fetched via a tiny local interface.
+		ap := r.App()
+		m.AudioSrcHz = ap.AudioSampleRate()
+		m.VideoW, m.VideoH = ap.ViewportSize()
+		m.VideoScale, m.ScaleMethod = ap.Scale()
+		coreConf := w.conf.Emulator.GetLibretroCoreConfig(game.System) // zero-value for "capture"
+		m.MaxThreads = coreConf.MaxThreads
+		m.BppTarget = coreConf.BppTarget
+		if f, ok := ap.(interface{ FPS() float64 }); ok {
+			m.VideoFPS = f.FPS()
+		}
+		m.VideoVFR = coreConf.VFR
+
+		m.SetPixFmt(ap.PixFormat())
+		m.SetRot(ap.Rotation())
+
+		r.SetMedia(m)
+
+		if err := m.Init(); err != nil {
+			c.log.Error().Err(err).Msgf("couldn't init the media")
+			r.Close()
+			w.router.SetRoom(nil)
+			return api.EmptyPacket
+		}
+
+		r.InitMedia()
+		r.StartApp()
+
+		// Adaptive bitrate (patch 0021). The room's chosen quality becomes the CEILING; ABR moves the
+		// encoder between a floor and that ceiling from the worst peer's send-side estimate. Costs one
+		// GObject property set per rung — no rebuild, no reneg. See pkg/worker/abr.go.
+		// An explicit lobby choice always wins. Otherwise ("Auto") the ceiling is DERIVED from the frame
+		// this room actually encodes — see autoCeilingKbps. The old path took a per-system constant the
+		// site had picked before the core even loaded, which could not know the core's real viewport,
+		// its scale, or a render profile that changed the resolution.
+		// An explicit lobby choice is FIXED for the room; only the derived ceiling tracks geometry.
+		var ceilFn func() int
+		if rq.VideoBitrate > 0 {
+			fixed := rq.VideoBitrate
+			ceilFn = func() int { return fixed }
+		} else {
+			ceilFn = func() int { k, _ := autoCeilingKbps(m); return k }
+			k, why := autoCeilingKbps(m)
+			w.log.Info().Msgf("abr: auto ceiling %d kbps — %s", k, why)
+			if err := m.SetVideoBitrate(k); err != nil {
+				w.log.Warn().Err(err).Msg("abr: could not apply the initial auto ceiling")
+			}
+		}
+		// The link-stat mirror rides the RetroAchievements credentials: that config block is where the
+		// worker's site base URL + internal secret live, so there is one worker->site trust path
+		// rather than two. Unconfigured = summary lines still logged, nothing POSTed.
+		raCfg := w.conf.RetroAchievements
+		startRoomAbr(w.log, r, m, ceilFn,
+			linkStatConfig{baseURL: raCfg.MirrorURL, secret: raCfg.Secret}, game.System)
+	}
+
+	needsKbMouse := r.App().KbMouseSupport()
+
+	s := room.WithWebRTC(user.Session)
+	s.OnMessage(func(data []byte) { r.App().Input(user.Index, byte(caged.RetroPad), data) })
+	if needsKbMouse {
+		// Keyboard and mouse both carry RELATIVE/EDGE-TRIGGERED state, not a resendable snapshot, so
+		// neither may ride the default unreliable channel (Ordered:false, MaxRetransmits:0) the RetroPad
+		// uses. That default is right for the pad — a frame is a FULL button snapshot, so a lost one is
+		// corrected 16 ms later by the next. It is wrong here: a dropped mouse delta is a permanent,
+		// unrecoverable shift in cursor position that accumulates for the whole session (this is what
+		// made ScummVM's cursor drift a "large offset" away from the player's real pointer), and a
+		// dropped key-up leaves a key stuck down forever.
+		_, _ = s.Channel("keyboard", &webrtc.ReliableChannelParams, func(data []byte) { r.App().Input(user.Index, byte(caged.Keyboard), data) })
+		_, _ = s.Channel("mouse", &webrtc.ReliableChannelParams, func(data []byte) { r.App().Input(user.Index, byte(caged.Mouse), data) })
+	}
+	// patch 0005: multi-disc swap. The browser opens a "disc" channel and sends a 1-byte target image
+	// index; the frontend applies it on the emulator thread. No-op for cores without disk control.
+	if disc, ok := r.App().(interface{ RequestDisk(int) }); ok {
+		_, _ = s.Channel("disc", nil, func(data []byte) {
+			if len(data) >= 1 {
+				disc.RequestDisk(int(data[0]))
+			}
+		})
+	}
+
+	c.RegisterRoom(r.Id())
+
+	response := api.StartGameResponse{
+		Room:    api.Room{Rid: r.Id()},
+		Record:  w.conf.Recording.Enabled,
+		KbMouse: needsKbMouse,
+	}
+
+	if r.App().AspectEnabled() {
+		ww, hh := r.App().ViewportSize()
+		scale, scaleM := r.App().Scale()
+		response.AV = &api.AppVideoInfo{
+			W:    ww,
+			H:    hh,
+			A:    r.App().AspectRatio(),
+			S:    int(scale),
+			SM:   scaleM,
+			Flip: r.App().Flipped(),
+			Rot:  r.App().Rotation(),
+		}
+	}
+
+	return api.Out{Payload: response}
+}
+
+// HandleTerminateSession handles cases when a user has been disconnected from the websocket of coordinator.
+func (c *coordinator) HandleTerminateSession(rq api.TerminateSessionRequest, w *Worker) {
+	if user := w.router.FindUser(rq.Id); user != nil {
+		w.router.Remove(user)
+		user.Disconnect()
+	}
+	releaseTimeWarp(w)
+}
+
+// HandleQuitGame handles cases when a user manually exits the game.
+func (c *coordinator) HandleQuitGame(rq api.GameQuitRequest, w *Worker) {
+	if user := w.router.FindUser(rq.Id); user != nil {
+		w.router.Remove(user)
+	}
+	releaseTimeWarp(w)
+}
+
+// releaseTimeWarp drops fast-forward/rewind whenever ANY player departs. The engage/release
+// pair rides a held chord in the departing player's browser — a tab closed mid-hold never
+// sends the release, and a room stuck at 4x forever is far worse than surviving players
+// having to re-hold their chord after someone leaves.
+func releaseTimeWarp(w *Worker) {
+	if r := w.router.Room(); r != nil {
+		if emu, ok := r.App().(*libretro.Caged); ok {
+			emu.SetFastForward(false)
+			emu.SetRewind(false)
+		}
+	}
+}
+
+func (c *coordinator) HandleResetGame(rq api.ResetGameRequest, w *Worker) api.Out {
+	if r := w.router.FindRoom(rq.Rid); r != nil {
+		emu := room.WithEmulator(r.App())
+		emu.Reset()
+		// A hard reset restores RA hardcore eligibility (RA's own rule), so clear the mid-run save-scum /
+		// time-manipulation taints — a clean run started after this is legit again.
+		emu.NotifyReset()
+		return api.OkPacket
+	}
+	return api.ErrPacket
+}
+
+// HandleFastForwardGame / HandleRewindGame toggle the room's time manipulation (t=114/115).
+// Checked cast, unlike the save/reset handlers above: a capture-lane room's App is a
+// *capture.App, not a *libretro.Caged, and a stray packet there must no-op, not panic the
+// worker. Both taint the RetroAchievements run as time-manipulated (RA's own hardcore rule);
+// the taint is sticky until a hard reset, so engage-only is enough.
+func (c *coordinator) HandleFastForwardGame(rq api.FastForwardGameRequest, w *Worker) {
+	r := w.router.FindRoom(rq.Rid)
+	if r == nil {
+		return
+	}
+	if emu, ok := r.App().(*libretro.Caged); ok {
+		emu.SetFastForward(rq.Active)
+		emu.NotifyFastForward(rq.Active)
+	}
+}
+
+func (c *coordinator) HandleRewindGame(rq api.RewindGameRequest, w *Worker) {
+	r := w.router.FindRoom(rq.Rid)
+	if r == nil {
+		return
+	}
+	if emu, ok := r.App().(*libretro.Caged); ok {
+		emu.SetRewind(rq.Active)
+		emu.NotifyFastForward(rq.Active) // rewind is time manipulation too
+	}
+}
+
+func (c *coordinator) HandleSaveGame(rq api.SaveGameRequest, w *Worker) api.Out {
+	r := w.router.FindRoom(rq.Rid)
+	if r == nil {
+		return api.ErrPacket
+	}
+	if err := room.WithEmulator(r.App()).SaveGameState(); err != nil {
+		c.log.Error().Err(err).Msg("cannot save game state")
+		return api.ErrPacket
+	}
+	return api.OkPacket
+}
+
+func (c *coordinator) HandleLoadGame(rq api.LoadGameRequest, w *Worker) api.Out {
+	r := w.router.FindRoom(rq.Rid)
+	if r == nil {
+		return api.ErrPacket
+	}
+	emu := room.WithEmulator(r.App())
+	if err := emu.RestoreGameState(); err != nil {
+		c.log.Error().Err(err).Msg("cannot load game state")
+		return api.ErrPacket
+	}
+	// The player loaded a save-STATE mid-run — tag every subsequent RA unlock/leaderboard this session as
+	// save-scummed (until a reset). This is the explicit Load press, NOT the gateway's boot-time seed
+	// (which restores through Frontend.Load directly and never hits this handler), so it can't false-taint
+	// a fresh Continue.
+	emu.NotifySaveStateLoaded()
+	return api.OkPacket
+}
+
+func (c *coordinator) HandleChangePlayer(rq api.ChangePlayerRequest, w *Worker) api.Out {
+	user := w.router.FindUser(rq.Id)
+	if user == nil || w.router.FindRoom(rq.Rid) == nil {
+		return api.Out{Payload: -1} // semi-predicates
+	}
+	user.Index = rq.Index
+	w.log.Info().Msgf("Updated player index to: %d", rq.Index)
+	return api.Out{Payload: rq.Index}
+}
+
+func (c *coordinator) HandleRecordGame(rq api.RecordGameRequest, w *Worker) api.Out {
+	if !w.conf.Recording.Enabled {
+		return api.ErrPacket
+	}
+	r := w.router.FindRoom(rq.Rid)
+	if r == nil {
+		return api.ErrPacket
+	}
+	room.WithRecorder(r.App()).ToggleRecording(rq.Active, rq.User)
+	return api.OkPacket
+}
+
+func toJson(data any) (string, error) {
+	if data == nil {
+		return "", nil
+	}
+	b, err := json.Marshal(data)
+	if err != nil {
+		return "", err
+	}
+	return string(b), nil
+}
diff --git a/pkg/worker/linkstat.go b/pkg/worker/linkstat.go
new file mode 100644
index 0000000..a98cd97
--- /dev/null
+++ b/pkg/worker/linkstat.go
@@ -0,0 +1,100 @@
+package worker
+
+// Session-close link statistics mirrored to the site (Phase 0 of the ABR quality plan).
+//
+// What this is for: the worker already KNOWS, by the end of every room, the rate each peer's link
+// actually sustained — and then forgets it when the room closes. Every room therefore re-certifies
+// from a cold 6000 kbps opener the same capacity it certified yesterday on the same link, which is
+// the 17–35s ramp Eric sees as "low-quality YouTube" at the start of every session. Storing the
+// measurement is what later lets a room open at a rate this device has already proven.
+//
+// This file is the WRITE half only, and it is deliberately inert: nothing here feeds back into any
+// ABR decision. It rides the same worker->site trust path as the RetroAchievements mirror
+// (racheevos.go) — same base URL, same X-Arcade-Internal-Secret header, same fire-and-forget
+// posture — so there is exactly one such transport to reason about, not two.
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/giongto35/cloud-game/v3/pkg/logger"
+)
+
+// Deliberately a SHORTER timeout than the RA mirror's 15s. An unlock is a durable user-visible record
+// worth waiting on; a link stat is a sample of a population, and the room it describes is already
+// gone. A stalled site must not leave goroutines parked for 15s per peer per room.
+var linkStatClient = &http.Client{Timeout: 5 * time.Second}
+
+// linkStatConfig is the site mirror endpoint + secret. Same fields, and in practice the same values,
+// as raMirrorConfig — the RA config block is where the worker's site credentials live, so a worker
+// with RA unconfigured also mirrors no link stats. That coupling is intentional (one secret to
+// rotate) but worth knowing: it is not a separate on/off switch.
+type linkStatConfig struct {
+	baseURL string
+	secret  string
+}
+
+func (c linkStatConfig) enabled() bool { return c.baseURL != "" && c.secret != "" }
+
+// linkStatRow is one peer's session summary. Field names match the site's LinkStatRequest.
+//
+// RampTicks is a POINTER because "never reached 90% of the ceiling" is a real, distinct outcome from
+// "reached it on tick 0" — a room that never got there is the single most interesting row in the
+// table, and collapsing it onto a sentinel integer would hide it.
+type linkStatRow struct {
+	RoomId        string  `json:"roomId"`
+	Username      string  `json:"username"`
+	DeviceId      string  `json:"deviceId"`
+	System        string  `json:"system"`
+	Codec         string  `json:"codec"`
+	CeilingKbps   int     `json:"ceilingKbps"`
+	OpenKbps      int     `json:"openKbps"`
+	SustainedKbps int     `json:"sustainedKbps"`
+	RampTicks     *int    `json:"rampTicks,omitempty"`
+	AtCeilPct     int     `json:"atCeilPct"`
+	CutsSteady    int     `json:"cutsSteady"`
+	StarvesSteady int     `json:"starvesSteady"`
+	CongEpisodes  int     `json:"congEpisodes"`
+	RttMeanMs     float64 `json:"rttMeanMs"`
+	RttSdMs       float64 `json:"rttSdMs"`
+	Path          string  `json:"path"`
+}
+
+// post ships one row. Call it from a goroutine: the only caller is the ABR loop's room-close branch,
+// and room teardown must not wait on the site being reachable.
+//
+// Fire-and-forget in the strict sense — no retry, no queue, no persistence. A dropped row costs one
+// sample out of many, and the alternative (a retry queue in the worker) would be a durability
+// mechanism for data whose entire value is statistical.
+func (c linkStatConfig) post(log *logger.Logger, row linkStatRow) {
+	if !c.enabled() {
+		return
+	}
+	buf, err := json.Marshal(row)
+	if err != nil {
+		return
+	}
+	req, err := http.NewRequest(http.MethodPost,
+		strings.TrimRight(c.baseURL, "/")+"/API/Arcade/Internal/LinkStat", bytes.NewReader(buf))
+	if err != nil {
+		return
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-Arcade-Internal-Secret", c.secret)
+	resp, err := linkStatClient.Do(req)
+	if err != nil {
+		log.Warn().Err(err).Msg("abr: link-stat mirror POST failed")
+		return
+	}
+	// Drain before close so the connection is reusable, and make a non-2xx VISIBLE: a wrong or rotated
+	// secret would otherwise fail with no symptom anywhere except "site rows never accumulate".
+	_, _ = io.Copy(io.Discard, resp.Body)
+	_ = resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		log.Warn().Msgf("abr: link-stat mirror POST rejected: %s", resp.Status)
+	}
+}
diff --git a/pkg/worker/media/d3d11zerocopy.go b/pkg/worker/media/d3d11zerocopy.go
new file mode 100644
index 0000000..d76fe6d
--- /dev/null
+++ b/pkg/worker/media/d3d11zerocopy.go
@@ -0,0 +1,308 @@
+package media
+
+// D3D11 cross-process zero-copy for the capture lane's WINDOW mode (capture lane v2).
+//
+// v1 window mode: the ArcadeCaptureHost helper WGC-captures the game window, reads the frame back to
+// system memory (~6 ms Map), memcpys it through a shared-memory pixel ring, and the worker re-uploads
+// it to the GPU for NVENC. This file removes that round trip: the helper keeps the frame on the GPU in
+// a keyed-mutex SHARED texture; the worker opens that texture (by NT-handle duplication — see below),
+// GPU-copies it into a pooled D3D11 texture, and pushes it as D3D11Memory straight into nvautogpu*enc.
+//
+// TRANSPORT = NT-handle DUPLICATION, not open-by-name. Proven on Ziggy 2026-07-23:
+// CreateSharedHandle(name)+OpenSharedResourceByName is PROCESS-LOCAL on this Win11/NVIDIA box
+// (in-process self-reopen works; cross-process E_INVALIDARG for bare/Global\/Local\ names alike). So
+// the helper publishes its pid + the raw NT-handle values + its adapter LUID in the ready JSON, and the
+// worker OpenProcess(PROCESS_DUP_HANDLE)+DuplicateHandle+OpenSharedResource1's them into itself.
+//
+// The GstD3D11Device MUST be opened for the helper's adapter LUID (gst_d3d11_device_new(0,0) can land on
+// the Intel iGPU and cross-adapter opens fail). Verified: the LUID-opened gst device lands on the same
+// NVIDIA 4070 Ti as the helper.
+//
+// The keyed mutex gives GPU-level producer/consumer ordering: the helper's next AcquireSync on a slot
+// blocks (on the GPU) until our CopyResource out of it has completed, so releasing the mutex right after
+// the copy CALL (before the async encode) is safe — this is the pool copy that "decouples encoder buffer
+// lifetime from the shared ring" (never hold the mutex across an async encode).
+//
+// One capture worker = one room, and the capture mod is a process-lifetime singleton, so the D3D11 state
+// is file-static globals (same shape glzerocopy.go uses). d11_deinit clears it between rooms.
+
+/*
+#define GST_USE_UNSTABLE_API
+#define COBJMACROS
+#cgo pkg-config: gstreamer-1.0 gstreamer-video-1.0 gstreamer-app-1.0 gstreamer-d3d11-1.0
+#cgo LDFLAGS: -ldxguid -luuid
+#include <windows.h>
+#include <d3d11_1.h>
+#include <dxgi1_2.h>
+#include <gst/gst.h>
+#include <gst/app/gstappsrc.h>
+#include <gst/video/video.h>
+#include <gst/d3d11/gstd3d11.h>
+#include <stdio.h>
+
+#define D11_MAX_SLOTS 8
+
+static GstD3D11Device        *d11_dev      = NULL;
+static ID3D11Device1         *d11_dev1     = NULL;   // for OpenSharedResource1
+static ID3D11DeviceContext   *d11_ctx      = NULL;   // the gst device's immediate context (locked on use)
+static GstD3D11PoolAllocator *d11_pool     = NULL;
+static ID3D11Texture2D       *d11_shared[D11_MAX_SLOTS];
+static IDXGIKeyedMutex       *d11_km[D11_MAX_SLOTS];
+static int                    d11_nshared  = 0;
+static int                    d11_w = 0, d11_h = 0;
+static char                   d11_err[512] = {0};
+
+static const char *d11_last_error(void) { return d11_err; }
+
+// d11_init opens a GstD3D11Device for the helper's adapter LUID and a pooled BGRA allocator at the
+// encode geometry. Returns 1 on success.
+static int d11_init(long long luid, int w, int h) {
+	if (d11_dev) return 1;
+	d11_w = w; d11_h = h;
+
+	d11_dev = luid != 0
+		? gst_d3d11_device_new_for_adapter_luid((gint64) luid, 0)
+		: gst_d3d11_device_new(0, 0);
+	if (!d11_dev) { g_snprintf(d11_err, sizeof(d11_err), "gst_d3d11_device_new_for_adapter_luid(%lld) failed", luid); return 0; }
+
+	ID3D11Device *dev = gst_d3d11_device_get_device_handle(d11_dev);
+	d11_ctx = gst_d3d11_device_get_device_context_handle(d11_dev);
+	if (!dev || !d11_ctx) { g_snprintf(d11_err, sizeof(d11_err), "gst device/context handle NULL"); return 0; }
+
+	HRESULT hr = ID3D11Device_QueryInterface(dev, &IID_ID3D11Device1, (void**) &d11_dev1);
+	if (FAILED(hr)) { g_snprintf(d11_err, sizeof(d11_err), "QI ID3D11Device1 hr=0x%08lX", (unsigned long) hr); return 0; }
+
+	// A pooled allocator of BGRA WxH textures usable as an encoder input AND a render target (black clear).
+	GstVideoInfo info;
+	gst_video_info_set_format(&info, GST_VIDEO_FORMAT_BGRA, w, h);
+	GstD3D11AllocationParams *params = gst_d3d11_allocation_params_new(
+		d11_dev, &info, GST_D3D11_ALLOCATION_FLAG_DEFAULT,
+		D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET, 0);
+	if (!params) { g_snprintf(d11_err, sizeof(d11_err), "alloc params NULL"); return 0; }
+	D3D11_TEXTURE2D_DESC desc; memset(&desc, 0, sizeof(desc));
+	desc.Width = w; desc.Height = h; desc.MipLevels = 1; desc.ArraySize = 1;
+	desc.Format = DXGI_FORMAT_B8G8R8A8_UNORM; desc.SampleDesc.Count = 1;
+	desc.Usage = D3D11_USAGE_DEFAULT;
+	desc.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+	d11_pool = gst_d3d11_pool_allocator_new(d11_dev, &desc);
+	gst_d3d11_allocation_params_free(params);
+	if (!d11_pool) { g_snprintf(d11_err, sizeof(d11_err), "pool allocator NULL"); return 0; }
+	if (!gst_d3d11_allocator_set_active(GST_D3D11_ALLOCATOR(d11_pool), TRUE)) {
+		g_snprintf(d11_err, sizeof(d11_err), "pool set_active failed"); return 0;
+	}
+	return 1;
+}
+
+// d11_open duplicates the helper's shared NT handles into this process and opens them as textures with
+// their keyed mutexes. Returns the number opened (== count on full success), or -1 on a hard failure.
+static int d11_open(int helperPid, unsigned long long *handles, int count) {
+	if (!d11_dev1) { g_snprintf(d11_err, sizeof(d11_err), "d11_open before d11_init"); return -1; }
+	if (count > D11_MAX_SLOTS) count = D11_MAX_SLOTS;
+	HANDLE proc = OpenProcess(PROCESS_DUP_HANDLE, FALSE, (DWORD) helperPid);
+	if (!proc) { g_snprintf(d11_err, sizeof(d11_err), "OpenProcess(pid=%d) GLE=%lu", helperPid, GetLastError()); return -1; }
+	int n = 0;
+	for (int i = 0; i < count; i++) {
+		HANDLE localH = NULL;
+		if (!DuplicateHandle(proc, (HANDLE)(uintptr_t) handles[i], GetCurrentProcess(), &localH, 0, FALSE, DUPLICATE_SAME_ACCESS)) {
+			g_snprintf(d11_err, sizeof(d11_err), "DuplicateHandle[%d] GLE=%lu", i, GetLastError());
+			break;
+		}
+		ID3D11Texture2D *tex = NULL;
+		HRESULT hr = ID3D11Device1_OpenSharedResource1(d11_dev1, localH, &IID_ID3D11Texture2D, (void**) &tex);
+		if (FAILED(hr)) { g_snprintf(d11_err, sizeof(d11_err), "OpenSharedResource1[%d] hr=0x%08lX", i, (unsigned long) hr); break; }
+		IDXGIKeyedMutex *km = NULL;
+		hr = ID3D11Texture2D_QueryInterface(tex, &IID_IDXGIKeyedMutex, (void**) &km);
+		if (FAILED(hr)) { ID3D11Texture2D_Release(tex); g_snprintf(d11_err, sizeof(d11_err), "QI KeyedMutex[%d] hr=0x%08lX", i, (unsigned long) hr); break; }
+		d11_shared[i] = tex; d11_km[i] = km; n++;
+	}
+	CloseHandle(proc);
+	d11_nshared = n;
+	return n;
+}
+
+// d11_acquire_pool_tex acquires a pooled memory + its ID3D11Texture2D. *out_mem must be put in a buffer.
+static ID3D11Texture2D *d11_acquire_pool_tex(GstMemory **out_mem) {
+	GstMemory *mem = NULL;
+	if (gst_d3d11_pool_allocator_acquire_memory(d11_pool, &mem) != GST_FLOW_OK || !mem) return NULL;
+	ID3D11Resource *res = gst_d3d11_memory_get_resource_handle((GstD3D11Memory*) mem);
+	*out_mem = mem;
+	return (ID3D11Texture2D*) res;
+}
+
+static void d11_push_buffer(GstAppSrc *src, GstMemory *mem, int w, int h, unsigned long long durNs) {
+	GstBuffer *buf = gst_buffer_new();
+	gst_buffer_append_memory(buf, mem);
+	gst_buffer_add_video_meta(buf, GST_VIDEO_FRAME_FLAG_NONE, GST_VIDEO_FORMAT_BGRA, w, h);
+	GST_BUFFER_DURATION(buf) = durNs;
+	gst_app_src_push_buffer(src, buf); // takes ownership of buf (+ the mem returns to the pool on unref)
+}
+
+// d11_push copies shared slot -> a pooled buffer under the slot's keyed mutex, then pushes the pool
+// buffer (mutex already released — never held across the async encode). Returns 1 on push, 0 on skip.
+static int d11_push(GstAppSrc *src, int slot, unsigned long long durNs) {
+	if (!src || !d11_pool || slot < 0 || slot >= d11_nshared || !d11_shared[slot]) return 0;
+	GstMemory *mem = NULL;
+	ID3D11Texture2D *poolTex = d11_acquire_pool_tex(&mem);
+	if (!poolTex) return 0;
+
+	// Acquire OUTSIDE the device lock: AcquireSync can block on the helper, and we must not stall the
+	// encoder (same device) while it does. Finite timeout so a stuck helper skips a frame, not wedges.
+	HRESULT hr = IDXGIKeyedMutex_AcquireSync(d11_km[slot], 0, 1000);
+	if (hr != S_OK) { gst_memory_unref(mem); return 0; }
+
+	gst_d3d11_device_lock(d11_dev);
+	ID3D11DeviceContext_CopyResource(d11_ctx, (ID3D11Resource*) poolTex, (ID3D11Resource*) d11_shared[slot]);
+	gst_d3d11_device_unlock(d11_dev);
+
+	IDXGIKeyedMutex_ReleaseSync(d11_km[slot], 0);
+	d11_push_buffer(src, mem, d11_w, d11_h, durNs);
+	return 1;
+}
+
+// d11_push_black pushes a cleared pool buffer (game-exit privacy / between-room blank).
+static int d11_push_black(GstAppSrc *src, unsigned long long durNs) {
+	if (!src || !d11_pool) return 0;
+	GstMemory *mem = NULL;
+	ID3D11Texture2D *poolTex = d11_acquire_pool_tex(&mem);
+	if (!poolTex) return 0;
+	ID3D11RenderTargetView *rtv = gst_d3d11_memory_get_render_target_view((GstD3D11Memory*) mem, 0);
+	gst_d3d11_device_lock(d11_dev);
+	if (rtv) { FLOAT black[4] = {0,0,0,1}; ID3D11DeviceContext_ClearRenderTargetView(d11_ctx, rtv, black); }
+	gst_d3d11_device_unlock(d11_dev);
+	d11_push_buffer(src, mem, d11_w, d11_h, durNs);
+	return 1;
+}
+
+// d11_set_context hands the pipeline our GstD3D11Device so its d3d11/nvautogpu elements use OUR device
+// (the one our pool buffers live on) instead of creating their own. Mirrors glzerocopy's zc_set_context.
+static void d11_set_context(GstElement *pipeline) {
+	if (!d11_dev || !pipeline) return;
+	GstContext *ctx = gst_d3d11_context_new(d11_dev);
+	gst_element_set_context(pipeline, ctx);
+	gst_context_unref(ctx);
+}
+
+// d11_read_slot_sample copies shared slot -> a staging texture and reads 4 quadrant-centre BGRA pixels
+// (out = 16 bytes). DIAGNOSTIC ONLY (cmd/capture-texcheck): proves the real open+keyed-mutex+copy path
+// returns real content, never called in the live pipeline. Returns 0 on success.
+static int d11_read_slot_sample(int slot, unsigned char *out, char *err, int errlen) {
+	if (!d11_dev || slot < 0 || slot >= d11_nshared || !d11_shared[slot]) { g_snprintf(err, errlen, "no slot %d", slot); return 1; }
+	ID3D11Device *dev = gst_d3d11_device_get_device_handle(d11_dev);
+	D3D11_TEXTURE2D_DESC sd; memset(&sd, 0, sizeof(sd));
+	sd.Width = d11_w; sd.Height = d11_h; sd.MipLevels = 1; sd.ArraySize = 1;
+	sd.Format = DXGI_FORMAT_B8G8R8A8_UNORM; sd.SampleDesc.Count = 1;
+	sd.Usage = D3D11_USAGE_STAGING; sd.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+	ID3D11Texture2D *st = NULL;
+	if (FAILED(ID3D11Device_CreateTexture2D(dev, &sd, NULL, &st))) { g_snprintf(err, errlen, "staging create failed"); return 2; }
+	if (IDXGIKeyedMutex_AcquireSync(d11_km[slot], 0, 1000) != S_OK) { ID3D11Texture2D_Release(st); g_snprintf(err, errlen, "AcquireSync timeout"); return 3; }
+	gst_d3d11_device_lock(d11_dev);
+	ID3D11DeviceContext_CopyResource(d11_ctx, (ID3D11Resource*) st, (ID3D11Resource*) d11_shared[slot]);
+	D3D11_MAPPED_SUBRESOURCE map;
+	HRESULT hr = ID3D11DeviceContext_Map(d11_ctx, (ID3D11Resource*) st, 0, D3D11_MAP_READ, 0, &map);
+	if (SUCCEEDED(hr)) {
+		int cx[4] = { d11_w/4, 3*d11_w/4, d11_w/4, 3*d11_w/4 };
+		int cy[4] = { d11_h/4, d11_h/4, 3*d11_h/4, 3*d11_h/4 };
+		for (int i = 0; i < 4; i++) {
+			unsigned char *px = (unsigned char*) map.pData + (size_t) cy[i]*map.RowPitch + (size_t) cx[i]*4;
+			out[i*4+0]=px[0]; out[i*4+1]=px[1]; out[i*4+2]=px[2]; out[i*4+3]=px[3];
+		}
+		ID3D11DeviceContext_Unmap(d11_ctx, (ID3D11Resource*) st, 0);
+	}
+	gst_d3d11_device_unlock(d11_dev);
+	IDXGIKeyedMutex_ReleaseSync(d11_km[slot], 0);
+	ID3D11Texture2D_Release(st);
+	if (FAILED(hr)) { g_snprintf(err, errlen, "Map hr=0x%08lX", (unsigned long) hr); return 4; }
+	return 0;
+}
+
+static void d11_deinit(void) {
+	for (int i = 0; i < D11_MAX_SLOTS; i++) {
+		if (d11_km[i])     { IDXGIKeyedMutex_Release(d11_km[i]); d11_km[i] = NULL; }
+		if (d11_shared[i]) { ID3D11Texture2D_Release(d11_shared[i]); d11_shared[i] = NULL; }
+	}
+	d11_nshared = 0;
+	if (d11_pool) { gst_d3d11_allocator_set_active(GST_D3D11_ALLOCATOR(d11_pool), FALSE); gst_object_unref(d11_pool); d11_pool = NULL; }
+	if (d11_dev1) { ID3D11Device1_Release(d11_dev1); d11_dev1 = NULL; }
+	d11_ctx = NULL;
+	if (d11_dev)  { gst_object_unref(d11_dev); d11_dev = NULL; }
+}
+*/
+import "C"
+
+import (
+	"fmt"
+	"unsafe"
+
+	"github.com/go-gst/go-gst/gst"
+)
+
+// InitD3D11ZeroCopy opens a GstD3D11Device on the helper's adapter LUID and a pooled BGRA allocator at
+// the encode geometry. Called before the media pipeline is built (so d11_set_context can run at build).
+func (g *GstMediaPipe) InitD3D11ZeroCopy(luid int64, w, h int) error {
+	if C.d11_init(C.longlong(luid), C.int(w), C.int(h)) == 0 {
+		return fmt.Errorf("d3d11 zero-copy init: %s", C.GoString(C.d11_last_error()))
+	}
+	return nil
+}
+
+// OpenD3D11Shared duplicates the helper's shared NT handles into this process and opens them.
+func (g *GstMediaPipe) OpenD3D11Shared(helperPid int, handles []uint64) error {
+	if len(handles) == 0 {
+		return fmt.Errorf("d3d11 zero-copy: no shared handles")
+	}
+	n := C.d11_open(C.int(helperPid), (*C.ulonglong)(unsafe.Pointer(&handles[0])), C.int(len(handles)))
+	if int(n) != len(handles) {
+		return fmt.Errorf("d3d11 zero-copy open (%d/%d): %s", int(n), len(handles), C.GoString(C.d11_last_error()))
+	}
+	return nil
+}
+
+// PushD3D11Slot copies shared texture[slot] into a pooled buffer under its keyed mutex and pushes it.
+// The capture app pushes here directly (not via ProcessVideo), so this owns the forced-keyframe clock —
+// same policy as the appsrc path, driven off the input frame like ProcessVideo does. The capture app
+// serializes its slot/black/re-push calls (frameMu), so the non-atomic keyframe counters stay safe.
+func (g *GstMediaPipe) PushD3D11Slot(slot, w, h int, durNs uint64) {
+	if g.v == nil || g.v.source == nil {
+		return
+	}
+	g.maybeForceKeyframe(g.v)
+	C.d11_push(g.v.src(), C.int(slot), C.ulonglong(durNs))
+}
+
+// PushD3D11Black pushes a cleared pool buffer (game-exit privacy / between-room blank).
+func (g *GstMediaPipe) PushD3D11Black(w, h int, durNs uint64) {
+	if g.v == nil || g.v.source == nil {
+		return
+	}
+	C.d11_push_black(g.v.src(), C.ulonglong(durNs))
+}
+
+// DeinitD3D11ZeroCopy releases the shared textures, the pool and the gst device.
+func (g *GstMediaPipe) DeinitD3D11ZeroCopy() { C.d11_deinit() }
+
+// ReadD3D11SlotSample reads 4 quadrant-centre BGRA pixels of shared slot (TL,TR,BL,BR). DIAGNOSTIC
+// ONLY (cmd/capture-texcheck) — proves the real open+keyed-mutex+copy path returns real content.
+func (g *GstMediaPipe) ReadD3D11SlotSample(slot int) ([4][4]byte, error) {
+	var out [16]C.uchar
+	errBuf := make([]C.char, 256)
+	if rc := C.d11_read_slot_sample(C.int(slot), &out[0], &errBuf[0], C.int(len(errBuf))); rc != 0 {
+		return [4][4]byte{}, fmt.Errorf("read slot %d: %s", slot, C.GoString(&errBuf[0]))
+	}
+	var px [4][4]byte
+	for i := 0; i < 4; i++ {
+		px[i] = [4]byte{byte(out[i*4]), byte(out[i*4+1]), byte(out[i*4+2]), byte(out[i*4+3])}
+	}
+	return px, nil
+}
+
+// SetD3D11ZeroCopy toggles the build-time flag (the appsrc carries D3D11Memory BGRA into nvautogpu*enc).
+func (g *GstMediaPipe) SetD3D11ZeroCopy(on bool) { g.D3D11ZeroCopy = on }
+
+// attachD3D11Context gives a pipeline our GstD3D11Device before it goes PLAYING (cgo preambles are
+// per-file, so this wrapper is what lets gstreamer.go reach d11_set_context).
+func attachD3D11Context(p *gst.Pipeline) {
+	if p == nil {
+		return
+	}
+	C.d11_set_context((*C.GstElement)(unsafe.Pointer(p.Instance())))
+}
diff --git a/pkg/worker/media/glzerocopy.go b/pkg/worker/media/glzerocopy.go
new file mode 100644
index 0000000..be84e8e
--- /dev/null
+++ b/pkg/worker/media/glzerocopy.go
@@ -0,0 +1,303 @@
+package media
+
+// GL zero-copy for hardware-rendered libretro cores (n64/gc/ps2/psp/dc).
+//
+// The libretro path used to pull every rendered frame back to system memory with glReadPixels —
+// SYNCHRONOUSLY, on the emulator thread — only to hand it to an appsrc that uploaded it to the GPU
+// again for NVENC. Measured (CLOUD_GAME_GL_READBACK_STATS=1): GameCube renders 1920x1584 (11.6 MB per
+// frame, far larger than the 1280x1056 we actually encode) and the readback blocked the core for a p50
+// of 3.7-4.2 ms — a QUARTER of a 60fps frame budget, up to half at p95.
+//
+// This keeps the frame in VRAM: the core's texture is copied GPU->GPU into a pool (graphics.zerocopy)
+// and pushed as GLMemory. nvav1enc accepts video/x-raw(memory:GLMemory) in RGBA directly, so there is
+// no download, no upload, and no conversion element in between.
+//
+// The context is the delicate part. The core's GL context lives on the emulator thread (a libco
+// cothread). GStreamer runs its GL work on its own thread, so it needs a context that SHARES object
+// space with the core's — otherwise the texture ids we hand it are meaningless. gst_gl_context_new_
+// wrapped() wraps the core's HGLRC without taking it over, and handing that to the pipeline as
+// "gst.gl.app_context" makes GStreamer create its own context shared with it.
+//
+// Cross-thread ordering is a GstGLSyncMeta on every buffer: our thread records a fence after the copy,
+// GStreamer's thread waits on it before the encoder reads. Without it the encoder can read a texture
+// whose copy has not landed — which shows up as intermittent tearing, not a clean failure.
+
+/*
+#cgo pkg-config: gstreamer-1.0 gstreamer-video-1.0 gstreamer-app-1.0 gstreamer-gl-1.0
+#include <gst/gst.h>
+#include <gst/gl/gl.h>
+#include <gst/app/gstappsrc.h>
+#include <gst/video/video.h>
+
+static GstGLDisplay *zc_display = NULL;
+static GstGLContext *zc_wrapped = NULL;   // the CORE's context, wrapped (not ours to drive)
+static GstGLContext *zc_shared  = NULL;   // GStreamer's OWN context, sharing object space with it
+static char zc_err[512] = {0};
+
+// zc_init wraps the core's native GL context. hglrc is the WGL HGLRC (graphics.RGFW.GLHandles).
+static int zc_prepare(void *hglrc) {
+	if (zc_wrapped) return 1;
+	if (!hglrc) return 0;
+
+	zc_display = gst_gl_display_new();
+	if (!zc_display) return 0;
+
+	// GST_GL_API_OPENGL3: the cores request a core-profile 3.x/4.x context (config.GLVersionMajor).
+	zc_wrapped = gst_gl_context_new_wrapped(zc_display, (guintptr) hglrc,
+	                                        GST_GL_PLATFORM_WGL, GST_GL_API_OPENGL3);
+	if (!zc_wrapped) {
+		gst_object_unref(zc_display);
+		zc_display = NULL;
+		return 0;
+	}
+	// Fill in the wrapped context's GL vtable from the current thread (the emulator thread, where the
+	// core's context IS current). Without this GStreamer has no function pointers for it.
+	gst_gl_context_activate(zc_wrapped, TRUE);
+	GError *err = NULL;
+	if (!gst_gl_context_fill_info(zc_wrapped, &err)) {
+		g_snprintf(zc_err, sizeof(zc_err), "fill_info: %s",
+		           err && err->message ? err->message : "failed");
+		if (err) g_error_free(err);
+		gst_gl_context_activate(zc_wrapped, FALSE);
+		gst_object_unref(zc_wrapped);
+		gst_object_unref(zc_display);
+		zc_wrapped = NULL;
+		zc_display = NULL;
+		return 0;
+	}
+	gst_gl_context_activate(zc_wrapped, FALSE);
+	return 1;
+}
+
+// zc_share creates GStreamer's own context, sharing object space with the core's.
+//
+// MUST run with NO GL context current on this thread. GStreamer shares via wglShareLists, and Windows
+// fails that with ERROR_BUSY (0xaa) while either context is CURRENT on a thread — which it is, because
+// we are on the graphics thread the core renders from. Caller brackets this with Unbind/Bind.
+static int zc_share(void) {
+	if (!zc_wrapped) return 0;
+
+	// DO NOT add the wrapped context to the display. That is what makes the elements try to USE it:
+	// nvav1enc calls gst_gl_context_thread_add() on whatever context the display hands out, and a
+	// WRAPPED context has no thread of its own — the call trips
+	//   'context->priv->active_thread == g_thread_self()' failed
+	// and the encoder ends up with "Couldn't get GL context", so not one frame is ever encoded.
+	//
+	// Instead let GStreamer create its OWN context that SHARES object space with the core's. Same
+	// share group => the texture ids from the core's context are valid in it, and it has a real thread,
+	// so the GL elements can drive it normally.
+	GError *cerr = NULL;
+	zc_shared = gst_gl_context_new(zc_display);
+	if (!zc_shared || !gst_gl_context_create(zc_shared, zc_wrapped, &cerr)) {
+		// Report WHY. This failing silently is what made the first attempt look like it worked (the
+		// readback fallback kept video flowing) while the feature was in fact off.
+		g_snprintf(zc_err, sizeof(zc_err), "%s",
+		           cerr && cerr->message ? cerr->message : "gst_gl_context_create failed");
+		if (cerr) g_error_free(cerr);
+		if (zc_shared) { gst_object_unref(zc_shared); zc_shared = NULL; }
+		gst_object_unref(zc_wrapped);
+		gst_object_unref(zc_display);
+		zc_wrapped = NULL;
+		zc_display = NULL;
+		return 0;
+	}
+	gst_gl_display_add_context(zc_display, zc_shared);
+	return 1;
+}
+
+static const char *zc_last_error(void) { return zc_err; }
+
+// zc_tex_released is the GDestroyNotify on every wrapped texture: GStreamer calls it when it frees the
+// buffer, which is the ONLY moment the texture is safe for the core to render over again. Without this
+// the pool just cycles and the encoder ends up reading a texture the core has already overwritten —
+// frames then show FUTURE pixels and snap back (a scrolling marquee jitters back and forth).
+extern void goReleaseZeroCopyTexture(unsigned int texid);
+static void zc_tex_released(gpointer user_data) {
+	goReleaseZeroCopyTexture((unsigned int) (guintptr) user_data);
+}
+
+// zc_set_context gives the pipeline our display + app context, so its GL elements build a context that
+// SHARES with the core's rather than creating an isolated one (whose texture ids would mean nothing).
+static void zc_set_context(GstElement *pipeline) {
+	if (!zc_wrapped || !pipeline) return;
+
+	GstContext *dctx = gst_context_new(GST_GL_DISPLAY_CONTEXT_TYPE, TRUE);
+	gst_context_set_gl_display(dctx, zc_display);
+	gst_element_set_context(pipeline, dctx);
+	gst_context_unref(dctx);
+
+	GstContext *actx = gst_context_new("gst.gl.app_context", TRUE);
+	GstStructure *s = gst_context_writable_structure(actx);
+	gst_structure_set(s, "context", GST_TYPE_GL_CONTEXT, zc_wrapped, NULL);
+	gst_element_set_context(pipeline, actx);
+	gst_context_unref(actx);
+}
+
+// zc_deinit drops our references to the GL contexts. MUST run BEFORE the core's GL context is
+// destroyed: the encoder holds a GL context of its own (shared with the core's), and tearing the core's
+// down first leaves nvcodec doing GL work against a dead share group — which is exactly the
+// "media pipeline teardown wedged (nvcodec set_state hang)" the worker hard-exits on.
+static void zc_deinit(void) {
+	if (zc_shared) { gst_object_unref(zc_shared); zc_shared = NULL; }
+	if (zc_wrapped) { gst_object_unref(zc_wrapped); zc_wrapped = NULL; }
+	if (zc_display) { gst_object_unref(zc_display); zc_display = NULL; }
+}
+
+// zc_push wraps an existing GL texture as a GstBuffer and pushes it. The texture belongs to the pool in
+// graphics.zerocopy — already a GPU-side copy of the core's frame, so the core is free to render the
+// next one immediately.
+static void zc_push(GstAppSrc *src, unsigned int texid, int w, int h, unsigned long long durNs) {
+	if (!zc_shared || !src || !texid) return;
+
+	// Renegotiate the source caps when the core's frame size changes at runtime — the SAME fix
+	// pushVideoBuf (gstreamer.go) already carries for the CPU path, which the GL path needs just as
+	// badly and shipped without. The appsrc caps are fixed at pipeline-build time, so once the core's
+	// geometry diverges we push a buffer whose video meta says 894 into caps that still claim 896;
+	// downstream gst_video_frame_map_id() then asserts 'info->height <= meta->height', the appsrc
+	// errors with "Internal data stream error", and the VIDEO STREAM STOPS FOR THE REST OF THE SESSION
+	// while the emulator runs on at a happy 60fps — a black room, with the core looking perfectly healthy
+	// in every log. (Found 2026-07-14 on PS2 Stuntman, which flips 1280x896 <-> 1280x894 the moment a
+	// save resumes. The CPU path's own comment names the rest of the victims: God of War, Kingdom Hearts,
+	// FFX, Shadow of the Colossus, Monster Hunter — PS2 games switch field/frame height mid-run as a
+	// matter of course, and GL zero-copy is armed for exactly these 3D cores.)
+	//
+	// Only width/height move; format and framerate are preserved. glcolorscale sits between this appsrc
+	// and the video_caps capsfilter that pins the ENCODE geometry, so it simply rescales the new size to
+	// the same output — the encoder never re-inits, and WebRTC never renegotiates. Nothing downstream
+	// can even tell.
+	GstCaps *cur = gst_app_src_get_caps(src);
+	if (cur) {
+		GstStructure *st = gst_caps_get_structure(cur, 0);
+		gint cw = 0, ch = 0;
+		gst_structure_get_int(st, "width", &cw);
+		gst_structure_get_int(st, "height", &ch);
+		if (cw != (gint) w || ch != (gint) h) {
+			g_printerr("[video] gl source caps %dx%d -> %dx%d (core frame size changed)\n", cw, ch, w, h);
+			GstCaps *nc = gst_caps_copy(cur);
+			gst_caps_set_simple(nc, "width", G_TYPE_INT, (gint) w, "height", G_TYPE_INT, (gint) h, NULL);
+			gst_app_src_set_caps(src, nc);
+			gst_caps_unref(nc);
+		}
+		gst_caps_unref(cur);
+	}
+
+	GstVideoInfo vinfo;
+	gst_video_info_set_format(&vinfo, GST_VIDEO_FORMAT_RGBA, w, h);
+
+	// Allocate against the context the PIPELINE drives (zc_shared), not the core's wrapped one. The two
+	// share object space, so this texture id — created in the core's context — is valid here, and every
+	// GL element downstream can operate on it from its own thread.
+	GstGLMemoryAllocator *alloc = gst_gl_memory_allocator_get_default(zc_shared);
+	GstGLVideoAllocationParams *params = gst_gl_video_allocation_params_new_wrapped_texture(
+		zc_shared, NULL, &vinfo, 0, NULL, GST_GL_TEXTURE_TARGET_2D, GST_GL_RGBA,
+		(guint) texid, (gpointer) (guintptr) texid, zc_tex_released);
+	if (!params) { gst_object_unref(alloc); return; }
+
+	// Allocate the ONE plane directly rather than gst_gl_memory_setup_buffer(): that helper wants a
+	// per-plane `wrapped_data` array and asserts 'wrapped_data != NULL' without it (every frame died on
+	// that assertion, silently, and the stream stayed black). RGBA is single-plane, so the base
+	// allocator is both simpler and correct here.
+	GstMemory *mem = (GstMemory *) gst_gl_base_memory_alloc(
+		(GstGLBaseMemoryAllocator *) alloc, (GstGLAllocationParams *) params);
+	gst_gl_allocation_params_free((GstGLAllocationParams *) params);
+	gst_object_unref(alloc);
+	if (!mem) return;
+
+	GstBuffer *buf = gst_buffer_new();
+	gst_buffer_append_memory(buf, mem);
+	gst_buffer_add_video_meta(buf, GST_VIDEO_FRAME_FLAG_NONE, GST_VIDEO_FORMAT_RGBA, w, h);
+
+	GST_BUFFER_DURATION(buf) = durNs;
+
+	// NO GstGLSyncMeta. It looks like the right tool and it is a trap here: set_sync_point() drives
+	// gst_gl_context_thread_add() on the context you give it, and the CORE's context is WRAPPED — it has
+	// no thread of its own, so that trips
+	//   'context->priv->active_thread == g_thread_self()' failed
+	// on every single frame (it spammed a worker to death). Handing it the SHARED context instead would
+	// bounce the fence onto GStreamer's thread, which is not where the copy happened.
+	//
+	// The producer waits instead: graphics.CopyFrameToPool does a glFinish after the GPU->GPU copy, so
+	// the texture is complete before the encoder is ever told about it. That costs a GPU sync on the
+	// emulator thread — but no PCIe transfer, which is the 11 MB/frame this whole path exists to remove.
+	gst_app_src_push_buffer(src, buf);
+
+	// ALWAYS-ON appsrc-depth localization (2026-07-17). Pairs with nanoarch's [zc-stat] "inflight" (total zc
+	// slots held across the WHOLE pipeline): if [zc-stat] shows a deep backlog while this appsrc queue stays
+	// ~0-1, the retention is DOWNSTREAM (encoder input / video_q / RTP pacing / room-start WebRTC ramp-up),
+	// NOT the appsrc — which is exactly why the reverted always-leaky appsrc could not touch it. Every ~600
+	// pushes / 10s so it is free.
+	{
+		static unsigned long long zc_push_n = 0;
+		if ((++zc_push_n % 600) == 0) {
+			guint64 lvlb = 0, lvlbytes = 0;
+			g_object_get(G_OBJECT(src), "current-level-buffers", &lvlb, "current-level-bytes", &lvlbytes, NULL);
+			g_printerr("[zc-appsrc] push#%llu appsrc queue: %llu buffers, %llu bytes (frame %dx%d)\n",
+			           (unsigned long long) zc_push_n, (unsigned long long) lvlb, (unsigned long long) lvlbytes, w, h);
+		}
+	}
+}
+*/
+import "C"
+
+import (
+	"fmt"
+	"unsafe"
+
+	"github.com/giongto35/cloud-game/v3/pkg/worker/caged/libretro/graphics"
+	"github.com/go-gst/go-gst/gst"
+)
+
+//export goReleaseZeroCopyTexture
+func goReleaseZeroCopyTexture(texid C.uint) {
+	graphics.ReleaseZeroCopyTexture(uint32(texid))
+}
+
+// glZeroCopyReady reports whether the GL context has been wrapped successfully.
+func glZeroCopyReady() bool { return C.zc_shared != nil }
+
+// InitGLZeroCopy wraps the core's GL context for GStreamer. MUST be called from the thread where that
+// context is current (the emulator thread) — it reads the GL function pointers out of it.
+func InitGLZeroCopy(hglrc uintptr, unbind func(), rebind func() error) error {
+	if hglrc == 0 {
+		return fmt.Errorf("no native GL context (not a hardware-rendered core?)")
+	}
+	// Phase 1 needs the core's context CURRENT (GStreamer reads its GL function pointers).
+	if C.zc_prepare(unsafe.Pointer(hglrc)) == 0 {
+		return fmt.Errorf("could not wrap the core's GL context: %s", C.GoString(C.zc_last_error()))
+	}
+	// Phase 2 needs it NOT current: sharing goes through wglShareLists, which Windows fails with
+	// ERROR_BUSY (0xaa) if either context is current on any thread. Unbind, share, rebind — and rebind
+	// even on failure, or the core would carry on rendering with no context at all.
+	unbind()
+	ok := C.zc_share() != 0
+	if err := rebind(); err != nil {
+		return fmt.Errorf("could not restore the core's GL context after sharing: %w", err)
+	}
+	if !ok {
+		return fmt.Errorf("could not share a GL context with GStreamer: %s", C.GoString(C.zc_last_error()))
+	}
+	return nil
+}
+
+// DeinitGLZeroCopy releases the GL contexts. Call BEFORE the core's GL context is destroyed — see the
+// note on zc_deinit: the reverse order wedges nvcodec's state change and the worker hard-exits.
+func DeinitGLZeroCopy() { C.zc_deinit() }
+
+// attachGLContext gives a pipeline the core's GL display + context, so its GL elements SHARE object
+// space with the core instead of building an isolated context (in which our texture ids would be
+// meaningless — garbage frames, not an error). cgo preambles are per-file, so this wrapper is what lets
+// gstreamer.go reach it.
+func attachGLContext(p *gst.Pipeline) {
+	if p == nil {
+		return
+	}
+	C.zc_set_context((*C.GstElement)(unsafe.Pointer(p.Instance())))
+}
+
+// pushGLTexture hands one pool texture to the encoder. No download, no upload, no conversion.
+func (g *GstMediaPipe) pushGLTexture(texID uint32, w, h int, durNs uint64) {
+	if g.v == nil || g.v.source == nil {
+		return
+	}
+	C.zc_push(g.v.src(), C.uint(texID), C.int(w), C.int(h), C.ulonglong(durNs))
+}
