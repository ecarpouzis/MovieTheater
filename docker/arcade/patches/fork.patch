+func (c *coordinator) HandleGameStart(rq api.StartGameRequest, w *Worker) api.Out {
+	user := w.router.FindUser(rq.Id)
+	if user == nil {
+		c.log.Error().Msgf("no user [%v]", rq.Id)
+		return api.EmptyPacket
+	}
+	user.Index = rq.PlayerIndex
+
+	r := w.router.FindRoom(rq.Rid)
+
+	// +injects game data into the original game request
+	// the name of the game either in the `room id` field or
+	// it's in the initial request
+	gameName := rq.Game
+	// The room id also carries the SYSTEM the room was minted for, which is what keeps the lookup
+	// on the right ROM when the same game name exists in several systems (it does, 1352 times).
+	system := ""
+	if rq.Rid != "" {
+		name := w.launcher.ExtractAppNameFromUrl(rq.Rid)
+		if name == "" {
+			c.log.Warn().Msg("couldn't decode game name from the room id")
+			return api.EmptyPacket
+		}
+		gameName = name
+		system = w.launcher.ExtractSystemFromUrl(rq.Rid)
+	}
+
+	gameInfo, err := w.launcher.FindApp(system, gameName)
+	if err != nil {
+		c.log.Error().Err(err).Send()
+		return api.EmptyPacket
+	}
+
+	if r == nil { // new room
+		uid := rq.Rid
+		if uid == "" {
+			uid = games.GenerateRoomID(gameName)
+		}
+		game := games.GameMetadata(gameInfo)
+
+		r = room.NewRoom(uid, nil, w.router.Users(), nil)
+		r.HandleClose = func() {
+			c.CloseRoom(uid)
+			c.log.Debug().Msgf("room close request %v sent", uid)
+		}
+
+		if other := w.router.Room(); other != nil {
+			c.log.Error().Msgf("concurrent room creation: %v / %v", uid, w.router.Room().Id())
+			return api.EmptyPacket
+		}
+
+		w.router.SetRoom(r)
+		c.log.Info().Str("room", r.Id()).Str("game", game.Name).Msg("New room")
+
+		// Per-room encoder quality (arcade per-room bitrate/FEC) — SHARED by both lanes. The creator's
+		// t=104 carries an optional video bitrate (kbps) + opus FEC + codec. WithOverrides applies them
+		// to a per-room COPY of the encoder config (deep-copies the codec map, never mutating the shared
+		// config) so concurrent rooms don't affect each other. No-op when all are unset.
+		roomCodec := w.roomVideoCodec(rq.VideoCodec)
+		encConf := w.conf.Encoder.WithOverrides(rq.VideoBitrate, rq.AudioFec, roomCodec)
+		if rq.VideoBitrate > 0 || rq.AudioFec != 0 || rq.VideoCodec != "" {
+			w.log.Info().Msgf("Per-room encoder overrides: bitrate=%d kbps fec=%d codec=%s", rq.VideoBitrate, rq.AudioFec, roomCodec)
+		}
+		// Per-room in-frame packet pacing (patch 0028): set unconditionally so a no-pacing room can
+		// never inherit the previous room's window. One worker hosts one room.
+		webrtc.SetPacing(rq.Pace)
+		if rq.Pace > 0 {
+			w.log.Info().Msgf("Per-room pacing: %d ms in-frame smoothing", rq.Pace)
+		}
+		m := media.NewGstreamer(encConf, w.log)
+
+		// Temporal SVC (svc.go): tell the send path how many layers this room's encoder emits, so it
+		// can drop upper layers per-peer. Set unconditionally, like SetPacing above — a non-layered
+		// room must never inherit the previous room's layer count and start dropping frames that were
+		// never produced. One worker hosts one room.
+		layers := m.TemporalLayers()
+		webrtc.SetTemporalLayers(layers)
+		if layers > 1 {
+			w.log.Info().Msgf("Temporal SVC: %d layers (weak peers get fewer frames, not a worse room)", layers)
+		}
+
+		if gameInfo.System == caged.CaptureSystem {
+			// Heavy browser lane (capture mod): launch a native program + capture the desktop through
+			// the gateway heavy contract. No libretro frontend/cheats/cloud-save/VideoChangeCb — the
+			// capture size is fixed. r.SetApp accepts any app.App.
+			capApp, ok := w.mana.Get(caged.Capture).(*capture.App)
+			if !ok || capApp == nil {
+				c.log.Error().Msg("capture start on a non-capture worker (zone misroute)")
+				r.Close()
+				w.router.SetRoom(nil)
+				return api.EmptyPacket
+			}
+			// P4 zero-copy: hand the media pipe the capture chain to use INSTEAD of its appsrc, so the
+			// frame goes capture → GPU convert → NVENC without ever touching system memory. The encoder
+			// stays where it was, so ABR (SetVideoBitrate), the per-room codec (encConf, applied above)
+			// and forced keyframes all keep working against the same `video_enc` element — only the
+			// keyframe CLOCK moves (to the encoded-frame side; see media.maybeForceKeyframe).
+			// The gate is how the app blanks the desktop, since no frame passes through Go to gate.
+			if capApp.ZeroCopy() {
+				m.VideoSrcChain = capApp.VideoSrcChain(encConf.Video.Colorimetry)
+				capApp.SetVideoGate(m.SetVideoValveDrop)
+			}
+			r.SetApp(capApp)
+			if err := capApp.LoadApp(gameName, uid); err != nil {
+				c.log.Error().Err(err).Msg("capture prepare/launch failed")
+				r.Close()
+				w.router.SetRoom(nil)
+				return api.EmptyPacket
+			}
+		} else {
+			// start the emulator (libretro lane)
+			app := room.WithEmulator(w.mana.Get(caged.Libretro))
+			app.ReloadFrontend()
+			app.SetSessionId(uid)
+			app.SetSaveOnClose(true)
+			app.EnableCloudStorage(uid, w.storage)
+			app.EnableRecording(rq.Record, rq.RecordUser, gameName)
+
+			// Per-room cheats: MUST be set before app.Load. Called UNCONDITIONALLY — nanoarch is a
+			// process-wide singleton, so a room with no cheats clears the previous room's staging.
+			app.SetRoomCheats(rq.CoreOptions, rq.Cheats)
+			if len(rq.CoreOptions) > 0 || len(rq.Cheats) > 0 {
+				w.log.Info().Msgf("Per-room cheats: %d core option(s), %d code(s)", len(rq.CoreOptions), len(rq.Cheats))
+			}
+
+			r.SetApp(app)
+
+			// GL ZERO-COPY — ARMED HERE, BEFORE app.Load, AND THAT IS THE WHOLE POINT.
+			//
+			// The core's GL context is created during LOAD (retro_hw_render -> initVideo), and the hook
+			// below is what wraps it for GStreamer. Setting this up after the load — down with the rest
+			// of the media finalize, which is where it naturally wants to live — means the context is
+			// already gone past: GLContextReady is still nil when initVideo runs, GStreamer never gets a
+			// GL context, and we then push texture ids into a pipeline that cannot resolve them. That
+			// is not a clean failure. It is a black stream and an nvcodec teardown hang (seen, 18:12).
+			//
+			// Scoped to HARDWARE-rendered libretro cores: a software core's frame is already in system
+			// memory (nothing to keep on the GPU), and the capture lane has its own zero-copy.
+			glZC := w.conf.Emulator.GlZeroCopy &&
+				w.conf.Emulator.GetLibretroCoreConfig(game.System).IsGlAllowed
+			nanoarch.Nan0.GLZeroCopy = glZC
+			m.GLZeroCopy = glZC
+			// ORDER IS THE WHOLE BUG. Room.Close() runs app.Close() (which destroys the core's GL
+			// context) and only THEN media.Destroy(). With GL zero-copy the encoder holds a GL context
+			// SHARED with the core's, so that order leaves nvcodec doing GL work against a dead share
+			// group — its state change never returns, and the worker hard-exits every single room close
+			// ("media pipeline teardown wedged (nvcodec set_state hang)").
+			//
+			// So tear the PIPELINE down first, from inside the core's own teardown, before its GL
+			// context goes away. media.Destroy() is bounded and safe to call again from Room.Close().
+			nanoarch.GLContextGone = func() {
+				m.Destroy()
+				media.DeinitGLZeroCopy()
+			}
+			nanoarch.GLContextReady = func(glrc uintptr, unbind func(), rebind func() error) error {
+				if err := media.InitGLZeroCopy(glrc, unbind, rebind); err != nil {
+					// nanoarch clears Nan0.GLZeroCopy on error; clear the media side too, or the
+					// pipeline would be built for GL frames that will never come.
+					m.GLZeroCopy = false
+					return err
+				}
+				return nil
+			}
+			if glZC {
+				w.log.Info().Msgf("GL zero-copy armed for %s (no glReadPixels)", game.System)
+			}
+
+			// recreate the video encoder when the core's frame size changes at runtime
+			app.VideoChangeCb(func() {
+				app.ViewportRecalculate()
+				m.VideoW, m.VideoH = app.ViewportSize()
+				m.VideoScale, m.ScaleMethod = app.Scale()
+
+				if err := m.Reinit(); err != nil {
+					c.log.Error().Err(err).Msgf("reinit fail")
+				}
+
+				data, err := api.Wrap(api.Out{
+					T: uint8(api.AppVideoChange),
+					Payload: api.AppVideoInfo{
+						W:    m.VideoW,
+						H:    m.VideoH,
+						A:    app.AspectRatio(),
+						S:    int(m.VideoScale),
+						SM:   m.ScaleMethod,
+						Flip: app.Flipped(),
+						Rot:  app.Rotation(),
+					}})
+				if err != nil {
+					c.log.Error().Err(err).Msgf("wrap")
+				}
+				r.Send(data)
+			})
+
+			w.log.Info().Msgf("Starting the game: %v", gameName)
+			if err := app.Load(game, w.conf.Library.BasePath); err != nil {
+				c.log.Error().Err(err).Msgf("couldn't load the game %v", game)
+				r.Close()
+				w.router.SetRoom(nil)
+				return api.EmptyPacket
+			}
+		}
+
+		// Media finalize — SHARED by both lanes, read through the app.App interface. FPS() is not on
+		// the interface (concrete on both apps), so it's fetched via a tiny local interface.
+		ap := r.App()
+		m.AudioSrcHz = ap.AudioSampleRate()
+		m.VideoW, m.VideoH = ap.ViewportSize()
+		m.VideoScale, m.ScaleMethod = ap.Scale()
+		coreConf := w.conf.Emulator.GetLibretroCoreConfig(game.System) // zero-value for "capture"
+		m.MaxThreads = coreConf.MaxThreads
+		if f, ok := ap.(interface{ FPS() float64 }); ok {
+			m.VideoFPS = f.FPS()
+		}
+		m.VideoVFR = coreConf.VFR
+
+		m.SetPixFmt(ap.PixFormat())
+		m.SetRot(ap.Rotation())
+
+		r.SetMedia(m)
+
+		if err := m.Init(); err != nil {
+			c.log.Error().Err(err).Msgf("couldn't init the media")
+			r.Close()
+			w.router.SetRoom(nil)
+			return api.EmptyPacket
+		}
+
+		r.InitMedia()
+		r.StartApp()
+
+		// Adaptive bitrate (patch 0021). The room's chosen quality becomes the CEILING; ABR moves the
+		// encoder between a floor and that ceiling from the worst peer's send-side estimate. Costs one
+		// GObject property set per rung — no rebuild, no reneg. See pkg/worker/abr.go.
+		abrCeiling := rq.VideoBitrate
+		if abrCeiling <= 0 {
+			abrCeiling = encConf.VideoBitrateKbps()
+		}
+		startRoomAbr(w.log, r, m, abrCeiling)
+	}
+
+	needsKbMouse := r.App().KbMouseSupport()
+
+	s := room.WithWebRTC(user.Session)
+	s.OnMessage(func(data []byte) { r.App().Input(user.Index, byte(caged.RetroPad), data) })
+	if needsKbMouse {
+		_, _ = s.Channel("keyboard", nil, func(data []byte) { r.App().Input(user.Index, byte(caged.Keyboard), data) })
+		_, _ = s.Channel("mouse", nil, func(data []byte) { r.App().Input(user.Index, byte(caged.Mouse), data) })
+	}
+	// patch 0005: multi-disc swap. The browser opens a "disc" channel and sends a 1-byte target image
+	// index; the frontend applies it on the emulator thread. No-op for cores without disk control.
+	if disc, ok := r.App().(interface{ RequestDisk(int) }); ok {
+		_, _ = s.Channel("disc", nil, func(data []byte) {
+			if len(data) >= 1 {
+				disc.RequestDisk(int(data[0]))
+			}
+		})
+	}
+
+	c.RegisterRoom(r.Id())
+
+	response := api.StartGameResponse{
+		Room:    api.Room{Rid: r.Id()},
+		Record:  w.conf.Recording.Enabled,
+		KbMouse: needsKbMouse,
+	}
+
+	if r.App().AspectEnabled() {
+		ww, hh := r.App().ViewportSize()
+		scale, scaleM := r.App().Scale()
+		response.AV = &api.AppVideoInfo{
+			W:    ww,
+			H:    hh,
+			A:    r.App().AspectRatio(),
+			S:    int(scale),
+			SM:   scaleM,
+			Flip: r.App().Flipped(),
+			Rot:  r.App().Rotation(),
+		}
+	}
+
+	return api.Out{Payload: response}
+}
