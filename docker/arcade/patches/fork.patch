+func TestCopyGlobVaultsTheCardAndNotTheBios(t *testing.T) {
+	dir := dcDir(t, "card")
+	vault := filepath.Join(t.TempDir(), "1", "dc")
+	if err := CopyGlob(dir, "vmu_save_*.bin", vault); err != nil {
+		t.Fatal(err)
+	}
+	if read(t, filepath.Join(vault, "vmu_save_A1.bin")) != "cardA1" {
+		t.Fatal("the VMU did not reach the vault")
+	}
+	if Exists(filepath.Join(vault, "dc_boot.bin")) || Exists(filepath.Join(vault, "data")) {
+		t.Fatal("the BIOS was copied into the player's vault")
+	}
+}
+
+func TestClearGlobLeavesTheBiosIntact(t *testing.T) {
+	dir := dcDir(t, "card")
+	if err := ClearGlob(dir, "vmu_save_*.bin"); err != nil {
+		t.Fatal(err)
+	}
+	if Exists(filepath.Join(dir, "vmu_save_A1.bin")) {
+		t.Fatal("the VMU survived the clear — the next player would inherit it")
+	}
+	if read(t, filepath.Join(dir, "dc_boot.bin")) != "BIOS" ||
+		read(t, filepath.Join(dir, "data", "syscalls.bin")) != "DATA" {
+		t.Fatal("clearing the card destroyed the BIOS")
+	}
+}
+
+// Seeding player B over player A's session must leave B holding B's card only — and must not
+// resurrect a VMU that B's vault doesn't have (A's C1 slot must not linger).
+func TestReplaceGlobSwapsPlayersWithoutBleed(t *testing.T) {
+	dir := dcDir(t, "playerA")
+	write(t, filepath.Join(dir, "vmu_save_C1.bin"), "playerA-C1")
+
+	vaultB := filepath.Join(t.TempDir(), "31", "dc")
+	write(t, filepath.Join(vaultB, "vmu_save_A1.bin"), "playerB-A1")
+
+	if err := ReplaceGlob(vaultB, "vmu_save_*.bin", dir); err != nil {
+		t.Fatal(err)
+	}
+	if got := read(t, filepath.Join(dir, "vmu_save_A1.bin")); got != "playerB-A1" {
+		t.Fatalf("player B's card was not seeded, got %q", got)
+	}
+	if Exists(filepath.Join(dir, "vmu_save_C1.bin")) || Exists(filepath.Join(dir, "vmu_save_B1.bin")) {
+		t.Fatal("player A's VMU leaked into player B's session")
+	}
+	if read(t, filepath.Join(dir, "dc_boot.bin")) != "BIOS" {
+		t.Fatal("seeding a card overwrote the BIOS")
+	}
+}
+
+// A pattern with a path separator is a config bug (it would escape the card dir): refuse it.
+func TestGlobFilesRefusesAPathPattern(t *testing.T) {
+	if _, err := GlobFiles(t.TempDir(), "../*.bin"); err == nil {
+		t.Fatal("a pattern containing a path separator must be refused")
+	}
+}
+
+// ── Vaulting rules (patch 0041) ─────────────────────────────────────────────────────────────────
+
+func touch(t *testing.T, path string, age time.Duration) {
+	t.Helper()
+	when := time.Now().Add(-age)
+	if err := os.Chtimes(path, when, when); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// The scenario this exists for: flycast dies on teardown, leaving player 33's card stranded on
+// worker 1. They rejoin, land on worker 2, play on, and their vault card moves ahead. Later, some
+// unrelated Dreamcast room runs on worker 1 and recovers the stranded card. That recovery must NOT
+// drag their progress backwards.
+func TestVaultNeverOverwritesANewerCardWithAStaleOne(t *testing.T) {
+	stranded, vault := t.TempDir(), t.TempDir()
+	write(t, filepath.Join(stranded, "vmu_save_A1.bin"), "old-stranded-card")
+	touch(t, filepath.Join(stranded, "vmu_save_A1.bin"), time.Hour)
+
+	write(t, filepath.Join(vault, "vmu_save_A1.bin"), "newer-card-from-worker-2")
+	touch(t, filepath.Join(vault, "vmu_save_A1.bin"), time.Minute)
+
+	if err := CopyGlobNewer(stranded, "vmu_save_*.bin", vault); err != nil {
+		t.Fatal(err)
+	}
+	if got := read(t, filepath.Join(vault, "vmu_save_A1.bin")); got != "newer-card-from-worker-2" {
+		t.Fatalf("a stale stranded card overwrote newer progress: %q", got)
+	}
+}
+
+func TestVaultTakesTheCardWhenItIsNewer(t *testing.T) {
+	dir, vault := t.TempDir(), t.TempDir()
+	write(t, filepath.Join(vault, "vmu_save_A1.bin"), "yesterday")
+	touch(t, filepath.Join(vault, "vmu_save_A1.bin"), time.Hour)
+	write(t, filepath.Join(dir, "vmu_save_A1.bin"), "just-saved")
+
+	if err := CopyGlobNewer(dir, "vmu_save_*.bin", vault); err != nil {
+		t.Fatal(err)
+	}
+	if got := read(t, filepath.Join(vault, "vmu_save_A1.bin")); got != "just-saved" {
+		t.Fatalf("a newer card was not vaulted: %q", got)
+	}
+}
+
+// A live harvest can land mid-write. We do not GUESS that a quiet file is a finished file — we copy
+// it and then ASK whether it changed under us. These two tests pin that check and its consequence.
+func TestUnchangedDetectsACoreWritingUnderUs(t *testing.T) {
+	dir := t.TempDir()
+	card := filepath.Join(dir, "vmu_save_A1.bin")
+	write(t, card, "state-A")
+	before, err := os.Stat(card)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !Unchanged(before, before) {
+		t.Fatal("a file must compare equal to itself")
+	}
+
+	write(t, card, "state-B-longer") // the core saves again while we were reading
+	after, err := os.Stat(card)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if Unchanged(before, after) {
+		t.Fatal("a card rewritten mid-copy was reported as unchanged — a torn card would reach the vault")
+	}
+}
+
+// A completed harvest leaves the vault holding the card and no scratch file behind (the copy lands
+// via a .part rename, so the vault can never be caught holding half a card).
+func TestVaultHarvestLeavesNoScratchFile(t *testing.T) {
+	dir, vault := t.TempDir(), t.TempDir()
+	write(t, filepath.Join(dir, "vmu_save_A1.bin"), "finished-card")
+	if err := CopyGlobNewer(dir, "vmu_save_*.bin", vault); err != nil {
+		t.Fatal(err)
+	}
+	if got := read(t, filepath.Join(vault, "vmu_save_A1.bin")); got != "finished-card" {
+		t.Fatalf("card did not reach the vault: %q", got)
+	}
+	if Exists(filepath.Join(vault, "vmu_save_A1.bin.part")) {
+		t.Fatal("a .part scratch file survived into the vault")
+	}
+}
+
+// CopyFile must carry mtime across, or every newer-wins comparison above is meaningless.
+func TestCopyFilePreservesModTime(t *testing.T) {
+	dir := t.TempDir()
+	src, dst := filepath.Join(dir, "a"), filepath.Join(dir, "b")
+	write(t, src, "x")
+	touch(t, src, time.Hour)
+	if err := CopyFile(src, dst); err != nil {
+		t.Fatal(err)
+	}
+	s, _ := os.Stat(src)
+	d, _ := os.Stat(dst)
+	if !s.ModTime().Equal(d.ModTime()) {
+		t.Fatalf("mtime not preserved: src %v dst %v", s.ModTime(), d.ModTime())
+	}
+}
+
+// The directory-shaped cards (gc, ps2) go through the same rules.
+func TestCopyTreeNewerProtectsTheVault(t *testing.T) {
+	dir, vault := t.TempDir(), t.TempDir()
+	card := filepath.Join("USA", "Card A", "gauntlet.gci")
+	write(t, filepath.Join(vault, card), "newer-characters")
+	touch(t, filepath.Join(vault, card), time.Minute)
+	write(t, filepath.Join(dir, card), "older-stranded")
+	touch(t, filepath.Join(dir, card), time.Hour)
+
+	if err := CopyTreeNewer(dir, vault); err != nil {
+		t.Fatal(err)
+	}
+	if got := read(t, filepath.Join(vault, card)); got != "newer-characters" {
+		t.Fatalf("stale GameCube card overwrote newer progress: %q", got)
+	}
+}
diff --git a/pkg/worker/abr.go b/pkg/worker/abr.go
new file mode 100644
index 0000000..8d095a2
--- /dev/null
+++ b/pkg/worker/abr.go
@@ -0,0 +1,256 @@
+package worker
+
+import (
+	"time"
+
+	"github.com/giongto35/cloud-game/v3/pkg/logger"
+	"github.com/giongto35/cloud-game/v3/pkg/network/webrtc"
+	"github.com/giongto35/cloud-game/v3/pkg/worker/media"
+	"github.com/giongto35/cloud-game/v3/pkg/worker/room"
+)
+
+// Adaptive bitrate for a room's single video encoder (arcade ABR, patch 0021; temporal SVC 0042).
+//
+// Why this is cheap: nvav1enc's `bitrate` is "changeable in the PLAYING state", so a rung costs one
+// property set — no pipeline rebuild, no renegotiation, no reconnect, nothing the player sees. Only
+// bitrate is adapted; changing RESOLUTION would re-init the pipeline (a visible glitch), so we don't.
+//
+// Why we probe upward instead of trusting the estimate: GCC is a congestion DETECTOR. Its estimate can
+// never exceed what we actually send (you cannot measure capacity you never use), so simply following
+// the estimate would pin the room forever at its starting bitrate. Instead we treat "estimate is
+// keeping up with what we send" as permission to send more, and back off hard the moment it isn't.
+//
+// ── What temporal SVC changed ──────────────────────────────────────────────────────────────────────
+// This loop used to drive the encoder from the WORST peer's estimate, because one encoder serves the
+// whole room: a single friend on hotel wifi throttled everyone. That is no longer inherent.
+//
+// With a layered encoder (svc.go) each peer can be fed a DIFFERENT SUBSET of the same stream, so a
+// weak peer takes fewer frames instead of forcing a worse picture on everybody. Two consequences:
+//
+//  1. The room bitrate follows the peers we can actually SERVE at their assigned layer. A peer that
+//     has been dropped to base layer no longer vetoes the room's quality, because the bits it
+//     receives are already only ~28% of what we send.
+//  2. A peer drags the room down only when even the BASE layer will not fit down its link. Then we do
+//     lower the room — but only to what base layer needs (estimate / baseShare), which is ~3.5x
+//     higher than the old "drop the room to the worst estimate" behaviour.
+const (
+	abrTick = time.Second
+
+	abrFloorKbps = 1500 // below this the picture is worse than a stall; give up adapting
+	abrStartKbps = 6000 // conservative opener; a healthy LAN reaches a 14 Mbps ceiling in ~7 ticks
+
+	abrRampPct    = 15 // healthy: raise the target by this much per tick
+	abrHealthyPct = 95 // estimate >= 95% of what that peer RECEIVES => its link is keeping up
+	abrBackoffPct = 85 // estimate <  85% of what that peer RECEIVES => congestion
+
+	abrMinStepKbps = 250 // don't bother with changes smaller than this
+
+	// Temporal-layer hysteresis. The gap between these two is a DEAD BAND in which a peer simply keeps
+	// the layer it has, and it has to be wide: a layer change halves (or doubles) the frame rate, which
+	// is enormously more visible than a bitrate rung. Narrow thresholds made a healthy peer oscillate
+	// 60->30->60 fps every few seconds — a stuttering game, and worse than anything it was avoiding.
+	abrLayerDownPct = 85  // drop a layer only when the estimate is <85% of what this peer RECEIVES
+	abrLayerUpPct   = 125 // climb only with 25% headroom over what the higher layer would cost
+	// ...and a drop must persist. One bad tick is noise (we send unpaced, so GCC misreads microbursts);
+	// two in a row is a link.
+	abrLayerDownTicks = 2
+)
+
+// layerShare[n][l] = the percentage of the encoder's bitrate a peer receives when it is fed temporal
+// layers 0..l of an n-layer stream. Measured off nvav1enc (see svc.go). These shift with content, so
+// they are used only to CHOOSE a layer and are re-checked every tick against the peer's real
+// estimate — an over-optimistic share costs one extra tick of backoff, not a broken stream.
+var layerShare = map[int][]int{
+	1: {100},
+	2: {53, 100},
+	3: {28, 54, 100},
+}
+
+// svcPeer is the slice of *webrtc.Peer that ABR needs. An interface so this package does not depend
+// on the concrete session type (and a peer without an estimator is simply skipped).
+type svcPeer interface {
+	TargetBitrateKbps() int
+	SetMaxTemporalLayer(int)
+	MaxTemporalLayer() int
+}
+
+// pickLayer returns the highest temporal layer whose share of `sendKbps` fits inside `estKbps`, and
+// whether even the base layer does not fit.
+//
+// Hysteresis: dropping a layer HALVES a peer's frame rate, which is far more visible than a bitrate
+// rung, so we refuse to do it on a marginal reading. Going DOWN needs the peer to be over budget
+// outright; coming back UP needs the higher layer to fit with 20% headroom. Without that gap a peer
+// parked near a boundary oscillates 60->30->60 fps every second, which looks worse than just staying
+// at 30.
+func pickLayer(layers, current, sendKbps, estKbps int) (layer int, starved bool) {
+	share := layerShare[layers]
+	if share == nil || estKbps <= 0 {
+		return current, false
+	}
+	for l := layers - 1; l >= 0; l-- {
+		need := sendKbps * share[l] / 100
+		switch {
+		case l > current:
+			// Climbing costs a re-sync of nothing, but flapping costs everything — see below.
+			need = need * abrLayerUpPct / 100
+		case l == current:
+			// STAYING PUT is the default, and the bar for leaving is deliberately low. A peer only
+			// drops a layer when it is MEANINGFULLY over budget, not merely a few percent under what we
+			// send — GCC's estimate wanders around the send rate constantly, that is what it does.
+			//
+			// This was a real bug, live: a peer estimating 13225 against 13875 sent (95% — which the
+			// bitrate loop below calls HEALTHY) had its frame rate halved, then restored, then halved,
+			// every few seconds. Dropping a layer halves the frame rate, so a flapping layer is a
+			// FAR worse artifact than the bitrate dip it was reacting to: it reads as a stuttering game
+			// and it is the single most visible thing this file can do wrong.
+			need = need * abrLayerDownPct / 100
+		}
+		if need <= estKbps {
+			return l, false
+		}
+	}
+	return 0, true // even base layer does not fit
+}
+
+// startRoomAbr drives the room's encoder bitrate, and each peer's temporal layer, from the peers'
+// send-side estimates. ceilKbps is the room's chosen quality (the creator's t=104 bitrate, else the
+// config default): ABR never exceeds it, so "Auto" on the site still decides how good a room may look.
+func startRoomAbr(log *logger.Logger, r *room.Room[*room.GameSession], m *media.GstMediaPipe, ceilKbps int) {
+	if ceilKbps <= 0 || r == nil || m == nil {
+		return
+	}
+	floor := min(abrFloorKbps, ceilKbps)
+	cur := min(max(abrStartKbps, floor), ceilKbps)
+
+	if err := m.SetVideoBitrate(cur); err != nil {
+		log.Warn().Err(err).Msg("abr: encoder rejected the initial bitrate; ABR disabled for this room")
+		return
+	}
+	layers := webrtc.TemporalLayers()
+	if layers < 1 || layerShare[layers] == nil {
+		layers = 1 // not layered (or a layer count we have no shares for): behave exactly as before
+	}
+	log.Info().Msgf("abr: start %d kbps (floor %d, ceiling %d, temporal layers %d)",
+		cur, floor, ceilKbps, layers)
+
+	go func() {
+		t := time.NewTicker(abrTick)
+		defer t.Stop()
+		// Consecutive below-threshold ticks (patch 0026). We send UNPACED on purpose (NoOpPacer —
+		// pacing is queued latency), so every encoded frame leaves as a microburst and GCC's
+		// delay-based detector occasionally reads one as congestion even on idle wired gigabit
+		// (measured: a single-tick 11000->7828 dip on an ethernet LAN with a direct host pair).
+		// Requiring TWO consecutive low ticks makes those one-tick artifacts invisible; genuine
+		// congestion still backs off, one second later.
+		lowTicks := 0
+		// Consecutive over-budget ticks per peer, for temporal-layer DROPS only (see below). Lives in
+		// this goroutine, so no locking; peers that leave the room simply stop being iterated.
+		layerDown := map[svcPeer]int{}
+		for range t.C {
+			if r.Closed() {
+				log.Debug().Msg("abr: room closed")
+				return
+			}
+
+			// worstServable: the tightest estimate among peers we can still serve at their assigned
+			// layer, expressed in ROOM terms (scaled back up by the share they receive). That is what
+			// the room bitrate must respect.
+			// roomCap: a hard ceiling contributed by any STARVED peer (one for whom not even the base
+			// layer fits) — set to what base layer alone would need.
+			worstServable, roomCap, peers := 0, 0, 0
+			for u := range r.Users().Values() {
+				p, ok := u.Session.(svcPeer)
+				if !ok {
+					continue
+				}
+				// 0 = not connected yet, or no TWCC feedback has arrived. Not an opinion.
+				est := p.TargetBitrateKbps()
+				if est <= 0 {
+					continue
+				}
+				peers++
+
+				now := p.MaxTemporalLayer()
+				layer, starved := pickLayer(layers, now, cur, est)
+				if layers > 1 && layer != now {
+					// A DROP must persist for abrLayerDownTicks before we act on it. We send unpaced on
+					// purpose, so every encoded frame leaves as a microburst and GCC occasionally reads
+					// one as congestion even on idle gigabit — and unlike a bitrate rung, acting on that
+					// noise halves the player's frame rate. Climbing back up needs no confirmation: it
+					// already carries a 25% headroom requirement, and being early to restore 60fps is
+					// not a defect.
+					if layer < now {
+						layerDown[p]++
+						if layerDown[p] < abrLayerDownTicks {
+							continue
+						}
+					}
+					delete(layerDown, p)
+					log.Info().Msgf("abr: peer layer %d -> %d (estimate %d kbps, room sends %d)",
+						now, layer, est, cur)
+					p.SetMaxTemporalLayer(layer)
+				} else {
+					delete(layerDown, p) // it recovered on its own; forget the bad tick
+				}
+
+				if starved {
+					// Even the base layer is too much for this link. Lower the room only to what BASE
+					// needs — not to this peer's raw estimate. Everyone else keeps the layers above.
+					need := est * 100 / layerShare[layers][0]
+					if roomCap == 0 || need < roomCap {
+						roomCap = need
+					}
+					continue
+				}
+				// This peer is served at `layer`, so it receives only a fraction of what we send.
+				// Judge its health against THAT, not against the full room bitrate: scale its estimate
+				// back up into room terms so one comparison works for every peer.
+				share := layerShare[layers][layer]
+				effective := est * 100 / max(share, 1)
+				if worstServable == 0 || effective < worstServable {
+					worstServable = effective
+				}
+			}
+			if peers == 0 {
+				continue // hold: nobody has told us anything yet
+			}
+
+			next := cur
+			switch {
+			case worstServable > 0 && worstServable*100 < cur*abrBackoffPct:
+				lowTicks++
+				if lowTicks >= 2 { // confirmed congestion
+					next = worstServable
+				}
+			case worstServable > 0 && worstServable*100 >= cur*abrHealthyPct && cur < ceilKbps:
+				lowTicks = 0
+				next = cur + max(abrMinStepKbps, cur*abrRampPct/100) // healthy: probe upward
+			default:
+				lowTicks = 0
+			}
+			// A starved peer's base-layer requirement is a hard ceiling on the room.
+			if roomCap > 0 {
+				next = min(next, roomCap)
+			}
+			next = min(max(next, floor), ceilKbps)
+
+			if next == cur || abs(next-cur) < abrMinStepKbps {
+				continue
+			}
+			if err := m.SetVideoBitrate(next); err != nil {
+				log.Warn().Err(err).Msgf("abr: failed to set %d kbps", next)
+				continue
+			}
+			log.Info().Msgf("abr: %d -> %d kbps (servable %d, starved-cap %d, ceiling %d, peers %d)",
+				cur, next, worstServable, roomCap, ceilKbps, peers)
+			cur = next
+		}
+	}()
+}
+
+func abs(n int) int {
+	if n < 0 {
+		return -n
+	}
+	return n
+}
diff --git a/pkg/worker/abr_test.go b/pkg/worker/abr_test.go
new file mode 100644
index 0000000..03dffe0
--- /dev/null
+++ b/pkg/worker/abr_test.go
@@ -0,0 +1,73 @@
+package worker
+
+import "testing"
+
+// 3-layer shares: base 28% / +mid 54% / full 100% of the room bitrate.
+func TestPickLayer(t *testing.T) {
+	const layers, send = 3, 10000 // room sends 10 Mbps
+
+	tests := []struct {
+		name        string
+		current     int
+		est         int
+		wantLayer   int
+		wantStarved bool
+	}{
+		// A healthy peer takes everything.
+		{"fat pipe keeps all layers", 2, 12000, 2, false},
+		{"exactly enough for full", 2, 10000, 2, false},
+
+		// 6 Mbps cannot carry the full 10 Mbps stream, but carries layers 0-1 (5.4 Mbps) fine. THIS is
+		// the case the whole feature exists for: before SVC this peer dragged the room to 6 Mbps.
+		{"mid link drops to layer 1", 2, 6000, 1, false},
+
+		// 3 Mbps: only the base layer (2.8 Mbps) fits.
+		{"weak link drops to base", 2, 3000, 0, false},
+
+		// Below even the base layer -> starved. The room must come down for this one.
+		{"starved", 2, 1000, 0, true},
+
+		// Hysteresis — a DEAD BAND, in both directions.
+		//
+		// A peer sitting at layer 1 needs the full layer (10 Mbps) plus 25% headroom (12.5 Mbps) before
+		// climbing back to 2; at 10.5 it stays put.
+		{"no climb without headroom", 1, 10500, 1, false},
+		{"climbs with headroom", 1, 12500, 2, false},
+
+		// ...and it does NOT drop just because the estimate dipped a little below what we send. This is
+		// the regression that shipped: a peer at 9000 against 10000 sent (90%) had its frame rate halved,
+		// restored, halved again every few seconds — the game visibly stuttered. A layer change halves
+		// the FRAME RATE, so it must cost more than a marginal reading. Only <85% moves it.
+		{"holds its layer on a shallow dip (was: flapped 60->30->60)", 2, 9000, 2, false},
+		{"drops when genuinely over budget", 2, 8000, 1, false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			layer, starved := pickLayer(layers, tc.current, send, tc.est)
+			if layer != tc.wantLayer || starved != tc.wantStarved {
+				t.Errorf("pickLayer(cur=%d, est=%d) = (layer %d, starved %v), want (layer %d, starved %v)",
+					tc.current, tc.est, layer, starved, tc.wantLayer, tc.wantStarved)
+			}
+		})
+	}
+}
+
+// With SVC off, no peer may ever be capped below the only layer that exists.
+func TestPickLayerSVCOff(t *testing.T) {
+	layer, starved := pickLayer(1, 0, 10000, 500) // 1 layer, hopeless estimate
+	if layer != 0 {
+		t.Errorf("layer = %d, want 0 (the only layer)", layer)
+	}
+	if !starved {
+		t.Errorf("a peer that cannot carry the single layer should read as starved (room must drop)")
+	}
+}
+
+// An unknown layer count must not panic or silently cap peers.
+func TestPickLayerUnknownLayerCount(t *testing.T) {
+	layer, starved := pickLayer(99, 2, 10000, 100)
+	if layer != 2 || starved {
+		t.Errorf("unknown layer count should hold current layer, got (%d, %v)", layer, starved)
+	}
+}
