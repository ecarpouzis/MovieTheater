+		genRenderbuffers(1, &rbo)
+		bindRenderbuffer(gl_RENDERBUFFER, rbo)
+		format, attachment := uint32(gl_DEPTH_COMPONENT24), uint32(gl_DEPTH_ATTACHMENT)
+		if stencil {
+			format, attachment = gl_DEPTH24_STENCIL8, gl_DEPTH_STENCIL_ATTACH
+		}
+		renderbufferStorage(gl_RENDERBUFFER, format, w, h)
+		framebufferRenderbuffer(gl_FRAMEBUFFER, attachment, gl_RENDERBUFFER, rbo)
+		bindRenderbuffer(gl_RENDERBUFFER, 0)
+	}
+
+	if status := checkFramebufferStatus(gl_FRAMEBUFFER); status != gl_FRAMEBUFFER_COMPLETE {
+		return fmt.Errorf("framebuffer incomplete: 0x%X", status)
+	}
+	return nil
+}
+
+func destroyFramebuffer() {
+	if hasDepth {
+		deleteRenderbuffers(1, &rbo)
+	}
+	deleteFramebuffers(1, &fbo)
+	deleteTextures(1, &tex)
+}
+
+// ReadFramebuffer reads the current FBO color attachment into the internal buffer.
+// Call SetBuffer first to size the buffer (w * h * 4).
+func ReadFramebuffer(size, w, h uint) []byte {
+	bindFramebuffer(gl_FRAMEBUFFER, fbo)
+	// glReadPixels is SYNCHRONOUS and runs on the emulator thread: it flushes the GL pipeline and
+	// blocks until the frame has crossed PCIe. That stall is what CLOUD_GAME_GL_READBACK_STATS=1
+	// measures (readback_stats.go) — it is the cost a GL/CUDA zero-copy path would remove.
+	if readbackStats.on {
+		start := time.Now()
+		readPixels(0, 0, int32(w), int32(h), pixType, pixFormat, bufPtr)
+		recordReadback(time.Since(start), size, w, h)
+		return buf[:size]
+	}
+	readPixels(0, 0, int32(w), int32(h), pixType, pixFormat, bufPtr)
+	return buf[:size]
+}
+
+// copyImageSubData copies a w*h region of one texture into another entirely on the GPU — no PCIe
+// traffic, no CPU involvement. This is what replaces the synchronous readback for HW-rendered cores.
+func copyImageSubData(src, dst uint32, w, h int32) {
+	C.gl_copy_image_sub_data((C.GPCOPYIMAGESUBDATA)(gpCopyImageSubData),
+		C.GLuint(src), C.GLuint(dst), C.GLsizei(w), C.GLsizei(h))
+}
+
+func flush()  { C.gl_flush((C.GPFLUSH)(gpFlush)) }
+func finish() { C.gl_finish((C.GPFLUSH)(gpFinish)) }
+
+func SetBuffer(size int) {
+	buf = make([]byte, size)
+	bufPtr = unsafe.Pointer(&buf[0])
+}
+
+func SetPixelFormat(format PixelFormat) error {
+	switch format {
+	case UnsignedShort5551:
+		pixFormat, pixType = 0x8034, gl_BGRA // GL_UNSIGNED_SHORT_5_5_5_1
+	case UnsignedShort565:
+		pixFormat, pixType = 0x8363, gl_RGB // GL_UNSIGNED_SHORT_5_6_5
+	case UnsignedInt8888Rev:
+		pixFormat, pixType = 0x8367, gl_BGRA // GL_UNSIGNED_INT_8_8_8_8_REV
+	default:
+		return errors.New("unknown pixel format")
+	}
+	return nil
+}
+
+func GLInfo() (version, vendor, renderer, glsl string) {
+	return goStr(getString(gl_VERSION)),
+		goStr(getString(gl_VENDOR)),
+		goStr(getString(gl_RENDERER)),
+		goStr(getString(gl_SHADING_LANG_VERSION))
+}
+
+func GlFbo() uint32 { return fbo }
diff --git a/pkg/worker/caged/libretro/graphics/readback_stats.go b/pkg/worker/caged/libretro/graphics/readback_stats.go
new file mode 100644
index 0000000..96877c5
--- /dev/null
+++ b/pkg/worker/caged/libretro/graphics/readback_stats.go
@@ -0,0 +1,81 @@
+package graphics
+
+import (
+	"fmt"
+	"os"
+	"sort"
+	"sync"
+	"time"
+)
+
+// Instrumentation for the GL readback (env-gated: CLOUD_GAME_GL_READBACK_STATS=1).
+//
+// Hardware-rendered cores (n64, gc, ps2, psp, dc — everything 3D) render into an FBO on the GPU and we
+// pull the pixels back with glReadPixels, on the EMULATOR THREAD, inside video_refresh. That call is
+// synchronous: it flushes the GL pipeline and blocks until the frame has crossed PCIe into system
+// memory. Then patch 0004 copies it again, and NVENC uploads it straight back to the GPU.
+//
+// So the question this answers is NOT "how much bandwidth does the round trip cost" — it is "how long
+// does the core sit still doing nothing". At 60fps the whole frame budget is 16.7 ms. If the readback
+// is ~0.5 ms it is noise and GL/CUDA interop (which has to share a WGL context across libco cothreads
+// — a crash risk, not a glitch risk) is not worth it. If it is 5-8 ms it is the biggest single win
+// available on the 3D cores, and it also explains frame-pacing sag on the heavy ones.
+//
+// Measure before building: the same discipline settled P4 (9.2 ms vs 3.0 ms measured), and it is what
+// showed the +137 ms figure in arxiv 2507.00623 does not describe this stack.
+var readbackStats = struct {
+	on      bool
+	mu      sync.Mutex
+	samples []time.Duration
+	w, h    uint
+	bytes   uint
+	logged  int
+}{on: os.Getenv("CLOUD_GAME_GL_READBACK_STATS") == "1"}
+
+const readbackReportEvery = 300 // ~5s at 60fps
+
+// recordReadback times one glReadPixels and periodically reports the distribution. Called only when
+// the env gate is on; the zero-cost path is a single bool check in ReadFramebuffer.
+func recordReadback(d time.Duration, size, w, h uint) {
+	s := &readbackStats
+	s.mu.Lock()
+	s.samples = append(s.samples, d)
+	s.w, s.h, s.bytes = w, h, size
+	if len(s.samples) < readbackReportEvery {
+		s.mu.Unlock()
+		return
+	}
+	batch := s.samples
+	s.samples = nil
+	s.logged++
+	n := s.logged
+	s.mu.Unlock()
+
+	sorted := make([]time.Duration, len(batch))
+	copy(sorted, batch)
+	sort.Slice(sorted, func(i, j int) bool { return sorted[i] < sorted[j] })
+
+	pct := func(p int) float64 {
+		i := len(sorted) * p / 100
+		if i >= len(sorted) {
+			i = len(sorted) - 1
+		}
+		return float64(sorted[i].Microseconds()) / 1000
+	}
+	var total time.Duration
+	for _, d := range batch {
+		total += d
+	}
+	mean := float64(total.Microseconds()) / float64(len(batch)) / 1000
+
+	// A frame is 16.7 ms at 60fps — express the cost as the share of the budget the core spends
+	// blocked, because that is the number that decides whether this is worth fixing.
+	budgetPct := pct(50) / 16.67 * 100
+
+	fmt.Fprintf(os.Stderr,
+		"[gl-readback #%d] %dx%d %.1f MB/frame | p50 %.2f ms  p95 %.2f ms  max %.2f ms  mean %.2f ms "+
+			"| p50 = %.0f%% of a 60fps frame budget (n=%d)\n",
+		n, w, h, float64(size)/1024/1024,
+		pct(50), pct(95), float64(sorted[len(sorted)-1].Microseconds())/1000, mean,
+		budgetPct, len(batch))
+}
