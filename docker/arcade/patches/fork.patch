+
+// ── Glob cards (patch 0041) ─────────────────────────────────────────────────────────────────────
+//
+// The Dreamcast's VMUs live IN the BIOS directory. Every card operation therefore has to be able to
+// see the four vmu_save_*.bin files and nothing else — if any of these tests fail, the failure mode
+// in production is either "we copied the BIOS into a player's vault" or, far worse, "we overwrote
+// the BIOS with a player's vault".
+
+// dcDir builds a Dreamcast system dir: the real BIOS plus a VMU set.
+func dcDir(t *testing.T, vmuBody string) string {
+	t.Helper()
+	dir := t.TempDir()
+	write(t, filepath.Join(dir, "dc_boot.bin"), "BIOS")
+	write(t, filepath.Join(dir, "dc_flash.bin"), "FLASH")
+	write(t, filepath.Join(dir, "data", "syscalls.bin"), "DATA")
+	for _, v := range []string{"A1", "B1"} {
+		write(t, filepath.Join(dir, "vmu_save_"+v+".bin"), vmuBody+v)
+	}
+	return dir
+}
+
+func TestGlobFilesMatchesOnlyTheCard(t *testing.T) {
+	dir := dcDir(t, "card")
+	got, err := GlobFiles(dir, "vmu_save_*.bin")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 {
+		t.Fatalf("want the 2 VMUs, got %v", got)
+	}
+	for _, f := range got {
