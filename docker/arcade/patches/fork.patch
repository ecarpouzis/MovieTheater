+	// The "data" channel carries BOTH the RetroPad frame (10/14 bytes) AND — W10 — the touch pointer
+	// packet (fixed 8 bytes, magic tag). Length+tag discriminate them so the hot pad path is untouched.
+	// Pointer is PORT-0 ONLY: the DS touch panel is player 1's, and an input-only 2nd-pad session (its own
+	// connection at port>0) must never move the player's stylus. Defense-in-depth — the client shim also
+	// gates pointer sends to the primary, pointer-capable session.
+	if len(data) == PointerPacketLen && data[0] == PointerTag {
+		if port == 0 {
+			n.pointer.Set(data)
+		}
+		return
+	}
+	n.retropad.SetInput(port, data)
