+//export coreVideoRefresh
+func coreVideoRefresh(data unsafe.Pointer, width, height uint, packed uint) {
+	if Nan0.Stopped.Load() {
+		return
+	}
+
+	// some frames can be rendered slower or faster than internal 1/fps core tick
+	// so track actual frame render time for proper RTP packet timestamps
+	// (and proper frame display time, for example: 1->1/60=16.6ms, 2->10ms, 3->23ms, 4->16.6ms)
+	// this is useful only for cores with variable framerate, for the fixed framerate cores this adds stutter
+	// !to find docs on Libretro refresh sync and frame times
+	dt := Nan0.tickTime
+	// Update frame timing only when needed: VFR mode or audio buffer callback.
+	if Nan0.vfr || Nan0.audioBuffCb != nil {
+		now := time.Now()
+		Nan0.lastFrameDelta = float64(now.Sub(Nan0.LastFrameTime))
+		Nan0.LastFrameTime = now
+	}
+	if Nan0.vfr {
+		dt = time.Duration(Nan0.lastFrameDelta)
+	}
+
+	// when the core returns a duplicate frame
+	if data == nil {
+		Nan0.Handlers.OnDup()
+		return
+	}
+
+	// calculate real frame width in pixels from packed data (realWidth >= width)
+	// some cores or games output zero pitch, i.e. N64 Mupen
+	bpp := Nan0.Video.PixFmt.BPP
+	if packed == 0 {
+		packed = width * bpp
+	}
+	// calculate space for the video frame
+	bytes := packed * height
+
+	var data_ []byte
+	var texID uint32
+	if data != C.RETRO_HW_FRAME_BUFFER_VALID {
+		//noinspection GoRedundantConversion
+		data_ = unsafe.Slice((*byte)(data), bytes)
+	} else if Nan0.GLZeroCopy {
+		// GL ZERO-COPY: the frame is already on the GPU, which is where the encoder wants it. Copy it
+		// GPU->GPU into a pool texture (so the core can immediately render the next frame over its own)
+		// and hand the encoder the texture id. No glReadPixels, so the emulator thread never blocks on
+		// PCIe — measured 3-4 ms per frame back on gc/n64, a quarter of a 60fps budget.
+		//
+		// 0 = the pool could not be set up (e.g. no glCopyImageSubData). Fall back to the readback
+		// rather than shipping no video: a missing feature must not be a black screen.
+		texID = graphics.CopyFrameToPool(int32(width), int32(height))
+		if texID == 0 {
+			data_ = graphics.ReadFramebuffer(bytes, width, height)
+		}
+	} else {
+		// if Libretro renders frame with OpenGL context
+		data_ = graphics.ReadFramebuffer(bytes, width, height)
+	}
+
+	// some cores or games have a variable output frame size, i.e. PSX Rearmed
+	// also we have an option of xN output frame magnification
+	// so, it may be rescaled
+
+	// Debug-only, env-gated (patch 0022): capture the RAW frame here, before scaling/4:2:0/NVENC.
+	// This is the ONLY place AA is still visible and the only place a core's true frame size is known.
+	if data_ != nil {
+		dumpFrame(data_, width, height, packed, bpp, int(Nan0.Video.PixFmt.C), data == C.RETRO_HW_FRAME_BUFFER_VALID)
+	}
+
+	Nan0.Handlers.OnVideo(data_, dt, FrameInfo{W: width, H: height, Stride: packed, Tex: texID})
+}
+
+// audioClockFrames accumulates audio frames (per channel) produced since the last read. The frontend
+// pacing loop drains it each tick to pace retro_run against the emulated audio clock (real-time 44.1kHz)
+// — so a game whose content rate varies (e.g. flycast running Sonic's 30fps gameplay at 2x, emitting 2x
+// audio) is throttled to true speed instead of the fixed video fps. See frontend.go Start.
+var audioClockFrames atomic.Int64
+
+// TakeAudioFrames returns and resets the audio frames produced since the last call.
+func (n *Nanoarch) TakeAudioFrames() int64 { return audioClockFrames.Swap(0) }
+
+//export coreAudioSampleBatch
+func coreAudioSampleBatch(data unsafe.Pointer, frames C.size_t) C.size_t {
+	if Nan0.Stopped.Load() {
+		return frames
+	}
+	audioClockFrames.Add(int64(frames))
+	Nan0.Handlers.OnAudio(data, int(frames)<<1)
+
+	// Audio buffer status for the core (e.g. mGBA frameskip).
+	if Nan0.audioBuffCb != nil {
+		rawRate := int(Nan0.sys.av.timing.sample_rate)
+		expectedNs := float64(frames) / float64(rawRate) * 1e9
+		d := Nan0.lastFrameDelta - expectedNs
+		Nan0.audioDrift += d
+
+		occupancy := min(max(50-int(Nan0.audioDrift/(expectedNs*4)*50), 0), 100)
+
+		underrun := false
+		if Nan0.audioDrift > expectedNs*4 {
+			underrun = true
+			Nan0.audioDrift = 0
+		}
+		if Nan0.audioDrift < -expectedNs*4 {
+			Nan0.audioDrift = -expectedNs * 4
+		}
+
+		C.call_audio_buffer_status(Nan0.audioBuffCb, true, C.unsigned(occupancy), C.bool(underrun))
+	}
+
+	return frames
+}
