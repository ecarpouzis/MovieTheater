+//export initVideo
+func initVideo() {
+	var context graphics.Context
+	switch Nan0.Video.hw.context_type {
+	case C.RETRO_HW_CONTEXT_NONE:
+		context = graphics.CtxNone
+	case C.RETRO_HW_CONTEXT_OPENGL:
+		context = graphics.CtxOpenGl
+	case C.RETRO_HW_CONTEXT_OPENGLES2:
+		context = graphics.CtxOpenGlEs2
+	case C.RETRO_HW_CONTEXT_OPENGL_CORE:
+		context = graphics.CtxOpenGlCore
+	case C.RETRO_HW_CONTEXT_OPENGLES3:
+		context = graphics.CtxOpenGlEs3
+	case C.RETRO_HW_CONTEXT_OPENGLES_VERSION:
+		context = graphics.CtxOpenGlEsVersion
+	case C.RETRO_HW_CONTEXT_VULKAN:
+		context = graphics.CtxVulkan
+	case C.RETRO_HW_CONTEXT_DUMMY:
+		context = graphics.CtxDummy
+	default:
+		context = graphics.CtxUnknown
+	}
+
+	thread.Main(func() {
+		var err error
+		Nan0.glCtx, err = graphics.NewRGFWContext(graphics.Config{
+			Ctx:            context,
+			W:              int(Nan0.sys.av.geometry.max_width),
+			H:              int(Nan0.sys.av.geometry.max_height),
+			GLAutoContext:  Nan0.Video.gl.autoCtx,
+			GLVersionMajor: uint(Nan0.Video.hw.version_major),
+			GLVersionMinor: uint(Nan0.Video.hw.version_minor),
+			GLHasDepth:     bool(Nan0.Video.hw.depth),
+			GLHasStencil:   bool(Nan0.Video.hw.stencil),
+		})
+		if err != nil {
+			panic(err)
+		}
+
+		// GL ZERO-COPY: wrap this context for GStreamer, HERE and nowhere else. It has to happen on the
+		// thread where the core's GL context is CURRENT (GStreamer reads the GL function pointers out
+		// of it), and this closure is that thread. Doing it from the coordinator handler — where the
+		// media pipe is otherwise assembled — silently produces a context with no vtable.
+		//
+		// A failure is NOT fatal: we log it and leave GLZeroCopy false, which keeps the readback path.
+		// The 3D lane must never go dark because an optimisation did not initialise.
+		if Nan0.GLZeroCopy && GLContextReady != nil {
+			glrc, _ := Nan0.glCtx.GLHandles()
+			// The share step needs NO context current (wglShareLists -> ERROR_BUSY otherwise), so hand
+			// the media package the unbind/rebind pair rather than letting it guess about our threads.
+			if err := GLContextReady(glrc, Nan0.glCtx.UnbindContext, Nan0.glCtx.BindContext); err != nil {
+				Nan0.log.Error().Err(err).Msg("gl zero-copy unavailable; falling back to the readback path")
+				Nan0.GLZeroCopy = false
+			} else {
+				Nan0.log.Info().Msg("gl zero-copy: the encoder reads the core's texture (no glReadPixels)")
+			}
+		}
+	})
+
+	if Nan0.log.GetLevel() < logger.InfoLevel {
+		printOpenGLDriverInfo()
+	}
+}
+
+// GLContextReady is called on the GRAPHICS thread once the core's GL context exists, with its native
+// handle, so the media package can wrap it for GStreamer. A package-level hook rather than an import so
+// nanoarch keeps knowing nothing about the encoder.
+var GLContextReady func(glrc uintptr, unbind func(), rebind func() error) error
+
+// GLContextGone is called just before the core's GL context is destroyed, so the media package can drop
+// the encoder's shared contexts first. Order matters — see deinitVideo.
+var GLContextGone func()
+
+//export deinitVideo
+func deinitVideo() {
+	// ORDER IS LOAD-BEARING (2026-07-15). Drop the ENCODER's GL contexts BEFORE the core's context_destroy
+	// runs. They share an object space, so destroying the core's context first leaves nvcodec doing GL work
+	// against a dead share group — which hangs its state change ("media pipeline teardown wedged") and the
+	// room-close watchdog then kills the worker (exitcode 70 after 30s). This was latent while EVERY GL core
+	// skipped context_destroy; ps2 now runs it (to persist the GS shader cache), so the encoder contexts
+	// MUST go first. Non-zero-copy cores have GLContextGone == nil and are unaffected.
+	if Nan0.GLZeroCopy && GLContextGone != nil {
+		GLContextGone()
+	}
+	if !Nan0.hackSkipHwContextDestroy {
+		C.bridge_context_reset(Nan0.Video.hw.context_destroy)
+	}
+	thread.Main(func() {
+		graphics.FreeZeroCopyPool()
+		if err := Nan0.glCtx.Deinit(); err != nil {
+			Nan0.log.Error().Err(err).Msg("deinit fail")
+		}
+	})
+	Nan0.Video.gl.enabled = false
+	Nan0.Video.gl.autoCtx = false
+	Nan0.hackSkipHwContextDestroy = false
+	Nan0.hackSkipSameThreadSave = false
+	Nan0.hackSkipBootRestore = false
+	Nan0.hackSkipSerializeSizeProbe = false
+	Nan0.hackVkSyntheticSurface = false
+	thread.SwitchGraphics(false)
+}
+
+// initVideoVulkan brings up the Vulkan-capture frontend (instance + device + hw render interface).
+// armVulkanZeroCopy sets the zero-copy flag BEFORE nano_vk_init — create_device_wrapper (inside
+// nano_vk_init) reads it to inject the external-memory/semaphore device extensions into the core's
+// device. Split out of initVideoVulkan (with finishVideoVulkan) so the LibCo C wrapper
+// (init_video_vk_cgo) can call the DEEP nano_vk_init DIRECTLY in C: that keeps vkCreateDevice on the
+// same_thread 64 MiB stack instead of the small Go cgo-callback stack it dropped onto when the wrapper
+// bounced through Go, which overflowed for N64 paraLLEl-RDP's (deeper, v1) device creation ->
+// STATUS_BAD_STACK / Exception 0xc0000028. Just a flag write, so thread-independent.
+//
+//export armVulkanZeroCopy
+func armVulkanZeroCopy() {
+	if Nan0.Video.vk.zeroCopy {
+		fence := 0
+		if Nan0.Video.vk.zcFence {
+			fence = 1
+		}
+		C.nano_vk_zc_set_enabled(1, C.int(fence))
+	}
+}
+
+// armVulkanSyntheticSurface arms (or clears) the synthetic-headless-surface path BEFORE nano_vk_init,
+// on the same cothread as armVulkanZeroCopy. Always writes an explicit 0/1 so a previous room's value
+// can never leak (nano_vk_shutdown's memset also clears it, but be defensive). Independent of zero-copy.
+//
+//export armVulkanSyntheticSurface
+func armVulkanSyntheticSurface() {
+	on := 0
+	if Nan0.hackVkSyntheticSurface {
+		on = 1
+	}
+	C.nano_vk_set_synthetic_surface(C.int(on))
+}
+
+// finishVideoVulkan runs the post-nano_vk_init work (GL-import setup + logging). It MUST run on the same
+// cothread as nano_vk_init so setupVulkanZeroCopy's thread.Main is inline on the graphics thread. rc is
+// nano_vk_init's return; a failure is fatal (the core would fetch a null hw interface at context_reset
+// and crash anyway, so fail loudly here).
+//
+//export finishVideoVulkan
+func finishVideoVulkan(rc C.int) {
+	if rc != 0 {
+		Nan0.log.Error().Msgf("vulkan capture init failed (rc=%v) — no frame path", int(rc))
+		panic("nano_vk_init failed")
+	}
+
+	// If a required extension was missing at device creation, nano_vk flipped its internal fallback and
+	// nano_vk_zc_wanted() now returns 0 — the room runs the M1 readback. (On the fleet's NVIDIA hardware
+	// this is probed away at pipeline-build time; this is the belt-and-braces runtime guard.)
+	// committedGL: the coordinator armed vkZeroCopy, so the media pipeline was built for GL textures
+	// (m.GLZeroCopy=true). If zero-copy then can't be set up, readback (system-memory) frames CANNOT be
+	// pushed into that GLMemory pipeline — see the captureBroken field.
+	committedGL := Nan0.Video.vk.zeroCopy
+	if Nan0.Video.vk.zeroCopy && C.nano_vk_zc_wanted() != 0 {
+		if err := setupVulkanZeroCopy(); err != nil {
+			Nan0.log.Error().Err(err).Msg("vulkan zero-copy setup failed — this room may not produce video (extensions probed OK, so this is unexpected)")
+			Nan0.Video.vk.zeroCopy = false
+		} else {
+			Nan0.Video.vk.zcReady = true
+			Nan0.log.Info().Msg("vulkan capture: device ready, zero-copy ACTIVE (frames imported to GL, no readback)")
+			return
+		}
+	}
+	// FAIL-SOFT: the pipeline is GL-committed but zero-copy is not active (the core's device couldn't do
+	// it, e.g. flycast ignoring the injected extensions). Pushing readback CPU frames into a GLMemory
+	// appsrc crashes the worker; instead drop every frame (black room) and keep the worker alive.
+	if committedGL && !Nan0.Video.vk.zcReady {
+		Nan0.Video.vk.captureBroken = true
+		Nan0.log.Error().Msg("vulkan capture: zero-copy UNAVAILABLE on a GL-committed pipeline (core device lacks external-memory) — " +
+			"room will show no video (fail-soft); the worker stays up. This core needs the v2 create_device2 injection path or a per-core fix.")
+		return
+	}
+	Nan0.log.Info().Msg("vulkan capture: device ready, hw render interface built (readback path)")
+}
+
+// initVideoVulkan is the NON-LibCo entry — runs inline on the caller goroutine (no same_thread). LibCo
+// cores instead run arm -> nano_vk_init (on the 64 MiB stack, direct C) -> finish via
+// same_thread(init_video_vk_cgo); see nanoarch.c. A failure is fatal (see finishVideoVulkan).
+func initVideoVulkan() {
+	armVulkanZeroCopy()
+	finishVideoVulkan(C.nano_vk_init())
+}
+
+// setupVulkanZeroCopy creates the dedicated RGFW/WGL import context for a Vulkan room, wraps it for
+// GStreamer (the same InitGLZeroCopy dance the GL cores use), and builds the exportable image pool +
+// GL imports. Runs on the core's cothread (LibCo) where the WGL context is current — thread.Main is
+// inline on Windows, so the cothread IS the graphics thread here.
+func setupVulkanZeroCopy() error {
+	var err error
+	thread.Main(func() {
+		// A core-profile 4.6 context: EXT_memory_object[_win32] + EXT_semaphore[_win32] live here, and
+		// GStreamer's wrap wants OPENGL3. This context exists ONLY to hold the imported textures and be
+		// wrapped for the encoder — the Vulkan core renders on its own device, not through this.
+		Nan0.glCtx, err = graphics.NewRGFWContext(graphics.Config{
+			Ctx:            graphics.CtxOpenGlCore,
+			W:              int(Nan0.sys.av.geometry.max_width),
+			H:              int(Nan0.sys.av.geometry.max_height),
+			GLVersionMajor: 4,
+			GLVersionMinor: 6,
+		})
+		if err != nil {
+			return
+		}
+		// Wrap our import context for GStreamer (needs it current for prepare, NOT current for the
+		// wglShareLists step — the unbind/rebind pair handles that). Same hook the GL cores use.
+		if GLContextReady != nil {
+			glrc, _ := Nan0.glCtx.GLHandles()
+			if err = GLContextReady(glrc, Nan0.glCtx.UnbindContext, Nan0.glCtx.BindContext); err != nil {
+				return
+			}
+		}
+		// Build the exportable Vulkan image pool + import each into a GL texture in this (current) context.
+		w := C.uint(Nan0.sys.av.geometry.base_width)
+		h := C.uint(Nan0.sys.av.geometry.base_height)
+		if rc := C.nano_vk_zc_setup(w, h); rc != 0 {
+			err = fmt.Errorf("nano_vk_zc_setup rc=%d", int(rc))
+			return
+		}
+		// Route GStreamer's texture-release notifications (its thread) into our C free list.
+		graphics.ExternalRelease = func(id uint32) bool { return C.nano_vk_zc_release(C.uint(id)) != 0 }
+	})
+	return err
+}
+
+// VulkanZeroCopySupported reports whether this box advertises the external-memory/semaphore Win32
+// extensions the M2 zero-copy path needs. Probed once (a throwaway instance; no device), cached — the
+// coordinator calls it at pipeline-build time to decide the readback-vs-GL pipeline before the core's
+// device exists. CLOUD_GAME_VK_ZC_SIMULATE_NOEXT=1 forces false (tests the automatic fallback).
+var vkZeroCopyProbe struct {
+	once sync.Once
+	ok   bool
+}
+
+func VulkanZeroCopySupported() bool {
+	vkZeroCopyProbe.once.Do(func() {
+		vkZeroCopyProbe.ok = C.nano_vk_probe_zerocopy() != 0
+	})
+	return vkZeroCopyProbe.ok
+}
+
+// deinitVideoVulkan tears the Vulkan-capture frontend down in the order the teardown-order lesson
+// demands: OUR resources before the core's device.
+//
+//export deinitVideoVulkan
+func deinitVideoVulkan() {
+	// 0) Zero-copy teardown FIRST, in the order the deinitVideo lesson demands: the encoder holds a GL
+	//    context SHARED with our import context, so drop GStreamer's contexts (GLContextGone ->
+	//    m.Destroy + DeinitGLZeroCopy) BEFORE we destroy the imported textures or our RGFW context, or
+	//    nvcodec does GL work against a dead share group and the worker hard-exits. Then destroy the
+	//    Vulkan pool + GL imports (device still live, our WGL context still current), then the context.
+	if Nan0.Video.vk.zcReady {
+		graphics.ExternalRelease = nil
+		if GLContextGone != nil {
+			GLContextGone()
+		}
+		thread.Main(func() {
+			C.nano_vk_zc_teardown()
+			if Nan0.glCtx != nil {
+				if err := Nan0.glCtx.Deinit(); err != nil {
+					Nan0.log.Error().Err(err).Msg("vulkan zero-copy: import context deinit failed")
+				}
+				Nan0.glCtx = nil
+			}
+		})
+		Nan0.Video.vk.zcReady = false
+	}
+	// 1) Destroy our command pool / staging / fences while the device is still fully live.
+	C.nano_vk_predestroy()
+	// 2) Run the core's context_destroy: it frees the core's own Vulkan objects on our device and
+	//    releases ownership of the device + instance back to us (paraLLEl-GS: pgs_destroy_device +
+	//    vk_libretro_shutdown). Unlike the GL path there is no shared-context deadlock class here, so
+	//    the Vulkan arm runs context_destroy by default (skip only if the hack is explicitly set).
+	if !Nan0.hackSkipHwContextDestroy {
+		C.bridge_context_reset(Nan0.Video.hw.context_destroy)
+	} else {
+		Nan0.log.Warn().Msg("vulkan: skipping context_destroy (skip_hw_context_destroy hack set)")
+	}
+	// 3) Destroy the device + instance and unload vulkan-1.dll.
+	//
+	// With skip_hw_context_destroy this destroys a VkDevice the core's never-run context_destroy
+	// still references (paraLLEl-GS's Granite objects leak into a dead device) — accepted for the
+	// same reason the GL path accepts the skipped destroy (review N3): the alternative is the
+	// renderer-independent MTGS::CloseGS deadlock, and reuse was verified clean across back-to-back
+	// rooms (the core's create_instance resets its static vulkan_ctx; we reset all our state and
+	// reload the loader, so nothing dangles into the next room).
+	C.nano_vk_shutdown()
+
+	Nan0.Video.vk.enabled = false
+	Nan0.Video.vk.zeroCopy = false
+	Nan0.hackSkipHwContextDestroy = false
+	Nan0.hackSkipSameThreadSave = false
+	Nan0.hackSkipBootRestore = false
+	Nan0.hackSkipSerializeSizeProbe = false
+	Nan0.hackVkSyntheticSurface = false
+}
+
+type limit struct {
+	d  time.Duration
+	t  *time.Timer
+	mu sync.Mutex
+}
+
+func NewLimit(d time.Duration) func(f func()) {
+	l := &limit{d: d}
+	return func(f func()) { l.push(f) }
+}
+
+func (d *limit) push(f func()) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.t != nil {
+		d.t.Stop()
+	}
+	d.t = time.AfterFunc(d.d, f)
+}
+
+func geometryChange(geom C.struct_retro_game_geometry) {
+	Nan0.limiter(func() {
+		old := Nan0.sys.av.geometry
+		Nan0.sys.av.geometry = geom
+
+		if Nan0.Video.gl.enabled && (old.max_width != geom.max_width || old.max_height != geom.max_height) {
+			// (for LRPS2) makes the max height bigger increasing SDL2 and OpenGL buffers slightly
+			Nan0.sys.av.geometry.max_height = C.unsigned(float32(Nan0.sys.av.geometry.max_height) * 1.5)
+			bufS := uint(geom.max_width*Nan0.sys.av.geometry.max_height) * Nan0.Video.PixFmt.BPP
+			graphics.SetBuffer(int(bufS))
+			Nan0.log.Debug().Msgf("OpenGL frame buffer: %v", bufS)
+		}
+
+		if Nan0.OnSystemAvInfo != nil {
+			Nan0.log.Debug().Msgf(">>> geometry change %v -> %v", old, geom)
+			go Nan0.OnSystemAvInfo()
+		}
+	})
+}
+
+func isGeometryDifferent(geom C.struct_retro_game_geometry) bool {
+	return Nan0.sys.av.geometry.base_width != geom.base_width ||
+		Nan0.sys.av.geometry.base_height != geom.base_height
+}
