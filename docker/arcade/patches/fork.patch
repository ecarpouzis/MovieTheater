+func (f *Frontend) SaveStateName() string         { return filepath.Base(f.HashPath()) }
+
+// Scale is the server-side upscale the encoder applies before NVENC. With ScaleMaxWidth set it is a
+// CEILING rather than a fixed multiplier: the largest integer factor whose output still fits wins.
+//
+// Both call sites (coordinatorhandlers) run ViewportRecalculate() immediately before this, so f.vw is
+// the CURRENT frame's width — which is the whole point. A core that changes resolution between games
+// (ScummVM) or mid-game re-picks its factor for free, and a core with no ScaleMaxWidth is untouched.
+func (f *Frontend) Scale() (float64, string) {
+	s := f.scale
+	if f.ScaleMaxWidth > 0 && s > 1 {
+		if w, _ := f.ViewportSize(); w > 0 {
+			k := int(s)
+			for k > 1 && w*k > f.ScaleMaxWidth {
+				k--
+			}
+			s = float64(k)
+		}
+	}
+	return s, f.scaleM
+}
+func (f *Frontend) SetAudioCb(cb func(app.Audio)) { f.onAudio = cb }
+func (f *Frontend) SetSessionId(name string)      { f.storage.SetMainSaveName(name) }
+func (f *Frontend) SetDataCb(cb func([]byte))     { f.onData = cb }
+func (f *Frontend) SetVideoCb(ff func(app.Video)) { f.onVideo = ff }
+func (f *Frontend) Tick() {
+	f.mu.Lock()
+	f.nano.Run()
+	// Advance the RetroAchievements runtime on the SAME goroutine that steps the core (rc_client is
+	// single-threaded, and its triggers read the RAM the core just updated). No-op when RA is off.
+	f.ra.DoFrame()
+	f.mu.Unlock()
+}
+func (f *Frontend) ViewportRecalculate()     { f.mu.Lock(); f.vw, f.vh = f.ViewportCalc(); f.mu.Unlock() }
+func (f *Frontend) ViewportSize() (int, int) { return f.vw, f.vh }
+
+func (f *Frontend) Input(port int, device byte, data []byte) {
+	switch Device(device) {
+	case RetroPad:
+		f.nano.InputRetropad(port, data)
+	case Keyboard:
+		f.nano.InputKeyboard(port, data)
+	case Mouse:
+		f.nano.InputMouse(port, data)
+	}
+}
+
+// RequestDisk queues a multi-disc swap to image index i (patch 0005 — the "disc" data channel).
+func (f *Frontend) RequestDisk(i int) { f.nano.RequestDisk(i) }
+
+func (f *Frontend) ViewportCalc() (nw int, nh int) {
+	w, h := f.FrameSize()
+	nw, nh = w, h
+
+	if f.IsPortrait() {
+		nw, nh = nh, nw
+	}
+
+	f.log.Debug().Msgf("viewport: %dx%d -> %dx%d", w, h, nw, nh)
+
+	return
+}
+
+func (f *Frontend) Close() {
+	f.log.Debug().Msgf("frontend close")
+	if f.closed.Swap(true) {
+		return
+	}
+	close(f.done)
+
+	f.mui.Lock()
+	f.nano.Close()
+	f.mui.Unlock()
+
+	if f.doneEvt != nil {
+		<-f.doneEvt
+	}
+
+	f.mui.Lock()
+	if f.UniqueSaveDir && !f.HasSave() {
+		if err := f.nano.DeleteSaveDir(); err != nil {
+			f.log.Error().Msgf("couldn't delete save dir: %v", err)
+		}
+	}
+
+	f.UniqueSaveDir = false
+	f.SaveStateFs = ""
+
+	f.mui.Unlock()
+	f.log.Debug().Msgf("frontend closed")
+}
+
+// ── Battery / memory card (libretro SAVE_RAM) ────────────────────────────────────────────────────
+//
+// The card is a SEPARATE persistence layer from the save-state and is saved and restored on its own.
+// It used to ride along inside Save()/Load(), which made it a side effect of the save-STATE, and that
+// was the arcade's worst save bug (found 2026-08-01, SM64 romhack on n64). Every SAVE_RAM system —
+// nes/snes/gb/gbc/gba/n64/nds/ps1/pce/vb/… — reached the core ONLY from the tail of Load(), and Load()
+// ran at boot only when a .dat state existed. So the card was silently dropped on every path that
+// legitimately has no state to restore:
+//
+//   - "New game". The gateway deliberately clears the state and re-seeds the card (it logs
+//     "+card kept"), because starting a new game on real hardware does not eject the cartridge.
+//     HasSave() was then false, nothing loaded the .srm, and the game booted with a BLANK battery —
+//     after which the close-save wrote that blank battery back over the player's vaulted card. This
+//     path LOSES the save, it does not merely hide it, and it is the most common boot on the site.
+//   - A competitive room (same clear-the-state boot).
+//   - An alternate core. The gateway withholds a state saved by a different core (right — a state is
+//     that core's memory dump) but still seeds the .srm (also right — a battery reads the same on any
+//     core). With no .dat there was nothing to hang the card restore off, so it vanished there too.
+//   - A state that fails to restore. RestoreSaveState's error returned early, skipping the card
+//     restore below it — and mupen's retro_unserialize is known-flaky, so a bad state ate the battery.
+//   - A NoSaveStates core (psp/ps2/scummvm). Save() and Load() both bailed at the top, so such a core
+//     could never persist SAVE_RAM at all.
+//
+// The symptom is identical in all five: the game boots to an empty file-select screen while the vault
+// holds a perfectly good card, and the next room close overwrites the vault with the blank one.
+
+// SaveSRAM writes the core's battery/memory card to <id>.srm. Nil (no-op) on a core that exposes no
+// SAVE_RAM region, which is most of the heavy ones — they ride the worker's card vault instead.
+func (f *Frontend) SaveSRAM() error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.saveSRAMLocked()
+}
+
+func (f *Frontend) saveSRAMLocked() error {
+	sram := nanoarch.SaveRAM()
+	if sram == nil {
+		return nil
+	}
+	err := f.storage.Save(f.SRAMPath(), sram)
+	sram = nil
+	return err
+}
+
+// RestoreSRAM inserts <id>.srm into the core's SAVE_RAM. Called at boot for EVERY core, with or
+// without a state to restore — that independence is the whole point. Missing file = nothing to do.
+func (f *Frontend) RestoreSRAM() error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.restoreSRAMLocked()
+}
+
+func (f *Frontend) restoreSRAMLocked() error {
+	sram, err := f.storage.Load(f.SRAMPath())
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return nil
+		}
+		return err
+	}
+	if len(sram) == 0 {
+		return nil
+	}
+	// Size disagreements are normal in one direction and dangerous in the other, so they are not one
+	// message. RestoreSaveRAM copies min(len) and can never overrun either way.
+	//
+	// SMALLER than the region is routine and NOT worth a warning: several cores size SAVE_RAM lazily.
+	// mgba reports the 128 KiB FLASH1M maximum until the game first touches flash and it detects the
+	// real type, so every GBA game with a 64 KiB save mismatches at boot (Mother 3, measured). The
+	// card lands at offset 0, which is exactly where that game's save belongs — nothing is lost.
+	//
+	// LARGER than the region genuinely drops the tail, so it stays a warning: that is a card from a
+	// different core or a different-sized battery, and the half of it we cannot deliver may be the
+	// half that matters.
+	if _, size := f.nano.MemoryRegion(nanoarch.RetroMemorySaveRAM); size > 0 && len(sram) > int(size) {
+		f.log.Warn().Msgf("SRAM card is BIGGER than this core's save region (%v bytes stored, region is %v) — "+
+			"restoring the first %v and DROPPING the rest; the card was likely written by another core",
+			len(sram), size, size)
+	}
+	nanoarch.RestoreSaveRAM(sram)
+	// Logged on purpose, at Info, once per boot. The failure this whole path exists to fix was SILENT
+	// on both sides — the gateway said "+card kept" and the worker said nothing at all, so the only
+	// evidence anything was wrong was a player staring at an empty file-select screen. One line here
+	// is what makes "was the card actually inserted?" answerable from the log.
+	f.log.Info().Msgf("save card inserted: %v bytes of SAVE_RAM from %v", len(sram), filepath.Base(f.SRAMPath()))
+	return nil
+}
+
+// Save writes the current state to the filesystem.
+func (f *Frontend) Save() error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+
+	// The card goes first and unconditionally: it is progress in its own right, it is the ONLY thing
+	// a NoSaveStates core has to persist, and it must survive a serialize that fails (or takes the
+	// process down) below it.
+	sramErr := f.saveSRAMLocked()
+	if f.NoSaveStates {
+		if sramErr != nil {
+			return sramErr
+		}
+		return ErrNoSaveStates
+	}
+
+	ss, err := nanoarch.SaveState()
+	if err != nil {
+		return err
+	}
+	if err := f.storage.Save(f.HashPath(), ss); err != nil {
+		return err
+	}
+	ss = nil
+	return sramErr
+}
+
+// Load restores the state from the filesystem.
+func (f *Frontend) Load() error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+
+	if f.NoSaveStates {
+		// No state to restore, but the card still belongs in the machine.
+		if err := f.restoreSRAMLocked(); err != nil {
+			return err
+		}
+		return ErrNoSaveStates
+	}
+
+	ss, err := f.storage.Load(f.HashPath())
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	stateErr := nanoarch.RestoreSaveState(ss)
+
+	// Restored even when the state failed: a rejected or foreign state must not also cost the player
+	// their battery. Order stays state-then-card so the .srm — the newer, authoritative copy — wins
+	// over whatever copy of the card the state had embedded in it.
+	sramErr := f.restoreSRAMLocked()
+	if stateErr != nil {
+		return stateErr
+	}
+	return sramErr
+}
+
+// ── Fast-forward / rewind (t=114/115) ────────────────────────────────────────────────────────────
+
+// SetFastForward engages/releases fast-forward. Safe on every core — it only changes pacing
+// (and mutes/thins the AV callbacks); nothing is serialized. Called off the coordinator's
+// command goroutine; the emulator loop reads the flag each tick.
+func (f *Frontend) SetFastForward(on bool) {
+	if f.ffOn.Swap(on) != on {
+		f.log.Info().Msgf("fast-forward %v", map[bool]string{true: "engaged", false: "released"}[on])
+	}
+}
+
+// SetRewind engages/releases rewind. No-op on cores without an armed rewind ring (config
+// Rewind flag + the serialize-safety gate in LoadCore) — the browser gates its UI by system,
+// but the wire is not to be trusted with a serialize on a core that can't take one.
+func (f *Frontend) SetRewind(on bool) {
+	if on && !f.rewindArmed.Load() {
+		return
+	}
+	if f.rwOn.Swap(on) != on {
+		f.log.Info().Msgf("rewind %v", map[bool]string{true: "engaged", false: "released"}[on])
+	}
+}
+
+// rewindStep walks the ring backward: on each step boundary (and immediately on engage) it pops
+// the newest snapshot and restores it, then the loop's normal Tick replays forward from there —
+// net motion one step back per step of real time, the standard frontend rewind shape. When the
+// ring runs dry the last popped state is re-restored, freezing the game at the oldest recorded
+// moment for as long as the player holds rewind. Emulator goroutine only.
+func (f *Frontend) rewindStep() {
+	if !f.rewindPopNow && f.rewindTicks%uint64(f.rewindStepFrames) != 0 {
+		return
+	}
+	f.rewindPopNow = false
+	st := f.rewindHold
+	if n := len(f.rewindSnaps); n > 0 {
+		st = f.rewindSnaps[n-1]
+		f.rewindSnaps[n-1] = nil
+		f.rewindSnaps = f.rewindSnaps[:n-1]
+		f.rewindBytes -= len(st)
+		// The state being displaced was restored on a previous step and nothing else references it.
+		f.recycle(f.rewindHold)
+		f.rewindHold = st
+	}
+	if st == nil {
+		return // nothing recorded yet this session
+	}
+	f.mu.Lock()
+	err := nanoarch.RestoreSaveState(st)
+	f.mu.Unlock()
+	if err != nil {
+		f.log.Warn().Err(err).Msg("rewind: restore failed; skipping a step")
+	}
+}
+
+// recycle offers a state buffer back to the capture path. Only buffers the ring itself has just
+// given up may be passed here — a buffer still reachable from rewindSnaps/rewindHold would be
+// overwritten by the next serialize and silently corrupt that snapshot. Emulator goroutine only.
+func (f *Frontend) recycle(buf []byte) {
+	if buf == nil || len(f.rewindFree) >= rewindFreeMax {
+		return
+	}
+	f.rewindFree = append(f.rewindFree, buf)
+}
+
+// rewindCapture appends the current state to the ring and evicts the oldest past the memory
+// cap. A core that keeps failing to serialize (3 in a row) loses rewind for the session — a
+// per-step error would otherwise log sixty times a minute for nothing. Emulator goroutine only.
+func (f *Frontend) rewindCapture() {
+	// Hand the core a buffer the ring already owns. A 2D core's state is a few hundred KB and this
+	// hardly matters, but N64's is 16.8 MB EVERY time — five a second is ~84 MB/s of garbage
+	// allocated on the emulator's own thread, and the GC that pays for it lands as visible hitches
+	// in a 60 fps stream. Recycling makes the steady state allocation-free.
+	var reuse []byte
+	if n := len(f.rewindFree); n > 0 {
+		reuse = f.rewindFree[n-1]
+		f.rewindFree[n-1] = nil
+		f.rewindFree = f.rewindFree[:n-1]
+	}
+	t0 := os.Nanotime()
+	f.mu.Lock()
+	st, err := nanoarch.SaveStateInto(reuse)
+	f.mu.Unlock()
+	costMs := float64(os.Nanotime()-t0) / 1e6
+	if err != nil {
+		f.rewindFails++
+		if f.rewindFails >= 3 {
+			f.rewindArmed.Store(false)
+			f.log.Warn().Err(err).Msg("rewind: serialize keeps failing — rewind disabled for this session")
+		}
+		return
+	}
+	f.rewindFails = 0
+	// A serialize STOPS the emulator for its duration, so on a heavy core the ring's cadence is a
+	// frame-budget decision, not a memory one — and it is only knowable per core, per game. Report
+	// it rather than assume it: mean/max against the frame budget is what says whether a core's
+	// rewind step should be widened (or the whole thing dropped for that tier).
+	f.rewindCapN++
+	f.rewindCapSumMs += costMs
+	if costMs > f.rewindCapMaxMs {
+		f.rewindCapMaxMs = costMs
+	}
+	if f.rewindCapN >= 100 {
+		f.log.Info().Msgf("rewind-diag: snapshot %.2f MB mean=%.2fms max=%.2fms ring=%d (%.0f MB / %.0f MB cap, ~%.1fs of history)",
+			float64(len(st))/(1<<20), f.rewindCapSumMs/float64(f.rewindCapN), f.rewindCapMaxMs,
+			len(f.rewindSnaps), float64(f.rewindBytes)/(1<<20), float64(f.rewindMaxBytes)/(1<<20),
+			float64(len(f.rewindSnaps)*f.rewindStepFrames)/max(f.nano.VideoFramerate(), 1))
+		f.rewindCapN, f.rewindCapSumMs, f.rewindCapMaxMs = 0, 0, 0
+	}
+	f.rewindSnaps = append(f.rewindSnaps, st)
+	f.rewindBytes += len(st)
+	for f.rewindBytes > f.rewindMaxBytes && len(f.rewindSnaps) > 1 {
+		f.rewindBytes -= len(f.rewindSnaps[0])
+		f.recycle(f.rewindSnaps[0])
+		f.rewindSnaps[0] = nil
+		f.rewindSnaps = f.rewindSnaps[1:]
+	}
+	// The [1:] reslices above leak backing-array headroom as the window slides; re-pack when the
+	// dead prefix dwarfs the live payload so a long session's header array can't creep unbounded.
+	if cap(f.rewindSnaps) > 2*len(f.rewindSnaps)+1024 {
+		f.rewindSnaps = append(make([][]byte, 0, len(f.rewindSnaps)+64), f.rewindSnaps...)
+	}
+}
+
+func (f *Frontend) IsSupported() error {
+	return graphics.RGFWTryInit()
+}
+
+func (f *Frontend) autosave(periodSec int) {
+	f.log.Info().Msgf("Autosave every [%vs]", periodSec)
+	ticker := time.NewTicker(time.Duration(periodSec) * time.Second)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-ticker.C:
+			if f.nano.IsStopped() {
+				return
+			}
+			// The card comes first: it is progress in its own right, and it survives a core that
+			// dies during the save-state below. On a NoSaveStates core it is the ONLY thing there
+			// is to persist, which is exactly why the tick still runs for them.
+			f.harvestCardsLive()
+			// NoAutoSaveStates joins NoSaveStates HERE and nowhere else — that is the whole point of
+			// the flag. This tick is the automatic writer: it fires unbidden every period, so on a core
+			// where serializing is expensive and risky (PCSX2: ~126 ms stall, 0xC0000409) it must not
+			// serialize. Deliberate saves are a different bargain and stay on; see NoAutoSaveStates in
+			// pkg/config/emulator.go for why collapsing the two cost us manual Save/Load on ps2.
+			if f.NoSaveStates || f.NoAutoSaveStates {
+				// Same reasoning one layer down: harvestCardsLive covers the cores whose card is a
+				// FILE, this covers one whose card is SAVE_RAM. Save() would return ErrNoSaveStates
+				// after writing it, so call the battery writer directly and keep the log quiet.
+				if err := f.SaveSRAM(); err != nil {
+					f.log.Error().Msgf("Autosave (card) failed: %v", err)
+				}
+				continue
+			}
+			if err := f.Save(); err != nil {
+				f.log.Error().Msgf("Autosave failed: %v", err)
+			} else {
+				f.log.Debug().Msgf("Autosave done")
+			}
+		case <-f.done:
+			return
+		}
+	}
+}
+
+func (f *Frontend) copyFsMaybe(path string) {
+	if f.SaveStateFs == "" {
+		return
+	}
+
+	fileName := f.SaveStateFs
+	hasPlaceholder := strings.HasPrefix(f.SaveStateFs, "*")
+	if hasPlaceholder {
+		game := strings.TrimSuffix(filepath.Base(path), filepath.Ext(path))
+		fileName = strings.Replace(f.SaveStateFs, "*", game, 1)
+	}
+
+	fullPath := filepath.Join(f.nano.SaveDir(), fileName)
+
+	if os.Exists(fullPath) {
+		return
+	}
+
+	storePath := filepath.Dir(path)
+	fsPath := filepath.Join(storePath, fileName)
+	if os.Exists(fsPath) {
+		if err := os.CopyFile(fsPath, fullPath); err != nil {
+			f.log.Error().Err(err).Msgf("fs copy fail")
+		} else {
+			f.log.Debug().Msgf("copied fs %v to %v", fsPath, fullPath)
+		}
+	}
+}
+
+// absf: |x| for float64. Local rather than importing math for one call, mirroring abs(int) in abr.go.
+// Used by the true-rate derivation in Start to compare a measured rate against the declared one.
+func absf(x float64) float64 {
+	if x < 0 {
+		return -x
+	}
+	return x
+}
diff --git a/pkg/worker/caged/libretro/frontend_cheevosboot_test.go b/pkg/worker/caged/libretro/frontend_cheevosboot_test.go
new file mode 100644
index 0000000..9a39aeb
--- /dev/null
+++ b/pkg/worker/caged/libretro/frontend_cheevosboot_test.go
@@ -0,0 +1,65 @@
+package libretro
+
+import (
+	"testing"
+	"time"
+)
+
+// The regression these guard: RetroAchievements used to be brought up with ONE query for SYSTEM_RAM
+// before the first frame, and a NULL pointer there disabled achievements and leaderboards for the
+// whole room. mupen64plus answers that query with ptr=NULL (size already correct) and publishes its
+// memory map ~2 ms later, in its first retro_run — so every plain-n64 room silently scored nothing
+// for over a month. The policy below must WAIT for the core rather than judge it on frame 0.
+func TestCheevosBootDecide(t *testing.T) {
+	for _, tt := range []struct {
+		name           string
+		hasRAM, hasMap bool
+		waited         time.Duration
+		want           cheevosBootAction
+	}{
+		// The core is fully up (GBA, PS2 — their map lands before core load even returns).
+		{"both sources, frame 0", true, true, 0, cheevosBootStart},
+
+		// THE BUG. mupen64plus on frame 0: no RAM pointer, no map yet. Judging here is what broke N64.
+		{"mupen at frame 0: nothing yet", false, false, 0, cheevosBootWait},
+		{"mupen 2ms later: map has landed", false, true, 2 * time.Millisecond, cheevosBootWait},
+		{"mupen: map only, past grace", false, true, cheevosBootGrace, cheevosBootStart},
+
+		// A map alone is enough — rc_libretro_memory_init maps from the descriptors and needs no
+		// SYSTEM_RAM pointer at all. This is the second half of the fix: the old code demanded RAM.
+		{"map only, well past grace", false, true, 5 * time.Second, cheevosBootStart},
+
+		// RAM alone is enough for the flat-layout consoles, but wait out the grace first in case a
+		// map is 2 ms behind — starting mapless when a map was coming is how a set gets disabled as
+		// "Invalid address".
+		{"ram only, inside grace", true, false, cheevosBootGrace - time.Millisecond, cheevosBootWait},
+		{"ram only, at grace", true, false, cheevosBootGrace, cheevosBootStart},
+
+		// Give up only when the core has published nothing at all by the deadline.
+		{"nothing, just inside deadline", false, false, cheevosBootDeadline - time.Millisecond, cheevosBootWait},
+		{"nothing, at deadline", false, false, cheevosBootDeadline, cheevosBootGiveUp},
+		{"nothing, past deadline", false, false, time.Minute, cheevosBootGiveUp},
+
+		// A late core must never be given up on while it is still producing: having a source at the
+		// deadline still starts, it does not expire.
+		{"both sources at the deadline", true, true, cheevosBootDeadline, cheevosBootStart},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := cheevosBootDecide(tt.hasRAM, tt.hasMap, tt.waited); got != tt.want {
+				t.Errorf("cheevosBootDecide(ram=%v, map=%v, waited=%v) = %v, want %v",
+					tt.hasRAM, tt.hasMap, tt.waited, got, tt.want)
+			}
+		})
+	}
+}
+
+// The grace must be far larger than the race it covers (observed: 2 ms) and the deadline far larger
+// than the grace, or the policy collapses back into judging the core too early.
+func TestCheevosBootTimingsAreOrdered(t *testing.T) {
+	if cheevosBootGrace < 100*time.Millisecond {
+		t.Errorf("grace %v is too tight to cover a core publishing late", cheevosBootGrace)
+	}
+	if cheevosBootDeadline <= cheevosBootGrace {
+		t.Errorf("deadline %v must exceed grace %v", cheevosBootDeadline, cheevosBootGrace)
+	}
+}
