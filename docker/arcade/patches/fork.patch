+		List:  map[string]config.CodecSettings{"opus": {}},
+	}
+	testFullCodec = config.Encoder{
+		Video: config.Video{Codec: "vp8"},
+		Audio: config.Audio{Codec: "opus"},
+		List:  map[string]config.CodecSettings{"vp8": {}, "opus": {}},
+	}
+)
