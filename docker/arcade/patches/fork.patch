diff --git a/pkg/worker/caged/capture/capture.go b/pkg/worker/caged/capture/capture.go
new file mode 100644
index 0000000..b70b92a
--- /dev/null
+++ b/pkg/worker/caged/capture/capture.go
@@ -0,0 +1,732 @@
+// Package capture implements the "capture" caged mod (heavy browser lane, H5): instead of running
+// a libretro core it launches a native Windows program through the heavy gateway contract, captures
+// the desktop with GStreamer (Windows Graphics Capture), feeds frames/PCM into the UNCHANGED
+// encode/WebRTC pipeline, and turns browser RetroPad packets into ViGEm virtual Xbox 360 pads.
+// See docs/arcade-capture-worker-plan.md.
+package capture
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/giongto35/cloud-game/v3/pkg/config"
+	"github.com/giongto35/cloud-game/v3/pkg/logger"
+	"github.com/giongto35/cloud-game/v3/pkg/worker/caged/app"
+	"github.com/go-gst/go-gst/gst"
+	"golang.org/x/sys/windows"
+)
+
+// System is the pseudo-core / gameInfo.System value that routes a start to this mod.
+const System = "capture"
+
+type App struct {
+	conf   config.Capture
+	log    *logger.Logger
+	http   *http.Client
+	secret string
+
+	hmonitor     uint64 // the monitor the pipeline captures — a per-room virtual display when enabled, else physical
+	physHmonitor uint64 // the boot-time physical monitor pick; the fallback when a virtual display can't be made
+
+	// Per-room virtual display (P4 isolation, sudovda.go). vda is opened once at Init; a display is
+	// ADD'd per room in OpenRoomDisplay and REMOVE'd in closeRoomDisplay.
+	vda      *vda
+	vdActive bool
+	vdMon    [16]byte // this room's MonitorGuid (REMOVE key)
+	vdX      int
+	vdY      int
+	vdW      int
+	vdH      int
+	vdStop   chan struct{} // watchdog ping loop
+
+	// Window-capture mode (captureMode: window, wincapture.go). The game window is parked OFF-SCREEN
+	// and the external ArcadeCaptureHost helper WGC-captures it by HWND, publishing BGRA frames into a
+	// shared-memory ring shmReadLoop feeds into the same design-A appsrc ingest.
+	winHwnd     uintptr // atomic: the game's top-level window (for the minimize guard)
+	winX        int
+	winY        int
+	winW        int
+	winH        int
+	winStop     chan struct{}  // stops shmReadLoop / windowGuardLoop
+	helper      *exec.Cmd      // the ArcadeCaptureHost process
+	helperStdin io.WriteCloser // held open; closing it makes the helper exit
+	shm         windows.Handle // shared-memory ring handle (reader side)
+	shmAddr     uintptr        // mapped view base
+	shmEvent    windows.Handle // per-frame signal event
+	shmW        int
+	shmH        int
+	shmStride   int
+	shmPerSlot  int // 8 (seq) + page-aligned pixel capacity, per slot
+
+	// Window ZERO-COPY (v2): the helper shares the frame as keyed-mutex D3D11 textures instead of a
+	// pixel readback; the shm ring carries only slot/seq (CONTROL channel). d11Sink is the media pipe's
+	// D3D11 hooks (wired by coordinatorhandlers BEFORE LoadApp). winZC is true once v2 is fully armed for
+	// this room; any setup failure falls back to v1 and leaves winZC=false.
+	d11Sink     d11Sink
+	winZC       bool
+	texLuid     int64
+	helperPid   int
+	texHandles  []uint64
+	lastSlot    int32 // atomic: last pushed slot (re-push target)
+	d11Black    atomic.Bool
+	d11Mu       sync.Mutex // serializes d3d11 push (read loop / re-push / black) — keyframe counters
+	d11LastPush time.Time  // guarded by d11Mu
+
+	videoCb func(app.Video)
+	audioCb func(app.Audio)
+
+	pads *padManager
+
+	// effectiveSource holds "d3d11" when the boot-time plugin check demoted us off d3d12; empty
+	// otherwise (use conf.VideoSource). Read through videoSource().
+	effectiveSource atomic.Value
+
+	// media pipelines + last-frame cache (guarded by frameMu)
+	videoPipe *gst.Pipeline
+	audioPipe *gst.Pipeline
+	// capturing gates whether live desktop frames are pushed downstream. It is NOT the room lifecycle:
+	// the pipeline is rebuilt per room now (startVideoPipeline / releaseVideo). This flag exists to
+	// BLANK the stream the moment the captured game dies, so a dead room can never show the desktop.
+	capturing  atomic.Bool
+	pipeMu     sync.Mutex // guards videoPipe/audioPipe teardown (exitWatcher vs Close race)
+	frameMu    sync.Mutex
+	lastFrame  []byte
+	lastStride int
+	lastDur    time.Duration
+	lastPush   time.Time
+	frames     uint64
+	rawFrames  uint64 // diag: appsink deliveries before the capturing gate
+	stopRepush chan struct{}
+
+	// per-room launch state
+	heavyAppId  string
+	roomId      string
+	ownerUserId int
+	swappedExe  string
+	proc        *gameProc
+	gamePid     int
+
+	// videoGate gates live desktop frames when the frames never reach Go (P4 zero-copy): the capture
+	// element lives in the MEDIA pipeline, so the only way to blank the stream is at that pipeline's
+	// valve. Wired by the coordinator's capture branch to media.SetVideoValveDrop; nil on design A,
+	// where the `capturing` flag does the same job on the Go frame path.
+	videoGate func(drop bool)
+
+	mu       sync.Mutex
+	started  bool
+	closed   bool
+	prepared bool // true once gwPrepare acquired the heavy lock — only then may Close() gwFinish (W1)
+}
+
+// ZeroCopy reports whether this room streams straight from GPU memory into the encoder (P4). Forced
+// OFF in window mode: those frames arrive over shared memory on the design-A appsrc path, so there is
+// no in-GStreamer monitor-capture chain to hand the media pipe (zeroCopy config is ignored — logged).
+func (a *App) ZeroCopy() bool { return !a.windowMode() && a.conf.ZeroCopy }
+
+// SetVideoGate wires the pipeline-level frame gate used in zero-copy mode.
+func (a *App) SetVideoGate(fn func(drop bool)) { a.videoGate = fn }
+
+// VideoSrcChain is the GStreamer head the MEDIA pipeline uses in place of its appsrc (P4): capture →
+// GPU convert/scale to the encode geometry → NV12 still in GPU memory, linked straight into NVENC.
+// Nothing here may touch system memory — a d3d12download or a videoconvert would restore exactly the
+// round trip P4 removes.
+//
+// ⚠ Two details are load-bearing and were learned the hard way:
+//   - The framerate goes on the SOURCE caps. Windows Graphics Capture only delivers on screen CHANGE,
+//     so a still screen starves whatever is downstream; with the rate negotiated at the source the
+//     element paces itself (verified: 781 frames / 60.5 fps over a static desktop). That is what lets
+//     zero-copy drop design A's re-push ticker entirely.
+//   - format/size go AFTER the convert, never on the source caps — putting them there fails to
+//     negotiate.
+//
+// Colorimetry rides the convert's caps because zero-copy has no video_caps capsfilter to carry it.
+// Keep it LIMITED range for capture: full-range washed out on tablet H.264 decoders.
+func (a *App) VideoSrcChain(colorimetry string) string {
+	src := "d3d11screencapturesrc"
+	extra := ""
+	conv := "d3d11convert"
+	mem := "D3D11Memory"
+	if a.videoSource() == "d3d12" {
+		src, conv, mem = "d3d12screencapturesrc", "d3d12convert", "D3D12Memory"
+		extra = "tonemap=reinhard " // the HDR handling only d3d12 has (needs our patched plugin)
+	}
+	caps := fmt.Sprintf("video/x-raw(memory:%s),format=NV12,width=%d,height=%d", mem, a.width(), a.height())
+	if colorimetry != "" {
+		caps += ",colorimetry=" + colorimetry
+	}
+	return fmt.Sprintf(
+		"%s name=video_src monitor-handle=%d show-cursor=false %s"+
+			"! video/x-raw(memory:%s),framerate=%d/1 "+
+			"! valve name=video_valve drop=true "+ // starts CLOSED: no desktop before the game is up
+			"! %s ! %s",
+		src, a.hmonitor, extra, mem, a.fps(), conv, caps)
+}
