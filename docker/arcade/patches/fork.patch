+// CoreCache declares a cache subtree whose contents are valid ONLY for the exact core BUILD that
+// wrote them, so the worker can drop it when the build underneath changes.
+//
+// This exists because of a real, expensive bug (see arcade patch 0042). Dolphin keys its pipeline
+// cache by a UID struct it compares with memcmp. Two builds of the same emulator — the stock nightly
+// and our patched one — lay that struct out differently (different compilers ⇒ different padding), so
+// the UIDs one build writes are unrecognizable to the other. A core reading a foreign cache matches
+// NOTHING, recompiles every pipeline inline on the emulator thread, and appends its own UIDs beside
+// the ones it could not read. That is not a slow first boot, it is a slow EVERY boot: the file only
+// grows, and both builds keep re-recompiling. It cost weeks and read as "the custom core is slow".
+//
+// The trap that hid it: Dolphin's per-game .uidcache sits NEXT TO the shader directory, not inside it,
+// so every "clear the shader cache" ever done left the poison in place.
+type CoreCache struct {
+	// Dir is the cache root, relative to the core's save dir (e.g. "User/Cache" for Dolphin).
+	Dir string
+	// Purge lists entries inside Dir to delete when the core build changes. Names are matched with
+	// filepath.Match against the top level of Dir, so both a directory ("Shaders") and a glob
+	// ("*.uidcache") work. Anything not listed is left alone — memory cards and saves live in these
+	// trees too, and they must survive a core swap.
+	Purge []string
+}
+
