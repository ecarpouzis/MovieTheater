diff --git a/pkg/worker/cheevos/vfs.go b/pkg/worker/cheevos/vfs.go
new file mode 100644
index 0000000..a2e250b
--- /dev/null
+++ b/pkg/worker/cheevos/vfs.go
@@ -0,0 +1,344 @@
+package cheevos
+
+/*
+#include <stdlib.h>
+#include "bridge.h"
+*/
+import "C"
+
+import (
+	"bytes"
+	"compress/flate"
+	"compress/zlib"
+	"encoding/binary"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"unsafe"
+)
+
+// ── A virtual filereader for rc_hash ────────────────────────────────────────────────────────────
+//
+// rc_hash reads a disc image through a filereader it can be handed (open/seek/tell/read/close). Our
+// library stores whole systems in COMPRESSED disc containers that its built-in reader cannot open:
+//
+//	.cso  CISO       — PS2 (1,865 dumps) and PSP
+//	.gcz  GCZ        — GameCube (599 dumps)
+//
+// Both are the same idea: a fixed block size, an index of per-block file offsets, and deflate for any
+// block that compressed usefully. That makes them RANDOM-ACCESS, which is the whole point of doing it
+// here rather than extracting: rc_hash reads a disc's descriptor, its root directory and one
+// executable — a few MB — so serving those reads on demand takes a moment, while materialising the
+// image to hash it would mean writing multi-GB temp files for thousands of games.
+//
+// Everything else (raw dumps, .iso, .cue/.bin) passes straight through to the OS, so installing this
+// reader is transparent for the formats that already worked.
+
+// vfsFile is one open handle. Exactly one of osFile / blk is set.
+type vfsFile struct {
+	osFile *os.File
+	blk    *blockImage
+	pos    int64
+}
+
+var (
+	vfsMu    sync.Mutex
+	vfsNext  uintptr = 1
+	vfsFiles         = map[uintptr]*vfsFile{}
+)
+
+func vfsPut(f *vfsFile) uintptr {
+	vfsMu.Lock()
+	defer vfsMu.Unlock()
+	h := vfsNext
+	vfsNext++
+	vfsFiles[h] = f
+	return h
+}
+
+func vfsGet(h uintptr) *vfsFile {
+	vfsMu.Lock()
+	defer vfsMu.Unlock()
+	return vfsFiles[h]
+}
+
+func vfsDrop(h uintptr) *vfsFile {
+	vfsMu.Lock()
+	defer vfsMu.Unlock()
+	f := vfsFiles[h]
+	delete(vfsFiles, h)
+	return f
+}
+
+//export goVfsOpen
+func goVfsOpen(cpath *C.char) C.uintptr_t {
+	path := C.GoString(cpath)
+	ext := strings.ToLower(filepath.Ext(path))
+
+	if ext == ".cso" || ext == ".ciso" || ext == ".zso" || ext == ".gcz" {
+		img, err := openBlockImage(path)
+		if err == nil {
+			return C.uintptr_t(vfsPut(&vfsFile{blk: img}))
+		}
+		// Fall through to a plain open: a mis-named file is better read raw than not at all.
+	}
+	fh, err := os.Open(path)
+	if err != nil {
+		return 0
+	}
+	return C.uintptr_t(vfsPut(&vfsFile{osFile: fh}))
+}
+
+//export goVfsSeek
+func goVfsSeek(h C.uintptr_t, offset C.int64_t, origin C.int) {
+	f := vfsGet(uintptr(h))
+	if f == nil {
+		return
+	}
+	var base int64
+	switch origin {
+	case 0: // SEEK_SET
+		base = 0
+	case 1: // SEEK_CUR
+		base = f.pos
+	case 2: // SEEK_END
+		base = f.size()
+	}
+	f.pos = base + int64(offset)
+	if f.pos < 0 {
+		f.pos = 0
+	}
+}
+
+//export goVfsTell
+func goVfsTell(h C.uintptr_t) C.int64_t {
+	f := vfsGet(uintptr(h))
+	if f == nil {
+		return 0
+	}
+	return C.int64_t(f.pos)
+}
+
+//export goVfsRead
+func goVfsRead(h C.uintptr_t, buf unsafe.Pointer, requested C.size_t) C.size_t {
+	f := vfsGet(uintptr(h))
+	if f == nil || requested == 0 {
+		return 0
+	}
+	// View rc_hash's destination buffer as a Go slice; C owns the memory, we only fill it.
+	dst := unsafe.Slice((*byte)(buf), int(requested))
+	n, _ := f.readAt(dst, f.pos)
+	f.pos += int64(n)
+	return C.size_t(n)
+}
+
+//export goVfsClose
+func goVfsClose(h C.uintptr_t) {
+	f := vfsDrop(uintptr(h))
+	if f == nil {
+		return
+	}
+	if f.osFile != nil {
+		f.osFile.Close()
+	}
+	if f.blk != nil {
+		f.blk.Close()
+	}
+}
+
+func (f *vfsFile) size() int64 {
+	if f.blk != nil {
+		return f.blk.size
+	}
+	if st, err := f.osFile.Stat(); err == nil {
+		return st.Size()
+	}
+	return 0
+}
+
+func (f *vfsFile) readAt(p []byte, off int64) (int, error) {
+	if f.blk != nil {
+		return f.blk.ReadAt(p, off)
+	}
+	return f.osFile.ReadAt(p, off)
+}
+
+// ── Block-compressed disc images (CSO / ZSO / GCZ) ──────────────────────────────────────────────
+
+type blockImage struct {
+	f         *os.File
+	size      int64  // uncompressed size
+	blockSize int64  // uncompressed bytes per block
+	offsets   []int64
+	flags     []bool // true = block stored uncompressed
+	raw       bool   // GCZ stores zlib streams; CSO stores raw deflate
+
+	mu       sync.Mutex
+	cacheIdx int64
+	cache    []byte
+}
+
+func openBlockImage(path string) (*blockImage, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	magic := make([]byte, 4)
+	if _, err := f.ReadAt(magic, 0); err != nil {
+		f.Close()
+		return nil, err
+	}
+	var img *blockImage
+	switch {
+	case string(magic) == "CISO" || string(magic) == "ZISO":
+		img, err = openCso(f)
+	case binary.LittleEndian.Uint32(magic) == 0xB10BC001:
+		img, err = openGcz(f)
+	default:
+		err = errors.New("not a block image")
+	}
+	if err != nil {
+		f.Close()
+		return nil, err
+	}
+	return img, nil
+}
+
+// CSO/CISO header: magic, header size, uncompressed size, block size, version, index shift, then
+// (blocks+1) little-endian uint32 offsets. The offset's TOP BIT means "stored uncompressed"; the
+// block's compressed length is the gap to the next offset.
+func openCso(f *os.File) (*blockImage, error) {
+	hdr := make([]byte, 24)
+	if _, err := f.ReadAt(hdr, 0); err != nil {
+		return nil, err
+	}
+	total := int64(binary.LittleEndian.Uint64(hdr[8:16]))
+	blockSize := int64(binary.LittleEndian.Uint32(hdr[16:20]))
+	shift := uint(hdr[21])
+	if blockSize <= 0 || total <= 0 {
+		return nil, errors.New("bad cso header")
+	}
+	nblocks := int((total + blockSize - 1) / blockSize)
+	idx := make([]byte, (nblocks+1)*4)
+	if _, err := f.ReadAt(idx, 24); err != nil {
+		return nil, err
+	}
+	offsets := make([]int64, nblocks+1)
+	flags := make([]bool, nblocks+1)
+	for i := 0; i <= nblocks; i++ {
+		v := binary.LittleEndian.Uint32(idx[i*4 : i*4+4])
+		flags[i] = v&0x80000000 != 0
+		offsets[i] = int64(v&0x7FFFFFFF) << shift
+	}
+	return &blockImage{f: f, size: total, blockSize: blockSize, offsets: offsets, flags: flags, cacheIdx: -1}, nil
+}
+
+// GCZ header: magic, sub_type, compressed_size, data_size, block_size, num_blocks, then num_blocks
+// uint64 offsets (top bit = uncompressed) and num_blocks uint32 hashes we do not verify.
+func openGcz(f *os.File) (*blockImage, error) {
+	hdr := make([]byte, 32)
+	if _, err := f.ReadAt(hdr, 0); err != nil {
+		return nil, err
+	}
+	dataSize := int64(binary.LittleEndian.Uint64(hdr[16:24]))
+	blockSize := int64(binary.LittleEndian.Uint32(hdr[24:28]))
+	nblocks := int(binary.LittleEndian.Uint32(hdr[28:32]))
+	if blockSize <= 0 || nblocks <= 0 {
+		return nil, errors.New("bad gcz header")
+	}
+	off := make([]byte, nblocks*8)
+	if _, err := f.ReadAt(off, 32); err != nil {
+		return nil, err
+	}
+	dataStart := int64(32 + nblocks*8 + nblocks*4)
+	offsets := make([]int64, nblocks+1)
+	flags := make([]bool, nblocks+1)
+	for i := 0; i < nblocks; i++ {
+		v := binary.LittleEndian.Uint64(off[i*8 : i*8+8])
+		flags[i] = v&0x8000000000000000 != 0
+		offsets[i] = dataStart + int64(v&0x7FFFFFFFFFFFFFFF)
+	}
+	// The final sentinel bounds the last block; the file's end is close enough for that.
+	if st, err := f.Stat(); err == nil {
+		offsets[nblocks] = st.Size()
+	}
+	return &blockImage{f: f, size: dataSize, blockSize: blockSize, offsets: offsets, flags: flags, raw: true, cacheIdx: -1}, nil
+}
+
+func (b *blockImage) block(i int64) ([]byte, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.cacheIdx == i && b.cache != nil {
+		return b.cache, nil
+	}
+	if i < 0 || int(i) >= len(b.offsets)-1 {
+		return nil, io.EOF
+	}
+	start, end := b.offsets[i], b.offsets[i+1]
+	if end <= start {
+		return nil, errors.New("bad block bounds")
+	}
+	comp := make([]byte, end-start)
+	if _, err := b.f.ReadAt(comp, start); err != nil && err != io.EOF {
+		return nil, err
+	}
+
+	var out []byte
+	if b.flags[i] {
+		out = comp
+		if int64(len(out)) > b.blockSize {
+			out = out[:b.blockSize]
+		}
+	} else {
+		var r io.ReadCloser
+		if b.raw {
+			zr, err := zlib.NewReader(bytes.NewReader(comp))
+			if err != nil {
+				return nil, err
+			}
+			r = zr
+		} else {
+			r = flate.NewReader(bytes.NewReader(comp))
+		}
+		dec, err := io.ReadAll(io.LimitReader(r, b.blockSize))
+		r.Close()
+		if err != nil && len(dec) == 0 {
+			return nil, err
+		}
+		out = dec
+	}
+	b.cacheIdx, b.cache = i, out
+	return out, nil
+}
+
+func (b *blockImage) ReadAt(p []byte, off int64) (int, error) {
+	if off >= b.size {
+		return 0, io.EOF
+	}
+	got := 0
+	for got < len(p) && off+int64(got) < b.size {
+		abs := off + int64(got)
+		blk, err := b.block(abs / b.blockSize)
+		if err != nil {
+			if got > 0 {
+				return got, nil
+			}
+			return 0, err
+		}
+		in := abs % b.blockSize
+		if in >= int64(len(blk)) {
+			break
+		}
+		n := copy(p[got:], blk[in:])
+		if n == 0 {
+			break
+		}
+		got += n
+	}
+	return got, nil
+}
+
+func (b *blockImage) Close() error { return b.f.Close() }
