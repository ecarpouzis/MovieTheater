+++ b/pkg/worker/caged/libretro/nanoarch/vulkan/vk_video/vulkan_video_codec_av1std.h
@@ -0,0 +1,394 @@
+#ifndef VULKAN_VIDEO_CODEC_AV1STD_H_
+#define VULKAN_VIDEO_CODEC_AV1STD_H_ 1
+
+/*
