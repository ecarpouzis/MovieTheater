+package room
+
+import (
+	"iter"
+	"log"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/giongto35/cloud-game/v3/pkg/network/webrtc"
+	"github.com/giongto35/cloud-game/v3/pkg/worker/caged/app"
+	"github.com/giongto35/cloud-game/v3/pkg/worker/media"
+)
+
+// closeGiveUp bounds how long a room's teardown may take before the worker concludes its core is
+// wedged and exits (patch 0041). It is deliberately generous: it only ever measures the shutdown of
+// a room that has already lost its last player, so firing late costs nothing and firing on a healthy
+// session is impossible. Teardown is meant to take milliseconds.
+const closeGiveUp = 30 * time.Second
+
+type MediaPipe interface {
+	// Destroy frees all allocated resources.
+	Destroy()
+	// Init initializes the pipe: allocates needed resources.
+	Init() error
+	// Reinit initializes video and audio pipes with the new settings.
+	Reinit() error
+	// ProcessAudio pushes 16bit PCM audio frames into the encoder.
+	ProcessAudio([]byte, func([]byte, time.Duration))
+	// ProcessVideo pushes a video frame into the encoder.
+	ProcessVideo(media.Video, func([]byte, time.Duration))
+	// SetVideoSink hands the encoder the callback that ships encoded frames to the peers.
+	// ProcessVideo sets it per frame, which is enough for the appsrc path — but P4 zero-copy has NO
+	// frame crossing into Go, so ProcessVideo never runs and the sink must be wired explicitly.
+	SetVideoSink(func([]byte, time.Duration))
+	// RequestKeyframe asks the encoder to emit a keyframe soon (a new viewer joined).
+	RequestKeyframe()
+}
+
+type SessionManager[T Session] interface {
+	Add(T) bool
+	Empty() bool
+	Find(string) T
+	RemoveL(T) int
+	// Reset used for proper cleanup of the resources if needed.
+	Reset()
+	Values() iter.Seq[T]
+}
+
+type Session interface {
+	Disconnect()
+	SendAudio([]byte, time.Duration)
+	SendVideo([]byte, time.Duration)
+	SendData([]byte)
+}
+
+type SessionKey string
+
+func (s SessionKey) String() string { return string(s) }
+func (s SessionKey) Id() string     { return s.String() }
+
+type Room[T Session] struct {
+	app   app.App
+	id    string
+	media MediaPipe
+	users SessionManager[T]
+
+	// atomic: the ABR loop (patch 0021) reads this from its own goroutine while Close() writes it.
+	closed      atomic.Bool
+	HandleClose func()
+}
+
+func NewRoom[T Session](id string, app app.App, um SessionManager[T], media MediaPipe) *Room[T] {
+	return &Room[T]{id: id, app: app, users: um, media: media}
+}
+
+func (r *Room[T]) InitMedia() {
+	// PLI/FIR -> keyframe (patch 0029): with an infinite GOP + intra-refresh there are no periodic
+	// IDRs, so a viewer that loses the reference chain recovers ONLY by asking. Process-global like
+	// SetPacing (one worker = one room); each room re-points it at its own media pipe. Wired HERE,
+	// not in NewRoom: HandleGameStart constructs the Room before the media pipe exists there, and a
+	// method value off a nil interface panics — that crashed every room create when this shipped in
+	// NewRoom. The closure re-checks at call time for the same reason.
+	webrtc.OnKeyframeRequest(func() {
+		if m := r.media; m != nil {
+			m.RequestKeyframe()
+		}
+	})
+	r.app.SetAudioCb(func(a app.Audio) {
+		r.media.ProcessAudio(a.Data, r.sendAudio)
+	})
+	r.app.SetVideoCb(func(v app.Video) {
+		r.media.ProcessVideo(media.Video{
+			Frame:    media.RawFrame{Tex: v.Frame.Tex, Data: v.Frame.Data, W: v.Frame.W, H: v.Frame.H, Stride: v.Frame.Stride},
+			Duration: v.Duration,
+		}, r.sendVideo)
+	})
+	// Where the encoded frames go. The appsrc path re-sets this on every ProcessVideo, so this is
+	// redundant there — but P4 zero-copy pushes no frame through Go, so without it the encoder runs at
+	// full speed into a nil callback and the room streams NOTHING (verified: 63 fps out of NVENC, zero
+	// frames at the browser). SetMedia runs before InitMedia, so r.media is live here.
+	r.media.SetVideoSink(r.sendVideo)
+}
+
+func (r *Room[T]) sendAudio(data []byte, dur time.Duration) {
+	for u := range r.users.Values() {
+		u.SendAudio(data, dur)
+	}
+}
+
+func (r *Room[T]) sendVideo(data []byte, dur time.Duration) {
+	// COPY ONCE, then fan out. Peers send on their own goroutines now, so a frame outlives this
+	// callback — and `data` is a window into a GStreamer buffer that is unmapped the moment we return.
+	// Handing that slice to another goroutine is a use-after-free. One copy per FRAME (not per peer)
+	// is the cost, and it is small: an encoded frame is ~17 KB at 8 Mbps/60fps.
+	//
+	// The copy is immutable from here on, so all peers can share it safely.
+	buf := make([]byte, len(data))
+	copy(buf, data)
+	for u := range r.users.Values() {
+		u.SendVideo(buf, dur)
+	}
+}
+
+// Closed reports whether the room has been torn down. Used by the ABR loop to stop itself.
+func (r *Room[T]) Closed() bool { return r == nil || r.closed.Load() }
+
+// Users exposes the room's session manager (the ABR loop polls each peer's bandwidth estimate).
+func (r *Room[T]) Users() SessionManager[T] { return r.users }
+
+func (r *Room[T]) App() app.App         { return r.app }
+func (r *Room[T]) Id() string           { return r.id }
+func (r *Room[T]) SetApp(app app.App)   { r.app = app }
+func (r *Room[T]) SetMedia(m MediaPipe) { r.media = m }
+func (r *Room[T]) StartApp()            { r.app.Start() }
+func (r *Room[T]) Send(data []byte) {
+	for u := range r.users.Values() {
+		u.SendData(data)
+	}
+}
+
+func (r *Room[T]) Close() {
+	// Swap also makes Close idempotent under a race (two goroutines closing at once).
+	if r == nil || r.closed.Swap(true) {
+		return
+	}
+
+	// TEARDOWN MUST NOT BE ABLE TO HANG FOREVER (patch 0041). Stock ran app.Close() straight, so a
+	// core that never returned from it took the whole worker with it: HandleClose below was never
+	// reached, the coordinator went on believing this worker was BUSY with a room that had no players
+	// left in it, and — one room per worker — the pool quietly lost a slot. Enough of those and every
+	// new room is turned away with "the arcade is full". Seen live: a PPSSPP room hung inside a boot
+	// restore and pinned its worker until an external watchdog killed it three minutes later.
+	//
+	// Note what is bounded here: the teardown of a room that has ALREADY lost its last player. It
+	// never policies a live session, so it cannot cut a slow game short — the worst a wrong bound can
+	// do is retire an idle worker a little early.
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		if r.app != nil {
+			r.app.Close() // vaults the memory card before it touches anything that can hang
+		}
+		if r.media != nil {
+			r.media.Destroy()
+		}
+	}()
+
+	select {
+	case <-done:
+		if r.HandleClose != nil {
+			r.HandleClose() // the room really is gone: let the coordinator hand this worker a new one
+		}
+	case <-time.After(closeGiveUp):
+		// The core is wedged inside C — nothing to unwind, no one to ask nicely. Do NOT tell the
+		// coordinator the room closed: that would advertise this worker as free while its core is
+		// still stuck, and the next player would be routed straight into it. Exit instead. The
+		// coordinator drops a worker that disconnects, and the runner brings a clean one back in ~4s.
+		log.Printf("room %v: the core did not finish shutting down after %v — it is wedged. Exiting so "+
+			"this worker is replaced rather than handed to the next player.", r.id, closeGiveUp)
+		os.Exit(70) // EX_SOFTWARE — deliberate, distinct from a core's crash code
+	}
+}
+
+// Router tracks and routes freshly connected users to an app room.
+// Rooms and users has 1-to-n relationship.
+type Router[T Session] struct {
+	room  *Room[T]
+	users SessionManager[T]
+	mu    sync.Mutex
+}
+
+func (r *Router[T]) FindRoom(id string) *Room[T] {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.room != nil && r.room.Id() == id {
+		return r.room
+	}
+	return nil
+}
+
+func (r *Router[T]) Remove(user T) {
+	if left := r.users.RemoveL(user); left == 0 {
+		r.Close()
+		r.SetRoom(nil) // !to remove
+	}
+}
+
+func (r *Router[T]) AddUser(user T) {
+	r.users.Add(user)
+	// A freshly joined viewer needs a keyframe to start decoding; we run a long GOP to kill the
+	// periodic-IDR audio hitch, so request one on join instead of waiting for the next periodic one.
+	r.mu.Lock()
+	if r.room != nil && r.room.media != nil {
+		r.room.media.RequestKeyframe()
+	}
+	r.mu.Unlock()
+}
+func (r *Router[T]) Close()                   { r.mu.Lock(); r.room.Close(); r.room = nil; r.mu.Unlock() }
+func (r *Router[T]) FindUser(uid string) T    { return r.users.Find(uid) }
+func (r *Router[T]) Room() *Room[T]           { r.mu.Lock(); defer r.mu.Unlock(); return r.room }
+func (r *Router[T]) SetRoom(room *Room[T])    { r.mu.Lock(); r.room = room; r.mu.Unlock() }
+func (r *Router[T]) HasRoom() bool            { r.mu.Lock(); defer r.mu.Unlock(); return r.room != nil }
+func (r *Router[T]) Users() SessionManager[T] { return r.users }
+func (r *Router[T]) Reset() {
+	r.mu.Lock()
+	if r.room != nil {
+		r.room.Close()
+		r.room = nil
+	}
+	for u := range r.users.Values() {
+		u.Disconnect()
+	}
+	r.users.Reset()
+	r.mu.Unlock()
+}
+
+type AppSession struct {
+	Session
+	uid SessionKey
+}
+
+func (p AppSession) Id() SessionKey { return p.uid }
+
+type GameSession struct {
+	AppSession
+	Index int // track user Index (i.e. player 1,2,3,4 select)
+}
+
+func NewGameSession(id string, s Session) *GameSession {
+	return &GameSession{AppSession: AppSession{uid: SessionKey(id), Session: s}}
+}
