diff --git a/pkg/os/crash_windows.go b/pkg/os/crash_windows.go
new file mode 100644
index 0000000..6dbf471
--- /dev/null
+++ b/pkg/os/crash_windows.go
@@ -0,0 +1,195 @@
+//go:build windows
+
+package os
+
+import (
+	"fmt"
+	"os"
+	"strings"
+	"sync/atomic"
+	"syscall"
+	"unsafe"
+)
+
+// Crash forensics for the worker.
+//
+// Every worker death we have ever had to diagnose arrived as one line from the runner —
+// `glworker EXITED exitcode=-1073741819 (0xC0000005)` — and nothing else. The log's last line before
+// it belongs to whichever component happened to be chattiest, which has actively misled us: the
+// capture worker's aborts were blamed for weeks on a GStreamer audio-padding warning that turned out
+// to be innocent, and one gdb backtrace named the real culprit (libgstd3d12) in a minute. This turns
+// every future crash into that backtrace WITHOUT needing gdb attached at the right moment: the code,
+// the faulting address, and — the part that actually names the culprit — the MODULE each stack frame
+// lands in. "It died in pcsx2_custom_libretro+0x3f21a0" is an answer; "it died" is not.
+//
+// ⚠ THIS MUST HOOK THE UNHANDLED PATH ONLY — never AddVectoredExceptionHandler.
+// Recompiling cores raise access violations as a matter of NORMAL OPERATION: PCSX2's fastmem takes a
+// deliberate AV on every out-of-range guest access and rescues it in its own page-fault handler (the
+// worker log's "Fastmem area: ..." line is that mechanism arming itself), and PPSSPP does the same
+// where its handler installs. A first-chance vectored handler would fire thousands of times per
+// second on healthy PS2 gameplay, drown the log, and cost real time in the fault path. A last-chance
+// filter runs only once the owning core has DECLINED to handle the fault — i.e. only when the process
+// is genuinely dying. See the ppsspp-core skill, "fastmem needs an exception handler".
+//
+// The filter returns EXCEPTION_CONTINUE_SEARCH: it observes and never changes what happens next, so
+// the process still dies exactly as it did before, with the same exit code the watchdog keys on.
+
+const (
+	exceptionContinueSearch = 0 // observe only — do not swallow the exception
+
+	// GetModuleHandleExW flags: resolve the module OWNING an address without touching its refcount
+	// (taking a reference from inside a crashing process would be a needless way to make things worse).
+	getModuleHandleExFromAddress   = 0x00000004
+	getModuleHandleExUnchangedRef  = 0x00000002
+	getModuleHandleExAddressUnpin  = getModuleHandleExFromAddress | getModuleHandleExUnchangedRef
+
+	maxFrames = 32
+)
+
+// exceptionRecord mirrors Win32 EXCEPTION_RECORD (amd64 layout). Only the head is read; the process
+// is already broken, so this stays to fixed offsets and does no allocation-heavy work.
+type exceptionRecord struct {
+	Code             uint32
+	Flags            uint32
+	Next             uintptr
+	Address          uintptr
+	NumberParameters uint32
+	_                uint32
+	Information      [15]uintptr
+}
+
+type exceptionPointers struct {
+	ExceptionRecord *exceptionRecord
+	ContextRecord   uintptr
+}
+
+var (
+	kernel32                     = syscall.NewLazyDLL("kernel32.dll")
+	procSetUnhandledExceptionFlt = kernel32.NewProc("SetUnhandledExceptionFilter")
+	procGetModuleHandleExW       = kernel32.NewProc("GetModuleHandleExW")
+	procGetModuleFileNameW       = kernel32.NewProc("GetModuleFileNameW")
+	procCaptureStackBackTrace    = kernel32.NewProc("RtlCaptureStackBackTrace")
+
+	// Re-entrancy guard. A fault raised while we are already formatting a report (our own bug, or a
+	// second thread dying at the same moment) must not recurse into the filter forever — one report
+	// is worth having, a loop of them costs the log we came for.
+	reporting atomic.Bool
+
+	crashTag atomic.Pointer[string] // extra context line, e.g. the room/system that was booting
+)
+
+// SetCrashContext records what the worker is currently doing, echoed into any crash report. The
+// crash itself tells you WHERE the process died; this tells you WHAT it was doing when it did —
+// which room, which system, which core. Cheap enough to set on every room start.
+func SetCrashContext(s string) { crashTag.Store(&s) }
+
+// InstallCrashHandler arms the last-chance crash reporter. Call once from main, AFTER the Go runtime
+// is up (the runtime installs its own handlers during init; ours must be the one set last to win).
+// Report goes to stderr, which the worker runner appends to the worker log — so it lands in the same
+// file, in order, right after whatever the core last printed.
+func InstallCrashHandler() {
+	cb := syscall.NewCallback(func(info *exceptionPointers) uintptr {
+		if info == nil || info.ExceptionRecord == nil {
+			return exceptionContinueSearch
+		}
+		if !reporting.CompareAndSwap(false, true) {
+			return exceptionContinueSearch
+		}
+		defer reporting.Store(false)
+		report(info.ExceptionRecord)
+		return exceptionContinueSearch
+	})
+	_, _, _ = procSetUnhandledExceptionFlt.Call(cb)
+}
+
+func report(rec *exceptionRecord) {
+	var b strings.Builder
+	b.WriteString("\n=== WORKER CRASH (unhandled exception) ===\n")
+	fmt.Fprintf(&b, "code    : 0x%08X %s\n", rec.Code, exceptionName(rec.Code))
+	fmt.Fprintf(&b, "address : 0x%016X  %s\n", rec.Address, moduleFor(rec.Address))
+
+	// For an access violation the two parameters say what was attempted and where — the difference
+	// between "wrote through a dangling pointer" and "executed a NULL function pointer", which points
+	// at completely different bugs.
+	if rec.Code == 0xC0000005 && rec.NumberParameters >= 2 {
+		what := map[uintptr]string{0: "read from", 1: "write to", 8: "execute at"}[rec.Information[0]]
+		if what == "" {
+			what = fmt.Sprintf("op%d at", rec.Information[0])
+		}
+		fmt.Fprintf(&b, "access  : %s 0x%016X\n", what, rec.Information[1])
+	}
+	if p := crashTag.Load(); p != nil && *p != "" {
+		fmt.Fprintf(&b, "context : %s\n", *p)
+	}
+
+	// The filter runs ON the faulting thread with its stack intact, so a plain backtrace from here
+	// walks down through the frames that faulted. Symbol names would need dbghelp (and a symbol
+	// server we do not have); module+offset is enough to name the culprit BINARY, which is the
+	// question we are actually asking — and it stays correct with no symbols shipped.
+	var frames [maxFrames]uintptr
+	n, _, _ := procCaptureStackBackTrace.Call(0, maxFrames, uintptr(unsafe.Pointer(&frames[0])), 0)
+	if n > 0 {
+		b.WriteString("stack   :\n")
+		for i := 0; i < int(n); i++ {
+			fmt.Fprintf(&b, "  [%02d] 0x%016X  %s\n", i, frames[i], moduleFor(frames[i]))
+		}
+	}
+	b.WriteString("=== END WORKER CRASH ===\n")
+
+	_, _ = os.Stderr.WriteString(b.String())
+	_ = os.Stderr.Sync()
+}
+
+// moduleFor names the loaded module owning an address, as "name+0xoffset". Unowned addresses (JIT'd
+// recompiler code — which is most of a PS2/PSP crash's interesting frames) have no module at all;
+// saying so explicitly is itself a finding, because it means the fault is in emitted guest code
+// rather than in any DLL we could bisect.
+func moduleFor(addr uintptr) string {
+	if addr == 0 {
+		return "(null)"
+	}
+	var hmod uintptr
+	r, _, _ := procGetModuleHandleExW.Call(getModuleHandleExAddressUnpin, addr, uintptr(unsafe.Pointer(&hmod)))
+	if r == 0 || hmod == 0 {
+		return "(no module — JIT/dynamic code or freed)"
+	}
+	var buf [syscall.MAX_PATH]uint16
+	l, _, _ := procGetModuleFileNameW.Call(hmod, uintptr(unsafe.Pointer(&buf[0])), uintptr(len(buf)))
+	if l == 0 {
+		return fmt.Sprintf("(module 0x%X)", hmod)
+	}
+	path := syscall.UTF16ToString(buf[:l])
+	if i := strings.LastIndexAny(path, `\/`); i >= 0 {
+		path = path[i+1:]
+	}
+	return fmt.Sprintf("%s+0x%X", path, addr-hmod)
+}
+
+func exceptionName(code uint32) string {
+	switch code {
+	case 0xC0000005:
+		return "ACCESS_VIOLATION"
+	case 0xC0000006:
+		return "IN_PAGE_ERROR"
+	case 0xC000001D:
+		return "ILLEGAL_INSTRUCTION"
+	case 0xC0000025:
+		return "NONCONTINUABLE_EXCEPTION"
+	case 0xC000008C:
+		return "ARRAY_BOUNDS_EXCEEDED"
+	case 0xC0000094:
+		return "INT_DIVIDE_BY_ZERO"
+	case 0xC0000096:
