+// GLHandles returns the native (WGL) context and device context of the core's GL context, so the media
+// pipeline can build a GStreamer GL context that SHARES with it. Zero on non-Windows / no window.
+func (r *RGFW) GLHandles() (glrc uintptr, dc uintptr) {
