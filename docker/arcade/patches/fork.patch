+var forceKeyframeEvent *gst.Event
+var cachedSegment *gst.Segment
+var cpuCores int
+var pixFmtToGst = map[uint32]string{
+	pixFmtBGRx:  "BGRx",
+	pixFmtBGRA:  "BGRA",
+	pixFmtRGB16: "RGB16",
+}
+var pixFmtCache = map[string]uint32{}
