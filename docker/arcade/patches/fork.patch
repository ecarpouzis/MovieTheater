diff --git a/pkg/worker/caged/libretro/graphics/zerocopy.go b/pkg/worker/caged/libretro/graphics/zerocopy.go
new file mode 100644
index 0000000..8d1ef77
--- /dev/null
+++ b/pkg/worker/caged/libretro/graphics/zerocopy.go
@@ -0,0 +1,145 @@
+package graphics
+
+// GL zero-copy for hardware-rendered cores (n64/gc/ps2/psp/dc).
+//
+// The old path pulled every frame back with glReadPixels — SYNCHRONOUS, on the emulator thread, inside
+// video_refresh. It flushes the GL pipeline and blocks until the frame has crossed PCIe. Measured
+// (CLOUD_GAME_GL_READBACK_STATS=1): GameCube 1920x1584 = 11.6 MB/frame, p50 3.7-4.2 ms, p95 6-8 ms —
+// the core sits blocked for a QUARTER of a 60fps frame budget, and up to half at p95.
+//
+// Instead we hand the encoder the texture: nvav1enc takes video/x-raw(memory:GLMemory) in RGBA
+// directly, so the frame never leaves VRAM.
+//
+// ── OWNERSHIP IS THE WHOLE PROBLEM, AND IT IS NOT OBVIOUS ──────────────────────────────────────────
+// The core re-renders into the SAME texture every frame, so we copy each frame GPU->GPU into a pool
+// texture and hand the encoder THAT. But a GstBuffer holds a *reference* to the texture, not a
+// snapshot — and the encoder consumes buffers asynchronously, several frames deep (the queue plus the
+// appsink hold ~5-6). A pool that simply cycles will therefore overwrite a texture the encoder has not
+// read yet, and that frame encodes pixels from the FUTURE. Then the next buffer shows the correct,
+// older content.
+//
+// That is not tearing and it is not a dropped frame — it is TIME going backwards, and it showed up
+// live as a scrolling marquee ("Select a Cup.") jumping back and forth while everything else looked
+// fine: 60fps, no freezes, no NACKs, clean audio.
+//
+// So a texture is only reusable once GStreamer has RELEASED the buffer holding it. Each wrapped
+// texture carries a destroy-notify that returns it to the free list (see media/glzerocopy.go); the
+// core takes the next FREE one, and if none is free it says so and the caller falls back to the
+// readback for that frame — a slow frame is always better than a wrong one.
+
+import (
+	"fmt"
+	"sync"
+)
+
+// zcPoolSize must comfortably exceed the number of buffers that can be in flight (queue + appsink +
+// the encoder's own). 8 is generous; each texture is only w*h*4 of VRAM and running out just means one
+// frame takes the readback path.
+const zcPoolSize = 8
+
+var (
+	zcMu     sync.Mutex
+	zcPool   []uint32 // every texture we own
+	zcFree   []uint32 // the ones GStreamer is not holding
+	zcW, zcH int32
+)
+
+// InitZeroCopyPool (re)allocates the texture pool for a frame size. Runs on the GL thread with the
+// core's context current.
+func InitZeroCopyPool(w, h int32) error {
+	if gpCopyImageSubData == nil {
+		return fmt.Errorf("glCopyImageSubData unavailable (needs GL 4.3+); GL zero-copy cannot run")
+	}
+	zcMu.Lock()
+	sized := zcW == w && zcH == h && len(zcPool) == zcPoolSize
+	zcMu.Unlock()
+	if sized {
+		return nil
+	}
+	FreeZeroCopyPool()
+
+	pool := make([]uint32, zcPoolSize)
+	genTextures(zcPoolSize, &pool[0])
+	for _, id := range pool {
+		bindTexture(gl_TEXTURE_2D, id)
+		texParameteri(gl_TEXTURE_2D, gl_TEXTURE_MIN_FILTER, gl_NEAREST)
+		texParameteri(gl_TEXTURE_2D, gl_TEXTURE_MAG_FILTER, gl_NEAREST)
+		texImage2D(gl_TEXTURE_2D, 0, gl_RGBA8, w, h, 0, pixType, pixFormat, nil)
+	}
+	bindTexture(gl_TEXTURE_2D, 0)
+
+	zcMu.Lock()
+	zcPool = pool
+	zcFree = append([]uint32(nil), pool...)
+	zcW, zcH = w, h
+	zcMu.Unlock()
+	return nil
+}
+
+// FreeZeroCopyPool deletes the textures. GL thread only.
+func FreeZeroCopyPool() {
+	zcMu.Lock()
+	pool := zcPool
+	zcPool, zcFree, zcW, zcH = nil, nil, 0, 0
+	zcMu.Unlock()
+
+	if len(pool) > 0 {
+		deleteTextures(int32(len(pool)), &pool[0])
+	}
+}
+
+// ExternalRelease, when set, owns the release path instead of this GL pool. The Vulkan zero-copy path
+// (M2) manages its OWN slot pool in C (nanoarch_vulkan.c), but GStreamer's release notify routes here
+// (media/glzerocopy.go's goReleaseZeroCopyTexture). This hook lets that release reach the Vulkan pool's
+// free list; it returns true if it owned the texture. GL cores leave it nil and use zcPool below.
+var ExternalRelease func(id uint32) bool
+
+// ReleaseZeroCopyTexture returns a texture to the free list. Called from GStreamer's thread when it
+// frees the buffer that wrapped it — that, and ONLY that, is what makes the texture safe to reuse.
+func ReleaseZeroCopyTexture(id uint32) {
+	if ExternalRelease != nil && ExternalRelease(id) {
+		return
+	}
+	zcMu.Lock()
+	defer zcMu.Unlock()
+	// Ignore textures from a pool we have already thrown away (a geometry change mid-flight).
+	for _, p := range zcPool {
+		if p == id {
+			zcFree = append(zcFree, id)
+			return
+		}
+	}
+}
+
+// CopyFrameToPool copies the core's just-rendered frame into a FREE pool texture and returns its id.
+// GPU->GPU: no readback, no CPU copy, and the emulator thread never blocks on PCIe.
+//
+// Returns 0 when the pool is unusable or every texture is still held by the encoder — the caller must
+// treat that as "use the readback for this frame", never as an empty frame.
+func CopyFrameToPool(w, h int32) uint32 {
+	zcMu.Lock()
+	needInit := len(zcPool) == 0 || w != zcW || h != zcH
+	zcMu.Unlock()
+	if needInit {
+		if err := InitZeroCopyPool(w, h); err != nil {
+			return 0
+		}
+	}
+
+	zcMu.Lock()
+	if len(zcFree) == 0 {
+		zcMu.Unlock()
+		return 0 // encoder is holding every texture; this frame goes the slow way
+	}
+	dst := zcFree[len(zcFree)-1]
+	zcFree = zcFree[:len(zcFree)-1]
+	zcMu.Unlock()
+
+	// tex is the FBO's colour attachment — what the core just rendered into.
+	copyImageSubData(tex, dst, w, h)
+	// The encoder reads this texture from ANOTHER context, on another thread, as soon as we return. A
+	// glFlush would only mean "submitted", not "done" — so wait for the copy to actually land. No PCIe
+	// transfer happens here (that is the 11 MB/frame we are removing); this is a GPU-side sync only.
+	finish()
+	return dst
+}
diff --git a/pkg/worker/caged/libretro/nanoarch/audiodump.go b/pkg/worker/caged/libretro/nanoarch/audiodump.go
new file mode 100644
index 0000000..5fe29f9
--- /dev/null
+++ b/pkg/worker/caged/libretro/nanoarch/audiodump.go
@@ -0,0 +1,114 @@
+package nanoarch
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+	"unsafe"
+)
+
+// Debug-only RAW audio dump, taken at `audio_cb` — i.e. BEFORE the resampler, Opus and WebRTC. The
+// sibling of framedump.go, and it exists for the same reason: a question the browser cannot answer.
+//
+// THE QUESTION: SM64 Last Impact crackles on our stack and not in Project64, and every downstream
+// suspect has been eliminated by measurement — client jitter buffer (80 ms and 400 ms identical),
+// Opus frame size (10 and 20 ms identical), loss resilience + bitrate (packet-loss-percentage 15->0,
+// inband-fec off, 96k->128k: identical), countperop (1 and 0 identical), and the pacer, which now
+// measures FLAT (ticks/s 60.0, audio/s 32004-32007 against a 32006 declaration, forgiven=0,
+// silence/s=0, noSleep 0%).
+//
+// Crucially, that pacing evidence proves the RATE is right and says NOTHING about the WAVEFORM: a
+// 5-second average of 32005 samples/s is perfectly compatible with individual buffers containing
+// discontinuities, and a discontinuity is exactly what a crackle IS. So the one untested link is the
+// PCM the core hands us. This dump captures it verbatim; if the clicks are already present here, they
+// are the core's (HLE audio microcode), and no amount of pipeline tuning was ever going to help.
+//
+// Off unless CLOUD_GAME_AUDIO_DUMP_DIR is set. Bounded two ways so it can never fill a disk: it stops
+// after CLOUD_GAME_AUDIO_DUMP_SECONDS (default 10) of audio and skips the first
+// CLOUD_GAME_AUDIO_DUMP_SKIP_SECONDS (default 8) so boot silence and the title jingle aren't what gets
+// captured. Writes ONE raw file (S16LE, stereo, interleaved — exactly the core's buffer) plus a small
+// JSON sidecar with the sample rate, because the raw file has no header to carry it.
+//
+// Analysis afterwards is plain arithmetic on the samples: a crackle shows up as isolated
+// sample-to-sample jumps far outside the local signal envelope. Silence in the dump while the game is
+// audibly playing would instead mean the core never produced it.
+type audioDumper struct {
+	dir      string
+	f        *os.File
+	skipLeft atomic.Int64 // frames still to be skipped before capture starts
+	left     atomic.Int64 // frames still to be captured
+	written  atomic.Int64
+	rate     atomic.Int64
+	metaOnce atomic.Bool
+	failed   atomic.Bool
+}
+
+var audioDump = func() *audioDumper {
+	dir := os.Getenv("CLOUD_GAME_AUDIO_DUMP_DIR")
+	if dir == "" {
+		return nil
+	}
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return nil
+	}
+	d := &audioDumper{dir: dir}
+	// Frame counts are derived from the rate at first callback (below); seconds are the knob because
+	// "10 seconds of audio" is what an operator actually wants to reason about.
+	d.skipLeft.Store(int64(envInt("CLOUD_GAME_AUDIO_DUMP_SKIP_SECONDS", 8)))
+	d.left.Store(int64(envInt("CLOUD_GAME_AUDIO_DUMP_SECONDS", 10)))
+	return d
+}()
+
+// dumpAudio is a no-op unless CLOUD_GAME_AUDIO_DUMP_DIR is set. Called on the EMULATOR thread from
+// coreAudioSampleBatch, so it must stay one nil check when disabled and must never block the emulator
+// for long when enabled (a plain buffered write to a local file; the caps keep the total tiny).
+//
+// data points at `frames` stereo frames of int16 (2 channels interleaved) = frames*4 bytes.
+func dumpAudio(data unsafe.Pointer, frames int, rate int) {
+	d := audioDump
+	if d == nil || d.failed.Load() || data == nil || frames <= 0 {
+		return
+	}
+	// Convert the second-based budgets to frames once we know the real rate.
+	if d.metaOnce.CompareAndSwap(false, true) {
+		if rate <= 0 {
+			rate = 44100
+		}
+		d.rate.Store(int64(rate))
+		d.skipLeft.Store(d.skipLeft.Load() * int64(rate))
+		d.left.Store(d.left.Load() * int64(rate))
+		f, err := os.Create(filepath.Join(d.dir, "audio.s16le"))
+		if err != nil {
+			d.failed.Store(true)
+			return
+		}
+		d.f = f
+		meta, _ := json.MarshalIndent(map[string]any{
+			"format": "s16le", "channels": 2, "rate": rate,
+			"note": "raw interleaved stereo PCM captured at audio_cb, BEFORE resample/Opus/WebRTC",
+		}, "", "  ")
+		_ = os.WriteFile(filepath.Join(d.dir, "audio.json"), meta, 0o644)
+	}
+	if d.f == nil {
+		return
+	}
+	if d.skipLeft.Add(-int64(frames)) >= 0 {
+		return
+	}
+	if d.left.Add(-int64(frames)) < 0 {
+		if f := d.f; f != nil {
+			d.f = nil
+			_ = f.Close()
+		}
+		return
+	}
+	// frames*4 bytes: 2 channels * int16. unsafe.Slice is a VIEW, not a copy — deliberately, to keep the
+	// emulator thread cheap. Safe because we write it synchronously here, before returning to the core,
+	// so the core cannot reuse the buffer underneath us. (Avoids needing a cgo preamble in this file.)
+	b := unsafe.Slice((*byte)(data), frames*4)
+	if _, err := d.f.Write(b); err != nil {
+		d.failed.Store(true)
+	}
+	d.written.Add(int64(frames))
+}
diff --git a/pkg/worker/caged/libretro/nanoarch/framedump.go b/pkg/worker/caged/libretro/nanoarch/framedump.go
new file mode 100644
index 0000000..b8fd32e
--- /dev/null
+++ b/pkg/worker/caged/libretro/nanoarch/framedump.go
@@ -0,0 +1,84 @@
+package nanoarch
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+)
+
+// Debug-only RAW frame dump (arcade patch 0022), taken at `video_cb` — i.e. BEFORE the GStreamer
+// pipeline, the 4:2:0 conversion and NVENC. It exists because two questions cannot be answered from the
+// browser:
+//
+//  1. **Anti-aliasing.** The decoded stream is quantized; at any realistic bitrate H.264 erases exactly
+//     the sub-pixel edge gradients that MSAA/SSAA create. A/B'ing AA post-decode is measurement of the
+//     encoder, not of AA. (n64 MSAA 4x measured identical to 0x this way, which proved nothing.)
+//  2. **What size a core really hands us.** CloudRetro sizes the encode from the core's *base* geometry
+//     (`Frontend.FrameSize`), so a core that renders bigger internally but reports a small base looks
+//     identical downstream. The dump records the width/height `video_cb` actually passed.
+//
+// Off unless CLOUD_GAME_FRAME_DUMP_DIR is set. When on it writes `frame-NNN.bin` (raw pixels, exactly as
+// the core produced them) plus `frame-NNN.json` describing how to read them. Bounded by
+// CLOUD_GAME_FRAME_DUMP_COUNT (default 3) so it can never fill a disk, and it skips the first
+// CLOUD_GAME_FRAME_DUMP_SKIP frames (default 300) so boot/black screens don't get captured.
+//
+// GL cores read back bottom-up: `flip` in the sidecar says so. Don't "fix" it in the reader without
+// checking — an upside-down comparison would silently change the edge statistics.
+type frameDumper struct {
+	dir     string
+	left    atomic.Int32
+	skip    atomic.Int32
+	written atomic.Int32
+}
+
+var dumper = func() *frameDumper {
+	dir := os.Getenv("CLOUD_GAME_FRAME_DUMP_DIR")
+	if dir == "" {
+		return nil
+	}
+	d := &frameDumper{dir: dir}
+	d.left.Store(int32(envInt("CLOUD_GAME_FRAME_DUMP_COUNT", 3)))
+	d.skip.Store(int32(envInt("CLOUD_GAME_FRAME_DUMP_SKIP", 300)))
+	_ = os.MkdirAll(dir, 0o755)
+	return d
+}()
+
+func envInt(k string, def int) int {
+	var n int
+	if _, err := fmt.Sscanf(os.Getenv(k), "%d", &n); err == nil && n > 0 {
+		return n
+	}
+	return def
+}
+
+// dumpFrame is a no-op unless CLOUD_GAME_FRAME_DUMP_DIR is set. Called on the emulator thread, so it
+// must stay cheap when disabled (one nil check) and bounded when enabled.
+func dumpFrame(data []byte, w, h, stride uint, bpp uint, pixFmtCode int, isGL bool) {
+	d := dumper
+	if d == nil || d.left.Load() <= 0 {
+		return
+	}
+	if d.skip.Add(-1) >= 0 {
+		return
+	}
+	if d.left.Add(-1) < 0 {
+		return
+	}
+	n := d.written.Add(1)
+
+	base := filepath.Join(d.dir, fmt.Sprintf("frame-%03d", n))
+	if err := os.WriteFile(base+".bin", data, 0o644); err != nil {
+		return
+	}
+	meta := map[string]any{
+		"width": w, "height": h, "stride": stride, "bpp": bpp,
+		"pixFmtCode": pixFmtCode,
+		// GL cores render bottom-left origin, so the readback is upside down.
+		"flip": isGL,
+		"note": "raw core output, pre-scale/pre-encode",
+	}
+	b, _ := json.MarshalIndent(meta, "", "  ")
+	_ = os.WriteFile(base+".json", b, 0o644)
+}
diff --git a/pkg/worker/caged/libretro/nanoarch/input.go b/pkg/worker/caged/libretro/nanoarch/input.go
index ed31bf2..0160823 100644
--- a/pkg/worker/caged/libretro/nanoarch/input.go
+++ b/pkg/worker/caged/libretro/nanoarch/input.go
@@ -2,6 +2,8 @@ package nanoarch
 
 import (
 	"encoding/binary"
+	"fmt"
+	"os"
 	"sync/atomic"
 )
 
@@ -15,6 +17,7 @@ void input_cache_set_port(unsigned port, uint32_t buttons,
 void input_cache_set_keyboard_key(unsigned id, uint8_t pressed);
 void input_cache_set_keyboard_bulk(const uint8_t *keys, size_t count);
 void input_cache_set_mouse(int16_t dx, int16_t dy, uint8_t buttons);
+void input_cache_set_pointer(int16_t x, int16_t y, uint8_t pressed);
 void input_cache_clear(void);
 */
 import "C"
@@ -172,3 +175,70 @@ func (ms *MouseState) Buttons() (l, r, m bool) {
 func (ms *MouseState) SyncToCache() {
 	C.input_cache_set_mouse(C.int16_t(ms.dx.Swap(0)), C.int16_t(ms.dy.Swap(0)), C.uint8_t(ms.buttons.Load()))
 }
+
+// Pointer packet wire format (W10 stylus/touch), on the SAME "data" channel as the RetroPad frame,
+// length-discriminated: the pad frame is 10 or 14 bytes, this is a fixed 8 with a magic tag.
+//
+//	[tag:1=0xF0][ver:1][x:2 LE][y:2 LE][pressed:1][flags:1]
+//
+// x/y are FULL-FRAMEBUFFER normalized (-0x7fff..0x7fff), LITTLE-ENDIAN (matches the pad channel's
+// SetInput; the keyboard channel's big-endian does NOT apply here). The core (melonDS DS) maps these
+// through the active screen layout to the DS touch panel, so nothing here knows the layout.
+const (
+	PointerTag       = 0xF0
+	PointerPacketVer = 0x01
+	PointerPacketLen = 8
+)
+
+// PointerState is the ABSOLUTE touch pointer (RETRO_DEVICE_POINTER). Port-0 only (DS touch = player 1).
+// Unlike MouseState (relative, consumed each sync) the value is absolute and PERSISTS across reads.
+type PointerState struct {
+	x, y    atomic.Int32
+	pressed atomic.Int32
+}
+
+func (ps *PointerState) Set(data []byte) {
+	if len(data) != PointerPacketLen || data[0] != PointerTag {
+		return
+	}
+	ps.x.Store(int32(int16(binary.LittleEndian.Uint16(data[2:4]))))
+	ps.y.Store(int32(int16(binary.LittleEndian.Uint16(data[4:6]))))
+	var p int32
+	if data[6] != 0 {
+		p = 1
+	}
+	ps.pressed.Store(p)
+}
+
+// SyncToCache pushes the absolute pointer to the C cache (NOT consumed). When the diagnostic env is set
+// it injects a constant pressed coordinate instead — see pointerTest below.
+func (ps *PointerState) SyncToCache() {
+	if pointerTestOn {
+		C.input_cache_set_pointer(C.int16_t(pointerTestX), C.int16_t(pointerTestY), 1)
+		return
+	}
+	var pressed C.uint8_t
+	if ps.pressed.Load() != 0 {
+		pressed = 1
+	}
+	C.input_cache_set_pointer(C.int16_t(ps.x.Load()), C.int16_t(ps.y.Load()), pressed)
+}
+
+// pointerTest*: DIAGNOSTIC ONLY (W10 worker->core proof). Set CLOUD_GAME_POINTER_TEST="x,y" (decimal
+// int16, full-frame normalized) to force a constant PRESSED pointer, bypassing the client shim — it
+// proves the RETRO_DEVICE_POINTER read path end-to-end without any browser input. OFF by default, so no
+// debug coordinate ships in the live path (same env-diagnostic pattern as CLOUD_GAME_FRAME_DUMP_DIR).
+var (
+	pointerTestOn        bool
+	pointerTestX         int16
+	pointerTestY         int16
+)
+
+func init() {
+	if s := os.Getenv("CLOUD_GAME_POINTER_TEST"); s != "" {
+		var x, y int
+		if n, _ := fmt.Sscanf(s, "%d,%d", &x, &y); n == 2 {
+			pointerTestOn, pointerTestX, pointerTestY = true, int16(x), int16(y)
+		}
+	}
+}
