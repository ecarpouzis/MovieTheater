+/*
+#cgo pkg-config: gstreamer-video-1.0 gstreamer-app-1.0
+#include <gst/gst.h>
+#include <gst/video/gstvideometa.h>
+#include <gst/app/gstappsrc.h>
+#include <gst/app/gstappsink.h>
+
+static inline GstVideoFormat gstVideoFormatFromString(const gchar *s) {
+	return gst_video_format_from_string(s);
+}
+
+static inline void doubleToFraction(const gdouble src, gint *num, gint *den) {
+	gst_util_double_to_fraction(src, num, den);
+}
+
+// pushVideoBuf COPIES the frame into a new buffer (MovieTheater patch 0004; was zero-copy wrap).
+// The copy frees the emulator's frame memory immediately, so the pusher never has to wait for the
+// encoder before accepting the next frame — throughput is no longer capped at 1/encode-round-trip
+// (which quantized to ~55fps on WSL2 and silently dropped the rest). ~74MB/s at 640x480x60 — noise.
+// The frame duration rides on the GstBuffer so the pull side can restore it for RTP timestamps.
+static inline void pushVideoBuf(GstAppSrc *src, void *data, gsize len,
+                                GstVideoFormat fmt, guint w, guint h, gint stride, guint64 durNs) {
+	// Drop degenerate frames. paraLLEl-RDP (N64, v1 Vulkan) emits a 1x1 frame during its async shader
+	// warmup; renegotiating the appsrc caps to 1x1 and pushing it makes GStreamer error the ENTIRE
+	// pipeline ("Internal data stream error", -5) and video never recovers (real 640x240/480 frames
+	// arrive a beat later but the pipeline is already dead). No real 3D-core output is sub-16px, so
+	// skip these: the pipeline holds its valid build-time caps until the first real frame.
+	if (w < 16 || h < 16) return;
+	// Renegotiate the source caps when the core's frame size changes at runtime. Many PS2 games
+	// (God of War, Kingdom Hearts, FFX, Shadow of the Colossus, Monster Hunter) switch field/frame
+	// height mid-run (interlace / progressive-scan modes). The appsrc caps are fixed at pipeline
+	// build time, so once the frame size diverges the buffer no longer matches and videoconvertscale
+	// rejects EVERY frame ("invalid video buffer received") -> solid green screen. We update only
+	// width/height (format + framerate preserved); the downstream capsfilter keeps the scaled output
+	// constant, so the encoder and WebRTC stream are unaffected — videoconvertscale just rescales.
+	GstCaps *cur = gst_app_src_get_caps(src);
+	if (cur) {
+		GstStructure *st = gst_caps_get_structure(cur, 0);
+		gint cw = 0, ch = 0;
+		gst_structure_get_int(st, "width", &cw);
+		gst_structure_get_int(st, "height", &ch);
+		if ((guint)cw != w || (guint)ch != h) {
+			g_printerr("[video] source caps %dx%d -> %ux%u (core frame size changed)\n", cw, ch, w, h);
+			GstCaps *nc = gst_caps_copy(cur);
+			gst_caps_set_simple(nc, "width", G_TYPE_INT, (gint)w, "height", G_TYPE_INT, (gint)h, NULL);
+			gst_app_src_set_caps(src, nc);
+			gst_caps_unref(nc);
+		}
+		gst_caps_unref(cur);
+	}
+	GstBuffer *buf = gst_buffer_new_allocate(NULL, len, NULL);
+	if (!buf) return;
+	gst_buffer_fill(buf, 0, data, len);
+	GST_BUFFER_DURATION(buf) = durNs;
+	if (stride != 0) {
+		gsize offset[GST_VIDEO_MAX_PLANES] = {0};
+		gint strides[GST_VIDEO_MAX_PLANES] = {stride};
+		gst_buffer_add_video_meta_full(buf, GST_VIDEO_FRAME_FLAG_NONE, fmt, w, h, 1, offset, strides);
+	}
+	gst_app_src_push_buffer(src, buf);
+}
+
+static inline guint64 bufDuration(GstBuffer *buf) { return GST_BUFFER_DURATION(buf); }
+
+// pushAudioBuf copies audio data into a new buffer.
+static inline void pushAudioBuf(GstAppSrc *src, void *data, gsize len) {
+	GstBuffer *buf = gst_buffer_new_allocate(NULL, len, NULL);
+	if (!buf) return;
+	gst_buffer_fill(buf, 0, data, len);
+	gst_app_src_push_buffer(src, buf);
+}
+
+// reconfAudioCaps re-caps the audio appsrc when the core changes its sample rate mid-session
+// (SET_SYSTEM_AV_INFO). The appsrc caps + the audioresample ratio are fixed at pipeline build time, so
+// an unhandled rate change feeds e.g. 32029-rate PCM through a 44100->48000 resampler = a ~27% audio
+// timeline drift (a standing/growing lag). Mirrors the video pushVideoBuf caps-renegotiation exactly:
+// update only "rate" (format/channels/layout preserved); audioresample re-derives its ratio to 48000.
+// Only valid when a resampler is present (room built at a non-48000 rate — the caller guards on that).
+static inline void reconfAudioCaps(GstAppSrc *src, gint rate) {
+	GstCaps *cur = gst_app_src_get_caps(src);
+	if (cur) {
+		GstStructure *st = gst_caps_get_structure(cur, 0);
+		gint cr = 0;
+		gst_structure_get_int(st, "rate", &cr);
+		if (cr != rate) {
+			g_printerr("[audio] source caps rate %d -> %d (core sample_rate changed)\n", cr, rate);
+			GstCaps *nc = gst_caps_copy(cur);
+			gst_caps_set_simple(nc, "rate", G_TYPE_INT, rate, NULL);
+			gst_app_src_set_caps(src, nc);
+			gst_caps_unref(nc);
+		}
+		gst_caps_unref(cur);
+	}
+}
+
+// pullMappedBuffer pulls a sample from the appsink, gets its buffer,
+// and maps it for reading. Returns the buffer (with ref held) on success,
+// or NULL if no sample/buffer is available.
+// The caller must call unmapAndUnref to release.
+static inline GstBuffer* pullMappedBuffer(GstAppSink *sink, GstMapInfo *mapInfo) {
+	GstSample *sample = gst_app_sink_pull_sample(sink);
+	if (!sample) return NULL;
+	GstBuffer *buffer = gst_sample_get_buffer(sample);
+	if (buffer) gst_buffer_ref(buffer);
+	gst_sample_unref(sample);
+	if (!buffer) return NULL;
+	if (!gst_buffer_map(buffer, mapInfo, GST_MAP_READ)) {
+		gst_buffer_unref(buffer);
+		return NULL;
+	}
+	return buffer;
+}
+
+static inline void unmapAndUnref(GstBuffer *buffer, GstMapInfo *mapInfo) {
+	gst_buffer_unmap(buffer, mapInfo);
+	gst_buffer_unref(buffer);
+}
