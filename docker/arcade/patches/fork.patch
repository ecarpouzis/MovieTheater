+ * NOTES: you need to set IV in ctx with AES_init_ctx_iv() or AES_ctx_set_iv()
+ *        no IV should ever be reused with the same key
+ */
+void AES_CTR_xcrypt_buffer(struct AES_ctx* ctx, uint8_t* buf, size_t length);
