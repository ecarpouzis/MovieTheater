+	}
+	return p.username
+}
+
+// LinkRttMs is the latest ICE round-trip time to this peer, in milliseconds, and whether a measurement
+// exists yet. OBSERVABILITY ONLY as of 2026-07-30 — nothing adapts to it.
+//
+// The question it is here to answer: a wired desktop and a Wi-Fi tablet on the SAME LAN are
+// indistinguishable from this side by address (same subnet) and by bandwidth estimate (which is bounded
+// by what we send plus probe headroom, so it reads ~2.4x the send rate on any link, healthy or not).
+// RTT — and especially its VARIANCE, since the tablet's failure mode is radio-queue buildup rather than
+// raw latency — is the only discriminator we have. Log it on real hardware before any threshold is
+// chosen; guessing one is how the gentle ramp gets reverted for the tablet it was built for.
+func (p *Peer) LinkRttMs() (float64, bool) {
+	if p == nil || p.c == nil {
+		return 0, false
+	}
+	s := p.c.SCTP()
+	if s == nil {
+		return 0, false
+	}
+	d := s.Transport()
+	if d == nil {
+		return 0, false
+	}
+	i := d.ICETransport()
+	if i == nil {
+		return 0, false
+	}
+	st, ok := i.GetSelectedCandidatePairStats()
+	if !ok || st.CurrentRoundTripTime <= 0 {
+		return 0, false
+	}
+	return st.CurrentRoundTripTime * 1000, true
+}
+
+// selectedPair returns the nominated ICE candidate pair of the VIDEO PeerConnection, or nil while ICE
+// is still in progress. Reached through the SCTP transport because that is where pion hangs the DTLS →
+// ICE transport chain; our rooms always negotiate the input DataChannel, so SCTP is always present.
+func (p *Peer) selectedPair() *webrtc.ICECandidatePair {
+	s := p.c.SCTP()
+	if s == nil {
+		return nil
+	}
+	d := s.Transport()
+	if d == nil {
+		return nil
+	}
+	i := d.ICETransport()
+	if i == nil {
+		return nil
+	}
+	pair, err := i.GetSelectedCandidatePair()
+	if err != nil {
+		return nil
+	}
+	return pair
+}
