+// setEncoderParam replaces "key=<value>" in a space-separated GStreamer element
+// params string. When the key is absent it is appended only if addIfMissing is
+// true. Video bitrate uses addIfMissing=false on purpose: a non-nvenc/x264 video
+// encoder (e.g. vp8enc) names its rate differently (target-bitrate in bit/s), so
+// a bogus "bitrate=" property must never be injected there.
+func setEncoderParam(params, key, val string, addIfMissing bool) string {
+	fields := strings.Fields(params)
+	found := false
+	for i, f := range fields {
+		if strings.HasPrefix(f, key+"=") {
+			fields[i] = key + "=" + val
+			found = true
+			break
+		}
+	}
+	if !found {
+		if !addIfMissing {
+			return params
+		}
+		fields = append(fields, key+"="+val)
+	}
+	return strings.Join(fields, " ")
+}
+
+// VideoBitrateKbps reads the ACTIVE video codec's configured `bitrate=` (kbit/s), or 0 when it has
+// none. Used as the ABR ceiling for rooms whose creator didn't pick a quality. vpx names its property
+// `target-bitrate` and measures bit/s, so it deliberately reports 0 here rather than a wrong number.
+func (e Encoder) VideoBitrateKbps() int {
+	cs, ok := e.List[strings.ToLower(e.Video.Codec)]
+	if !ok {
+		return 0
+	}
+	for _, f := range strings.Fields(cs.Params) {
+		if v, found := strings.CutPrefix(f, "bitrate="); found {
+			if n, err := strconv.Atoi(v); err == nil && n > 0 {
+				return n
+			}
+		}
+	}
+	return 0
+}
+
+// WithOverrides returns a COPY of the encoder config carrying the per-room quality
+// a room creator chose (arcade per-room bitrate/FEC, threaded in via the t=104
+// GAME_START packet). It never mutates the shared config: List is a reference-type
+// map, so it is deep-copied before any CodecSettings.Params is rewritten — otherwise
+// one room's choice would leak into every concurrent room.
+//
+//	bitrateKbps > 0 → rewrite the ACTIVE video codec's `bitrate=` (kbps; nvh264enc/
+//	                  x264enc). Replace-only (clamped 500..20000 kbps) so vp8's
+//	                  `target-bitrate` is left alone.
+//	fec == 1        → force opus in-band FEC ON  (inband-fec=true,  packet-loss-percentage=15)
+//	fec == 2        → force opus in-band FEC OFF (inband-fec=false, packet-loss-percentage=0)
+//	fec == 0        → leave the opus params exactly as configured.
+func (e Encoder) WithOverrides(bitrateKbps int, fec int, codec string) Encoder {
+	codec = strings.ToLower(strings.TrimSpace(codec))
+	if codec == strings.ToLower(e.Video.Codec) {
+		codec = "" // no-op: already the active codec
+	}
+	if bitrateKbps <= 0 && fec == 0 && codec == "" {
+		return e
+	}
+	nl := make(map[string]CodecSettings, len(e.List))
+	for k, v := range e.List {
+		nl[k] = v
+	}
+	e.List = nl
+
+	// Per-room codec swap (patch 0036) — BEFORE the bitrate rewrite below, so the bitrate lands on
+	// the codec this room will actually encode with. Callers sanitize against e.List (the worker's
+	// roomVideoCodec), so an unknown value can't reach the pipeline builder from here.
+	if codec != "" {
+		if _, ok := e.List[codec]; ok {
+			e.Video.Codec = codec
+		}
+	}
+
+	if bitrateKbps > 0 {
+		if bitrateKbps < 500 {
+			bitrateKbps = 500
+		} else if bitrateKbps > 20000 {
+			bitrateKbps = 20000
+		}
+		vc := strings.ToLower(e.Video.Codec)
+		if cs, ok := e.List[vc]; ok {
+			cs.Params = setEncoderParam(cs.Params, "bitrate", strconv.Itoa(bitrateKbps), false)
+			e.List[vc] = cs
+		}
+	}
+	if fec != 0 {
+		on := fec == 1
+		fecVal, plp := "false", "0"
+		if on {
+			fecVal, plp = "true", "15"
+		}
+		ac := strings.ToLower(e.Audio.Codec)
+		if cs, ok := e.List[ac]; ok {
+			cs.Params = setEncoderParam(cs.Params, "inband-fec", fecVal, true)
+			cs.Params = setEncoderParam(cs.Params, "packet-loss-percentage", plp, true)
+			e.List[ac] = cs
+		}
+	}
+	return e
+}
