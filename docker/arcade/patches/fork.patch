+// State defines any memory state of the emulator
+type State []byte
+
+type mem struct {
+	ptr  unsafe.Pointer
+	size uint
+}
+
+const (
+	CallSerialize   = 1
+	CallUnserialize = 2
+)
+
+// SaveState returns emulator internal state.
+//
+// Patch 0030 — two long-standing faults fixed here:
+//  1. retro_serialize_size ran on the CALLER's goroutine even for LibCo cores, whose entire
+//     lifecycle (retro_run, context_reset) lives on the same_thread pthread — the documented
+//     autosave access violation (PPSSPP), and PCSX2 hard-crashed the same way (0xC0000409,
+//     live 2026-07-09). It now runs where the core runs.
+//  2. same_thread_with_args read the Go POINTER-to-size as the size itself, so every LibCo
+//     serialize/unserialize got a garbage byte count — a size-validating core fastfails, and
+//     load-state "flakiness" (mupen) matches corrupt sizes exactly. Size now travels by value.
+// serializeSize asks the core how many bytes ITS state is, on the thread the core lives on
+// (see SaveState's note 1 — the probe access-violates if it runs anywhere else for LibCo cores).
+func serializeSize() C.size_t {
+	if Nan0.LibCo && !Nan0.hackSkipSameThreadSave {
+		return C.size_t(C.same_thread_serialize_size(retroSerializeSize))
+	}
+	return C.bridge_retro_serialize_size(retroSerializeSize)
+}
+
+func SaveState() (State, error) {
+	size := serializeSize()
+	if size == 0 {
+		return nil, errors.New("retro_serialize_size returned 0 (core cannot save-state this game)")
+	}
+	data := make([]byte, uint(size))
+	rez := false
+
+	if Nan0.LibCo && !Nan0.hackSkipSameThreadSave {
+		rez = *(*bool)(C.same_thread_with_args2(retroSerialize, C.int(CallSerialize), unsafe.Pointer(&data[0]), size))
+	} else {
+		rez = bool(C.bridge_retro_serialize(retroSerialize, unsafe.Pointer(&data[0]), size))
+	}
+
+	if !rez {
+		return nil, errors.New("retro_serialize failed")
+	}
+
+	return data, nil
+}
+
+// RestoreSaveState restores emulator internal state.
+func RestoreSaveState(st State) error {
+	if len(st) <= 0 {
+		return errors.New("empty load state")
+	}
+
+	// A state this core did not write must never reach retro_unserialize. Cores validate the
+	// buffer they are handed only loosely, and a rejected load does not leave them intact:
+	// PCSX2 given a Dolphin state logged "GS: Savestate version is incompatible. Load aborted."
+	// and then access-violated on the next tick (0xC0000005, live 2026-07-11). The worker died,
+	// the runner restarted it, the same save was re-seeded, and the room crash-looped forever —
+	// the game simply never booted again. A core is entitled to crash on foreign bytes; our job
+	// is not to hand them over.
+	//
+	// The test is SIZE, but it cannot be equality: retro_serialize_size is not stable for every
+	// core. Dolphin's grows as the game warms up — it reports 111,735,182 bytes five seconds into
+	// Gauntlet's boot (when the deferred restore runs) and writes 122,064,041 at session end, so
+	// demanding an exact match refused the player's own GameCube save (measured 2026-07-11).
+	//
+	// A foreign core is wrong by MULTIPLES, not percent: PCSX2 wants 50,599,322 bytes for that
+	// same 122 MB Dolphin state (2.4x), and a PS2 state offered to Dolphin is 0.45x. Same-core
+	// drift is single-digit percent. So bound the ratio generously — wide enough that no core's
+	// own state is ever turned away, tight enough that another core's never gets through.
+	want := serializeSize()
+	if want == 0 {
+		return errors.New("retro_serialize_size returned 0 (core cannot load-state this game)")
+	}
+	if ratio := float64(len(st)) / float64(want); ratio < 0.5 || ratio > 2 {
+		return fmt.Errorf("refusing a foreign save state: this core wants ~%v bytes, the save has %v (%.2fx)",
+			uint(want), len(st), ratio)
+	}
+
+	size := C.size_t(len(st))
+	rez := false
+
+	if Nan0.LibCo {
+		rez = *(*bool)(C.same_thread_with_args2(retroUnserialize, C.int(CallUnserialize), unsafe.Pointer(&st[0]), size))
+	} else {
+		rez = bool(C.bridge_retro_unserialize(retroUnserialize, unsafe.Pointer(&st[0]), size))
+	}
+
+	if !rez {
+		return errors.New("retro_unserialize failed")
+	}
+
+	return nil
+}
+
+// SaveRAM returns the game save RAM (cartridge) data or a nil slice.
+func SaveRAM() State {
+	memory := ptSaveRAM()
+	if memory == nil {
+		return nil
+	}
+	return C.GoBytes(memory.ptr, C.int(memory.size))
+}
+
+// RestoreSaveRAM restores game save RAM.
+func RestoreSaveRAM(st State) {
+	if len(st) > 0 {
+		if memory := ptSaveRAM(); memory != nil {
+			//noinspection GoRedundantConversion
+			copy(unsafe.Slice((*byte)(memory.ptr), memory.size), st)
+		}
+	}
+}
