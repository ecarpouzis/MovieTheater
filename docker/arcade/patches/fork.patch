+func TestBuildVideoPipeline(t *testing.T) {
+	p, err := buildVideoPipeline(640, 480, 640, 480, pixFmtBGRx, "bilinear2", 0, testVideoCodec, testLog, 0, false, "", false, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if p.zeroCopy || p.source == nil || p.srcPad == nil {
+		t.Fatal("empty srcChain must build the appsrc path")
+	}
+	p.destroy()
+}
+
+// The zero-copy head (P4) replaces the appsrc with a live source and links it straight into the
+// encoder. videotestsrc stands in for the d3d12 capture element so this runs anywhere: what is under
+// test is the WIRING — that the head is honoured, that `video_enc` (ABR + per-room codec) and
+// `video_valve` (the desktop gate) still exist by name, and that there is no appsrc to push into.
+func TestBuildVideoPipelineZeroCopy(t *testing.T) {
+	// I420 because the stand-in encoder is vp8 (the real chain hands NVENC NV12 in GPU memory —
+	// see capture.App.VideoSrcChain). The head's job here is only to prove the wiring.
+	chain := "videotestsrc name=video_src is-live=true ! video/x-raw,framerate=60/1 " +
+		"! valve name=video_valve drop=true ! videoconvert ! video/x-raw,format=I420,width=640,height=480"
+	p, err := buildVideoPipeline(640, 480, 640, 480, pixFmtBGRx, "", 0, testFullCodec, testLog, 60, false, chain, false, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.destroy()
+	if !p.zeroCopy {
+		t.Fatal("srcChain must mark the pipe zero-copy")
+	}
+	if p.source != nil || p.srcPad != nil {
+		t.Fatal("zero-copy has no appsrc: nothing may push frames from Go")
+	}
+	if p.enc == nil {
+		t.Fatal("no video_enc: ABR and the per-room codec would silently stop working")
+	}
+	if p.valve == nil {
+		t.Fatal("no video_valve: the desktop could not be gated off the stream")
+	}
+}
