+// ── Per-user virtual memory cards (MovieTheater patch 0039) ──────────────────────────────────────
+//
+// A memory card is the one save class libretro never exposes: PCSX2 and Dolphin write theirs into
+// their own directories, so a card is ONE file shared by every player — outside the per-user vault,
+// with no backup. For some games that card IS the progress: Gauntlet Dark Legacy keeps its named
+// characters on the GameCube card, not in the save-state, so a player's characters were visible to
+// (and deletable by) everyone, and would vanish with the directory.
+//
+// The worker has to be the one to move them. The gateway can't: the COORDINATOR picks which worker
+// serves a room, so the gateway never knows whose card directory is in play. The worker knows its
+// own dirs and runs exactly one room at a time — which is also why each worker now needs its OWN
+// ConfDir (two workers sharing one would seed and harvest each other's cards).
+//
+// Only the CARD subtree moves. The save dir also holds Dolphin's shader caches (~850 MB), which are
+// shared, disposable, and regenerate — vaulting those per session would be absurd.
+
+// cardOwner parses the room id the site mints (sv-<user>-<game>-<slot>-<system>___<key>, ArcadeSaveId).
+// Returns ok=false for a stock random room id, which correctly means "no owner, leave cards alone".
+func cardOwner(roomId string) (user string, system string, ok bool) {
+	if !strings.HasPrefix(roomId, "sv-") {
+		return "", "", false
+	}
+	sep := strings.Index(roomId, "___")
+	if sep < 0 {
+		return "", "", false
+	}
+	parts := strings.SplitN(roomId[len("sv-"):sep], "-", 4)
+	if len(parts) != 4 || parts[0] == "" || parts[3] == "" {
+		return "", "", false
+	}
+	return parts[0], parts[3], true
+}
+
+// card is where a system keeps its memory card in the worker's dirs. Two shapes, because the cores
+// disagree:
+//
+//	dir  — the card IS a directory and everything under it is card (gc: <save>/User/GC, ps2:
+//	       <system>/pcsx2/memcards). Seed/harvest move the whole subtree.
+//	glob — the card is loose FILES in a directory that also holds things we must never touch (dc:
+//	       vmu_save_*.bin sit in the Dreamcast system dir next to dc_boot.bin/dc_flash.bin). Only
+//	       the matching files move; the BIOS beside them is invisible to every card operation.
+type card struct {
+	dir     string // directory the core reads/writes
+	pattern string // "" = the whole dir is the card; otherwise only files matching this name
+}
+
+func (c card) empty() bool { return c.dir == "" }
+
+// cardFor resolves the configured card for a system: "<root>:<path>", root = save|system. A trailing
+// path element containing a wildcard makes it a file set rather than a directory, e.g.
+// "system:dc/vmu_save_*.bin". Empty when the system has no card (most cores) or the feature is off.
+func (f *Frontend) cardFor(system string) card {
+	if f.conf.CardVault == "" {
+		return card{}
+	}
+	spec, ok := f.conf.Cards[system]
+	if !ok {
+		return card{}
+	}
+	root, rel, found := strings.Cut(spec, ":")
+	if !found {
+		f.log.Error().Msgf("cards: bad spec for %v: %q (want \"save:<path>\" or \"system:<path>\")", system, spec)
+		return card{}
+	}
+
+	// uniqueSaveDir and a save-rooted card are mutually exclusive, and silently so — which is why this
+	// refuses rather than warns. uniqueSaveDir re-points nano.SaveDir() at a PER-SESSION subdirectory,
+	// so "save:User/GC" would resolve somewhere the core never writes its card: we would faithfully
+	// vault an empty directory over the player's real one every session. It is off for every carded
+	// core today; this exists so that turning it back on fails loudly instead of eating saves.
+	if f.UniqueSaveDir && root == "save" {
+		f.log.Error().Msgf(
+			"cards: %v has uniqueSaveDir AND a save-rooted card (%q) — these cannot both be on: the card "+
+				"would resolve inside the per-session save dir. Cards DISABLED for this room; fix the config.",
+			system, spec)
+		return card{}
+	}
+
+	var base string
+	switch root {
+	case "save":
+		base = f.nano.SaveDir()
+	case "system":
+		base = f.nano.SystemDir()
+	default:
+		f.log.Error().Msgf("cards: unknown root %q for %v", root, system)
+		return card{}
+	}
+
+	rel = filepath.FromSlash(rel)
+	if last := filepath.Base(rel); strings.ContainsAny(last, "*?[") {
+		if dir := filepath.Dir(rel); dir != "." {
+			return card{dir: filepath.Join(base, dir), pattern: last}
+		}
+		return card{dir: base, pattern: last}
+	}
+	return card{dir: filepath.Join(base, rel)}
+}
+
+func (f *Frontend) vaultDir(user, system string) string {
+	return filepath.Join(f.conf.CardVault, user, system)
+}
+
+// ownerFile records who the card currently in the worker's directory belongs to, so that a worker
+// that DIED without harvesting (the exit-139 teardown, a kill) can still have that player's card
+// recovered on the next room rather than cleared out from under them. A glob card's dir is SHARED
+// (dc's VMUs sit in the BIOS dir), so its stamp is system-scoped and can't collide with a neighbour.
+const cardOwnerFile = ".owner"
+
+func (f *Frontend) cardOwnerPath(system string, c card) string {
+	if c.pattern == "" {
+		return filepath.Join(c.dir, cardOwnerFile)
+	}
+	return filepath.Join(c.dir, cardOwnerFile+"-"+system)
+}
+
+// vaultCard copies the card OUT of the worker's dir into a player's vault. It never deletes, never
+// replaces a vault file with an older one, and discards any copy the core tore by writing to the
+// card mid-read (see os.CopyTreeNewer) — so it is safe to call while the core is still running.
+func (f *Frontend) vaultCard(c card, vault string) error {
+	if c.pattern == "" {
+		return os.CopyTreeNewer(c.dir, vault)
+	}
+	return os.CopyGlobNewer(c.dir, c.pattern, vault)
+}
+
+// vaultHasCard reports whether this player has a card of this shape already stored.
+func (f *Frontend) vaultHasCard(c card, vault string) bool {
+	if c.pattern == "" {
+		return os.Exists(vault)
+	}
+	files, err := os.GlobFiles(vault, c.pattern)
+	return err == nil && len(files) > 0
+}
+
+// seedCards puts THIS room owner's card in place before the core loads the game.
+func (f *Frontend) seedCards() {
+	user, system, ok := cardOwner(f.storage.MainPath())
+	if !ok {
+		return
+	}
+	c := f.cardFor(system)
+	if c.empty() {
+		return
+	}
+
+	// Whoever used this directory last may never have been harvested: a worker that dies skips the
+	// close path entirely, and that is NOT rare — flycast corrupts the heap on teardown often enough
+	// (0xC0000374) that a Dreamcast room ending in a dead worker is routine. Vault what's here before
+	// touching it.
+	//
+	// This runs even when the previous owner IS this user, and that is the whole point. Skipping it
+	// then looks harmless but is the worst case there is: a first-time player crashes before their
+	// first harvest, rejoins, and — with an empty vault and their only copy sitting right here — the
+	// "fresh card" branch below would wipe the session the crash already failed to save.
+	if prev, err := os.ReadFile(f.cardOwnerPath(system, c)); err == nil {
+		if p := strings.TrimSpace(string(prev)); p != "" {
+			if err := f.vaultCard(c, f.vaultDir(p, system)); err != nil {
+				// ABORT THE SEED. Do not log-and-continue: the seed below CLEARS or OVERWRITES this
+				// directory, so carrying on here would destroy the very card we just failed to save —
+				// a locked file or a full disk would turn into someone's progress gone for good. The
+				// room boots on whatever card is already in place (the previous player's, so we do
+				// not stamp a new owner either). Wrong card beats no card: it is recoverable, and the
+				// next room retries the recovery.
+				f.log.Error().Err(err).Msgf(
+					"cards: could not recover user %v's unharvested %v card — REFUSING to seed over it; "+
+						"this room runs on the card that is already here", p, system)
+				return
+			}
+			if p != user {
+				f.log.Info().Msgf("cards: recovered an unharvested %v card for user %v", system, p)
+			} else {
+				f.log.Info().Msgf("cards: recovered your own unharvested %v card (user %v)", system, p)
+			}
+		}
+	}
+
+	vault := f.vaultDir(user, system)
+	switch {
+	case !f.vaultHasCard(c, vault):
+		// First time this user plays this system. Their card starts EMPTY rather than inheriting
+		// whatever the previous player left behind — a fresh card, like a new console. The core
+		// re-creates (and formats) what it needs on boot.
+		// (Existing shared cards are migrated into each user's vault out of band; see the skill.)
+		var err error
+		if c.pattern == "" {
+			err = os.ClearDir(c.dir)
+		} else {
+			err = os.ClearGlob(c.dir, c.pattern)
+		}
+		if err != nil {
+			f.log.Error().Err(err).Msgf("cards: could not clear the %v card", system)
+			return
