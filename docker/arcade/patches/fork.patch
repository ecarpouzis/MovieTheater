+/*
+#cgo CFLAGS: -I${SRCDIR}
+#include "libretro.h"
+#include "nanoarch.h"
+#include <stdlib.h>
+*/
+import "C"
+
+var (
+	RGBA5551    = PixFmt{C: 0, BPP: 2} // BIT_FORMAT_SHORT_5_5_5_1 has 5 bits R, 5 bits G, 5 bits B, 1 bit alpha
+	RGBA8888Rev = PixFmt{C: 1, BPP: 4} // BIT_FORMAT_INT_8_8_8_8_REV has 8 bits R, 8 bits G, 8 bits B, 8 bit alpha
+	RGB565      = PixFmt{C: 2, BPP: 2} // BIT_FORMAT_SHORT_5_6_5 has 5 bits R, 6 bits G, 5 bits
+)
+
+type Nanoarch struct {
+	Handlers
+
+	keyboard KeyboardState
+	mouse    MouseState
+	retropad InputState
+
+	pendingDisk atomic.Int32 // patch 0005: queued disc index+1 (0 = none), applied on the emulator thread in Run
+
+	keyboardCb    *C.struct_retro_keyboard_callback
+	LastFrameTime time.Time
+	LibCo         bool
+	meta          Metadata
+	options       map[string]string
+	options4rom   map[string]map[string]string
+	fps4rom       map[string]float64
+	roomOptions   map[string]string // per-room core-option cheats, applied just before retro_load_game
+	cheats        []string          // per-room cheat codes, applied via retro_cheat_set after it
+	// HwContextOverride stages a per-ROOM hardware-context override ("vulkan"), set by the room layer
+	// (coordinatorhandlers) when the game's per-game override requests a Vulkan renderer
+	// (overrides.WantsVulkanRenderer). Consumed and CLEARED by the next CoreLoad — same staging
+	// lifecycle as roomOptions/cheats, so it can never leak into the next room on this singleton.
+	// It exists because the context choice is per-GAME (Stuntman -> paraLLEl-GS) while the core
+	// config's HwContext is per-SYSTEM, and BOTH the core path and the media pipeline's GLZeroCopy
+	// (build-time!) must agree before app.Load.
+	HwContextOverride string
+	// VkZeroCopyStaged / VkZeroCopyFence: staged by the coordinator alongside HwContextOverride, consumed
+	// + cleared in CoreLoad. When a Vulkan room is also zero-copy-capable (extensions probed, kill-switch
+	// off) the coordinator sets VkZeroCopyStaged so CoreLoad brings up the GL import context + pool.
+	VkZeroCopyStaged bool
+	VkZeroCopyFence  bool
+	reserved      chan struct{} // limits concurrent use
+	Rot           uint
+	serializeSize C.size_t
+	Stopped       atomic.Bool
+	sys           struct {
+		av  C.struct_retro_system_av_info
+		i   C.struct_retro_system_info
+		api C.unsigned
+	}
+	tickTime         time.Duration
+	cSaveDirectory   *C.char
+	cSystemDirectory *C.char
+	cUserName        *C.char
+	Video            struct {
+		gl struct {
+			enabled bool
+			autoCtx bool
+		}
+		// vk: the core renders with RETRO_HW_CONTEXT_VULKAN and we capture its frames through the
+		// Vulkan-capture frontend (nanoarch_vulkan.c) instead of a GL/RGFW context. Mutually exclusive
+		// with gl.enabled — a Vulkan core never touches the WGL/RGFW path.
+		vk struct {
+			enabled bool
+			// zeroCopy: this room runs the M2 Vulkan->GL external-memory zero-copy path (the core's frame
+			// is imported as a GL texture and fed to the encoder through zc_push) instead of the M1
+			// readback. Decided per-room by the coordinator (staged in VkZeroCopyStaged, consumed in
+			// CoreLoad); requires the external-memory/semaphore extensions (probed) and the kill-switch off.
+			zeroCopy bool
+			zcFence  bool // conservative layer-2 sync (host fence-wait the blit) — CLOUD_GAME_VK_ZEROCOPY=fence
+			zcReady  bool // pool + GL imports built successfully this room
+			// captureBroken: the media pipeline was committed to GL-texture mode (the coordinator armed
+			// vkZeroCopy because the box-level extension PROBE passed), but the core's actual device could
+			// NOT do zero-copy (e.g. flycast v1 create_device ignored our required_device_extensions), so
+			// zc setup failed. Readback frames are system memory and CANNOT feed a GLMemory appsrc — pushing
+			// them crashes the worker (flycast GPF, live 2026-07-16). When set, coreVideoRefresh DROPS every
+			// frame: the room shows black but the worker survives (fail-soft). Reset per room in CoreLoad.
+			captureBroken bool
+		}
+		hw     *C.struct_retro_hw_render_callback
+		PixFmt PixFmt
+	}
+	vfr    bool
+	Aspect bool
+	// GLZeroCopy: hand HW-rendered frames to the encoder as a GL texture instead of pulling them back
+	// with glReadPixels. Only meaningful for GL cores; ignored by everything else (a software core's
+	// frame is already in system memory, so there is nothing to keep on the GPU).
+	GLZeroCopy bool
+	glCtx      *graphics.RGFW
+	hackSkipHwContextDestroy bool
+	hackSkipSameThreadSave   bool
+	hackSkipBootRestore      bool
+	// MovieTheater patch 0016: skip the informational retro_serialize_size probe right after load.
+	// Dolphin defers its whole video/emu init to context_reset + first retro_run (its EmuThread spawns
+	// there), so serialize_size at load walks the save-state chain into a NULL g_vertex_manager →
+	// 0xc0000005 at boot. The probe only feeds a log line; the real save path re-queries at save time.
+	hackSkipSerializeSizeProbe bool
+	// hackVkSyntheticSurface: hand the Vulkan core a REAL (hidden-window) VkSurfaceKHR at create_device
+	// instead of VK_NULL_HANDLE. PPSSPP's libretro Vulkan context demands a non-null surface (it echoes
+	// the frontend handle back through its swapchain warp and queries surface caps on it through the real
+	// driver — a null there access-violated live 2026-07-16). Opt-in per core (paraLLEl-GS/RDP never
+	// touch a surface); consumed by nano_vk_set_synthetic_surface before nano_vk_init.
+	hackVkSyntheticSurface   bool
+	limiter                  func(func())
+	log                      *logger.Logger
+
+	audioBuffCb    *C.struct_retro_audio_buffer_status_callback
+	lastFrameDelta float64 // most recent frame delta (ns)
+	audioDrift     float64 // cumulative timing drift for frameskip
+}
+
+type Handlers struct {
+	OnAudio        func(ptr unsafe.Pointer, frames int)
+	OnVideo        func(data []byte, delta time.Duration, fi FrameInfo)
+	OnDup          func()
+	OnSystemAvInfo func()
+}
+
+type FrameInfo struct {
+	// Tex is the GL texture holding this frame (GL zero-copy, HW cores only). Non-zero => Data is nil
+	// and the frame never left VRAM: the encoder reads the texture directly instead of us pulling it
+	// back over PCIe with glReadPixels. See graphics/zerocopy.go.
+	Tex uint32
+	W      uint
+	H      uint
+	Stride uint
+}
+
+type Metadata struct {
+	FrameDup        bool
+	LibPath         string // the full path to some emulator lib
+	IsGlAllowed     bool
+	// HwContext selects the hardware-render context the core uses: "" / "gl" = the OpenGL path
+	// (RGFW/WGL, the historical default gated by IsGlAllowed), "vulkan" = the Vulkan-capture path
+	// (RETRO_HW_CONTEXT_VULKAN + nanoarch_vulkan.c). A "vulkan" core does NOT create a GL context.
+	HwContext       string
+	UsesLibCo       bool
+	AutoGlContext   bool
+	HasVFR          bool
+	Options         map[string]string
+	Options4rom     map[string]map[string]string
+	Fps4rom         map[string]float64
+	Hacks           []string
+	Hid             map[int][]int
+	CoreAspectRatio bool
+	KbMouseSupport  bool
+	LibExt          string
+}
+
+type PixFmt struct {
+	C   uint32
+	BPP uint
+}
+
+func (p PixFmt) String() string {
+	switch p.C {
+	case 0:
+		return "RGBA5551/2"
+	case 1:
+		return "RGBA8888Rev/4"
+	case 2:
+		return "RGB565/2"
+	default:
+		return fmt.Sprintf("Unknown (%v/%v)", p.C, p.BPP)
+	}
+}
+
+// Nan0 is a global link for C callbacks to Go
+var Nan0 = Nanoarch{
+	reserved: make(chan struct{}, 1), // this thing forbids concurrent use of the emulator
+	Stopped:  atomic.Bool{},
+	limiter:  func(fn func()) { fn() },
+	Handlers: Handlers{
+		OnAudio: func(unsafe.Pointer, int) {},
+		OnVideo: func([]byte, time.Duration, FrameInfo) {},
+		OnDup:   func() {},
+	},
+}
+
+// init provides a global single instance lock
+// !to remove when isolated properly
+func init() { Nan0.reserved <- struct{}{} }
+
+func NewNano(localPath string) *Nanoarch {
+	nano := &Nan0
+	nano.cSaveDirectory = C.CString(localPath + "/legacy_save")
+	nano.cSystemDirectory = C.CString(localPath + "/system")
+	nano.cUserName = C.CString("retro")
+	return nano
+}
+
+func (n *Nanoarch) AspectRatio() float32             { return float32(n.sys.av.geometry.aspect_ratio) }
+func (n *Nanoarch) AudioSampleRate() int             { return int(n.sys.av.timing.sample_rate) }
+func (n *Nanoarch) VideoFramerate() float64          { return float64(n.sys.av.timing.fps) }
+func (n *Nanoarch) IsPortrait() bool                 { return 90 == n.Rot%180 }
+func (n *Nanoarch) KbMouseSupport() bool             { return n.meta.KbMouseSupport }
+func (n *Nanoarch) BaseWidth() int                   { return int(n.sys.av.geometry.base_width) }
+func (n *Nanoarch) BaseHeight() int                  { return int(n.sys.av.geometry.base_height) }
+func (n *Nanoarch) WaitReady()                       { <-n.reserved }
+func (n *Nanoarch) Close()                           { n.Stopped.Store(true); n.reserved <- struct{}{} }
+func (n *Nanoarch) SetLogger(log *logger.Logger)     { n.log = log }
+func (n *Nanoarch) SetVideoDebounce(t time.Duration) { n.limiter = NewLimit(t) }
+func (n *Nanoarch) SaveDir() string                  { return C.GoString(n.cSaveDirectory) }
+func (n *Nanoarch) SystemDir() string                { return C.GoString(n.cSystemDirectory) }
+// SetRoomCheats stages one room's cheats for the next LoadGame, which consumes and clears them.
+// Passing nils is meaningful: it wipes whatever the previous room on this worker staged.
+func (n *Nanoarch) SetRoomCheats(opts map[string]string, codes []string) {
+	n.roomOptions, n.cheats = opts, codes
+}
+
+func (n *Nanoarch) SetSaveDirSuffix(sx string) {
+	dir := C.GoString(n.cSaveDirectory) + "/" + sx
+	err := os.CheckCreateDir(dir)
+	if err != nil {
+		n.log.Error().Msgf("couldn't create %v, %v", dir, err)
+	}
+	if n.cSaveDirectory != nil {
+		C.free(unsafe.Pointer(n.cSaveDirectory))
+	}
+	n.cSaveDirectory = C.CString(dir)
+}
+func (n *Nanoarch) DeleteSaveDir() error {
+	if n.cSaveDirectory == nil {
+		return nil
+	}
+
+	dir := C.GoString(n.cSaveDirectory)
+	return os.RemoveAll(dir)
+}
+
+func (n *Nanoarch) CoreLoad(meta Metadata) {
+	var err error
+	// Per-room hardware-context override (see the field comment): consume + clear the staging.
+	if n.HwContextOverride != "" {
+		n.log.Info().Msgf("hw context override for this room: %q (core default %q)", n.HwContextOverride, meta.HwContext)
+		meta.HwContext = n.HwContextOverride
+		n.HwContextOverride = ""
+	}
+	n.meta = meta
+	n.LibCo = meta.UsesLibCo
+	n.vfr = meta.HasVFR
+	n.Aspect = meta.CoreAspectRatio
+	n.Video.gl.autoCtx = meta.AutoGlContext
+	// Vulkan cores are hardware-rendered but bypass the GL/RGFW path entirely (they use the
+	// Vulkan-capture frontend). Everything else keeps the historical IsGlAllowed gate.
+	n.Video.vk.enabled = meta.HwContext == "vulkan"
+	// GL is on for cores that allow it, AND for a room the per-game GL escape hatch explicitly pins to
+	// "gl" even though the core config defaults to Vulkan (isGlAllowed:false). Without the HwContext=="gl"
+	// term, an escaped game on a Vulkan-default core gets NEITHER context and the core fails to load.
+	n.Video.gl.enabled = (meta.IsGlAllowed || meta.HwContext == "gl") && !n.Video.vk.enabled
+	// M2 zero-copy is per-room; consume the staged decision (like HwContextOverride) so it cannot leak
+	// into the next room. A zero-copy Vulkan room DOES need a GL context (the import context), so it
+	// switches graphics on like a GL core would.
+	n.Video.vk.zeroCopy = n.Video.vk.enabled && n.VkZeroCopyStaged
+	n.Video.vk.zcFence = n.VkZeroCopyFence
+	n.Video.vk.zcReady = false
+	n.Video.vk.captureBroken = false
+	n.VkZeroCopyStaged = false
+	n.VkZeroCopyFence = false
+
+	Nan0.audioBuffCb = nil
+
+	// The GL path and the Vulkan zero-copy import context both need the graphics thread; a plain Vulkan
+	// (M1 readback) room does all its work on the core's cothread, so it leaves graphics off.
+	thread.SwitchGraphics(n.Video.gl.enabled || n.Video.vk.zeroCopy)
+
+	// hacks
+	Nan0.hackSkipHwContextDestroy = meta.HasHack("skip_hw_context_destroy")
+	Nan0.hackSkipSameThreadSave = meta.HasHack("skip_same_thread_save")
+	Nan0.hackSkipBootRestore = meta.HasHack("skip_boot_restore")
+	Nan0.hackSkipSerializeSizeProbe = meta.HasHack("skip_serialize_size_probe")
+	Nan0.hackVkSyntheticSurface = meta.HasHack("vk_synthetic_surface")
+
+	// reset controllers
+	n.retropad = InputState{}
+	n.keyboardCb = nil
+	n.keyboard = KeyboardState{}
+	n.mouse = MouseState{}
+
+	n.options = maps.Clone(meta.Options)
+	n.options4rom = meta.Options4rom
+	n.fps4rom = meta.Fps4rom
+
+	corePath := meta.LibPath + meta.LibExt
+	coreLib, err = open(corePath)
+	if err != nil {
+		n.log.Fatal().Err(err).Msgf("core load: %s", corePath)
+	}
+
+	retroInit = coreLib.load("retro_init")
+	retroDeinit = coreLib.load("retro_deinit")
+	retroAPIVersion = coreLib.load("retro_api_version")
+	retroGetSystemInfo = coreLib.load("retro_get_system_info")
+	retroGetSystemAVInfo = coreLib.load("retro_get_system_av_info")
+	retroSetEnvironment = coreLib.load("retro_set_environment")
+	retroSetVideoRefresh = coreLib.load("retro_set_video_refresh")
+	retroSetInputPoll = coreLib.load("retro_set_input_poll")
+	retroSetInputState = coreLib.load("retro_set_input_state")
+	retroSetAudioSample = coreLib.load("retro_set_audio_sample")
+	retroSetAudioSampleBatch = coreLib.load("retro_set_audio_sample_batch")
+	retroReset = coreLib.load("retro_reset")
+	retroRun = coreLib.load("retro_run")
+	retroLoadGame = coreLib.load("retro_load_game")
+	retroCheatReset = coreLib.load("retro_cheat_reset")
+	retroCheatSet = coreLib.load("retro_cheat_set")
+	retroUnloadGame = coreLib.load("retro_unload_game")
+	retroSerializeSize = coreLib.load("retro_serialize_size")
+	retroSerialize = coreLib.load("retro_serialize")
+	retroUnserialize = coreLib.load("retro_unserialize")
+	retroSetControllerPortDevice = coreLib.load("retro_set_controller_port_device")
+	retroGetMemorySize = coreLib.load("retro_get_memory_size")
+	retroGetMemoryData = coreLib.load("retro_get_memory_data")
+
+	C.bridge_retro_set_environment(retroSetEnvironment, C.core_environment_cgo)
+	C.bridge_retro_set_input_state(retroSetInputState, C.core_input_state_cgo)
+	C.bridge_set_callback(retroSetVideoRefresh, C.core_video_refresh_cgo)
+	C.bridge_set_callback(retroSetInputPoll, C.core_input_poll_cgo)
+	C.bridge_set_callback(retroSetAudioSample, C.core_audio_sample_cgo)
+	C.bridge_set_callback(retroSetAudioSampleBatch, C.core_audio_sample_batch_cgo)
+
+	if n.LibCo {
+		C.same_thread(retroInit)
+	} else {
+		C.bridge_call(retroInit)
+	}
+
+	n.sys.api = C.bridge_retro_api_version(retroAPIVersion)
+	C.bridge_retro_get_system_info(retroGetSystemInfo, &n.sys.i)
+	n.log.Info().Msgf("System >>> %v (%v) [%v] nfp: %v, api: %v",
+		C.GoString(n.sys.i.library_name), C.GoString(n.sys.i.library_version),
+		C.GoString(n.sys.i.valid_extensions), bool(n.sys.i.need_fullpath),
+		uint(n.sys.api))
+}
+
+func (n *Nanoarch) LoadGame(path string) error {
+	game := C.struct_retro_game_info{}
+
+	big := bool(n.sys.i.need_fullpath) // big ROMs are loaded by cores later
+	if big {
+		size, err := os.StatSize(path)
+		if err != nil {
+			return err
+		}
+		game.size = C.size_t(size)
+	} else {
+		bytes, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		// !to pin in 1.21
+		ptr := unsafe.Pointer(C.CBytes(bytes))
+		game.data = ptr
+		game.size = C.size_t(len(bytes))
+		defer C.free(ptr)
+	}
+	fp := C.CString(path)
+	defer C.free(unsafe.Pointer(fp))
+	game.path = fp
+
+	n.log.Debug().Msgf("ROM - big: %v, size: %v", big, byteCountBinary(int64(game.size)))
+
+	romName := strings.TrimSuffix(filepath.Base(path), filepath.Ext(path))
+
+	// maybe some custom options (static per-ROM overrides from config.yaml)
+	if n.options4rom != nil {
+		if _, ok := n.options4rom[romName]; ok {
+			for k, v := range n.options4rom[romName] {
+				n.options[k] = v
+				n.log.Debug().Msgf("Replace: %v=%v", k, v)
+			}
+		}
+	}
+
+	// Arcade per-game config manifest (game-overrides.json, DB-driven via arcade-gameconfig-export).
+	// Core-option overrides here win over config; the forced-fps field is applied after av-info below.
+	override, hasOverride := gameOverrides()[romName]
+	if hasOverride {
+		for k, v := range override.Options {
+			n.options[k] = v
+			n.log.Info().Msgf("[game-override] option %v=%v for %q", k, v, romName)
+		}
+	}
+
+	// Per-room cheats, part 1: core-option cheats (arcade cheats feature). LAST writer wins on purpose —
+	// this is one player's explicit choice for one room, so it outranks the static config and the per-game
+	// manifest. The core reads these while loading, so they must land before retro_load_game.
+	for k, v := range n.roomOptions {
+		n.options[k] = v
+		n.log.Info().Msgf("[room-cheat] option %v=%v", k, v)
+	}
+
+	if ok := C.bridge_retro_load_game(retroLoadGame, &game); !ok {
+		return fmt.Errorf("core failed to load ROM: %v", path)
+	}
+
+	// Per-room cheats, part 2: cheat codes, which are only meaningful once the game is loaded (they poke
+	// its memory).
+	//
+	// retro_cheat_reset runs UNCONDITIONALLY. Nanoarch is a process-wide singleton (Nan0) and a worker
+	// serves one room after another, so "only reset when this room has cheats" would let the previous
+	// room's codes survive into a room that asked for none. RetroArch resets on every content load too.
+	//
+	// Every core EXPORTS retro_cheat_set — a good number implement it as an empty stub, and then a code is
+	// accepted and does nothing. There is no way to detect that from here, which is why the site only
+	// offers codes on the systems ArcadeCheatCatalog.SupportsCheatCodes allowlists.
+	C.bridge_retro_cheat_reset(retroCheatReset)
+	applied := 0
+	for _, code := range n.cheats {
+		if code == "" {
+			continue
+		}
+		cs := C.CString(code)
+		C.bridge_retro_cheat_set(retroCheatSet, C.unsigned(applied), C.bool(true), cs)
+		C.free(unsafe.Pointer(cs))
+		applied++
+	}
+	if applied > 0 {
+		n.log.Info().Msgf("[room-cheat] applied %d cheat code(s)", applied)
+	}
+	// Staged per-room state is consumed here. Clearing it means a later load on this singleton — a disc
+	// swap, a core reload — can't silently re-apply a previous room's cheats.
+	n.roomOptions, n.cheats = nil, nil
+
+	var av C.struct_retro_system_av_info
+	C.bridge_retro_get_system_av_info(retroGetSystemAVInfo, &av)
+	n.log.Info().Msgf("System A/V >>> %vx%v (%vx%v), [%vfps], AR [%v], audio [%vHz]",
+		av.geometry.base_width, av.geometry.base_height,
+		av.geometry.max_width, av.geometry.max_height,
+		av.timing.fps, av.geometry.aspect_ratio, av.timing.sample_rate,
+	)
+	if isGeometryDifferent(av.geometry) {
+		geometryChange(av.geometry)
+	}
+	n.sys.av = av
+
+	// Per-ROM forced framerate (arcade per-game config). Some cores advertise the DISPLAY refresh
+	// (e.g. flycast reports 59.94 for Dreamcast) while the GAME's engine is hardcoded to a lower rate
+	// with physics tied to it — Sonic Adventure is locked to 30fps, so pacing retro_run at 59.94Hz runs
+	// it at DOUBLE SPEED. Overriding the stored timing here makes tickTime, VideoFramerate() and the
+	// frontend pacing loop all target the game's true rate. Only listed games are affected; genuine
+	// 60fps titles are untouched (no global slowdown). Source: manifest wins, config fps4rom is fallback.
+	forcedFps := 0.0
+	if hasOverride && override.Fps > 0 {
+		forcedFps = override.Fps
+	} else if n.fps4rom != nil {
+		forcedFps = n.fps4rom[romName]
+	}
+	if forcedFps > 0 {
+		n.log.Info().Msgf("[game-override] forcing %.3f fps for %q (core advertised %.3f)", forcedFps, romName, float64(n.sys.av.timing.fps))
+		n.sys.av.timing.fps = C.double(forcedFps)
+	}
+
+	if !n.hackSkipSerializeSizeProbe {
+		n.serializeSize = C.bridge_retro_serialize_size(retroSerializeSize)
+		n.log.Info().Msgf("Save file size: %v", byteCountBinary(int64(n.serializeSize)))
+	} else {
+		n.serializeSize = 0 // informational only; SaveGameState re-queries fresh (see hack note above)
+		n.log.Info().Msgf("Save file size: probe skipped (skip_serialize_size_probe)")
+	}
+
+	Nan0.tickTime = time.Duration(float64(time.Second) / float64(n.sys.av.timing.fps))
+	if n.vfr {
+		n.log.Info().Msgf("variable framerate (VFR) is enabled")
+	}
+
+	n.Stopped.Store(false)
+
+	if n.Video.gl.enabled {
+		if n.LibCo {
+			C.same_thread(C.init_video_cgo)
+			C.same_thread(unsafe.Pointer(Nan0.Video.hw.context_reset))
+		} else {
+			runtime.LockOSThread()
+			initVideo()
+			C.bridge_context_reset(Nan0.Video.hw.context_reset)
+			runtime.UnlockOSThread()
+		}
+	} else if n.Video.vk.enabled {
+		// Vulkan-capture: bring up the instance/device (nano_vk_init) BEFORE context_reset — the core
+		// fetches the hw render interface during context_reset. Both run on the core's cothread for
+		// LibCo cores (LRPS2). No GL context, no thread pinning (Vulkan objects are not thread-bound).
+		if n.LibCo {
+			C.same_thread(C.init_video_vk_cgo)
+			C.same_thread(unsafe.Pointer(Nan0.Video.hw.context_reset))
+		} else {
+			initVideoVulkan()
+			C.bridge_context_reset(Nan0.Video.hw.context_reset)
+		}
+	}
+
+	// set default controller types on all ports
+	// needed for nestopia
+	for i := range maxPort {
+		C.bridge_retro_set_controller_port_device(retroSetControllerPortDevice, C.uint(i), C.RETRO_DEVICE_JOYPAD)
+	}
+
+	// map custom devices to ports
+	for k, v := range n.meta.Hid {
+		for _, device := range v {
+			C.bridge_retro_set_controller_port_device(retroSetControllerPortDevice, C.uint(k), C.unsigned(device))
+			n.log.Debug().Msgf("set custom port-device: %v:%v", k, device)
+		}
+	}
+
+	n.LastFrameTime = time.Now()
+
+	return nil
+}
+
+func (n *Nanoarch) Shutdown() {
+	Nan0.audioBuffCb = nil
+	if n.LibCo {
+		thread.Main(func() {
+			C.same_thread(retroUnloadGame)
+			C.same_thread(retroDeinit)
+			if n.Video.gl.enabled {
+				C.same_thread(C.deinit_video_cgo)
+			}
+			if n.Video.vk.enabled {
+				C.same_thread(C.deinit_video_vk_cgo)
+			}
+			C.same_thread(C.same_thread_stop)
+		})
+	} else {
+		if n.Video.gl.enabled {
+			thread.Main(func() {
+				// running inside a go routine, lock the thread to make sure the OpenGL context stays current
+				runtime.LockOSThread()
+				if err := n.glCtx.BindContext(); err != nil {
+					n.log.Error().Err(err).Msg("ctx switch fail")
+				}
+			})
+		}
+		C.bridge_call(retroUnloadGame)
+		C.bridge_call(retroDeinit)
+		if n.Video.gl.enabled {
+			thread.Main(func() {
+				deinitVideo()
+				runtime.UnlockOSThread()
+			})
+		}
+		if n.Video.vk.enabled {
+			deinitVideoVulkan()
+		}
+	}
+
+	setRotation(0)
+	Nan0.sys.av = C.struct_retro_system_av_info{}
+	if err := coreLib.close(); err != nil {
+		n.log.Error().Err(err).Msg("lib close failed")
+	}
+	n.options = nil
+	n.options4rom = nil
+	Nan0.audioBuffCb = nil
+	C.free(unsafe.Pointer(n.cUserName))
+	C.free(unsafe.Pointer(n.cSaveDirectory))
+	C.free(unsafe.Pointer(n.cSystemDirectory))
+}
+
+func (n *Nanoarch) Reset() {
+	C.bridge_call(retroReset)
+}
+
+func (n *Nanoarch) syncInputToCache() {
+	n.retropad.SyncToCache()
+	if n.keyboardCb != nil {
+		n.keyboard.SyncToCache()
+	}
+	n.mouse.SyncToCache()
+}
+
+func (n *Nanoarch) Run() {
+	// patch 0005: apply a queued multi-disc swap on the emulator thread, before the core steps. (Disc-based
+	// cores — pcsx/Sega CD/Saturn — are non-LibCo, so this runs on the same thread as the retro_run below.)
+	if d := n.pendingDisk.Swap(0); d > 0 {
+		if !bool(C.nano_disk_set_index(C.uint(d - 1))) {
+			n.log.Warn().Msgf("disk swap to index %d failed (no disk control or bad index)", d-1)
+		}
+	}
+	n.syncInputToCache()
+
+	// gc root-cause instrumentation: retro_run TICKS even when no video reaches the encoder, so the dump
+	// lives here (not in video_cb, which may never fire). Every 5s, log the Go video_cb classification +
+	// the C-side set_image/zc-frame/drop-reason counters. Proves "emulation running, frames not arriving".
+	if vkDbgOn && n.Video.vk.enabled {
+		vkDbg.ticks++
+		if time.Since(vkDbg.lastDump) >= 5*time.Second {
+			vkDbg.lastDump = time.Now()
+			n.log.Info().Msgf("[vkdbg-go] ticks=%d video_cb: total=%d null=%d VALID=%d software=%d broken=%d last=%dx%d zcReady=%v captureBroken=%v",
+				vkDbg.ticks, vkDbg.vcbTotal, vkDbg.vcbNull, vkDbg.vcbValid, vkDbg.vcbSoftware, vkDbg.vcbBroken,
+				vkDbg.lastW, vkDbg.lastH, n.Video.vk.zcReady, n.Video.vk.captureBroken)
+			C.nano_vk_dbg_log()
+		}
+	}
+
+	if n.LibCo {
+		C.same_thread(retroRun)
+	} else {
+		if n.Video.gl.enabled {
+			runtime.LockOSThread()
+			if err := n.glCtx.BindContext(); err != nil {
+				n.log.Error().Err(err).Msg("ctx bind fail")
+			}
+		}
+		C.bridge_call(retroRun)
+		if n.Video.gl.enabled {
+			runtime.UnlockOSThread()
+		}
+	}
+}
