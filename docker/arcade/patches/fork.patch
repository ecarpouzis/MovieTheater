-	data := make([]byte, uint(size))
-	rez := false
-
-	if Nan0.LibCo && !Nan0.hackSkipSameThreadSave {
-		rez = *(*bool)(C.same_thread_with_args2(retroSerialize, C.int(CallSerialize), unsafe.Pointer(&data[0]), unsafe.Pointer(&size)))
