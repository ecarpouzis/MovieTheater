+// ── MovieTheater (custom core): switchable per-triangle sort KEY ──────────────────────────────
+//
+// Stock flycast keys each translucent triangle on minZ() — the MINIMUM of the three vertices' z,
+// where z is 1/W (ta_vtx.cpp vert_cvt_base_), so larger = NEARER. The key is therefore each
+// triangle's single FARTHEST vertex, and std::stable_sort orders farthest-first (painter's).
+//
+// That one scalar is the whole mechanism: for the translucent list the pipeline runs depth-test
+// GREATER_OR_EQUAL with depth WRITE DISABLED (pipeline.cpp), so translucent-vs-translucent
+// visibility is decided purely by draw order. An extremum key compares two points that can be
+// nowhere near where the two triangles actually overlap on screen, which is upstream
+// flyinghead/flycast#100 ("Accurate Per strip/Per triangle", still open) and is what mangles
+// Sonic Adventure's face — the mouth/muzzle decals lose the sort to the geometry they sit on,
+// and flip in and out frame-to-frame as the head rotates.
+//
+// This does not pretend to be an exact solution (that needs Newell-style splitting or per-pixel
+// OIT). It makes the KEY selectable so the right one can be MEASURED against a real scene rather
+// than argued about, and so a per-game override can pin whichever wins. Mode 0 is stock, bit-for-
+// bit, and is the default — nothing changes unless a room asks for it.
+enum MtSortKey
+{
+	MTSK_MIN = 0,       // stock: farthest vertex
+	MTSK_MEAN,          // centroid of 1/W — the ordinary painter's key
+	MTSK_MAX,           // nearest vertex
+	MTSK_MIN_TIE,       // stock key, quantized so near-equal depths compare EQUAL
+	MTSK_MEAN_TIE,      // centroid, quantized likewise
+	MTSK_MEAN_TIE_COARSE,
+	// Diagnostic: no reordering at all. Every key is equal, so std::stable_sort leaves the list in
+	// SUBMISSION order (PolyParam order, then strip order). This is not a shipping candidate — it
+	// answers the question the whole ladder hinges on: does the game's own draw order render the
+	// face correctly? If yes, the fix is to stop the scalar reordering geometry it cannot resolve.
+	// If no, the game depends on the PVR's real per-pixel autosort and only OIT can be right.
+	MTSK_NONE,
+};
+int mtSortKeyMode = MTSK_MIN;
+
+// Collapse depths that differ only in the low mantissa bits onto one value. IEEE-754 positive
+// floats are monotonic in their bit pattern, so masking N low bits buckets them with constant
+// RELATIVE precision. The point is std::stable_sort: keys that compare EQUAL keep their original
+// submission order, and for a decal lying on a surface that submission order is the artist's
+// intent — the depth difference between them is real but far below the accuracy this scalar key
+// can resolve, so ordering by it is noise, and noise is exactly what makes the mouth flicker.
+static inline float quantizeZ(float z, int dropBits)
+{
+	if (!(z > 0.f) || !std::isfinite(z))
+		return z;
+	u32 u;
+	memcpy(&u, &z, sizeof(u));
+	u &= ~((1u << dropBits) - 1u);
+	float r;
+	memcpy(&r, &u, sizeof(r));
+	return r;
+}
+
+static inline float mtSortKey(float a, float b, float c)
+{
+	switch (mtSortKeyMode)
+	{
+	case MTSK_MEAN:
+		return (a + b + c) * (1.f / 3.f);
+	case MTSK_MAX:
+		return std::max(std::max(a, b), c);
+	case MTSK_MIN_TIE:
+		return quantizeZ(std::min(std::min(a, b), c), 12);
+	case MTSK_MEAN_TIE:
+		return quantizeZ((a + b + c) * (1.f / 3.f), 12);
+	case MTSK_MEAN_TIE_COARSE:
+		return quantizeZ((a + b + c) * (1.f / 3.f), 16);
+	case MTSK_NONE:
+		return 0.f;
+	case MTSK_MIN:
+	default:
+		return std::min(std::min(a, b), c);
+	}
+}
+
 static float minZ(const Vertex *v, const u32 *mod)
 {
-	return std::min(std::min(v[mod[0]].z, v[mod[1]].z), v[mod[2]].z);
+	return mtSortKey(v[mod[0]].z, v[mod[1]].z, v[mod[2]].z);
 }
 
