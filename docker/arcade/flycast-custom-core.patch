diff --git a/core/rend/vulkan/vk_context_lr.h b/core/rend/vulkan/vk_context_lr.h
index 3726b98..afc8a5f 100644
--- a/core/rend/vulkan/vk_context_lr.h
+++ b/core/rend/vulkan/vk_context_lr.h
@@ -53,7 +53,19 @@ public:
 	void WaitIdle() const { queue.waitIdle(); }
 	void SubmitCommandBuffers(const std::vector<vk::CommandBuffer> &buffers, vk::Fence fence) {
 		retro_render_if->lock_queue(retro_render_if->handle);
-		queue.submit(vk::SubmitInfo(nullptr, nullptr, buffers, nullptr), fence);
+		// MovieTheater (custom core, Option A): if PresentFrame armed a present-done semaphore, signal it
+		// on THIS submit. flycast renders on its own thread (rend.ThreadedRendering) and passes NO
+		// set_image semaphore, so the CloudRetro zero-copy capture (which imports colorAttachments[idx]
+		// and blits from the emu cothread) would otherwise race this render submit and read a pre/mid-
+		// render image = garbage/stale. Signaling here + passing the same semaphore to set_image lets the
+		// frontend's copy WAIT on render completion (mirrors the Dolphin present-semaphore cure). The
+		// semaphore is single-use per frame and consumed immediately below.
+		vk::Semaphore sig = pendingSignalSem;
+		pendingSignalSem = vk::Semaphore();
