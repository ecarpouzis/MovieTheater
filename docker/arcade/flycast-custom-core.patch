diff --git a/core/windows/fault_handler.cpp b/core/windows/fault_handler.cpp
index ceed7f0..bf60de1 100644
--- a/core/windows/fault_handler.cpp
+++ b/core/windows/fault_handler.cpp
@@ -154,6 +154,31 @@ static LONG WINAPI exceptionHandler(EXCEPTION_POINTERS *ep)
 #endif
 
 	ERROR_LOG(COMMON, "[GPF] Thread:%s PC %p unhandled access to %p", getThreadName(), (void *)context.pc, address);
+	{
+		// MovieTheater diag: print the faulting module + RVA so addr2line can resolve the source line
+		// under ASLR (the RelWithDebInfo core loads at a randomized base). RVA = PC - moduleBase.
+		auto printModRva = [](const char *tag, uintptr_t addr) {
+			HMODULE mod = nullptr;
+			if (addr && GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+					(LPCSTR)addr, &mod) && mod) {
+				char modname[MAX_PATH] = {0};
+				GetModuleFileNameA(mod, modname, MAX_PATH);
+				ERROR_LOG(COMMON, "[GPF] %s=%p module=%s base=%p RVA=%p", tag, (void *)addr, modname,
+						(void *)mod, (void *)(addr - (uintptr_t)mod));
+			} else {
+				ERROR_LOG(COMMON, "[GPF] %s=%p (not in a loaded module)", tag, (void *)addr);
+			}
+		};
+		printModRva("PC", (uintptr_t)context.pc);
+		// A call through a garbage function pointer faults at instruction-fetch of the target, so RSP
+		// still points at the pushed RETURN address = the caller (inside flycast, resolvable). Walk a
+		// few stack slots so a resolvable caller frame is found even past a leaf with no call.
+		uintptr_t *sp = (uintptr_t *)context.rsp;
+		for (int i = 0; sp && i < 12; i++) {
+			char tag[24]; snprintf(tag, sizeof(tag), "RET[%d]", i);
+			printModRva(tag, sp[i]);
+		}
+	}
 	if (prevExceptionHandler != nullptr)
 		prevExceptionHandler(ep);
 
