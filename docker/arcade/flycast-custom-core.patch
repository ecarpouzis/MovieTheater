 					float z2 = getProjectedZ(v2, ctx.matrices[pp->mvMatrix].mat);
-					triangleList.back().z = std::min(z0, std::min(z1, z2));
+					// Naomi2's projected z is -1/z and can be NEGATIVE, which quantizeZ passes
+					// through untouched — the tie modes are therefore inert here by design.
+					triangleList.back().z = mtSortKey(z0, z1, z2);
