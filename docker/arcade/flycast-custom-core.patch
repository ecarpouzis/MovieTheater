@@ -427,11 +454,24 @@ void VulkanContext::PresentFrame(vk::Image image, vk::ImageView imageView, const
 	quadDrawer->Draw(cmdBuffer, imageView, vtx, false);
 	overlay->Draw(cmdBuffer, extent, config::EmulateFramebuffer ? 1 : (int)config::RenderResolution / 480.f,
 			true, true);
+
+	// MovieTheater (custom core, Option A): arm a render-done semaphore for THIS image before endFrame's
+	// submit, then hand it to set_image so the CloudRetro zero-copy capture waits on it. Without this,
+	// flycast's threaded render submit races the frontend's blit (flycast passes no set_image semaphore,
+	// unlike the safe single-threaded paraLLEl-GS) → pre/mid-render reads = garbage/stale. Lazily grow the
+	// per-image ring; pendingSignalSem is consumed by SubmitCommandBuffers (called from endFrame below).
+	int imgIdx = GetCurrentImageIndex();
+	while ((int)renderCompleteSems.size() <= imgIdx)
+		renderCompleteSems.push_back(device.createSemaphoreUnique(vk::SemaphoreCreateInfo()));
+	vk::Semaphore frameSem = *renderCompleteSems[imgIdx];
+	pendingSignalSem = frameSem;
+
 	endFrame(image);
 
-	retro_image.image_view = (VkImageView)colorAttachments[GetCurrentImageIndex()]->GetImageView();
-	retro_image.create_info.image = (VkImage)colorAttachments[GetCurrentImageIndex()]->GetImage();
-	retro_render_if->set_image(retro_render_if->handle, &retro_image, 0, nullptr, vk::QueueFamilyIgnored);
+	retro_image.image_view = (VkImageView)colorAttachments[imgIdx]->GetImageView();
+	retro_image.create_info.image = (VkImage)colorAttachments[imgIdx]->GetImage();
+	VkSemaphore waitSem = (VkSemaphore)frameSem;
+	retro_render_if->set_image(retro_render_if->handle, &retro_image, 1, &waitSem, vk::QueueFamilyIgnored);
 }
 
