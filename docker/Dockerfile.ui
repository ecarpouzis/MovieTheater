# Build react app on glibc (node:20-slim), not alpine/musl. Vite 8 bundles via rolldown, whose native
# bundler binding ships as a per-platform optionalDependency; npm doesn't reliably install the *musl*
# binding from a lock generated on another OS/libc (npm/cli#4828), so the alpine build can't find
# @rolldown/binding-linux-x64-musl. glibc uses the linux-x64-gnu binding (also present in the lock) and
# avoids the issue. The release stage stays alpine — it only serves the platform-independent static build.
FROM node:20-slim AS reactapp-build
WORKDIR /build
COPY src/ui/package.json .
COPY src/ui/package-lock.json .
RUN npm install
# npm SILENTLY skips an optional dependency it fails to fetch, and the per-platform native binaries are optional
# dependencies — so a fresh `npm install` (a cache miss) can finish "successfully" without lightningcss's Linux
# binary, and the build then dies in Vite's CSS minifier ("Cannot find module '../lightningcss.linux-x64-gnu.node'",
# 2026-10-03 run 37102181478). Check that it loads; if not, install the exact version the lockfile pins, then insist.
RUN node -e "require('lightningcss')" 2>/dev/null || ( \
      v=$(node -p "require('./package-lock.json').packages['node_modules/lightningcss-linux-x64-gnu'].version") && \
      echo "lightningcss native binary missing after npm install - installing lightningcss-linux-x64-gnu@$v" && \
      npm install --no-save "lightningcss-linux-x64-gnu@$v" && \
      node -e "require('lightningcss')" )
COPY src/ui/ .
# The commit being built, for index.html's mt-build marker. Declared HERE, after `npm install`, so a
# new SHA invalidates only the build layer and never the dependency layer. There is no .git in this
# context, so without this the marker would read "unknown".
ARG MT_BUILD=""
ENV MT_BUILD=$MT_BUILD
RUN npm run build

# Build final release image
FROM node:20-alpine AS release
RUN npm install -g serve

WORKDIR /app
COPY --from=reactapp-build /build/build .

# serve -s /app -l 3000
CMD ["serve", "-s", "/app", "-l", "3000"]
