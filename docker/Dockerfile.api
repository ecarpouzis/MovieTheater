# Build dotnet C# project
FROM mcr.microsoft.com/dotnet/sdk:10.0 as dotnet-build
WORKDIR /build
COPY docker/projectfiles.tar .
RUN tar -xvf projectfiles.tar
RUN dotnet restore src/MovieTheater/MovieTheater.csproj

COPY src ./src
RUN dotnet publish src/MovieTheater/MovieTheater.csproj --no-restore -c Release -o /publish

# Build final release image
FROM mcr.microsoft.com/dotnet/aspnet:10.0 as release

# Python + Pillow for PILResaveImage, from Debian's own packages. The aspnet:10.0 image is Debian 13,
# whose distro-managed pip refuses `pip install --upgrade pip` (RECORD file not found), so no pip at all.
RUN apt-get update &&     apt-get install -y --no-install-recommends python3 python3-pil &&     rm -rf /var/lib/apt/lists/*

ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS="http://+:80"
EXPOSE 80

ENV PYPATH /usr/bin/python3
ENV MOVIEPOSTERSDIR /volume/posters
ENV BOARDGAMEIMAGESDIR /volume/boardgameimages

WORKDIR /app
COPY --from=dotnet-build /publish ./

# dotnet /app/MovieTheater.dll web
CMD ["dotnet", "/app/MovieTheater.dll", "web"]

